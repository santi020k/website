{
  "name": "website",
  "version": "3.3.0",
  "private": true,
  "description": "Engineering portfolio and blog by Santiago Molina.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prelint": "astro sync",
    "prebuild": "npm-run-all --serial prebuild:clean generate:icons generate:fonts generate:og",
    "prebuild:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "astro build",
    "postbuild": "npm-run-all --serial postbuild:sitemap postbuild:redirects audit:seo",
    "postbuild:sitemap": "node scripts/js/generate-cross-site-sitemap.mjs",
    "postbuild:redirects": "node scripts/js/generate-cloudflare-redirects.mjs",
    "generate:icons": "node scripts/js/generate-favicons.mjs",
    "generate:fonts": "node scripts/js/generate-fonts.mjs",
    "generate:fonts:py": "python3 scripts/py/generate-fonts.py",
    "generate:project-images": "node scripts/js/generate-project-images.mjs",
    "pregenerate:cv": "pnpm run build",
    "generate:cv": "node scripts/js/generate-resume-pdf.mjs",
    "generate:og": "santi-og generate --config scripts/js/generate-og-images.js",
    "generate:og:force": "santi-og generate --config scripts/js/generate-og-images.js --force",
    "check:og": "santi-og check --config scripts/js/generate-og-images.js",
    "audit:seo": "santi-og audit --config og.audit.config.mjs",
    "inspect:og": "santi-og inspect https://santi020k.com --json",
    "preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview",
    "lint": "SYNCKIT_TIMEOUT=180000 eslint . --max-warnings=0",
    "lint:fix": "SYNCKIT_TIMEOUT=180000 eslint . --fix --max-warnings=0",
    "check": "astro check",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "vitest run",
    "test:webmentions": "vitest run src/utils/__tests__/webmentions-fetch.test.ts",
    "check:webmentions": "node scripts/js/check-webmentions.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=dot",
    "playwright:install": "pnpm exec playwright install",
    "playwright:install:chromium": "pnpm exec playwright install chromium",
    "pretest:e2e": "pnpm run playwright:install:chromium",
    "test:e2e": "playwright test",
    "pretest:e2e:fast": "pnpm run playwright:install:chromium",
    "test:e2e:fast": "SKIP_BUILD=1 playwright test --reporter=line",
    "pretest:e2e:ci": "pnpm run playwright:install:chromium",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:e2e:ci:stable": "PW_ONLY_CHROMIUM=true PW_CHROMIUM_CHANNEL=chrome playwright test --project=chromium --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "node -e \"require('node:fs').rmSync('.lighthouseci', { recursive: true, force: true })\" && lhci autorun --config=.lighthouserc.local.json",
    "lighthouse:full": "node -e \"require('node:fs').rmSync('.lighthouseci', { recursive: true, force: true })\" && LHCI_NUMBER_OF_RUNS=3 lhci autorun",
    "lint:content": "node scripts/js/content-lint.mjs",
    "lint:md": "markdownlint-cli2",
    "spellcheck": "cspell --quiet \"**/*.{md,mdx}\"",
    "verify:quality": "npm-run-all --silent --serial spellcheck lint check lint:md lint:content test",
    "verify:fast": "npm-run-all --silent --serial verify:quality build",
    "verify:full": "npm-run-all --silent --serial spellcheck lint check lint:md lint:content test:coverage build && pnpm run lighthouse && pnpm run test:e2e:ci:stable",
    "ci:verify": "pnpm run verify:full",
    "hooks:install": "node scripts/js/install-quality-hooks.mjs",
    "prepare": "pnpm run hooks:install",
    "pre-commit": "lint-staged --quiet && astro check",
    "pre-push": "pnpm run verify:fast",
    "commit": "commitprompt"
  },
  "dependencies": {
    "@astrojs/mdx": "catalog:",
    "@astrojs/rss": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@santi020k/lumen-astro": "catalog:",
    "@santi020k/theme": "catalog:",
    "@shikijs/transformers": "catalog:",
    "astro": "catalog:",
    "astro-icon": "catalog:",
    "astro-robots-txt": "catalog:",
    "astro-webmanifest": "catalog:",
    "fast-xml-parser": "catalog:",
    "hastscript": "catalog:",
    "mdast-util-directive": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "mdast-util-to-string": "catalog:",
    "rehype-external-links": "catalog:",
    "rehype-pretty-code": "catalog:",
    "rehype-unwrap-images": "catalog:",
    "remark-directive": "catalog:",
    "sharp": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/markdown-remark": "catalog:",
    "@astrojs/ts-plugin": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@lhci/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@santi020k/commitprompt": "catalog:",
    "@santi020k/eslint-config-full": "catalog:",
    "@santi020k/og": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/mdast": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "js-yaml": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "reading-time": "catalog:",
    "remark-parse": "catalog:",
    "remark-stringify": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vfile": "catalog:",
    "vitest": "catalog:",
    "wawoff2": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "license": "SEE LICENSE IN LICENSE",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,md,mdx,json}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{md,mdx}": [
      "cspell --quiet --no-must-find-files"
    ]
  }
}
