{
  "name": "website",
  "version": "2.1.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm-run-all --serial prebuild:clean generate:og",
    "prebuild:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "generate:og": "node scripts/generate-og-images.js",
    "generate:og:force": "FORCE_OG=1 node scripts/generate-og-images.js",
    "preview": "astro preview",
    "lint": "eslint . --fix",
    "format": "eslint --fix .",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "spellcheck": "cspell \"**/*.{md,mdx}\"",
    "ci:verify": "npm-run-all --serial ci:verify:check ci:verify:e2e",
    "ci:verify:check": "npm-run-all --parallel spellcheck lint test:coverage build",
    "ci:verify:e2e": "test:e2e:ci",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run ci:verify"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/mdx": "5.0.3",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "@shikijs/transformers": "^4.0.2",
    "@types/alpinejs": "^3.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "alpinejs": "^3.15.10",
    "astro": "6.1.3",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "astro-webmanifest": "^1.0.0",
    "cssnano": "^7.1.4",
    "fast-xml-parser": "^5.5.9",
    "hastscript": "^9.0.1",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^4.0.0",
    "satori": "0.26.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@axe-core/playwright": "^4.11.1",
    "@iconify-json/hugeicons": "^1.2.24",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/tabler": "^1.2.33",
    "@iconify/tailwind4": "^1.2.3",
    "@lhci/cli": "^0.15.1",
    "@pagefind/default-ui": "^1.4.0",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@santi020k/eslint-config-astro": "^1.1.0",
    "@santi020k/eslint-config-basic": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "commit-and-tag-version": "^12.7.1",
    "commitizen": "^4.3.1",
    "cspell": "^9.7.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.1.0",
    "eslint-plugin-playwright": "^2.10.1",
    "graphql": "^16.13.2",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^7.0.2",
    "pagefind": "^1.4.0",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,md,mdx,json}": [
      "eslint --fix"
    ],
    "*.{md,mdx}": [
      "cspell"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "esbuild": "^0.25.0",
      "sharp": "^0.34.5"
    }
  }
}
