---
import { ClientRouter } from 'astro:transitions'

import BackToTop from '@/components/atoms/BackToTop.astro'
import ParticlesBackground from '@/components/atoms/ParticlesBackground.astro'
import SkipLink from '@/components/atoms/SkipLink.astro'
import SiteFooter from '@/components/organisms/SiteFooter.astro'
import SiteHeader from '@/components/organisms/SiteHeader.astro'
import BaseHead from '@/components/shared/BaseHead.astro'
import NavProgress from '@/components/shared/NavProgress.astro'
import ScrollReveal from '@/components/shared/ScrollReveal.astro'
import ServiceWorkerRegistration from '@/components/shared/ServiceWorkerRegistration.astro'
import ThemeProvider from '@/components/shared/ThemeProvider.astro'

import '@/styles/global.css'

import { siteConfig } from '@/site.config'
import type { SiteMeta } from '@/types/site'

interface Props {
  meta: SiteMeta
}

const {
  meta: {
    articleDate,
    articleUpdated,
    breadcrumbs,
    description = siteConfig.description,
    ogImage,
    ogImageAlt,
    preloadImage,
    structuredData,
    title
  }
} = Astro.props

const headMeta = {
  title,
  description,
  ...(articleDate !== undefined ? { articleDate } : {}),
  ...(articleUpdated !== undefined ? { articleUpdated } : {}),
  ...(breadcrumbs !== undefined ? { breadcrumbs } : {}),
  ...(ogImage !== undefined ? { ogImage } : {}),
  ...(ogImageAlt !== undefined ? { ogImageAlt } : {}),
  ...(preloadImage !== undefined ? { preloadImage } : {}),
  ...(structuredData !== undefined ? { structuredData } : {})
}
---

<html class="scroll-smooth" lang={siteConfig.lang}>
  <head>
    <BaseHead {...headMeta} />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <ThemeProvider />
    <SkipLink />

    <div class="relative flex min-h-screen w-full flex-col overflow-x-clip">
      <ParticlesBackground density="medium" class="-z-10" />
      <div class="
        pointer-events-none absolute inset-0 -z-10 grid-fade opacity-60
      "
      />
      <SiteHeader />

      <main
        id="main"
        class="
          mx-auto flex w-full max-w-[96rem] flex-1 flex-col justify-center gap-16
          px-5 pt-12 pb-24
          sm:px-6
          lg:gap-20 lg:px-8
          2xl:gap-24 2xl:px-10
        "
        tabindex="-1"
        transition:animate="fade"
      >
        <slot />
      </main>

      <SiteFooter />
    </div>

    <BackToTop />
    <NavProgress />
    <ScrollReveal />
    {import.meta.env.PROD && <ServiceWorkerRegistration />}

    <script>
      // Scroll to top on forward navigation; preserve position on back/forward.
      // Also restore SR/keyboard focus to <main> after the swap so the virtual
      // cursor follows the page change instead of staying on a stale element.
      document.addEventListener('astro:before-preparation', (e) => {
        const { navigationType } = e as Event & { navigationType?: string }
        const isTraverse = navigationType === 'traverse'

        document.addEventListener('astro:after-swap', () => {
          if (!isTraverse) {
            window.scrollTo(0, 0)
          }

          const main = document.getElementById('main')
          if (main instanceof HTMLElement) {
            main.focus({ preventScroll: true })
          }
        }, { once: true })
      })
    </script>

  </body>
</html>
