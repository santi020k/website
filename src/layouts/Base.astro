---
import { CLOUDFLARE_WEB_ANALYTICS_TOKEN } from 'astro:env/client'
import { ClientRouter } from 'astro:transitions'

import ArrowSprite from '@/components/atoms/ArrowSprite.astro'
import BackToTop from '@/components/atoms/BackToTop.astro'
import SiteFooter from '@/components/organisms/SiteFooter.astro'
import SiteHeader from '@/components/organisms/SiteHeader.astro'
import BaseHead from '@/components/shared/BaseHead.astro'
import CloudflareAnalytics from '@/components/shared/CloudflareAnalytics.astro'
import NavProgress from '@/components/shared/NavProgress.astro'
import ServiceWorkerRegistration from '@/components/shared/ServiceWorkerRegistration.astro'
import ThemeProvider from '@/components/shared/ThemeProvider.astro'

import type { SiteMeta } from '@/types/site'

import '@/styles/global.css'

import { Particles, SkipLink } from '@santi020k/lumen-astro'
import UIPrimitives from '@santi020k/lumen-astro/runtime'

import { getLocale, localeLanguage, sharedTranslator } from '@/i18n'
import { siteConfig } from '@/site.config'

interface Props {
  backdrop?: 'decorated' | 'particles' | 'plain'
  footerVariant?: 'compact' | 'default'
  headerVariant?: 'dock' | 'signature'
  mainClass?: string | undefined
  mainSpacing?: 'generous' | 'standard'
  meta: SiteMeta
}

const {
  backdrop = 'decorated',
  footerVariant = 'default',
  headerVariant = 'dock',
  mainClass,
  mainSpacing = 'standard',
  meta: {
    articleDate,
    articleUpdated,
    breadcrumbs,
    canonicalUrl,
    contentLocale,
    description = siteConfig.description,
    noindex,
    ogImage,
    ogImageAlt,
    preloadImage,
    seoTitle,
    structuredData,
    title
  }
} = Astro.props

const headMeta = {
  title,
  description,
  ...(articleDate !== undefined ? { articleDate } : {}),
  ...(articleUpdated !== undefined ? { articleUpdated } : {}),
  ...(breadcrumbs !== undefined ? { breadcrumbs } : {}),
  ...(canonicalUrl !== undefined ? { canonicalUrl } : {}),
  ...(contentLocale !== undefined ? { contentLocale } : {}),
  ...(noindex !== undefined ? { noindex } : {}),
  ...(ogImage !== undefined ? { ogImage } : {}),
  ...(ogImageAlt !== undefined ? { ogImageAlt } : {}),
  ...(preloadImage !== undefined ? { preloadImage } : {}),
  ...(seoTitle !== undefined ? { seoTitle } : {}),
  ...(structuredData !== undefined ? { structuredData } : {})
}

const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)
const isGenerousSpacing = mainSpacing === 'generous'

// Cookieless, aggregate page views. `spa` follows ClientRouter navigations through the History API.
const cloudflareBeacon = import.meta.env.PROD && CLOUDFLARE_WEB_ANALYTICS_TOKEN ?
  JSON.stringify({ spa: true, token: CLOUDFLARE_WEB_ANALYTICS_TOKEN }) :
  undefined
---

<html
  class="
    scroll-smooth
    data-instant-scroll:scroll-auto
    motion-reduce:scroll-auto
  "
  data-instant-scroll
  lang={localeLanguage(locale)}
>
  <head>
    <BaseHead {...headMeta} />
    {cloudflareBeacon && <CloudflareAnalytics config={cloudflareBeacon} />}
    <script is:inline>
      // Register before ClientRouter's deferred module. Chromium dispatches window
      // popstate listeners in registration order even when capture is requested.
      window.addEventListener('popstate', event => {
        if (event.state === null) return

        document.documentElement.setAttribute('data-instant-scroll', '')

        // Chromium must resolve the new style before the router calls scrollTo.
        getComputedStyle(document.documentElement).getPropertyValue('scroll-behavior')

        // Keep auto scrolling until the router and other listeners finish.
        setTimeout(() => document.documentElement.removeAttribute('data-instant-scroll'), 0)
      }, { capture: true })
    </script>
    <ClientRouter fallback="swap" />
    <noscript>
      <style is:inline>
        /*
         * Without scripts, CodeTabs cannot switch panels and copy controls cannot
         * write to the clipboard, so show every command and leave manual selection.
         * Lumen hides [hidden] with !important inside lumen.base. This layer is
         * declared before the bundled stylesheets, so its !important rules win.
         */
        @layer reading-without-javascript {
          [data-package-manager-code-tabs] > [role="tablist"],
          .prose-santi [data-ui-code-copy],
          .editorial-detail-hero [data-article-copy],
          [data-newsletter-copy],
          #copy-link-btn {
            display: none !important;
          }

          [data-package-manager-code-tabs],
          [data-package-manager-code-tabs] > [role="tabpanel"],
          [data-package-manager-code-tabs] [data-ui-code] {
            display: block !important;
          }

          [data-package-manager-code-tabs] figcaption {
            display: none !important;
          }

          [data-package-manager-code-tabs] > [role="tabpanel"] + [role="tabpanel"] {
            border-top: 1px solid hsl(var(--line)) !important;
          }
        }

        /*
         * Scripts drop data-instant-scroll once the router has restored scroll.
         * Without them it stays, so this unlayered rule keeps same-page links smooth.
         */
        @media (prefers-reduced-motion: no-preference) {
          :root[data-instant-scroll] {
            scroll-behavior: smooth;
          }
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen" data-backdrop={backdrop}>
    <ThemeProvider />
    <SkipLink href="#main">{t('shared.skipToContent')}</SkipLink>
    <ArrowSprite />

    <div class="relative flex min-h-screen w-full flex-col overflow-x-clip">
      {backdrop !== 'plain' && (
<Particles
        class="
          pointer-events-none absolute inset-0 z-0 min-h-0 overflow-hidden
          rounded-none bg-transparent bg-none
        "
        data-particles-bg
        density="medium"
/>
)}
      {backdrop === 'decorated' && (
<div class="pointer-events-none absolute inset-0 -z-10 grid-fade opacity-60"/>
)}
      <SiteHeader variant={headerVariant} />

      <main
        data-page-spacing={mainSpacing}
        data-page-frame={headerVariant === 'signature' ? '' : undefined}
        id="main"
        class:list={[
          `
            mx-auto flex w-full max-w-384 flex-1 flex-col justify-center
            page-flow px-5 pt-12
            sm:px-6
            lg:px-8
            2xl:px-10
          `,
          isGenerousSpacing ?
            `
              pb-20
              sm:pb-22
              lg:pb-24
            ` :
            `
              pb-16
              sm:pb-18
              lg:pb-20
            `,
          mainClass
        ]}
        tabindex="-1"
      >
        <slot />
      </main>

      <SiteFooter variant={footerVariant} />
    </div>

    <BackToTop />
    <NavProgress />
    <UIPrimitives />
    {import.meta.env.PROD && <ServiceWorkerRegistration />}

    <script>
      import { TransitionBeforeSwapEvent } from 'astro:transitions/client'

      let anchoringFrame = 0
      let followsFragment = false

      // Keyboard focus can still be scrolling the outgoing page. Stop that
      // animation before loading the next document so queued compositor updates
      // cannot displace its restored history or fragment position.
      document.addEventListener('astro:before-preparation', () => {
        window.scrollTo({ behavior: 'instant', left: window.scrollX, top: window.scrollY })
      })

      // The route transition owns the entrance after navigation. Replaying each
      // hero's initial-load animation underneath it causes a second jump/fade.
      document.addEventListener('astro:before-swap', event => {
        followsFragment = false

        if (event instanceof TransitionBeforeSwapEvent) {
          // History traversal restores a saved position; other navigations to a
          // hash let the browser follow the fragment before after-swap.
          followsFragment = event.navigationType !== 'traverse' && event.to.hash !== ''

          event.newDocument.body.dataset.clientNavigation = ''

          // A queued adjustment from the outgoing document must not move Astro's
          // restored position. Keep anchoring off across the root-attribute swap.
          cancelAnimationFrame(anchoringFrame)

          document.documentElement.setAttribute('data-navigation-scroll', '')

          event.newDocument.documentElement.setAttribute('data-navigation-scroll', '')
        }
      })

      // Every rendered document starts with data-instant-scroll, and a swap copies it
      // onto the live root before Astro restores history or fragment scroll. Dropping
      // it afterwards keeps same-page links smooth without animating restoration.
      const allowSmoothScroll = () => {
        document.documentElement.removeAttribute('data-instant-scroll')
      }

      // Find an existing ID target, trying the literal fragment before decoding it.
      const hasFragmentTarget = () => {
        const fragment = window.location.hash.slice(1)

        if (!fragment) return false

        if (document.getElementById(fragment)) return true

        try {
          return document.getElementById(decodeURIComponent(fragment)) !== null
        } catch {
          return false
        }
      }

      // Restore SR/keyboard focus after a swap so the virtual cursor follows
      // the page change. Astro retains control of fragment and history scroll.
      document.addEventListener('astro:after-swap', () => {
        allowSmoothScroll()

        // Allow the restored document to paint before selecting a new scroll
        // anchor. Two frames also cover the immediate, non-native swap fallback.
        anchoringFrame = requestAnimationFrame(() => {
          anchoringFrame = requestAnimationFrame(() => {
            document.documentElement.removeAttribute('data-navigation-scroll')

            anchoringFrame = 0
          })
        })

        // Astro has already followed the fragment natively, which set the
        // sequential focus starting point at its target. Focusing main would
        // send the next Tab back to the top of the page.
        if (followsFragment && hasFragmentTarget()) return

        const main = document.getElementById('main')

        if (main instanceof HTMLElement) {
          main.focus({ preventScroll: true })
        }
      })

      // The first document load restores reload and cross-document history scroll.
      document.addEventListener('astro:page-load', allowSmoothScroll)
    </script>

  </body>
</html>
