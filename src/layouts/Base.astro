---
import { ClientRouter } from 'astro:transitions'

import BackToTop from '../components/atoms/BackToTop.astro'
import SkipLink from '../components/atoms/SkipLink.astro'
import SiteFooter from '../components/organisms/SiteFooter.astro'
import SiteHeader from '../components/organisms/SiteHeader.astro'
import BaseHead from '../components/shared/BaseHead.astro'
import NavProgress from '../components/shared/NavProgress.astro'
import ScrollReveal from '../components/shared/ScrollReveal.astro'
import ServiceWorkerRegistration from '../components/shared/ServiceWorkerRegistration.astro'
import ThemeProvider from '../components/shared/ThemeProvider.astro'
import { siteConfig } from '../site.config'
import type { SiteMeta } from '../types/site'

import '../styles/global.css'

interface Props {
  meta: SiteMeta
}

const {
  meta: {
    articleDate,
    articleUpdated,
    breadcrumbs,
    description = siteConfig.description,
    ogImage,
    preloadImage,
    structuredData,
    title
  }
} = Astro.props

const headMeta = {
  title,
  description,
  ...(articleDate !== undefined ? { articleDate } : {}),
  ...(articleUpdated !== undefined ? { articleUpdated } : {}),
  ...(breadcrumbs !== undefined ? { breadcrumbs } : {}),
  ...(ogImage !== undefined ? { ogImage } : {}),
  ...(preloadImage !== undefined ? { preloadImage } : {}),
  ...(structuredData !== undefined ? { structuredData } : {})
}
---

<html class="scroll-smooth" lang={siteConfig.lang}>
  <head>
    <BaseHead {...headMeta} />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <ThemeProvider />
    <SkipLink />

    <div class="relative min-h-screen w-full overflow-x-clip">
      <div class="
        pointer-events-none absolute inset-0 -z-10 grid-fade opacity-60
      "
      />
      <SiteHeader />

      <main
        id="main"
        class="
          mx-auto flex min-h-[calc(100vh-8rem)] w-full max-w-6xl flex-col gap-24
          px-5 pt-12 pb-24
          sm:px-6
          lg:px-8
        "
        transition:animate="fade"
      >
        <slot />
      </main>

      <SiteFooter />
    </div>

    <BackToTop />
    <NavProgress />
    <ScrollReveal />
    {import.meta.env.PROD && <ServiceWorkerRegistration />}

    <script>
      // Scroll to top on forward navigation; preserve position on back/forward
      document.addEventListener('astro:before-preparation', (e) => {
        const { navigationType } = e as Event & { navigationType?: string }
        if (navigationType !== 'traverse') {
          document.addEventListener('astro:after-swap', () => {
            window.scrollTo(0, 0)
          }, { once: true })
        }
      })
    </script>

  </body>
</html>
