---
import { type CollectionEntry, render } from 'astro:content'
import { Icon } from 'astro-icon/components'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import ProjectCard from '@/components/molecules/ProjectCard.astro'
import TocCard from '@/components/molecules/TocCard.astro'
import ProjectHero from '@/components/organisms/ProjectHero.astro'

import {
  getProjectDurationLabel,
  getProjectFocusLabel,
  getProjectTimelineLabel,
  getProjectTypeLabel
} from '@/utils/project-meta'

import BaseLayout from '@/layouts/Base.astro'

interface Props {
  project: CollectionEntry<'project'>
  relatedProjects?: CollectionEntry<'project'>[]
}

const { project, relatedProjects = [] } = Astro.props
const metaTitle = project.data.seoTitle ?? `${project.data.title} · ${project.data.rol ?? 'Project'}`
const metaDescription = project.data.seoDescription ?? project.data.description
// Use Dynamic OG Image generator (/og/portfolio/[id].png)
const socialImage = new URL(`/og/portfolio/${project.id}.png`, Astro.site).href
const { headings } = await render(project)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const sameAs = [project.data.githubUrl, project.data.liveDemoUrl].filter(Boolean)
const hasLiveDemo = Boolean(project.data.liveDemoUrl)
const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const focusLabel = getProjectFocusLabel(project.data.typesId)
const timelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const durationLabel = getProjectDurationLabel(project.data.startingDate, project.data.endingDate)
const stackPreview = project.data.technologies.slice(0, 6)
const projectStageLabel = project.data.endingDate ? 'Completed case study' : 'Active project'

const projectSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': hasLiveDemo ? ['CreativeWork', 'SoftwareApplication'] : 'CreativeWork',
  name: project.data.title,
  description: metaDescription,
  dateCreated: project.data.startingDate.toISOString(),
  ...(project.data.endingDate ? { dateModified: project.data.endingDate.toISOString() } : {}),
  keywords: project.data.technologies,
  url: canonicalURL.href,
  ...(project.data.coverImage?.ogImage ? { image: new URL(project.data.coverImage.ogImage, Astro.site).href } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
  author: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' },
  { name: project.data.title, url: Astro.url.pathname }
]

---

<BaseLayout
  meta={{
    breadcrumbs,
    description: metaDescription,
    ogImage: socialImage,
    ogImageAlt: `${metaTitle} — portfolio case study by Santiago Molina`,
    structuredData: projectSchema,
    title: metaTitle
  }}
>
  <div
    aria-hidden="true"
    role="presentation"
    class="
      fixed top-0 left-0 z-50 h-1.5 bg-linear-to-r from-brand to-brand-soft
      shadow-[0_0_10px_hsl(var(--brand)/0.22)] transition-all duration-150
      ease-out
    "
    style="width: 0%"
    x-data="{
      percent: 0,
      updateProgress() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        this.percent = (winScroll / height) * 100;
      }
    }"
    x-init="window.addEventListener('scroll', () => updateProgress())"
    :style="`width: ${percent}%`"
  >
  </div>

  <article class="mx-auto flex w-full max-w-6xl flex-col gap-12">
    <ProjectHero project={project} />

    <section
      class="
        grid gap-10 border-t border-line/70 pt-10
        lg:grid-cols-[minmax(0,1fr)_18rem]
      "
      data-animate
    >
      <div class="min-w-0 space-y-8">
        <div class="section-shell-subtle space-y-6">
          <div class="
            flex flex-wrap items-start justify-between gap-4 border-b
            border-line/60 pb-6
          "
          >
            <div class="space-y-2">
              <p class="section-label">Case study notes</p>
              <p class="max-w-2xl text-sm/6 text-ink-soft">
                A closer look at the delivery decisions, technical tradeoffs, and product constraints behind this work.
              </p>
            </div>
            <Pill label={projectStageLabel} tone="brand" />
          </div>

          <div class="prose-project prose-santi max-w-none">
            <slot />
          </div>
        </div>

        <footer
          class="
            flex flex-col gap-6 border-t border-line pt-8
            sm:flex-row sm:items-center sm:justify-between
          "
        >
          <a
            href="/portfolio/"
            class="
              group inline-flex items-center gap-2 font-medium text-ink
              transition-colors
              hover:text-brand
            "
          >
            <Icon
              aria-hidden="true"
              class="
                size-5 transition-transform
                group-hover:-translate-x-1
              "
              name="tabler:arrow-left"
            />
            Back to portfolio
          </a>

          <div class="section-actions">
            {project.data.liveDemoUrl && (
              <ButtonLink href={project.data.liveDemoUrl} newTab showArrow variant="secondary">
                View live project
              </ButtonLink>
            )}
            {project.data.githubUrl && (
              <ButtonLink href={project.data.githubUrl} newTab showArrow variant="ghost">
                Open repository
              </ButtonLink>
            )}
          </div>
        </footer>
      </div>

      <aside class="
        editorial-rail
        lg:self-start
      "
      >
        <div class="mini-note">
          <p class="section-label">At a glance</p>
          <dl class="mt-4 space-y-4 text-sm/6 text-ink-soft">
            <div class="flex flex-col">
              <dt class="flex items-center gap-2 section-label">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand"
                  name="tabler:briefcase-2"
                />
                <span>Type</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                {projectTypeLabel}
              </dd>
            </div>

            <div class="flex flex-col">
              <dt class="flex items-center gap-2 section-label">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand"
                  name="tabler:user-star"
                />
                <span>Role</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                {project.data.rol ?? 'Hands-on builder'}
              </dd>
            </div>

            <div class="flex flex-col">
              <dt class="flex items-center gap-2 section-label">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand"
                  name="tabler:calendar-time"
                />
                <span>Timeline</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                {timelineLabel}
              </dd>
            </div>

            <div class="flex flex-col">
              <dt class="flex items-center gap-2 section-label">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand"
                  name="tabler:hourglass"
                />
                <span>Duration</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                {durationLabel}
              </dd>
            </div>
          </dl>
        </div>

        <div class="mini-note">
          <p class="section-label">Focus</p>
          <p class="mt-3 text-sm/6 text-ink-soft">{focusLabel}</p>
        </div>

        <div class="mini-note">
          <p class="section-label">Core stack</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {stackPreview.map(technology => (
              <Pill label={technology} tone="outline" />
            ))}
          </div>
        </div>

        {!!project.data.impactMetrics.length && (
          <div class="mini-note">
            <p class="section-label">Outcomes</p>
            <ul class="mt-4 list-none space-y-3 p-0">
              {project.data.impactMetrics.map(metric => (
                <li class="
                  rounded-2xl border border-brand/12 bg-brand-soft/35 px-4 py-3
                  text-sm/6 text-ink
                "
                >
                  {metric}
                </li>
              ))}
            </ul>
          </div>
        )}

        {!!headings.length && <TocCard headings={headings} />}
      </aside>
    </section>
  </article>

  {!!relatedProjects.length && (
    <section class="editorial-section" data-animate>
      <div class="space-y-3">
        <p class="section-label">Related work</p>
        <h2 class="text-3xl">More case studies in a similar lane.</h2>
      </div>
      <div class="
        grid gap-6
        lg:grid-cols-2
      "
      >
        {relatedProjects.map((relatedProject, index) => (
          <ProjectCard featured={index === 0} project={relatedProject} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
