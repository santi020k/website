---
import { type CollectionEntry, render } from 'astro:content'

import BaseLayout from './Base.astro'

import ProjectCard from '../components/molecules/ProjectCard.astro'
import TocCard from '../components/molecules/TocCard.astro'
import ProjectHero from '../components/organisms/ProjectHero.astro'

interface Props {
  project: CollectionEntry<'project'>
  relatedProjects?: CollectionEntry<'project'>[]
}

const { project, relatedProjects = [] } = Astro.props
const metaTitle = project.data.seoTitle ?? `${project.data.title} · ${project.data.rol ?? 'Project'}`
const metaDescription = project.data.seoDescription ?? project.data.description
// Use Dynamic OG Image generator (/og/portfolio/[id].png)
const socialImage = new URL(`/og/portfolio/${project.id}.png`, Astro.site).href
const { headings } = await render(project)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const sameAs = [project.data.githubUrl, project.data.liveDemoUrl].filter(Boolean)
const hasLiveDemo = Boolean(project.data.liveDemoUrl)

const projectSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': hasLiveDemo ? ['CreativeWork', 'SoftwareApplication'] : 'CreativeWork',
  name: project.data.title,
  description: metaDescription,
  dateCreated: project.data.startingDate.toISOString(),
  ...(project.data.endingDate ? { dateModified: project.data.endingDate.toISOString() } : {}),
  keywords: project.data.technologies,
  url: canonicalURL.href,
  ...(project.data.coverImage?.ogImage ? { image: new URL(project.data.coverImage.ogImage, Astro.site).href } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
  author: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' },
  { name: project.data.title, url: Astro.url.pathname }
]

---

<BaseLayout
  meta={{
    breadcrumbs,
    description: metaDescription,
    ogImage: socialImage,
    structuredData: projectSchema,
    title: metaTitle
  }}
>
  <ProjectHero project={project} />

  <section class="
    grid gap-8
    lg:grid-cols-[minmax(0,1fr)_18rem]
  "
  >
    <article class="
      rounded-4xl p-6 panel-surface
      sm:p-8
    "
    >
      <slot />
    </article>

    <div class="
      space-y-6
      lg:sticky lg:top-32 lg:h-fit
    "
    >
      {!!headings.length && <TocCard headings={headings} />}
    </div>
  </section>

  {!!relatedProjects.length && (
    <section class="space-y-8">
      <div class="space-y-3">
        <p class="
          text-sm font-semibold tracking-[0.2em] text-ink-muted uppercase
        "
        >Related work
        </p>
        <h2 class="text-3xl">More projects in a similar lane.</h2>
      </div>
      <div class="
        grid gap-6
        lg:grid-cols-2
      "
      >
        {relatedProjects.map(relatedProject => (
          <ProjectCard project={relatedProject} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
