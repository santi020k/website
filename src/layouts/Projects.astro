---
import { type CollectionEntry, render } from 'astro:content'
import { Icon } from 'astro-icon/components'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import ProjectPreviewCard from '@/components/molecules/ProjectPreviewCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import ShareButtons from '@/components/molecules/ShareButtons.astro'
import TocCard from '@/components/molecules/TocCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import ProjectHero from '@/components/organisms/ProjectHero.astro'

import {
  getProjectDurationLabel,
  getProjectFocusLabel,
  getProjectNotesDescription,
  getProjectNotesLabel,
  getProjectRelatedHeading,
  getProjectStageLabel,
  getProjectTimelineLabel,
  getProjectTypeLabel
} from '@/utils/project-meta'

import ReadingProgressBar from '@/components/shared/ReadingProgressBar.astro'
import BaseLayout from '@/layouts/Base.astro'

interface Props {
  project: CollectionEntry<'project'>
  relatedProjects?: CollectionEntry<'project'>[]
}

const { project, relatedProjects = [] } = Astro.props
const metaTitle = project.data.seoTitle ?? `${project.data.title} · ${project.data.role ?? 'Project'}`
const metaDescription = project.data.seoDescription ?? project.data.description
// Use Dynamic OG Image generator (/og/portfolio/[id].webp)
const socialImage = new URL(`/og/portfolio/${project.id}.webp`, Astro.site).href
const { headings } = await render(project)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const sameAs = [project.data.githubUrl, project.data.liveDemoUrl].filter(Boolean)
const hasLiveDemo = Boolean(project.data.liveDemoUrl)
const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const focusLabel = getProjectFocusLabel(project.data.typesId)
const timelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const durationLabel = getProjectDurationLabel(project.data.startingDate, project.data.endingDate)
const stackPreview = project.data.technologies.slice(0, 6)
const projectStageLabel = getProjectStageLabel(project.data.typesId, project.data.endingDate)
const projectNotesLabel = getProjectNotesLabel(project.data.typesId)
const projectNotesDescription = getProjectNotesDescription(project.data.typesId)
const projectRelatedHeading = getProjectRelatedHeading(project.data.typesId)
const startIso = project.data.startingDate.toISOString().slice(0, 7)
const endIso = project.data.endingDate?.toISOString().slice(0, 7)
const caseStudy = project.data.caseStudy

const caseStudyRows = caseStudy ?
  [
    { body: caseStudy.problem, label: 'Problem' },
    { body: caseStudy.approach, label: 'Approach' },
    { body: caseStudy.outcome, label: 'Outcome' },
    { body: caseStudy.metrics, label: 'Metrics' }
  ].filter((row): row is { body: string, label: string } => Boolean(row.body?.trim())) :
  []

const projectSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': hasLiveDemo ? ['CreativeWork', 'SoftwareApplication'] : 'CreativeWork',
  name: project.data.title,
  description: metaDescription,
  dateCreated: project.data.startingDate.toISOString(),
  ...(project.data.endingDate ? { dateModified: project.data.endingDate.toISOString() } : {}),
  keywords: project.data.technologies,
  url: canonicalURL.href,
  ...(project.data.coverImage?.ogImage ? { image: new URL(project.data.coverImage.ogImage, Astro.site).href } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
  author: {
    '@type': 'Person',
    name: 'Santiago Molina',
    url: Astro.site?.href
  }
}

const parentPage = project.data.typesId === 'personal' ?
  { name: 'Projects', url: '/projects/' } :
  { name: 'Work', url: '/work/' }

const breadcrumbs = [
  { name: 'Home', url: '/' },
  parentPage,
  { name: project.data.title, url: Astro.url.pathname }
]

---

<BaseLayout
  meta={{
    breadcrumbs,
    description: metaDescription,
    ogImage: socialImage,
    ogImageAlt: `${metaTitle} — ${projectTypeLabel.toLowerCase()} by Santiago Molina`,
    structuredData: projectSchema,
    title: metaTitle
  }}
>
  <ReadingProgressBar />

  <article class="mx-auto flex w-full max-w-6xl flex-col gap-10">
    <ProjectHero parentPage={parentPage} project={project} />

    <section
      class="
        grid grid-cols-1 gap-10 section-divider
        lg:grid-cols-[minmax(0,1fr)_18rem]
      "
      data-animate="fade"
    >
      <div class="min-w-0 space-y-8">
        <div class="section-shell-subtle space-y-6">
          <div class="
            -mx-4 -mt-8 mb-2 flex flex-wrap items-start justify-between
            gap-4 card-divider bg-brand-soft/10 px-4
            pt-8
            sm:-mx-8 sm:px-8
          "
          >
            <div class="space-y-2">
              <p class="section-label">{projectNotesLabel}</p>
              <p class="max-w-2xl text-sm/6 text-ink-soft">{projectNotesDescription}</p>
            </div>
            <Pill label={projectStageLabel} tone="brand" />
          </div>

          {!!caseStudyRows.length && (
            <div
              aria-label="Case study summary"
              class="glass-pro rounded-2xl p-1"
              role="region"
            >
              <div class="divide-y divide-line/20">
                {caseStudyRows.map((row, i) => (
                  <div
                    class="
                      group flex gap-4 px-5 py-4 transition-colors
                      duration-300 hover:bg-brand-soft/10
                      sm:gap-6 sm:px-6
                    "
                  >
                    <div
                      class="
                        mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center
                        rounded-lg bg-brand/10 text-xs font-bold
                        tabular-nums text-brand transition-colors
                        group-hover:bg-brand/20
                      "
                    >
                      {String(i + 1).padStart(2, '0')}
                    </div>
                    <div class="min-w-0 space-y-1">
                      <p class="section-label text-brand/80">{row.label}</p>
                      <p class="text-sm/6 text-ink">{row.body}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="prose-project prose-santi max-w-none">
            <slot />
          </div>
        </div>

        <ShareButtons title={project.data.title} url={canonicalURL.href} />

        <footer
          class="
            flex flex-col gap-6 section-divider-compact
            sm:flex-row sm:items-center sm:justify-between
          "
        >
          <a
            href={parentPage.url}
            class="
              group inline-flex items-center gap-2 font-medium text-ink
              transition-colors
              hover:text-brand
            "
          >
            <Icon
              aria-hidden="true"
              class="
                size-5 transition-transform
                group-hover:-translate-x-1
              "
              name="tabler:arrow-left"
            />
            Back to {parentPage.name.toLowerCase()}
          </a>

          <div class="flex flex-wrap items-center gap-3">
            {project.data.liveDemoUrl && (
              <ButtonLink href={project.data.liveDemoUrl} newTab showArrow>
                View live project
              </ButtonLink>
            )}
            {project.data.githubUrl && (
              <ButtonLink href={project.data.githubUrl} newTab showArrow variant="secondary">
                Open repository
              </ButtonLink>
            )}
            <a
              href="#main"
              class="
                group inline-flex items-center gap-1.5 text-sm font-medium
                text-ink-muted transition-colors
                hover:text-brand
                motion-reduce:transition-none
              "
            >
              <Icon
                aria-hidden="true"
                class="
                  size-4 transition-transform
                  group-hover:-translate-y-0.5
                  motion-reduce:transition-none
                "
                name="tabler:arrow-up"
              />
              Back to top
            </a>
          </div>
        </footer>
      </div>

      <aside
        aria-label="Project details"
        class="
          min-w-0 editorial-rail
          lg:self-start
        "
      >
        <div
          aria-hidden="true"
          class="
            -mx-4 mb-6 h-px bg-linear-to-r from-transparent via-brand/40
            to-transparent
            sm:-mx-0
            lg:hidden
          "
        />
        {headings.length ?
          <TocCard headings={headings} /> :
          (
            <div class="glass-pro rounded-2xl px-5 py-4 text-sm/6 text-ink-muted">
              <Icon aria-hidden="true" class="mb-2 size-4 text-brand/50" name="tabler:file-text" />
              <p>No sections to navigate — this project has a single-page write-up.</p>
            </div>
          )}

        <div aria-labelledby="sidebar-glance" class="glass-pro rounded-2xl p-5">
          <p class="section-label flex items-center gap-2" id="sidebar-glance">
            <Icon aria-hidden="true" class="size-4 text-brand" name="tabler:info-circle" />
            At a glance
          </p>
          <dl class="mt-4 space-y-3 text-sm/6 text-ink-soft">
            <div class="group flex items-start justify-between gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-brand-soft/10">
              <dt class="flex items-center gap-2 section-label whitespace-nowrap">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand/70"
                  name="tabler:briefcase-2"
                />
                <span>Type</span>
              </dt>
              <dd class="text-sm font-medium text-ink text-end">
                {projectTypeLabel}
              </dd>
            </div>

            <div class="group flex items-start justify-between gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-brand-soft/10">
              <dt class="flex items-center gap-2 section-label whitespace-nowrap">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand/70"
                  name="tabler:user-star"
                />
                <span>Role</span>
              </dt>
              <dd class="text-sm font-medium text-ink text-end">
                {project.data.role ?? 'Hands-on builder'}
              </dd>
            </div>

            <div class="group flex items-start justify-between gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-brand-soft/10">
              <dt class="flex items-center gap-2 section-label whitespace-nowrap">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand/70"
                  name="tabler:calendar-time"
                />
                <span>Timeline</span>
              </dt>
              <dd class="text-sm font-medium text-ink text-end">
                <time datetime={endIso ? `${startIso}/${endIso}` : startIso}>{timelineLabel}</time>
              </dd>
            </div>

            <div class="group flex items-start justify-between gap-3 rounded-lg px-2 py-1.5 transition-colors hover:bg-brand-soft/10">
              <dt class="flex items-center gap-2 section-label whitespace-nowrap">
                <Icon
                  aria-hidden="true"
                  class="size-4 shrink-0 text-brand/70"
                  name="tabler:hourglass"
                />
                <span>Duration</span>
              </dt>
              <dd class="text-sm font-medium text-ink text-end">
                {durationLabel}
              </dd>
            </div>
          </dl>
        </div>

        <div aria-labelledby="sidebar-focus" class="glass-pro rounded-2xl p-5">
          <p class="section-label flex items-center gap-2" id="sidebar-focus">
            <Icon aria-hidden="true" class="size-4 text-brand" name="tabler:target" />
            Focus
          </p>
          <p class="mt-3 text-sm/6 text-ink-soft">{focusLabel}</p>
        </div>

        <div aria-labelledby="sidebar-stack" class="glass-pro rounded-2xl p-5">
          <p class="section-label flex items-center gap-2" id="sidebar-stack">
            <Icon aria-hidden="true" class="size-4 text-brand" name="tabler:stack-2" />
            Core stack
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {stackPreview.map(technology => (
              <Pill label={technology} tone="outline" />
            ))}
            {project.data.technologies.length > 6 && (
              <Pill label={`+${project.data.technologies.length - 6} more`} tone="outline" />
            )}
          </div>
        </div>

        {!!project.data.impactMetrics.length && (
          <div aria-labelledby="sidebar-outcomes" class="glass-pro rounded-2xl p-5">
            <p class="section-label flex items-center gap-2" id="sidebar-outcomes">
              <Icon aria-hidden="true" class="size-4 text-brand" name="tabler:trophy" />
              Outcomes
            </p>
            <ul class="mt-4 list-none space-y-2 p-0">
              {project.data.impactMetrics.map(metric => (
                <li
                  class="
                    group flex items-start gap-3 rounded-xl px-3 py-2.5
                    transition-colors hover:bg-brand-soft/20
                  "
                >
                  <div
                    class="
                      mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center
                      rounded-full bg-brand/15 text-brand transition-colors
                      group-hover:bg-brand/25
                    "
                  >
                    <Icon
                      aria-hidden="true"
                      class="size-3.5"
                      name="tabler:check"
                    />
                  </div>
                  <span class="text-sm/6 font-medium text-ink">{metric}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </section>
  </article>

  {!!relatedProjects.length && (
    <PageSection>
      <SectionHeader
        eyebrow="Related work"
        title={projectRelatedHeading}
        description="More work from a similar lane — same type, overlapping technologies, adjacent problems."
      />
      <div class:list={[
        'grid gap-6',
        relatedProjects.length > 1 && 'sm:grid-cols-2'
      ]}
      >
        {relatedProjects.map(relatedProject => (
          <ProjectPreviewCard project={relatedProject} />
        ))}
      </div>
    </PageSection>
  )}

</BaseLayout>
