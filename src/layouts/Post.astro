---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import readingTime from 'reading-time'

import BaseLayout from './Base.astro'

import CoverImage from '../components/atoms/CoverImage.astro'
import FormattedDate from '../components/atoms/FormattedDate.astro'
import Pill from '../components/atoms/Pill.astro'
import RelatedPosts from '../components/molecules/RelatedPosts.astro'
import ShareButtons from '../components/molecules/ShareButtons.astro'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate } = post.data
// Use Dynamic OG Image generator (/og/blog/[id].png)
const ogImage = new URL(`/og/blog/${post.id}.png`, Astro.site).href
const stats = readingTime(post.body ?? '')
const readingTimeText = stats.text
const wordCount = Math.round(stats.words)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const coverAspectRatio = post.data.coverImage ?
  post.data.coverImage.src.width / post.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08

const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  inLanguage: 'en-US',
  wordCount,
  keywords: post.data.tags,
  image: ogImage,
  url: canonicalURL.href,
  author: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  },
  publisher: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title, url: Astro.url.pathname }
]

---

<BaseLayout
  meta={{
    articleDate: publishDate.toISOString(),
    articleUpdated: updatedDate?.toISOString(),
    breadcrumbs,
    description,
    ogImage,
    structuredData: blogPostingSchema,
    title
  }}
>
  <div
    class="
      fixed top-0 left-0 z-50 h-1.5 bg-linear-to-r from-brand to-brand-soft
      shadow-[0_0_10px_hsl(var(--brand)/0.22)] transition-all duration-150
      ease-out
    "
    style="width: 0%"
    x-data="{
      percent: 0,
      updateProgress() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        this.percent = (winScroll / height) * 100;
      }
    }"
    x-init="window.addEventListener('scroll', () => updateProgress())"
    :style="`width: ${percent}%`"
  >
  </div>

  <article class="mx-auto flex w-full max-w-6xl flex-col gap-12">
    <header
      class="
        grid gap-10 border-b border-line/70 pb-10
        lg:grid-cols-[minmax(0,1fr)_17rem]
      "
      data-animate
    >
      <div class="space-y-8">
        <div class="flex items-center gap-2 text-sm font-medium text-ink-muted">
          <a
            href="/blog/"
            class="
              transition-colors
              hover:text-brand
            "
          >Blog
          </a>
          <Icon aria-hidden="true" name="tabler:chevron-right" class="size-4" />
          <span class="text-ink-soft">Post</span>
        </div>

        <div class="flex flex-col gap-4">
          <h1 class="
            max-w-4xl text-4xl/tight font-bold
            sm:text-5xl
            lg:text-6xl
          "
          >
            {title}
          </h1>

          <p class="
            max-w-3xl text-lg/8 text-ink-soft
            sm:text-xl/8
          "
          >{description}
          </p>
        </div>

        {post.data.coverImage && (
          <div class:list={[
            'panel-card overflow-hidden',
            !useWideCoverFrame && 'mx-auto w-full max-w-4xl'
          ]}
          >
            <CoverImage
              alt={post.data.coverImage.alt}
              fetchpriority="high"
              image={post.data.coverImage.src}
              loading="eager"
              mode="detail"
              sizes="(min-width: 1024px) 960px, 100vw"
            />
          </div>
        )}
      </div>

      <aside class="editorial-rail">
        <div class="mini-note">
          <p class="section-label">Reading guide</p>
          <dl class="mt-4 space-y-4 text-sm/6 text-ink-soft">
            <div class="flex flex-col">
              <dt
                class="
                  flex items-center gap-2 text-xs font-semibold
                  tracking-[0.18em] text-ink-muted uppercase
                "
              >
                <Icon aria-hidden="true" name="tabler:calendar" class="size-4" />
                <span>Published</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                <FormattedDate date={publishDate} />
              </dd>
            </div>

            <div class="flex flex-col">
              <dt
                class="
                  flex items-center gap-2 text-xs font-semibold
                  tracking-[0.18em] text-ink-muted uppercase
                "
              >
                <Icon aria-hidden="true" name="tabler:clock" class="size-4" />
                <span>Read time</span>
              </dt>
              <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                {readingTimeText}
              </dd>
            </div>

            {updatedDate && (
              <div class="flex flex-col">
                <dt
                  class="
                    flex items-center gap-2 text-xs font-semibold
                    tracking-[0.18em] text-ink-muted uppercase
                  "
                >
                  <Icon
                    aria-hidden="true"
                    name="tabler:refresh"
                    class="size-4"
                  />
                  <span>Updated</span>
                </dt>
                <dd class="mt-1.5 pl-6 text-sm font-medium text-ink">
                  <FormattedDate date={updatedDate} />
                </dd>
              </div>
            )}
          </dl>
        </div>

        {canonicalUrl && (
          <div class="mini-note">
            <p class="section-label">Originally published</p>
            <a
              href={canonicalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="
                mt-3 inline-flex items-center gap-2 text-sm font-medium text-ink
                transition-colors
                hover:text-brand
              "
            >
              <Icon
                aria-hidden="true"
                name="tabler:external-link"
                class="size-4"
              />
              <span>Read on Medium</span>
            </a>
          </div>
        )}
      </aside>
    </header>

    <div
      class="prose-santi mx-auto w-full max-w-3xl animate-fade-in"
      style="animation-delay: 120ms"
    >
      <slot />
      <div class="mt-16">
        <ShareButtons title={title} url={canonicalURL.href} />
      </div>
    </div>

    <footer
      class="
        mt-16 flex animate-fade-in flex-col gap-10 border-t border-line pt-10
      "
      style="animation-delay: 220ms"
    >
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map(tag => (
          <Pill label={tag} showHash tone="outline" />
        ))}
      </div>

      <div class="flex items-center justify-between">
        <a
          href="/blog/"
          class="
            group flex items-center gap-2 font-medium text-ink transition-colors
            hover:text-brand
          "
        >
          <Icon
            aria-hidden="true"
            name="tabler:arrow-left"
            class="
              size-5 transition-transform
              group-hover:-translate-x-1
            "
          />
          Back to blog
        </a>
      </div>
    </footer>
  </article>

  <div class="mx-auto w-full max-w-6xl space-y-20">
    <RelatedPosts currentPostId={post.id} tags={post.data.tags} />
  </div>

  <script>
    const COPY_ICON = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
    `.trim();

    const CHECK_ICON = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="size-4 text-green-500">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    `.trim();

    function setupEnhancedCodeBlocks() {
      const codeFigures = document.querySelectorAll('figure[data-rehype-pretty-code-figure]');

      for (const figure of codeFigures) {
        const pre = figure.querySelector('pre');
        if (!pre || figure.querySelector('.code-header')) continue;

        const lang = figure.getAttribute('data-language') || 'code';
        const titleEl = figure.querySelector('[data-rehype-pretty-code-title]');
        const titleText = titleEl ? titleEl.textContent : '';

        // Create Header
        const header = document.createElement('div');
        header.className = 'code-header';

        // Window Controls
        const controls = document.createElement('div');
        controls.className = 'window-controls';
        controls.innerHTML = `
          <span class="window-dot red"></span>
          <span class="window-dot yellow"></span>
          <span class="window-dot green"></span>
        `;
        header.appendChild(controls);

        // Title / Language Badge Container
        const centerContainer = document.createElement('div');
        centerContainer.className = 'code-title-container';

        if (titleText) {
          centerContainer.innerHTML = `
            <span class="lang-badge">${lang}</span>
            <span class="truncate">${titleText}</span>
          `;
        } else {
          centerContainer.innerHTML = `<span class="lang-badge">${lang}</span>`;
        }
        header.appendChild(centerContainer);

        // Copy Button
        const copyButton = document.createElement('button');
        copyButton.className = 'copy-button';
        copyButton.setAttribute('aria-label', 'Copy code');
        copyButton.innerHTML = COPY_ICON;

        copyButton.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;

          await navigator.clipboard.writeText(text);

          copyButton.innerHTML = CHECK_ICON;
          copyButton.classList.add('copied');

          setTimeout(() => {
            copyButton.innerHTML = COPY_ICON;
            copyButton.classList.remove('copied');
          }, 2000);
        });

        header.appendChild(copyButton);

        // Prepend header to figure
        figure.insertBefore(header, pre);
      }
    }

    // Run on initial load
    setupEnhancedCodeBlocks();

    // Run on view transitions
    document.addEventListener('astro:after-swap', setupEnhancedCodeBlocks);
  </script>
</BaseLayout>
