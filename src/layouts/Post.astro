---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import readingTime from 'reading-time'

import BaseLayout from './Base.astro'

import FormattedDate from '../components/atoms/FormattedDate.astro'
import RelatedPosts from '../components/molecules/RelatedPosts.astro'
import ShareButtons from '../components/molecules/ShareButtons.astro'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate } = post.data
// Use Dynamic OG Image generator (/og/blog/[id].png)
const ogImage = new URL(`/og/blog/${post.id}.png`, Astro.site).href
const stats = readingTime(post.body ?? '')
const readingTimeText = stats.text
const wordCount = Math.round(stats.words)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  inLanguage: 'en-US',
  wordCount,
  keywords: post.data.tags,
  image: ogImage,
  url: canonicalURL.href,
  author: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  },
  publisher: {
    '@type': 'Person',
    name: 'Santiago Molina Orozco',
    url: Astro.site?.href
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title, url: Astro.url.pathname }
]

---

<BaseLayout
  meta={{
    articleDate: publishDate.toISOString(),
    articleUpdated: updatedDate?.toISOString(),
    breadcrumbs,
    description,
    ogImage,
    structuredData: blogPostingSchema,
    title
  }}
>
  <div
    class="
      fixed top-0 left-0 z-50 h-1.5 bg-linear-to-r from-brand to-brand-soft
      shadow-[0_0_10px_rgba(var(--color-brand),0.5)] transition-all duration-150
      ease-out
    "
    style="width: 0%"
    x-data="{
      percent: 0,
      updateProgress() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        this.percent = (winScroll / height) * 100;
      }
    }"
    x-init="window.addEventListener('scroll', () => updateProgress())"
    :style="`width: ${percent}%`"
  >
  </div>

  <article class="mx-auto flex w-full max-w-6xl flex-col gap-10">
    <header class="flex animate-slide-up flex-col gap-6">
      <div class="flex items-center gap-2 text-sm font-medium text-ink-muted">
        <a
          href="/blog/"
          class="
            transition-colors
            hover:text-brand
          "
        >Blog
        </a>
        <Icon name="tabler:chevron-right" class="size-4" />
        <span class="text-ink-soft">Post</span>
      </div>

      <div class="flex flex-col gap-4">
        <h1 class="
          text-4xl/tight font-bold
          sm:text-5xl
          lg:text-6xl
        "
        >
          {title}
        </h1>

        <div class="
          flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-soft
        "
        >
          <div class="flex items-center gap-2">
            <Icon name="tabler:calendar" class="size-4" />
            <FormattedDate date={publishDate} />
          </div>
          <div class="flex items-center gap-2">
            <Icon name="tabler:clock" class="size-4" />
            <span>{readingTimeText}</span>
          </div>
          {updatedDate && (
            <div class="flex items-center gap-2">
              <Icon name="tabler:refresh" class="size-4" />
              <span>Updated: <FormattedDate date={updatedDate} /></span>
            </div>
          )}
          {canonicalUrl && (
            <a
              href={canonicalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="
                flex items-center gap-2 transition-colors
                hover:text-brand
              "
            >
              <Icon name="tabler:external-link" class="size-4" />
              <span>Original on Medium</span>
            </a>
          )}
        </div>
      </div>

      {post.data.coverImage && (
        <div class="
          relative aspect-video overflow-hidden rounded-2xl subtle-outline
        "
        >
          <Image
            src={post.data.coverImage.src}
            alt={post.data.coverImage.alt}
            class="size-full object-cover"
            inferSize
          />
        </div>
      )}
    </header>

    <div class="
      prose-santi mx-auto w-full max-w-3xl animate-fade-in
      [animation-delay:200ms]
    "
    >
      <slot />
      <div class="mt-16">
        <ShareButtons title={title} url={canonicalURL.href} />
      </div>
    </div>

    <footer class="
      mt-20 flex animate-fade-in flex-col gap-10 border-t border-line pt-10
      [animation-delay:400ms]
    "
    >
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map(tag => (
          <span class="
            rounded-full bg-surface-muted px-4 py-1.5 text-sm font-medium
            text-ink-soft subtle-outline
          "
          >
            #{tag}
          </span>
        ))}
      </div>

      <div class="flex items-center justify-between">
        <a
          href="/blog/"
          class="
            group flex items-center gap-2 font-medium text-ink transition-colors
            hover:text-brand
          "
        >
          <Icon
            name="tabler:arrow-left"
            class="
              size-5 transition-transform
              group-hover:-translate-x-1
            "
          />
          Back to blog
        </a>
      </div>
    </footer>
  </article>

  <div class="mx-auto w-full max-w-6xl space-y-20">
    <RelatedPosts currentPostId={post.id} tags={post.data.tags} />
  </div>

  <script>
    const COPY_ICON = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
    `.trim();

    const CHECK_ICON = `
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="size-4 text-green-500">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    `.trim();

    function setupEnhancedCodeBlocks() {
      const codeFigures = document.querySelectorAll('figure[data-rehype-pretty-code-figure]');

      for (const figure of codeFigures) {
        const pre = figure.querySelector('pre');
        if (!pre || figure.querySelector('.code-header')) continue;

        const lang = figure.getAttribute('data-language') || 'code';
        const titleEl = figure.querySelector('[data-rehype-pretty-code-title]');
        const titleText = titleEl ? titleEl.textContent : '';

        // Create Header
        const header = document.createElement('div');
        header.className = 'code-header';

        // Window Controls
        const controls = document.createElement('div');
        controls.className = 'window-controls';
        controls.innerHTML = `
          <span class="window-dot red"></span>
          <span class="window-dot yellow"></span>
          <span class="window-dot green"></span>
        `;
        header.appendChild(controls);

        // Title / Language Badge Container
        const centerContainer = document.createElement('div');
        centerContainer.className = 'code-title-container';

        if (titleText) {
          centerContainer.innerHTML = `
            <span class="lang-badge">${lang}</span>
            <span class="truncate">${titleText}</span>
          `;
        } else {
          centerContainer.innerHTML = `<span class="lang-badge">${lang}</span>`;
        }
        header.appendChild(centerContainer);

        // Copy Button
        const copyButton = document.createElement('button');
        copyButton.className = 'copy-button';
        copyButton.setAttribute('aria-label', 'Copy code');
        copyButton.innerHTML = COPY_ICON;

        copyButton.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;

          await navigator.clipboard.writeText(text);

          copyButton.innerHTML = CHECK_ICON;
          copyButton.classList.add('copied');

          setTimeout(() => {
            copyButton.innerHTML = COPY_ICON;
            copyButton.classList.remove('copied');
          }, 2000);
        });

        header.appendChild(copyButton);

        // Prepend header to figure
        figure.insertBefore(header, pre);
      }
    }

    // Run on initial load
    setupEnhancedCodeBlocks();

    // Run on view transitions
    document.addEventListener('astro:after-swap', setupEnhancedCodeBlocks);
  </script>
</BaseLayout>
