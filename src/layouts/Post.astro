---
import type { MarkdownHeading } from 'astro'

import type { CollectionEntry } from 'astro:content'
import { WEBMENTION_API_KEY } from 'astro:env/server'

import ArticleCodeRecovery from '@/components/molecules/ArticleCodeRecovery.astro'
import ArticleExampleFolds from '@/components/molecules/ArticleExampleFolds.astro'
import ArticleFigureViewers from '@/components/molecules/ArticleFigureViewers.astro'
import ArticleSectionReferences from '@/components/molecules/ArticleSectionReferences.astro'
import CommentsSection from '@/components/molecules/CommentsSection.astro'
import NewsletterSignup from '@/components/molecules/NewsletterSignup.astro'
import ProjectFooterNav from '@/components/molecules/ProjectFooterNav.astro'
import ReadingChapterOpener from '@/components/molecules/ReadingChapterOpener.astro'
import ReadingContents from '@/components/molecules/ReadingContents.astro'
import RelatedPosts from '@/components/molecules/RelatedPosts.astro'
import SeriesNavigator from '@/components/molecules/SeriesNavigator.astro'
import ShareButtons from '@/components/molecules/ShareButtons.astro'
import WebmentionsSection from '@/components/molecules/WebmentionsSection.astro'
import PostHero from '@/components/organisms/PostHero.astro'
import BaseLayout from '@/layouts/Base.astro'

import type { PrintReference } from '@/plugins/rehype-print-references'
import { getArticlePageImprint } from '@/utils/article-page-imprint'
import { getPostSlug } from '@/utils/posts'
import { getReadingStats } from '@/utils/reading-time'
import { getSocialImageURL } from '@/utils/social-image'
import { fetchWebmentionsForTarget } from '@/utils/webmentions-fetch'

import '@/styles/article-print.css'

import { ScrollProgress } from '@santi020k/lumen-astro'

import { ogManifest } from '@/data/og-manifest'
import { getSeriesContext } from '@/data/series'
import {
  createAuthorSchema,
  createPublisherSchema,
  createWebsiteSchemaReference,
  siteConfig
} from '@/site.config'

interface Props {
  figureCaptions: string[]
  headings: MarkdownHeading[]
  post: CollectionEntry<'post'>
  printReferences: PrintReference[]
  recommendationUrls: string[]
}

const { figureCaptions, headings, post, printReferences, recommendationUrls } = Astro.props
const { canonicalUrl, description, publishDate, seoTitle, title, updatedDate } = post.data

const ogImage = getSocialImageURL(
  Astro.url.pathname,
  Astro.site,
  `/og/blog/${getPostSlug(post.id)}.webp`,
  ogManifest
)

const { words: wordCount } = getReadingStats(post.body)
const localURL = new URL(Astro.url.pathname, Astro.site)
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : localURL
const seriesContext = await getSeriesContext(post)
const hasContents = headings.some(heading => heading.depth <= 3)
const pageTargetUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://santi020k.com').href

const webmentions = WEBMENTION_API_KEY ?
  await fetchWebmentionsForTarget(pageTargetUrl, WEBMENTION_API_KEY) :
  []

const blogPostingSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  inLanguage: 'en-US',
  wordCount,
  keywords: post.data.tags,
  image: ogImage,
  url: canonicalURL.href,
  author: createAuthorSchema(Astro.site),
  publisher: createPublisherSchema(Astro.site),
  isPartOf: createWebsiteSchemaReference(Astro.site),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: title, url: Astro.url.pathname }
]

---

<BaseLayout
mainClass="remaining-pages remaining-pages--reading"
  meta={{
    articleDate: publishDate.toISOString(),
    articleUpdated: updatedDate?.toISOString(),
    breadcrumbs,
    canonicalUrl: canonicalURL.href,
    description,
    ogImage,
    ogImageAlt: post.data.coverImage?.alt ?
      `${post.data.coverImage.alt} — article on ${title}` :
      `Social preview card for the article "${title}"`,
    seoTitle,
    structuredData: blogPostingSchema,
    title
  }}
>
  <style is:inline data-article-page-imprint set:html={getArticlePageImprint(title)} />
  <ScrollProgress targetId="article-content" />

  <article class="h-entry section-container-wide flex flex-col" data-reading-layout>
    <!-- The h-entry permalink is metadata only, so it adds no focus stop or announcement. -->
    <data class="u-url" hidden value={localURL.href}></data>
    <PostHero post={post} />

    <!-- ── Body: prose + sticky TOC sidebar when the reading container has room ── -->
    <section
      class="grid grid-cols-1 gap-10"
      data-reading-body
    >
      <!-- The reading rail shares a boundary with prose, before the closing flow. -->
      <div class="min-w-0 space-y-10" data-post-story>
        {hasContents && (
          <div data-post-mobile-toc>
            <ReadingChapterOpener headings={headings} />
          </div>
        )}
        <div class="e-content max-w-none">
          <div class="prose-santi max-w-none" data-article-prose id="article-content">
            <slot />
          </div>
          {figureCaptions.length > 0 && <ArticleFigureViewers captions={figureCaptions} />}
          <ArticleSectionReferences headings={headings} url={localURL.href} />
          <ArticleExampleFolds />
          <ArticleCodeRecovery />
        </div>
      </div>

      <!-- A stretched grid cell bounds the sticky contents to the prose row. -->
      {hasContents && (
        <div class="min-w-0" data-post-rail-boundary>
          <aside aria-label="Article navigation" class="min-w-0 space-y-5" data-post-desktop-toc data-reading-rail>
            <ReadingContents headings={headings} />
          </aside>
        </div>
      )}

      <div class="min-w-0 space-y-10" data-post-continuation>
        {seriesContext && (
          <SeriesNavigator
            currentPostId={post.id}
            next={seriesContext.next}
            position={seriesContext.position}
            posts={seriesContext.posts}
            previous={seriesContext.previous}
            series={seriesContext.series}
            total={seriesContext.total}
          />
        )}

        <div data-article-closing id="article-close">
          <CommentsSection />

          <WebmentionsSection mentions={webmentions} />

          <ShareButtons title={title} url={localURL.href} variant="colophon" />
        </div>
      </div>
    </section>
    {printReferences.length > 0 && (
      <section data-article-print-references aria-labelledby="article-print-references-heading">
        <h2 id="article-print-references-heading">References</h2>
        <ol>
          {printReferences.map(({ href, label }, index) => (
            <li id={`article-print-reference-${index + 1}`}>
              <span>{label}</span>
              <a href={href} target="_blank" rel="noopener noreferrer">{href.replace(/^https:\/\//u, '')}</a>
            </li>
          ))}
        </ol>
      </section>
    )}
    <p data-article-print-source>
      <span>{title}</span>
      <a href={localURL.href}>{localURL.href}</a>
    </p>
  </article>

  {siteConfig.newsletter && (
    <aside aria-label="Newsletter" class="section-container-wide" data-article-newsletter>
      <NewsletterSignup formAction={siteConfig.newsletter.formAction} idSuffix="article" />
    </aside>
  )}

  <RelatedPosts currentPostId={post.id} excludeSeriesId={post.data.seriesId} excludeUrls={recommendationUrls} tags={post.data.tags} />

  <div class="section-container-wide" data-post-final-return>
    <ProjectFooterNav parentPage={{ name: 'Blog', url: '/blog/' }} variant="colophon" />
  </div>

</BaseLayout>

<style>
  [data-article-newsletter] { max-width: 56rem; margin-block: 3rem 0; }

  @container reading-layout (width < 40rem) {
    [data-reading-body] { padding-block-start: 1.75rem; }
    [data-post-mobile-toc] { margin-block-end: 1.75rem; }
  }

  /* The build-time Reference ledger belongs only to current article prose. */
  [data-article-prose] :global([data-article-references]) {
    --reference-accent: hsl(var(--brand));
    container: article-references / inline-size;
    margin-block: 2.125rem 2.5rem;
    color: hsl(var(--ink));
    font: 400 1rem/1.65 var(--font-sans);
  }
  :global([data-theme='dark']) [data-article-prose] :global([data-article-references]) {
    --reference-accent: hsl(var(--accent));
  }
  [data-article-prose] :global([data-series-connection]) { margin-block-end: 0; }
  [data-reading-body] :global(.e-content:has([data-series-connection])) { margin-block-end: 0; }
  [data-reading-body]:has(:global([data-series-content])) {
    row-gap: 0;
  }
  [data-reading-body]:has(:global([data-series-connection])) [data-post-continuation] :global([data-series-content]) {
    margin-block-start: 1.25rem;
  }
  [data-article-prose] :global([data-reference-header]) {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: .5rem;
    color: var(--reference-accent);
    font-size: .8125rem;
    font-weight: 500;
  }
  [data-article-prose] :global([data-reference-header] p) { margin: 0; }
  [data-article-prose] :global([data-reference-rule]) { flex: 1; height: 1px; background: hsl(var(--line)); }
  [data-article-prose] :global([data-article-references] svg) { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
  [data-article-prose] :global([data-article-references] ul) { margin: 0; padding: 0; list-style: none; }
  [data-article-prose] :global([data-article-references] li) { margin: 0; padding: 0; }
  [data-article-prose] :global([data-reference-link]) {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr) 1.5rem;
    align-items: start;
    column-gap: 1.125rem;
    min-height: 4.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid hsl(var(--line));
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  [data-article-prose] :global([data-reference-kind]) { padding-top: .1875rem; color: hsl(var(--ink-soft)); font-size: .75rem; }
  [data-article-prose] :global([data-reference-title]) { min-width: 0; font-weight: 500; }
  [data-article-prose] :global([data-reference-link] > [data-arrow-exchange]) { width: 1.125rem; height: 1.125rem; margin-top: .3125rem; color: var(--reference-accent); }
  [data-article-prose] :global([data-reference-source]) {
    display: block;
    margin-top: .1875rem;
    color: hsl(var(--ink-soft));
    font-size: .75rem;
    font-weight: 400;
  }
  [data-article-prose] :global([data-reference-link]:hover [data-reference-title]) { color: var(--reference-accent); }
  [data-article-prose] :global([data-reference-link]:focus-visible) { outline: 2px solid var(--reference-accent); outline-offset: 4px; }
  @container article-references (width < 32rem) {
    [data-article-prose] :global([data-reference-link]) { grid-template-columns: minmax(0, 1fr) 1.5rem; row-gap: .375rem; }
    [data-article-prose] :global([data-reference-kind]) { grid-column: 1; padding: 0; }
    [data-article-prose] :global([data-reference-title]) { grid-column: 1; grid-row: 2; }
    [data-article-prose] :global([data-reference-link] > [data-arrow-exchange]) { grid-column: 2; grid-row: 1 / 3; align-self: center; margin: 0; }
  }
</style>
