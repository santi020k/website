---
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects, getFormattedDate } from '@/utils/date'
import { getGitLastModified } from '@/utils/git'

import { ButtonLink, Icon, Link } from '@santi020k/lumen-astro'

import {
  AUTHOR_JOB_TITLE,
  CAREER_START_YEAR,
  createAuthorSchema,
  siteConfig
} from '@/site.config'

const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const projectsById = new Map(allProjects.map(project => [project.id.replace(/\/index$/u, ''), project]))

const selectResumeProjects = (ids: readonly string[]) => ids.map(id => {
  const project = projectsById.get(id)

  if (!project) throw new Error(`Missing resume project: ${id}`)

  return project
})

const workProjects = selectResumeProjects([
  'smith-commerce',
  'xgames',
  'void',
  'optic-power'
])

const earlierWork = selectResumeProjects([
  'pads',
  'datagran',
  'justbit',
  'nebular'
])

const communityWork = selectResumeProjects(['react-js-colombia'])
const resumeTechnologyLimit = 8
// Keep one crawlable PDF URL across deployments. The response revalidates at
// the edge, so cache busting does not need to create a new query URL per build.
const resumePdfPath = '/pdf/cv.pdf'
const fullResumePdfPath = '/pdf/cv-full.pdf'
const resumeDateCreated = '2024-01-01T00:00:00.000Z'

const resumeDescription =
  `Engineering leader and full-stack architect with ${new Date().getFullYear() - CAREER_START_YEAR}+ years building resilient products, ` +
  'modernizing frontend systems, and helping teams deliver with confidence.'

const resumeDateModified = getGitLastModified([
  'scripts/py/cv.md',
  'src/content/project',
  'src/pages/resume.astro',
  'src/site.config.ts'
], resumeDateCreated)

const resumePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: resumeDateCreated,
  dateModified: resumeDateModified,
  mainEntity: {
    ...createAuthorSchema(Astro.site),
    jobTitle: AUTHOR_JOB_TITLE,
    description: resumeDescription,
    mainEntityOfPage: new URL('/resume/', Astro.site ?? 'https://santi020k.com').href
  }
}
---

<PageLayout
  footerVariant="compact"
  meta={{
    description: resumeDescription,
    structuredData: resumePageSchema,
    title: 'Resume & Curriculum Vitae'
  }}
>
  <div
    class="
      glass-pro section-container-wide rounded-4xl p-5
      sm:p-8
      lg:p-10
      print:m-0 print:max-w-none print:rounded-none print:border-0
      print:bg-transparent print:p-0 print:shadow-none
    "
    data-resume-shell
  >
    <div class="
      mb-12 flex flex-col items-start justify-between gap-6
      sm:flex-row
      print:mb-6
    "
    >
      <div>
        <p class="
          section-label text-brand
          dark:text-accent
          print:text-black
        "
        >Resume
        </p>
        <h1
          class="
            mt-3 text-4xl/[0.98] font-extrabold tracking-[-0.06em] text-ink
            sm:text-5xl/[0.96]
            print:text-3xl print:tracking-tight
          "
        >
          {siteConfig.author}
        </h1>
        <p class="mt-2 text-xl text-brand">{AUTHOR_JOB_TITLE}</p>
        <p class="mt-4 max-w-2xl text-ink-soft">{resumeDescription}</p>
      </div>
      <div class="
        space-y-2 text-left text-sm text-ink-soft
        sm:text-right
      "
      >
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={`mailto:${siteConfig.contact.email}`}
          >
            {siteConfig.contact.email}
          </Link>
        </p>
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={siteConfig.contact.linkedin}
          >
            linkedin.com/in/santi020k
          </Link>
        </p>
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={siteConfig.contact.github}
          >
            github.com/santi020k
          </Link>
        </p>
        <p>{siteConfig.location}</p>
        <div
          class="
            mt-4 ui-combobox w-full grid-cols-2
            sm:flex sm:w-auto sm:justify-end
            print:hidden
          "
          data-print-hidden
        >
          <ButtonLink
            ariaLabel="Download two-page resume PDF"
            class="
              w-full
              sm:w-auto
            "
            download="santiago-molina-resume.pdf"
            href={resumePdfPath}
            variant="primary"
          >
            <Icon class="size-4" name="download" /> 2-page resume
          </ButtonLink>
          <ButtonLink
            ariaLabel="Download full CV PDF"
            class="
              w-full
              sm:w-auto
            "
            download="santiago-molina-full-cv.pdf"
            href={fullResumePdfPath}
            variant="secondary"
          >
            <Icon class="size-4" name="download" /> Full CV
          </ButtonLink>
        </div>
        <p class="
          text-xs text-ink-muted
          print:hidden
        "
        >
          Two-page resume for applications · Full CV with complete work history
        </p>
      </div>
    </div>

    <section class="
      mb-10
      print:mb-5
    "
    >
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >Experience</h2>
      <div class="
        space-y-8
        print:space-y-6
      "
      >
        {
          workProjects.map(project => (
            <div class="print:break-inside-avoid" data-resume-entry>
              <div
class="
  mb-2 flex flex-col items-baseline justify-between gap-1
  sm:flex-row
"
                data-resume-compact-header
              >
                <h3 class="text-lg font-bold text-ink">
                  {project.data.title} <span class="resume-role-text">— {project.data.role}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft">
                  {getFormattedDate(project.data.startingDate, { month: 'short', year: 'numeric', day: undefined })} – {project.data.endingDate ? getFormattedDate(project.data.endingDate, { month: 'short', year: 'numeric', day: undefined }) : 'Present'}
                </span>
              </div>
              <p class="mb-3 text-sm text-ink-soft">{project.data.description}</p>

              {project.data.impactMetrics.length > 0 && (
                <div class="mb-3">
                  <h4 class="
                    mb-2 text-xs font-semibold tracking-wider text-ink-muted
                    uppercase
                  "
                  >Key Impact
                  </h4>
                  <ul class="
                    ml-5 list-outside list-disc space-y-1 text-sm text-ink-soft
                  "
                  >
                    {project.data.impactMetrics.map(metric => (
                      <li>{metric}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="
                mt-3 flex flex-wrap gap-1.5
                print:hidden
              "
              >
                {project.data.technologies.slice(0, resumeTechnologyLimit).map(tech => (
                  <span
                    class="
                      inline-flex items-center rounded-md bg-surface-muted px-2
                      py-0.5 text-xs font-medium text-ink-soft ring-1
                      ring-line/50 ring-inset
                      print:border print:border-gray-300
                    "
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
class="
  mb-10
  print:hidden
"
      data-resume-full-only
    >
      <h2 class="mb-6 border-b border-line pb-2 text-2xl font-semibold">Earlier Experience</h2>
      <div class="divide-y divide-line">
        {
          earlierWork.map(project => (
            <div
class="
  py-5
  first:pt-0
  last:pb-0
"
              data-resume-compact-entry
            >
              <div
class="
  mb-2 flex flex-col items-baseline justify-between gap-1
  sm:flex-row
"
                data-resume-compact-header
              >
                <h3 class="text-base font-bold text-ink">
                  {project.data.title} <span class="resume-role-text">— {project.data.role}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft">
                  {getFormattedDate(project.data.startingDate, { month: 'short', year: 'numeric', day: undefined })} – {project.data.endingDate ? getFormattedDate(project.data.endingDate, { month: 'short', year: 'numeric', day: undefined }) : 'Present'}
                </span>
              </div>
              <p class="text-sm text-ink-soft">{project.data.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="
      mb-10
      print:mb-5 print:break-inside-avoid
    "
    >
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >Community</h2>
      <div class="
        space-y-8
        print:space-y-6
      "
      >
        {
          communityWork.map(project => (
            <div class="print:break-inside-avoid">
              <div class="
                mb-2 flex flex-col items-baseline justify-between gap-1
                sm:flex-row
              "
              >
                <h3 class="text-lg font-bold text-ink">
                  {project.data.title} <span class="resume-role-text">— {project.data.role}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft">
                  {getFormattedDate(project.data.startingDate, { month: 'short', year: 'numeric', day: undefined })} – {project.data.endingDate ? getFormattedDate(project.data.endingDate, { month: 'short', year: 'numeric', day: undefined }) : 'Present'}
                </span>
              </div>
              <p class="mb-3 text-sm text-ink-soft">{project.data.description}</p>

              {project.data.impactMetrics.length > 0 && (
                <div class="mb-3">
                  <h4 class="
                    mb-2 text-xs font-semibold tracking-wider text-ink-muted
                    uppercase
                  "
                  >Key Impact
                  </h4>
                  <ul class="
                    ml-5 list-outside list-disc space-y-1 text-sm text-ink-soft
                  "
                  >
                    {project.data.impactMetrics.map(metric => (
                      <li>{metric}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="
                mt-3 flex flex-wrap gap-1.5
                print:hidden
              "
              >
                {project.data.technologies.slice(0, resumeTechnologyLimit).map(tech => (
                  <span
                    class="
                      inline-flex items-center rounded-md bg-surface-muted px-2
                      py-0.5 text-xs font-medium text-ink-soft ring-1
                      ring-line/50 ring-inset
                      print:border print:border-gray-300
                    "
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="print:break-inside-avoid">
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >Skills & Expertise</h2>
      <div class="
        grid grid-cols-1 gap-6
        md:grid-cols-2
        print:grid-cols-2 print:gap-4
      "
      >
        <div>
          <h3 class="
            mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
          "
          >Languages
          </h3>
          <p class="text-sm text-ink-soft">Spanish (native), English (C1).</p>
        </div>
        <div>
          <h3 class="
            mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
          "
          >Front-End
          </h3>
          <p class="text-sm text-ink-soft">React.js, Next.js, React Native, Astro, TypeScript, Tailwind CSS, Redux, TanStack Query, Radix UI.</p>
        </div>
        <div>
          <h3 class="
            mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
          "
          >Back-End
          </h3>
          <p class="text-sm text-ink-soft">Node.js, Express.js, NestJS, REST, GraphQL, PostgreSQL, MongoDB, PHP, Ruby on Rails.</p>
        </div>
        <div>
          <h3 class="
            mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
          "
          >DevOps & Architecture
          </h3>
          <p class="text-sm text-ink-soft">AWS, Docker, CI/CD, GitHub Actions, System Design, Microservices, Turborepo.</p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  @media print {
    :global(html) {
      color-scheme: light !important;
      --theme-bg: 0 0% 100% !important;
      --surface: 0 0% 100% !important;
      --surface-muted: 0 0% 97% !important;
      --surface-strong: 0 0% 92% !important;
      --line: 0 0% 72% !important;
      --ink: 0 0% 7% !important;
      --ink-soft: 0 0% 23% !important;
      --ink-muted: 0 0% 38% !important;
      --brand: 264 92% 38% !important;
      --brand-solid: 264 92% 38% !important;
      --brand-soft: 264 60% 94% !important;
      --accent: 264 92% 38% !important;
      --glow: 264 60% 70% !important;
    }
    :global(header),
    :global(footer),
    :global(.grid-fade),
    :global(.ui-skip-link),
    :global([data-particles-bg]),
    :global([data-site-search]),
    :global([data-print-hidden]),
    :global(.back-to-top-button) {
      display: none !important;
    }
    :global(#main) {
      display: block !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    :global([data-resume-shell]) {
      isolation: auto !important;
      width: 100% !important;
      max-width: none !important;
      overflow: visible !important;
      border: 0 !important;
      background: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
    }
    :global([data-resume-shell])::before,
    :global([data-resume-shell])::after {
      display: none !important;
    }
    :global(body) {
      margin: 0 !important;
      background: white !important;
      color: black !important;
      font-size: 11pt;
    }
    :global([data-resume-shell] a) {
      color: inherit !important;
      text-decoration: none !important;
    }
    :global([data-resume-entry]) {
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
    }
    :global([data-resume-compact-entry]) {
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
    }
    :global([data-resume-compact-header]) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto !important;
      column-gap: 1rem !important;
      margin-bottom: 0 !important;
      padding-bottom: 0.65rem !important;
    }
    :global([data-resume-entry]:nth-child(3)) {
      break-before: page;
      page-break-before: always;
    }
    :global(html[data-resume-variant='full'] [data-resume-full-only]) {
      display: block !important;
    }
    :global(h1),
    :global(h2),
    :global(h3) {
      color: black !important;
    }
    @page {
      size: A4;
      margin: 1.35cm;
    }
  }
</style>
