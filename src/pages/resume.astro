---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import ResumeEvidenceNote from '@/components/molecules/ResumeEvidenceNote.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getGitLastModified } from '@/utils/git'
import { getTechnologyPath, getTechnologySlug } from '@/utils/links'

import '@/styles/pages/resume.css'

import { ButtonLink, Icon, Link } from '@santi020k/lumen-astro'

import { getUniqueTechnologies } from '@/data/project'
import { getLocale, localizePath } from '@/i18n'
import { localizePageSource, pageTranslator } from '@/i18n/page-copy'
import {
  AUTHOR_JOB_TITLE,
  CAREER_START_YEAR,
  createAuthorSchema,
  siteConfig
} from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)
const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const projectsById = new Map(allProjects.map(project => [project.id.replace(/\/index$/u, ''), project]))

const selectResumeProjects = (ids: readonly string[]) => ids.map(id => {
  const project = projectsById.get(id)

  if (!project) throw new Error(`Missing resume project: ${id}`)

  return project
})

const workProjects = selectResumeProjects([
  'smith-commerce',
  'xgames',
  'void',
  'optic-power'
])

const earlierWork = selectResumeProjects([
  'pads',
  'datagran',
  'justbit',
  'nebular'
])

const communityWork = selectResumeProjects(['react-js-colombia'])

const resumeSections = [
  { id: 'resume-experience', label: t('shared.experience') },
  { id: 'resume-earlier-experience', label: t('page.earlierExperience7') },
  { id: 'resume-community', label: t('shared.community') },
  { id: 'resume-skills', label: t('page.skillsAndExpertise7') }
]

const technologySlugs = new Set(getUniqueTechnologies(allProjects).map(getTechnologySlug))

const resumeSkillGroups = [
  { title: t('page.frontEnd'), skills: ['React.js', 'Next.js', 'React Native', 'Astro', 'TypeScript', 'Tailwind CSS', 'Redux', 'TanStack Query', 'Radix UI'] },
  { title: t('page.backEnd'), skills: ['Node.js', 'Express.js', 'NestJS', 'REST', 'GraphQL', 'PostgreSQL', 'MongoDB', 'PHP', 'Ruby on Rails'] },
  { title: t('page.devopsAndArchitecture'), skills: ['AWS', 'Docker', 'CI/CD', 'GitHub Actions', t('page.systemDesign'), 'Microservices', 'Turborepo'] }
].map(group => ({
  title: group.title,
  skills: group.skills.map(label => {
    const technology = label === 'REST' ? 'REST APIs' : label

    return { label, href: technologySlugs.has(getTechnologySlug(technology)) ? getTechnologyPath(technology) : undefined }
  })
}))

const resumeTechnologyLimit = 8
// Keep one crawlable PDF URL across deployments. The response revalidates at
// the edge, so cache busting does not need to create a new query URL per build.
const resumePdfPath = '/pdf/cv.pdf'
const fullResumePdfPath = '/pdf/cv-full.pdf'
const resumeDateCreated = '2024-01-01T00:00:00.000Z'

const resumeDescription =
  (pageLocale === 'es' ? `Líder de ingeniería y arquitecto full-stack con más de ${new Date().getFullYear() - CAREER_START_YEAR} años construyendo productos sólidos, ` : `Engineering leader and full-stack architect with ${new Date().getFullYear() - CAREER_START_YEAR}+ years building resilient products, `) +
  t('page.modernizingFrontendSystemsAndHelpingTeams')

const resumeDateModified = getGitLastModified([
  'scripts/py/cv.md',
  'src/content/project',
  'src/pages/resume.astro',
  'src/site.config.ts'
], resumeDateCreated)

const resumePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: resumeDateCreated,
  dateModified: resumeDateModified,
  mainEntity: {
    ...createAuthorSchema(Astro.site),
    jobTitle: localizePageSource(pageLocale, AUTHOR_JOB_TITLE),
    description: resumeDescription,
    mainEntityOfPage: new URL(localizePath('/resume/', pageLocale), Astro.site ?? 'https://santi020k.com').href
  }
}
---

<PageLayout
mainClass="remaining-pages"
  footerVariant="compact"
  meta={{
    description: resumeDescription,
    structuredData: resumePageSchema,
    title: t('page.resumeAndCurriculumVitae')
  }}
>
  <div
    class="
      glass-pro section-container-wide rounded-4xl p-5
      sm:p-8
      lg:p-10
      print:m-0 print:max-w-none print:rounded-none print:border-0
      print:bg-transparent print:p-0 print:shadow-none
    "
    data-resume-shell
  >
    <div
      class="
        mb-12 flex flex-col items-start justify-between gap-6
        sm:flex-row
        print:mb-6
      "
      data-resume-header
    >
      <div data-resume-identity>
        <p class="
          section-label text-brand
          dark:text-accent
          print:text-black
        "
        >{t('nav.resume')}
        </p>
        <h1
          class="
            mt-3 text-4xl/[0.98] font-extrabold tracking-[-0.06em] text-ink
            sm:text-5xl/[0.96]
            print:text-3xl print:tracking-tight
          "
        >
          {siteConfig.author}
        </h1>
        <p class="mt-2 text-xl text-brand">{localizePageSource(pageLocale, AUTHOR_JOB_TITLE)}</p>
        <p class="mt-4 max-w-2xl text-ink-soft">{resumeDescription}</p>
      </div>
      <div
        class="
          max-w-full space-y-2 text-left text-sm wrap-break-word text-ink-soft
          sm:text-right
        "
        data-resume-contacts
      >
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={localizePath(`mailto:${siteConfig.contact.email}`, pageLocale)}
          >
            <Icon
class="
  size-4 shrink-0
  print:hidden
"
name="mail"
data-resume-contact-icon
            />
            {siteConfig.contact.email}
          </Link>
        </p>
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={localizePath(siteConfig.contact.linkedin, pageLocale)}
            newTab
          >
            <ArrowExchange
class="
  size-4 shrink-0
  print:hidden
"
direction="up-right"
data-resume-contact-icon
            />
            linkedin.com/in/santi020k
          </Link>
        </p>
        <p>
          <Link
            className="
              text-inherit
              hover:text-brand
            "
            href={localizePath(siteConfig.contact.github, pageLocale)}
            newTab
          >
            <ArrowExchange
class="
  size-4 shrink-0
  print:hidden
"
direction="up-right"
data-resume-contact-icon
            />
            github.com/santi020k
          </Link>
        </p>
        <p>{siteConfig.location}</p>
        <div
          class="
            mt-4 grid w-full
            grid-cols-[repeat(auto-fit,minmax(min(100%,8.5rem),1fr))] gap-2
            sm:flex sm:w-auto sm:flex-wrap sm:justify-end
            print:hidden
          "
          data-print-hidden
          data-resume-downloads
        >
          <ButtonLink
            ariaLabel={t('page.download2PageResumePdf')}
            class="
              w-full
              sm:w-auto
            "
            download="santiago-molina-resume.pdf"
            data-astro-prefetch="false"
            href={localizePath(resumePdfPath, pageLocale)}
            variant="primary"
          >
            <Icon class="size-4" name="download" /> {t('resume.conciseDownload')}
          </ButtonLink>
          <ButtonLink
            ariaLabel={t('page.downloadFullCvPdf')}
            class="
              w-full
              sm:w-auto
            "
            download="santiago-molina-full-cv.pdf"
            data-astro-prefetch="false"
            href={localizePath(fullResumePdfPath, pageLocale)}
            variant="secondary"
          >
            <Icon class="size-4" name="download" /> {t('page.fullCv')}
          </ButtonLink>
        </div>
        <p class="
          text-xs text-ink-muted
          print:hidden
        "
        >
          {t('page.twoPageResumeForApplicationsFull')}
        </p>
      </div>
    </div>

    <nav id="resume-index" class="print:hidden" aria-labelledby="resume-index-label" data-resume-index data-print-hidden>
      <p id="resume-index-label">{t('page.onThisPage')}</p>
      <ol role="list">
        {resumeSections.map((section, index) => (
          <li>
            <Link href={localizePath(`#${section.id}`, pageLocale)} variant="inherit">
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {section.label}
            </Link>
          </li>
        ))}
      </ol>
    </nav>

    <section
id="resume-experience"
class="
  mb-10
  print:mb-5
"
    >
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >{t('shared.experience')}</h2>
      <div class="
        space-y-8
        print:space-y-6
      "
      >
        {
          workProjects.map(project => (
            <div class="print:break-inside-avoid" data-resume-entry>
              <div
class="
  mb-2 flex flex-col items-baseline justify-between gap-1
  sm:flex-row
"
                data-resume-compact-header
              >
                <h3 class="text-lg font-bold text-ink">
                  {project.data.title} <span class="resume-role-text"><span data-resume-role-separator>— </span>{localizePageSource(pageLocale, project.data.role ?? '')}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft" data-resume-date>
                  {new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.startingDate)} – {project.data.endingDate ? new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.endingDate) : t('page.present')}
                </span>
              </div>
              <p class="mb-3 text-sm text-ink-soft">{localizePageSource(pageLocale, project.data.description)}</p>

              {project.data.impactMetrics.length > 0 && (
                <div class="mb-3" data-resume-impact>
                  <h4 class="
                    mb-2 text-xs font-semibold tracking-wider text-ink-muted
                    uppercase
                  "
                  >{t('page.keyImpact')}
                  </h4>
                  <ul
role="list"
class="ml-5 list-outside list-disc space-y-1 text-sm text-ink-soft"
                  >
                    {project.data.impactMetrics.map(metric => (
                      <li>{localizePageSource(pageLocale, metric)}</li>
                    ))}
                  </ul>
                  <ResumeEvidenceNote project={project} />
                </div>
              )}
              {project.data.impactMetrics.length === 0 && <ResumeEvidenceNote compact project={project} />}

              <div
class="
  mt-3 flex flex-wrap gap-1.5
  print:hidden
"
                data-resume-stack
              >
                {project.data.technologies.slice(0, resumeTechnologyLimit).map(tech => (
                  <span
                    class="
                      inline-flex items-center rounded-md bg-surface-muted px-2
                      py-0.5 text-xs font-medium text-ink-soft ring-1
                      ring-line/50 ring-inset
                      print:border print:border-gray-300
                    "
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      id="resume-earlier-experience"
class="
  mb-10
  print:hidden
"
      data-resume-full-only
    >
      <h2 class="mb-6 border-b border-line pb-2 text-2xl font-semibold">{t('page.earlierExperience')}</h2>
      <div class="divide-y divide-line">
        {
          earlierWork.map(project => (
            <div
class="
  py-5
  first:pt-0
  last:pb-0
"
              data-resume-compact-entry
            >
              <div
class="
  mb-2 flex flex-col items-baseline justify-between gap-1
  sm:flex-row
"
                data-resume-compact-header
              >
                <h3 class="text-base font-bold text-ink">
                  {project.data.title} <span class="resume-role-text"><span data-resume-role-separator>— </span>{localizePageSource(pageLocale, project.data.role ?? '')}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft" data-resume-date>
                  {new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.startingDate)} – {project.data.endingDate ? new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.endingDate) : t('page.present')}
                </span>
              </div>
              <p class="text-sm text-ink-soft">{localizePageSource(pageLocale, project.data.description)}</p>
              <ResumeEvidenceNote compact project={project} />
            </div>
          ))
        }
      </div>
    </section>

    <section
id="resume-community"
class="
  mb-10
  print:mb-5 print:break-inside-avoid
"
    >
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >{t('shared.community')}</h2>
      <div class="
        space-y-8
        print:space-y-6
      "
      >
        {
          communityWork.map(project => (
            <div class="print:break-inside-avoid" data-resume-community-entry>
              <div
class="
  mb-2 flex flex-col items-baseline justify-between gap-1
  sm:flex-row
"
              data-resume-community-header
              >
                <h3 class="text-lg font-bold text-ink">
                  {project.data.title} <span class="resume-role-text"><span data-resume-role-separator>— </span>{localizePageSource(pageLocale, project.data.role ?? '')}</span>
                </h3>
                <span class="text-sm font-medium text-ink-soft" data-resume-date>
                  {new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.startingDate)} – {project.data.endingDate ? new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(project.data.endingDate) : t('page.present')}
                </span>
              </div>
              <p class="mb-3 text-sm text-ink-soft">{localizePageSource(pageLocale, project.data.description)}</p>

              {project.data.impactMetrics.length > 0 && (
                <div class="mb-3" data-resume-impact>
                  <h4 class="
                    mb-2 text-xs font-semibold tracking-wider text-ink-muted
                    uppercase
                  "
                  >{t('page.keyImpact')}
                  </h4>
                  <ul
role="list"
class="ml-5 list-outside list-disc space-y-1 text-sm text-ink-soft"
                  >
                    {project.data.impactMetrics.map(metric => (
                      <li>{localizePageSource(pageLocale, metric)}</li>
                    ))}
                  </ul>
                  <ResumeEvidenceNote project={project} />
                </div>
              )}
              {project.data.impactMetrics.length === 0 && <ResumeEvidenceNote compact project={project} />}

              <div
class="
  mt-3 flex flex-wrap gap-1.5
  print:hidden
"
              data-resume-stack
              >
                {project.data.technologies.slice(0, resumeTechnologyLimit).map(tech => (
                  <span
                    class="
                      inline-flex items-center rounded-md bg-surface-muted px-2
                      py-0.5 text-xs font-medium text-ink-soft ring-1
                      ring-line/50 ring-inset
                      print:border print:border-gray-300
                    "
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="resume-skills" class="print:break-inside-avoid">
      <h2 class="
        mb-6 border-b border-line pb-2 text-2xl font-semibold
        print:mb-4
      "
      >{t('page.skillsAndExpertise')}</h2>
      <div
class="
  grid grid-cols-1 gap-6
  md:grid-cols-2
  print:grid-cols-2 print:gap-4
"
      data-resume-skills
      >
        <div>
          <h3 class="
            mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
          "
          >{t('page.languages')}
          </h3>
          <p class="text-sm text-ink-soft">{t('page.spanishNativeEnglishC1')}</p>
        </div>
        {resumeSkillGroups.map(group => (
          <div>
            <h3 class="
              mb-2 text-xs font-semibold tracking-wider text-ink-muted uppercase
            "
            >{group.title}</h3>
            <ul class="print:hidden" role="list" aria-label={`${group.title} ${t('page.skills')}`} data-resume-skill-links data-print-hidden>
              {group.skills.map(skill => (
                <li>{skill.href ? <Link href={localizePath(skill.href, pageLocale)} variant="inherit">{skill.label}</Link> : <span>{skill.label}</span>}</li>
              ))}
            </ul>
            <p
class="
  hidden text-sm text-ink-soft
  print:block
"
data-resume-skills-print
            >{group.skills.map(skill => skill.label).join(', ')}.</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</PageLayout>

<style>
  @media print {
    :global(html) {
      color-scheme: light !important;
      --canvas: 0 0% 100% !important;
      --surface: 0 0% 100% !important;
      --surface-muted: 0 0% 97% !important;
      --surface-strong: 0 0% 92% !important;
      --line: 0 0% 72% !important;
      --ink: 0 0% 7% !important;
      --ink-soft: 0 0% 23% !important;
      --ink-muted: 0 0% 38% !important;
      --brand: 264 92% 38% !important;
      --brand-solid: 264 92% 38% !important;
      --brand-soft: 264 60% 94% !important;
      --accent: 264 92% 38% !important;
      --glow: 264 60% 70% !important;
    }
    :global(header),
    :global(footer),
    :global(.grid-fade),
    :global([data-slot="skip-link"]),
    :global([data-particles-bg]),
    :global([data-site-search]),
    :global([data-print-hidden]),
    :global(.back-to-top-button) {
      display: none !important;
    }
    :global(#main) {
      display: block !important;
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    :global([data-resume-shell]) {
      isolation: auto !important;
      width: 100% !important;
      max-width: none !important;
      overflow: visible !important;
      border: 0 !important;
      background: none !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
    }
    :global([data-resume-shell])::before,
    :global([data-resume-shell])::after {
      display: none !important;
    }
    :global(body) {
      margin: 0 !important;
      background: white !important;
      color: black !important;
      font-size: 11pt;
    }
    :global([data-resume-shell] a) {
      color: inherit !important;
      text-decoration: none !important;
    }
    :global([data-resume-entry]) {
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
    }
    :global([data-resume-compact-entry]) {
      break-inside: avoid-page !important;
      page-break-inside: avoid !important;
    }
    :global([data-resume-compact-header]) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto !important;
      column-gap: 1rem !important;
      margin-bottom: 0 !important;
      padding-bottom: 0.65rem !important;
    }
    :global([data-resume-entry]:nth-child(3)) {
      break-before: page;
      page-break-before: always;
    }
    :global(html[data-resume-variant='full'] [data-resume-full-only]) {
      display: block !important;
    }
    :global(h1),
    :global(h2),
    :global(h3) {
      color: black !important;
    }
    @page {
      size: A4;
      margin: 1.35cm;
    }
  }
</style>
