---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

const description =
  t('page.termsAndConditionsForUsingSanti020k')

/** Single source of truth for the effective and review dates shown across this page. */
const effectiveDate = t('page.august252026')
const lastReviewed = t('page.august252026')

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('page.termsAndConditions'), url: localizePath('/terms/', pageLocale) }
]

const meta = {
  breadcrumbs,
  description,
  title: t('page.termsAndConditions')
}

const sections = [
  {
    label: t('page.usingThisSite'),
    body: t('page.byAccessingSanti020kComYouAgree')
  },
  {
    label: t('page.purposeOfTheContent'),
    body: t('page.thisPortfolioAndBlogSharePersonal')
  },
  {
    label: t('page.intellectualProperty'),
    body: t('page.unlessStatedOtherwiseTheWritingDesign')
  },
  {
    label: t('page.thirdPartyLinksAndServices'),
    body: t('page.theSiteLinksToServicesAnd')
  },
  {
    label: t('page.availabilityAndAccuracy'),
    body: t('page.iWorkToKeepTheSite')
  },
  {
    label: t('page.limitationOfLiability'),
    body: t('page.toTheFullestExtentPermittedBy')
  },
  {
    label: t('shared.privacy'),
    body: t('page.thePrivacyPageExplainsBrowserStorage')
  },
  {
    label: t('page.changesAndGoverningLaw'),
    body: t('page.theseTermsMayBeUpdatedWhen')
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <article class="space-y-12">
    <PageHero
      description={t('page.clearExpectationsForUsingThisPortfolio')}
      eyebrow={t('page.legal')}
      gradientText={t('page.plainLanguage')}
      metaItems={[t('page.personalPortfolio'), t('page.educationalContent'), `${t('page.effective')} ${effectiveDate}`]}
      title={t('page.termsAndConditions')}
    />

    <PolicySections {sections} />

    <PolicyContactCard label={t('page.questionsOrPermissions')} title={t('page.askBeforeReusingSubstantialMaterial')}>
      <p>
        {t('page.forQuestionsAboutTheseTermsOr')}{' '}
        <Link
variant="inherit"
href={localizePath(`mailto:${siteConfig.contact.email}?subject=Terms%20and%20permissions`, pageLocale)}
        >
          {siteConfig.contact.email}
        </Link>.
      </p>
      <p slot="note">
        {t('page.effective')} {effectiveDate}{t('page.lastReviewed7')} {lastReviewed}.
      </p>
    </PolicyContactCard>
  </article>

  <div class="section-container-wide section-actions">
    <ButtonLink href={localizePath('/', pageLocale)} showArrow variant="secondary">
      {t('page.backHome')}
    </ButtonLink>
    <ButtonLink href={localizePath('/privacy/', pageLocale)} showArrow variant="ghost">
      {t('page.privacyStatement')}
    </ButtonLink>
  </div>
</PageLayout>
