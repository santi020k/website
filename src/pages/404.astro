---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

const meta = {
  description: 'The page you are looking for could not be found.',
  title: 'Page not found'
}
---

<PageLayout meta={meta}>
  <section
    aria-labelledby="error-heading"
    class="
      section-container-wide grid animate-reveal-lcp gap-10
      motion-reduce:animate-none
      lg:grid-cols-[1fr_0.72fr] lg:items-start
    "
  >
    <div class="space-y-6">
      <span
        class="
          inline-flex items-center rounded-full border border-brand/25
          bg-brand-soft/78 px-3 py-1 text-[0.72rem] font-semibold
          tracking-[0.24em] text-brand uppercase
        "
        role="alert"
      >
        404 · Page not found
      </span>

      <div class="space-y-4">
        <span
          aria-hidden="true"
          class="
            block text-[6.25rem] leading-none font-black tracking-[-0.08em]
            text-brand/85 select-none
            sm:text-[8rem]
          "
        >
          404
        </span>
        <h1
          class="
            max-w-xl text-3xl
            sm:text-4xl
          "
          id="error-heading"
        >
          This page drifted out of orbit.
        </h1>
        <p class="max-w-md text-base/7 text-ink-soft">
          The route may have changed, or the page may never have existed in this version of the site.
        </p>
      </div>

      <div class="section-actions">
        <ButtonLink href="/" showArrow>
          Back home
        </ButtonLink>
        <ButtonLink href="/portfolio/" showArrow variant="secondary">
          Open projects
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="ghost">
          Read blog
        </ButtonLink>
      </div>
    </div>

    <div class="editorial-rail">
      <Card class="p-5" variant="muted">
        <p class="section-label">Try these instead</p>
        <div class="mt-4 space-y-3 text-sm/7 text-ink-soft">
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/portfolio/"
            >
              Portfolio
            </a>
            {' '}
            for recent case studies, shipped systems, and product work.
          </p>
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/blog/"
            >
              Blog
            </a>
            {' '}
            for architecture, automation, and developer experience writing.
          </p>
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/about/"
            >
              About
            </a>
            {' '}
            for a quick overview of experience, leadership style, and community work.
          </p>
        </div>
      </Card>

      <Card class="overflow-hidden p-0">
        <div
          aria-hidden="true"
          class="
            relative flex aspect-4/3 items-center justify-center grid-fade
            opacity-75
          "
        >
          <!-- Decorative orbital illustration -->
          <svg
            class="
              absolute inset-0 m-auto h-[72%] w-auto animate-float-y
              motion-reduce:animate-none
            "
            viewBox="0 0 220 220"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Orbit ring (ellipse) -->
            <ellipse
              cx="110"
              cy="110"
              rx="88"
              ry="36"
              stroke="hsl(var(--brand)/0.28)"
              stroke-width="1.5"
              stroke-dasharray="6 5"
            />
            <!-- Planet -->
            <circle cx="110" cy="110" r="30" fill="hsl(var(--brand)/0.10)" stroke="hsl(var(--brand)/0.38)" stroke-width="1.5"/>
            <!-- Planet highlight -->
            <ellipse cx="100" cy="103" rx="9" ry="5" fill="hsl(var(--brand)/0.14)" transform="rotate(-20 100 103)"/>
            <!-- Satellite body -->
            <rect x="162" y="52" width="22" height="14" rx="3" fill="hsl(var(--surface-strong)/0.9)" stroke="hsl(var(--brand)/0.55)" stroke-width="1.2"/>
            <!-- Solar panel left -->
            <rect x="137" y="55" width="22" height="8" rx="2" fill="hsl(var(--brand)/0.22)" stroke="hsl(var(--brand)/0.45)" stroke-width="1"/>
            <!-- Solar panel right -->
            <rect x="187" y="55" width="22" height="8" rx="2" fill="hsl(var(--brand)/0.22)" stroke="hsl(var(--brand)/0.45)" stroke-width="1"/>
            <!-- Antenna -->
            <line x1="173" y1="52" x2="173" y2="44" stroke="hsl(var(--brand)/0.6)" stroke-width="1.2"/>
            <circle cx="173" cy="43" r="2" fill="hsl(var(--brand)/0.7)"/>
            <!-- Signal waves from antenna -->
            <path d="M167 38 Q173 32 179 38" stroke="hsl(var(--brand)/0.35)" stroke-width="1" fill="none"/>
            <path d="M164 33 Q173 25 182 33" stroke="hsl(var(--brand)/0.18)" stroke-width="1" fill="none"/>
            <!-- Stars -->
            <circle cx="40"  cy="38"  r="1.2" fill="hsl(var(--ink)/0.35)"/>
            <circle cx="185" cy="170" r="1"   fill="hsl(var(--ink)/0.30)"/>
            <circle cx="60"  cy="175" r="1.4" fill="hsl(var(--ink)/0.28)"/>
            <circle cx="196" cy="80"  r="0.9" fill="hsl(var(--ink)/0.25)"/>
            <circle cx="28"  cy="130" r="1"   fill="hsl(var(--ink)/0.22)"/>
            <circle cx="145" cy="185" r="1.1" fill="hsl(var(--ink)/0.22)"/>
            <circle cx="78"  cy="42"  r="0.8" fill="hsl(var(--ink)/0.20)"/>
          </svg>
        </div>
      </Card>
    </div>
  </section>
</PageLayout>
