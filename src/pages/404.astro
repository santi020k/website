---
import ButtonLink from '@/components/atoms/ButtonLink.astro'

import PageLayout from '@/layouts/Base.astro'

const meta = {
  description: 'The page you are looking for could not be found.',
  title: 'Page not found'
}
---

<PageLayout meta={meta}>
  <section
    aria-labelledby="error-heading"
    class="
      grid gap-10
      lg:grid-cols-[1fr_0.72fr] lg:items-start
    "
    role="alert"
    data-animate
  >
    <div class="space-y-6">
      <span class="
        inline-flex items-center rounded-full border border-brand/25
        bg-brand-soft/78 px-3 py-1 text-[0.72rem] font-semibold
        tracking-[0.24em] text-brand uppercase
      "
      >
        404 · Page not found
      </span>

      <div class="space-y-4">
        <span
          aria-hidden="true"
          class="
            block text-[6.25rem] leading-none font-black tracking-[-0.08em]
            text-brand/85 select-none
            sm:text-[8rem]
          "
        >
          404
        </span>
        <h1
          class="
            max-w-xl text-3xl
            sm:text-4xl
          "
          id="error-heading"
        >
          This page drifted out of orbit.
        </h1>
        <p class="max-w-md text-base/7 text-ink-soft">
          The route may have changed, or the page may never have existed in this version of the site.
        </p>
      </div>

      <div class="section-actions">
        <ButtonLink href="/" showArrow>
          Back home
        </ButtonLink>
        <ButtonLink href="/portfolio/" showArrow variant="secondary">
          Open projects
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="ghost">
          Read blog
        </ButtonLink>
      </div>
    </div>

    <div class="editorial-rail">
      <div class="mini-note">
        <p class="section-label">Try these instead</p>
        <div class="mt-4 space-y-3 text-sm/7 text-ink-soft">
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/portfolio/"
            >
              Portfolio
            </a>
            {' '}
            for recent case studies, shipped systems, and product work.
          </p>
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/blog/"
            >
              Blog
            </a>
            {' '}
            for architecture, automation, and developer experience writing.
          </p>
          <p>
            <a
              class="
                font-medium text-ink transition-colors
                hover:text-brand
              "
              href="/about/"
            >
              About
            </a>
            {' '}
            for a quick overview of experience, leadership style, and community work.
          </p>
        </div>
      </div>

      <div class="panel-card overflow-hidden">
        <div aria-hidden="true" class="aspect-4/3 grid-fade opacity-75" />
      </div>
    </div>
  </section>
</PageLayout>
