---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageLayout from '@/layouts/Base.astro'

import { Card, Icon, Link } from '@santi020k/lumen-astro'

const recoveryPages = [
  { slug: 'portfolio', title: 'Portfolio', description: 'Recent case studies, shipped systems, and product work.' },
  { slug: 'blog', title: 'Blog', description: 'Architecture, automation, and developer experience writing.' },
  { slug: 'about', title: 'About', description: 'A quick overview of experience, leadership style, and community work.' }
]

const meta = {
  description: 'The page you are looking for could not be found.',
  noindex: true,
  title: 'Page not found'
}
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <section
    aria-labelledby="error-heading"
    class="
      section-container-wide grid animate-reveal-lcp grid-cols-1 gap-10
      motion-reduce:animate-none
      lg:grid-cols-[minmax(0,1fr)_minmax(0,0.72fr)] lg:items-start
    "
  >
    <div class="space-y-6">
      <p class="editorial-eyebrow">404 · Page not found</p>

      <div class="space-y-4">
        <span
          aria-hidden="true"
          class="
            block text-[min(6.25rem,32vw)] leading-none font-medium
            tracking-[-0.08em] text-brand/85 select-none
            sm:text-[8rem]
          "
        >
          404
        </span>
        <h1
          class="
            max-w-xl text-3xl
            sm:text-4xl
          "
          id="error-heading"
        >
          This page drifted out of orbit.
        </h1>
        <p class="max-w-md text-base/7 text-ink-soft">
          The route may have changed, or the page may never have existed in this version of the site.
        </p>
      </div>

      <div class="section-actions">
        <ButtonLink href="/" showArrow>
          Back home
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="secondary">
          Read blog
        </ButtonLink>
      </div>
    </div>

    <div class="editorial-rail">
      <Card as="section" variant="unstyled" data-recovery-card aria-labelledby="recovery-heading">
        <header data-recovery-header>
          <h2 id="recovery-heading" data-recovery-heading>Try these instead</h2>
          <Icon name="signpost" class="size-5.5 shrink-0" />
        </header>
        <nav data-recovery-links aria-labelledby="recovery-heading">
          {recoveryPages.map(({ slug, title, description }) => (
            <Link
              href={`/${slug}/`}
              variant="inherit"
              data-recovery-link
            >
              <div data-recovery-copy>
                <h3 id={`recovery-${slug}`} data-recovery-title>{title}</h3>
                <p id={`recovery-${slug}-description`} data-recovery-description>{description}</p>
              </div>
              <span data-recovery-direction>
                <Icon name="arrow-up-right" class="size-4" />
              </span>
            </Link>
          ))}
        </nav>
      </Card>

      <Card class="p-0">
        <div
          aria-hidden="true"
          class="
            relative flex aspect-4/3 items-center justify-center grid-fade
            opacity-75
          "
        >
          <!-- Decorative orbital illustration -->
          <svg
            class="absolute inset-0 m-auto h-[72%] w-auto"
            viewBox="0 0 220 220"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- Orbit ring (ellipse) -->
            <ellipse
              cx="110"
              cy="110"
              rx="88"
              ry="36"
              stroke="hsl(var(--brand)/0.28)"
              stroke-width="1.5"
              stroke-dasharray="6 5"
            />
            <!-- Planet -->
            <circle cx="110" cy="110" r="30" fill="hsl(var(--brand)/0.10)" stroke="hsl(var(--brand)/0.38)" stroke-width="1.5"/>
            <!-- Planet highlight -->
            <ellipse cx="100" cy="103" rx="9" ry="5" fill="hsl(var(--brand)/0.14)" transform="rotate(-20 100 103)"/>
            <!-- Satellite body -->
            <rect x="162" y="52" width="22" height="14" rx="3" fill="hsl(var(--surface-strong)/0.9)" stroke="hsl(var(--brand)/0.55)" stroke-width="1.2"/>
            <!-- Solar panel left -->
            <rect x="137" y="55" width="22" height="8" rx="2" fill="hsl(var(--brand)/0.22)" stroke="hsl(var(--brand)/0.45)" stroke-width="1"/>
            <!-- Solar panel right -->
            <rect x="187" y="55" width="22" height="8" rx="2" fill="hsl(var(--brand)/0.22)" stroke="hsl(var(--brand)/0.45)" stroke-width="1"/>
            <!-- Antenna -->
            <line x1="173" y1="52" x2="173" y2="44" stroke="hsl(var(--brand)/0.6)" stroke-width="1.2"/>
            <circle cx="173" cy="43" r="2" fill="hsl(var(--brand)/0.7)"/>
            <!-- Signal waves from antenna -->
            <path d="M167 38 Q173 32 179 38" stroke="hsl(var(--brand)/0.35)" stroke-width="1" fill="none"/>
            <path d="M164 33 Q173 25 182 33" stroke="hsl(var(--brand)/0.18)" stroke-width="1" fill="none"/>
            <!-- Stars -->
            <circle cx="40"  cy="38"  r="1.2" fill="hsl(var(--ink)/0.35)"/>
            <circle cx="185" cy="170" r="1"   fill="hsl(var(--ink)/0.30)"/>
            <circle cx="60"  cy="175" r="1.4" fill="hsl(var(--ink)/0.28)"/>
            <circle cx="196" cy="80"  r="0.9" fill="hsl(var(--ink)/0.25)"/>
            <circle cx="28"  cy="130" r="1"   fill="hsl(var(--ink)/0.22)"/>
            <circle cx="145" cy="185" r="1.1" fill="hsl(var(--ink)/0.22)"/>
            <circle cx="78"  cy="42"  r="0.8" fill="hsl(var(--ink)/0.20)"/>
          </svg>
        </div>
      </Card>
    </div>
  </section>
</PageLayout>

<style>
  [data-recovery-card][data-slot='card'] {
    container: recovery / inline-size;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-recovery-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  [data-recovery-card] [data-recovery-heading] {
    margin: 0;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }

  [data-recovery-links] { padding: 0 1.625rem 0.5rem; }

  [data-recovery-card] :global([data-recovery-link]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.875rem;
    align-items: center;
    gap: 1rem;
    padding-block: 1.375rem;
    border-bottom: 1px solid hsl(var(--line));
    color: hsl(var(--ink));
    text-decoration: none;
  }

  [data-recovery-card] :global([data-recovery-link]:last-child) { border-bottom: 0; }
  [data-recovery-copy] { min-width: 0; }

  [data-recovery-card] [data-recovery-title] {
    margin: 0 0 0.5625rem;
    font-size: 1.4375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.045em;
  }

  [data-recovery-description] {
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    letter-spacing: 0;
  }

  [data-recovery-direction] { display: flex; justify-content: center; color: hsl(var(--brand)); }
  [data-recovery-card] :global([data-recovery-link]:is(:hover, :focus-visible)) [data-recovery-title] {
    color: hsl(var(--brand));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  :global([data-theme='dark']) [data-recovery-header] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  :global([data-theme='dark']) [data-recovery-direction],
  :global([data-theme='dark']) [data-recovery-card] :global([data-recovery-link]:is(:hover, :focus-visible)) [data-recovery-title] { color: hsl(var(--accent)); }

  @container recovery (width < 20rem) {
    [data-recovery-header] { padding: 1.25rem; }
    [data-recovery-links] { padding-inline: 1.25rem; }
  }

  @container recovery (width < 14rem) {
    [data-recovery-header] { gap: 0.5rem; padding: 1rem 0.75rem; }
    [data-recovery-links] { padding-inline: 0.75rem; }
    [data-recovery-card] :global([data-recovery-link]) { grid-template-columns: minmax(0, 1fr); }
    [data-recovery-direction] { display: none; }
    [data-recovery-card] [data-recovery-title] { font-size: 1.25rem; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  }
</style>
