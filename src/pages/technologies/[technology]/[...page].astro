---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import Pagination from '@/components/Paginator.astro'
import ProjectPreview from '@/components/projects/ProjectPreview.astro'

import { collectionDateSortProjects } from '@/utils/date'

import { getAllProjects, getUniqueTechnologies } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allProjects = await getAllProjects()
  const sortedProjects = allProjects.sort(collectionDateSortProjects)
  const uniqueTechnologies = getUniqueTechnologies(sortedProjects)

  return uniqueTechnologies.flatMap((technology) => {
    const filterProjects = sortedProjects.filter(project => project.data.technologies.includes(technology))
    return paginate(filterProjects, {
      // TODO: Remove pagination
      pageSize: 50,
      params: { technology }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'project'>>
}

const { page } = Astro.props
const { technology } = Astro.params

const meta = {
  description: `View all projects with the technology - ${technology}`,
  title: `Technology: ${technology}`
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Previous Technologies',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Next Technologies →',
      url: page.url.next
    }
  })
};
---

<PageLayout meta={meta}>
  <h1 class="mb-6 flex items-center">
    <a class="sm:hover:underline" href="/technologies/">Technologies</a>
    <span class="me-3 ms-2">→</span>
    <span class="text-2xl">#{technology}</span>
  </h1>
  <section aria-label="Blog project list">
    <ul class="space-y-4">
      {
        page.data.map(p => (
          <li class="grid-cols-[auto_1fr]">
            <ProjectPreview project={p} />
          </li>
        ))
      }
    </ul>
    <Pagination {...paginationProps} />
  </section>
</PageLayout>
