---
import type { GetStaticPaths, Page } from 'astro'

import type { CollectionEntry } from 'astro:content'

import PageHero from '@/components/molecules/PageHero.astro'
import TechnologyArchiveChapter from '@/components/molecules/TechnologyArchiveChapter.astro'
import ProjectsGallery from '@/components/organisms/ProjectsGallery.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getTechnologyPath, getTechnologySlug } from '@/utils/links'
import { getSocialImagePath } from '@/utils/social-image'

import { Icon, Link } from '@santi020k/lumen-astro'

import { createProjectCollectionSchema, getUniqueTechnologies } from '@/data/project'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allProjects = await getCachedProjects()
  const sortedProjects = allProjects.sort(collectionDateSortProjects)
  const uniqueTechnologies = getUniqueTechnologies(sortedProjects)

  return uniqueTechnologies.flatMap(technology => {
    const technologySlug = getTechnologySlug(technology)

    const filteredProjects = sortedProjects.filter(project => project.data.technologies.some(
      projectTechnology => getTechnologySlug(projectTechnology) === technologySlug
    ))

    return paginate(filteredProjects, {
      pageSize: 50,
      params: { technology: technologySlug },
      props: { technology }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'project'>>
  technology: string
}

const { page, technology } = Astro.props

const projectMatches = page.data.filter(
  project => project.data.typesId === 'personal' || project.data.typesId === 'experimental'
)

const communityMatches = page.data.filter(project => project.data.typesId === 'community')
const workExperienceMatches = page.data.filter(project => project.data.typesId === 'professional')

const evidenceGroups = [
  { count: workExperienceMatches.length, label: 'Work experience', context: 'professional work', href: '#technology-work-heading' },
  { count: projectMatches.length, label: 'Projects', context: 'independent projects', href: '#technology-projects-heading' },
  { count: communityMatches.length, label: 'Community', context: 'community', href: '#technology-community-heading' }
].filter(group => group.count > 0)

const evidenceContext = new Intl.ListFormat('en', { type: 'conjunction' }).format(evidenceGroups.map(group => group.context))

const openingDescription = `${page.data.length} ${page.data.length === 1 ? 'entry' : 'entries'}` +
  `${page.lastPage > 1 ? ' on this page' : ''} ${evidenceGroups.length > 1 ? 'across' : 'in'} ${evidenceContext}. ` +
  `Explore where ${technology} shaped the work.`

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Technologies', url: '/technologies/' },
  { name: technology, url: getTechnologyPath(technology) }
]

const technologyListSchema = createProjectCollectionSchema(
  `${technology} · Technology`, Astro.url.pathname, page.data, Astro.site
)

const meta = {
  breadcrumbs,
  description: `Projects and case studies where ${technology} shaped the architecture, ` +
    'delivery workflow, or product experience.',
  ogImage: getSocialImagePath(`/technologies/${encodeURIComponent(technology)}/`),
  structuredData: technologyListSchema,
  title: `${technology} · Technology`
}

---

<PageLayout mainClass="remaining-pages" meta={meta}>
  <PageHero
    description={openingDescription}
    eyebrow="Technology evidence"
    gradientText="In practice."
    title={technology}
  >
    <nav aria-label="Technology evidence" data-technology-evidence-index slot="after-description">
      {evidenceGroups.map(group => (
        <Link data-technology-evidence-link href={group.href} variant="inherit">
          <span data-technology-evidence-count>{group.count}</span>{' '}
          <span data-technology-evidence-label>{group.label}</span>
          <Icon data-technology-evidence-arrow name="arrow-down" />
        </Link>
      ))}
    </nav>
    <div data-technology-archive-escape>
      <Link href="/technologies/" variant="inherit">All technologies<Icon name="arrow-right" /></Link>
      <Link href="/portfolio/" variant="inherit">Portfolio<Icon name="arrow-right" /></Link>
    </div>
  </PageHero>

  {projectMatches.length > 0 && (
    <section
      aria-labelledby="technology-projects-heading"
      class="section-container-wide space-y-8 page-section-space"
    >
      <TechnologyArchiveChapter
        countLabel={`${projectMatches.length} independent ${projectMatches.length === 1 ? 'project' : 'projects'}`}
        description="Independent builds, open-source tools, and experiments that shape the product or engineering system."
        headingId="technology-projects-heading"
        technology={technology}
        title="Projects"
      />

      <ProjectsGallery projects={projectMatches} />
    </section>
  )}

  {communityMatches.length > 0 && (
    <section
      aria-labelledby="technology-community-heading"
      class="section-container-wide space-y-8 page-section-space"
    >
      <TechnologyArchiveChapter
        countLabel={`${communityMatches.length} community ${communityMatches.length === 1 ? 'initiative' : 'initiatives'}`}
        description="Meetups, workshops, and mentorship that help engineers learn and connect."
        headingId="technology-community-heading"
        technology={technology}
        title="Community"
      />

      <ProjectsGallery projects={communityMatches} />
    </section>
  )}

  {workExperienceMatches.length > 0 && (
    <section
      aria-labelledby="technology-work-heading"
      class="section-container-wide space-y-8 page-section-space"
    >
      <TechnologyArchiveChapter
        countLabel={`${workExperienceMatches.length} professional ${workExperienceMatches.length === 1 ? 'role' : 'roles'}`}
        description="Client and product work across architecture, delivery, and measurable outcomes."
        headingId="technology-work-heading"
        technology={technology}
        title="Work experience"
      />

      <ProjectsGallery projects={workExperienceMatches} />
    </section>
  )}

</PageLayout>

<style>
  [data-technology-evidence-index] {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 1.75rem;
    margin-top: 2.5rem;
    border-block: 1px solid hsl(var(--line));
  }
  [data-technology-evidence-index] :global([data-technology-evidence-link]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 0.75rem;
    min-width: 0;
    padding-block: 1.75rem;
    color: hsl(var(--ink));
    text-decoration: none;
  }
  [data-technology-evidence-count] {
    grid-column: 1 / -1;
    font-size: 2.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  [data-technology-evidence-label] { font-size: 0.9375rem; line-height: 1.8; }
  [data-technology-evidence-index] :global([data-technology-evidence-arrow]) { color: hsl(var(--accent)); }
  [data-technology-evidence-index] :global(a:is(:hover, :focus-visible)) { color: hsl(var(--accent)); }
  [data-technology-evidence-index] :global(a:is(:hover, :focus-visible)) [data-technology-evidence-label] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  [data-technology-archive-escape] { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; }
  [data-technology-archive-escape] :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    text-decoration: none;
  }
  [data-technology-archive-escape] :global(a:is(:hover, :focus-visible)) {
    color: hsl(var(--accent));
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  :is([data-technology-evidence-index], [data-technology-archive-escape]) :global(a:focus-visible) {
    outline: 2px solid hsl(var(--accent));
    outline-offset: 4px;
  }
  @container editorial-hero (width < 32rem) {
    [data-technology-evidence-index] { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-technology-evidence-index] :global([data-technology-evidence-link]) {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      padding-block: 1.25rem;
    }
    [data-technology-evidence-index] :global(a + a) { border-top: 1px solid hsl(var(--line)); }
    [data-technology-evidence-count] { grid-column: auto; font-size: 2rem; }
  }
</style>
