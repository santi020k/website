---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import ProjectCard from '@/components/molecules/ProjectCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'

import { collectionDateSortProjects } from '@/utils/date'

import { getAllProjects, getUniqueTechnologies } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allProjects = await getAllProjects()
  const sortedProjects = allProjects.sort(collectionDateSortProjects)
  const uniqueTechnologies = getUniqueTechnologies(sortedProjects)

  return uniqueTechnologies.flatMap(technology => {
    const filteredProjects = sortedProjects.filter(project => project.data.technologies.includes(technology))

    return paginate(filteredProjects, {
      pageSize: 50,
      params: { technology }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'project'>>
}

const { page } = Astro.props
const { technology = '' } = Astro.params

const meta = {
  description: `Projects and case studies that include ${technology}.`,
  title: `${technology} · Technology`
}
---

<PageLayout meta={meta}>
  <section class="space-y-6">
    <SectionHeading
      description={`A filtered view of the portfolio entries where ${technology} played a meaningful role.`}
      eyebrow="Technology filter"
      level="h1"
      title={technology}
    />
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/technologies/" showArrow variant="secondary">
        All technologies
      </ButtonLink>
      <ButtonLink href="/portfolio/" showArrow variant="ghost">
        Portfolio
      </ButtonLink>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    {page.data.map(project => (
      <ProjectCard project={project} />
    ))}
  </section>
</PageLayout>
