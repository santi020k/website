---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import ProjectCard from '@/components/molecules/ProjectCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import { getUniqueTechnologies } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'
import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getPortfolioPath, getTechnologyPath } from '@/utils/links'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allProjects = await getCachedProjects()
  const sortedProjects = allProjects.sort(collectionDateSortProjects)
  const uniqueTechnologies = getUniqueTechnologies(sortedProjects)

  return uniqueTechnologies.flatMap(technology => {
    const filteredProjects = sortedProjects.filter(project => project.data.technologies.includes(technology))

    return paginate(filteredProjects, {
      pageSize: 50,
      params: { technology }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'project'>>
}

const { page } = Astro.props
const { technology = '' } = Astro.params

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Technologies', url: '/technologies/' },
  { name: technology, url: getTechnologyPath(technology) }
]

const technologyListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${technology} · Technology`,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: page.data.length,
    itemListElement: page.data.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(getPortfolioPath(project.id), Astro.site).href,
      name: project.data.title
    }))
  }
}

const meta = {
  breadcrumbs,
  description: `Projects and case studies where ${technology} shaped the architecture, ` +
    'delivery workflow, or product experience.',
  structuredData: technologyListSchema,
  title: `${technology} · Technology`
}

---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Technology filter"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          {technology}
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">Projects.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Projects where {technology} played a meaningful role in the architecture, delivery workflow, or product experience.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/technologies/" showArrow variant="secondary">
            All technologies
          </ButtonLink>
          <ButtonLink href="/portfolio/" showArrow variant="secondary">
            Portfolio
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <StatsGrid>
    <StatCard description={`Projects in the portfolio where ${technology} shaped the architecture or delivery.`} label="Projects" value={String(page.total)} />
  </StatsGrid>

  <PageSection>
    <div class="
      grid gap-6
      lg:grid-cols-2
    "
    >
      {page.data.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
  </PageSection>
</PageLayout>
