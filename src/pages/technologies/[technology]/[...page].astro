---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '../../../components/atoms/ButtonLink.astro'
import ProjectCard from '../../../components/molecules/ProjectCard.astro'
import SectionHeading from '../../../components/molecules/SectionHeading.astro'
import { getUniqueTechnologies } from '../../../data/project'
import PageLayout from '../../../layouts/Base.astro'
import { getCachedProjects } from '../../../utils/content'
import { collectionDateSortProjects } from '../../../utils/date'
import { getPortfolioPath, getTechnologyPath } from '../../../utils/links'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allProjects = await getCachedProjects()
  const sortedProjects = allProjects.sort(collectionDateSortProjects)
  const uniqueTechnologies = getUniqueTechnologies(sortedProjects)

  return uniqueTechnologies.flatMap(technology => {
    const filteredProjects = sortedProjects.filter(project => project.data.technologies.includes(technology))

    return paginate(filteredProjects, {
      pageSize: 50,
      params: { technology }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'project'>>
}

const { page } = Astro.props
const { technology = '' } = Astro.params

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Technologies', url: '/technologies/' },
  { name: technology, url: getTechnologyPath(technology) }
]

const technologyListSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${technology} · Technology`,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: page.data.length,
    itemListElement: page.data.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(getPortfolioPath(project.id), Astro.site).href,
      name: project.data.title
    }))
  }
}

const meta = {
  breadcrumbs,
  description: `Projects and case studies where ${technology} shaped the architecture, ` +
    'delivery workflow, or product experience.',
  structuredData: technologyListSchema,
  title: `${technology} · Technology`
}

---

<PageLayout meta={meta}>
  <section class="space-y-6">
    <SectionHeading
      description={`Projects where ${technology} played a meaningful role in the architecture, ` +
        'delivery workflow, or product experience.'}
      eyebrow="Technology filter"
      level="h1"
      title={technology}
    />
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/technologies/" showArrow variant="secondary">
        All technologies
      </ButtonLink>
      <ButtonLink href="/portfolio/" showArrow variant="ghost">
        Portfolio
      </ButtonLink>
    </div>
  </section>

  <section class="
    grid gap-6
    lg:grid-cols-2
  "
  >
    {
      page.data.map(project => (
        <ProjectCard project={project} />
      ))
    }
  </section>
</PageLayout>
