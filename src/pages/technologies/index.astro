---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import TechnologyEvidenceLedger from '@/components/molecules/TechnologyEvidenceLedger.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import '@/styles/pages/technologies.css'

import { Card, Icon, Input, Link, MotionGroup } from '@santi020k/lumen-astro'

import { getTechnologyEntryCounts } from '@/data/project'
import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const allProjects = await getCachedProjects()
const technologies = getTechnologyEntryCounts(allProjects)
const coreTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 4))
const regularTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 2 && count < 4))
const selectiveTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count === 1))

const technologyGroups = [
  {
    items: coreTechnologies,
    recurrence: t('technology.coreRecurrence'),
    summary: t('collection.repeatedFoundationsAcrossProductArchitectureDelivery'),
    title: t('collection.core')
  },
  {
    items: regularTechnologies,
    recurrence: t('technology.regularRecurrence'),
    summary: t('collection.reliableCompanionToolsThatHelpTeams'),
    title: t('collection.regular')
  },
  {
    items: selectiveTechnologies,
    recurrence: t('technology.selectiveRecurrence'),
    summary: t('collection.contextSpecificPlatformsApisAndProduct'),
    title: t('collection.selective')
  }
].filter(group => group.items.length > 0)

const evidencePaths = [
  { href: '/work/', title: t('collection.workExperience'), description: t('collection.rolesTeamsAndSystemsShipped') },
  { href: '/projects/', title: t('collection.independentProjects'), description: t('collection.appsToolsAndIdeasIBuild') },
  { href: '/blog/', title: t('collection.writing'), description: t('collection.decisionsExperimentsAndLessons') }
]

const meta = {
  description: t('collection.browseSantiagoMolinaSCapabilitiesAnd'),
  title: t('collection.capabilitiesAndTechnologies')
}

---

<PageLayout mainClass="remaining-pages" meta={meta}>
  <div data-technology-opening>
    <PageHero
      compact
      description={t('technology.indexDescription', { count: technologies.length })}
      eyebrow={t('collection.capabilitiesIndex')}
      gradientText={t('collection.realWork')}
      title={t('collection.toolsConnectedTo')}
    >
      <div data-technology-index data-technology-opening-controls slot="after-description">
        <div data-technology-filter-row>
          <div data-technology-search-dock>
            <div data-technology-search-field>
              <span data-technology-search-mark><Icon class="size-5.25" name="search" /></span>
              <div>
                <label for="technology-filter">{t('collection.findATechnology')}</label>
                <Input
                  aria-describedby="technology-filter-status"
                  autocomplete="off"
                  data-technology-search-input
                  id="technology-filter"
                  placeholder={t('collection.search')}
                  spellcheck="false"
                  type="search"
                />
              </div>
            </div>
            <p
              aria-atomic="true"
              aria-live="polite"
              data-technology-search-counter
              id="technology-filter-status"
            >
              <span class="sr-only" data-technology-result-prefix>{t('collection.showingAll')}</span><span data-technology-result-count>{technologies.length}</span>{' '}<span data-technology-result-unit>{t('collection.technologies7')}</span><span
class="sr-only"
data-technology-result-suffix
                                                                                                                                                                                                                                                 >.</span>
            </p>
          </div>
        </div>
        <nav aria-label={t('collection.browseTechnologyGroups')} data-technology-group-navigation>
          {technologyGroups.map((group, index) => (
            <Link href={`#technology-group-${index}`} variant="inherit">
              <span data-technology-shortcut-title>{localizeCollectionSource(locale, group.title)}</span>
              <ArrowExchange class="size-4" direction="down" />
              <span data-technology-shortcut-meta>
                {group.items.length} {group.items.length === 1 ? t('collection.technology') : t('collection.technologies7')}<br />
                {group.recurrence}
              </span>
            </Link>
          ))}
        </nav>
        <div data-technology-opening-actions>
          <Link href={localizePath('/work/', locale)} variant="inherit">{t('collection.browseWork')}<ArrowExchange
class="size-4"
direction="right"
                                                                                                    /></Link>
          <Link href={localizePath('/portfolio/', locale)} variant="inherit">{t('collection.portfolio')}<ArrowExchange
class="size-4"
direction="right"
                                                                                                        /></Link>
        </div>
      </div>
    </PageHero>
  </div>

  <PageSection layout="stacked">
    <Card class="p-0" data-technology-catalog variant="muted">
      <div data-technology-index>
        <section aria-labelledby="technology-matches-heading" data-technology-matches hidden>
          <header data-technology-matches-header>
            <h2 id="technology-matches-heading">{t('collection.matchesFor')} “<span data-technology-match-query></span>”</h2>
            <p>{t('collection.countsReflectPortfolioEntries')}</p>
          </header>
          <div aria-label={t('collection.matchingTechnologies')} data-technology-matches-list role="list"></div>
        </section>
        <div data-technology-groups>
          {technologyGroups.map((group, index) => (
            <section
              aria-labelledby={`technology-group-${index}`}
              data-technology-group
            >
              <div data-technology-intro>
                <h2 id={`technology-group-${index}`} tabindex="-1">
                  <span data-technology-heading>
                    <span
aria-hidden="true"
data-technology-number
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span data-technology-title>{localizeCollectionSource(locale, group.title)}
                    </span>
                  </span>
                  <span
data-technology-group-count
                  >
                    {group.items.length} {group.items.length === 1 ? t('collection.tool') : t('home.hero.emphasis')}
                  </span>
                </h2>
                <p class="max-w-sm text-sm/6 text-ink-soft">{group.summary}</p>
              </div>

              <MotionGroup aria-label={t('technology.collection', { name: localizeCollectionSource(locale, group.title) })} data-technology-links enterExit={false} role="list">
                {group.items.map(([technology, count]) => (
                  <span data-label={technology} data-technology-item data-ui-motion-key={technology} role="listitem">
                    <Link
                      href={localizePath(getTechnologyPath(technology), locale)}
                      variant="inherit"
                    >
                      <span data-technology-label>{technology}</span>{' '}
                      <span data-technology-match-group>{localizeCollectionSource(locale, group.title)}</span>{' '}
                      <span data-technology-project-count>{count}<span
class="sr-only"
data-technology-entry-unit
                                                                 > {count === 1 ? t('collection.entry') : t('collection.entries')}</span></span>
                      <span data-technology-match-arrow><ArrowExchange
class="size-4"
direction="up-right"
                                                        /></span>
                    </Link>
                  </span>
                ))}
              </MotionGroup>
            </section>
          ))}
        </div>

        <section
          aria-labelledby="technology-empty-heading"
          data-technologies-empty
          hidden
        >
          <span data-technology-empty-icon><Icon class="size-5.5" name="search-x" /></span>
          <div>
            <h2 id="technology-empty-heading">{t('collection.noTechnologiesMatchThatSearch')}</h2>
            <p>{t('collection.tryABroaderTermOrClear')}</p>
          </div>
        </section>
      </div>
    </Card>
  </PageSection>

  <TechnologyEvidenceLedger mostRecurring={technologies[0]} total={technologies.length} />

  <PageSection layout="stacked">
    <section aria-labelledby="technology-evidence-heading" data-technology-evidence-paths id="trace-the-evidence">
      <header data-evidence-paths-header>
        <p data-evidence-paths-label>{t('collection.beyondTheToolkit')}</p>
        <h2 id="technology-evidence-heading">{t('collection.followItIntoTheWork')}</h2>
        <p data-evidence-paths-copy>{t('collection.seeTheRolesProductsAndDecisions')}</p>
      </header>
      <nav aria-label={t('collection.exploreBeyondTheToolkit')} data-evidence-paths-navigation>
        {evidencePaths.map((path, index) => (
          <Link data-evidence-path href={localizePath(path.href, locale)} variant="inherit">
            <span aria-hidden="true" data-evidence-path-number>{String(index + 1).padStart(2, '0')}</span>
            <span data-evidence-path-body>
              <span data-evidence-path-title>{localizeCollectionSource(locale, path.title)}</span>{' '}
              <span data-evidence-path-description>{localizeCollectionSource(locale, path.description)}</span>
            </span>
            <ArrowExchange data-evidence-path-arrow direction="up-right" />
          </Link>
        ))}
      </nav>
    </section>
  </PageSection>

  <script>
    const setupTechnologyIndex = () => {
      const isSpanish = document.documentElement.lang.startsWith('es')
      const copy = isSpanish ? { all: 'Mostrando todas las ', singular: 'tecnología', plural: 'tecnologías', foundOne: ' encontrada.', foundMany: ' encontradas.' } : { all: 'Showing all ', singular: 'technology', plural: 'technologies', foundOne: ' found.', foundMany: ' found.' }
      const groups = document.querySelector<HTMLElement>('[data-technology-groups]')
      const input = document.querySelector<HTMLInputElement>('#technology-filter')
      const status = document.getElementById('technology-filter-status')
      const statusPrefix = status?.querySelector('[data-technology-result-prefix]')
      const statusCount = status?.querySelector('[data-technology-result-count]')
      const statusUnit = status?.querySelector('[data-technology-result-unit]')
      const statusSuffix = status?.querySelector('[data-technology-result-suffix]')
      const empty = document.querySelector<HTMLElement>('[data-technologies-empty]')
      const shortcuts = document.querySelector<HTMLElement>('[data-technology-group-navigation]')
      const matches = document.querySelector<HTMLElement>('[data-technology-matches]')
      const matchesList = matches?.querySelector<HTMLElement>('[data-technology-matches-list]')
      const matchesQuery = matches?.querySelector<HTMLElement>('[data-technology-match-query]')

      if (!groups || !input || !statusPrefix || !statusCount || !statusUnit || !statusSuffix || !empty || !matches || !matchesList || !matchesQuery || groups.dataset.filterReady === 'true') return

      groups.dataset.filterReady = 'true'

      const catalogGroups = [...groups.querySelectorAll<HTMLElement>('[data-technology-group]')].flatMap(group => {
        const list = group.querySelector<HTMLElement>('[data-technology-links]')

        return list ? [{ list, items: [...list.querySelectorAll<HTMLElement>('[data-technology-item]')] }] : []
      })

      const updateResults = () => {
        const queryText = input.value.trim()
        const query = queryText.toLocaleLowerCase()
        const searching = query.length > 0
        const resultItems = document.createDocumentFragment()
        let visibleTotal = 0

        for (const { list, items } of catalogGroups) {
          for (const item of items) {
            const isMatch = !searching || (item.dataset.label ?? '').toLocaleLowerCase().includes(query)

            item.hidden = !isMatch

            item.querySelector('[data-technology-entry-unit]')?.classList.toggle('sr-only', !searching)

            if (searching && isMatch) resultItems.append(item)
            else list.append(item)

            if (isMatch) visibleTotal += 1
          }
        }

        matchesList.replaceChildren(resultItems)

        matchesQuery.textContent = queryText

        matches.hidden = !searching || visibleTotal === 0

        groups.hidden = searching

        if (shortcuts) shortcuts.hidden = searching

        empty.hidden = visibleTotal > 0

        statusPrefix.textContent = searching ? '' : copy.all

        statusCount.textContent = String(visibleTotal)

        statusUnit.textContent = visibleTotal === 1 ? copy.singular : copy.plural

        const foundLabel = visibleTotal === 1 ? copy.foundOne : copy.foundMany

        statusSuffix.textContent = searching ? foundLabel : '.'
      }

      input.addEventListener('input', updateResults)

      updateResults()
    }

    document.addEventListener('astro:page-load', setupTechnologyIndex)
  </script>
</PageLayout>

<style>
  [data-technology-match-group], [data-technology-match-arrow] { display: none; }
  [data-technology-matches-header] { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem 2rem; padding-bottom: 1rem; }
  [data-technology-matches-header] h2 { min-width: 0; margin: 0; color: hsl(var(--ink)); font-size: 1.125rem; font-weight: 500; line-height: 1.5; letter-spacing: -.03em; overflow-wrap: anywhere; }
  [data-technology-matches-header] p { flex-shrink: 0; margin: 0; color: hsl(var(--ink-soft)); font-size: .75rem; line-height: 1.8; }
  [data-technology-matches-list] { border-top: 1px solid hsl(var(--line)); }
  [data-technology-matches-list] [data-technology-item] { display: block; }
  [data-technology-matches-list] :global(a) { display: grid; grid-template-columns: minmax(0, 1fr) 6rem 6rem 1rem; align-items: center; gap: 1rem; min-height: 4.75rem; padding-block: 1.125rem; font-size: 1.125rem; font-weight: 500; line-height: 1.5; letter-spacing: -.025em; }
  [data-technology-matches-list] [data-technology-match-group] { display: block; color: hsl(var(--ink-soft)); font-size: .75rem; font-weight: 400; line-height: 1.8; letter-spacing: normal; }
  [data-technology-matches-list] [data-technology-project-count] { color: hsl(var(--ink)); font-size: .8125rem; line-height: 1.8; letter-spacing: normal; text-align: end; }
  [data-technology-matches-list] [data-technology-entry-unit] { color: hsl(var(--ink-soft)); font-size: .75rem; font-weight: 400; }
  [data-technology-matches-list] [data-technology-match-arrow] { display: block; color: hsl(var(--brand)); }
  [data-technology-matches-list] :global(a:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 4px; border-radius: .125rem; }
  :global([data-theme='santi020k-dark']) [data-technology-matches-list] [data-technology-match-arrow] { color: hsl(var(--accent)); }
  :global([data-theme='santi020k-dark']) [data-technology-matches-list] :global(a:focus-visible) { outline-color: hsl(var(--accent)); }
  @container technology-index (width < 34rem) {
    [data-technology-matches-header] { flex-direction: column; gap: .375rem; }
    [data-technology-matches-header] p { flex-shrink: 1; }
    [data-technology-matches-list] :global(a) { grid-template-columns: minmax(0, 1fr) auto; gap: .625rem; }
    [data-technology-matches-list] [data-technology-label] { grid-column: 1; grid-row: 1; }
    [data-technology-matches-list] [data-technology-match-group] { grid-column: 1; grid-row: 2; }
    [data-technology-matches-list] [data-technology-project-count] { grid-column: 2; grid-row: 2; }
    [data-technology-matches-list] [data-technology-match-arrow] { grid-column: 2; grid-row: 1; justify-self: end; }
  }

  [data-technology-intro] h2 { margin: 0; }
  [data-technology-opening-controls] { margin-top: 2rem; }
  [data-technology-opening-controls] [data-technology-filter-row] { padding-bottom: 0; }
  [data-technology-group-navigation] { margin-top: 2.25rem; border-block: 1px solid hsl(var(--line)); }
  [data-technology-group-navigation]:not([hidden]) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  [data-technology-group-navigation] :global(a) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; align-items: center; gap: .5rem .75rem; min-width: 0; padding-block: 1.25rem; color: hsl(var(--ink)); text-decoration: none; }
  [data-technology-shortcut-title] { font-size: 1.0625rem; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
  [data-technology-shortcut-meta] { grid-column: 1 / -1; color: hsl(var(--ink-soft)); font-size: .75rem; line-height: 1.8; overflow-wrap: anywhere; }
  [data-technology-group-navigation] :global(svg) { color: hsl(var(--brand)); }
  [data-technology-opening-actions] { display: flex; flex-wrap: wrap; gap: .75rem 1.75rem; margin-top: 1.5rem; }
  [data-technology-opening-actions] :global(a) { display: inline-flex; align-items: center; gap: .75rem; min-height: 2.75rem; color: hsl(var(--ink-soft)); font-size: .8125rem; line-height: 1.8; text-decoration: none; }
  [data-technology-opening-controls] :global(a:hover) { color: hsl(var(--brand)); }
  [data-technology-opening-controls] :global(a:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 4px; border-radius: .125rem; }
  :global([data-theme='santi020k-dark']) [data-technology-opening-controls] :global(a:hover),
  :global([data-theme='santi020k-dark']) [data-technology-group-navigation] :global(svg) { color: hsl(var(--accent)); }
  :global([data-theme='santi020k-dark']) [data-technology-opening-controls] :global(a:focus-visible) { outline-color: hsl(var(--accent)); }
  @container technology-index (width < 34rem) {
    [data-technology-group-navigation]:not([hidden]) { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-technology-group-navigation] :global(a + a) { border-top: 1px solid hsl(var(--line)); }
  }

  [data-technologies-empty] {
    padding-block: 1.75rem;
    border-bottom: 1px solid hsl(var(--line));
  }
  [data-technologies-empty]:not([hidden]) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
  }
  [data-technology-empty-icon] {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .75rem .1875rem .75rem .1875rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }
  :global([data-theme='santi020k-dark']) [data-technology-empty-icon] { color: hsl(var(--accent)); }
  [data-technologies-empty] h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.035em;
    hyphens: none;
  }
  [data-technologies-empty] p {
    margin-top: .75rem;
    color: hsl(var(--ink-soft));
    font-size: .875rem;
    line-height: 1.8;
  }
  @container technology-index (width < 32rem) {
    [data-technologies-empty] { padding-block: 1.5rem; }
    [data-technologies-empty]:not([hidden]) { gap: 1rem; }
    [data-technologies-empty] h2 { font-size: 1.375rem; }
  }
  @container technology-index (width < 18rem) {
    [data-technologies-empty]:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
  @container technology-index (width < 12rem) {
    [data-technologies-empty] h2 { font-size: 1.125rem; }
  }
</style>
