---
import Badge from '@/components/Badge.astro'

import { getAllProjects, getUniqueTechnologiesWithCount } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'

const allProjects = await getAllProjects()
const allTechnologies = getUniqueTechnologiesWithCount(allProjects)

const meta = {
  description: 'A list of all the topics I\'ve written about in my posts',
  title: 'All Tags'
};
---

<PageLayout meta={meta}>
  <h1 class="mb-6">Technologies</h1>
  <div class="flex flex-wrap items-center gap-2">
    {
      allTechnologies.map(([technology, val]) => (
        <div class="flex items-center gap-x-2">
          <a aria-label={`View all posts with the technology: ${technology}`} href={`/technologies/${technology}`}>
            <Badge variant="muted" title={technology}>
              <span class="text-xs font-normal">
                &nbsp;{val} post{val > 1 && 's'}
              </span>
            </Badge>
          </a>
        </div>
      ))
    }
  </div>
</PageLayout>
