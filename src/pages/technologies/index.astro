---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import PillCount from '@/components/atoms/PillCount.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { getUniqueTechnologiesWithCount } from '@/data/project'

const allProjects = await getCachedProjects()
const technologies = getUniqueTechnologiesWithCount(allProjects)
const topTechnology = technologies[0]?.[0]
const coreTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 4))
const regularTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 2 && count < 4))
const selectiveTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count === 1))

const technologyGroups = [
  {
    description: 'The core stack that shows up repeatedly across shipped projects.',
    items: coreTechnologies,
    title: 'Core'
  },
  {
    description: 'Technologies that support product delivery on a regular basis.',
    items: regularTechnologies,
    title: 'Regular'
  },
  {
    description: 'Specialized tools that appear in narrower product or platform contexts.',
    items: selectiveTechnologies,
    title: 'Selective'
  }
].filter(group => group.items.length > 0)

const meta = {
  description: 'Browse the technologies Santiago Molina uses across frontend architecture, product systems, testing, and delivery.',
  title: 'Technology Index'
}

---

<PageLayout meta={meta}>
  <PageHero
    description="The recurring stack across the portfolio: React, Next.js, TypeScript, Node.js, React Native, testing, DX, and the tools around them."
    eyebrow="Stack Index"
    gradientText="Full-stack range."
    title="Frontend-first stack."
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/portfolio/" showArrow variant="secondary">
      Back to portfolio
    </ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard description="Distinct tools and platforms across the full portfolio." label="Technologies" value={String(technologies.length)} />
    <StatCard description="The single technology that appears most often across shipped projects." label="Most used" value={topTechnology ?? ''} />
    <StatCard description="Frontend, backend, testing, delivery, and developer tooling." label="Scope" value="Full stack" />
  </StatsGrid>

  <section
    class="
      section-container-wide grid gap-8 pt-10
      lg:grid-cols-3
    "
    data-stagger="70"
  >
    {technologyGroups.map(group => (
      <Card class="h-full space-y-4 p-5" variant="muted">
        <div class="space-y-2">
          <p class="section-label">{group.title}</p>
          <p class="text-sm/6 text-ink-soft">{group.description}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {group.items.map(([technology, count]) => (
            <Pill href={getTechnologyPath(technology)} label={technology} tone="outline">
              <PillCount count={count} />
            </Pill>
          ))}
        </div>
      </Card>
    ))}
  </section>
</PageLayout>
