---
import ButtonLink from '../../components/atoms/ButtonLink.astro'
import Pill from '../../components/atoms/Pill.astro'
import SectionHeading from '../../components/molecules/SectionHeading.astro'
import { getAllProjects, getUniqueTechnologiesWithCount } from '../../data/project'
import PageLayout from '../../layouts/Base.astro'
import { getTechnologyPath } from '../../utils/links'

const allProjects = await getAllProjects()
const technologies = getUniqueTechnologiesWithCount(allProjects)

const meta = {
  description: 'Browse the technologies Santiago Molina uses across frontend architecture, product systems, testing, and delivery.',
  title: 'Technology Index'
}

const technologyPills = technologies.map(([technology, count]) => (
  // eslint-disable-next-line @typescript-eslint/no-unsafe-return
  <Pill href={getTechnologyPath(technology)} label={technology} tone="outline">
    <span class="text-xs text-ink-muted">{count}</span>
  </Pill>
))
---

<PageLayout meta={meta}>
  <section class="space-y-6">
    <SectionHeading
      description="This is the recurring stack across the portfolio: React, Next.js, TypeScript, Node.js, React Native, testing, DX, and the tools around them."
      eyebrow="Stack index"
      level="h1"
      title="A frontend-first stack with full-stack range."
    />
    <ButtonLink href="/portfolio/" showArrow variant="secondary">
      Back to portfolio
    </ButtonLink>
  </section>

  <section class="
    rounded-4xl p-6 panel-surface
    sm:p-8
  "
  >
    <div class="flex flex-wrap gap-3">
      {technologyPills}
    </div>
  </section>
</PageLayout>
