---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { Card, Icon, Input, Link, MotionGroup } from '@santi020k/lumen-astro'

import { getUniqueTechnologiesWithCount } from '@/data/project'

const allProjects = await getCachedProjects()
const technologies = getUniqueTechnologiesWithCount(allProjects)
const topTechnology = technologies[0]?.[0]
const totalTechnologyMentions = technologies.reduce((total, [, count]) => total + count, 0)
const coreTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 4))
const regularTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 2 && count < 4))
const selectiveTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count === 1))

const technologyGroups = [
  {
    items: coreTechnologies,
    summary: 'Repeated foundations across product architecture, delivery workflows, and the portfolio surface.',
    title: 'Core'
  },
  {
    items: regularTechnologies,
    summary: 'Reliable companion tools that help teams ship, test, document, and maintain production systems.',
    title: 'Regular'
  },
  {
    items: selectiveTechnologies,
    summary: 'Context-specific platforms, APIs, and product capabilities used when the problem calls for them.',
    title: 'Selective'
  }
].filter(group => group.items.length > 0)

const meta = {
  description: 'Browse Santiago Molina’s capabilities and technologies across frontend architecture, product systems, testing, and delivery.',
  title: 'Capabilities & Technologies'
}

---

<PageLayout mainClass="remaining-pages" meta={meta}>
  <PageHero
    description="The recurring capabilities and technologies across the portfolio: frontend and backend architecture, testing, delivery automation, developer experience, and the platforms around them."
    eyebrow="Capabilities index"
    gradientText="Full-stack range."
    metaItems={['Frontend architecture', 'Testing', 'Delivery tooling']}
    title="Capabilities and technologies."
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/portfolio/" showArrow variant="secondary">
      Back to portfolio
    </ButtonLink>
  </PageHero>

  <PageSection layout="stacked">
    <SectionHeader
      description="Grouped by how often each tool appears in shipped work, with the most product-shaping technologies kept easiest to scan."
      eyebrow="Technology groups"
      title="The stack by recurrence."
    />

    <Card class="p-0" data-technology-catalog variant="muted">
      <div data-technology-index>
        <div data-technology-filter-row>
          <p data-technology-search-eyebrow>Stack snapshot</p>
          <div data-technology-search-dock>
            <div data-technology-search-field>
              <span data-technology-search-mark><Icon class="size-5.25" name="search" /></span>
              <div>
                <label for="technology-filter">Find a technology</label>
                <Input
                  aria-describedby="technology-filter-status"
                  autocomplete="off"
                  data-technology-search-input
                  id="technology-filter"
                  placeholder="Search technologies…"
                  spellcheck="false"
                  type="search"
                />
              </div>
            </div>
            <p
              aria-atomic="true"
              aria-live="polite"
              data-technology-search-counter
              id="technology-filter-status"
            >
              <span class="sr-only" data-technology-result-prefix>Showing all </span><span data-technology-result-count>{technologies.length}</span>{' '}<span data-technology-result-unit>technologies</span><span
class="sr-only"
data-technology-result-suffix
                                                                                                                                                                                                              >.</span>
            </p>
          </div>
          <p data-technology-search-note>
            Search the full index, then follow any technology to the projects where it appears.
          </p>
        </div>

        <div data-technology-groups>
          {technologyGroups.map((group, index) => (
            <section
              aria-labelledby={`technology-group-${index}`}
              data-technology-group
            >
              <div data-technology-intro>
                <h3 id={`technology-group-${index}`}>
                  <span data-technology-heading>
                    <span
aria-hidden="true"
data-technology-number
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span data-technology-title>{group.title}
                    </span>
                  </span>
                  <span
data-technology-group-count
                  >
                    {group.items.length} {group.items.length === 1 ? 'tool' : 'tools'}
                  </span>
                </h3>
                <p class="max-w-sm text-sm/6 text-ink-soft">{group.summary}</p>
              </div>

              <MotionGroup aria-label={`${group.title} technologies`} data-technology-links enterExit={false} role="list">
                {group.items.map(([technology, count]) => (
                  <span data-label={technology} data-technology-item data-ui-motion-key={technology} role="listitem">
                    <Link
                      href={getTechnologyPath(technology)}
                      variant="inherit"
                    >
                      <span data-technology-label>{technology}</span>{' '}
                      <span data-technology-project-count>{count}<span class="
                        sr-only
                      "
                                                                 > {count === 1 ? 'project' : 'projects'}</span></span>
                    </Link>
                  </span>
                ))}
              </MotionGroup>
            </section>
          ))}
        </div>

        <section
          aria-labelledby="technology-empty-heading"
          data-technologies-empty
          hidden
        >
          <span data-technology-empty-icon><Icon class="size-5.5" name="search-x" /></span>
          <div>
            <h3 id="technology-empty-heading">No technologies match that search.</h3>
            <p>Try a broader term or clear the search field.</p>
          </div>
        </section>
      </div>
    </Card>
  </PageSection>

  <StatsGrid showDivider={false}>
    <StatCard description="Distinct capabilities, tools, and platforms across the full portfolio." icon="code-xml" label="Technologies" value={technologies.length} />
    <StatCard description="The single technology that appears most often across shipped projects." icon="star" label="Most used" value={topTechnology ?? ''} />
    <StatCard description="Tagged project evidence connecting tools back to shipped work." icon="layers" label="Signals" value={totalTechnologyMentions} />
    <StatCard description="Frontend, backend, testing, delivery, and developer tooling." icon="layers" label="Scope" value="Full stack" />
  </StatsGrid>

  <PageSection layout="stacked">
    <section aria-labelledby="technology-evidence-heading" id="trace-the-evidence">
      <Card data-technology-evidence variant="unstyled">
        <header data-evidence-header>
          <p data-evidence-label>Trace the evidence</p>
          <h2 id="technology-evidence-heading">Tools are easier to trust when they point to real work.</h2>
        </header>
        <div data-evidence-body>
          <p data-evidence-copy>
            Each technology page filters the portfolio to the projects where that tool shaped the
            architecture, delivery workflow, or product experience.
          </p>
          <div data-evidence-actions>
            <ButtonLink href="/portfolio/" showArrow>Browse portfolio</ButtonLink>
            <ButtonLink href="/blog/" showArrow variant="inline">Read the writing</ButtonLink>
          </div>
        </div>
      </Card>
    </section>
  </PageSection>

  <script>
    const setupTechnologyIndex = () => {
      const groups = document.querySelector<HTMLElement>('[data-technology-groups]')
      const input = document.querySelector<HTMLInputElement>('#technology-filter')
      const status = document.getElementById('technology-filter-status')
      const statusPrefix = status?.querySelector('[data-technology-result-prefix]')
      const statusCount = status?.querySelector('[data-technology-result-count]')
      const statusUnit = status?.querySelector('[data-technology-result-unit]')
      const statusSuffix = status?.querySelector('[data-technology-result-suffix]')
      const empty = document.querySelector<HTMLElement>('[data-technologies-empty]')

      if (!groups || !input || !statusPrefix || !statusCount || !statusUnit || !statusSuffix || !empty || groups.dataset.filterReady === 'true') return

      groups.dataset.filterReady = 'true'

      const groupElements = groups.querySelectorAll<HTMLElement>('[data-technology-group]')

      input.addEventListener('input', () => {
        const query = input.value.trim().toLocaleLowerCase()
        let visibleTotal = 0

        groupElements.forEach(group => {
          const groupItems = group.querySelectorAll<HTMLElement>('[data-technology-item]')

          const count = [...groupItems].reduce((total, item) => {
            const matches = !query || (item.dataset.label ?? '').toLocaleLowerCase().includes(query)

            item.hidden = !matches

            return total + (matches ? 1 : 0)
          }, 0)

          const countLabel = group.querySelector<HTMLElement>('[data-technology-group-count]')

          group.hidden = count === 0

          if (countLabel) countLabel.textContent = `${count} ${count === 1 ? 'tool' : 'tools'}`

          visibleTotal += count
        })

        empty.hidden = visibleTotal > 0

        statusPrefix.textContent = query ? '' : 'Showing all '

        statusCount.textContent = String(visibleTotal)

        statusUnit.textContent = visibleTotal === 1 ? 'technology' : 'technologies'

        statusSuffix.textContent = query ? ' found.' : '.'
      })
    }

    document.addEventListener('astro:page-load', setupTechnologyIndex)
  </script>
</PageLayout>

<style>
  [data-technologies-empty] {
    padding-block: 1.75rem;
    border-bottom: 1px solid hsl(var(--line));
  }
  [data-technologies-empty]:not([hidden]) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
  }
  [data-technology-empty-icon] {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .75rem .1875rem .75rem .1875rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }
  :global([data-theme='dark']) [data-technology-empty-icon] { color: hsl(var(--accent)); }
  [data-technologies-empty] h3 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.035em;
    hyphens: none;
  }
  [data-technologies-empty] p {
    margin-top: .75rem;
    color: hsl(var(--ink-soft));
    font-size: .875rem;
    line-height: 1.8;
  }
  @container technology-index (width < 32rem) {
    [data-technologies-empty] { padding-block: 1.5rem; }
    [data-technologies-empty]:not([hidden]) { gap: 1rem; }
    [data-technologies-empty] h3 { font-size: 1.375rem; }
  }
  @container technology-index (width < 18rem) {
    [data-technologies-empty]:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
  @container technology-index (width < 12rem) {
    [data-technologies-empty] h3 { font-size: 1.125rem; }
  }
</style>
