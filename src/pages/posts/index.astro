---
import { getCollection } from 'astro:content'

import ButtonLink from '../../components/atoms/ButtonLink.astro'
import PostCard from '../../components/molecules/PostCard.astro'
import SectionHeading from '../../components/molecules/SectionHeading.astro'
import StatCard from '../../components/molecules/StatCard.astro'
import PageLayout from '../../layouts/Base.astro'
import { siteConfig } from '../../site.config'

const posts = (await getCollection('post', ({ data }) => (
  import.meta.env.PROD ? !data.draft : true
)))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())

const uniqueTags = new Set(posts.flatMap(post => post.data.tags)).size
---

<PageLayout
  meta={{
    description: 'Writing by Santiago Molina on frontend architecture, DX, React, TypeScript, testing, and the workflows behind reliable product teams.',
    title: 'Blog'
  }}
>
  <section class="
    grid gap-6
    lg:grid-cols-[1.15fr_0.85fr]
  "
  >
    <SectionHeading
      description="I write about frontend architecture, DX, testing, and the small workflow decisions that make teams faster. Full articles live on Medium and Towards Dev; this site keeps the short version."
      eyebrow="Blog"
      level="h1"
      title="Writing about frontend craft, systems, and developer experience."
    />

    <div class="
      grid gap-4
      sm:grid-cols-2
      lg:grid-cols-1
    "
    >
      <StatCard description="Articles currently hosted on my site and cross-posted to Medium." label="Posts" value={String(posts.length)} />
      <StatCard description="Topics and themes covered in my writing across various publications." label="Tags" value={String(uniqueTags)} />
    </div>
  </section>

  <section class="flex flex-wrap gap-3">
    <ButtonLink href={siteConfig.contact.medium} newTab showArrow>
      Open Medium profile
    </ButtonLink>
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
  </section>

  <section class="
    grid gap-6
    lg:grid-cols-2
    xl:grid-cols-3
  "
  >
    {posts.map(post => (

      <PostCard post={post} />
    ))}
  </section>
</PageLayout>
