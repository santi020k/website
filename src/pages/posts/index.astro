---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import StatCard from '@/components/molecules/StatCard.astro'

import { getMediumPosts } from '@/data/medium'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const posts = [...await getMediumPosts()]
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())

const latestPublicationCount = new Set(posts.map(post => post.publication)).size

const meta = {
  description: 'Writing by Santiago Molina on frontend architecture, DX, React, TypeScript, testing, and the workflows behind reliable product teams.',
  title: 'Blog'
}
---

<PageLayout meta={meta}>
  <section class="
    grid gap-6
    lg:grid-cols-[1.15fr_0.85fr]
  "
  >
    <SectionHeading
      description="I write about frontend architecture, DX, testing, and the small workflow decisions that make teams faster. Full articles live on Medium and Towards Dev; this site keeps the short version."
      eyebrow="Blog"
      level="h1"
      title="Writing about frontend craft, systems, and developer experience."
    />

    <div class="
      grid gap-4
      sm:grid-cols-2
      lg:grid-cols-1
    "
    >
      <StatCard description="Articles currently pulled into the site from my Medium feed." label="Posts" value={String(posts.length)} />
      <StatCard description="Publications currently represented across Medium and Towards Dev." label="Publications" value={String(latestPublicationCount)} />
    </div>
  </section>

  <section class="flex flex-wrap gap-3">
    <ButtonLink href={siteConfig.contact.medium} newTab showArrow>
      Open Medium profile
    </ButtonLink>
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
  </section>

  <section class="
    grid gap-6
    lg:grid-cols-2
    xl:grid-cols-3
  "
  >
    {posts.map(post => (
      <PostCard post={post} />
    ))}
  </section>
</PageLayout>
