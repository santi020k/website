---
import { getImage } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import CommunityCard from '@/components/molecules/CommunityCard.astro'
import PostListItem from '@/components/molecules/PostListItem.astro'
import ProjectPreviewCard from '@/components/molecules/ProjectPreviewCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import HomeHero from '@/components/pages/home/HomeHero.astro'
import HomeStats from '@/components/pages/home/HomeStats.astro'

import { getCachedPosts, getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getPortfolioPath, getPostPath } from '@/utils/links'

import AboutMeImage from '@/assets/photos/about-me.webp'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig, YEARS_OF_EXPERIENCE } from '@/site.config'

const [allProjects, allPosts] = await Promise.all([getCachedProjects(), getCachedPosts()])

const workProjects = allProjects
  .filter(project => project.data.typesId === 'professional')
  .sort(collectionDateSortProjects)
  .slice(0, 4)

const personalProjects = allProjects
  .filter(project => project.data.typesId === 'personal')
  .sort(collectionDateSortProjects)
  .slice(0, 4)

const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4)

const yearsOfExperience = YEARS_OF_EXPERIENCE
const contactHref = siteConfig.contact.whatsapp

const heroPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  widths: [400, 600, 800]
})

const homePageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: 'Work experience',
      itemListElement: workProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPortfolioPath(project.id), Astro.site).href,
        name: project.data.title
      }))
    },
    {
      '@type': 'ItemList',
      name: 'Side projects',
      itemListElement: personalProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPortfolioPath(project.id), Astro.site).href,
        name: project.data.title
      }))
    },
    {
      '@type': 'ItemList',
      name: 'Latest writing',
      itemListElement: latestPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPostPath(post.id), Astro.site).href,
        name: post.data.title
      }))
    }
  ]
}

const meta = {
  description:
    `I'm Santiago Molina (@santi020k), an Engineering Leader & Full-Stack Architect with ${YEARS_OF_EXPERIENCE} years of experience building resilient systems and scaling technical teams.`,
  preloadImage: {
    href: heroPortraitImage.src,
    imagesizes: '(min-width: 1024px) 352px, 75vw',
    imagesrcset: heroPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  structuredData: homePageSchema,
  title: 'Engineering Leader & Full-Stack Architect'
}
---

<PageLayout meta={meta}>
  <HomeHero contactHref={contactHref} yearsOfExperience={yearsOfExperience} />
  <div class="mt-12 lg:mt-16 2xl:mt-20">
    <HomeStats yearsOfExperience={yearsOfExperience} />
  </div>

  {/* Work Experience */}
  <section
    class="
      relative left-1/2 w-screen -translate-x-1/2 overflow-hidden py-20
      sm:py-24
      lg:py-28
    "
  >
    <div
      aria-hidden="true"
      class="
        pointer-events-none absolute inset-x-0 top-8 bottom-8 bg-radial
        from-brand/8 via-surface/4 to-transparent
      "
    />
    <div class="
      relative mx-auto w-full max-w-[88rem] space-y-8 px-5
      sm:px-6
      lg:px-8
      2xl:px-10
    "
    >
      <SectionHeader
        align="center"
        eyebrow="Work Experience"
        title="Professional roles."
        description="Client and product work across teams and industries."
      />
      <div class="space-y-6">
        <div
          class="
            grid gap-5
            md:grid-cols-2
            xl:grid-cols-4
          "
          data-stagger="60"
        >
          {workProjects.map(project => (
            <ProjectPreviewCard project={project} accentTone="brand" />
          ))}
        </div>
        <div class="
          section-actions
          sm:justify-center
        "
        >
          <ButtonLink href="/work/" showArrow>
            View all work
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
            LinkedIn
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  {/* Side Projects */}
  <section
    class="
      relative left-1/2 w-screen -translate-x-1/2 overflow-hidden py-20
      sm:py-24
      lg:py-28
    "
  >
    <div
      aria-hidden="true"
      class="
        pointer-events-none absolute inset-x-0 top-8 bottom-8 bg-radial
        from-accent/7 via-surface/4 to-transparent
      "
    />
    <div class="
      relative mx-auto w-full max-w-[88rem] space-y-8 px-5
      sm:px-6
      lg:px-8
      2xl:px-10
    "
    >
      <SectionHeader
        align="center"
        eyebrow="Side Projects"
        title="Built for the love of it."
        description="Open source, community work, and experiments."
      />
      <div class="space-y-6">
        <div
          class="
            grid gap-5
            md:grid-cols-2
            xl:grid-cols-4
          "
          data-stagger="60"
        >
          {personalProjects.map(project => (
            <ProjectPreviewCard project={project} accentTone="accent" />
          ))}
        </div>
        <div class="
          section-actions
          sm:justify-center
        "
        >
          <ButtonLink href="/projects/" showArrow>
            View all projects
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.github} newTab showArrow variant="secondary">
            GitHub
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  {/* Writing */}
  <PageSection>
    <SectionHeader
      eyebrow="Writing"
      title="Thoughts on building and leading."
      description="Articles on architecture, automation, and engineering decisions."
      variant="shelf"
    />
    <div class="space-y-6">
      <div class="panel-card p-2 sm:p-4" data-stagger="50">
        {latestPosts.map(post => (
          <PostListItem post={post} />
        ))}
      </div>
      <div class="section-actions">
        <ButtonLink href="/blog/" showArrow>
          Read all articles
        </ButtonLink>
        <ButtonLink href="/feed.xml" showArrow variant="secondary">
          RSS
        </ButtonLink>
      </div>
    </div>
  </PageSection>

  {/* Speaking & Community */}
  <PageSection>
    <SectionHeader
      eyebrow="Beyond the code"
      title="Speaking & Community."
      description="Co-organizing ReactJS Colombia and speaking on DX, automation, and engineering leadership at local and regional events."
      variant="shelf"
    />
    <div class="space-y-6">
      <div
        class="
          grid gap-4
          md:grid-cols-2
        "
        data-stagger="60"
      >
        <CommunityCard
          title="ReactJS Colombia"
          subtitle="Co-organizer"
          description="Building the local React community through meetups, workshops, and knowledge sharing."
          icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
          tone="brand"
        />
        <CommunityCard
          title="Technical Talks"
          subtitle="Speaker"
          description="Sharing practical insights on DX, architecture, and engineering leadership."
          icon='<path d="M12 8a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2 2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Z"/><path d="M19 11V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10"/><path d="M3 13h4"/><path d="M17 13h4"/><path d="M19 13v4"/><path d="M5 13v4"/>'
          tone="accent"
        />
      </div>
      <div class="section-actions">
        <ButtonLink href="/speaking/" showArrow>
          Speaking
        </ButtonLink>
        <ButtonLink href="http://meetup.com/react-js-medellin" newTab showArrow variant="secondary">
          ReactJS Colombia
        </ButtonLink>
      </div>
    </div>
  </PageSection>
</PageLayout>
