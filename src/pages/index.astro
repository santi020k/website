---
import { getImage } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import CommunityCard from '@/components/molecules/CommunityCard.astro'
import PostListItem from '@/components/molecules/PostListItem.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import HomeHero from '@/components/pages/home/HomeHero.astro'
import HomeProjectShowcase from '@/components/pages/home/HomeProjectShowcase.astro'
import HomeStats from '@/components/pages/home/HomeStats.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

import AboutMeImage from '@/assets/photos/originals/santiago-profile-with-dog.jpg'
import { getCachedPosts, getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getPortfolioPath, getPostPath } from '@/utils/links'

import { siteConfig, YEARS_OF_EXPERIENCE } from '@/site.config'

const [allProjects, allPosts] = await Promise.all([getCachedProjects(), getCachedPosts()])

const workProjects = allProjects
  .filter(project => project.data.typesId === 'professional')
  .sort(collectionDateSortProjects)
  .slice(0, 4)

const personalProjects = allProjects
  .filter(project => project.data.typesId === 'personal')
  .sort(collectionDateSortProjects)
  .slice(0, 4)

const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4)

const yearsOfExperience = YEARS_OF_EXPERIENCE

const heroPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  widths: [400, 600, 800]
})

const homePageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: 'Work experience',
      itemListElement: workProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPortfolioPath(project.id), Astro.site).href,
        name: project.data.title
      }))
    },
    {
      '@type': 'ItemList',
      name: 'Side projects',
      itemListElement: personalProjects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPortfolioPath(project.id), Astro.site).href,
        name: project.data.title
      }))
    },
    {
      '@type': 'ItemList',
      name: 'Latest writing',
      itemListElement: latestPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(getPostPath(post.id), Astro.site).href,
        name: post.data.title
      }))
    }
  ]
}

const meta = {
  description: [
    `I'm Santiago Molina (@santi020k), an Engineering Leader & Full-Stack Architect with ${YEARS_OF_EXPERIENCE}`,
    'years of experience building resilient systems and scaling technical teams.'
  ].join(' '),
  preloadImage: {
    href: heroPortraitImage.src,
    imagesizes: '(min-width: 1024px) 352px, 75vw',
    imagesrcset: heroPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  structuredData: homePageSchema,
  title: 'Engineering Leader & Full-Stack Architect'
}
---

<PageLayout
  mainSpacing="home"
  meta={meta}
>
  <HomeHero yearsOfExperience={yearsOfExperience} />
  <div
    class="
      section-container-wide
      scroll-mt-28 pt-10
      sm:pt-12
      lg:pt-14
    "
    id="home-stats"
  >
    <HomeStats yearsOfExperience={yearsOfExperience} />
  </div>

  {/* Santiago likes the breathing room between homepage sections. Keep the spacing intentional. */}
  <HomeProjectShowcase
    actions={[
      { href: '/work/', label: 'View all work' },
      { href: siteConfig.contact.linkedin, label: 'LinkedIn', newTab: true, variant: 'secondary' }
    ]}
    description="Client and product work where architecture, delivery systems, and team leadership mattered."
    eyebrow="Work Experience"
    projects={workProjects}
    title="Professional roles."
  />

  <HomeProjectShowcase
    actions={[
      { href: '/projects/', label: 'View all projects' },
      { href: siteConfig.contact.github, label: 'GitHub', newTab: true, variant: 'secondary' }
    ]}
    description="Open source, community work, and experiments with a little more room to explore."
    eyebrow="Side Projects"
    layout="reverse"
    projects={personalProjects}
    supportingLabel="More selected projects"
    title="Built for the love of it."
    tone="accent"
  />

  {/* Writing */}
  <PageSection class="section-container-wide pt-22 sm:pt-24 lg:pt-28">
    <SectionHeader
      eyebrow="Writing"
      title="Thoughts on building and leading."
      description="Articles on architecture, automation, and engineering decisions."
      variant="shelf"
    />
    <div class="space-y-6">
      <Card
        class="
          p-2
          sm:p-4
        "
        data-stagger="50"
      >
        {latestPosts.map(post => (
          <PostListItem post={post} />
        ))}
      </Card>
      <div class="section-actions">
        <ButtonLink href="/blog/" showArrow>
          Read all articles
        </ButtonLink>
        <ButtonLink href="/feed.xml" showArrow variant="secondary">
          RSS
        </ButtonLink>
      </div>
    </div>
  </PageSection>

  {/* Speaking & Community */}
  <PageSection class="section-container-wide pt-22 sm:pt-24 lg:pt-28">
    <SectionHeader
      eyebrow="Beyond the code"
      title="Speaking & Community."
      description="Co-organizing ReactJS Colombia and speaking on DX, automation, and engineering leadership at local and regional events."
      variant="shelf"
    />
    <div class="space-y-6">
      <div
        class="
          grid gap-4
          md:grid-cols-2
        "
        data-stagger="60"
      >
        <CommunityCard
          title="ReactJS Colombia"
          subtitle="Co-organizer"
          description="Building the local React community through meetups, workshops, and knowledge sharing."
          icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
          tone="brand"
        />
        <CommunityCard
          title="Technical Talks"
          subtitle="Speaker"
          description="Sharing practical insights on DX, architecture, and engineering leadership."
          icon='<path d="M12 8a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2 2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Z"/><path d="M19 11V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v10"/><path d="M3 13h4"/><path d="M17 13h4"/><path d="M19 13v4"/><path d="M5 13v4"/>'
          tone="accent"
        />
      </div>
      <div class="section-actions">
        <ButtonLink href="/speaking/" showArrow>
          Speaking
        </ButtonLink>
        <ButtonLink href="http://meetup.com/react-js-medellin" newTab showArrow variant="secondary">
          ReactJS Colombia
        </ButtonLink>
      </div>
    </div>
  </PageSection>
</PageLayout>
