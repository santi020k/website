---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import AboutMeImage from '../assets/photos/about-me.webp'
import ButtonLink from '../components/atoms/ButtonLink.astro'
import Eyebrow from '../components/atoms/Eyebrow.astro'
import Pill from '../components/atoms/Pill.astro'
import PostCard from '../components/molecules/PostCard.astro'
import ProjectCard from '../components/molecules/ProjectCard.astro'
import SectionHeading from '../components/molecules/SectionHeading.astro'
import StatCard from '../components/molecules/StatCard.astro'
import { getAllProjects, getTechnologiesByUsage } from '../data/project'
import PageLayout from '../layouts/Base.astro'
import { siteConfig } from '../site.config'
import { collectionDateSortProjects } from '../utils/date'
import { getTechnologyPath } from '../utils/links'

const allProjects = await getAllProjects()
const allPosts = await getCollection('post')

const featuredProjects = allProjects
  .filter(project => project.data.typesId === 'professional')
  .sort(collectionDateSortProjects)
  .slice(0, 3)

const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)

const topTechnologies = getTechnologiesByUsage(allProjects).slice(0, 10)
const yearsOfExperience = `${new Date().getFullYear() - 2014}+`
const [featuredProject, ...supportingProjects] = featuredProjects
const [featuredPost, ...supportingPosts] = latestPosts

const meta = {
  description:
    'Engineering Leader & Full-Stack Architect with 10+ years of experience building resilient systems and scaling technical teams.',
  title: 'Engineering Leader & Full-Stack Architect'
}
---

<PageLayout meta={meta}>
  <section
    class="
      grid gap-10
      lg:grid-cols-[1.08fr_0.92fr] lg:items-end
    "
    data-animate
  >
    <div class="space-y-10">
      <Eyebrow
        label="Leadership · Automation · DX"
        tone="brand"
        className="
          text-center whitespace-normal
          sm:text-left
        "
      />

      <div class="space-y-5">
        <h1 class="
          max-w-4xl text-3xl wrap-break-word
          sm:text-6xl
          lg:text-7xl
        "
        >
          Full-stack engineer, tech lead, and builder of developer-first systems.
        </h1>
        <p class="
          max-w-3xl text-base/7 text-ink-soft
          sm:text-xl/8
        "
        >
          {siteConfig.headline} Over the last {yearsOfExperience} years I have shipped across commerce, SaaS, gaming,
          and real estate — leading cross-functional teams, building automation that eliminates toil, and raising the
          bar on developer experience at every layer of the stack.
        </p>
      </div>

      <div class="section-actions">
        <ButtonLink href="/portfolio/" showArrow>
          See selected work
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="secondary">
          Read the writing
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.resume} newTab showArrow variant="ghost">
          Open resume
        </ButtonLink>
      </div>

      <div class="
        grid gap-3
        sm:max-w-2xl sm:grid-cols-2
      "
      >
        <div class="mini-note">
          <p class="section-label">Based in</p>
          <p class="mt-2 text-base/7 text-ink">{siteConfig.location}</p>
        </div>
        <div class="mini-note">
          <p class="section-label">Open to</p>
          <p class="mt-2 text-base/7 text-ink">{siteConfig.availability}</p>
        </div>
      </div>
    </div>

    <div class="relative w-full">
      <div class="
        pointer-events-none absolute inset-x-8 top-8 h-24 rounded-full
        bg-brand/12 blur-3xl
      "
      />
      <div class="relative z-10 grid gap-4">
        <div class="
          panel-card overflow-hidden rounded-4xl p-4
          sm:p-5
        "
        >
          <Image
            alt="Portrait of Santiago Molina"
            class="aspect-4/5 w-full rounded-[1.6rem] object-cover"
            fetchpriority="high"
            loading="eager"
            sizes="(min-width: 1024px) 400px, 100vw"
            src={AboutMeImage}
            widths={[400, 600, 800]}
          />
        </div>
        <div class="
          grid gap-3
          sm:grid-cols-2
        "
        >
          <div class="mini-note">
            <p class="section-label">Primary focus</p>
            <p class="mt-2 text-lg font-semibold text-ink">Full-stack · Automation · DX</p>
          </div>
          <div class="mini-note">
            <p class="section-label">Working style</p>
            <p class="mt-2 text-lg font-semibold text-ink">Hands-on tech leadership</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="
      grid gap-6 border-t border-line/70 pt-10
      md:grid-cols-2
      xl:grid-cols-4
    "
    data-animate
  >
    <StatCard description="Years shipping web and mobile products across full-stack, leadership, and automation roles." label="Experience" value={yearsOfExperience} />
    <StatCard description="Largest cross-functional team I have led across product, design, frontend, and backend." label="Team led" value="14" />
    <StatCard description="Reduced release lead times by optimizing CI/CD pipelines and automating quality gates." label="Cycle Time" value="-75%" />
    <StatCard description="Typical attendance for ReactJS Colombia meetups, workshops, and talks." label="Community" value="100+" />
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="React and TypeScript sit at the center, but the work extends across the full stack: backend services, automation pipelines, testing infrastructure, and delivery tooling."
      eyebrow="Stack"
      title="A full-stack toolkit built around automation and DX."
    />
    <div class="space-y-5">
      <p class="max-w-3xl text-sm/6 text-ink-muted">
        Most-used tools across shipped products, delivery pipelines, and day-to-day engineering workflows.
      </p>
      <div class="flex flex-wrap gap-3">
        {topTechnologies.map(technology => (
          <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="From headless commerce and esports to real estate and open source, these projects show how I approach architecture, automation, and delivery under real constraints."
      eyebrow="Selected work"
      linkHref="/portfolio/"
      linkLabel="View all projects"
      title="Work shaped by real teams, real constraints, and measurable outcomes."
    />
    <div class="space-y-6">
      {featuredProject && <ProjectCard featured project={featuredProject} />}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {supportingProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="The throughline in my work is making engineering calmer: clearer priorities, fewer avoidable decisions under pressure, and better systems for the people shipping them."
      eyebrow="Approach"
      title="The work is technical, but the goal is always team clarity."
    />
    <div class="
      grid gap-6
      lg:grid-cols-3
    "
    >
      <div class="
        panel-card h-full p-6
        sm:p-7
        lg:col-span-2
      "
      >
        <p class="section-label">What I do now</p>
        <h2 class="mt-4 text-3xl">Engineering that ships and systems that last.</h2>
        <p class="mt-4 max-w-2xl text-base/7 text-ink-soft">
          My work spans full-stack delivery, developer tooling, and automation: finding the slowest parts of a
          team’s workflow and replacing them with repeatable systems that make shipping feel calmer and more predictable.
        </p>
      </div>
      <div class="space-y-6">
        <div class="h-full mini-note">
          <p class="section-label">How I lead</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            I stay close to the code, set useful standards, and help teams make better technical decisions earlier.
          </p>
        </div>
        <div class="h-full mini-note">
          <p class="section-label">Outside the sprint</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            I co-organize ReactJS Colombia, write about DX and workflows, and keep building while working remotely from Medellin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="I write about software architecture, full-stack systems, automation, and the engineering decisions that help teams ship with confidence. Published in Towards Dev and on Medium."
      eyebrow="Writing"
      linkHref="/blog/"
      linkLabel="See all articles"
      title="Practical writing for engineers who build and lead."
    />
    <div class="space-y-6">
      {featuredPost && <PostCard featured post={featuredPost} />}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {supportingPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>
</PageLayout>
