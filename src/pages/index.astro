---
import { getImage, Picture } from 'astro:assets'
import { getCollection } from 'astro:content'

import AboutMeImage from '../assets/photos/about-me.webp'
import ButtonLink from '../components/atoms/ButtonLink.astro'
import Eyebrow from '../components/atoms/Eyebrow.astro'
import Pill from '../components/atoms/Pill.astro'
import PostCard from '../components/molecules/PostCard.astro'
import ProjectCard from '../components/molecules/ProjectCard.astro'
import SectionHeading from '../components/molecules/SectionHeading.astro'
import StatCard from '../components/molecules/StatCard.astro'
import { speakingTopics, usesHighlights } from '../data/profile'
import { getAllProjects, getUniqueTechnologiesWithCount } from '../data/project'
import PageLayout from '../layouts/Base.astro'
import { siteConfig } from '../site.config'
import { collectionDateSortProjects } from '../utils/date'
import { getTechnologyPath } from '../utils/links'
import { sortTechnologyCountsByInterest } from '../utils/technologies'

const allProjects = await getAllProjects()
const allPosts = await getCollection('post')

const featuredProjects = allProjects
  .filter(project => project.data.typesId === 'professional')
  .sort(collectionDateSortProjects)
  .slice(0, 3)

const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)

const allTechnologies = getUniqueTechnologiesWithCount(allProjects)
const topTechnologies = sortTechnologyCountsByInterest(allTechnologies).slice(0, 50)
const hiddenTechnologyCount = Math.max(0, allTechnologies.length - topTechnologies.length)
const yearsOfExperience = `${new Date().getFullYear() - 2014}+`
const [featuredProject, ...supportingProjects] = featuredProjects
const [featuredPost, ...supportingPosts] = latestPosts
const featuredSpeakingTopics = speakingTopics.slice(0, 3)

const heroPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  widths: [400, 600, 800]
})

const meta = {
  description:
    'Engineering Leader & Full-Stack Architect with 12+ years of experience building resilient systems and scaling technical teams.',
  preloadImage: {
    href: heroPortraitImage.src,
    imagesizes: '(min-width: 1024px) 352px, 75vw',
    imagesrcset: heroPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  title: 'Engineering Leader & Full-Stack Architect'
}
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="
      relative grid gap-10
      lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center
    "
    >
      <div class="relative z-10 space-y-8">
        <Eyebrow
          label="Santiago Molina"
          tone="brand"
          className="
            animate-slide-up whitespace-normal
            motion-reduce:animate-none
          "
        />

        <div
          class="
            animate-slide-up space-y-4
            motion-reduce:animate-none
          "
          style="animation-delay: 90ms"
        >
          <h1 class="
            max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
            sm:text-6xl/[0.95]
            lg:text-[5.2rem]/[0.92]
          "
          >
            Calm systems.
            <span class="block text-brand">Clear delivery.</span>
          </h1>
          <p class="
            max-w-xl text-base/7 text-ink-soft
            sm:text-lg/7
          "
          >
            Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
          </p>
        </div>

        <div
          class="
            animate-slide-up space-y-5
            motion-reduce:animate-none
          "
          style="animation-delay: 180ms"
        >
          <div class="
            inline-flex min-h-14 flex-wrap items-center gap-3 rounded-full
            border border-line/70 bg-surface/78 px-4 py-3
            shadow-[0_10px_26px_hsl(var(--ink)/0.04)]
          "
          >
            <span class="section-label">Focus</span>
            <span
              aria-hidden="true"
              class="
                hidden h-px w-8 bg-linear-to-r from-line to-transparent
                sm:block
              "
            />
            <div class="
              hidden h-6 overflow-hidden
              motion-reduce:hidden
              sm:block
            "
            >
              <div class="
                grid auto-rows-[1.5rem] will-change-transform
                motion-safe:animate-hero-phrase-cycle
              "
              >
                <span class="text-sm font-semibold text-ink">Architecture systems</span>
                <span class="text-sm font-semibold text-ink">Automation flows</span>
                <span class="text-sm font-semibold text-ink">Developer experience</span>
                <span class="text-sm font-semibold text-ink">Architecture systems</span>
              </div>
            </div>
            <span class="
              text-sm font-semibold text-ink
              motion-reduce:hidden
              sm:hidden
            "
            >Architecture systems
            </span>
            <span class="
              hidden text-sm font-semibold text-ink
              motion-reduce:inline
            "
            >
              Architecture systems
            </span>
          </div>

          <div class="section-actions">
            <ButtonLink href="/portfolio/" showArrow>
              See selected work
            </ButtonLink>
            <ButtonLink href="/blog/" showArrow variant="secondary">
              Read the writing
            </ButtonLink>
            <ButtonLink href={siteConfig.contact.resume} newTab showArrow variant="ghost">
              Open resume
            </ButtonLink>
          </div>

          <div class="flex flex-wrap gap-3 text-sm text-ink-muted">
            <span class="
              inline-flex items-center rounded-full border border-line/60
              bg-surface/72 px-3 py-2
            "
            >{siteConfig.location}
            </span>
            <span class="
              inline-flex items-center rounded-full border border-line/60
              bg-surface/72 px-3 py-2
            "
            >{yearsOfExperience} years building teams and systems
            </span>
            <span class="
              inline-flex items-center rounded-full border border-line/60
              bg-surface/72 px-3 py-2
            "
            >ReactJS Colombia
            </span>
          </div>
        </div>
      </div>

      <div
        class="
          relative isolate mx-auto w-full max-w-88 animate-spring-up
          motion-reduce:animate-none
        "
        style="animation-delay: 140ms"
      >
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[12%] z-10 rounded-4xl
            bg-linear-to-br from-brand/10 via-transparent to-accent/10 blur-2xl
          "
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[-10%] z-20 rounded-full border
            border-brand/12
            motion-safe:animate-[spin_24s_linear_infinite]
            motion-reduce:animate-none
          "
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[10%] z-20 rounded-full border
            border-brand/10
            motion-safe:animate-[spin_18s_linear_infinite_reverse]
            motion-reduce:animate-none
          "
        />

        <div class="
          panel-card relative z-0 overflow-hidden rounded-[2.25rem] p-3
          sm:p-4
        "
        >
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-0 z-10 grid-fade opacity-30
            "
          />
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-0 z-20 bg-linear-to-br
              from-transparent via-transparent to-brand/12
            "
          />
          <Picture
            alt="Portrait of Santiago Molina"
            class="
              relative z-0 aspect-4/5 w-full rounded-[1.7rem] object-cover
              object-[center_18%]
            "
            fetchpriority="high"
            formats={['avif', 'webp']}
            loading="eager"
            sizes="(min-width: 1024px) 352px, 75vw"
            src={AboutMeImage}
            widths={[400, 600, 800]}
          />
        </div>

        <div class="
          absolute bottom-8 -left-4 z-30 hidden mini-note min-w-40
          motion-safe:animate-float-y
          motion-reduce:animate-none
          sm:-left-8 sm:block
        "
        >
          <p class="section-label">Base</p>
          <p class="mt-2 text-sm/6 text-ink">Medellin · Remote worldwide</p>
        </div>

        <div
          class="
            absolute top-8 -right-4 z-30 hidden mini-note min-w-32
            motion-safe:animate-float-y
            motion-reduce:animate-none
            sm:-right-8 sm:block
          "
          style="animation-delay: 900ms"
        >
          <p class="section-label">Experience</p>
          <p class="mt-2 text-lg font-semibold text-ink">{yearsOfExperience}</p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="
      grid gap-6 border-t border-line/70 pt-10
      md:grid-cols-2
      xl:grid-cols-4
    "
    data-animate
  >
    <StatCard description="Years shipping web and mobile products across full-stack, leadership, and automation roles." label="Experience" value={yearsOfExperience} />
    <StatCard description="Largest cross-functional team I have led across product, design, frontend, and backend." label="Team led" value="14" />
    <StatCard description="Reduced release lead times by optimizing CI/CD pipelines and automating quality gates." label="Cycle Time" value="-75%" />
    <StatCard description="Typical attendance for ReactJS Colombia meetups, workshops, and talks." label="Community" value="100+" />
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="React and TypeScript sit at the center, but the work extends across the full stack: backend services, automation pipelines, testing infrastructure, and delivery tooling."
      eyebrow="Stack"
      title="A full-stack toolkit built around automation and DX."
    />
    <div class="space-y-5">
      <p class="max-w-3xl text-sm/6 text-ink-muted">
        A curated snapshot of the stack, ordered from the tools that shape products most directly to the supporting
        systems around them.
      </p>
      <div class="flex flex-wrap gap-3">
        {topTechnologies.map(([technology]) => (
          <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
        ))}
        {hiddenTechnologyCount > 0 && (
          <Pill href="/technologies/" label={`+${hiddenTechnologyCount} technologies`} tone="neutral" />
        )}
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="From headless commerce and esports to real estate and open source, these projects show how I approach architecture, automation, and delivery under real constraints."
      eyebrow="Selected work"
      linkHref="/portfolio/"
      linkLabel="View all projects"
      title="Work shaped by real teams, real constraints, and measurable outcomes."
    />
    <div class="space-y-6">
      {featuredProject && <ProjectCard featured project={featuredProject} />}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {supportingProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="The throughline in my work is making engineering calmer: clearer priorities, fewer avoidable decisions under pressure, and better systems for the people shipping them."
      eyebrow="Approach"
      title="The work is technical, but the goal is always team clarity."
    />
    <div class="
      grid items-start gap-6
      lg:grid-cols-3
    "
    >
      <div class="
        panel-card p-6
        sm:p-7
        lg:col-span-2
      "
      >
        <p class="section-label">What I do now</p>
        <h2 class="mt-4 text-3xl">Engineering that ships and systems that last.</h2>
        <p class="mt-4 max-w-2xl text-base/7 text-ink-soft">
          My work spans full-stack delivery, developer tooling, and automation: finding the slowest parts of a
          team's workflow and replacing them with repeatable systems that make shipping feel calmer and more
          predictable.
        </p>
      </div>
      <div class="grid gap-6">
        <div class="mini-note">
          <p class="section-label">How I lead</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            I stay close to the code, set useful standards, and help teams make better technical decisions earlier.
          </p>
        </div>
        <div class="mini-note">
          <p class="section-label">Outside the sprint</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            I co-organize ReactJS Colombia, write about DX and workflows, and keep building while working
            remotely from Medellin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="Projects only show one part of the picture. The other part is how I share what I learn, contribute to engineering communities, and keep my own workflow sharp."
      eyebrow="Beyond delivery"
      title="Speaking, community work, and the setup behind the work."
    />
    <div class="space-y-6">
      <article class="
        panel-card space-y-6 p-6
        sm:p-7
      "
      >
        <div class="space-y-3">
          <p class="section-label">Speaking and community</p>
          <h2 class="text-3xl">Practical sessions for engineers, teams, and local communities.</h2>
          <p class="max-w-2xl text-base/7 text-ink-soft">
            I am most useful in rooms where the goal is practical clarity: developer experience, technical leadership,
            architecture, testing, automation, and the delivery systems that make teams feel more confident.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {featuredSpeakingTopics.map(topic => (
            <Pill label={topic.title} tone="outline" />
          ))}
        </div>
        <ButtonLink href="/speaking/" showArrow variant="secondary">
          Explore speaking
        </ButtonLink>
      </article>

      <article class="
        panel-card space-y-6 p-6
        sm:p-7
      "
      >
        <div class="space-y-3">
          <p class="section-label">Uses and workflow</p>
          <h2 class="text-3xl">A practical setup built around clarity and fast feedback.</h2>
          <p class="max-w-2xl text-base/7 text-ink-soft">
            The exact tools shift over time, but the priorities stay the same: boring reliability, fewer context
            switches, and a workflow that supports both deep implementation work and hands-on leadership.
          </p>
        </div>
        <div
          class="
            grid gap-4
            sm:grid-cols-3
          "
        >
          {usesHighlights.map(highlight => (
            <div class="mini-note">
              <p class="section-label">{highlight.label}</p>
              <p class="mt-3 text-sm/7 text-ink-soft">{highlight.value}</p>
            </div>
          ))}
        </div>
        <ButtonLink href="/uses/" showArrow variant="secondary">
          See the uses page
        </ButtonLink>
      </article>
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="I write about software architecture, full-stack systems, automation, and the engineering decisions that help teams ship with confidence. Published in Towards Dev and on Medium."
      eyebrow="Writing"
      linkHref="/blog/"
      linkLabel="See all articles"
      title="Practical writing for engineers who build and lead."
    />
    <div class="space-y-6">
      {featuredPost && <PostCard featured post={featuredPost} />}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {supportingPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>
</PageLayout>
