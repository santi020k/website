---
import { Image } from 'astro:assets'

import ProjectPreview from '@/components/projects/ProjectPreview.astro'

import { collectionDateSortProjects } from '@/utils/date'

import AboutMeImage from '@/assets/photos/about-me.webp'
import { getAllProjects, getTechnologiesByUsage } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'

const allProjects = await getAllProjects()

const featuredProjects = allProjects
  .filter(p => p.data.typesId === 'professional')
  .sort(collectionDateSortProjects)
  .slice(0, 3)

const topTechnologies = getTechnologiesByUsage(allProjects).slice(0, 12)
---

<PageLayout meta={{ title: 'Santiago Molina — Full Stack Developer & Tech Lead', description: 'Seasoned Full Stack Developer and Tech Lead with 10+ years of experience in React, React Native, Node.js, and TypeScript. I specialize in front-end architecture and crafting exceptional UI/UX experiences.' }}>

  <!-- ─── Hero ────────────────────────────────────────────────────── -->
  <section aria-label="Introduction" class="relative">
    <div class="
      grid grid-cols-1 items-center gap-10
      sm:grid-cols-2 sm:gap-8
    "
    >
      <!-- Left: text stack -->
      <div
        class="
          flex flex-col gap-5
          md:gap-6
        "
      >
        <!-- Status badge -->
        <span
          data-hero="1"
          class="
            inline-flex w-fit items-center gap-2 rounded-full border
            border-color-200 px-3 py-1 text-sm font-medium text-zinc-500
            dark:border-color-250 dark:text-zinc-400
          "
        >
          <span
            aria-hidden="true"
            class="
              size-2 animate-pulse rounded-full bg-green-500
              motion-reduce:animate-none
            "
          >
          </span>
          Available for opportunities
        </span>

        <!-- Name -->
        <h1
          data-hero="2"
          class="
            text-3xl/tight font-bold text-zinc-900
            sm:text-4xl
            lg:text-5xl
            dark:text-zinc-100
          "
        >
          Santiago Molina
        </h1>

        <!-- Role -->
        <p
          data-hero="3"
          class="
            text-lg font-semibold text-accent-two
            sm:text-xl
          "
        >
          Full Stack Developer &amp; Tech Lead
        </p>

        <!-- Bio -->
        <p
          data-hero="4"
          class="
            max-w-lg text-base/relaxed text-zinc-600
            dark:text-zinc-300
          "
        >
          10+ years building scalable web and mobile products. I specialise in
          front-end architecture, React ecosystems, and leading teams that ship
          fast without cutting corners.
        </p>

        <!-- CTAs -->
        <div data-hero="5" class="flex flex-wrap gap-3">
          <a
            href="/portfolio/"
            class="
              inline-flex cursor-pointer items-center gap-2 rounded-xl
              bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white
              transition-all duration-200
              hover:bg-zinc-700
              focus-visible:outline-2 focus-visible:outline-offset-2
              focus-visible:outline-zinc-900
              dark:bg-zinc-100 dark:text-zinc-900
              dark:hover:bg-zinc-300
              dark:focus-visible:outline-zinc-100
            "
          >
            <!-- Briefcase icon -->
            <svg
              aria-hidden="true"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            View Portfolio
          </a>

          <a
            href="https://linkedin.com/in/santi020k"
            rel="noreferrer"
            target="_blank"
            title="Connect on LinkedIn"
            class="
              inline-flex cursor-pointer items-center gap-2 rounded-xl border
              border-color-300 px-5 py-2.5 text-sm font-semibold text-zinc-900
              transition-all duration-200
              hover:border-color-500 hover:bg-color-75
              focus-visible:outline-2 focus-visible:outline-offset-2
              focus-visible:outline-zinc-900
              dark:border-color-300 dark:text-zinc-100
              dark:hover:border-color-500 dark:hover:bg-color-75
              dark:focus-visible:outline-zinc-100
            "
          >
            <!-- LinkedIn icon -->
            <svg
              aria-hidden="true"
              class="size-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <!-- Right: photo -->
      <div
        data-hero="photo"
        class="
          flex justify-center
          sm:justify-end
        "
      >
        <Image
          alt="Santiago Molina — Full Stack Developer"
          class="
            w-full max-w-xs rounded-2xl shadow-xl
            sm:max-w-sm
            xl:max-w-md
            dark:shadow-zinc-900
          "
          priority
          src={AboutMeImage}
        />
      </div>
    </div>
  </section>

  <!-- ─── Core Stack ─────────────────────────────────────────────── -->
  <section aria-label="Core technologies" class="mt-20">
    <h2 class="
      mb-6 text-base font-semibold tracking-widest text-zinc-400 uppercase
      dark:text-zinc-500
    "
    >
      Core Stack
    </h2>
    <div class="flex flex-wrap gap-2" role="list">
      {topTechnologies.map(tech => (
        <span
          class="
            cursor-default rounded-full border border-color-200 bg-color-75 px-3
            py-1 text-sm font-medium text-zinc-700 transition-colors
            duration-150
            hover:border-color-400 hover:bg-color-150
            dark:border-color-200 dark:bg-color-75 dark:text-zinc-300
            dark:hover:border-color-400 dark:hover:bg-color-150
          "
          role="listitem"
        >
          {tech}
        </span>
      ))}
    </div>
  </section>

  <!-- ─── Featured Work ──────────────────────────────────────────── -->
  <section aria-label="Featured work" class="mt-20">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="
        font-bold text-zinc-900
        dark:text-zinc-100
      ">
        Featured Work
      </h2>
      <a
        href="/portfolio/"
        class="
          inline-flex cursor-pointer items-center gap-1 text-sm font-medium
          text-link underline-offset-2 transition-all duration-150
          hover:underline
        "
      >
        View all
        <svg
          aria-hidden="true"
          class="size-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="
      grid grid-cols-1 gap-4
      sm:grid-cols-2
      lg:grid-cols-3
    "
    >
      {featuredProjects.map(project => (
        <ProjectPreview project={project} />
      ))}
    </div>
  </section>

  <!-- ─── CTA strip ──────────────────────────────────────────────── -->
  <section
    aria-label="Contact call to action"
    class="
      mt-20 rounded-2xl border border-color-200 bg-color-75 px-8 py-10
      text-center
      dark:border-color-200 dark:bg-color-75
    "
  >
    <p class="
      text-lg font-semibold text-zinc-900
      dark:text-zinc-100
    "
    >
      Let's build something great together.
    </p>
    <p class="
      mt-2 text-sm text-zinc-500
      dark:text-zinc-400
    "
    >
      Open to senior / lead roles, consulting, and interesting side projects.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="mailto:santi020k@gmail.com"
        class="
          inline-flex cursor-pointer items-center gap-2 rounded-xl bg-zinc-900
          px-5 py-2.5 text-sm font-semibold text-white transition-all
          duration-200
          hover:bg-zinc-700
          focus-visible:outline-2 focus-visible:outline-offset-2
          focus-visible:outline-zinc-900
          dark:bg-zinc-100 dark:text-zinc-900
          dark:hover:bg-zinc-300
          dark:focus-visible:outline-zinc-100
        "
      >
        <!-- Mail icon -->
        <svg
          aria-hidden="true"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect height="16" rx="2" width="20" x="2" y="4"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Send me an email
      </a>
      <a
        href="/pdf/cv.pdf"
        rel="noreferrer"
        target="_blank"
        class="
          inline-flex cursor-pointer items-center gap-2 rounded-xl border
          border-color-300 px-5 py-2.5 text-sm font-semibold text-zinc-900
          transition-all duration-200
          hover:border-color-500 hover:bg-color-75
          focus-visible:outline-2 focus-visible:outline-offset-2
          focus-visible:outline-zinc-900
          dark:border-color-300 dark:text-zinc-100
          dark:hover:border-color-500 dark:hover:bg-color-150
          dark:focus-visible:outline-zinc-100
        "
      >
        Download CV
      </a>
    </div>
  </section>

</PageLayout>

<style>
  /* Entrance animations — respect prefers-reduced-motion */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  [data-hero="1"] { animation: fade-up 0.55s ease both 0.05s; }
  [data-hero="2"] { animation: fade-up 0.55s ease both 0.15s; }
  [data-hero="3"] { animation: fade-up 0.55s ease both 0.25s; }
  [data-hero="4"] { animation: fade-up 0.55s ease both 0.35s; }
  [data-hero="5"] { animation: fade-up 0.55s ease both 0.45s; }
  [data-hero="photo"] { animation: fade-in 0.7s ease both 0.25s; }

  @media (prefers-reduced-motion: reduce) {
    [data-hero] { animation: none; }
  }
</style>
