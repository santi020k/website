---
import TravelMap from '@/components/pages/travel/TravelMap.astro'
import PageLayout from '@/layouts/Base.astro'

import { ButtonLink, Collapsible, Icon } from '@santi020k/lumen-astro'

import { getTravelVisitLabel, travelCountries, travelPageDescription } from '@/data/travel'
import { createAuthorSchema } from '@/site.config'

const meta = {
  breadcrumbs: [{ name: 'Home', url: '/' }, { name: 'Travel', url: '/travel/' }],
  description: travelPageDescription,
  title: 'Travel & Life Abroad',
  structuredData: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Travel & Life Abroad',
    description: travelPageDescription,
    url: new URL('/travel/', Astro.site).href,
    author: createAuthorSchema(Astro.site)
  }
}
---

<PageLayout backdrop="plain" meta={meta}>
  <TravelMap />

  <section data-travel-section aria-labelledby="travel-story-heading">
    <div data-travel-section-heading>
      <p class="maker-hero-eyebrow"><span class="maker-hero-signal" aria-hidden="true"></span>Roots &amp; returns</p>
      <h2 id="travel-story-heading">Colombia, Paraguay,<br />and the places between.</h2>
    </div>
    <div data-travel-story>
      <p>Colombia is where I’m from. Paraguay is part of my story as both a destination and my country of residence: I have been there seven times, with visits to Asunción, Encarnación, and Ciudad del Este.</p>
      <p>Some countries appear once on this map; others are places I have returned to. I have visited Mexico seven times, and the United States, Brazil, and Argentina twice each.</p>
      <p>I’m starting this journal with the places. Over time, I’ll add the stories behind them: everyday life while traveling, working from different places, and the memories I want to keep.</p>
    </div>
  </section>

  <section data-travel-section id="travel-countries" aria-labelledby="country-list-heading">
    <div data-travel-section-heading>
      <p class="maker-hero-eyebrow"><span class="maker-hero-signal" aria-hidden="true"></span>The notebook</p>
      <h2 id="country-list-heading">Places I’ve kept<br />along the way.</h2>
      <p>The countries, cities, and regions I have visited, with room for more memories as I write.</p>
    </div>
    <Collapsible id="travel-notebook">
      <summary>All {travelCountries.length} countries &amp; the places within them</summary>
      <div data-travel-country-list>
        {travelCountries.map(country => (
          <article id={`country-${country.code.toLowerCase()}`} aria-labelledby={`country-name-${country.code.toLowerCase()}`}>
            <span data-travel-notebook-code aria-hidden="true">{country.code}</span>
            <div data-travel-country-content>
              <header data-travel-country-heading>
                <h3 id={`country-name-${country.code.toLowerCase()}`}>{country.name}</h3>
                <span data-travel-visit-label>{getTravelVisitLabel(country)}</span>
              </header>
              {country.places.length > 0 ?
(
                <ul data-travel-place-list role="list">
                  {country.places.map(place => <li>{place}</li>)}
                </ul>
              ) :
<p data-travel-home-copy>I’m from Colombia. This is where my story begins.</p>}
              {country.note && <p data-travel-country-note>{country.note}</p>}
            </div>
          </article>
        ))}
      </div>
    </Collapsible>
  </section>

  <section class="maker-hero" data-travel-section aria-labelledby="travel-stories-heading">
    <div data-travel-section-heading>
      <p class="maker-hero-eyebrow"><span class="maker-hero-signal" aria-hidden="true"></span>Stories to come</p>
      <h2 id="travel-stories-heading">More than places<br />on a map.</h2>
    </div>
    <div data-travel-story>
      <p>I’m collecting the stories behind these journeys. Travel posts will join my blog as I finish writing them.</p>
      <div class="maker-hero-actions">
        <ButtonLink class="maker-hero-primary" href="/blog/" variant="unstyled">
          Read the blog
          <span class="maker-hero-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </ButtonLink>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  [data-travel-section] {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 4rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-top: 3rem;
    border-top: 1px solid hsl(var(--line) / 0.65);
  }

  [data-travel-section-heading] .maker-hero-eyebrow { margin-bottom: 1.5rem; }
  [data-travel-section-heading] h2 {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  [data-travel-section-heading] > p:last-child:not(.maker-hero-eyebrow) {
    max-width: 22rem;
    margin-top: 1.25rem;
  }
  [data-travel-story], [data-travel-section-heading] > p:last-child:not(.maker-hero-eyebrow) {
    color: hsl(var(--ink-soft));
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: -0.012em;
  }
  [data-travel-story] > p + p { margin-top: 1.25rem; }

  /* Keep the native Lumen disclosure; the notebook shares the hero's ruled canvas. */
  :global(#travel-notebook.ui-collapsible) { --ui-disclosure-inset: 0rem; overflow: visible; border: 0; border-radius: 0; background: transparent; }
  :global(#travel-notebook > summary) {
    min-height: 3.5rem;
    padding: 0.75rem 2.5rem 0.75rem 0;
    border-bottom: 1px solid hsl(var(--line) / 0.65);
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.7;
  }
  :global(#travel-notebook > summary:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 4px; }
  [data-travel-country-list] { min-width: 0; padding: 0; container: travel-notebook / inline-size; }
  [data-travel-country-list] article { display: grid; grid-template-columns: 3.75rem minmax(0, 1fr); gap: 1.5rem; padding-block: 1.625rem; border-top: 1px solid hsl(var(--line)); }
  [data-travel-country-list] article:first-child { border-top: 0; }
  [data-travel-country-list] article:last-child { border-bottom: 1px solid hsl(var(--line)); }
  [data-travel-notebook-code] { min-width: 0; padding-top: .1875rem; color: hsl(var(--brand)); font-size: 1.875rem; font-weight: 500; line-height: 1.15; letter-spacing: -.06em; }
  [data-travel-country-content] { min-width: 0; }
  [data-travel-country-heading] { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1rem; margin-bottom: 1rem; }
  [data-travel-country-heading] h3 { min-width: 0; font-size: 1.625rem; font-weight: 500; line-height: 1.25; letter-spacing: -.045em; }
  [data-travel-visit-label] { max-width: 13em; color: hsl(var(--ink-soft)); font-size: .6875rem; line-height: 1.65; }
  [data-travel-place-list] { display: flex; flex-wrap: wrap; gap: .25rem 1.125rem; padding: 0; list-style: none; color: hsl(var(--ink-soft)); font-size: .8125rem; line-height: 1.8; }
  [data-travel-place-list] li { display: flex; align-items: baseline; gap: .4375rem; min-width: 0; }
  [data-travel-place-list] li::before { content: ''; width: .1875rem; height: .1875rem; flex-shrink: 0; align-self: center; border-radius: 50%; background: hsl(var(--brand)); }
  [data-travel-home-copy], [data-travel-country-note] { color: hsl(var(--ink-soft)); font-size: .75rem; line-height: 1.85; }
  [data-travel-country-note] { margin-top: .75rem; }
  :global([data-theme='dark']) [data-travel-notebook-code] { color: hsl(var(--accent)); }
  :global([data-theme='dark']) [data-travel-place-list] li::before { background: hsl(var(--accent)); }

  @container travel-notebook (width < 28rem) {
    [data-travel-country-list] article { grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; }
    [data-travel-notebook-code] { font-size: 1.5rem; }
    [data-travel-country-heading] { display: block; }
    [data-travel-country-heading] h3 { font-size: 1.4375rem; }
    [data-travel-visit-label] { display: block; max-width: none; margin-top: .5rem; }
  }

  @container travel-notebook (width < 14rem) {
    [data-travel-country-list] article { grid-template-columns: minmax(0, 1fr); gap: .75rem; padding-block: 1.5rem; }
    [data-travel-notebook-code] { font-size: 1.0625rem; }
  }

  @media (max-width: 47.999rem) {
    [data-travel-section] { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; padding-top: 2rem; }
    [data-travel-section-heading] .maker-hero-eyebrow { margin-bottom: 1rem; }
  }
</style>
