---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import SculptedTag from '@/components/atoms/SculptedTag.astro'
import CareerTimeline from '@/components/organisms/CareerTimeline.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { ButtonLink, Card, Link, Stat } from '@santi020k/lumen-astro'

import { createProjectCollectionSchema, getUniqueTechnologiesWithCount } from '@/data/project'
import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)
const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const workProjects = allProjects.filter(p => p.data.typesId === 'professional')
const allTechnologies = getUniqueTechnologiesWithCount(workProjects)
const technologies = sortTechnologyCountsByInterest(allTechnologies).slice(0, 18)

const toolkitLanes = [
  { id: 'web', title: t('page.webFoundations'), names: ['React.js', 'Next.js', 'TypeScript'] },
  { id: 'mobile', title: t('page.mobile'), names: ['React Native', 'Expo'] },
  { id: 'data', title: t('page.dataAndState'), names: ['Node.js', 'GraphQL', 'Apollo Client', 'TanStack Query', 'OpenAPI', 'Zustand', 'Redux Toolkit', 'Redux Sagas', 'Redux'] },
  { id: 'ui', title: t('page.uiSystems'), names: ['Storybook', 'Tailwind CSS', 'Radix UI', 'Mantine UI'] }
]

const groupedTechnologyNames = new Set(toolkitLanes.flatMap(lane => lane.names))

const toolkitGroups = [
  ...toolkitLanes.map(lane => ({
    id: lane.id,
    title: lane.title,
    items: technologies.filter(([name]) => lane.names.includes(name))
  })),
  { id: 'other', title: t('page.otherTools'), items: technologies.filter(([name]) => !groupedTechnologyNames.has(name)) }
].filter(group => group.items.length > 0)

const careerStats = [
  {
    label: t('page.professionalRoles'),
    value: String(workProjects.length),
    description: t('page.acrossCommerceGamingAgenciesAndSaas'),
    source: { href: '#experience-heading', label: t('page.exploreTheTimeline') }
  },
  {
    label: t('page.largestTeamLed'),
    value: '14',
    description: t('page.productDesignFrontendAndBackend'),
    source: { href: localizePath('/portfolio/void/#what-i-led', pageLocale), label: t('page.voidGgWhatILed') }
  },
  {
    label: t('page.productionTechnologies'),
    value: String(allTechnologies.length),
    description: t('page.toolsChosenToFitTheProduct'),
    source: { href: '#tools-heading', label: t('page.exploreTheToolkit') }
  },
  {
    label: t('page.fasterDeployments'),
    value: '60%',
    description: t('page.throughCiCdAndImprovedRelease'),
    source: { href: localizePath('/portfolio/void/#key-outcomes', pageLocale), label: t('page.voidGgKeyOutcomes') }
  }
]

const careerDestinations = [
  { id: 'resume', category: t('shared.experience'), title: t('page.openResume'), description: t('page.rolesProjectsAndSkillsInOne'), href: siteConfig.contact.resume },
  { id: 'technologies', category: t('page.technologyIndex'), title: t('page.exploreTheFullToolkit'), description: t('page.browseTheToolsUsedAcrossAll'), href: localizePath('/technologies/', pageLocale) }
]

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('nav.work'), url: localizePath('/work/', pageLocale) }
]

const workListSchema = createProjectCollectionSchema(t('page.workExperienceSantiagoMolina'), localizePath('/work/', pageLocale), workProjects, Astro.site)
---

<PageLayout
backdrop="plain"
  headerVariant="signature"
  meta={{
    breadcrumbs,
    description: t('page.exploreSantiagoMolinaSEngineeringWork'),
    seoTitle: t('page.santiagoMolinaEngineeringLeadershipWork'),
    structuredData: workListSchema,
    title: t('page.workExperienceSantiagoMolina')
  }}
>
  <div class="work-page" data-work-page>
    <div class="signature-frame work-intro">
      <section aria-labelledby="work-heading" class="work-hero-grid">
        <div>
          <p class="maker-hero-eyebrow"><span
  aria-hidden="true"
  class="maker-hero-signal"
                                        ></span><span data-work-eyebrow-copy>{t('page.workExperienceUsAndLatam')}</span></p>
          <h1 id="work-heading" class="work-heading">{t('page.productsShipped')}<br /><span class="
            maker-hero-emphasis
          "
                                                                                      >{t('page.teamsLed')}</span></h1>

        </div>
        <div class="work-hero-summary">
          <p class="text-lg/7 font-medium tracking-tight text-ink">{t('page.goodSoftwareTakesMoreThanCode')}</p>
          <p class="mt-4 text-sm/7 text-ink-soft">{t('page.iHelpTeamsTurnComplexProblems')}</p>

        </div>
          <div class="maker-hero-actions" data-work-hero-actions>
            <ButtonLink class="maker-hero-primary" href="#experience-heading" variant="unstyled">
              {t('page.exploreExperience')} <span
aria-hidden="true"
class="maker-hero-arrow"
                                            ><ArrowExchange direction="down" /></span>
            </ButtonLink>
            <div class="work-hero-secondary-links">
              <ButtonLink class="maker-hero-secondary" href={localizePath(siteConfig.contact.resume, pageLocale)} variant="unstyled">{t('page.openResume')} <ArrowExchange direction="right" /></ButtonLink>
              <ButtonLink class="maker-hero-secondary" data-work-hero-external href={localizePath(siteConfig.contact.linkedin, pageLocale)} newTab variant="unstyled">LinkedIn <ArrowExchange /></ButtonLink>
            </div>
          </div>
      </section>

      <section
id="career-at-a-glance"
aria-label={t('page.careerAtAGlance')}
class="work-stats"
      >
        {careerStats.map(({ description, label, source, value }, index) => (
          <Stat as="article" variant="bare" aria-labelledby={`work-stat-${index}`}>
            <p class="work-stat-value">{value}</p>
            <div data-work-stat-copy>
              <h2 id={`work-stat-${index}`}>{label}</h2>
              <p>{description}</p>
              {source && (
                <ButtonLink data-work-stat-source href={localizePath(source.href, pageLocale)} variant="unstyled">
                  <span>{source.label}</span><ArrowExchange direction={source.href.startsWith('#') ? 'down' : 'right'} />
                </ButtonLink>
              )}
            </div>
          </Stat>
        ))}
      </section>

    </div>

    <section
aria-labelledby="experience-heading"
class="
  pt-16
  sm:pt-20
"
    >
      <div class="work-section-heading">
        <div><p class="maker-hero-eyebrow mb-4">{t('work.chapterExperience')}</p><h2
id="experience-heading"
class="
  text-3xl/tight font-semibold tracking-tighter text-ink
  sm:text-4xl
"
                                                                                 >{t('page.theWorkOverTime')}</h2></div>
        <p class="max-w-sm text-sm/7 text-ink-soft">{t('page.clientAndProductWorkWhereArchitecture')}</p>
      </div>
      <CareerTimeline projects={workProjects} />
    </section>

    <section
aria-labelledby="tools-heading"
class="
  border-t border-line/65 pt-12
  sm:pt-16
"
    >
      <div class="work-section-heading">
        <div><p class="maker-hero-eyebrow mb-4">{t('work.chapterToolkit')}</p><h2
id="tools-heading"
class="
  text-3xl/tight font-semibold tracking-tighter text-ink
  sm:text-4xl
"
                                                                              >{t('page.theToolsBehindTheWork')}</h2></div>
        <p class="max-w-sm text-sm/7 text-ink-soft">{t('page.reactAndTypescriptAtTheCenter')}</p>
      </div>
      <div data-work-stack>
        {toolkitGroups.map((group, index) => (
          <section class="work-toolkit-lane" aria-labelledby={`work-toolkit-${group.id}`}>
            <div class="work-toolkit-heading">
              <span class="work-toolkit-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3 id={`work-toolkit-${group.id}`}>{group.title}</h3>
            </div>
            <ul
aria-label={`${group.title} technologies`}
class="@container/sculpted-tags flex flex-wrap gap-2.5"
            >
              {group.items.map(([name, count]) => <li class="max-w-full min-w-0"><SculptedTag count={count} href={localizePath(getTechnologyPath(name), pageLocale)} label={name} /></li>)}
            </ul>
          </section>
        ))}
      </div>
      <p class="mt-7 text-xs/6 text-ink-soft">{t('page.numbersIndicateTheProfessionalProjectsUsing')}</p>
      <nav id="work-next-steps" class="work-close" aria-label={t('page.continueExploringWork')} data-work-close>
        {careerDestinations.map(destination => (
          <Link class="work-close-link" href={localizePath(destination.href, pageLocale)} variant="inherit">
            <Card as="div" variant="unstyled" data-work-close-card={destination.id}>
              <p data-work-close-category>{destination.category}</p>
              <h3 id={`work-close-${destination.id}`}>{destination.title}</h3>
              <p data-work-close-description>{destination.description}</p>
              <span data-work-close-arrow><ArrowExchange direction="right" /></span>
            </Card>
          </Link>
        ))}
      </nav>
    </section>
  </div>
</PageLayout>
