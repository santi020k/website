---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import SculptedTag from '@/components/atoms/SculptedTag.astro'
import CareerTimeline from '@/components/organisms/CareerTimeline.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { ButtonLink, Card, Icon, Link, Stat } from '@santi020k/lumen-astro'

import { createProjectCollectionSchema, getUniqueTechnologiesWithCount } from '@/data/project'
import { siteConfig } from '@/site.config'

const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const workProjects = allProjects.filter(p => p.data.typesId === 'professional')
const allTechnologies = getUniqueTechnologiesWithCount(workProjects)
const technologies = sortTechnologyCountsByInterest(allTechnologies).slice(0, 18)

const toolkitLanes = [
  { id: 'web', title: 'Web foundations', names: ['React.js', 'Next.js', 'TypeScript'] },
  { id: 'mobile', title: 'Mobile', names: ['React Native', 'Expo'] },
  { id: 'data', title: 'Data & state', names: ['Node.js', 'GraphQL', 'Apollo Client', 'TanStack Query', 'OpenAPI', 'Zustand', 'Redux Toolkit', 'Redux Sagas', 'Redux'] },
  { id: 'ui', title: 'UI systems', names: ['Storybook', 'Tailwind CSS', 'Radix UI', 'Mantine UI'] }
]

const groupedTechnologyNames = new Set(toolkitLanes.flatMap(lane => lane.names))

const toolkitGroups = [
  ...toolkitLanes.map(lane => ({
    id: lane.id,
    title: lane.title,
    items: technologies.filter(([name]) => lane.names.includes(name))
  })),
  { id: 'other', title: 'Other tools', items: technologies.filter(([name]) => !groupedTechnologyNames.has(name)) }
].filter(group => group.items.length > 0)

const careerStats = [
  {
    label: 'Professional roles',
    value: String(workProjects.length),
    description: 'Across commerce, gaming, agencies, and SaaS.',
    source: { href: '#experience-heading', label: 'Explore the timeline' }
  },
  {
    label: 'Largest team led',
    value: '14',
    description: 'Product, design, frontend, and backend.',
    source: { href: '/portfolio/void/#what-i-led', label: 'Void.GG · What I led' }
  },
  {
    label: 'Production technologies',
    value: String(allTechnologies.length),
    description: 'Tools chosen to fit the product.',
    source: { href: '#tools-heading', label: 'Explore the toolkit' }
  },
  {
    label: 'Faster deployments',
    value: '60%',
    description: 'Through CI/CD and improved release workflows.',
    source: { href: '/portfolio/void/#key-outcomes', label: 'Void.GG · Key outcomes' }
  }
]

const careerDestinations = [
  { id: 'resume', category: 'Experience', title: 'Open resume', description: 'Roles, projects, and skills in one readable view.', href: siteConfig.contact.resume },
  { id: 'technologies', category: 'Technology index', title: 'Explore the full toolkit', description: 'Browse the tools used across all projects.', href: '/technologies/' }
]

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Work', url: '/work/' }
]

const workListSchema = createProjectCollectionSchema('Work Experience — Santiago Molina', '/work/', workProjects, Astro.site)
---

<PageLayout
backdrop="plain"
  headerVariant="signature"
  meta={{
    breadcrumbs,
    description: 'Explore Santiago Molina’s engineering work across commerce, SaaS, gaming, and platforms, including architecture, delivery systems, and technical leadership.',
    seoTitle: 'Santiago Molina — Engineering Leadership Work',
    structuredData: workListSchema,
    title: 'Work Experience — Santiago Molina'
  }}
>
  <div class="work-page" data-work-page>
    <div class="signature-frame work-intro">
      <section aria-labelledby="work-heading" class="work-hero-grid">
        <div>
          <p class="maker-hero-eyebrow"><span
  aria-hidden="true"
  class="maker-hero-signal"
                                        ></span>Work experience / US &amp; LATAM</p>
          <h1 id="work-heading" class="work-heading">Products shipped.<br /><span class="
            maker-hero-emphasis
          "
                                                                            >Teams led.</span></h1>
        </div>
        <div>
          <p class="text-lg/7 font-medium tracking-tight text-ink">Good software takes more than code.</p>
          <p class="mt-4 text-sm/7 text-ink-soft">I help teams turn complex problems into products that hold up. Architecture decisions, delivery systems, and hands-on technical leadership, from startup pressure to scale-up complexity.</p>
          <div class="maker-hero-actions" data-work-hero-actions>
            <ButtonLink class="maker-hero-primary" href="#experience-heading" variant="unstyled">
              Explore experience <span
aria-hidden="true"
class="maker-hero-arrow"
                                 ><ArrowExchange direction="down" /></span>
            </ButtonLink>
            <div class="work-hero-secondary-links">
              <ButtonLink class="maker-hero-secondary" href={siteConfig.contact.resume} variant="unstyled">Open resume <ArrowExchange direction="right" /></ButtonLink>
              <ButtonLink class="maker-hero-secondary" data-work-hero-external href={siteConfig.contact.linkedin} newTab variant="unstyled">LinkedIn <ArrowExchange /></ButtonLink>
            </div>
          </div>
        </div>
      </section>

      <section
id="career-at-a-glance"
aria-label="Career at a glance"
class="work-stats"
      >
        {careerStats.map(({ description, label, source, value }, index) => (
          <Stat as="article" variant="bare" aria-labelledby={`work-stat-${index}`}>
            <p class="work-stat-value">{value}</p>
            <div data-work-stat-copy>
              <h2 id={`work-stat-${index}`}>{label}</h2>
              <p>{description}</p>
              {source && (
                <ButtonLink data-work-stat-source href={source.href} variant="unstyled">
                  <span>{source.label}</span><Icon name={source.href.startsWith('#') ? 'arrow-down' : 'arrow-right'} />
                </ButtonLink>
              )}
            </div>
          </Stat>
        ))}
      </section>

    </div>

    <section
aria-labelledby="experience-heading"
class="
  pt-16
  sm:pt-20
"
    >
      <div class="work-section-heading">
        <div><p class="maker-hero-eyebrow mb-4">01 / Experience</p><h2
id="experience-heading"
class="
  text-3xl/tight font-semibold tracking-tighter text-ink
  sm:text-4xl
"
                                                                   >The work, over time.</h2></div>
        <p class="max-w-sm text-sm/7 text-ink-soft">Client and product work where architecture, team habits, and release quality had to improve together.</p>
      </div>
      <CareerTimeline projects={workProjects} />
    </section>

    <section
aria-labelledby="tools-heading"
class="
  border-t border-line/65 pt-12
  sm:pt-16
"
    >
      <div class="work-section-heading">
        <div><p class="maker-hero-eyebrow mb-4">02 / Toolkit</p><h2
id="tools-heading"
class="
  text-3xl/tight font-semibold tracking-tighter text-ink
  sm:text-4xl
"
                                                                >The tools behind the work.</h2></div>
        <p class="max-w-sm text-sm/7 text-ink-soft">React and TypeScript at the center. Backend, mobile, testing, and delivery tools to fit the problem.</p>
      </div>
      <div data-work-stack>
        {toolkitGroups.map((group, index) => (
          <section class="work-toolkit-lane" aria-labelledby={`work-toolkit-${group.id}`}>
            <div class="work-toolkit-heading">
              <span class="work-toolkit-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3 id={`work-toolkit-${group.id}`}>{group.title}</h3>
            </div>
            <ul
aria-label={`${group.title} technologies`}
class="@container/sculpted-tags flex flex-wrap gap-2.5"
            >
              {group.items.map(([name, count]) => <li class="max-w-full min-w-0"><SculptedTag count={count} href={getTechnologyPath(name)} label={name} /></li>)}
            </ul>
          </section>
        ))}
      </div>
      <p class="mt-7 text-xs/6 text-ink-soft">Numbers indicate the professional projects using each technology.</p>
      <nav id="work-next-steps" class="work-close" aria-label="Continue exploring work" data-work-close>
        {careerDestinations.map(destination => (
          <Link class="work-close-link" href={destination.href} variant="inherit">
            <Card as="div" variant="unstyled" data-work-close-card={destination.id}>
              <p data-work-close-category>{destination.category}</p>
              <h3 id={`work-close-${destination.id}`}>{destination.title}</h3>
              <p data-work-close-description>{destination.description}</p>
              <span data-work-close-arrow><Icon name="arrow-right" /></span>
            </Card>
          </Link>
        ))}
      </nav>
    </section>
  </div>
</PageLayout>
