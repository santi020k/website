---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'

import { getCachedPosts } from '@/utils/content'

import { selectedSessions, speakingFormats, speakingHighlights, speakingTopics } from '@/data/profile'
import PageLayout from '@/layouts/Base.astro'
import { createWhatsAppHref, siteConfig, whatsappMessages } from '@/site.config'

const postCount = (await getCachedPosts()).length
const highlights = speakingHighlights.map(h => h.label === 'Published writing' ? { ...h, value: `${postCount} posts` } : h)

const description =
  'Talks, workshops, and engineering conversations about developer experience, technical leadership, frontend architecture, and calmer delivery systems.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Speaking', url: '/speaking/' }
]

const speakingWhatsAppHref = createWhatsAppHref(whatsappMessages.speaking)

const bookingNotes = [
  {
    label: 'Best fit',
    value: 'Meetups, internal engineering talks, workshops, and leadership roundtables.'
  },
  {
    label: 'Helpful details',
    value: 'Audience size, format, date range, and the outcome you want the session to create.'
  },
  {
    label: 'Response time',
    value: 'WhatsApp is usually fastest for short intros; LinkedIn is great for async context.'
  }
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    description,
    mainEntity: {
      '@type': 'Person',
      jobTitle: 'Engineering Leader & Full-Stack Architect',
      knowsAbout: speakingTopics.map(topic => topic.title),
      name: siteConfig.author,
      sameAs: [siteConfig.contact.github, siteConfig.contact.linkedin, siteConfig.contact.medium]
    },
    name: 'Speaking'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: speakingTopics.map(topic => ({
      '@type': 'Question',
      acceptedAnswer: {
        '@type': 'Answer',
        text: topic.description
      },
      name: topic.title
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: 'Formats available for speaking engagements',
    itemListElement: speakingFormats.map((format, index) => ({
      '@type': 'ListItem',
      description: format.description,
      name: format.title,
      position: index + 1
    })),
    name: 'Speaking formats'
  }
]
---

<PageLayout meta={{
  breadcrumbs,
  description,
  structuredData,
  title: 'Speaking & Workshops'
}}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Speaking"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Talks, workshops,
          <span class="
            block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
            pb-4 text-transparent
          "
          >and engineering conversations.
          </span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Practical, opinionated sessions grounded in shipped work — leadership,
          architecture, DX, and the decisions that make teams faster or slower.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href={speakingWhatsAppHref} newTab showArrow>
            Invite me on WhatsApp
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
            Connect on LinkedIn
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <StatsGrid>
    {highlights.map(highlight => (
      <StatCard label={highlight.label} value={highlight.value} />
    ))}
  </StatsGrid>

  <PageSection>
    <SectionHeader
      description="A selection of talks and workshops delivered at meetups, conferences, and internal engineering events. Topics range from architecture decisions to delivery systems."
      eyebrow="Selected sessions"
      title="Talks with evidence."
    />
    <div
      class="
        grid gap-6
        sm:grid-cols-2
      "
    >
      {selectedSessions.map(talk => (
        <article class="
          talk-card flex h-full flex-col space-y-4 p-6
          sm:p-7
        "
        >
          <div>
            <p class="section-label">{talk.event} · {talk.year}</p>
            {talk.audience && (
              <p class="mt-1 text-xs text-ink-muted">{talk.audience}</p>
            )}
          </div>
          <h2 class="text-xl font-semibold text-ink">{talk.title}</h2>
          <p class="grow text-sm/7 text-ink-soft">{talk.description}</p>
          <div class="flex flex-wrap gap-2">
            {talk.tags.map(tag => (
              <span class="
                rounded-full border border-line/50 px-3 py-0.5 text-xs
                font-medium text-ink-muted
              "
              >{tag}
              </span>
            ))}
          </div>
          {(talk.links.slides ?? talk.links.video) && (
            <div class="section-actions">
              {talk.links.slides && (
                <ButtonLink href={talk.links.slides} newTab showArrow variant="secondary">
                  Slides
                </ButtonLink>
              )}
              {talk.links.video && (
                <ButtonLink href={talk.links.video} newTab showArrow variant="secondary">
                  Watch talk
                </ButtonLink>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Practical sessions grounded in shipped work — not theory. The goal is always for attendees to leave with something they can apply on Monday."
      eyebrow="Context"
      title="Where the talks happen."
    />

    <div
      class="
        grid gap-4
        sm:grid-cols-2
      "
      data-stagger="60"
    >
      <div class="mini-note h-full">
        <p class="section-label">ReactJS Colombia</p>
        <p class="mt-3 text-sm/7 text-ink-soft">
          Co-organizer of ReactJS Colombia — one of the largest React communities in Latin America. Sessions cover frontend architecture, performance, and developer experience in Spanish for regional engineers.
        </p>
      </div>
      <div class="mini-note h-full">
        <p class="section-label">Internal team sessions</p>
        <p class="mt-3 text-sm/7 text-ink-soft">
          Engineering talks inside product teams — architecture reviews, tooling onboarding, and tech lead cohorts. Closer to coaching than presenting; built around the team's actual problems.
        </p>
      </div>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Making it easy helps both of us. The more context you bring, the better I can tailor the session to your audience."
      eyebrow="Booking"
      title="Make the invite easy."
    />

    <div class="space-y-6">
      <div
        class="
          grid gap-4
          sm:grid-cols-3
        "
        data-stagger="60"
      >
        {bookingNotes.map(note => (
          <div class="mini-note h-full">
            <p class="section-label">{note.label}</p>
            <p class="mt-3 text-sm/7 text-ink-soft">{note.value}</p>
          </div>
        ))}
      </div>
      <div class="section-actions">
        <ButtonLink href={speakingWhatsAppHref} newTab showArrow>
          Invite me on WhatsApp
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          Message on LinkedIn
        </ButtonLink>
      </div>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Each topic draws on real project experience — architecture choices made under constraint, delivery problems solved in production, and team dynamics at different scales."
      eyebrow="Topics"
      title="What I speak about."
    />
    <div
      class="
        grid gap-6
        sm:grid-cols-2
      "
    >
      {speakingTopics.map(topic => (
        <article class="
          talk-card h-full space-y-4 p-6
          sm:p-7
        "
        >
          <h2 class="text-2xl font-semibold text-ink">{topic.title}</h2>
          <p class="text-sm/7 text-ink-soft">{topic.description}</p>
        </article>
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Different formats fit different goals. Pick the one that matches your audience and the outcome you want from the session."
      eyebrow="Formats"
      title="Available formats."
    />
    <div
      class="
        grid gap-6
        sm:grid-cols-2
      "
    >
      {speakingFormats.map(format => (
        <article class="
          talk-card h-full space-y-4 p-6
          sm:p-7
        "
        >
          <p class="section-label">{format.title}</p>
          <p class="text-base/7 text-ink-soft">{format.description}</p>
        </article>
      ))}
    </div>
  </PageSection>

</PageLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-stagger] > * {
      opacity: 0;
      transform: translateY(18px);
      animation: talk-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    [data-stagger="60"] > *:nth-child(1) { animation-delay: 0ms; }
    [data-stagger="60"] > *:nth-child(2) { animation-delay: 60ms; }
    [data-stagger="60"] > *:nth-child(3) { animation-delay: 120ms; }
    [data-stagger="60"] > *:nth-child(4) { animation-delay: 180ms; }

    [data-animate] {
      opacity: 0;
      transform: translateY(14px);
      animation: talk-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 80ms forwards;
    }

    @keyframes talk-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
