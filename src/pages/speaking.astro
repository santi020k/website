---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import TalkCard from '@/components/molecules/TalkCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import SpeakingHero from '@/components/pages/speaking/SpeakingHero.astro'
import SpeakingTimeline from '@/components/pages/speaking/SpeakingTimeline.astro'
import PageLayout from '@/layouts/Base.astro'

import SpeakerPortrait from '@/assets/photos/originals/me-1-square.webp'
import { getCachedPosts, getCachedProjects } from '@/utils/content'
import { getPortfolioPath } from '@/utils/links'

import { Card, Icon, RevealGroup } from '@santi020k/lumen-astro'

import { speakingFormats, speakingHighlights, speakingTopics } from '@/data/profile'
import {
  AUTHOR_JOB_TITLE,
  createAuthorSchema,
  createWhatsAppHref,
  sameAsProfiles,
  siteConfig,
  whatsappMessages
} from '@/site.config'

const talks = (await getCollection('talk', ({ data }) => !data.draft))
  .map(({ data }) => data)
  .sort((a, b) => {
    const aSortDate = a.date?.valueOf() ?? Date.UTC(a.year, 11, 31)
    const bSortDate = b.date?.valueOf() ?? Date.UTC(b.year, 11, 31)

    return (bSortDate - aSortDate) || (a.order - b.order)
  })

const postCount = (await getCachedPosts()).length
const highlights = speakingHighlights.map(h => h.label === 'Published writing' ? { ...h, value: String(postCount) } : h)
const communityWork = (await getCachedProjects()).find(project => project.data.typesId === 'community')

const description =
  'Talks, workshops, and community work around developer experience, technical leadership, frontend architecture, and practical knowledge sharing.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Speaking & Community', url: '/speaking/' }
]

const speakingWhatsAppHref = createWhatsAppHref(whatsappMessages.speaking)

const speakerPortraitImage = await getImage({
  format: 'avif',
  src: SpeakerPortrait,
  widths: [336, 384, 672, 768]
})

const bookingNotes = [
  {
    label: 'Best fit',
    value: 'Meetups, internal engineering talks, workshops, and leadership roundtables.'
  },
  {
    label: 'Helpful details',
    value: 'Audience size, format, date range, and the outcome you want the session to create.'
  },
  {
    label: 'Tailoring',
    value: 'Every session is shaped around the audience, constraints, and outcome—not pulled from a generic deck.'
  }
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    description,
    mainEntity: {
      ...createAuthorSchema(Astro.site),
      jobTitle: AUTHOR_JOB_TITLE,
      knowsAbout: speakingTopics.map(topic => `${topic.title} ${topic.subtitle}`),
      sameAs: sameAsProfiles.slice(0, 3)
    },
    name: 'Speaking & Community'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: 'A chronological record of public, private, and reconstructed speaking sessions',
    itemListElement: talks.map((talk, index) => ({
      '@type': 'ListItem',
      description: talk.description,
      name: talk.title,
      position: index + 1
    })),
    name: 'Speaking timeline'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: 'Formats available for speaking engagements',
    itemListElement: speakingFormats.map((format, index) => ({
      '@type': 'ListItem',
      description: format.description,
      name: `${format.title} ${format.subtitle}`,
      position: index + 1
    })),
    name: 'Speaking formats'
  }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description,
    preloadImage: {
      href: speakerPortraitImage.src,
      imagesizes: '(min-width: 1280px) 384px, (min-width: 1024px) 352px, (min-width: 640px) 368px, 336px',
      imagesrcset: speakerPortraitImage.srcSet.attribute,
      type: 'image/avif'
    },
    structuredData,
    title: 'Speaking & Community'
  }}
>
  <SpeakingHero
    linkedinHref={siteConfig.contact.linkedin}
    whatsappHref={speakingWhatsAppHref}
  />

  <StatsGrid columns={3}>
    {highlights.map(highlight => (
      <StatCard
        description={highlight.description}
        icon={highlight.icon}
        label={highlight.label}
        source={highlight.source}
        {...(highlight.prefix ? { prefix: highlight.prefix } : {})}
        {...(highlight.suffix ? { suffix: highlight.suffix } : {})}
        value={highlight.value}
      />
    ))}
  </StatsGrid>

  <PageSection>
    <SectionHeader
      description="Each topic draws on real project experience — architecture choices made under constraint, delivery problems solved in production, and team dynamics at different scales."
      eyebrow="Topics"
      title="What I speak about."
    />
    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
      "
      stagger={70}
      threshold={0}
    >
      {speakingTopics.map((topic, index) => (
        <TalkCard
          description={topic.description}
          index={index}
          source={topic.source}
          subtitle={topic.subtitle}
          title={topic.title}
          variant="topic"
        />
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Different formats fit different goals. Pick the one that matches your audience and the outcome you want from the session."
      eyebrow="Formats"
      title="Available formats."
    />
    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
      "
      stagger={70}
      threshold={0}
    >
      {speakingFormats.map((format, index) => (
        <TalkCard
          description={format.description}
          index={index}
          outcome={{ ...format.outcome, href: '#speaking-booking-heading' }}
          subtitle={format.subtitle}
          title={format.title}
          variant="format"
        />
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description="Every session I can recover so far, combining public event records with clearly labeled private and reconstructed talks from earlier in my career."
      eyebrow="Speaking history"
      title="The talks, in one timeline."
    />
    <SpeakingTimeline talks={talks} />
  </PageSection>

  {communityWork && (
    <PageSection>
      <SectionHeader
        description="Since 2017, I’ve helped create free events, practical learning opportunities, and a more connected local React ecosystem."
        eyebrow="Community"
        title="ReactJS Colombia."
      />

      <Card
        as="article"
        aria-labelledby="speaking-community-heading"
        data-speaking-community
        data-community-dossier
        variant="unstyled"
      >
        <div data-community-dossier-grid>
          <header data-community-cover>
            <p data-community-role>{communityWork.data.role}</p>
            <h3 id="speaking-community-heading">
              Building a community where engineers can learn and share.
            </h3>
            <span data-community-symbol>
              <Icon name="users-round" class="size-6" />
            </span>
          </header>

          <div data-community-body>
            <p data-community-copy>
              ReactJS Colombia brings developers together through meetups, workshops,
              mentorship, and speaker support. My work spans event planning, talk
              curation, logistics, and helping first-time speakers feel ready to contribute.
            </p>

            <ul aria-label="Community impact" data-community-evidence>
              {communityWork.data.impactMetrics.map((metric, index) => (
                <li>
                  <span aria-hidden="true" data-community-number>{String(index + 1).padStart(2, '0')}</span>
                  <span>{metric}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <footer class="section-actions" data-community-actions>
          {communityWork.data.liveDemoUrl && (
            <ButtonLink href={communityWork.data.liveDemoUrl} newTab showArrow>
              Visit the community
            </ButtonLink>
          )}
          <ButtonLink href={getPortfolioPath(communityWork.id)} showArrow variant="secondary">
            Read the community story
          </ButtonLink>
        </footer>
      </Card>
    </PageSection>
  )}

  <PageSection>
    <SectionHeader
      description="Share a little context and I can suggest the right shape for the session. WhatsApp is fastest for a short introduction; LinkedIn works well for a fuller brief."
      eyebrow="Booking"
      title="Bring the audience. I’ll shape the session."
    />

    <Card
      as="section"
      aria-labelledby="speaking-booking-heading"
      data-speaking-booking
      data-speaking-invitation
      variant="unstyled"
    >
      <div data-invitation-grid>
        <div data-invitation-cover>
          <span data-invitation-icon><Icon
name="messages-square"
class="size-6.5"
                                     /></span>
          <h3 id="speaking-booking-heading">Start with a brief.</h3>
          <p>
            Include the event, audience, date range, preferred format, and the outcome
            you want attendees to leave with.
          </p>
          <div class="section-actions" data-invitation-action>
            <ButtonLink href={speakingWhatsAppHref} newTab showArrow>
              Start the conversation
            </ButtonLink>
          </div>
        </div>

        <RevealGroup data-invitation-notes stagger={60} threshold={0}>
          {bookingNotes.map(note => (
            <div data-invitation-note>
              <h3>{note.label}</h3>
              <p>{note.value}</p>
            </div>
          ))}
        </RevealGroup>
      </div>
    </Card>
  </PageSection>

</PageLayout>

<style>
  [data-community-dossier][data-slot='card'] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-community-dossier-grid] { display: grid; grid-template-columns: minmax(0, 1fr); }

  [data-community-cover] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: 1.5rem;
    padding: 1.75rem 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
  }

  [data-community-role] {
    margin: 0;
    color: hsl(var(--brand));
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-community-cover] h3 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }

  [data-community-symbol] {
    display: none;
    width: 3.375rem;
    height: 3.375rem;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    border: 1px solid hsl(var(--line));
    border-radius: 1rem;
    background: hsl(var(--surface));
    color: hsl(var(--brand));
  }

  [data-community-body] { min-width: 0; padding: 1.75rem 1.625rem; }

  [data-community-copy] {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.9;
    letter-spacing: 0;
  }

  [data-community-evidence] { display: grid; margin: 1.375rem 0 0; padding: 0; list-style: none; }

  [data-community-evidence] li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid hsl(var(--line));
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    letter-spacing: 0;
  }

  [data-community-number] { padding-top: 0.125rem; color: hsl(var(--brand)); font-size: 0.6875rem; }
  [data-community-actions] { padding: 1.375rem 1.625rem; border-top: 1px solid hsl(var(--line)); }

  :global([data-theme='dark']) [data-community-role] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  :global([data-theme='dark']) :is([data-community-number], [data-community-symbol]) { color: hsl(var(--accent)); }

  @container speaking-community (width >= 32rem) {
    [data-community-dossier-grid] { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); }
    [data-community-cover] { border-top-right-radius: 0; }
    [data-community-symbol] { display: flex; }
  }

  @container speaking-community (width < 22rem) {
    [data-community-cover], [data-community-body], [data-community-actions] { padding: 1.5rem; }
    [data-community-cover] h3 { font-size: 1.75rem; }
  }

  @container speaking-community (width < 14rem) {
    [data-community-cover], [data-community-body], [data-community-actions] { padding-inline: 0.75rem; }
    [data-community-cover] h3 { font-size: 1.5rem; }
    [data-community-evidence] li { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }

  [data-speaking-invitation][data-slot='card'] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-invitation-grid] { display: grid; grid-template-columns: minmax(0, 1fr); }

  [data-invitation-cover] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: 1.25rem;
    padding: 1.875rem 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
  }

  [data-invitation-icon] { color: hsl(var(--brand)); }

  [data-invitation-cover] h3 {
    max-width: 10ch;
    margin: 0;
    color: hsl(var(--ink));
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  [data-speaking-invitation] p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.9;
    letter-spacing: 0;
  }

  [data-invitation-action] { max-width: 100%; margin-top: auto; }
  [data-invitation-notes] { min-width: 0; padding: 0.625rem 1.625rem; }
  [data-invitation-note] { padding-block: 1.4375rem; }
  [data-invitation-note] + [data-invitation-note] { border-top: 1px solid hsl(var(--line)); }

  [data-invitation-note] h3 {
    margin: 0 0 0.625rem;
    color: hsl(var(--ink));
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }

  :global([data-theme='dark']) [data-invitation-icon] { color: hsl(var(--accent)); }

  @container speaking-booking (width >= 32rem) {
    [data-invitation-grid] { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    [data-invitation-cover] { border-radius: 1.6875rem 0 0 1.6875rem; }
  }

  @container speaking-booking (width < 20rem) {
    [data-invitation-cover] { padding: 1.5rem 1.25rem; }
    [data-invitation-notes] { padding-inline: 1.25rem; }
  }

  @container speaking-booking (width < 14rem) {
    [data-invitation-cover] { padding: 1.25rem 0.75rem; }
    [data-invitation-cover] h3 { font-size: 1.5rem; }
    [data-invitation-notes] { padding-inline: 0.75rem; }
  }
</style>
