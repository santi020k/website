---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import TalkCard from '@/components/molecules/TalkCard.astro'
import TestimonialCard from '@/components/molecules/TestimonialCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import SpeakingHero from '@/components/pages/speaking/SpeakingHero.astro'
import SpeakingTimeline from '@/components/pages/speaking/SpeakingTimeline.astro'
import PageLayout from '@/layouts/Base.astro'

import SpeakerPortrait from '@/assets/photos/originals/me-1-square.webp'
import { getCachedPosts, getCachedProjects } from '@/utils/content'
import { getPortfolioPath } from '@/utils/links'

import Card from '@santi020k/lumen-astro/components/Card'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Link from '@santi020k/lumen-astro/components/Link'
import RevealGroup from '@santi020k/lumen-astro/components/RevealGroup'

import { getLocale, localizePath } from '@/i18n'
import { localizePageSource, pageTranslator } from '@/i18n/page-copy'
import { getLocalizedProfile } from '@/i18n/profile'
import {
  AUTHOR_JOB_TITLE,
  createAuthorSchema,
  createWhatsAppHref,
  sameAsProfiles,
  siteConfig,
  whatsappMessages
} from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)
const { speakingFormats, speakingHighlights, speakingTopics, testimonials } = getLocalizedProfile(pageLocale)

const talks = (await getCollection('talk', ({ data }) => !data.draft))
  .map(({ data }) => ({ ...data, title: localizePageSource(pageLocale, data.title), description: localizePageSource(pageLocale, data.description), audience: data.audience ? localizePageSource(pageLocale, data.audience) : undefined, location: data.location ? localizePageSource(pageLocale, data.location) : undefined, tags: data.tags.map(tag => localizePageSource(pageLocale, tag)) }))
  .sort((a, b) => {
    const aSortDate = a.date?.valueOf() ?? Date.UTC(a.year, 11, 31)
    const bSortDate = b.date?.valueOf() ?? Date.UTC(b.year, 11, 31)

    return (bSortDate - aSortDate) || (a.order - b.order)
  })

const postCount = (await getCachedPosts()).length
const highlights = speakingHighlights.map(h => h.label === t('page.publishedWriting') ? { ...h, value: String(postCount) } : h)
const communityWork = (await getCachedProjects()).find(project => project.data.typesId === 'community')

const speakingChapters = [
  { id: 'speaking-topics', label: t('page.topics') },
  { id: 'speaking-formats', label: t('page.formats') },
  { id: 'speaking-history', label: t('page.history') },
  ...(communityWork ? [{ id: 'speaking-community', label: t('shared.community') }] : [])
]

const description =
  t('page.talksWorkshopsAndCommunityWorkAround')

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('page.speakingAndCommunity'), url: localizePath('/speaking/', pageLocale) }
]

const speakingWhatsAppHref = createWhatsAppHref(pageLocale === 'es' ? 'Hola Santiago, vi tu página de charlas y me gustaría invitarte a una charla o taller. Evento y fecha:' : whatsappMessages.speaking)

const speakerPortraitImage = await getImage({
  format: 'avif',
  src: SpeakerPortrait,
  widths: [336, 384, 672, 768]
})

// Recommendations that speak to explaining ideas and sharing knowledge, the core of a good talk.
const speakingTestimonials = testimonials.filter(({ name }) => name === 'Raphael Drummond' || name === 'David Delgado')

const bookingNotes = [
  {
    label: t('page.bestFit'),
    value: t('page.meetupsInternalEngineeringTalksWorkshopsAnd')
  },
  {
    label: t('page.helpfulDetails'),
    value: t('page.audienceSizeFormatDateRangeAnd')
  },
  {
    label: t('page.tailoring'),
    value: t('page.everySessionIsShapedAroundThe')
  }
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    description,
    mainEntity: {
      ...createAuthorSchema(Astro.site),
      jobTitle: AUTHOR_JOB_TITLE,
      knowsAbout: speakingTopics.map(topic => `${topic.title} ${topic.subtitle}`),
      sameAs: sameAsProfiles.slice(0, 3)
    },
    name: t('page.speakingAndCommunity')
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: t('page.aChronologicalRecordOfPublicPrivate'),
    itemListElement: talks.map((talk, index) => ({
      '@type': 'ListItem',
      description: talk.description,
      name: talk.title,
      position: index + 1
    })),
    name: t('page.speakingTimeline')
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: t('page.formatsAvailableForSpeakingEngagements'),
    itemListElement: speakingFormats.map((format, index) => ({
      '@type': 'ListItem',
      description: format.description,
      name: `${format.title} ${format.subtitle}`,
      position: index + 1
    })),
    name: t('page.speakingFormats')
  }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description,
    preloadImage: {
      href: speakerPortraitImage.src,
      imagesizes: '(min-width: 1280px) 384px, (min-width: 1024px) 352px, (min-width: 640px) 368px, 336px',
      imagesrcset: speakerPortraitImage.srcSet.attribute,
      type: 'image/avif'
    },
    structuredData,
    title: 'Speaking & Community'
  }}
>
  <SpeakingHero />

  <StatsGrid columns={3}>
    {highlights.map(highlight => (
      <StatCard
        description={highlight.description}
        icon={highlight.icon}
        label={highlight.label}
        source={highlight.source}
        {...(highlight.prefix ? { prefix: highlight.prefix } : {})}
        {...(highlight.suffix ? { suffix: highlight.suffix } : {})}
        value={highlight.value}
      />
    ))}
  </StatsGrid>

  <div class="section-container-wide" data-speaking-guide-container>
    <nav id="speaking-guide" aria-labelledby="speaking-guide-label" data-speaking-guide>
      <p id="speaking-guide-label">{t('page.exploreSpeaking')}</p>
      <ol role="list">
        {speakingChapters.map(({ id, label }, index) => (
          <li>
            <Link href={localizePath(`#${id}`, pageLocale)} variant="inherit">
              <span data-speaking-guide-copy>
                <span aria-hidden="true" data-speaking-guide-number>{String(index + 1).padStart(2, '0')}</span>
                <span>{label}</span>
              </span>
              <ArrowExchange data-speaking-guide-arrow direction="down-right" size="sm" />
            </Link>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <PageSection>
    <SectionHeader
      description={t('page.eachTopicDrawsOnRealProject')}
      eyebrow={t('page.topics')}
      id="speaking-topics"
      title={t('page.whatISpeakAbout')}
    />
    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
      "
      stagger={70}
      threshold={0}
    >
      {speakingTopics.map((topic, index) => (
        <TalkCard
          description={topic.description}
          index={index}
          source={topic.source}
          subtitle={topic.subtitle}
          title={topic.title}
          variant="topic"
        />
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection>
    <SectionHeader
      description={t('page.differentFormatsFitDifferentGoalsPick')}
      eyebrow={t('page.formats')}
      id="speaking-formats"
      title={t('page.availableFormats')}
    />
    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
      "
      stagger={70}
      threshold={0}
    >
      {speakingFormats.map((format, index) => (
        <TalkCard
          description={format.description}
          index={index}
          outcome={{ ...format.outcome, href: '#speaking-booking-heading' }}
          subtitle={format.subtitle}
          title={format.title}
          variant="format"
        />
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('page.everySessionICanRecoverSo')}
      eyebrow={t('page.speakingHistory')}
      id="speaking-history"
      title={t('page.theTalksInOneTimeline')}
    />
    <SpeakingTimeline talks={talks} />
  </PageSection>

  {communityWork && (
    <PageSection>
      <SectionHeader
        description={t('page.since2017IVeHelpedCreate')}
        eyebrow={t('shared.community')}
        id="speaking-community"
        title="ReactJS Colombia."
      />

      <Card
        as="article"
        aria-labelledby="speaking-community-heading"
        data-speaking-community
        data-community-dossier
        variant="unstyled"
      >
        <div data-community-dossier-grid>
          <header data-community-cover>
            <p data-community-role>{localizePageSource(pageLocale, communityWork.data.role ?? '')}</p>
            <h3 id="speaking-community-heading">
              {t('page.buildingACommunityWhereEngineersCan')}
            </h3>
            <span data-community-symbol>
              <Icon name="users-round" class="size-6" />
            </span>
          </header>

          <div data-community-body>
            <p data-community-copy>
              {t('speaking.communityDescription')}
            </p>

            <ul aria-label={t('page.communityImpact')} data-community-evidence>
              {communityWork.data.impactMetrics.map((metric, index) => (
                <li>
                  <span aria-hidden="true" data-community-number>{String(index + 1).padStart(2, '0')}</span>
                  <span>{localizePageSource(pageLocale, metric)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <footer class="section-actions" data-community-actions>
          {communityWork.data.liveDemoUrl && (
            <ButtonLink href={localizePath(communityWork.data.liveDemoUrl, pageLocale)} newTab showArrow>
              {t('page.visitTheCommunity')}
            </ButtonLink>
          )}
          <ButtonLink href={localizePath(getPortfolioPath(communityWork.id), pageLocale)} showArrow variant="secondary">
            {t('page.readTheCommunityStory')}
          </ButtonLink>
        </footer>
      </Card>
    </PageSection>
  )}

  <PageSection layout="stacked">
    <SectionHeader
      description={t('page.clearExplanationsAndGenerousKnowledgeSharing')}
      eyebrow={t('page.inTheirWords')}
      linkHref="/about/#about-recommendations"
      linkLabel={t('page.readMoreRecommendations')}
      title={t('page.complexIdeasExplainedClearly')}
    />
    <div data-speaking-testimonials>
      {speakingTestimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }) => (
        <TestimonialCard authorName={name} avatarInitials={avatarInitials} avatarUrl={avatarUrl} quote={quote} relationship={relationship} role={role} />
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description={t('page.shareALittleContextAndICan')}
      eyebrow={t('page.booking')}
      title={t('page.bringTheAudienceILlShape')}
    />

    <Card
      as="section"
      aria-labelledby="speaking-booking-heading"
      data-speaking-booking
      data-speaking-invitation
      variant="unstyled"
    >
      <div data-invitation-grid>
        <div data-invitation-cover>
          <span data-invitation-icon><Icon
name="messages-square"
class="size-6.5"
                                     /></span>
          <h3 id="speaking-booking-heading">{t('page.startWithABrief')}</h3>
          <p>
            {t('page.includeTheEventAudienceDateRange')}
          </p>
          <div data-invitation-action>
            <div>
              <p data-invitation-channel-label>{t('page.forAQuickIntroduction')}</p>
              <ButtonLink className="w-full" href={localizePath(speakingWhatsAppHref, pageLocale)} newTab showArrow>
                {t('page.messageOnWhatsapp')}
              </ButtonLink>
            </div>
            <div data-invitation-secondary>
              <p data-invitation-channel-label>{t('page.ratherTalkItThrough')}</p>
              <Link data-invitation-link href={localizePath(siteConfig.contact.calendar, pageLocale)} newTab variant="inherit">
                <span>{t('page.bookACall')}</span><ArrowExchange data-invitation-link-icon direction="up-right" size="sm" />
              </Link>
              <Link data-invitation-link href={localizePath(siteConfig.contact.linkedin, pageLocale)} newTab variant="inherit">
                <span>{t('page.sendAFullerBriefOnLinkedin')}</span><ArrowExchange data-invitation-link-icon direction="up-right" size="sm" />
              </Link>
            </div>
          </div>
        </div>

        <RevealGroup data-invitation-notes stagger={60} threshold={0}>
          {bookingNotes.map(note => (
            <div data-invitation-note>
              <h3>{note.label}</h3>
              <p>{note.value}</p>
            </div>
          ))}
        </RevealGroup>
      </div>
    </Card>
  </PageSection>

</PageLayout>

<style>
  [data-speaking-guide-container] { container: speaking-guide / inline-size; }
  [data-speaking-guide] { --guide-accent: var(--brand); margin-top: 2.5rem; }
  :global(:root[data-theme='santi020k-dark']) [data-speaking-guide] { --guide-accent: var(--accent); }
  [data-speaking-guide] > p { color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.8; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-speaking-guide] ol { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); margin: 1rem 0 0; padding: 0; border-bottom: 1px solid hsl(var(--line)); list-style: none; }
  [data-speaking-guide] li { min-width: 0; }
  [data-speaking-guide] :global(a) { display: flex; align-items: center; justify-content: space-between; gap: 0.625rem; min-height: 4.25rem; padding: 0.875rem 1.25rem 0.875rem 0; border-top: 1px solid hsl(var(--line)); color: hsl(var(--ink)); font-size: 0.8125rem; font-weight: 500; line-height: 1.8; text-decoration: none; }
  [data-speaking-guide-copy] { display: flex; align-items: center; gap: 0.625rem; min-width: 0; }
  [data-speaking-guide-copy] > span:last-child { min-width: 0; overflow-wrap: anywhere; }
  [data-speaking-guide-number] { color: hsl(var(--guide-accent)); font-size: 0.6875rem; font-weight: 400; }
  [data-speaking-guide] :global([data-speaking-guide-arrow]) { flex-shrink: 0; color: hsl(var(--guide-accent)); }
  [data-speaking-guide] :global(a:hover) { color: hsl(var(--guide-accent)); text-decoration: underline; text-underline-offset: 0.25rem; }
  [data-speaking-guide] :global(a:focus-visible) { outline: 2px solid hsl(var(--guide-accent)); outline-offset: 0.25rem; }
  @container speaking-guide (width < 36rem) {
    [data-speaking-guide] ol { grid-auto-flow: row; grid-template-columns: minmax(0, 1fr); }
    [data-speaking-guide] :global(a) { min-height: 3rem; padding: 0.625rem 0; }
  }

  [data-community-dossier][data-slot='card'] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-community-dossier-grid] { display: grid; grid-template-columns: minmax(0, 1fr); }

  [data-community-cover] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: 1.5rem;
    padding: 1.75rem 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
  }

  [data-community-role] {
    margin: 0;
    color: hsl(var(--brand));
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The cover aligns items to the start, so without a cap the title grows to its
     longest word. Keep it within the cover so long words still break when the
     browser has no hyphenation dictionary for the page language. */
  [data-community-cover] h3 {
    max-width: 100%;
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }

  [data-community-symbol] {
    display: none;
    width: 3.375rem;
    height: 3.375rem;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    border: 1px solid hsl(var(--line));
    border-radius: 1rem;
    background: hsl(var(--surface));
    color: hsl(var(--brand));
  }

  [data-community-body] { min-width: 0; padding: 1.75rem 1.625rem; }

  [data-community-copy] {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.9;
    letter-spacing: 0;
  }

  [data-community-evidence] { display: grid; margin: 1.375rem 0 0; padding: 0; list-style: none; }

  [data-community-evidence] li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid hsl(var(--line));
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    letter-spacing: 0;
  }

  [data-community-number] { padding-top: 0.125rem; color: hsl(var(--brand)); font-size: 0.6875rem; }
  [data-community-actions] { padding: 1.375rem 1.625rem; border-top: 1px solid hsl(var(--line)); }

  :global([data-theme='santi020k-dark']) [data-community-role] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  :global([data-theme='santi020k-dark']) :is([data-community-number], [data-community-symbol]) { color: hsl(var(--accent)); }

  @container speaking-community (width >= 32rem) {
    [data-community-dossier-grid] { grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); }
    [data-community-cover] { border-top-right-radius: 0; }
    [data-community-symbol] { display: flex; }
  }

  @container speaking-community (width < 22rem) {
    [data-community-cover], [data-community-body], [data-community-actions] { padding: 1.5rem; }
    [data-community-cover] h3 { font-size: 1.75rem; }
  }

  @container speaking-community (width < 14rem) {
    [data-community-cover], [data-community-body], [data-community-actions] { padding-inline: 0.75rem; }
    [data-community-cover] h3 { font-size: 1.5rem; }
    [data-community-evidence] li { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }

  [data-speaking-invitation][data-slot='card'] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-invitation-grid] { display: grid; grid-template-columns: minmax(0, 1fr); }

  [data-invitation-cover] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: 1.25rem;
    padding: 1.875rem 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
  }

  [data-invitation-icon] { color: hsl(var(--brand)); }

  [data-invitation-cover] h3 {
    max-width: 10ch;
    margin: 0;
    color: hsl(var(--ink));
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  [data-speaking-invitation] p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.9;
    letter-spacing: 0;
  }

  [data-invitation-action] { width: 100%; max-width: 100%; margin-top: auto; }
  [data-speaking-invitation] [data-invitation-channel-label] { margin-bottom: 0.5rem; font-size: 0.6875rem; line-height: 1.8; }
  [data-invitation-secondary] { display: grid; gap: 0.25rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid hsl(var(--line)); }
  [data-speaking-testimonials] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 63.99rem) {
    [data-speaking-testimonials] { grid-template-columns: minmax(0, 1fr); }
  }
  [data-invitation-link] { display: flex; min-height: 2.75rem; align-items: center; justify-content: space-between; gap: 0.75rem; color: hsl(var(--ink)); font-size: 0.75rem; font-weight: 500; line-height: 1.8; text-decoration: none; }
  [data-invitation-link] span { min-width: 0; overflow-wrap: anywhere; }
  [data-invitation-link] :global([data-invitation-link-icon]) { flex-shrink: 0; color: hsl(var(--brand)); }
  [data-invitation-link]:hover span { text-decoration: underline; text-underline-offset: 0.25rem; }
  [data-invitation-link]:focus-visible { outline: 2px solid hsl(var(--brand)); outline-offset: 0.25rem; }
  [data-invitation-notes] { min-width: 0; padding: 0.625rem 1.625rem; }
  [data-invitation-note] { padding-block: 1.4375rem; }
  [data-invitation-note] + [data-invitation-note] { border-top: 1px solid hsl(var(--line)); }

  [data-invitation-note] h3 {
    margin: 0 0 0.625rem;
    color: hsl(var(--ink));
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }

  :global([data-theme='santi020k-dark']) [data-invitation-icon] { color: hsl(var(--accent)); }
  :global([data-theme='santi020k-dark']) [data-invitation-link] :global([data-invitation-link-icon]) { color: hsl(var(--accent)); }

  @container speaking-booking (width >= 32rem) {
    [data-invitation-grid] { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    [data-invitation-cover] { border-radius: 1.6875rem 0 0 1.6875rem; }
  }

  @container speaking-booking (width < 20rem) {
    [data-invitation-cover] { padding: 1.5rem 1.25rem; }
    [data-invitation-notes] { padding-inline: 1.25rem; }
  }

  @container speaking-booking (width < 14rem) {
    [data-invitation-cover] { padding: 1.25rem 0.75rem; }
    [data-invitation-cover] h3 { font-size: 1.5rem; }
    [data-invitation-notes] { padding-inline: 0.75rem; }
  }
</style>
