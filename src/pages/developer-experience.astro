---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PrincipleCard from '@/components/molecules/PrincipleCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import ShippedSystemCard from '@/components/molecules/ShippedSystemCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'

import { Card, Icon, Link, RevealGroup } from '@santi020k/lumen-astro'

import {
  createAuthorSchema,
  createWebsiteSchemaReference,
  YEARS_OF_EXPERIENCE
} from '@/site.config'

const description =
  'A practical guide to developer experience: measure delivery friction, encode useful standards, automate verification, and help teams ship confidently.'

const allPosts = await getCachedPosts()

const developerExperienceTags = new Set([
  'ai',
  'automation',
  'ci-cd',
  'code-quality',
  'developer-experience',
  'engineering-standards',
  'eslint',
  'testing'
])

const topicPosts = allPosts.filter(post => post.data.tags.some(tag => developerExperienceTags.has(tag)))

const featuredSlugs = [
  'why-developer-experience-work-should-be-measured-like-product-work',
  'designing-eslint-packages-teams-actually-adopt',
  'ai-coding-is-probabilistic-your-delivery-process-should-not-be',
  'one-quality-command-across-polyglot-repositories',
  'playwright-accessibility-checks-that-teams-keep-running',
  'muted-commands-make-ai-automation-faster-and-cheaper'
] as const

const postsBySlug = new Map(allPosts.map(post => [getPostSlug(post.id), post]))

const getFeaturedPost = (slug: typeof featuredSlugs[number]): CollectionEntry<'post'> => {
  const post = postsBySlug.get(slug)

  if (!post) throw new Error(`Missing developer experience hub post: ${slug}`)

  return post
}

const featuredPosts = featuredSlugs.map(getFeaturedPost)

const shippedSystems = [
  {
    title: 'Astro Doctor',
    category: 'Diagnostics',
    icon: 'scan-line',
    body: 'One rule system expressed through a CLI, ESLint, editor diagnostics, CI feedback, and agent guidance.',
    href: '/portfolio/astro-doctor/',
    linkLabel: 'Explore Astro Doctor'
  },
  {
    title: 'ESLint Config Basic',
    category: 'Standards',
    icon: 'list-checks',
    body: 'Composable standards designed to reduce configuration work while keeping framework and monorepo decisions explicit.',
    href: '/portfolio/eslint-config-basic/',
    linkLabel: 'Explore the ESLint toolkit'
  },
  {
    title: 'Lumen UI',
    category: 'Interfaces',
    icon: 'layers',
    body: 'Shared accessibility, interaction, and token contracts across Astro, React, and Web Components without runtime lock-in.',
    href: '/portfolio/lumen-ui/',
    linkLabel: 'Explore Lumen UI'
  }
] as const

const principles = [
  {
    title: 'Measure friction',
    subtitle: 'before choosing tools',
    body: 'Start with cycle time, failed checks, review delays, repeated questions, and recovery work. A tool is useful only when one of those outcomes improves.'
  },
  {
    title: 'Turn repeated judgment',
    subtitle: 'into clear defaults',
    body: 'Document the decision once, encode the deterministic part in linting or tests, and leave the genuinely contextual part visible for human review.'
  },
  {
    title: 'Keep feedback close',
    subtitle: 'to the change',
    body: 'Fast local checks, focused editor guidance, and one dependable quality command shorten the distance between a mistake and a useful explanation.'
  },
  {
    title: 'Protect the flow,',
    subtitle: 'not just the code',
    body: 'A healthy system covers accessibility, release confidence, documentation, ownership, and recovery—not merely formatting or a passing build.'
  }
]

const canonicalUrl = new URL('/developer-experience/', Astro.site).href

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalUrl}#page`,
  name: 'Developer Experience & Engineering Quality',
  description,
  url: canonicalUrl,
  author: createAuthorSchema(Astro.site),
  isPartOf: createWebsiteSchemaReference(Astro.site),
  about: [
    { '@type': 'Thing', name: 'Developer experience' },
    { '@type': 'Thing', name: 'Engineering quality' },
    { '@type': 'Thing', name: 'Software delivery automation' }
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: 'Developer experience field guides',
    itemListElement: featuredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: new URL(getPostPath(post.id), Astro.site).href
    }))
  }
}

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Developer Experience', url: '/developer-experience/' }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description,
    seoTitle: 'Developer Experience & Engineering Quality',
    structuredData,
    title: 'Developer Experience & Engineering Quality'
  }}
>
  <PageHero
    description="Developer experience is the quality of the system around software delivery: how clearly people can understand, change, verify, release, and recover the product. The goal is not more tooling. It is less avoidable friction and more trustworthy feedback."
    eyebrow="Developer Experience"
    gradientText="improves delivery."
    metaItems={['Engineering quality', 'Delivery automation', 'Team systems']}
    title="Build a system that"
  >
    <ButtonLink href="#field-guides" showArrow>
      Read the field guides
    </ButtonLink>
    <ButtonLink href="/portfolio/astro-doctor/" showArrow variant="secondary">
      See the system in practice
    </ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard
      description="Published articles connected to developer experience, engineering quality, testing, and automation."
      icon="notebook-pen"
label="Field notes"
      value={topicPosts.length}
    />
    <StatCard
      description="Release lead-time reduction achieved by improving CI/CD pipelines and automating quality gates."
      icon="timer"
label="Delivery outcome"
      suffix="%"
      value={-75}
    />
    <StatCard
      description="Building software products, delivery systems, and engineering practices across teams and platforms."
      icon="briefcase-business"
label="Experience"
      value={YEARS_OF_EXPERIENCE}
    />
  </StatsGrid>

  <PageSection>
    <SectionHeader
      description="The useful version of DX connects a recurring team problem to a measurable delivery outcome."
      eyebrow="Working definition"
      title="Developer experience is an operating system for delivery."
    />

    <Card
      as="section"
      aria-label="Working definition"
      data-working-definition
      variant="unstyled"
    >
      <div data-definition-spread>
        <div data-definition-panel>
          <p data-definition-label>The system</p>
          <h3>Make the path clear.</h3>
          <p data-definition-copy>
            Good developer experience makes the correct path easier to discover, the risky path easier to
            detect, and failures easier to recover from. It combines architecture, documentation, tooling,
            tests, release processes, and team agreements into one coherent feedback system.
          </p>
        </div>
        <div data-definition-panel>
          <p data-definition-label>The evidence</p>
          <h3>Measure what changes.</h3>
          <p data-definition-copy>
            That means measuring outcomes instead of counting tools. Faster feedback matters when it reduces
            waiting. Automation matters when it removes repeated work. Standards matter when they help people
            make decisions without guessing what “good” means.
          </p>
        </div>
      </div>
      <footer data-definition-footer>
        <Link data-definition-action href="/blog/why-developer-experience-work-should-be-measured-like-product-work/" variant="inherit">
          <span>Read the measurement framework</span>
          <Icon class="shrink-0" name="arrow-up-right" size="sm" />
        </Link>
      </footer>
    </Card>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Four practices keep developer-experience work tied to product delivery instead of turning it into a collection of disconnected tools."
      eyebrow="Operating model"
      title="Make the feedback system explicit."
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-5
        sm:card-grid-2
      "
      stagger={60}
      threshold={0}
    >
      {principles.map((principle, index) => (
        <PrincipleCard body={principle.body} index={index} subtitle={principle.subtitle} title={principle.title} />
      ))}
    </RevealGroup>
  </PageSection>

  <section
    aria-label="Developer experience field guides"
    class="
      section-container-wide pt-20
      sm:pt-24
      lg:pt-28
    "
  >
    {/* The fragment target starts at the visible heading, so the root scroll padding alone clears the header. */}
    <div id="field-guides">
      <SectionHeader
        description="Start with measurement and standards, then follow the implementation paths through linting, testing, automation, and AI-assisted delivery."
        eyebrow="Field guides"
        linkHref="/blog/tags/developer-experience/"
        linkLabel="Browse every developer experience post"
        title="Evidence, decisions, and implementation details."
      />
      <div class="
        mt-10
        sm:mt-12
      "
      >
        <PostsGallery columns={3} posts={featuredPosts} />
      </div>
    </div>
  </section>

  <PageSection>
    <SectionHeader
      description="The portfolio shows how these ideas become products, rules, editor feedback, documentation, and reusable component systems."
      eyebrow="Shipped systems"
      title="The practice behind the writing."
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-5 [--card-grid-min:12rem]
        lg:card-grid-3
      "
      id="shipped-systems"
      stagger={60}
      threshold={0}
    >
      {shippedSystems.map(system => <ShippedSystemCard {...system} />)}
    </RevealGroup>
  </PageSection>
</PageLayout>

<style>
  [data-working-definition][data-slot='card'] {
    --definition-accent: hsl(var(--brand));
    container: working-definition / inline-size;
    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  :global([data-theme='dark']) [data-working-definition] { --definition-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-definition-spread] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  [data-definition-panel] { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.375rem; min-width: 0; padding: 1.75rem; }
  [data-definition-panel]:first-child { border-right: 1px solid hsl(var(--line)); border-radius: 1.4375rem 0 0 0; background: hsl(var(--brand-soft)); }
  [data-definition-label] { margin: 0; color: var(--definition-accent); font-size: 0.6875rem; line-height: 1.8; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-definition-panel] h3 { margin: 0; color: hsl(var(--ink)); font-size: 1.4375rem; line-height: 1.35; font-weight: 500; letter-spacing: -0.04em; hyphens: none; }
  [data-definition-copy] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.95; }
  [data-definition-footer] { padding: 1.375rem 1.75rem; border-top: 1px solid hsl(var(--line)); }
  [data-definition-action][data-slot='link'] { display: flex; align-items: center; justify-content: space-between; gap: 1.125rem; min-height: 2.75rem; color: var(--definition-accent); font-size: 0.875rem; line-height: 1.7; font-weight: 500; text-decoration: none; }
  [data-definition-action]:is(:hover, :focus-visible) { text-decoration: underline; text-underline-offset: 0.25em; }
  [data-definition-action]:focus-visible { outline: 2px solid var(--definition-accent); outline-offset: 4px; }
  @container working-definition (width < 35rem) {
    [data-definition-spread] { grid-template-columns: minmax(0, 1fr); }
    [data-definition-panel]:first-child { border-right: 0; border-bottom: 1px solid hsl(var(--line)); border-radius: 1.4375rem 1.4375rem 0 0; }
  }
  @container working-definition (width < 22.5rem) {
    [data-definition-panel] { padding: 1.375rem min(1.125rem, 18px); }
    [data-definition-footer] { padding: 1.125rem min(1.125rem, 18px); }
  }
</style>
