---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PrincipleCard from '@/components/molecules/PrincipleCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import ShippedSystemCard from '@/components/molecules/ShippedSystemCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'

import { Card, Link, RevealGroup } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import {
  createAuthorSchema,
  createWebsiteSchemaReference,
  YEARS_OF_EXPERIENCE
} from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

const description =
  t('page.aPracticalGuideToDeveloperExperience')

const allPosts = await getCachedPosts()

const developerExperienceTags = new Set([
  'ai',
  'automation',
  'ci-cd',
  'code-quality',
  'developer-experience',
  'engineering-standards',
  'eslint',
  'testing'
])

const topicPosts = allPosts.filter(post => post.data.tags.some(tag => developerExperienceTags.has(tag)))

const featuredSlugs = [
  'why-developer-experience-work-should-be-measured-like-product-work',
  'designing-eslint-packages-teams-actually-adopt',
  'ai-coding-is-probabilistic-your-delivery-process-should-not-be',
  'one-quality-command-across-polyglot-repositories',
  'playwright-accessibility-checks-that-teams-keep-running',
  'muted-commands-make-ai-automation-faster-and-cheaper'
] as const

const postsBySlug = new Map(allPosts.map(post => [getPostSlug(post.id), post]))

const getFeaturedPost = (slug: typeof featuredSlugs[number]): CollectionEntry<'post'> => {
  const post = postsBySlug.get(slug)

  if (!post) throw new Error(`Missing developer experience hub post: ${slug}`)

  return post
}

const featuredPosts = featuredSlugs.map(getFeaturedPost)

const shippedSystems = [
  {
    title: 'Astro Doctor',
    category: t('page.diagnostics'),
    icon: 'scan-line',
    body: t('page.oneRuleSystemExpressedThroughA'),
    href: localizePath('/portfolio/astro-doctor/', pageLocale),
    linkLabel: t('page.exploreAstroDoctor')
  },
  {
    title: 'ESLint Config Basic',
    category: t('page.standards'),
    icon: 'list-checks',
    body: t('page.composableStandardsDesignedToReduceConfiguration'),
    href: localizePath('/portfolio/eslint-config-basic/', pageLocale),
    linkLabel: t('page.exploreTheEslintToolkit')
  },
  {
    title: 'Lumen UI',
    category: t('page.interfaces'),
    icon: 'layers',
    body: t('page.sharedAccessibilityInteractionAndTokenContracts'),
    href: localizePath('/portfolio/lumen-ui/', pageLocale),
    linkLabel: t('page.exploreLumenUi')
  }
] as const

const principles = [
  {
    title: t('page.measureFriction'),
    subtitle: t('page.beforeChoosingTools'),
    body: t('page.startWithCycleTimeFailedChecks')
  },
  {
    title: t('page.turnRepeatedJudgment'),
    subtitle: t('page.intoClearDefaults'),
    body: t('page.documentTheDecisionOnceEncodeThe')
  },
  {
    title: t('page.keepFeedbackClose'),
    subtitle: t('page.toTheChange'),
    body: t('page.fastLocalChecksFocusedEditorGuidance')
  },
  {
    title: t('page.protectTheFlow'),
    subtitle: t('page.notJustTheCode'),
    body: t('page.aHealthySystemCoversAccessibilityRelease')
  }
]

const canonicalUrl = new URL(localizePath('/developer-experience/', pageLocale), Astro.site).href

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalUrl}#page`,
  name: t('page.developerExperienceAndEngineeringQuality'),
  description,
  url: canonicalUrl,
  author: createAuthorSchema(Astro.site),
  isPartOf: createWebsiteSchemaReference(Astro.site),
  about: [
    { '@type': 'Thing', name: t('page.developerExperience7') },
    { '@type': 'Thing', name: t('page.engineeringQuality') },
    { '@type': 'Thing', name: t('page.softwareDeliveryAutomation') }
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: t('page.developerExperienceFieldGuides'),
    itemListElement: featuredPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: new URL(localizePath(getPostPath(post.id), pageLocale), Astro.site).href
    }))
  }
}

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('page.developerExperience'), url: localizePath('/developer-experience/', pageLocale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description,
    seoTitle: t('page.developerExperienceAndEngineeringQuality'),
    structuredData,
    title: t('page.developerExperienceAndEngineeringQuality')
  }}
>
  <PageHero
    description={t('page.developerExperienceIsTheQualityOf')}
    eyebrow={t('page.developerExperience')}
    gradientText={t('page.improvesDelivery')}
    metaItems={[t('page.engineeringQuality'), 'Delivery automation', 'Team systems']}
    title={t('page.buildASystemThat')}
  >
    <ButtonLink href="#field-guides" showArrow>
      {t('page.readTheFieldGuides')}
    </ButtonLink>
    <ButtonLink href={localizePath('/portfolio/astro-doctor/', pageLocale)} showArrow variant="secondary">
      {t('page.seeTheSystemInPractice')}
    </ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard
      description={t('page.publishedArticlesConnectedToDeveloperExperience')}
      icon="notebook-pen"
label={t('page.fieldNotes')}
      value={topicPosts.length}
    />
    <StatCard
      description={t('page.releaseLeadTimeReductionAchievedBy')}
      icon="timer"
label={t('page.deliveryOutcome')}
      suffix="%"
      value={-75}
    />
    <StatCard
      description={t('page.buildingSoftwareProductsDeliverySystemsAnd')}
      icon="briefcase-business"
label={t('shared.experience')}
      value={YEARS_OF_EXPERIENCE}
    />
  </StatsGrid>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('page.theUsefulVersionOfDxConnects')}
      eyebrow={t('page.workingDefinition')}
      title={t('page.developerExperienceIsAnOperatingSystem')}
    />

    <Card
      as="section"
      aria-label={t('page.workingDefinition')}
      data-working-definition
      variant="unstyled"
    >
      <div data-definition-spread>
        <div data-definition-panel>
          <p data-definition-label>{t('page.theSystem')}</p>
          <h3>{t('page.makeThePathClear')}</h3>
          <p data-definition-copy>
            {t('page.goodDeveloperExperienceMakesTheCorrect')}
          </p>
        </div>
        <div data-definition-panel>
          <p data-definition-label>{t('page.theEvidence')}</p>
          <h3>{t('page.measureWhatChanges')}</h3>
          <p data-definition-copy>
            {t('page.thatMeansMeasuringOutcomesInsteadOf')}
          </p>
        </div>
      </div>
      <footer data-definition-footer>
        <Link data-definition-action href={localizePath('/blog/why-developer-experience-work-should-be-measured-like-product-work/', pageLocale)} variant="inherit">
          <span>{t('page.readTheMeasurementFramework')}</span>
          <ArrowExchange class="shrink-0" direction="up-right" size="sm" />
        </Link>
      </footer>
    </Card>
  </PageSection>

  <PageSection>
    <SectionHeader
      description={t('page.fourPracticesKeepDeveloperExperienceWork')}
      eyebrow={t('page.operatingModel')}
      title={t('page.makeTheFeedbackSystemExplicit')}
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-5
        sm:card-grid-2
      "
      stagger={60}
      threshold={0}
    >
      {principles.map((principle, index) => (
        <PrincipleCard body={principle.body} index={index} subtitle={principle.subtitle} title={principle.title} />
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      id="field-guides"
      description={t('page.startWithMeasurementAndStandardsThen')}
      eyebrow={t('page.fieldGuides')}
      linkHref="/blog/tags/developer-experience/"
      linkLabel="Browse every developer experience post"
      title={t('page.evidenceDecisionsAndImplementationDetails')}
    />
    <PostsGallery columns={3} posts={featuredPosts} />
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('page.thePortfolioShowsHowTheseIdeas')}
      eyebrow={t('page.shippedSystems')}
      title={t('page.thePracticeBehindTheWriting')}
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
        lg:card-grid-3
      "
      id="shipped-systems"
      stagger={60}
      threshold={0}
    >
      {shippedSystems.map(system => <ShippedSystemCard {...system} />)}
    </RevealGroup>
  </PageSection>
</PageLayout>

<style>
  [data-working-definition][data-slot='card'] {
    --definition-accent: hsl(var(--brand));
    container: working-definition / inline-size;
    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  :global([data-theme='dark']) [data-working-definition] { --definition-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-definition-spread] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  [data-definition-panel] { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1.375rem; min-width: 0; padding: 1.75rem; }
  [data-definition-panel]:first-child { border-right: 1px solid hsl(var(--line)); border-radius: 1.4375rem 0 0 0; background: hsl(var(--brand-soft)); }
  [data-definition-label] { margin: 0; color: var(--definition-accent); font-size: 0.6875rem; line-height: 1.8; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-definition-panel] h3 { margin: 0; color: hsl(var(--ink)); font-size: 1.4375rem; line-height: 1.35; font-weight: 500; letter-spacing: -0.04em; hyphens: none; }
  [data-definition-copy] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.95; }
  [data-definition-footer] { padding: 1.375rem 1.75rem; border-top: 1px solid hsl(var(--line)); }
  [data-definition-action][data-slot='link'] { display: flex; align-items: center; justify-content: space-between; gap: 1.125rem; min-height: 2.75rem; color: var(--definition-accent); font-size: 0.875rem; line-height: 1.7; font-weight: 500; text-decoration: none; }
  [data-definition-action]:is(:hover, :focus-visible) { text-decoration: underline; text-underline-offset: 0.25em; }
  [data-definition-action]:focus-visible { outline: 2px solid var(--definition-accent); outline-offset: 4px; }
  @container working-definition (width < 35rem) {
    [data-definition-spread] { grid-template-columns: minmax(0, 1fr); }
    [data-definition-panel]:first-child { border-right: 0; border-bottom: 1px solid hsl(var(--line)); border-radius: 1.4375rem 1.4375rem 0 0; }
  }
  @container working-definition (width < 22.5rem) {
    [data-definition-panel] { padding: 1.375rem min(1.125rem, 18px); }
    [data-definition-footer] { padding: 1.125rem min(1.125rem, 18px); }
  }
</style>
