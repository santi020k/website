---
import { getEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import FaqList from '@/components/molecules/FaqList.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import TestimonialCard from '@/components/molecules/TestimonialCard.astro'
import WhatsAppIntake from '@/components/molecules/WhatsAppIntake.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import ContactHero from '@/components/pages/contact/ContactHero.astro'
import PageLayout from '@/layouts/Base.astro'

import { getPortfolioPath } from '@/utils/links'

import { Icon, Link, RevealGroup } from '@santi020k/lumen-astro'

import { createFaqSchema } from '@/data/work-with-me'
import { getLocale, localizePath } from '@/i18n'
import { translatePage } from '@/i18n/page-copy'
import { getLocalizedProfile } from '@/i18n/profile'
import { getLocalizedContactMetric, getLocalizedWorkWithMe } from '@/i18n/work-with-me'
import { createAuthorSchema, createWebsiteSchemaReference, siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = (source: string) => translatePage(pageLocale, source)
const { testimonials } = getLocalizedProfile(pageLocale)
const { workProcess, workWithMeFaq, workWithMeServices } = getLocalizedWorkWithMe(pageLocale)

const description =
  t('Invite Santiago Molina to speak, talk about an engineering role, or get help growing your team, adopting AI in engineering, and raising code quality.')

const resultProjectIds = ['void', 'smith-commerce', 'optic-power'] as const

const results = await Promise.all(resultProjectIds.map(async id => {
  const project = await getEntry('project', id)
  const metric = project?.data.impactMetrics[0]

  if (!project || !metric) throw new Error(`Work with me needs a project with an impact metric: ${id}`)

  return {
    display: getLocalizedContactMetric(metric, pageLocale),
    href: localizePath(getPortfolioPath(project.id), pageLocale),
    metric: t(metric),
    title: project.data.title
  }
}))

const featuredTestimonials = testimonials.slice(0, 2)
const canonicalUrl = new URL(localizePath('/work-with-me/', pageLocale), Astro.site).href

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${canonicalUrl}#page`,
    name: t('Work with Santiago Molina'),
    description,
    url: canonicalUrl,
    about: createAuthorSchema(Astro.site),
    isPartOf: createWebsiteSchemaReference(Astro.site)
  },
  { '@context': 'https://schema.org', ...createFaqSchema(workWithMeFaq, canonicalUrl) }
]

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', pageLocale) },
  { name: t('Work with me'), url: localizePath('/work-with-me/', pageLocale) }
]
---

<PageLayout
  mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description,
    seoTitle: t('Work with Santiago Molina — Talks, Roles, and Engineering Help'),
    structuredData,
    title: t('Work with me')
  }}
>
  <ContactHero />

  <PageSection layout="stacked">
    <SectionHeader
      description={t('Five kinds of work, all built on the same things: shipping real products, leading teams, and making engineering easier.')}
      id="ways-to-work"
      eyebrow={t('01 / Ways I can help')}
      title={t('Pick what fits. Or mix them.')}
    />

    <RevealGroup data-services stagger={60} threshold={0}>
      {workWithMeServices.map((service, index) => (
        <article data-service>
          <div data-service-index aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <Icon class="size-6" name={service.icon} />
          </div>
          <div data-service-summary>
            <h3>{service.title}</h3>
            <p data-service-description>{service.description}</p>
          </div>
          <div data-service-detail>
            <ul>
              {service.examples.map(example => <li><Icon class="size-4 shrink-0" name="check" />{example}</li>)}
            </ul>
            <Link data-service-proof href={localizePath(service.proof.href, pageLocale)} variant="inherit">
              <span>{service.proof.label}</span><ArrowExchange class="shrink-0" direction="right" size="sm" />
            </Link>
          </div>
        </article>
      ))}
    </RevealGroup>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('A few results from client work. Each case study explains the problem, the decisions, and how the result was measured.')}
      eyebrow={t('02 / Proof')}
      linkHref={localizePath('/portfolio/', pageLocale)}
      linkLabel={t('Read the case studies')}
      title={t('Results teams can feel.')}
    />
    <ul data-results>
      {results.map((result, index) => (
        <li>
          <a aria-describedby={`contact-result-${index}`} data-result href={localizePath(result.href, pageLocale)}>
            <span data-result-project>{result.title}<ArrowExchange
class="shrink-0"
direction="up-right"
size="sm"
                                                    /></span>
            {result.display.value && <span data-result-value>{result.display.value}</span>}
            <span data-result-label>{result.display.label}</span>
          </a>
          <p class="sr-only" id={`contact-result-${index}`}>{result.metric}</p>
        </li>
      ))}
    </ul>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      id="start"
      description={t('WhatsApp is the fastest way to reach me. If you’d rather talk first, book a call.')}
      eyebrow={t('03 / Start a conversation')}
      title={t('One message is enough.')}
    />

    <div data-start-grid>
      <WhatsAppIntake />

      <aside aria-label={t('Other ways to reach me')} data-start-aside>
        <p data-process-label>{t('What happens next')}</p>
        <ol data-process>
          {workProcess.map((step, index) => (
            <li>
              <span data-process-number aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div data-channels>
          <p data-channels-label>{t('Prefer another channel?')}</p>
          <a data-channel href={localizePath(siteConfig.contact.calendar, pageLocale)} rel="noopener noreferrer" target="_blank">
            <Icon class="size-5 shrink-0" name="calendar-days" />
            <span><strong>{t('Book a call')}</strong><span>{t('Pick a time on my calendar')}</span></span>
            <ArrowExchange class="shrink-0" direction="up-right" size="sm" />
          </a>
          <a data-channel href={localizePath(`mailto:${siteConfig.contact.email}`, pageLocale)}>
            <Icon class="size-5 shrink-0" name="mail" />
            <span><strong>{t('Email')}</strong><span>{siteConfig.contact.email}</span></span>
            <ArrowExchange class="shrink-0" direction="up-right" size="sm" />
          </a>
          <a data-channel href={localizePath(siteConfig.contact.linkedin, pageLocale)} rel="noopener noreferrer" target="_blank">
            <Icon class="size-5 shrink-0" name="briefcase-business" />
            <span><strong>LinkedIn</strong><span>{t('For recruiters and fuller briefs')}</span></span>
            <ArrowExchange class="shrink-0" direction="up-right" size="sm" />
          </a>
        </div>
      </aside>
    </div>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('From people I’ve managed, worked beside, and built for.')}
      eyebrow={t('04 / In their words')}
      linkHref={localizePath('/about/#about-recommendations', pageLocale)}
      linkLabel={t('Read more recommendations')}
      title={t('What working together is like.')}
    />
    <div data-work-testimonials>
      {featuredTestimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }) => (
        <TestimonialCard authorName={name} avatarInitials={avatarInitials} avatarUrl={avatarUrl} quote={quote} relationship={relationship} role={role} />
      ))}
    </div>
  </PageSection>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('Still unsure? These are the questions people usually ask first.')}
      id="contact-faq"
      eyebrow={t('05 / FAQ')}
      title={t('Before you write.')}
    />
    <FaqList items={workWithMeFaq} />
  </PageSection>
</PageLayout>

<style>
  [data-services], [data-results], [data-start-grid] { --service-accent: var(--brand); }
  :global(:root[data-theme='dark']) [data-services], :global(:root[data-theme='dark']) [data-results], :global(:root[data-theme='dark']) [data-start-grid] { --service-accent: var(--accent); }
  [data-services] { container: contact-services / inline-size; display: grid; }
  [data-service] { display: grid; grid-template-columns: 4rem minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; min-width: 0; padding-block: 2.5rem; border-top: 1px solid hsl(var(--line)); }
  [data-service]:last-child { border-bottom: 1px solid hsl(var(--line)); }
  [data-service-index] { display: flex; flex-direction: column; align-items: start; gap: 1.25rem; color: hsl(var(--service-accent)); }
  [data-service-index] > span { font-size: 0.6875rem; line-height: 1.8; font-variant-numeric: tabular-nums; letter-spacing: 0.08em; }
  [data-service-summary], [data-service-detail] { min-width: 0; }
  [data-service] h3 { max-width: 20ch; margin: 0; color: hsl(var(--ink)); font-size: 1.75rem; font-weight: 500; line-height: 1.25; letter-spacing: -0.045em; text-wrap: balance; }
  [data-service-description] { max-width: 40ch; margin: 1rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-service-detail] { display: flex; flex-direction: column; align-items: start; justify-content: space-between; gap: 1.25rem; }
  [data-service] ul { display: grid; gap: 0.625rem; margin: 0; padding: 0; list-style: none; }
  [data-service] li { display: flex; align-items: start; gap: 0.75rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.8; }
  [data-service] li :global(svg) { flex: none; margin-top: 0.25rem; color: hsl(var(--service-accent)); }
  [data-service-proof][data-slot='link'] { display: inline-flex; align-items: center; gap: 1rem; min-height: 2.75rem; color: hsl(var(--ink)); font-size: 0.8125rem; font-weight: 500; text-decoration: none; }
  [data-service-proof]:is(:hover, :focus-visible) { color: hsl(var(--service-accent)); text-decoration: underline; text-underline-offset: 0.25em; }
  [data-results] { container: contact-results / inline-size; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  [data-results] li { min-width: 0; }
  [data-results] li + li { border-left: 1px solid hsl(var(--line)); }
  [data-result] { display: flex; height: 100%; min-width: 0; flex-direction: column; align-items: start; gap: 1.25rem; padding: 0.25rem 2.5rem 0.5rem; color: hsl(var(--ink)); text-decoration: none; }
  [data-results] li:first-child [data-result] { padding-left: 0; }
  [data-results] li:last-child [data-result] { padding-right: 0; }
  [data-result-project] { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.8; }
  [data-result-value] { margin-top: 0.5rem; color: hsl(var(--service-accent)); font-size: clamp(2.5rem, 5cqi, 4.5rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.065em; overflow-wrap: anywhere; }
  [data-result-label] { max-width: 24ch; color: hsl(var(--ink)); font-size: 0.875rem; line-height: 1.8; }
  [data-result]:is(:hover, :focus-visible) [data-result-project] { color: hsl(var(--service-accent)); text-decoration: underline; text-underline-offset: 0.25em; }
  [data-result]:focus-visible { outline: 2px solid hsl(var(--service-accent)); outline-offset: 0.375rem; }
  [data-start-grid] { container: start-grid / inline-size; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; gap: 4rem; }
  [data-start-aside] { display: grid; min-width: 0; gap: 1.5rem; padding-top: 1.5rem; }
  [data-process-label], [data-channels-label] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.625rem; font-weight: 500; letter-spacing: 0.13em; line-height: 1.8; text-transform: uppercase; }
  [data-process] { display: grid; margin: 0; padding: 0; list-style: none; }
  [data-process] li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; padding-block: 1.25rem; border-top: 1px solid hsl(var(--line)); }
  [data-process] li:last-child { border-bottom: 1px solid hsl(var(--line)); }
  [data-process-number] { color: hsl(var(--service-accent)); font-size: 0.6875rem; font-variant-numeric: tabular-nums; letter-spacing: 0.08em; line-height: 2.2; }
  [data-process] h3 { margin: 0; color: hsl(var(--ink)); font-size: 1rem; font-weight: 500; line-height: 1.6; letter-spacing: -0.025em; }
  [data-process] p { margin: 0.375rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.8; }
  [data-channels] { display: grid; margin-top: 1rem; }
  [data-channels-label] { margin-bottom: 1rem; }
  [data-channel] { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem; min-height: 5.25rem; padding-block: 1rem; border-bottom: 1px solid hsl(var(--line)); color: hsl(var(--ink)); text-decoration: none; }
  [data-channel] > span { display: flex; min-width: 0; flex-direction: column; gap: 0.25rem; }
  [data-channel] strong { font-size: 0.875rem; font-weight: 500; }
  [data-channel] > span > span { color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.6; overflow-wrap: anywhere; }
  [data-channel] :global(svg) { color: hsl(var(--service-accent)); }
  [data-channel]:hover strong { text-decoration: underline; text-underline-offset: 0.25em; }
  [data-channel]:focus-visible { outline: 2px solid hsl(var(--service-accent)); outline-offset: 3px; }
  [data-work-testimonials] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  @container contact-services (width < 48rem) {
    [data-service] { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem 1.5rem; padding-block: 2rem; }
    [data-service-detail] { grid-column: 2; }
    [data-service] h3 { font-size: 1.5rem; }
  }
  @media (max-width: 63.99rem) {
    [data-start-grid] { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    [data-start-aside] { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem 2.5rem; padding-top: 0; }
    [data-process-label] { grid-column: 1 / -1; }
    [data-channels] { margin: 0; }
    [data-work-testimonials] { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 47.99rem) {
    [data-start-aside] { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    [data-results] { grid-template-columns: minmax(0, 1fr); }
    [data-results] li + li { border-left: 0; border-top: 1px solid hsl(var(--line)); }
    [data-results] [data-result] { padding: 1.5rem 0; gap: 0.75rem; }
    [data-result-value] { font-size: clamp(2rem, 14cqi, 3.25rem); }
  }
  @container contact-services (width < 20rem) {
    [data-service] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-service-index] { flex-direction: row; align-items: center; justify-content: space-between; }
    [data-service-detail] { grid-column: 1; }
    [data-service] h3 { font-size: 1.25rem; }
  }
</style>
