---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const description =
  'How santi020k.com handles data: no ad trackers, no profiling, just a static site with a theme preference.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy', url: '/privacy/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Privacy & analytics'
}

const sections = [
  {
    label: 'What runs here',
    body: 'Static HTML built with Astro, delivered via CDN. No third-party ad pixels, no visitor profiling.'
  },
  {
    label: 'Cookies & local storage',
    body: 'Only your theme preference (light / dark) is stored locally. No cross-site tracking from this domain.'
  },
  {
    label: 'Third-party services',
    body: 'Newsletter forms are handled by their own providers under their own terms. Contact links open your usual app.'
  },
  {
    label: 'Webmentions',
    body: 'Blog posts may show public reactions via Webmention.io — only interactions already published on the open web.'
  }
]
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Legal"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Privacy
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">without the maze.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          A static portfolio with no ad trackers and no profiling. Here's the short version.
        </p>
      </div>
    </div>
  </section>

  <div
    class="
      grid gap-4
      sm:grid-cols-2
    "
    data-stagger="60"
  >
    {sections.map(({ label, body }) => (
      <div class="mini-note h-full">
        <p class="section-label">{label}</p>
        <p class="mt-3 text-sm/7 text-ink-soft">{body}</p>
      </div>
    ))}
  </div>

  <div class="mini-note max-w-xl" data-animate>
    <p class="section-label">Questions</p>
    <p class="mt-2 text-sm/7 text-ink-soft">
      Reach out at{' '}
      <a class="font-medium text-brand transition-colors hover:text-accent" href={`mailto:${siteConfig.contact.email}`}>
        {siteConfig.contact.email}
      </a>
      {' '}for anything privacy-related.
    </p>
  </div>

  <div class="section-actions" data-animate>
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/accessibility/" showArrow variant="ghost">
      Accessibility statement
    </ButtonLink>
  </div>
</PageLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-stagger] > * {
      opacity: 0;
      transform: translateY(14px);
      animation: privacy-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    [data-stagger="60"] > *:nth-child(1) { animation-delay: 0ms; }
    [data-stagger="60"] > *:nth-child(2) { animation-delay: 60ms; }
    [data-stagger="60"] > *:nth-child(3) { animation-delay: 120ms; }
    [data-stagger="60"] > *:nth-child(4) { animation-delay: 180ms; }

    [data-animate] {
      opacity: 0;
      transform: translateY(10px);
      animation: privacy-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
    }

    @keyframes privacy-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
