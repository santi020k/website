---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PageLayout from '@/layouts/Base.astro'

import { Card } from '@santi020k/lumen-astro'

import { siteConfig } from '@/site.config'

const description =
  'How santi020k.com stores preferences, recent searches, offline pages, and data sent to third-party services.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy', url: '/privacy/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Privacy & analytics'
}

const sections = [
  {
    label: 'What runs here',
    body: 'Static HTML built with Astro, delivered via CDN. No third-party ad pixels, no visitor profiling.'
  },
  {
    label: 'Browser storage',
    body: 'Theme preference and recent site-search terms are stored in localStorage on your device. The service worker may also keep previously visited pages and assets in Cache Storage for offline access. Clearing this site’s browser data removes both.'
  },
  {
    label: 'Hosting analytics',
    body: 'Cloudflare provides aggregate server-side traffic and performance metrics as the site host. This site sends no first-party analytics beacon and sets no analytics cookies.'
  },
  {
    label: 'Third-party services',
    body: 'Newsletter subscriptions are processed by Buttondown. Comments are provided by Giscus through GitHub Discussions. Those services receive the information you submit and apply their own privacy terms.'
  },
  {
    label: 'Webmentions',
    body: 'Blog posts may show public reactions retrieved through Webmention.io. These are interactions already published on the open web; removal requests can be sent to the contact address below.'
  }
]
---

<PageLayout footerVariant="compact" meta={meta}>
  <PageHero
    description="No ad trackers or visitor profiles. This page explains the browser storage and third-party services the site does use."
    eyebrow="Legal"
    gradientText="without the maze."
    metaItems={['No ad pixels', 'No profiling', 'Reviewed July 26, 2026']}
    title="Privacy"
  />

  <div class="page-card-grid" data-stagger="60">
    {sections.map(({ label, body }) => (
      <Card class="h-full p-5" variant="muted">
        <p class="section-label">{label}</p>
        <p class="mt-3 text-sm/7 text-ink-soft">{body}</p>
      </Card>
    ))}
  </div>

  <section class="section-container-wide">
    <div class="cta-panel max-w-3xl">
      <p class="
        section-label text-brand
        dark:text-accent
      "
      >Questions
      </p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
        Privacy questions should be easy to ask.
      </h2>
      <p class="mt-3 text-sm/7 text-ink-soft">
        Reach out at{' '}
        <a
          class="
            font-medium text-brand transition-colors
            hover:text-accent
          "
          href={`mailto:${siteConfig.contact.email}`}
        >
          {siteConfig.contact.email}
        </a>
        {' '}for anything privacy-related.
      </p>
      <p class="mt-3 text-xs/6 text-ink-muted">
        Last reviewed July 26, 2026. I aim to acknowledge privacy and deletion requests within five business days.
      </p>
    </div>
  </section>

  <div class="section-container-wide section-actions">
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/accessibility/" showArrow variant="ghost">
      Accessibility statement
    </ButtonLink>
  </div>
</PageLayout>
