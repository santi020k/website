---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import { Link } from '@santi020k/lumen-astro'

import { siteConfig } from '@/site.config'

const description =
  'How santi020k.com stores preferences, recent searches, offline pages, and data sent to third-party services.'

/** Single source of truth for the review date shown in the hero and the footnote. */
const lastReviewed = 'October 23, 2026'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy', url: '/privacy/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Privacy & analytics'
}

const sections = [
  {
    label: 'What runs here',
    body: 'Static HTML built with Astro, delivered via CDN. No third-party ad pixels, no visitor profiling.'
  },
  {
    label: 'Browser storage',
    body: 'Theme preference and recent site-search terms are stored in localStorage on your device. The service worker may also keep previously visited pages and assets in Cache Storage for offline access. Saved responses can retain their original URL, including search terms. Clearing this site’s browser data removes both.'
  },
  {
    label: 'Hosting analytics',
    body: 'Cloudflare provides aggregate server-side traffic and performance metrics as the site host. This site sends no first-party analytics beacon and sets no analytics cookies.'
  },
  {
    label: 'Third-party services',
    body: 'Newsletter subscriptions are processed by Buttondown. Comments are provided by Giscus through GitHub Discussions. When comments load, Giscus receives the page URL, which can include an open site-search query. These services also receive the information you submit and apply their own privacy terms.'
  },
  {
    label: 'Webmentions',
    body: 'Blog posts may show public reactions retrieved through Webmention.io. These are interactions already published on the open web; removal requests can be sent to the contact address below. Reaction profile pictures load directly from Webmention.io or the author’s site, so that host receives your IP address when your browser fetches the image. These requests send no referrer.'
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <PageHero
    description="No ad trackers or visitor profiles. This page explains the browser storage and third-party services the site does use."
    eyebrow="Legal"
    gradientText="without the maze."
    metaItems={['No ad pixels', 'No profiling', `Reviewed ${lastReviewed}`]}
    title="Privacy"
  />

  <PolicySections {sections} />

  <PolicyContactCard label="Questions" title="Privacy questions should be easy to ask.">
    <p>
      Reach out at{' '}
      <Link
variant="inherit"
href={`mailto:${siteConfig.contact.email}`}
      >
        {siteConfig.contact.email}
      </Link>
      {' '}for anything privacy-related.
    </p>
    <p slot="note">
      Last reviewed {lastReviewed}. I aim to acknowledge privacy and deletion requests within five business days.
    </p>
  </PolicyContactCard>

  <div class="section-container-wide section-actions">
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/accessibility/" showArrow variant="ghost">
      Accessibility statement
    </ButtonLink>
  </div>
</PageLayout>
