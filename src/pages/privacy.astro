---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

import { siteConfig } from '@/site.config'

const description =
  'How santi020k.com handles data: no ad trackers, no profiling, just a static site with a theme preference.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy', url: '/privacy/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Privacy & analytics'
}

const sections = [
  {
    label: 'What runs here',
    body: 'Static HTML built with Astro, delivered via CDN. No third-party ad pixels, no visitor profiling.'
  },
  {
    label: 'Cookies & local storage',
    body: 'Only your theme preference (light / dark) is stored locally. No cross-site tracking from this domain.'
  },
  {
    label: 'Third-party services',
    body: 'Newsletter forms are handled by their own providers under their own terms. Contact links open your usual app.'
  },
  {
    label: 'Webmentions',
    body: 'Blog posts may show public reactions via Webmention.io — only interactions already published on the open web.'
  }
]
---

<PageLayout meta={meta}>
  <PageHero
    description="A static portfolio with no ad trackers, no profiling, and only the local preferences needed to make the site feel right."
    eyebrow="Legal"
    gradientText="without the maze."
    metaItems={['No ad pixels', 'No profiling', 'Theme saved locally']}
    title="Privacy"
  />

  <div class="page-card-grid" data-stagger="60">
    {sections.map(({ label, body }) => (
      <Card class="h-full p-5" variant="muted">
        <p class="section-label">{label}</p>
        <p class="mt-3 text-sm/7 text-ink-soft">{body}</p>
      </Card>
    ))}
  </div>

  <section class="section-container-wide">
    <div class="cta-panel max-w-3xl">
      <p class="section-label text-brand">Questions</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
        Privacy questions should be easy to ask.
      </h2>
      <p class="mt-3 text-sm/7 text-ink-soft">
        Reach out at{' '}
        <a
          class="
            font-medium text-brand transition-colors
            hover:text-accent
          "
          href={`mailto:${siteConfig.contact.email}`}
        >
          {siteConfig.contact.email}
        </a>
        {' '}for anything privacy-related.
      </p>
    </div>
  </section>

  <div class="section-container-wide section-actions">
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/accessibility/" showArrow variant="ghost">
      Accessibility statement
    </ButtonLink>
  </div>
</PageLayout>
