---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

const description =
  t('page.howSanti020kComStoresPreferencesRecent')

/** Single source of truth for the review date shown in the hero and the footnote. */
const lastReviewed = t('page.october282026')

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('shared.privacy'), url: localizePath('/privacy/', pageLocale) }
]

const meta = {
  breadcrumbs,
  description,
  title: t('page.privacyAndAnalytics')
}

const sections = [
  {
    label: t('page.whatRunsHere'),
    body: t('page.staticHtmlBuiltWithAstroDelivered')
  },
  {
    label: t('page.browserStorage'),
    body: t('page.themePreferenceAndRecentSiteSearch')
  },
  {
    label: t('page.analytics'),
    body: t('page.cloudflareHostsTheSiteAndProvides')
  },
  {
    label: t('page.contactForm'),
    body: t('page.theWorkWithMeFormWrites')
  },
  {
    label: t('page.thirdPartyServices'),
    body: t('page.newsletterSubscriptionsAreProcessedByButtondown')
  },
  {
    label: 'Webmentions',
    body: t('page.blogPostsMayShowPublicReactions')
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <PageHero
    description={t('page.noAdTrackersOrVisitorProfiles')}
    eyebrow={t('page.legal')}
    gradientText={t('page.withoutTheMaze')}
    metaItems={['No ad pixels', 'No profiling', `${t('page.reviewed')} ${lastReviewed}`]}
    title={t('shared.privacy')}
  />

  <PolicySections {sections} />

  <PolicyContactCard label={t('page.questions')} title={t('page.privacyQuestionsShouldBeEasyTo')}>
    <p>
      {t('page.reachOutAt')}{' '}
      <Link
variant="inherit"
href={localizePath(`mailto:${siteConfig.contact.email}`, pageLocale)}
      >
        {siteConfig.contact.email}
      </Link>
      {' '}{t('page.forAnythingPrivacyRelated')}
    </p>
    <p slot="note">
      {t('page.lastReviewed')} {lastReviewed}{t('page.iAimToAcknowledgePrivacyAnd')}
    </p>
  </PolicyContactCard>

  <div class="section-container-wide section-actions">
    <ButtonLink href={localizePath('/', pageLocale)} showArrow variant="secondary">
      {t('page.backHome')}
    </ButtonLink>
    <ButtonLink href={localizePath('/accessibility/', pageLocale)} showArrow variant="ghost">
      {t('page.accessibilityStatement')}
    </ButtonLink>
  </div>
</PageLayout>
