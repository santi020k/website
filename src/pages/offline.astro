---
import Button from '@/components/atoms/Button.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PageLayout from '@/layouts/Base.astro'

import { Card, Icon } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { translatePage } from '@/i18n/page-copy'

const pageLocale = getLocale(Astro.url.pathname)
const t = (source: string) => translatePage(pageLocale, source)

const meta = {
  description: t('Offline fallback page for the santi020k portfolio and blog.'),
  noindex: true,
  title: t('Offline')
}
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <div class="section-container-wide" data-offline-layout>
    <PageHero
      description={t('Your connection or the site may be unavailable. Try again, or open a previously visited page from the local cache.')}
      eyebrow={t('Offline')}
      gradientText={t('but cached pages are within reach.')}
      metaItems={[t('Cached pages'), t('Static-first'), t('Try again anytime')]}
      title={t('Page unavailable,')}
    >
      <ButtonLink href={localizePath('/', pageLocale)} variant="secondary">
        {t('Go home')}
      </ButtonLink>
      <ButtonLink href={localizePath('/portfolio/', pageLocale)} variant="ghost">
        {t('Browse projects')}
      </ButtonLink>
      <Button data-retry-connection>
        {t('Try again')}
      </Button>
    </PageHero>

    <div data-offline-support>
      <Card as="section" variant="unstyled" data-offline-folio aria-labelledby="offline-cache-heading">
        <header data-offline-header>
          <h2 id="offline-cache-heading">{t('What\'s cached')}</h2>
          <Icon name="cloud-download" class="size-5.5 shrink-0" />
        </header>
        <p data-offline-copy>
          {t('Previously visited pages may still be available offline. The freshest posts, projects, and profile updates will appear once the site responds again.')}
        </p>
        <footer data-offline-footer>
          <span data-connection-indicator>
            <span data-connection-offline><Icon name="wifi-off" class="size-4" /></span>
            <span data-connection-online hidden><Icon name="wifi" class="size-4" /></span>
          </span>
          <p aria-live="polite" aria-atomic="true" data-connection-status>
            {t('Try again, or open a previously visited page.')}
          </p>
        </footer>
      </Card>
    </div>
  </div>

  <script>
    import { getLocale } from '@/i18n'

    let offlineControls: AbortController | undefined

    const setupOfflineControls = () => {
      offlineControls?.abort()

      offlineControls = undefined

      const retry = document.querySelector<HTMLButtonElement>('[data-retry-connection]')
      const status = document.querySelector<HTMLElement>('[data-connection-status]')
      const offlineIcon = document.querySelector<HTMLElement>('[data-connection-offline]')
      const onlineIcon = document.querySelector<HTMLElement>('[data-connection-online]')

      if (!retry || !status || !offlineIcon || !onlineIcon) return

      offlineControls = new AbortController()

      const { signal } = offlineControls

      const updateStatus = () => {
        offlineIcon.hidden = navigator.onLine

        onlineIcon.hidden = !navigator.onLine

        // navigator.onLine only reflects the browser's network link; it cannot
        // tell whether this site is reachable or merely slow.
        const spanish = getLocale(window.location.pathname) === 'es'

        const onlineMessage = spanish ?
          'Tu navegador indica que hay conexión. Inténtalo de nuevo para cargar la página actualizada.' :
          'Your browser reports a connection. Try again to load the latest page.'

        const offlineMessage = spanish ? 'Tu navegador indica que no hay conexión.' : 'Your browser reports no connection.'

        status.textContent = navigator.onLine ? onlineMessage : offlineMessage
      }

      retry.addEventListener('click', () => window.location.reload(), { signal })

      window.addEventListener('online', updateStatus, { signal })

      window.addEventListener('offline', updateStatus, { signal })

      updateStatus()
    }

    setupOfflineControls()

    document.addEventListener('astro:page-load', setupOfflineControls)

    document.addEventListener('astro:before-swap', () => {
      offlineControls?.abort()

      offlineControls = undefined
    })
  </script>
</PageLayout>

<style>
  [data-offline-layout] { container: offline-layout / inline-size; display: grid; gap: 3rem; }
  [data-offline-support] { min-width: 0; }
  @container offline-layout (width >= 56rem) {
    [data-offline-layout] > :global(.editorial-page-hero) { grid-column: 1; grid-row: 1; padding-top: 0; }
    [data-offline-support] { grid-column: 2; grid-row: 1; align-self: center; }
    [data-offline-layout] :global(.editorial-page-title) { font-size: 3.5rem; }
  }
  @media (width >= 64rem) {
    [data-offline-layout] { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  }
  /* Text enlargement stacks the columns even on a wide viewport. */
  @container offline-layout (width < 56rem) {
    [data-offline-layout] > :global(.editorial-page-hero), [data-offline-support] { grid-column: 1 / -1; }
  }

  [data-offline-folio][data-slot='card'] {
    container: offline-folio / inline-size;
    max-width: 36rem;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
  }

  [data-offline-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 1.625rem;
    border-radius: 1.6875rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  [data-offline-folio] h2 {
    margin: 0;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }

  [data-offline-copy] {
    margin: 1.5rem 1.625rem;
    color: hsl(var(--ink));
    font-size: 1.0625rem;
    line-height: 1.8;
    letter-spacing: -0.025em;
  }

  [data-offline-footer] {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    margin-inline: 1.625rem;
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid hsl(var(--line));
  }

  [data-connection-indicator] {
    display: flex;
    align-items: center;
    justify-content: center;
    color: hsl(var(--brand));
  }

  [data-connection-status] {
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    letter-spacing: 0;
  }

  :global([data-theme='dark']) [data-offline-header] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  :global([data-theme='dark']) [data-connection-indicator] { color: hsl(var(--accent)); }

  @container offline-folio (width < 20rem) {
    [data-offline-header] { padding: 1.375rem; }
    [data-offline-copy] { margin: 1.375rem; font-size: 1rem; }
    [data-offline-footer] { margin-inline: 1.375rem; }
  }

  @container offline-folio (width < 14rem) {
    [data-offline-header] { gap: 0.5rem; padding: 1rem 0.75rem; }
    [data-offline-copy] { margin-inline: 0.75rem; }
    [data-offline-footer] { grid-template-columns: minmax(0, 1fr); margin-inline: 0.75rem; }
    [data-connection-indicator] { justify-content: start; }
  }
</style>
