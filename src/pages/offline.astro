---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import PageLayout from '@/layouts/Base.astro'

const meta = {
  description: 'Offline fallback page for the santi020k portfolio and blog.',
  title: 'Offline'
}
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Offline"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          No connection,
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">but still within reach.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Previously visited pages can still load from the local cache. Refresh once you're back online.
        </p>
      </div>

      <div
        class="
          animate-slide-up [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/">
            Go home
          </ButtonLink>
          <ButtonLink href="/portfolio/" variant="secondary">
            Browse projects
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <div class="mini-note max-w-xl" data-animate>
    <p class="section-label">What's cached</p>
    <p class="mt-2 text-sm/7 text-ink-soft">
      Pages you've visited before are available offline. Refresh when your connection returns to get the latest content.
    </p>
  </div>
</PageLayout>
