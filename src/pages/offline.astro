---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

const meta = {
  description: 'Offline fallback page for the santi020k portfolio and blog.',
  title: 'Offline'
}
---

<PageLayout meta={meta}>
  <PageHero
    description="Previously visited pages can still load from the local cache. Refresh when the connection returns to get the newest version."
    eyebrow="Offline"
    gradientText="but still within reach."
    metaItems={['Cached pages', 'Static-first', 'Refresh when online']}
    title="No connection,"
  >
    <ButtonLink href="/">
      Go home
    </ButtonLink>
    <ButtonLink href="/portfolio/" variant="secondary">
      Browse projects
    </ButtonLink>
  </PageHero>

  <section class="section-container-wide">
    <Card
      class="
        max-w-xl p-5
        sm:p-6
      "
      variant="muted"
    >
      <p class="section-label">What's cached</p>
      <p class="mt-2 text-sm/7 text-ink-soft">
        Pages you've visited before are available offline. The freshest posts, projects, and profile updates will appear after the browser reconnects.
      </p>
    </Card>
  </section>
</PageLayout>
