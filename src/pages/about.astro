---
import { getImage } from 'astro:assets'

import OrganizationLogoRail from '@/components/molecules/OrganizationLogoRail.astro'
import PrincipleCard from '@/components/molecules/PrincipleCard.astro'
import TestimonialCard from '@/components/molecules/TestimonialCard.astro'
import AboutHero from '@/components/pages/about/AboutHero.astro'
import AboutSectionHeading from '@/components/pages/about/AboutSectionHeading.astro'
import PageLayout from '@/layouts/Base.astro'

import AboutMeImage from '@/assets/photos/portraits/santiago-plum-soft-smile.png'
import { getCachedProjects } from '@/utils/content'

import { ButtonLink, Icon, Note } from '@santi020k/lumen-astro'

import { collaborationLanes, engineeringPrinciples, selectedOrganizations, testimonials } from '@/data/profile'
import {
  AUTHOR_JOB_TITLE,
  createAuthorSchema,
  createWebsiteSchemaReference,
  sameAsProfiles,
  siteConfig,
  YEARS_OF_EXPERIENCE
} from '@/site.config'

const yearsOfExperience = YEARS_OF_EXPERIENCE
const projectsById = new Map((await getCachedProjects()).map(project => [project.id, project]))

const organizationRailItems = selectedOrganizations.map(organization => {
  const project = projectsById.get(organization.projectId)

  if (!project) {
    throw new Error(`Missing project for About page organization: ${organization.projectId}`)
  }

  return { ...organization, project }
})

const aboutPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  width: 400,
  height: 500,
  widths: [320, 400, 640, 800]
})

const profileStats = [
  {
    description: 'Building web, mobile, backend, automation, and developer experience systems.',
    label: 'Experience',
    value: `${yearsOfExperience} years`
  },
  {
    description: 'Largest cross-functional team led across product, design, frontend, and backend.',
    label: 'Team leadership',
    value: '14 people'
  },
  {
    description: 'Release lead-time reduction through CI/CD and quality-gate automation.',
    label: 'Delivery systems',
    value: '-75%'
  }
]

const storyBeats = [
  'Based in Medellín, Colombia, I have spent the last decade-plus shipping products across commerce, SaaS, gaming, real estate, and media.',
  'Across these projects, I focus on architecture that can evolve, delivery pipelines that catch problems early, and team habits that make decisions clearer.',
  'I like being close to the product and close to the code. The best technical leadership I have seen is practical, calm, and specific enough that teams can move faster without guessing what “good” means.'
]

const workingModes = [
  'Architecture and modernization for products that need to keep shipping.',
  'Developer experience, automation, testing, linting, and CI/CD systems that reduce review noise.',
  'Technical leadership for teams that need clearer standards and calmer decisions under pressure.'
]

const description =
  `Santiago Molina is a Medellín-based engineering leader and full-stack architect with ${yearsOfExperience} years ` +
  'building products, delivery systems, and developer teams.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
]

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About Santiago Molina — Engineering Leader',
  description,
  url: new URL('/about/', Astro.site).href,
  isPartOf: createWebsiteSchemaReference(Astro.site),
  mainEntity: {
    ...createAuthorSchema(Astro.site),
    alternateName: 'santi020k',
    jobTitle: AUTHOR_JOB_TITLE,
    description,
    image: new URL(aboutPortraitImage.src, Astro.site).href,
    knowsAbout: [
      'Full-Stack Engineering',
      'Software Architecture',
      'Technical Leadership',
      'Developer Experience',
      'Automation Systems'
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Medellín',
      addressCountry: 'CO'
    },
    email: `mailto:${siteConfig.contact.email}`,
    sameAs: sameAsProfiles
  }
}

const meta = {
  breadcrumbs,
  description,
  preloadImage: {
    href: aboutPortraitImage.src,
    imagesizes: '(min-width: 768px) 400px, calc(100vw - 48px)',
    imagesrcset: aboutPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  seoTitle: 'Santiago Molina — Engineering Leader',
  structuredData: aboutPageSchema,
  title: 'About Santiago Molina — Engineering Leader'
}
---

<PageLayout headerVariant="signature" meta={meta}>
  <div class="about-page" data-about-page>
    <AboutHero />

    <section class="about-stats" aria-label="Profile highlights">
      {profileStats.map(({ description: statDescription, label, value }) => (
        <Note borderPosition="none" class="about-stat" label={label}>
          <p class="about-stat-value">{value}</p>
          <p data-about-stat-description>{statDescription}</p>
        </Note>
      ))}
    </section>

    <section class="about-section">
      <AboutSectionHeading index="01" eyebrow="The shape of the work" title="Engineering, leadership, and delivery systems." description="A working model of what I care about, where I can help, and why the details matter." />
      <div class="about-story">
        <div class="about-story-copy">{storyBeats.map(beat => <p>{beat}</p>)}</div>
        <div class="about-working-modes">
          <h3>Where I usually help.</h3>
          <ul>{workingModes.map((mode, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{mode}</p></li>
          ))}</ul>
        </div>
      </div>
    </section>

    <section class="about-section">
      <AboutSectionHeading index="02" eyebrow="Collaboration" title="Range, with a clear purpose." description="The places where hands-on engineering and technical leadership can make the biggest difference." />
      <div class="about-lanes">
        {collaborationLanes.map(({ description: laneDescription, fit, title }, index) => (
          <article>
            <p class="about-eyebrow">{String(index + 1).padStart(2, '0')}</p>
            <h3>{title}</h3>
            <p>{laneDescription}</p>
            <p class="about-lane-fit">{fit}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section">
      <AboutSectionHeading index="03" eyebrow="Context" title="The people and products behind the work." description="Commerce, SaaS, gaming, real estate, and community. Each brought a different problem to solve." />
      <OrganizationLogoRail organizations={organizationRailItems} />
      <div class="about-actions">
        <ButtonLink class="about-link" href="/portfolio/" variant="unstyled">Read the case studies<Icon name="arrow-right" /></ButtonLink>
        <ButtonLink class="about-link" href={siteConfig.contact.linkedin} newTab variant="unstyled">Open LinkedIn<Icon name="arrow-up-right" /></ButtonLink>
      </div>
    </section>

    <section class="about-section">
      <AboutSectionHeading index="04" eyebrow="Principles" title="What I believe about engineering." description="The principles I come back to when a product is moving fast and the team needs decisions that hold." />
      <div class="about-principles">
        {engineeringPrinciples.map(({ body, title }, index) => (
          <PrincipleCard appearance="editorial" body={body} index={index} title={title} />
        ))}
      </div>
    </section>

    <section class="about-section">
      <AboutSectionHeading index="05" eyebrow="Recommendations" title="What collaborators say about the work." description="Communication, reliability, and helping people do better work together—in their own words." />
      <div class="about-testimonials">
        {testimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }) => (
          <TestimonialCard authorName={name} avatarInitials={avatarInitials} avatarUrl={avatarUrl} quote={quote} relationship={relationship} role={role} />
        ))}
      </div>
      <div class="about-actions">
        <ButtonLink class="about-link" href={siteConfig.contact.linkedin} newTab variant="unstyled">See all LinkedIn recommendations<Icon name="arrow-up-right" /></ButtonLink>
      </div>
    </section>

    <section class="about-next">
      <div><p class="about-eyebrow">Keep exploring</p><h2>Want the fuller picture?</h2><p>The portfolio has the project evidence; the blog has the thinking behind the decisions.</p></div>
      <div class="maker-hero-actions">
        <ButtonLink class="maker-hero-primary" href="/portfolio/" variant="unstyled">View portfolio<span class="
          maker-hero-arrow
        "
                                                                                                   ><Icon name="arrow-up-right" /></span></ButtonLink>
        <ButtonLink class="maker-hero-secondary" href="/blog/" variant="unstyled">Read the blog<Icon name="arrow-right" /></ButtonLink>
      </div>
    </section>
  </div>
</PageLayout>
