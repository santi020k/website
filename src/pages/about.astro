---
import { getImage, Picture } from 'astro:assets'

import AboutMeImage from '../assets/photos/originals/me-1-square.webp'
import ButtonLink from '../components/atoms/ButtonLink.astro'
import Eyebrow from '../components/atoms/Eyebrow.astro'
import GradientDivider from '../components/atoms/GradientDivider.astro'
import SocialList from '../components/molecules/SocialList.astro'
import { selectedOrganizations, testimonials } from '../data/profile'
import PageLayout from '../layouts/Base.astro'
import { siteConfig } from '../site.config'

const yearsOfExperience = `${new Date().getFullYear() - 2014}+`

const aboutPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  widths: [400, 600, 800]
})

const description =
  `${yearsOfExperience} years shipping full-stack products. ` +
  'Senior engineer and tech lead based in Medellín — focused on automation, developer experience, and cross-functional leadership.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
]

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Santiago Molina — Engineering Leader',
  description,
  url: new URL('/about/', Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    name: siteConfig.author,
    jobTitle: 'Engineering Leader & Full-Stack Architect',
    description: siteConfig.description,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Medellín',
      addressCountry: 'CO'
    },
    email: `mailto:${siteConfig.contact.email}`,
    sameAs: [
      siteConfig.contact.github,
      siteConfig.contact.linkedin,
      siteConfig.contact.medium
    ].filter(Boolean)
  }
}

const meta = {
  breadcrumbs,
  description,
  preloadImage: {
    href: aboutPortraitImage.src,
    imagesizes: '(min-width: 1024px) 352px, 75vw',
    imagesrcset: aboutPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  structuredData: aboutPageSchema,
  title: 'About Santiago Molina — Engineering Leader'
}
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="
      relative grid gap-10
      lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center
    "
    >
      <div class="relative z-10 space-y-8">
        <Eyebrow
          label="About"
          tone="brand"
          className="
            animate-slide-up whitespace-normal
            motion-reduce:animate-none
          "
        />

        <div
          class="
            animate-slide-up space-y-4 [animation-delay:90ms]
            motion-reduce:animate-none
          "
        >
          <h1 class="
            max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
            sm:text-6xl/[0.95]
            lg:text-[5.2rem]/[0.92]
          "
          >
            Engineering leader.
            <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">Full-stack architect.</span>
          </h1>
          <p class="
            max-w-xl text-base/7 text-ink-soft
            sm:text-lg/7
          "
          >
            Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
          </p>
        </div>

        <div
          class="
            animate-slide-up space-y-5 [animation-delay:180ms]
            motion-reduce:animate-none
          "
        >
          <div class="section-actions">
            <ButtonLink href="/portfolio/" showArrow>
              See selected work
            </ButtonLink>
            <ButtonLink href="/blog/" showArrow variant="secondary">
              Read the blog
            </ButtonLink>
            <ButtonLink href={siteConfig.contact.resume} newTab showArrow variant="secondary">
              Open résumé
            </ButtonLink>
          </div>

          <SocialList />
        </div>
      </div>

      <div
        class="
          animate-reveal-lcp relative isolate mx-auto w-full max-w-88
          motion-reduce:animate-none
        "
      >
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[5%] z-10 rounded-4xl
            bg-radial from-brand/18 via-accent/8 to-transparent blur-3xl
            motion-safe:animate-pulse
            motion-reduce:animate-none
          "
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[-10%] z-20 rounded-full border-2
            border-brand/15 [animation-delay:800ms]
            motion-safe:animate-[spin_24s_linear_infinite]
            motion-reduce:animate-none
            dark:border-brand/20
          "
          style="border-image: linear-gradient(135deg, hsl(var(--brand)/0.3), hsl(var(--accent)/0.15), transparent) 1; border-radius: 9999px;"
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-[8%] z-20 rounded-full border
            border-brand/10 [animation-delay:800ms]
            motion-safe:animate-[spin_18s_linear_infinite_reverse]
            motion-reduce:animate-none
          "
          style="border-image: linear-gradient(225deg, hsl(var(--accent)/0.2), hsl(var(--brand)/0.1), transparent) 1; border-radius: 9999px;"
        />

        <div class="
          panel-card relative z-0 overflow-hidden rounded-[2.25rem] p-3
          sm:p-4
          transition-shadow duration-500
          hover:shadow-[0_20px_60px_-15px_hsl(var(--brand)/0.15)]
          motion-reduce:transition-none
        "
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 z-10 grid-fade opacity-20 dark:opacity-30"
          />
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-0 z-20 bg-linear-to-br
              from-brand/5 via-transparent to-accent/8
            "
          />
          <Picture
            alt="Portrait of Santiago Molina"
            class="
              relative z-0 aspect-4/5 w-full rounded-[1.7rem] object-cover
              object-top
            "
            decoding="sync"
            fetchpriority="high"
            formats={['avif', 'webp']}
            height={440}
            loading="eager"
            sizes="(min-width: 1024px) 352px, 75vw"
            src={AboutMeImage}
            width={352}
            widths={[400, 600, 800]}
          />
        </div>

        <div class="
          absolute bottom-8 -left-4 z-30 hidden mini-note min-w-40 border-l-4 border-l-brand/40
          [animation-delay:600ms]
          motion-safe:animate-float-y
          motion-reduce:animate-none
          sm:-left-8 sm:block
        "
        >
          <p class="section-label flex items-center gap-1.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand motion-safe:animate-pulse" />
            Base
          </p>
          <p class="mt-2 text-sm/6 text-ink">Medellin · Remote worldwide</p>
        </div>

        <div
          class="
            absolute top-8 -right-4 z-30 hidden mini-note min-w-32 border-r-4 border-r-accent/40
            [animation-delay:900ms]
            motion-safe:animate-float-y
            motion-reduce:animate-none
            sm:-right-8 sm:block
          "
        >
          <p class="section-label">Experience</p>
          <p class="mt-2 text-2xl font-bold bg-linear-to-br from-ink to-ink-soft bg-clip-text text-transparent">{yearsOfExperience}</p>
        </div>
      </div>
    </div>
  </section>

  <GradientDivider class="pt-10" />
  <section class="grid gap-8 pt-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-10" data-animate>
    <div class="space-y-3">
      <p class="section-label text-brand">The story</p>
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        Engineering, leadership, and the work behind it.
      </h2>
    </div>

    <div class="space-y-8">
      <div class="space-y-6 section-copy max-w-2xl">
        <p>
          I'm Santiago Molina, a full-stack engineer and tech lead based in Medellín, Colombia.
          Over the last {yearsOfExperience} years I've shipped products across commerce, SaaS, gaming,
          and real estate — working across the entire stack from architecture and backend services to
          CI/CD pipelines and developer tooling.
        </p>

        <p>
          Right now my focus is on teams and systems: how to structure engineering organizations so they stay
          fast to ship, easy to maintain, and hard to break. I care deeply about developer experience — not as
          a buzzword, but as the measurable gap between a team that ships with confidence and one that ships
          with anxiety. Automation is usually how you close that gap.
        </p>

        <p>
          I've led cross-functional teams of up to 14 people spanning product, design, frontend, and backend.
          I believe the most valuable thing a tech lead does is reduce the number of decisions engineers
          have to make under pressure — through clear standards, good tooling, and systems that fail loudly
          instead of silently.
        </p>

        <p>
          Outside work I co-organize ReactJS Colombia, write about engineering workflows and DX, and find the
          intersection between good software and good products. When I'm not at a keyboard I'm probably reading,
          hiking, or watching something with a good score on Letterboxd.
        </p>
      </div>

      <div class="
        grid gap-3
        sm:grid-cols-3
      "
      >
        <div class="mini-note">
          <p class="section-label">Experience</p>
          <p class="mt-2 text-lg font-semibold text-ink">{yearsOfExperience} years</p>
        </div>
        <div class="mini-note">
          <p class="section-label">Leadership</p>
          <p class="mt-2 text-sm/7 text-ink-soft">Led teams of up to 14 across product, design, frontend, and backend.</p>
        </div>
        <div class="mini-note">
          <p class="section-label">Focus today</p>
          <p class="mt-2 text-sm/7 text-ink-soft">Automation, delivery clarity, and developer experience that compounds.</p>
        </div>
      </div>
    </div>
  </section>

  <GradientDivider class="pt-10" />
  <section class="grid gap-8 pt-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-10" data-animate>
    <div class="space-y-3">
      <p class="section-label text-brand">Social proof</p>
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        Some of the teams and communities behind the work.
      </h2>
      <p class="max-w-xl text-sm text-ink-soft">
        A few of the products, companies, and communities behind the portfolio. The value is in the work itself, but context helps people read the case studies with the right level of trust.
      </p>
    </div>

    <div class="space-y-6">
      <div class="
        grid gap-4
        sm:grid-cols-2
        lg:grid-cols-3
      "
      >
        {selectedOrganizations.map(({ context, label }) => (
          <article class="mini-note h-full">
            <p class="section-label">{label}</p>
            <p class="mt-3 text-sm/7 text-ink-soft">{context}</p>
          </article>
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href="/portfolio/" showArrow>
          Read the case studies
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          Open LinkedIn
        </ButtonLink>
      </div>
    </div>
  </section>

  <GradientDivider class="pt-10" />
  <section class="grid gap-8 pt-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-10" data-animate>
    <div class="space-y-3">
      <p class="section-label text-brand">Principles</p>
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        What I believe about engineering.
      </h2>
      <p class="max-w-xl text-sm text-ink-soft">
        A few things that shape how I work, how I lead, and what I focus on.
      </p>
    </div>

    <div
      class="
        grid gap-6
        sm:grid-cols-2
      "
    >
      {[
        {
          title: 'Automate the friction, not the thinking',
          body: 'The best automation removes toil — repetitive, low-judgment work that slows teams down. It should never replace the thinking that makes products worth building.'
        },
        {
          title: 'DX is UX for your team',
          body: 'The developer experience of a codebase shapes how fast and confidently the team can move. Bad DX compounds. Good DX compounds too — invest early and measure it.'
        },
        {
          title: 'Leadership means fewer decisions under pressure',
          body: 'A good tech lead reduces ambiguity before it becomes risk. Clear standards, good tooling, and systems that fail loudly are how you protect a team\'s velocity at scale.'
        },
        {
          title: 'Performance is a product decision',
          body: 'Speed isn\'t a tech concern, it\'s a user concern. Every kilobyte and every render-blocking resource is a choice that affects real people on real connections.'
        },
        {
          title: 'Boring tech is often the right call',
          body: 'The goal is to solve the problem, not to use the newest tool. Stable, well-understood solutions let the team focus on the actual product.'
        },
        {
          title: 'Consistency beats perfection',
          body: 'A consistent codebase with some imperfections beats an inconsistent one with pockets of brilliance. Conventions compound. Exceptions cost.'
        }
      ].map(({ title, body }, index) => (
        <div
          class:list={[
            `
              panel-card h-full space-y-3 p-6
              sm:p-7
            `,
            index === 0 && 'sm:col-span-2'
          ]}
        >
          <p class="section-label">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="text-xl font-semibold text-ink">{title}</h3>
          <p class="text-sm/7 text-ink-soft">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <GradientDivider class="pt-10" />
  <section class="grid gap-8 pt-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:gap-10" data-animate>
    <div class="space-y-3">
      <p class="section-label text-brand">Recommendations</p>
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        What collaborators say about the work.
      </h2>
      <p class="max-w-xl text-sm text-ink-soft">
        A few direct quotes from colleagues, managers, and clients. The recurring patterns across them are summarised below.
      </p>
    </div>

    <div class="space-y-10">
      <div
        class="
          grid gap-6
          sm:grid-cols-2
        "
      >
        {testimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }) => (
          <article class="
            panel-card h-full space-y-5 p-6
            sm:p-7
          "
          >
            <div class="flex items-center gap-4">
              {avatarUrl ?
                (
                  <img
                    alt={name}
                    class="size-11 shrink-0 rounded-full object-cover"
                    decoding="async"
                    height="44"
                    loading="lazy"
                    src={avatarUrl}
                    width="44"
                  />
                ) :
                (
                  <div class="
                    grid size-11 shrink-0 place-items-center rounded-full
                    bg-brand/10 text-sm font-semibold text-brand
                  "
                  >
                    {avatarInitials}
                  </div>
                )}
              <div>
                <p class="text-sm font-semibold text-ink">{name}</p>
                <p class="text-xs text-ink-muted">{role} · {relationship}</p>
              </div>
            </div>
            <blockquote class="text-sm/7 text-ink-soft">
              <p>"{quote}"</p>
            </blockquote>
          </article>
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          See all LinkedIn recommendations
        </ButtonLink>
      </div>
    </div>
  </section>
</PageLayout>
