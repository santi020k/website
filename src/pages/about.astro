---
import { getImage } from 'astro:assets'

import AnimatedPortrait from '@/components/atoms/AnimatedPortrait.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import MiniNote from '@/components/atoms/MiniNote.astro'
import PrincipleCard from '@/components/molecules/PrincipleCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SocialList from '@/components/molecules/SocialList.astro'
import TestimonialCard from '@/components/molecules/TestimonialCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PageLayout from '@/layouts/Base.astro'

import AboutMeImage from '@/assets/photos/originals/me-1-square.webp'

import { engineeringPrinciples, selectedOrganizations, testimonials } from '@/data/profile'
import { AUTHOR_JOB_TITLE, sameAsProfiles, siteConfig, YEARS_OF_EXPERIENCE } from '@/site.config'

const yearsOfExperience = YEARS_OF_EXPERIENCE

const aboutPortraitImage = await getImage({
  format: 'avif',
  src: AboutMeImage,
  widths: [400, 600, 800]
})

const description =
  `${yearsOfExperience} years shipping full-stack products. ` +
  'I am Santiago Molina (@santi020k), a senior engineer and tech lead based in Medellín — focused on automation and developer experience.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
]

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Santiago Molina — Engineering Leader',
  description,
  url: new URL('/about/', Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    name: siteConfig.author,
    jobTitle: AUTHOR_JOB_TITLE,
    description: siteConfig.description,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Medellín',
      addressCountry: 'CO'
    },
    email: `mailto:${siteConfig.contact.email}`,
    sameAs: sameAsProfiles.slice(0, 3)
  }
}

const meta = {
  breadcrumbs,
  description,
  preloadImage: {
    href: aboutPortraitImage.src,
    imagesizes: '(min-width: 1024px) 352px, 75vw',
    imagesrcset: aboutPortraitImage.srcSet.attribute,
    type: 'image/avif'
  },
  structuredData: aboutPageSchema,
  title: 'About Santiago Molina — Engineering Leader'
}
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="
      relative grid gap-10
      lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center
    "
    >
      <div class="relative z-10 space-y-8">
        <Eyebrow
          label="About Santiago Molina (@santi020k)"
          tone="brand"
          className="
            animate-slide-up whitespace-normal
            motion-reduce:animate-none
          "
        />

        <div
          class="
            animate-slide-up space-y-4 [animation-delay:90ms]
            motion-reduce:animate-none
          "
        >
          <h1 class="sr-only">About Santiago Molina (@santi020k) — Engineering Leader</h1>
          <h2
            aria-hidden="true"
            class="
              max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
              sm:text-6xl/[0.95]
              lg:text-[5.2rem]/[0.92]
            "
          >
            Engineering leader.
            <span class="
              block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
              pb-4 text-transparent
            "
            >Full-stack architect.
            </span>
          </h2>
          <p class="
            max-w-xl text-base/7 text-ink-soft
            sm:text-lg/7
          "
          >
            Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
          </p>
        </div>

        <div
          class="
            animate-slide-up space-y-5 [animation-delay:180ms]
            motion-reduce:animate-none
          "
        >
          <div class="section-actions">
            <ButtonLink href="/portfolio/" showArrow>
              See selected work
            </ButtonLink>
            <ButtonLink href="/blog/" showArrow variant="secondary">
              Read the blog
            </ButtonLink>
            <ButtonLink href={siteConfig.contact.resume} newTab showArrow variant="secondary">
              Open résumé
            </ButtonLink>
          </div>

          <SocialList />
        </div>
      </div>

      <AnimatedPortrait
        src={AboutMeImage}
        alt="Portrait of Santiago Molina (@santi020k)"
        showFloatingBadges
        badgeProps={{
          location: { label: 'Base', text: 'Medellin · Remote worldwide' },
          experience: { label: 'Experience', value: yearsOfExperience }
        }}
      />
    </div>
  </section>

  <PageSection>
    <SectionHeader
      eyebrow="The story"
      title="Engineering, leadership, and the work behind it."
    />

    <div class="space-y-8">
      <div class="max-w-2xl space-y-6 section-copy">
        <p>
          I'm Santiago Molina, a full-stack engineer and tech lead based in Medellín, Colombia.
          Over the last {yearsOfExperience} years I've shipped products across commerce, SaaS, gaming,
          and real estate — working across the entire stack from architecture and backend services to
          CI/CD pipelines and developer tooling.
        </p>

        <p>
          Right now my focus is on teams and systems: how to structure engineering organizations so they stay
          fast to ship, easy to maintain, and hard to break. I care deeply about developer experience — not as
          a buzzword, but as the measurable gap between a team that ships with confidence and one that ships
          with anxiety. Automation is usually how you close that gap.
        </p>

        <p>
          I've led cross-functional teams of up to 14 people spanning product, design, frontend, and backend.
          I believe the most valuable thing a tech lead does is reduce the number of decisions engineers
          have to make under pressure — through clear standards, good tooling, and systems that fail loudly
          instead of silently.
        </p>

        <p>
          Outside work I co-organize ReactJS Colombia, write about engineering workflows and DX, and find the
          intersection between good software and good products. When I'm not at a keyboard I'm probably reading,
          hiking, or watching something with a good score on Letterboxd.
        </p>
      </div>

      <div class="
        grid gap-3
        sm:grid-cols-3
      "
      >
        <MiniNote label="Experience">
          <p class="text-lg font-semibold text-ink">{yearsOfExperience} years</p>
        </MiniNote>
        <MiniNote label="Leadership">
          <p class="text-sm/7 text-ink-soft">Led teams of up to 14 across product, design, frontend, and backend.</p>
        </MiniNote>
        <MiniNote label="Focus today">
          <p class="text-sm/7 text-ink-soft">Automation, delivery clarity, and developer experience that compounds.</p>
        </MiniNote>
      </div>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      eyebrow="Companies & communities"
      title="Some of the teams and communities behind the work."
      description="A few of the products, companies, and communities behind the portfolio. The value is in the work itself, but context helps people read the case studies with the right level of trust."
    />

    <div class="space-y-6">
      <div class="
        grid gap-4
        sm:grid-cols-2
        lg:grid-cols-3
      "
      >
        {selectedOrganizations.map(({ context, label }) => (
          <MiniNote label={label} className="h-full">
            <p class="text-sm/7 text-ink-soft">{context}</p>
          </MiniNote>
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href="/portfolio/" showArrow>
          Read the case studies
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          Open LinkedIn
        </ButtonLink>
      </div>
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      eyebrow="Principles"
      title="What I believe about engineering."
      description="A few things that shape how I work, how I lead, and what I focus on."
    />

    <div class="
      grid gap-6
      sm:grid-cols-2
    "
    >
      {engineeringPrinciples.map(({ title, body }, index) => (
        <PrincipleCard
          index={index}
          title={title}
          body={body}
          featured={index === 0}
        />
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      eyebrow="Recommendations"
      title="What collaborators say about the work."
      description="A few direct quotes from colleagues, managers, and clients. The recurring patterns across them are summarised below."
    />

    <div class="space-y-10">
      <div
        class="
          grid gap-6
          sm:grid-cols-2
        "
        data-stagger="80"
      >
        {testimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }) => (
          <TestimonialCard
            quote={quote}
            authorName={name}
            role={role}
            relationship={relationship}
            avatarInitials={avatarInitials}
            avatarUrl={avatarUrl}
          />
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          See all LinkedIn recommendations
        </ButtonLink>
      </div>
    </div>
  </PageSection>
</PageLayout>
