---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'

import Prose from '@/components/Prose.astro'

import { getAllProjects } from '@/data/project'
import ProjectLayout from '@/layouts/Projects.astro'
import { collectionDateSortProjects } from '@/utils/date'

// If you're using an adaptor in SSR mode, getStaticPaths wont work -> https://docs.astro.build/en/guides/routing/#modifying-the-slug-example-for-ssr
export const getStaticPaths = (async () => {
  const projectsEntries = await getAllProjects()

  return projectsEntries.map(project => ({
    params: { slug: project.id },
    props: { project }
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { project } = Astro.props
const { Content } = await render(project);
const relatedProjects = (await getAllProjects())
  .filter(entry => entry.id !== project.id && entry.data.typesId === project.data.typesId)
  .sort(collectionDateSortProjects)
  .slice(0, 2)
---

<ProjectLayout project={project} relatedProjects={relatedProjects}>
  <Prose>
    <Content />
  </Prose>
</ProjectLayout>
