---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

import { render } from 'astro:content'

import Prose from '@/components/atoms/Prose.astro'
import ProjectLayout from '@/layouts/Projects.astro'

import { getCachedProjects, getRelatedProjects  } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'

// If you're using an adaptor in SSR mode, getStaticPaths wont work -> https://docs.astro.build/en/guides/routing/#modifying-the-slug-example-for-ssr
export const getStaticPaths = (async () => {
  const projectsEntries = await getCachedProjects()

  return projectsEntries.map(project => ({
    params: { slug: project.id },
    props: { project }
  }))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { project } = Astro.props
const { Content } = await render(project)

const relatedProjects = (await getRelatedProjects({
  currentProjectId: project.id,
  limit: 2,
  technologies: project.data.technologies,
  ...(project.data.typesId ? { typesId: project.data.typesId } : {})
}))
  .sort(collectionDateSortProjects)
---

<ProjectLayout project={project} relatedProjects={relatedProjects}>
  <Prose>
    <Content />
  </Prose>
</ProjectLayout>
