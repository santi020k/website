---
import ButtonLink from '../../components/atoms/ButtonLink.astro'
import Pill from '../../components/atoms/Pill.astro'
import ProjectCard from '../../components/molecules/ProjectCard.astro'
import SectionHeading from '../../components/molecules/SectionHeading.astro'
import StatCard from '../../components/molecules/StatCard.astro'
import { getAllProjects, getUniqueTechnologiesWithCount, groupProjectsByTypesId } from '../../data/project'
import { getAllTypes } from '../../data/types'
import PageLayout from '../../layouts/Base.astro'
import { siteConfig } from '../../site.config'
import { collectionDateSortProjects } from '../../utils/date'
import { getTechnologyPath } from '../../utils/links'

const allProjects = (await getAllProjects()).sort(collectionDateSortProjects)
const groupedProjects = groupProjectsByTypesId(allProjects)
const allTypes = (await getAllTypes()).sort((a, b) => {
  if (a.id === 'professional') return -1
  if (b.id === 'professional') return 1
  return 0
})
const technologies = getUniqueTechnologiesWithCount(allProjects).slice(0, 18)
const professionalCount = groupedProjects.professional?.length ?? 0
const personalCount = groupedProjects.personal?.length ?? 0

const meta = {
  description: 'Case studies from Santiago Molina across headless commerce, gaming, SaaS, real estate, community, and open-source work.',
  title: 'Portfolio'
}

const typePills = allTypes.map(type => (
  // eslint-disable-next-line @typescript-eslint/no-unsafe-return
  <Pill href={`#${type.id}`} label={type.data.title} tone="outline" />
))
---

<PageLayout meta={meta}>
  <section class="
    grid gap-6
    lg:grid-cols-[1.1fr_0.9fr]
  "
  >
    <div class="space-y-6">
      <SectionHeading
        description="A curated look at the work behind my resume: frontend architecture, product systems, and hands-on technical leadership across US and LATAM teams."
        eyebrow="Portfolio"
        level="h1"
        title="Case studies from real teams, products, and constraints."
      />
      <div class="flex flex-wrap gap-3">
        <ButtonLink href={siteConfig.contact.resume} newTab showArrow>
          Open resume
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          Message on LinkedIn
        </ButtonLink>
      </div>
      <div class="flex flex-wrap gap-2">
        {typePills}
      </div>
    </div>

    <div class="
      grid gap-4
      sm:grid-cols-3
      lg:grid-cols-1
    "
    >
      <StatCard description="Roles across commerce, gaming, real estate, martech, agencies, and SaaS." label="Professional" value={String(professionalCount)} />
      <StatCard description="Open-source and community work that sharpens how I build and lead." label="Personal" value={String(personalCount)} />
      <StatCard description="Recurring tools and platforms that show up across production systems." label="Technologies" value={String(technologies.length)} />
    </div>
  </section>

  <section class="space-y-14">
    {allTypes.map((type) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return
      <section class="space-y-8" id={type.id}>
        <SectionHeading
          description={type.data.description}
          eyebrow={type.id === 'professional' ? 'Client and product work' : 'Personal builds'}
          title={type.data.title}
        />
        <div class="
          grid gap-6
          lg:grid-cols-2
        "
        >
          {(groupedProjects[type.id] ?? []).map(project => (
            // eslint-disable-next-line @typescript-eslint/no-unsafe-return
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))}
  </section>

  <section class="space-y-8">
    <SectionHeading
      description="React and TypeScript sit at the center, but the stack widens to fit the product: testing, mobile, backend, DX, and delivery tooling."
      eyebrow="Technology map"
      linkHref="/technologies/"
      linkLabel="Browse the full stack index"
      title="The tools behind the work."
    />
    <div class="flex flex-wrap gap-3">
      {technologies.map(([technology, count]) => (
        // eslint-disable-next-line @typescript-eslint/no-unsafe-return
        <Pill href={getTechnologyPath(technology)} label={technology} tone="outline">
          <span class="text-xs text-ink-muted">{count}</span>
        </Pill>
      ))}
    </div>
  </section>
</PageLayout>
