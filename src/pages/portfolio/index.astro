---
import Badge from '@/components/Badge.astro'
import ProjectPreview from '@/components/projects/ProjectPreview.astro'

import { collectionDateSortProjects } from '@/utils/date'

import { getAllProjects, getUniqueTechnologies, groupProjectsByTypesId } from '@/data/project'
import { getAllTypes } from '@/data/types'
import PageLayout from '@/layouts/Base.astro'

const MAX_TAGS = 20
const allProjects = await getAllProjects()
const allTypes = await getAllTypes()
const allTypesReversed = [...allTypes].reverse()
const data = allProjects.sort(collectionDateSortProjects)
const uniqueTechnologies = getUniqueTechnologies(allProjects).slice(0, MAX_TAGS)

const meta = {
  title: 'Projects',
  description: 'Explore a collection of client and personal projects, showcasing my experience in web development, architecture, and design.'
}

const groupedByTypeId = groupProjectsByTypesId(data)
---

<PageLayout meta={meta}>
  <div class="flex flex-col gap-y-16">
    <section class="flex flex-col gap-y-4">
      <h1 class="font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Portfolio
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-200">
        Showcases projects I’ve worked on, from client work and open-source libraries to experiments.
        Each reflects a blend of technical depth, user-centric design, and a passion for solving real-world problems.
      </p>
      <p class="text-base text-zinc-700 dark:text-zinc-200">
        Looking for more? Check out my{' '}
        <a
          href="/pdf/cv.pdf"
          target="_blank"
          class="text-sky-700 transition-all duration-200 hover:text-sky-600 hover:underline dark:text-sky-400 dark:hover:text-sky-500"
        >
          CV/Resume
        </a>
      </p>
    </section>

    <section class="grid gap-8 sm:grid-cols-[1fr_auto]">
      <div aria-label="Projects project list" class="flex flex-col gap-y-16">
        <div x-data="{ activeTab: 0 }">
          <nav class="mb-4 inline-flex items-center space-x-1 overflow-x-auto rounded-xl bg-gray-500/5 p-1 text-sm text-gray-700 rtl:space-x-reverse dark:bg-gray-500/20 dark:text-gray-200">
            <div role="tablist" class="-mb-px flex items-stretch gap-2 text-slate-500">
              {allTypesReversed.map((type, index) => (
                <button :id={`tab-${index}`} role="tab" :aria-controls={`panel-${index}`} @click={`activeTab = ${index}`} :aria-selected={`activeTab === ${index}`} :class={`{ 'text-sky-700 shadow bg-white dark:text-white dark:bg-[#034463]': activeTab === ${index} }`} class="flex h-8 cursor-pointer items-center whitespace-nowrap rounded-lg px-5 font-medium text-gray-700 outline-none transition-all duration-300 hover:text-gray-900 focus:text-sky-700 focus:ring-2 focus:ring-inset focus:ring-white dark:text-gray-400 dark:hover:text-gray-300 dark:focus:text-white dark:focus:ring-sky-600" aria-selected="true">
                  <span>{type.data.title}</span>
                </button>
              ))}
            </div>
          </nav>
          <div>
            {allTypesReversed.map((type, index) => (
              <div x-show={`activeTab === ${index}`} id={`panel-${index}`} role="tabpanel" :aria-labelledby={`tab-${index}`} x-cloak>
                <article id={type.data.id} class="flex flex-col gap-y-4">
                  <p class="text-zinc-600 dark:text-zinc-200">
                    {type.data.description}
                  </p>
                  <ul class="flex flex-col gap-y-8 text-start">
                    {groupedByTypeId[type.data.id]?.map(project => (
                      <li class="m-0 flex flex-col gap-4">
                        <ProjectPreview project={project} />
                      </li>
                    ))}
                  </ul>
                </article>
              </div>
            ))}
          </div>
        </div>
      </div>
      {
        !!uniqueTechnologies.length && (
          <aside class="flex flex-col gap-y-4 md:min-w-56 md:max-w-56 md:basis-56">
            <h1 class="flex text-base">
              Technologies
            </h1>
            <div class="flex flex-col gap-y-4">
              <ul class="flex flex-wrap gap-2">
                {uniqueTechnologies.map(technology => (
                  <li>
                    <a aria-label={`View all posts with the technology: ${technology}`} href={`/technologies/${technology}`}>
                      <Badge variant="muted" title={technology} />
                    </a>
                  </li>
                ))}
              </ul>

              <div class="ms-auto flex h-6 items-center sm:text-end md:block">
                <a
                  aria-label="View all projects categories"
                  class="text-sm font-medium"
                  href="/technologies/"
                >
                  View all →
                </a>
              </div>
            </div>
          </aside>
        )
      }
    </section>
  </div>
</PageLayout>
