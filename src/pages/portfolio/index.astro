---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import ProjectPreviewCard from '@/components/molecules/ProjectPreviewCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects } from '@/utils/date'

const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const selectedWork = allProjects.filter(project => project.data.typesId === 'professional').slice(0, 3)
const selectedProjects = allProjects.filter(project => project.data.typesId === 'personal').slice(0, 3)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Selected client systems, product work, open-source tools, and community projects by Santiago Molina.',
    title: 'Selected Portfolio — Santiago Molina'
  }}
>
  <PageHero
    description="A curated set of client systems, product work, and independent builds. Each case study connects decisions to delivery context and outcomes."
    eyebrow="Selected portfolio"
    gradientText="with the context."
    metaItems={['Architecture', 'Developer experience', 'Technical leadership']}
    title="Shipped work"
  >
    <ButtonLink href="#selected-work" showArrow>
      Explore selected work
    </ButtonLink>
    <ButtonLink href="/work/" showArrow variant="secondary">
      Full work history
    </ButtonLink>
    <ButtonLink href="/projects/" showArrow variant="secondary">
      All side projects
    </ButtonLink>
  </PageHero>

  <PageSection>
    <SectionHeader
      description="Recent professional work where architecture, delivery systems, and technical leadership had to move together."
      eyebrow="Client and product work"
      linkHref="/work/"
      linkLabel="Browse full work history"
      title="Selected professional work."
    />
    <div
      class="
        grid scroll-mt-28 gap-6
        md:grid-cols-2
        xl:grid-cols-3
      "
      data-stagger="60"
      id="selected-work"
    >
      {selectedWork.map(project => (
        <ProjectPreviewCard project={project} />
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="Open-source, community, and self-directed work that turns curiosity into reusable tools and practices."
      eyebrow="Independent builds"
      linkHref="/projects/"
      linkLabel="Browse all side projects"
      title="Selected personal projects."
    />
    <div
      class="
        grid gap-6
        md:grid-cols-2
        xl:grid-cols-3
      "
      data-stagger="60"
    >
      {selectedProjects.map(project => (
        <ProjectPreviewCard accentTone="accent" project={project} />
      ))}
    </div>
  </PageSection>
</PageLayout>
