---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'

import PageLayout from '@/layouts/Base.astro'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Engineering portfolio of Santiago Molina — browse client and product work or personal projects and open source.',
    title: 'Portfolio — Santiago Molina'
  }}
>
  <PageHero
    description="The portfolio is split into two sections — client and product work, and personal open-source projects."
    eyebrow="Portfolio"
    gradientText="and side projects."
    title="Work experience"
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/projects/" showArrow variant="secondary">
      Browse projects
    </ButtonLink>
  </PageHero>

  <section
    class="
      grid gap-6
      sm:grid-cols-2
    "
    data-stagger="80"
  >
    <div class="panel-card flex flex-col gap-6 p-7">
      {/* Specular top-edge highlight */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 z-10 h-px"
        style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.3) 40%, hsl(0 0% 100% / 0.45) 50%, hsl(0 0% 100% / 0.3) 60%, transparent 92%);"
      />
      <div class="space-y-2">
        <p class="section-label">Work Experience</p>
        <h2 class="text-xl font-semibold text-ink">
          Client &amp; Product Work
        </h2>
        <p class="text-sm/7 text-ink-soft">
          Roles across commerce, gaming, SaaS, real estate, martech, and agencies — focused on architecture and technical leadership.
        </p>
      </div>
      <div class="mt-auto">
        <ButtonLink href="/work/" showArrow variant="secondary">
          Browse work
        </ButtonLink>
      </div>
    </div>

    <div class="panel-card flex flex-col gap-6 p-7">
      {/* Specular top-edge highlight */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 z-10 h-px"
        style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.3) 40%, hsl(0 0% 100% / 0.45) 50%, hsl(0 0% 100% / 0.3) 60%, transparent 92%);"
      />
      <div class="space-y-2">
        <p class="section-label">Side Projects</p>
        <h2 class="text-xl font-semibold text-ink">
          Open Source &amp; Personal Builds
        </h2>
        <p class="text-sm/7 text-ink-soft">
          Open-source tools, community work, and self-directed experiments built to learn, share, and sharpen craft.
        </p>
      </div>
      <div class="mt-auto">
        <ButtonLink href="/projects/" showArrow variant="secondary">
          Browse projects
        </ButtonLink>
      </div>
    </div>
  </section>
</PageLayout>
