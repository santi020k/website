---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import ProjectCard from '@/components/molecules/ProjectCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import StatCard from '@/components/molecules/StatCard.astro'

import { getAllProjects, getUniqueTechnologiesWithCount, groupProjectsByTypesId } from '@/data/project'
import { getAllTypes } from '@/data/types'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'
import { collectionDateSortProjects } from '@/utils/date'
import { getTechnologyPath } from '@/utils/links'

const allProjects = (await getAllProjects()).sort(collectionDateSortProjects)
const groupedProjects = groupProjectsByTypesId(allProjects)
const allTypes = (await getAllTypes()).sort((a, b) => (a.id === 'professional' ? -1 : b.id === 'professional' ? 1 : 0))
const technologies = getUniqueTechnologiesWithCount(allProjects).slice(0, 18)

const professionalCount = groupedProjects.professional?.length ?? 0
const personalCount = groupedProjects.personal?.length ?? 0

const meta = {
  description: 'Selected projects across client work, leadership roles, experiments, and developer tooling from Santiago Molina.',
  title: 'Portfolio'
}
---

<PageLayout meta={meta}>
  <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="space-y-6">
    <SectionHeading
      description="A curated view of the products, platforms, and developer tools I have built or led. The goal is not volume. It is to show range, technical judgment, and the kind of work I enjoy doing best."
      eyebrow="Portfolio"
      level="h1"
      title="Case studies with product context, not just screenshots."
    />
      <div class="flex flex-wrap gap-3">
        <ButtonLink href={siteConfig.contact.resume} newTab showArrow>
          Open resume
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
          Contact on LinkedIn
        </ButtonLink>
      </div>
      <div class="flex flex-wrap gap-2">
        {allTypes.map(type => (
          <Pill href={`#${type.id}`} label={type.data.title} tone="outline" />
        ))}
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
      <StatCard description="Projects delivered with companies, product teams, and clients." label="Professional" value={String(professionalCount)} />
      <StatCard description="Open-source, community, and self-directed projects." label="Personal" value={String(personalCount)} />
      <StatCard description="Technologies used across the portfolio." label="Technologies" value={String(technologies.length)} />
    </div>
  </section>

  <section class="space-y-14">
    {allTypes.map(type => (
      <section class="space-y-8" id={type.id}>
        <SectionHeading
          description={type.data.description}
          eyebrow={type.id === 'professional' ? 'Client and product work' : 'Personal builds'}
          title={type.data.title}
        />
        <div class="grid gap-6 lg:grid-cols-2">
          {(groupedProjects[type.id] ?? []).map(project => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))}
  </section>

  <section class="space-y-8">
    <SectionHeading
      description="A quick look at the technologies that show up most often across the project work."
      eyebrow="Technology map"
      linkHref="/technologies/"
      linkLabel="Browse the full stack index"
      title="Recurring tools, frameworks, and platforms."
    />
    <div class="flex flex-wrap gap-3">
      {technologies.map(([technology, count]) => (
        <Pill href={getTechnologyPath(technology)} label={technology} tone="outline">
          <span class="text-xs text-ink-muted">{count}</span>
        </Pill>
      ))}
    </div>
  </section>
</PageLayout>
