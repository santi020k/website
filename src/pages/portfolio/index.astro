---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PortfolioCollectionHeading from '@/components/molecules/PortfolioCollectionHeading.astro'
import PortfolioProjectSpotlight from '@/components/molecules/PortfolioProjectSpotlight.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionRelevanceSortProjects } from '@/utils/date'

import { Link, RevealGroup } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text
const allProjects = (await getCachedProjects()).sort(collectionRelevanceSortProjects)
const selectedWork = allProjects.filter(project => project.data.typesId === 'professional').slice(0, 3)
const selectedProjects = allProjects.filter(project => project.data.typesId === 'personal').slice(0, 4)
const caseStudyCount = selectedWork.length + selectedProjects.length

const collectionPaths = [
  {
    count: selectedWork.length,
    description: t('Commerce, esports, and sports media.'),
    id: 'selected-work',
    label: t('Client work')
  },
  {
    count: selectedProjects.length,
    description: t('Shared foundations and personal products.'),
    id: 'independent-builds',
    label: t('Independent builds')
  }
].filter(collection => collection.count > 0)

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: t('Portfolio'), url: localizePath('/portfolio/', locale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: t('Selected client systems, product work, open-source tools, and technical experiments by Santiago Molina.'),
    title: t('Selected Portfolio — Santiago Molina')
  }}
>
  <PageHero
    compact
    description={t('The architecture, tradeoffs, and outcomes behind client systems and independent products. Choose where to start.')}
    eyebrow={`${t('Selected portfolio')} / ${caseStudyCount} ${caseStudyCount === 1 ? t('case study') : t('case studies')}`}
    gradientText={t('Built to hold up.')}
    title={t('Work that shipped.')}
  >
    <div slot="after-description" data-portfolio-paths-container>
      <nav aria-label={t('Choose a case study collection')} data-portfolio-paths>
        {collectionPaths.map(collection => (
          <Link data-portfolio-path href={`#${collection.id}`} variant="inherit">
            <span>
              <span data-portfolio-path-title>
                <span>{t(collection.label)}</span>{' '}
                <span data-portfolio-path-count>{collection.count}<span class="
                  sr-only
                "
                                                                  > {collection.count === 1 ? t('case study') : t('case studies')}</span></span>
              </span>
              <span data-portfolio-path-description>{t(collection.description)}</span>
            </span>
            <ArrowExchange direction="down" />
          </Link>
        ))}
      </nav>
      <div data-portfolio-paths-footer>
        <p>{t('Problem → decisions → outcome')}</p>
        <Link data-portfolio-history-link href={localizePath('/work/', locale)} variant="inherit">
          View work history <ArrowExchange direction="right" />
        </Link>
      </div>
    </div>
  </PageHero>

  <section
    aria-labelledby="selected-work-heading"
    class="section-container-wide scroll-mt-28 space-y-8 page-section-space"
    data-portfolio-section
    id="selected-work"
    tabindex="-1"
  >
    <PortfolioCollectionHeading
      count={selectedWork.length}
      description={t('Professional work where architecture, delivery systems, and technical leadership had to move together.')}
      emphasis={t('real pressure.')}
      eyebrow={t('Client and product work')}
      headingId="selected-work-heading"
      href={localizePath('/work/', locale)}
      linkLabel={t('Full work history')}
      title={t('Systems built under')}
    />

    <RevealGroup
      class="space-y-6"
      stagger={60}
      threshold={0}
    >
      {selectedWork[0] && (
        <PortfolioProjectSpotlight featured imagePriority project={selectedWork[0]} />
      )}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {selectedWork.slice(1).map(project => (
          <PortfolioProjectSpotlight project={project} />
        ))}
      </div>
    </RevealGroup>
  </section>

  <section
    aria-labelledby="independent-builds-heading"
    class="section-container-wide scroll-mt-28 space-y-8 page-section-space"
    data-portfolio-section
    id="independent-builds"
    tabindex="-1"
  >
    <PortfolioCollectionHeading
      count={selectedProjects.length}
      description={t('Open-source and self-directed work where curiosity becomes something other people can use.')}
      emphasis={t('useful tools.')}
      eyebrow={t('Independent builds')}
      headingId="independent-builds-heading"
      href={localizePath('/projects/', locale)}
      linkLabel={t('All independent projects')}
      title={t('Ideas turned into')}
    />

    <RevealGroup
      class="space-y-6"
      stagger={60}
      threshold={0}
    >
      {selectedProjects[0] && (
        <PortfolioProjectSpotlight featured project={selectedProjects[0]} />
      )}
      <div class="
        grid gap-6
        md:grid-cols-2
        xl:grid-cols-3
      "
      >
        {selectedProjects.slice(1).map(project => (
          <PortfolioProjectSpotlight project={project} />
        ))}
      </div>
    </RevealGroup>
  </section>
</PageLayout>

<style>
  [data-portfolio-paths-container] { container: portfolio-paths / inline-size; }
  [data-portfolio-paths] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  [data-portfolio-paths] :global([data-portfolio-path]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.25rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  [data-portfolio-paths] :global([data-portfolio-path]:hover) { color: hsl(var(--brand)); }
  [data-portfolio-path-title] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.04em;
  }
  [data-portfolio-path-count] {
    color: hsl(var(--brand));
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: normal;
  }
  :global(:root[data-theme='dark']) [data-portfolio-path-count] { color: hsl(var(--accent)); }
  :global(:root[data-theme='dark']) [data-portfolio-paths] :global([data-portfolio-path]:hover) { color: hsl(var(--accent)); }
  [data-portfolio-path-description] {
    display: block;
    margin-top: 0.625rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  [data-portfolio-paths-footer] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  [data-portfolio-paths-footer] :global([data-portfolio-history-link]) {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    color: inherit;
  }
  @container portfolio-paths (width < 36rem) {
    [data-portfolio-paths] { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-portfolio-paths] :global([data-portfolio-path] + [data-portfolio-path]) { border-top: 0; }
  }
</style>
