---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PortfolioProjectSpotlight from '@/components/molecules/PortfolioProjectSpotlight.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionRelevanceSortProjects } from '@/utils/date'

import { Icon, Link, RevealGroup } from '@santi020k/lumen-astro'

const allProjects = (await getCachedProjects()).sort(collectionRelevanceSortProjects)
const selectedWork = allProjects.filter(project => project.data.typesId === 'professional').slice(0, 3)
const selectedProjects = allProjects.filter(project => project.data.typesId === 'personal').slice(0, 4)
const caseStudyCount = selectedWork.length + selectedProjects.length

const collectionPaths = [
  {
    count: selectedWork.length,
    description: 'Commerce, esports, and sports media.',
    id: 'selected-work',
    label: 'Client work'
  },
  {
    count: selectedProjects.length,
    description: 'Shared foundations and personal products.',
    id: 'independent-builds',
    label: 'Independent builds'
  }
].filter(collection => collection.count > 0)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: 'Selected client systems, product work, open-source tools, and technical experiments by Santiago Molina.',
    title: 'Selected Portfolio — Santiago Molina'
  }}
>
  <PageHero
    compact
    description="The architecture, tradeoffs, and outcomes behind client systems and independent products. Choose where to start."
    eyebrow={`Selected portfolio / ${caseStudyCount} ${caseStudyCount === 1 ? 'case study' : 'case studies'}`}
    gradientText="Built to hold up."
    title="Work that shipped."
  >
    <div slot="after-description" data-portfolio-paths-container>
      <nav aria-label="Choose a case study collection" data-portfolio-paths>
        {collectionPaths.map(collection => (
          <Link data-portfolio-path href={`#${collection.id}`} variant="inherit">
            <span>
              <span data-portfolio-path-title>
                <span>{collection.label}</span>{' '}
                <span data-portfolio-path-count>{collection.count}<span class="
                  sr-only
                "
                                                                  > {collection.count === 1 ? 'case study' : 'case studies'}</span></span>
              </span>
              <span data-portfolio-path-description>{collection.description}</span>
            </span>
            <Icon name="arrow-down" />
          </Link>
        ))}
      </nav>
      <div data-portfolio-paths-footer>
        <p>Problem → decisions → outcome</p>
        <Link data-portfolio-history-link href="/work/" variant="inherit">
          View work history <Icon name="arrow-right" />
        </Link>
      </div>
    </div>
  </PageHero>

  <section
    aria-labelledby="selected-work-heading"
    class="section-container-wide scroll-mt-28 space-y-8 page-section-space"
    data-portfolio-section
    id="selected-work"
    tabindex="-1"
  >
    <div
      class="
        grid gap-6 border-b border-line/50 pb-7
        lg:grid-cols-[minmax(0,0.9fr)_minmax(22rem,1.1fr)] lg:items-end
        lg:gap-12
      "
    >
      <div class="space-y-4">
        <Eyebrow label="Client and product work" tone="brand" />
        <h2
class="
  max-w-2xl text-3xl font-semibold tracking-[-0.04em]
  sm:text-4xl
"
        id="selected-work-heading"
        >
          Systems built under real pressure.
        </h2>
      </div>
      <div class="
        flex flex-col items-start gap-5
        sm:flex-row sm:items-end sm:justify-between
      "
      >
        <p class="
          max-w-xl text-sm/7 text-ink-soft
          sm:text-base/7
        "
        >
          Professional work where architecture, delivery systems, and technical leadership had to move together.
        </p>
        <ButtonLink className="shrink-0" href="/work/" showArrow variant="inline">
          Browse work
        </ButtonLink>
      </div>
    </div>

    <RevealGroup
      class="space-y-6"
      stagger={60}
      threshold={0}
    >
      {selectedWork[0] && (
        <PortfolioProjectSpotlight featured imagePriority project={selectedWork[0]} />
      )}
      <div class="
        grid gap-6
        md:grid-cols-2
      "
      >
        {selectedWork.slice(1).map(project => (
          <PortfolioProjectSpotlight project={project} />
        ))}
      </div>
    </RevealGroup>
  </section>

  <section
    aria-labelledby="independent-builds-heading"
    class="section-container-wide scroll-mt-28 space-y-8 page-section-space"
    data-portfolio-section
    id="independent-builds"
    tabindex="-1"
  >
    <div
      class="
        grid gap-6 border-b border-line/50 pb-7
        lg:grid-cols-[minmax(0,0.9fr)_minmax(22rem,1.1fr)] lg:items-end
        lg:gap-12
      "
    >
      <div class="space-y-4">
        <Eyebrow label="Independent builds" tone="brand" />
        <h2
class="
  max-w-2xl text-3xl font-semibold tracking-[-0.04em]
  sm:text-4xl
"
        id="independent-builds-heading"
        >
          Ideas turned into useful tools.
        </h2>
      </div>
      <div class="
        flex flex-col items-start gap-5
        sm:flex-row sm:items-end sm:justify-between
      "
      >
        <p class="
          max-w-xl text-sm/7 text-ink-soft
          sm:text-base/7
        "
        >
          Open-source and self-directed work where curiosity becomes something other people can use.
        </p>
        <ButtonLink className="shrink-0" href="/projects/" showArrow variant="inline">
          Browse projects
        </ButtonLink>
      </div>
    </div>

    <RevealGroup
      class="space-y-6"
      stagger={60}
      threshold={0}
    >
      {selectedProjects[0] && (
        <PortfolioProjectSpotlight featured project={selectedProjects[0]} />
      )}
      <div class="
        grid gap-6
        md:grid-cols-2
        xl:grid-cols-3
      "
      >
        {selectedProjects.slice(1).map(project => (
          <PortfolioProjectSpotlight project={project} />
        ))}
      </div>
    </RevealGroup>
  </section>
</PageLayout>

<style>
  [data-portfolio-paths-container] { container: portfolio-paths / inline-size; }
  [data-portfolio-paths] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  [data-portfolio-paths] :global([data-portfolio-path]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.25rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  [data-portfolio-paths] :global([data-portfolio-path]:hover) { color: hsl(var(--brand)); }
  [data-portfolio-path-title] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.04em;
  }
  [data-portfolio-path-count] {
    color: hsl(var(--brand));
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: normal;
  }
  :global(:root[data-theme='dark']) [data-portfolio-path-count] { color: hsl(var(--accent)); }
  :global(:root[data-theme='dark']) [data-portfolio-paths] :global([data-portfolio-path]:hover) { color: hsl(var(--accent)); }
  [data-portfolio-path-description] {
    display: block;
    margin-top: 0.625rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  [data-portfolio-paths-footer] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  [data-portfolio-paths-footer] :global([data-portfolio-history-link]) {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    color: inherit;
  }
  @container portfolio-paths (width < 36rem) {
    [data-portfolio-paths] { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-portfolio-paths] :global([data-portfolio-path] + [data-portfolio-path]) { border-top: 0; }
  }
</style>
