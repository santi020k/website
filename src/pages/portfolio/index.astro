---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]

const sections = [
  {
    buttonLabel: 'Browse work',
    description: 'Roles across commerce, gaming, SaaS, real estate, martech, and agencies — focused on architecture and technical leadership.',
    href: '/work/',
    label: 'Work Experience',
    meta: 'Client systems · leadership · delivery',
    title: 'Client & Product Work'
  },
  {
    buttonLabel: 'Browse projects',
    description: 'Open-source tools, community work, and self-directed experiments built to learn, share, and sharpen craft.',
    href: '/projects/',
    label: 'Side Projects',
    meta: 'Open source · community · experiments',
    title: 'Open Source & Personal Builds'
  }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Engineering portfolio of Santiago Molina — browse client and product work or personal projects and open source.',
    title: 'Portfolio — Santiago Molina'
  }}
>
  <PageHero
    description="A focused map of shipped product work and the personal builds that sharpen the craft behind it."
    eyebrow="Portfolio"
    gradientText="and side projects."
    metaItems={['Architecture', 'Developer experience', 'Technical leadership']}
    title="Work experience"
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/projects/" showArrow variant="secondary">
      Browse projects
    </ButtonLink>
  </PageHero>

  <section class="page-card-grid" data-stagger="70">
    {sections.map(({ buttonLabel, description, href, label, meta, title }, index) => (
      <Card class="flex h-full flex-col gap-6 p-7" variant="interactive">
        <div class="flex items-start justify-between gap-4">
          <p class="section-label text-brand">{label}</p>
          <span class="text-sm font-semibold text-ink-muted">
            {String(index + 1).padStart(2, '0')}
          </span>
        </div>
        <div class="space-y-2">
          <h2 class="text-xl font-semibold text-ink">{title}</h2>
          <p class="text-sm/7 text-ink-soft">{description}</p>
        </div>
        <p class="mt-auto border-t border-line/35 pt-4 text-xs/6 font-semibold tracking-[0.14em] text-ink-muted uppercase">
          {meta}
        </p>
        <div class="mt-auto">
          <ButtonLink href={href} showArrow variant="secondary">
            {buttonLabel}
          </ButtonLink>
        </div>
      </Card>
    ))}
  </section>
</PageLayout>
