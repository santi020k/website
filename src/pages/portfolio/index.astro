---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]

const sections = [
  {
    buttonLabel: 'Browse work',
    description: 'Roles across commerce, gaming, SaaS, real estate, martech, and agencies — focused on architecture and technical leadership.',
    href: '/work/',
    label: 'Work Experience',
    title: 'Client & Product Work'
  },
  {
    buttonLabel: 'Browse projects',
    description: 'Open-source tools, community work, and self-directed experiments built to learn, share, and sharpen craft.',
    href: '/projects/',
    label: 'Side Projects',
    title: 'Open Source & Personal Builds'
  }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Engineering portfolio of Santiago Molina — browse client and product work or personal projects and open source.',
    title: 'Portfolio — Santiago Molina'
  }}
>
  <PageHero
    description="The portfolio is split into two sections — client and product work, and personal open-source projects."
    eyebrow="Portfolio"
    gradientText="and side projects."
    title="Work experience"
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/projects/" showArrow variant="secondary">
      Browse projects
    </ButtonLink>
  </PageHero>

  <section
    class="
      section-container-wide grid gap-6
      sm:grid-cols-2
    "
    data-stagger="70"
  >
    {sections.map(({ buttonLabel, description, href, label, title }) => (
      <Card class="flex flex-col gap-6 p-7">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 z-10 h-px"
          style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.3) 40%, hsl(0 0% 100% / 0.45) 50%, hsl(0 0% 100% / 0.3) 60%, transparent 92%);"
        />
        <div class="space-y-2">
          <p class="section-label">{label}</p>
          <h2 class="text-xl font-semibold text-ink">{title}</h2>
          <p class="text-sm/7 text-ink-soft">{description}</p>
        </div>
        <div class="mt-auto">
          <ButtonLink href={href} showArrow variant="secondary">
            {buttonLabel}
          </ButtonLink>
        </div>
      </Card>
    ))}
  </section>
</PageLayout>
