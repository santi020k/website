---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import PageLayout from '@/layouts/Base.astro'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Engineering portfolio of Santiago Molina — browse client and product work or personal projects and open source.',
    title: 'Portfolio — Santiago Molina'
  }}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Portfolio"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Work experience
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">and side projects.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          The portfolio is split into two sections — client and product work, and personal open-source projects.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/work/" showArrow>
            Browse work
          </ButtonLink>
          <ButtonLink href="/projects/" showArrow variant="secondary">
            Browse projects
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section
    class="
      grid gap-6
      sm:grid-cols-2
    "
    data-animate
  >
    <div class="section-shell-subtle flex flex-col gap-4">
      <div class="space-y-2">
        <p class="section-label">Work Experience</p>
        <h2 class="text-xl font-semibold text-ink">
          Client &amp; Product Work
        </h2>
        <p class="text-sm/6 text-ink-soft">
          Roles across commerce, gaming, SaaS, real estate, martech, and agencies
          — with a focus on architecture and technical leadership.
        </p>
      </div>
      <div class="mt-auto">
        <ButtonLink href="/work/" showArrow variant="secondary">
          Browse work
        </ButtonLink>
      </div>
    </div>

    <div class="section-shell-subtle flex flex-col gap-4">
      <div class="space-y-2">
        <p class="section-label">Side Projects</p>
        <h2 class="text-xl font-semibold text-ink">
          Open Source &amp; Personal Builds
        </h2>
        <p class="text-sm/6 text-ink-soft">
          Open-source tools, community work, and self-directed experiments built
          to learn, share, and sharpen craft beyond client work.
        </p>
      </div>
      <div class="mt-auto">
        <ButtonLink href="/projects/" showArrow variant="secondary">
          Browse projects
        </ButtonLink>
      </div>
    </div>
  </section>
</PageLayout>
