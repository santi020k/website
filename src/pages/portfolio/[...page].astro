---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import Badge from '@/components/Badge.astro'
import Pagination from '@/components/Paginator.astro'
import ProjectPreview from '@/components/projects/ProjectPreview.astro'

import { capitalizeFirstLetter } from '@/utils/capitalize-first-letter'
import { collectionDateSortProjects } from '@/utils/date'

import { getAllProjects, getUniqueTags, groupProjectsByTypesId } from '@/data/project'
import PageLayout from '@/layouts/Base.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const MAX_POSTS_PER_PAGE = 5
  const MAX_TAGS = 20
  const allProjects = await getAllProjects()
  const uniqueTags = getUniqueTags(allProjects).slice(0, MAX_TAGS)
  return paginate(allProjects.sort(collectionDateSortProjects), {
    pageSize: MAX_POSTS_PER_PAGE,
    props: { uniqueTags }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'project'>>
  allTypes: CollectionEntry<'types'>[]
  uniqueTags: string[]
}

const { page, uniqueTags } = Astro.props

const meta = {
  title: 'Projects',
  description: 'Explore a collection of client and personal projects, showcasing my experience in web development, architecture, and design.'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Previous Page',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Next Page →',
      url: page.url.next
    }
  })
}

const groupedByTypeId = groupProjectsByTypesId(page.data)
---

<PageLayout meta={meta}>
  <section class="mx-auto mb-8 max-w-4xl">
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Portfolio
    </h1>
    <p class="mb-6 text-lg text-zinc-600 dark:text-zinc-400">
      Showcases projects I’ve worked on, from client work and open-source libraries to experiments.
      Each reflects a blend of technical depth, user-centric design, and a passion for solving real-world problems.
    </p>
    <p class="mb-8 text-base text-zinc-500 dark:text-zinc-400">
      Looking for more? Check out my{' '}
      <a
        href="/pdf/cv.pdf"
        target="_blank"
        class="text-sky-500 transition-all duration-200 hover:text-sky-600 hover:underline dark:text-sky-400 dark:hover:text-sky-500"
      >
        CV/Resume
      </a>
    </p>
  </section>

  <div class="grid gap-y-8 sm:grid-cols-[1fr_auto] sm:gap-x-8">
    <section aria-label="Projects project list" class="grow">
      {
        Object.entries(groupedByTypeId).map(([key, projects]) => (
          <article id={key}>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{capitalizeFirstLetter(key)} Projects</h1>
            <ul class="mb-8 mt-4 space-y-8 text-start">
              {projects?.map(project => (
                <li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
                  <ProjectPreview project={project} />
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>
    {
      !!uniqueTags.length && (
        <aside class="md:min-w-56 md:max-w-56 md:basis-56">
          <h4 class="mb-4 flex gap-2">
            Tags
            {/*
            <Icon aria-hidden="true" class="mb-1 h-6 w-6" focusable="false" name="hugeicons:tags" />
            */}
          </h4>
          <ul class="flex flex-wrap gap-2">
            {uniqueTags.map(tag => (
              <li>
                <a aria-label={`View all posts with the tag: ${tag}`} href={`/tags/${tag}`}>
                  <Badge variant="muted" title={tag} />
                </a>
              </li>
            ))}

            <span class="ms-auto inline-flex h-6 items-center text-base sm:text-end">
              <a
                aria-label="View all projects categories"
                class="font-medium"
                href="/tags/"
              >
                View all →
              </a>
            </span>
          </ul>
        </aside>
      )
    }
  </div>
  <Pagination {...paginationProps} />
</PageLayout>
