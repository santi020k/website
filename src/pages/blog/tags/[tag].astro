---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import PageLayout from '@/layouts/Base.astro'
import { getCachedPosts } from '@/utils/content'
import { getAllTags } from '@/utils/tags'

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCachedPosts()
  const allTags = getAllTags(posts)

  return allTags.map(([tag]) => ({
    params: { tag: encodeURIComponent(tag) },
    props: {
      posts: posts.filter(post => post.data.tags.includes(tag)),
      tag,
      totalTopics: allTags.length
    }
  }))
}

interface Props {
  posts: CollectionEntry<'post'>[]
  tag: string
  totalTopics: number
}

const { posts, tag, totalTopics } = Astro.props
const postCount = posts.length

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: 'Topics', url: '/blog/tags/' },
  { name: `#${tag}`, url: Astro.url.pathname }
]
---

<PageLayout meta={{
  breadcrumbs,
  description: `Posts tagged ${tag} across architecture, automation, developer experience, and engineering workflow.`,
  title: `${tag} Posts`
}}
>
  <section
    class="
      grid gap-10
      lg:grid-cols-[1.05fr_0.95fr]
    "
    data-animate
  >
    <div class="space-y-6">
      <SectionHeading
        description={`Posts connected by the ${tag} topic.`}
        eyebrow="Topic archive"
        level="h1"
        title={`#${tag}`}
      />

      <div class="flex flex-wrap gap-2">
        <Pill label={`${postCount} ${postCount === 1 ? 'post' : 'posts'}`} tone="brand" />
        <Pill label={`${totalTopics} total topics`} tone="outline" />
      </div>

      <div class="section-actions">
        <ButtonLink href="/blog/tags/" showArrow variant="secondary">
          Browse all topics
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="ghost">
          Back to blog
        </ButtonLink>
      </div>
    </div>
  </section>

  <section class="
    grid gap-6
    lg:grid-cols-2
  "
  >
    {posts.map(post => (
      <PostCard post={post} />
    ))}
  </section>
</PageLayout>
