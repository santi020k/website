---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import Pill from '@/components/atoms/Pill.astro'
import PillCount from '@/components/atoms/PillCount.astro'
import Pagination from '@/components/molecules/Pagination.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import TagFilter from '@/components/molecules/TagFilter.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getAllTags } from '@/utils/tags'

import PageLayout from '@/layouts/Base.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCachedPosts()
  const allTags = getAllTags(posts)

  return allTags.flatMap(([tag]) => {
    const tagPosts = posts.filter(p => p.data.tags.includes(tag))

    return paginate(tagPosts, {
      params: { tag: encodeURIComponent(tag) },
      pageSize: 9,
      props: { tag, totalTopics: allTags.length }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'post'>>
  tag: string
  totalTopics: number
}

const { page, tag, totalTopics } = Astro.props
const allPosts = await getCachedPosts()
const allTags = getAllTags(allPosts)
const topTags = allTags.slice(0, 8)
const relatedTags = topTags.filter(([t]) => t !== tag).slice(0, 6)
const postCount = page.total
const isFirstPage = page.currentPage === 1
const featuredPost = isFirstPage ? page.data[0] : null
const gridPosts = isFirstPage ? page.data.slice(1) : page.data
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: 'Topics', url: '/blog/tags/' },
  { name: `#${tag}`, url: getTagPath(tag) },
  ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}`, url: Astro.url.pathname }] : [])
]
---

<PageLayout meta={{
  breadcrumbs,
  description: `Posts tagged ${tag} across architecture, automation, developer experience, and engineering workflow.`,
  title: isFirstPage ?
    `${tag} Posts` :
    `${tag} Posts · Page ${page.currentPage} of ${page.lastPage}`
}}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Topic archive"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          #{tag}
          <span class="
            block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
            pb-4 text-transparent
          "
          >All posts.
          </span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Filtered to {postCount} {postCount === 1 ? 'post' : 'posts'} connected by the #{tag} topic.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/blog/tags/" showArrow variant="secondary">
            Browse all topics
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Back to blog
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <StatsGrid>
    <StatCard description="Posts connected by this topic in the archive." label="Posts" value={String(postCount)} />
    <StatCard description="Distinct topics across the full writing archive." label="Total topics" value={String(totalTopics)} />
    {page.lastPage > 1 && <StatCard description="Pagination for this topic archive." label="Page" value={`${page.currentPage} / ${page.lastPage}`} />}
  </StatsGrid>

  {relatedTags.length > 0 && (
    <section class="flex flex-wrap items-center gap-3 pt-2">
      <p class="shrink-0 section-label">Related topics</p>
      <div class="flex flex-wrap gap-2">
        {relatedTags.map(([t, count]) => (
          <Pill href={getTagPath(t)} label={t} showHash tone="outline">
            <PillCount count={count} />
          </Pill>
        ))}
      </div>
    </section>
  )}

  <PageSection>
    <SectionHeader
      description={isFirstPage ?
        `Start with the latest post tagged #${tag}, then browse the rest.` :
        `Browse posts tagged #${tag} across the archive.`}
      eyebrow={isFirstPage ? 'Latest' : `Page ${page.currentPage} of ${page.lastPage}`}
      title={`Posts tagged #${tag}`}
    />

    <div class="space-y-6">
      {featuredPost && <PostCard featured post={featuredPost} />}

      {featuredPost && (
        <div class="flex items-center gap-4">
          <div class="h-px flex-1 bg-line/50" />
          <span class="section-label">Filter posts</span>
          <div class="h-px flex-1 bg-line/50" />
        </div>
      )}

      <TagFilter activeTag={tag} tags={topTags} />

      {gridPosts.length > 0 ?
        (
          <div class="post-grid" data-stagger>
            {gridPosts.map(post => (
              <PostCard post={post} />
            ))}
          </div>
        ) :
        (
          <div class="flex flex-col items-center gap-4 py-16 text-center">
            <p class="text-lg text-ink-soft">
              No posts found for <strong class="text-ink">#{tag}</strong>.
            </p>
            <ButtonLink href="/blog/" showArrow variant="secondary">
              Back to all posts
            </ButtonLink>
          </div>
        )}

      <Pagination baseUrl={getTagPath(tag)} page={page} />
    </div>
  </PageSection>
</PageLayout>
