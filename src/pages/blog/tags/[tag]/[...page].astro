---
import type { GetStaticPaths, Page } from 'astro'

import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import Pagination from '@/components/molecules/Pagination.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import TagFilter from '@/components/molecules/TagFilter.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { BLOG_ARCHIVE_PAGE_SIZE } from '@/utils/pagination'
import { getAllTags, getBlogBrowseTags, getBlogTopicLabel } from '@/utils/tags'

import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCachedPosts()
  const allTags = getAllTags(posts)

  return allTags.flatMap(([tag]) => {
    const tagPosts = posts.filter(p => p.data.tags.includes(tag))

    return paginate(tagPosts, {
      params: { tag: encodeURIComponent(tag) },
      pageSize: BLOG_ARCHIVE_PAGE_SIZE,
      props: { tag, totalTopics: allTags.length }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'post'>>
  tag: string
  totalTopics: number
}

const { page, tag, totalTopics } = Astro.props
const allPosts = await getCachedPosts()
const allTags = getAllTags(allPosts)
const topTags = getBlogBrowseTags(allTags)
const postCount = page.total
const isFirstPage = page.currentPage === 1
const topicLabel = getBlogTopicLabel(tag)
const archiveDescription = t(`Articles, guides, and personal notes about ${topicLabel}.`)

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: t('Topics'), url: localizePath('/blog/tags/', locale) },
  { name: topicLabel, url: getTagPath(tag) },
  ...(page.currentPage > 1 ? [{ name: t(`Page ${page.currentPage}`), url: Astro.url.pathname }] : [])
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: isFirstPage ?
      archiveDescription :
      t(`${archiveDescription} Page ${page.currentPage} of ${page.lastPage}.`),
    title: isFirstPage ?
      t(`${topicLabel} posts`) :
      t(`${topicLabel} posts · Page ${page.currentPage} of ${page.lastPage}`)
  }}
>
  <PageHero
    compact={!isFirstPage}
    description={locale === 'es' ? `${postCount} ${postCount === 1 ? 'artículo' : 'artículos'} sobre ${topicLabel}.` : `${postCount} ${postCount === 1 ? 'post' : 'posts'} about ${topicLabel}.`}
    eyebrow={t('Topic archive')}
    gradientText={t('All posts.')}
    metaItems={[t('Filtered archive'), t('Browse by topic'), t('Latest first')]}
    title={topicLabel}
  >
    <ButtonLink href={localizePath('/blog/tags/', locale)} showArrow variant="secondary">{t('Browse all topics')}</ButtonLink>
    <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('Back to blog')}</ButtonLink>
  </PageHero>

  <section
    class="section-container-wide page-section-space"
  >
    <SectionHeader
      description={isFirstPage ?
        t('Start with the latest post, then browse the rest.') :
        t(`Browse earlier posts about ${topicLabel}.`)}
      eyebrow={isFirstPage ? t('Latest') : t(`Page ${page.currentPage} of ${page.lastPage}`)}
      title={t(`Posts about ${topicLabel}`)}
    />

    <div class="
      mt-10 space-y-8
      sm:mt-12
    "
    >
      <TagFilter activeTag={tag} tags={topTags} totalTopics={totalTopics} />

      {page.data.length > 0 ?
        (
          <PostsGallery posts={page.data} />
        ) :
        (
          <div class="flex flex-col items-center gap-4 py-16 text-center">
            <p class="text-lg text-ink-soft">
              {t('No posts found for')} <strong class="text-ink">{topicLabel}</strong>.
            </p>
            <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('Back to all posts')}</ButtonLink>
          </div>
        )}

      <Pagination baseUrl={localizePath(getTagPath(tag), locale)} page={page} />
    </div>
  </section>

  {isFirstPage && (
    <StatsGrid columns={page.lastPage > 1 ? 3 : 2}>
      <StatCard description={t('Posts connected by this topic in the archive.')} icon="file-text" label={t('Posts')} value={postCount} />
      <StatCard description={t('Distinct topics across the full writing archive.')} icon="hash" label={t('Total topics')} value={totalTopics} />
      {page.lastPage > 1 && <StatCard description={t('Pagination for this topic archive.')} icon="list-ordered" label={t('Page')} value={`${page.currentPage} / ${page.lastPage}`} />}
    </StatsGrid>
  )}
</PageLayout>
