---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getAllTags, getBlogTopicLabel } from '@/utils/tags'

import { Card, Icon, Input, Link, MotionGroup, Toggle } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const posts = await getCachedPosts()
const allTags = getAllTags(posts)
const topTag = allTags[0]

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: t('collection.topics'), url: localizePath('/blog/tags/', locale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: t('collection.browsePostsAboutSoftwareReadingGaming'),
    title: t('collection.blogTopics')
  }}
>
  <section aria-labelledby="topic-index-heading" class="section-container-wide" data-topic-catalog>
    <header data-topic-opening>
      <div data-topic-opening-topline>
        <Link data-text-link data-topic-return href={localizePath('/blog/', locale)} variant="inherit">
          <ArrowExchange class="size-4 shrink-0" direction="left" />
          <span data-text-link-label>{t('collection.backToBlog')}</span>
        </Link>
        <p class="section-label" data-topic-total>{allTags.length} {allTags.length === 1 ? t('collection.topic') : t('collection.topics7')}</p>
      </div>
      <h1 id="topic-index-heading">{t('collection.browseByTopic7')}</h1>
      <p data-topic-opening-description>
        {locale === 'es' ? 'Encuentra artículos relacionados sobre software, lectura, videojuegos y descubrimientos cotidianos.' : 'Find related writing on software, reading, gaming, and everyday discoveries.'}
      </p>
      <Link data-text-link data-topic-series href={localizePath('/blog/series/', locale)} variant="inherit">
        <span data-text-link-label>{locale === 'es' ? '¿Prefieres un recorrido de lectura?' : 'Prefer a connected reading path?'}</span>
        <ArrowExchange class="size-4 shrink-0" direction="right" />
      </Link>
    </header>

    <div class="space-y-4" data-topic-index>
      <Card data-topic-search-folio variant="unstyled">
        <div data-topic-search-field>
          <label for="tag-filter"><Icon class="size-4.5 shrink-0" name="search" /><span>{t('collection.findATopic')}</span></label>
          <Input
            aria-describedby="tag-filter-status"
            autocomplete="off"
            data-topic-search-input
            id="tag-filter"
            placeholder={t('collection.searchTopics')}
            spellcheck="false"
            type="search"
          />
        </div>
        <div data-topic-search-footer>
          <div data-topic-search-sort>
            <span class="section-label">{t('collection.sort')}</span>
            <div aria-label={t('collection.sortTopics')} data-topic-search-options role="group">
              <Toggle controlled data-sort-btn="count" pressed>{t('collection.byCount')}</Toggle>
              <Toggle controlled data-sort-btn="alpha">A → Z</Toggle>
            </div>
          </div>
          <p aria-live="polite" id="tag-filter-status">{locale === 'es' ? `Mostrando los ${allTags.length} temas.` : `Showing all ${allTags.length} topics.`}</p>
        </div>
      </Card>

      <MotionGroup
        class="
          grid gap-4
          sm:card-grid-2
          lg:card-grid-3
        "
        id="tags-list"
      >
        {allTags.map(([tag, count]) => (
          <span data-count={String(count)} data-label={tag} data-name={getBlogTopicLabel(tag)} data-topic-entry data-ui-motion-key={tag}>
            <Link data-topic-card href={localizePath(getTagPath(tag), locale)} variant="inherit">
              <span data-topic-name>{getBlogTopicLabel(tag)}</span>
              <span data-topic-count>{count} {count === 1 ? t('collection.post') : t('collection.posts7')}</span>
              <ArrowExchange class="size-4.5" data-topic-arrow direction="right" />
            </Link>
          </span>
        ))}

      </MotionGroup>
      <section
        aria-labelledby="topic-empty-heading"
        data-tags-empty
        hidden
      >
        <span data-topic-empty-icon><Icon class="size-5.5" name="search-x" /></span>
        <h2 id="topic-empty-heading">{t('collection.noTopicsMatchThatSearch')}</h2>
      </section>
    </div>

    <script>
      const setupTopicIndex = () => {
        const isSpanish = document.documentElement.lang.startsWith('es')
        const singular = isSpanish ? 'tema encontrado' : 'topic found'
        const plural = isSpanish ? 'temas encontrados' : 'topics found'
        const allLabel = isSpanish ? 'Mostrando los' : 'Showing all'
        const topicLabel = isSpanish ? 'temas' : 'topics'
        const list = document.getElementById('tags-list')
        const input = document.querySelector<HTMLInputElement>('#tag-filter')
        const status = document.getElementById('tag-filter-status')
        const empty = document.querySelector<HTMLElement>('[data-tags-empty]')
        const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort-btn]')

        if (!list || !input || !status || !empty || list.dataset.filterReady === 'true') return

        list.dataset.filterReady = 'true'

        const items = [...list.children].filter((item): item is HTMLElement => item instanceof HTMLElement)

        const updateFilter = () => {
          // Preserve slug queries while also matching the readable topic names.
          const query = input.value.trim().replace(/^#/u, '').trim().toLocaleLowerCase()
          let visibleCount = 0

          items.forEach(item => {
            const matches = !query || [item.dataset.label, item.dataset.name]
              .some(label => label?.toLocaleLowerCase().includes(query))

            item.hidden = !matches

            if (matches) visibleCount += 1
          })

          empty.hidden = visibleCount > 0

          const resultLabel = visibleCount === 1 ? singular : plural

          status.textContent = query ? `${visibleCount} ${resultLabel}.` : `${allLabel} ${items.length} ${topicLabel}.`
        }

        const setActive = (active: HTMLButtonElement) => {
          queueMicrotask(() => {
            sortButtons.forEach(button => {
              const isActive = button === active

              button.setAttribute('aria-pressed', String(isActive))
            })
          })
        }

        sortButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const sort = btn.getAttribute('data-sort-btn')

            items.sort((a, b) => sort === 'alpha' ?
              (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '') :
              Number(b.dataset.count) - Number(a.dataset.count) ||
              (a.dataset.label ?? '').localeCompare(b.dataset.label ?? ''))

            items.forEach(item => list.appendChild(item))

            setActive(btn)
          })
        })

        input.addEventListener('input', updateFilter)
      }

      document.addEventListener('astro:page-load', setupTopicIndex)
    </script>
  </section>

  <StatsGrid columns={topTag ? 3 : 2}>
    <StatCard
      description={t('collection.findASubjectThatFitsWhat')}
      icon="hash"
      label={t('collection.topicsToExplore')}
      source={{ href: '#topic-index-heading', label: t('collection.returnToTopicSearch') }}
      value={allTags.length}
    />
    <StatCard
      description={t('collection.readAcrossTopicsWithTheLatest')}
      icon="file-text"
      label={t('collection.postsInTheArchive')}
      source={{ href: localizePath('/blog/#posts', locale), label: t('collection.browseAllWriting') }}
      value={posts.length}
    />
    {topTag && (
      <StatCard
        description={t('topic.mostExplored', { topic: getBlogTopicLabel(topTag[0]) })}
        icon="trending-up"
        label={t('collection.mostWrittenAbout')}
        source={{ href: localizePath(getTagPath(topTag[0]), locale), label: getBlogTopicLabel(topTag[0]) }}
        suffix={topTag[1] === 1 ? t('collection.post') : t('collection.posts7')}
        value={topTag[1]}
      />
    )}
  </StatsGrid>
</PageLayout>

<style>
  [data-topic-opening] { container: topic-opening / inline-size; margin-bottom: 1.75rem; }
  [data-topic-opening-topline] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .75rem 1.5rem;
    padding-bottom: .875rem;
    border-bottom: 1px solid hsl(var(--line));
  }
  :global([data-topic-return]), :global([data-topic-series]) {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    min-height: 2.75rem;
    max-width: 100%;
    font-size: .8125rem;
    line-height: 1.7;
  }
  :global([data-topic-return]) { color: hsl(var(--ink-soft)); }
  [data-topic-total] { margin: 0; }
  [data-topic-opening] h1 {
    max-width: 22ch;
    margin: 2rem 0 0;
    color: hsl(var(--ink));
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.055em;
    overflow-wrap: anywhere;
  }
  [data-topic-opening-description] {
    max-width: 50ch;
    margin: 1.5rem 0 0;
    color: hsl(var(--ink-soft));
    font-size: .9375rem;
    line-height: 1.85;
  }
  :global([data-topic-series]) { margin-top: .875rem; color: hsl(var(--brand)); }
  :global([data-theme='dark'] [data-topic-series]) { color: hsl(var(--accent)); }
  @container topic-opening (width < 18rem) {
    [data-topic-opening] h1 { font-size: 2rem; }
  }

  [data-topic-entry] { container: topic-card / inline-size; min-width: 0; }
  :global(a[data-topic-card]) {
    --topic-card-accent: hsl(var(--brand));
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.125rem;
    align-content: center;
    align-items: center;
    gap: .625rem 1.375rem;
    min-width: 0;
    min-height: 7.25rem;
    height: 100%;
    padding: 1.375rem;
    border: 1px solid hsl(var(--line));
    border-radius: .4375rem 1.5rem 1.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    font-weight: 400;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
  }
  :global([data-theme='dark'] a[data-topic-card]) { --topic-card-accent: hsl(var(--accent)); }
  [data-topic-name] {
    grid-column: 1;
    min-width: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -.035em;
    overflow-wrap: anywhere;
  }
  [data-topic-count] { grid-column: 1; color: hsl(var(--ink-soft)); font-size: .75rem; line-height: 1.8; font-variant-numeric: tabular-nums; }
  :global([data-topic-arrow]) { grid-column: 2; grid-row: 1 / span 2; color: var(--topic-card-accent); }
  :global(a[data-topic-card]:is(:hover, :focus-visible)) {
    border-color: var(--topic-card-accent);
    background: color-mix(in srgb, hsl(var(--brand-soft)) 25%, hsl(var(--surface)));
    box-shadow: inset 0 0 0 1px var(--topic-card-accent);
  }
  :global(a[data-topic-card]:is(:hover, :focus-visible)) [data-topic-name] {
    color: var(--topic-card-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .25rem;
  }
  :global(a[data-topic-card]:focus-visible) { outline: 2px solid var(--topic-card-accent); outline-offset: 4px; }
  @container topic-card (width < 20rem) {
    :global(a[data-topic-card]) { gap: .625rem 1rem; min-height: 6.75rem; padding: 1.25rem; }
    [data-topic-name] { font-size: 1.125rem; }
  }
  @container topic-card (width < 14rem) {
    :global(a[data-topic-card]) { gap: .5rem .75rem; padding: .75rem; }
    [data-topic-name] { font-size: 1rem; }
  }
  @container topic-card (width < 11rem) {
    :global(a[data-topic-card]) { padding: .5rem; }
    :global([data-topic-arrow]) { grid-row: 2; }
    [data-topic-name] { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(a[data-topic-card]) { transition: none; }
  }

  [data-topic-index] { container: topic-index / inline-size; }
  :global(.remaining-pages [data-topic-search-folio][data-slot='card']) {
    --topic-search-accent: hsl(var(--brand));

    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.625rem .4375rem 1.625rem .4375rem;
    background: hsl(var(--surface));
    box-shadow: .375rem .375rem 0 hsl(var(--surface-muted));
  }
  :global(:root[data-theme='dark'] .remaining-pages [data-topic-search-folio]) {
    --topic-search-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }
  [data-topic-search-field] { min-width: 0; padding: 1.5rem 1.5rem 1.125rem; }
  [data-topic-search-field] label {
    display: flex;
    align-items: center;
    gap: .625rem;
    color: var(--topic-search-accent);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1.6;
  }
  :global([data-topic-search-input]) {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 3.5rem;
    margin-top: .625rem;
    padding: .625rem 0;
    border: 0;
    border-bottom: 1px solid hsl(var(--line));
    border-radius: 0;
    background: hsl(var(--surface));
    box-shadow: none;
    color: hsl(var(--ink));
    font: 400 1.75rem/1.35 var(--font-sans);
    letter-spacing: -.035em;
  }
  :global([data-topic-search-input]::placeholder) { color: hsl(var(--ink-soft)); opacity: 1; }
  :global([data-topic-search-input]:focus-visible) {
    border-bottom-color: var(--topic-search-accent);
    outline: 2px solid var(--topic-search-accent);
    outline-offset: 4px;
    box-shadow: none;
  }
  [data-topic-search-footer] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .875rem 1.5rem;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0 0 1.5625rem .375rem;
    background: hsl(var(--surface-muted));
  }
  [data-topic-search-sort] {
    display: flex;
    min-width: 0;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem;
  }
  [data-topic-search-options] {
    display: flex;
    min-width: 0;
    max-width: 100%;
    flex-wrap: wrap;
    border: 1px solid hsl(var(--line));
    border-radius: .375rem .875rem .375rem .875rem;
    background: hsl(var(--surface));
  }
  :global([data-topic-search-options] [data-sort-btn]) {
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    padding: .5625rem .875rem;
    border: 0;
    border-radius: .3125rem 0 0 .8125rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    font: 500 .875rem/1.45 var(--font-sans);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  :global([data-topic-search-options] [data-sort-btn] + [data-sort-btn]) {
    border-left: 1px solid hsl(var(--line));
    border-radius: 0 .8125rem .3125rem 0;
  }
  :global([data-topic-search-options] [data-sort-btn]:hover) {
    background: hsl(var(--surface-muted));
    color: var(--topic-search-accent);
  }
  :global([data-topic-search-options] [data-sort-btn][aria-pressed='true']) {
    background: hsl(var(--ink));
    color: hsl(var(--surface));
  }
  :global([data-topic-search-options] [data-sort-btn]:focus-visible) {
    position: relative;
    outline: 2px solid var(--topic-search-accent);
    outline-offset: 3px;
  }
  #tag-filter-status {
    min-width: 0;
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: .75rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  @container topic-index (width < 26rem) {
    [data-topic-search-field] { padding: 1.25rem 1rem 1rem; }
    [data-topic-search-footer] { padding: .75rem 1rem; }
    :global([data-topic-search-input]) { font-size: 1.4375rem; }
  }
  @container topic-index (width < 17rem) {
    [data-topic-search-options] { gap: .375rem; border: 0; background: transparent; }
    :global([data-topic-search-options] [data-sort-btn]),
    :global([data-topic-search-options] [data-sort-btn] + [data-sort-btn]) {
      border: 1px solid hsl(var(--line));
      border-radius: .3125rem .75rem .3125rem .75rem;
    }
    [data-topic-search-sort] { gap: .5rem; }
  }
  [data-tags-empty] {
    padding-block: 1.75rem;
    border-block: 1px solid hsl(var(--line));
  }
  [data-tags-empty]:not([hidden]) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
  }
  [data-topic-empty-icon] {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .75rem .1875rem .75rem .1875rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }
  :global([data-theme='dark']) [data-topic-empty-icon] { color: hsl(var(--accent)); }
  [data-tags-empty] h2 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.035em;
    hyphens: none;
  }
  @container topic-index (width < 32rem) {
    [data-tags-empty] { padding-block: 1.5rem; }
    [data-tags-empty]:not([hidden]) { gap: 1rem; }
    [data-tags-empty] h2 { font-size: 1.375rem; }
  }
  @container topic-index (width < 18rem) {
    [data-tags-empty]:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
