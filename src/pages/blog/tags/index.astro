---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getAllTags } from '@/utils/tags'

import PageLayout from '@/layouts/Base.astro'

const posts = await getCachedPosts()
const allTags = getAllTags(posts)
const topTagCount = allTags[0]?.[1] ?? 0

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: 'Topics', url: '/blog/tags/' }
]
---

<PageLayout meta={{
  breadcrumbs,
  description: 'Browse the blog archive by recurring topics and tags across architecture, automation, DX, and engineering workflow.',
  title: 'Blog Topics'
}}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Topics"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Browse by topic.
          <span class="
            block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
            pb-4 text-transparent
          "
          >Find related writing fast.
          </span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Browse the archive by recurring topics so related posts are easier to find without hunting through the full feed.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Back to blog
          </ButtonLink>
          <ButtonLink href="/blog/series/" showArrow variant="secondary">
            Browse series
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <StatsGrid>
    <StatCard description="Distinct recurring topics across the current writing archive." label="Topics" value={String(allTags.length)} />
    <StatCard description="Published posts that can be reached through these topic pages." label="Posts" value={String(posts.length)} />
    <StatCard description="How often the most-used topic currently appears in the archive." label="Top topic" value={`${topTagCount}x`} />
  </StatsGrid>

  <PageSection class="lg:grid-cols-1!">
    <SectionHeader
      description="Each topic opens a filtered archive page with the related posts."
      eyebrow="All topics"
      title="Recurring themes across the archive."
    />

    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <span class="section-label">Sort</span>
        <div class="flex gap-2">
          <button class="pagination-btn pagination-btn--active" data-sort-btn="count" type="button">By count</button>
          <button class="pagination-btn" data-sort-btn="alpha" type="button">A → Z</button>
        </div>
      </div>

      <div
        class="
          grid gap-4
          sm:grid-cols-2
          lg:grid-cols-3
        "
        id="tags-list"
      >
        {allTags.map(([tag, count], i) => {
          const pct = allTags[0]?.[1] ? Math.round((count / allTags[0][1]) * 100) : 0

          return (
            <span data-count={String(count)} data-label={tag}>
              <a
                class="
                  tag-glass-card group block rounded-[1.35rem]
                  focus-visible:ring-2 focus-visible:ring-brand/50
                  focus-visible:outline-none
                "
                href={getTagPath(tag)}
                style={`--card-accent: var(--brand); animation-delay: ${i * 30}ms`}
              >
                <article
                  class="
                    tag-glass-inner relative flex h-full flex-col gap-4
                    overflow-hidden rounded-[1.35rem] p-6
                  "
                >
                  {/* Specular top-edge highlight */}
                  <div
                    aria-hidden="true"
                    class="
                      pointer-events-none absolute inset-x-0 top-0 z-20 h-px
                    "
                    style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.35) 30%, hsl(0 0% 100% / 0.5) 50%, hsl(0 0% 100% / 0.35) 70%, transparent 92%);"
                  />
                  {/* Accent tint on hover */}
                  <div
                    aria-hidden="true"
                    class="
                      tag-glass-tint pointer-events-none absolute inset-0
                      opacity-0
                    "
                    style="background: radial-gradient(ellipse 80% 60% at 70% 20%, color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent), transparent 65%);"
                  />

                  <div class="
                    relative z-10 flex items-start justify-between gap-2
                  "
                  >
                    <span class="
                      text-base font-semibold tracking-tight text-ink
                      transition-colors duration-200
                      group-hover:text-brand
                    "
                    >
                      #{tag}
                    </span>
                    <span
                      class="
                        shrink-0 rounded-full border px-2 py-0.5 text-xs
                        font-semibold tabular-nums
                      "
                      style="background: hsl(var(--brand-soft) / 0.55); color: hsl(var(--brand)); border-color: color-mix(in srgb, hsl(var(--brand)) 30%, transparent);"
                    >
                      {count}
                    </span>
                  </div>

                  <div class="relative z-10 mt-auto">
                    <div
                      class="h-1 w-full overflow-hidden rounded-full"
                      style="background: hsl(var(--line) / 0.35);"
                    >
                      <div
                        class="
                          h-full rounded-full transition-all duration-500
                          motion-reduce:transition-none
                        "
                        style={`width: ${pct}%; background: linear-gradient(90deg, hsl(var(--brand) / 0.55), hsl(var(--accent) / 0.75));`}
                      />
                    </div>
                    <p class="mt-2 text-xs text-ink-muted">
                      {count} {count === 1 ? 'post' : 'posts'}
                    </p>
                  </div>
                </article>
              </a>
            </span>
          )
        })}
      </div>
    </div>

    <script>
      const list = document.getElementById('tags-list')!
      const btns = document.querySelectorAll<HTMLButtonElement>('[data-sort-btn]')

      function setActive(active: HTMLButtonElement) {
        btns.forEach(b => b.classList.toggle('pagination-btn--active', b === active))
      }

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const sort = btn.getAttribute('data-sort-btn')
          const items = [...list.children] as HTMLElement[]

          items.sort((a, b) =>
            sort === 'alpha'
              ? (a.dataset.label ?? '').localeCompare(b.dataset.label ?? '')
              : Number(b.dataset.count) - Number(a.dataset.count)
          )

          items.forEach(el => list.appendChild(el))
          setActive(btn)
        })
      })
    </script>

    <style>
      .tag-glass-inner {
        background: linear-gradient(
          160deg,
          hsl(var(--surface) / 0.82),
          hsl(var(--surface-muted) / 0.62)
        );
        border: 1px solid hsl(var(--line) / 0.42);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow:
          0 8px 24px hsl(230 30% 8% / 0.04),
          0 3px 8px hsl(230 30% 8% / 0.025),
          inset 0 1px 0 hsl(0 0% 100% / 0.1);
      }

      @media (prefers-reduced-motion: no-preference) {
        .tag-glass-card {
          transition:
            transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.3s ease;
        }

        .tag-glass-card:hover {
          transform: translateY(-4px);
        }

        .tag-glass-card:hover .tag-glass-inner {
          border-color: color-mix(in srgb, hsl(var(--brand)) 28%, hsl(var(--line) / 0.42));
          box-shadow:
            inset 0 1px 0 hsl(0 0% 100% / 0.14),
            0 0 0 1px color-mix(in srgb, hsl(var(--brand)) 16%, transparent),
            0 16px 40px hsl(230 30% 8% / 0.1),
            0 6px 16px color-mix(in srgb, hsl(var(--brand)) 14%, transparent);
        }

        /* Shimmer sweep */
        .tag-glass-inner::after {
          content: '';
          position: absolute;
          top: 0;
          bottom: 0;
          left: -65%;
          width: 35%;
          background: linear-gradient(
            90deg,
            transparent,
            hsl(0 0% 100% / 0.04) 40%,
            hsl(0 0% 100% / 0.07) 50%,
            hsl(0 0% 100% / 0.04) 60%,
            transparent
          );
          transform: skewX(-10deg);
          z-index: 9;
          pointer-events: none;
        }

        @keyframes tag-shimmer {
          from { left: -65%; }
          to   { left: 130%; }
        }

        .tag-glass-card:hover .tag-glass-inner::after {
          animation: tag-shimmer 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        .tag-glass-tint {
          transition: opacity 0.4s ease;
        }

        .tag-glass-card:hover .tag-glass-tint {
          opacity: 1;
        }
      }
    </style>
  </PageSection>
</PageLayout>
