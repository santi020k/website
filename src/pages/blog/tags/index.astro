---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getAllTags } from '@/utils/tags'

import { Card, Icon, Input, Link, MotionGroup, Toggle } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text
const posts = await getCachedPosts()
const allTags = getAllTags(posts)
const topTagCount = allTags[0]?.[1] ?? 0

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: t('Topics'), url: localizePath('/blog/tags/', locale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: t('Browse posts about software, reading, gaming, and everyday discoveries by topic.'),
    title: t('Blog Topics')
  }}
>
  <PageHero
    description={t('Browse the archive by recurring topics so related posts are easier to find without hunting through the full feed.')}
    eyebrow={t('Topics')}
    gradientText={t('Find related writing fast.')}
    metaItems={[t('Architecture'), t('Automation'), t('Developer experience')]}
    title={t('Browse by topic.')}
  >
    <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('Back to blog')}</ButtonLink>
    <ButtonLink href={localizePath('/blog/series/', locale)} showArrow variant="secondary">{t('Browse series')}</ButtonLink>
  </PageHero>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('Each topic opens a filtered archive page with the related posts.')}
      eyebrow={t('All topics')}
      title={t('Recurring themes across the archive.')}
    />

    <div class="space-y-4" data-topic-index>
      <Card data-topic-search-folio variant="unstyled">
        <div data-topic-search-field>
          <label for="tag-filter"><Icon class="size-4.5 shrink-0" name="search" /><span>{t('Find a topic')}</span></label>
          <Input
            aria-describedby="tag-filter-status"
            autocomplete="off"
            data-topic-search-input
            id="tag-filter"
            placeholder={t('Search topics…')}
            spellcheck="false"
            type="search"
          />
        </div>
        <div data-topic-search-footer>
          <div data-topic-search-sort>
            <span class="section-label">{t('Sort')}</span>
            <div aria-label={t('Sort topics')} data-topic-search-options role="group">
              <Toggle controlled data-sort-btn="count" pressed>{t('By count')}</Toggle>
              <Toggle controlled data-sort-btn="alpha">A → Z</Toggle>
            </div>
          </div>
          <p aria-live="polite" id="tag-filter-status">{locale === 'es' ? `Mostrando los ${allTags.length} temas.` : `Showing all ${allTags.length} topics.`}</p>
        </div>
      </Card>

      <MotionGroup
        class="
          grid gap-4
          sm:card-grid-2
          lg:card-grid-3
        "
        id="tags-list"
      >
        {allTags.map(([tag, count]) => {
          const pct = allTags[0]?.[1] ? Math.round((count / allTags[0][1]) * 100) : 0

          return (
            <span data-count={String(count)} data-label={tag} data-ui-motion-key={tag}>
              <Link
                class="
                  group block h-full rounded-[1.35rem] font-normal text-inherit
                  no-underline
                  focus-visible:ring-2 focus-visible:ring-brand/50
                  focus-visible:outline-hidden
                "
                href={localizePath(getTagPath(tag), locale)}
              >
                <Card
                  class="
                    relative flex h-full flex-col gap-5 rounded-[1.35rem] p-5
                    sm:px-6 sm:py-5.5
                  "
                  data-topic-card
                  variant="default"
                >
                  <div class="
                    flex flex-wrap items-baseline justify-between gap-x-4
                    gap-y-2
                  "
                  >
                    <span class="
                      max-w-full min-w-0 text-base font-medium tracking-tight
                      text-ink transition-colors duration-200
                      group-hover:text-brand
                      motion-reduce:transition-none
                    "
                    >
                      #{tag}
                    </span>
                    <span
                      class="
                        shrink-0 rounded-full border border-brand/20
                        bg-brand-soft/60 px-2 text-xs font-medium
                        whitespace-nowrap text-ink tabular-nums
                      "
                    >
                      {count} {count === 1 ? t('post') : t('posts')}
                    </span>
                  </div>

                  <div
                    aria-hidden="true"
                    class="
                      mt-auto h-0.75 w-full overflow-hidden rounded-full
                      bg-line/35
                    "
                  >
                    <div
                      class="topic-meter-fill"
                      style={`width: ${pct}%;`}
                    />
                  </div>
                </Card>
              </Link>
            </span>
          )
        })}
      </MotionGroup>
      <section
        aria-labelledby="topic-empty-heading"
        data-tags-empty
        hidden
      >
        <span data-topic-empty-icon><Icon class="size-5.5" name="search-x" /></span>
        <h3 id="topic-empty-heading">{t('No topics match that search.')}</h3>
      </section>
    </div>

    <script>
      const setupTopicIndex = () => {
        const isSpanish = document.documentElement.lang.startsWith('es')
        const singular = isSpanish ? 'tema encontrado' : 'topic found'
        const plural = isSpanish ? 'temas encontrados' : 'topics found'
        const allLabel = isSpanish ? 'Mostrando los' : 'Showing all'
        const topicLabel = isSpanish ? 'temas' : 'topics'
        const list = document.getElementById('tags-list')
        const input = document.querySelector<HTMLInputElement>('#tag-filter')
        const status = document.getElementById('tag-filter-status')
        const empty = document.querySelector<HTMLElement>('[data-tags-empty]')
        const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort-btn]')

        if (!list || !input || !status || !empty || list.dataset.filterReady === 'true') return

        list.dataset.filterReady = 'true'

        const items = [...list.children].filter((item): item is HTMLElement => item instanceof HTMLElement)

        const updateFilter = () => {
          // Visible labels render as #tag, so accept one leading # before matching data-label.
          const query = input.value.trim().replace(/^#/u, '').trim().toLocaleLowerCase()
          let visibleCount = 0

          items.forEach(item => {
            const matches = !query || (item.dataset.label ?? '').toLocaleLowerCase().includes(query)

            item.hidden = !matches

            if (matches) visibleCount += 1
          })

          empty.hidden = visibleCount > 0

          const resultLabel = visibleCount === 1 ? singular : plural

          status.textContent = query ? `${visibleCount} ${resultLabel}.` : `${allLabel} ${items.length} ${topicLabel}.`
        }

        const setActive = (active: HTMLButtonElement) => {
          queueMicrotask(() => {
            sortButtons.forEach(button => {
              const isActive = button === active

              button.setAttribute('aria-pressed', String(isActive))
            })
          })
        }

        sortButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const sort = btn.getAttribute('data-sort-btn')

            items.sort((a, b) => sort === 'alpha' ?
              (a.dataset.label ?? '').localeCompare(b.dataset.label ?? '') :
              Number(b.dataset.count) - Number(a.dataset.count))

            items.forEach(item => list.appendChild(item))

            setActive(btn)
          })
        })

        input.addEventListener('input', updateFilter)
      }

      document.addEventListener('astro:page-load', setupTopicIndex)
    </script>
  </PageSection>

  <StatsGrid columns={3}>
    <StatCard description={t('Distinct recurring topics across the current writing archive.')} icon="hash" label={t('Topics')} value={allTags.length} />
    <StatCard description={t('Published posts that can be reached through these topic pages.')} icon="file-text" label={t('Posts')} value={posts.length} />
    <StatCard description={t('How often the most-used topic currently appears in the archive.')} icon="trending-up" label={t('Top topic')} suffix="x" value={topTagCount} />
  </StatsGrid>
</PageLayout>

<style>
  [data-topic-index] { container: topic-index / inline-size; }
  :global(.remaining-pages [data-topic-search-folio][data-slot='card']) {
    --topic-search-accent: hsl(var(--brand));

    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.625rem .4375rem 1.625rem .4375rem;
    background: hsl(var(--surface));
    box-shadow: .375rem .375rem 0 hsl(var(--surface-muted));
  }
  :global(:root[data-theme='dark'] .remaining-pages [data-topic-search-folio]) {
    --topic-search-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }
  [data-topic-search-field] { min-width: 0; padding: 1.5rem 1.5rem 1.125rem; }
  [data-topic-search-field] label {
    display: flex;
    align-items: center;
    gap: .625rem;
    color: var(--topic-search-accent);
    font-size: .8125rem;
    font-weight: 500;
    line-height: 1.6;
  }
  :global([data-topic-search-input]) {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 3.5rem;
    margin-top: .625rem;
    padding: .625rem 0;
    border: 0;
    border-bottom: 1px solid hsl(var(--line));
    border-radius: 0;
    background: hsl(var(--surface));
    box-shadow: none;
    color: hsl(var(--ink));
    font: 400 1.75rem/1.35 var(--font-sans);
    letter-spacing: -.035em;
  }
  :global([data-topic-search-input]::placeholder) { color: hsl(var(--ink-soft)); opacity: 1; }
  :global([data-topic-search-input]:focus-visible) {
    border-bottom-color: var(--topic-search-accent);
    outline: 2px solid var(--topic-search-accent);
    outline-offset: 4px;
    box-shadow: none;
  }
  [data-topic-search-footer] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .875rem 1.5rem;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0 0 1.5625rem .375rem;
    background: hsl(var(--surface-muted));
  }
  [data-topic-search-sort] {
    display: flex;
    min-width: 0;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem;
  }
  [data-topic-search-options] {
    display: flex;
    min-width: 0;
    max-width: 100%;
    flex-wrap: wrap;
    border: 1px solid hsl(var(--line));
    border-radius: .375rem .875rem .375rem .875rem;
    background: hsl(var(--surface));
  }
  :global([data-topic-search-options] [data-sort-btn]) {
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    padding: .5625rem .875rem;
    border: 0;
    border-radius: .3125rem 0 0 .8125rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink-soft));
    font: 500 .875rem/1.45 var(--font-sans);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  :global([data-topic-search-options] [data-sort-btn] + [data-sort-btn]) {
    border-left: 1px solid hsl(var(--line));
    border-radius: 0 .8125rem .3125rem 0;
  }
  :global([data-topic-search-options] [data-sort-btn]:hover) {
    background: hsl(var(--surface-muted));
    color: var(--topic-search-accent);
  }
  :global([data-topic-search-options] [data-sort-btn][aria-pressed='true']) {
    background: hsl(var(--ink));
    color: hsl(var(--surface));
  }
  :global([data-topic-search-options] [data-sort-btn]:focus-visible) {
    position: relative;
    outline: 2px solid var(--topic-search-accent);
    outline-offset: 3px;
  }
  #tag-filter-status {
    min-width: 0;
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: .75rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  @container topic-index (width < 26rem) {
    [data-topic-search-field] { padding: 1.25rem 1rem 1rem; }
    [data-topic-search-footer] { padding: .75rem 1rem; }
    :global([data-topic-search-input]) { font-size: 1.4375rem; }
  }
  @container topic-index (width < 17rem) {
    [data-topic-search-options] { gap: .375rem; border: 0; background: transparent; }
    :global([data-topic-search-options] [data-sort-btn]),
    :global([data-topic-search-options] [data-sort-btn] + [data-sort-btn]) {
      border: 1px solid hsl(var(--line));
      border-radius: .3125rem .75rem .3125rem .75rem;
    }
    [data-topic-search-sort] { gap: .5rem; }
  }
  [data-tags-empty] {
    padding-block: 1.75rem;
    border-block: 1px solid hsl(var(--line));
  }
  [data-tags-empty]:not([hidden]) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
  }
  [data-topic-empty-icon] {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: .75rem .1875rem .75rem .1875rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }
  :global([data-theme='dark']) [data-topic-empty-icon] { color: hsl(var(--accent)); }
  [data-tags-empty] h3 {
    margin: 0;
    color: hsl(var(--ink));
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.035em;
    hyphens: none;
  }
  @container topic-index (width < 32rem) {
    [data-tags-empty] { padding-block: 1.5rem; }
    [data-tags-empty]:not([hidden]) { gap: 1rem; }
    [data-tags-empty] h3 { font-size: 1.375rem; }
  }
  @container topic-index (width < 18rem) {
    [data-tags-empty]:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
