---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getAllTags } from '@/utils/tags'

import { Card, Input, Link, Toggle } from '@santi020k/lumen-astro'

const posts = await getCachedPosts()
const allTags = getAllTags(posts)
const topTagCount = allTags[0]?.[1] ?? 0

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: 'Topics', url: '/blog/tags/' }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Browse the blog archive by recurring topics and tags across architecture, automation, DX, and engineering workflow.',
    title: 'Blog Topics'
  }}
>
  <PageHero
    description="Browse the archive by recurring topics so related posts are easier to find without hunting through the full feed."
    eyebrow="Topics"
    gradientText="Find related writing fast."
    metaItems={['Architecture', 'Automation', 'Developer experience']}
    title="Browse by topic."
  >
    <ButtonLink href="/blog/" showArrow variant="secondary">
      Back to blog
    </ButtonLink>
    <ButtonLink href="/blog/series/" showArrow variant="secondary">
      Browse series
    </ButtonLink>
  </PageHero>

  <PageSection class="lg:grid-cols-1!">
    <SectionHeader
      description="Each topic opens a filtered archive page with the related posts."
      eyebrow="All topics"
      title="Recurring themes across the archive."
    />

    <div class="space-y-4">
      <div class="
        grid gap-4
        sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end
      "
      >
        <div class="space-y-2">
          <label class="section-label block" for="tag-filter">Find a topic</label>
          <Input
            aria-describedby="tag-filter-status"
            autocomplete="off"
            class="field-surface"
            id="tag-filter"
            placeholder="Search topics…"
            spellcheck="false"
            type="search"
          />
        </div>
        <div class="
          flex items-center gap-3
          sm:pb-0.5
        "
        >
          <span class="section-label">Sort</span>
          <div class="flex gap-2">
            <Toggle className="pagination-btn pagination-btn--active" controlled data-sort-btn="count" pressed>By count</Toggle>
            <Toggle className="pagination-btn" controlled data-sort-btn="alpha">A → Z</Toggle>
          </div>
        </div>
      </div>

      <p
        id="tag-filter-status"
        aria-live="polite"
        class="text-sm text-ink-muted"
      >
        Showing all {allTags.length} topics.
      </p>

      <div
        class="
          grid gap-4
          sm:grid-cols-2
          lg:grid-cols-3
        "
        id="tags-list"
        data-stagger="40"
      >
        {allTags.map(([tag, count], i) => {
          const pct = allTags[0]?.[1] ? Math.round((count / allTags[0][1]) * 100) : 0

          return (
            <span data-count={String(count)} data-label={tag}>
              <Link
                class="
                  group block h-full rounded-[1.35rem] font-normal text-inherit
                  no-underline
                  focus-visible:ring-2 focus-visible:ring-brand/50
                  focus-visible:outline-none
                "
                href={getTagPath(tag)}
                style={`animation-delay: ${i * 30}ms`}
              >
                <Card
                  as="article"
                  class="
                    relative flex h-full flex-col gap-4 rounded-[1.35rem] p-6
                  "
                  variant="interactive"
                >
                  <div
                    aria-hidden="true"
                    class="
                      pointer-events-none absolute inset-x-0 top-0 h-1
                      bg-linear-to-r from-brand/55 via-accent/45 to-transparent
                      opacity-70
                    "
                  />

                  <div class="
                    relative z-10 flex items-start justify-between gap-2
                  "
                  >
                    <span class="
                      text-base font-semibold tracking-tight text-ink
                      transition-colors duration-200
                      group-hover:text-brand
                    "
                    >
                      #{tag}
                    </span>
                    <span
                      class="
                        shrink-0 rounded-full border border-brand/20
                        bg-brand-soft/60 px-2 py-0.5 text-xs font-semibold
                        text-brand tabular-nums
                      "
                    >
                      {count}
                    </span>
                  </div>

                  <div class="relative z-10 mt-auto">
                    <div
                      class="h-1 w-full overflow-hidden rounded-full bg-line/35"
                    >
                      <div
                        class="topic-meter-fill"
                        style={`width: ${pct}%;`}
                      />
                    </div>
                    <p class="mt-2 text-xs text-ink-muted">
                      {count} {count === 1 ? 'post' : 'posts'}
                    </p>
                  </div>
                </Card>
              </Link>
            </span>
          )
        })}
      </div>
      <p
        class="
          rounded-2xl border border-line/55 bg-surface/72 p-5 text-sm
          text-ink-soft
        "
        data-tags-empty
        hidden
      >
        No topics match that search.
      </p>
    </div>

    <script>
      const setupTopicIndex = () => {
        const list = document.getElementById('tags-list')
        const input = document.querySelector<HTMLInputElement>('#tag-filter')
        const status = document.getElementById('tag-filter-status')
        const empty = document.querySelector<HTMLElement>('[data-tags-empty]')
        const btns = document.querySelectorAll<HTMLButtonElement>('[data-sort-btn]')

        if (!list || !input || !status || !empty || list.dataset.filterReady === 'true') return

        list.dataset.filterReady = 'true'

        const items = [...list.children] as HTMLElement[]

        const updateFilter = () => {
          const query = input.value.trim().toLocaleLowerCase()
          let visibleCount = 0

          items.forEach(item => {
            const matches = !query || (item.dataset.label ?? '').toLocaleLowerCase().includes(query)

            item.hidden = !matches
            if (matches) visibleCount += 1
          })

          empty.hidden = visibleCount > 0
          status.textContent = query ?
            `${visibleCount} ${visibleCount === 1 ? 'topic' : 'topics'} found.` :
            `Showing all ${items.length} topics.`
        }

        const setActive = (active: HTMLButtonElement) => {
          queueMicrotask(() => {
            btns.forEach(button => {
              const isActive = button === active
              button.classList.toggle('pagination-btn--active', isActive)
              button.classList.toggle('ui-toggle--pressed', isActive)
              button.setAttribute('aria-pressed', String(isActive))
            })
          })
        }

        btns.forEach(btn => {
          btn.addEventListener('click', () => {
            const sort = btn.getAttribute('data-sort-btn')

            items.sort((a, b) =>
              sort === 'alpha'
                ? (a.dataset.label ?? '').localeCompare(b.dataset.label ?? '')
                : Number(b.dataset.count) - Number(a.dataset.count)
            )

            items.forEach(item => list.appendChild(item))
            setActive(btn)
          })
        })

        input.addEventListener('input', updateFilter)
      }

      document.addEventListener('astro:page-load', setupTopicIndex)
    </script>
  </PageSection>

  <StatsGrid>
    <StatCard description="Distinct recurring topics across the current writing archive." label="Topics" value={String(allTags.length)} />
    <StatCard description="Published posts that can be reached through these topic pages." label="Posts" value={String(posts.length)} />
    <StatCard description="How often the most-used topic currently appears in the archive." label="Top topic" value={`${topTagCount}x`} />
  </StatsGrid>
</PageLayout>
