---
import type { GetStaticPaths, Page } from 'astro'

import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import EditorialEntryCard from '@/components/molecules/EditorialEntryCard.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import Pagination from '@/components/molecules/Pagination.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import TagFilter from '@/components/molecules/TagFilter.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostPath } from '@/utils/links'
import { getAllTags } from '@/utils/tags'

import { editorialCalendar } from '@/data/editorial-calendar'
import { getSeriesSummaries } from '@/data/series'
import { siteConfig, YEARS_OF_WRITING } from '@/site.config'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCachedPosts()
  const allTagsData = getAllTags(posts)

  return paginate(posts, {
    pageSize: 9,
    props: { allTagsData }
  })
}

interface Props {
  allTagsData: [string, number][]
  page: Page<CollectionEntry<'post'>>
}

const { allTagsData, page } = Astro.props
const isFirstPage = page.currentPage === 1
const activeSeries = (await getSeriesSummaries()).filter(s => s.postCount > 0 && s.series.data.status === 'active')
const santi020kWaySeries = isFirstPage ? (activeSeries.find(s => s.series.id === 'the-santi020k-way') ?? null) : null
const roadmapPreview = isFirstPage ? editorialCalendar.slice(0, 3) : []
const topTags = allTagsData.slice(0, 8)
const featuredPost = page.data[0] ?? null
const gridPosts = page.data.slice(1)

const cadenceDescription =
  'One deep post each month, one refreshed evergreen guide. The archive compounds instead of aging.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}`, url: Astro.url.pathname }] : [])
]

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Software Engineering Blog — Santiago Molina',
  url: new URL('/blog/', Astro.site).href,
  blogPost: page.data.map((post, index) => ({
    '@type': 'BlogPosting',
    position: index + 1,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    url: new URL(getPostPath(post.id), Astro.site).href,
    author: {
      '@type': 'Person',
      name: siteConfig.author
    }
  }))
}
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Practical guides and deep dives into software architecture, full-stack systems, and automation by Santiago Molina.',
    structuredData: blogListSchema,
    title: isFirstPage ?
      'Software Engineering Blog — Santiago Molina' :
      `Blog · Page ${page.currentPage} of ${page.lastPage} — Santiago Molina`
  }}
>
  <PageHero
    description="Practical writing on architecture, team habits, delivery systems, and the automation that helps software work feel calmer."
    eyebrow="Blog"
    gradientText="Architecture. Craft."
    title="Writing about software."
  >
    <ButtonLink href={siteConfig.contact.medium} newTab showArrow>
      Open Medium
    </ButtonLink>
    <ButtonLink href="/blog/tags/" showArrow variant="secondary">
      Browse topics
    </ButtonLink>
    <ButtonLink href="/blog/series/" showArrow variant="secondary">
      Browse series
    </ButtonLink>
  </PageHero>

  <StatsGrid>
    <StatCard description="Articles currently hosted on my site and cross-posted to Medium." label="Posts" value={String(page.total)} />
    <StatCard
      description="Topics and themes covered in my writing across various publications."
      label="Tags"
      value={String(allTagsData.length)}
    />
    <StatCard
      description="Grouped reading tracks so related posts are easier to follow in sequence."
      label="Series"
      value={String(activeSeries.length)}
    />
    <StatCard
      description="Years of writing and sharing engineering knowledge across the web."
      label="Experience"
      value={YEARS_OF_WRITING}
    />
  </StatsGrid>

  <PageSection>
    <SectionHeader
      description="Latest post first, then browse by topic and depth."
      eyebrow={isFirstPage ? 'Latest' : `Page ${page.currentPage} of ${page.lastPage}`}
      title="Recent writing with a practical bias."
    />

    <div class="space-y-6">
      {featuredPost && <PostCard featured post={featuredPost} />}

      <TagFilter showDivider={!!featuredPost} tags={topTags} />

      <div class="post-grid" data-stagger="60">
        {gridPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>

      <Pagination page={page} />
    </div>
  </PageSection>

  {isFirstPage && santi020kWaySeries && (
    <PageSection>
      <SectionHeader
        description="A new blog section collecting the principles I keep returning to around ownership, code quality, feedback, responsive thinking, and calmer releases."
        eyebrow="The santi020k way"
        linkHref="/blog/series/the-santi020k-way/"
        linkLabel="Browse the full series"
        title="A clearer home for my engineering principles."
      />

      <div
class="
        grid gap-6
        lg:grid-cols-[1.05fr_0.95fr]
      "
      data-stagger="70"
      >
        <Card
          as="article"
          class="
            flex flex-col gap-5 p-6
            sm:gap-6 sm:p-7
          "
          variant="muted"
        >
          <p class="text-base/8 text-ink-soft">
            This series turns a private set of notes into public writing. The throughline is simple:
            stronger teams care about the whole system, not just the local task in front of them.
          </p>

          <p class="text-base/8 text-ink-soft">
            The posts cover ownership, code smells, review language, Git habits, responsive standards,
            team conventions, release discipline, and small readability choices that compound over time.
          </p>

          <div class="section-actions">
            <ButtonLink href="/blog/series/the-santi020k-way/" showArrow>
              Explore the series
            </ButtonLink>
            <ButtonLink href="/blog/series/" showArrow variant="secondary">
              View all series
            </ButtonLink>
          </div>
        </Card>

        <Card class="
          flex flex-col gap-5 p-6
          sm:p-7
        "
        >
          <div class="flex flex-wrap items-center gap-2">
            <Pill label={`${santi020kWaySeries.postCount} posts`} tone="brand" />
            <Pill label="Newly imported" tone="outline" />
          </div>

          <div class="space-y-3">
            <p class="section-label">Focus areas</p>
            <div class="flex flex-wrap gap-2">
              {santi020kWaySeries.series.data.focusAreas.map(area => (
                <Pill label={area} tone="outline" />
              ))}
            </div>
          </div>

          <p class="text-sm/7 text-ink-soft">
            It is the right track if you want the cultural and operational rules behind how I like to
            build software teams, not only the framework-specific implementation details.
          </p>
        </Card>
      </div>
    </PageSection>
  )}

  {isFirstPage && !!activeSeries.length && (
    <PageSection>
      <SectionHeader
        description="Related posts now live in clearer tracks, so topics like Next.js delivery systems and ESLint tooling feel like connected reading instead of isolated entries."
        eyebrow="Series"
        linkHref="/blog/series/"
        linkLabel="Browse all series"
        title="Follow related posts in order."
      />

      <div class="post-grid" data-stagger="60">
        {activeSeries.map(item => (
          <SeriesCard postCount={item.postCount} series={item.series} />
        ))}
      </div>
    </PageSection>
  )}

  {isFirstPage && (
    <PageSection>
      <SectionHeader
        description={cadenceDescription}
        eyebrow="Publishing Rhythm"
        linkHref="/blog/content-calendar/"
        linkLabel="View full calendar"
        title="Consistent output, compounding value."
      />

      <div class="max-w-xl space-y-4">
        <div class="flex flex-col gap-4" data-stagger="60">
          {roadmapPreview.map(entry => (
            <EditorialEntryCard
              format={entry.format}
              headline={entry.headline}
              month={entry.month}
              refreshTitle={entry.refreshTitle}
              seriesId={entry.seriesId}
              variant="compact"
            />
          ))}
        </div>

        <div class="section-actions">
          <ButtonLink href="/blog/content-calendar/" showArrow>
            See the roadmap
          </ButtonLink>
          <ButtonLink href="/blog/series/" showArrow variant="secondary">
            Browse series
          </ButtonLink>
          <ButtonLink href="/feed.xml" showArrow variant="secondary">
            Follow via RSS
          </ButtonLink>
        </div>
      </div>
    </PageSection>
  )}
</PageLayout>
