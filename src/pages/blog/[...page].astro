---
import type { GetStaticPaths, Page } from 'astro'

import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import NewsletterSignup from '@/components/molecules/NewsletterSignup.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import Pagination from '@/components/molecules/Pagination.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import TagFilter from '@/components/molecules/TagFilter.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import BlogHero from '@/components/pages/blog/BlogHero.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostPath } from '@/utils/links'
import { BLOG_ARCHIVE_PAGE_SIZE } from '@/utils/pagination'
import { getAllTags, getBlogBrowseTags } from '@/utils/tags'

import { RevealGroup } from '@santi020k/lumen-astro'

import { getSeriesSummaries } from '@/data/series'
import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'
import { createAuthorSchema, siteConfig } from '@/site.config'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCachedPosts()
  const allTagsData = getAllTags(posts)

  return paginate(posts, {
    pageSize: BLOG_ARCHIVE_PAGE_SIZE,
    props: { allTagsData }
  })
}

interface Props {
  allTagsData: [string, number][]
  page: Page<CollectionEntry<'post'>>
}

const { allTagsData, page } = Astro.props
const isFirstPage = page.currentPage === 1
const activeSeries = (await getSeriesSummaries()).filter(s => s.postCount > 0 && s.series.data.status === 'active')
const topTags = getBlogBrowseTags(allTagsData)
const latestPost = page.data[0] ?? null
const archiveDescription = t('Notes on software, reading, gaming, and everyday discoveries by Santiago Molina.')

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  ...(page.currentPage > 1 ? [{ name: t(`Page ${page.currentPage}`), url: Astro.url.pathname }] : [])
]

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t('Personal Blog — Santiago Molina'),
  url: new URL('/blog/', Astro.site).href,
  blogPost: page.data.map((post, index) => ({
    '@type': 'BlogPosting',
    position: index + 1,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    url: new URL(getPostPath(post.id), Astro.site).href,
    author: createAuthorSchema(Astro.site)
  }))
}
---

<PageLayout
  headerVariant={isFirstPage ? 'signature' : 'dock'}
  mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: isFirstPage ?
      archiveDescription :
      t(`${archiveDescription} Page ${page.currentPage} of ${page.lastPage}.`),
    structuredData: blogListSchema,
    title: isFirstPage ?
      t('Personal Blog — Santiago Molina') :
      t(`Blog · Page ${page.currentPage} of ${page.lastPage} — Santiago Molina`)
  }}
>
  {isFirstPage ?
(
    <BlogHero latestPost={latestPost} postCount={page.total} topicCount={allTagsData.length} />
  ) :
(
    <PageHero
      compact
      description={t(`Older writing from page ${page.currentPage} of ${page.lastPage}, ordered newest first.`)}
      eyebrow={t('Blog archive')}
      gradientText={t(`Page ${page.currentPage}.`)}
      metaItems={[t('Archive'), t('Latest first')]}
      title={t('Writing archive.')}
    >
      <ButtonLink href={localizePath('/blog/', locale)} showArrow>{t('Back to latest posts')}</ButtonLink>
      <ButtonLink href={localizePath('/blog/tags/', locale)} showArrow variant="secondary">{t('Browse topics')}</ButtonLink>
    </PageHero>
  )}

  <section
    id="posts"
    aria-label={isFirstPage ? t('Latest blog posts') : t(`Blog posts, page ${page.currentPage}`)}
    class="section-container-wide scroll-mt-28 page-section-space"
  >
    <SectionHeader
      description={isFirstPage ? t('Software, reading, gaming, and everything in between. Browse the feed or follow a topic.') : t('More notes and discoveries, ordered newest first.')}
      eyebrow={isFirstPage ? t('Latest') : t(`Page ${page.currentPage} of ${page.lastPage}`)}
      title={isFirstPage ? t('Recent notes and discoveries.') : t('From the archive.')}
    />

    <div class="
      mt-10 space-y-8
      sm:mt-12
    "
    >
      <TagFilter tags={topTags} totalTopics={allTagsData.length} />

      <PostsGallery posts={page.data} />

      <div class="pt-2">
        <Pagination page={page} />
      </div>
    </div>
  </section>

  {isFirstPage && !!activeSeries.length && (
    <PageSection layout="stacked">
      <SectionHeader
        description={t('Go deeper with connected posts on engineering principles, delivery systems, and developer tools.')}
        eyebrow="Series"
        linkHref={localizePath('/blog/series/', locale)}
        linkLabel={t('Browse all series')}
        title={t('Follow related posts in order.')}
      />

      <RevealGroup
class="
  grid grid-cols-1 gap-6
  sm:card-grid-2
  lg:card-grid-3
"
stagger={60}
threshold={0}
      >
        {activeSeries.map(item => (
          <SeriesCard postCount={item.postCount} series={item.series} />
        ))}
      </RevealGroup>
    </PageSection>
  )}

  {isFirstPage && siteConfig.newsletter?.formAction && (
    <PageSection layout="stacked">
      <NewsletterSignup formAction={siteConfig.newsletter.formAction} />
    </PageSection>
  )}

</PageLayout>
