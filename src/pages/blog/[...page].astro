---
import type { GetStaticPaths, Page } from 'astro'

import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import NewsletterSignup from '@/components/molecules/NewsletterSignup.astro'
import Pagination from '@/components/molecules/Pagination.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import TagFilter from '@/components/molecules/TagFilter.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import BlogArchiveHero from '@/components/pages/blog/BlogArchiveHero.astro'
import BlogHero from '@/components/pages/blog/BlogHero.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostPath } from '@/utils/links'
import { BLOG_ARCHIVE_PAGE_SIZE } from '@/utils/pagination'
import { getAllTags, getBlogBrowseTags } from '@/utils/tags'

import { Link, RevealGroup } from '@santi020k/lumen-astro'

import { getSeriesSummaries } from '@/data/series'
import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'
import { createAuthorSchema, siteConfig } from '@/site.config'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCachedPosts()
  const allTagsData = getAllTags(posts)

  return paginate(posts, {
    pageSize: BLOG_ARCHIVE_PAGE_SIZE,
    props: { allTagsData }
  })
}

interface Props {
  allTagsData: [string, number][]
  page: Page<CollectionEntry<'post'>>
}

const { allTagsData, page } = Astro.props
const isFirstPage = page.currentPage === 1
const activeSeries = (await getSeriesSummaries()).filter(s => s.postCount > 0 && s.series.data.status === 'active')
const topTags = getBlogBrowseTags(allTagsData)
const latestPost = page.data[0] ?? null
const archiveDescription = t('collection.notesOnSoftwareReadingGamingAnd')

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  ...(page.currentPage > 1 ? [{ name: t('pagination.page', { page: page.currentPage }), url: Astro.url.pathname }] : [])
]

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t('collection.personalBlogSantiagoMolina'),
  url: new URL('/blog/', Astro.site).href,
  blogPost: page.data.map((post, index) => ({
    '@type': 'BlogPosting',
    position: index + 1,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
    url: new URL(getPostPath(post.id), Astro.site).href,
    author: createAuthorSchema(Astro.site)
  }))
}
---

<PageLayout
  headerVariant={isFirstPage ? 'signature' : 'dock'}
  mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: isFirstPage ?
      archiveDescription :
      t('pagination.description', { description: archiveDescription, page: page.currentPage, total: page.lastPage }),
    structuredData: blogListSchema,
    title: isFirstPage ?
      t('collection.personalBlogSantiagoMolina') :
      t('blog.pageTitle', { page: page.currentPage, total: page.lastPage })
  }}
>
  {isFirstPage ?
(
    <BlogHero latestPost={latestPost} postCount={page.total} topicCount={allTagsData.length} />
  ) :
(
    <BlogArchiveHero currentPage={page.currentPage} lastPage={page.lastPage} postCount={page.data.length} />
  )}

  <section
    id="posts"
    aria-label={isFirstPage ? t('collection.latestBlogPosts') : t('blog.pageLabel', { page: page.currentPage })}
    class="section-container-wide scroll-mt-28 page-section-space"
  >
    <SectionHeader
      description={isFirstPage ? t('collection.softwareReadingGamingAndEverythingIn') : t('collection.moreNotesAndDiscoveriesOrderedNewest')}
      eyebrow={isFirstPage ? t('collection.latest') : t('pagination.position', { page: page.currentPage, total: page.lastPage })}
      title={isFirstPage ? t('collection.recentNotesAndDiscoveries') : t('collection.fromTheArchive')}
    />

    <div class="
      mt-10 space-y-8
      sm:mt-12
    "
    >
      <TagFilter tags={topTags} totalTopics={allTagsData.length} />

      <PostsGallery posts={page.data} />

      <div class="pt-2">
        <Pagination page={page} />
      </div>
    </div>
  </section>

  {isFirstPage && !!activeSeries.length && (
    <PageSection layout="stacked">
      <header id="blog-series" class="scroll-mt-28" data-blog-series-caption>
        <div>
          <h2>{t('series.shelfHeading')}</h2>
          <p>{t('series.shelfDescription')}</p>
        </div>
        <Link data-blog-series-browse data-text-link href={localizePath('/blog/series/', locale)} variant="inherit">
          <span data-text-link-label>{t('collection.browseAllSeries')}</span>
          <ArrowExchange direction="right" />
        </Link>
      </header>

      <RevealGroup
class="
  grid grid-cols-1 gap-6
  sm:card-grid-2
  lg:card-grid-3
"
stagger={60}
threshold={0}
      >
        {activeSeries.map(item => (
          <SeriesCard firstPost={item.posts[0]} postCount={item.postCount} readingMinutes={item.readingMinutes} series={item.series} />
        ))}
      </RevealGroup>
    </PageSection>
  )}

  {isFirstPage && siteConfig.newsletter?.formAction && (
    <PageSection layout="stacked">
      <NewsletterSignup formAction={siteConfig.newsletter.formAction} />
    </PageSection>
  )}

</PageLayout>

<style>
  [data-blog-series-caption] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  [data-blog-series-caption] h2 {
    color: hsl(var(--ink));
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  [data-blog-series-caption] p {
    margin-top: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  [data-blog-series-caption] :global([data-blog-series-browse]) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    color: hsl(var(--brand));
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.7;
  }

  :global([data-theme='dark']) [data-blog-series-caption] :global([data-blog-series-browse]) {
    color: hsl(var(--accent));
  }

  @container page-section (width < 34rem) {
    [data-blog-series-caption] {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    [data-blog-series-caption] :global([data-blog-series-browse]) {
      justify-self: start;
    }
  }
</style>
