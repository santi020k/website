---
import { getCollection } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeading from '@/components/molecules/SectionHeading.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'

import { getTopTags } from '@/utils/tags'

import { editorialCalendar, publishingRhythm } from '@/data/editorial-calendar'
import { getSeriesSummaries } from '@/data/series'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const posts = (await getCollection('post', ({ data }) => (
  import.meta.env.PROD ? !data.draft : true
)))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())

const uniqueTags = new Set(posts.flatMap(post => post.data.tags)).size
const activeSeries = (await getSeriesSummaries()).filter(item => item.postCount > 0 && item.series.data.status === 'active')
const santi020kWaySeries = activeSeries.find(item => item.series.id === 'the-santi020k-way') ?? null
const roadmapPreview = editorialCalendar.slice(0, 3)

const cadenceDescription =
  `${publishingRhythm.summary} ` +
  'The current roadmap runs from April 2026 through September 2026 so the site keeps growing on a predictable rhythm instead of in bursts.'

const topTags = getTopTags(posts)
const [featuredPost, ...remainingPosts] = posts

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' }
]
---

<PageLayout
  meta={{
    breadcrumbs,
    description: 'Practical guides and deep dives into software architecture, full-stack systems, and automation by Santiago Molina.',
    title: 'Software Engineering Blog — Santiago Molina'
  }}
>
  <section
    class="
      grid gap-10
      lg:grid-cols-[1.05fr_0.95fr]
    "
  >
    <div class="space-y-6">
      <SectionHeading
        description="I write about full-stack systems, architecture, and the automation that helps teams ship with confidence. From backend services to delivery pipelines, I share what I learn along the way."
        eyebrow="Blog"
        level="h1"
        title="Writing about software architecture, automation, and engineering craft."
      />

      <div class="section-actions">
        <ButtonLink href={siteConfig.contact.medium} newTab showArrow>
          Open Medium profile
        </ButtonLink>
        <ButtonLink href="/" showArrow variant="secondary">
          Back home
        </ButtonLink>
      </div>

      <div class="space-y-3">
        <p class="section-label">Popular topics</p>
        <div class="flex flex-wrap gap-2">
          {topTags.map(([tag]) => (
            <Pill label={tag} showHash tone="outline" />
          ))}
        </div>
      </div>
    </div>

    <div class="
      grid gap-4
      sm:grid-cols-2
      lg:grid-cols-1
    "
    >
      <StatCard description="Articles currently hosted on my site and cross-posted to Medium." label="Posts" value={String(posts.length)} />
      <StatCard
        description="Topics and themes covered in my writing across various publications."
        label="Tags"
        value={String(uniqueTags)}
      />
      <StatCard
        description="Grouped reading tracks so related posts are easier to follow in sequence."
        label="Series"
        value={String(activeSeries.length)}
      />
    </div>
  </section>

  <section class="editorial-section" data-animate>
    <SectionHeading
      description="Start with the latest piece, then browse the rest by topic and depth."
      eyebrow="Latest"
      title="Recent writing with a practical bias."
    />
    <div class="space-y-6">
      {featuredPost && <PostCard featured post={featuredPost} />}

      <div
        class="
          grid gap-6
          lg:grid-cols-2
        "
      >
        {remainingPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>

  {santi020kWaySeries && (
    <section class="editorial-section" data-animate>
      <SectionHeading
        description="A new blog section collecting the principles I keep returning to around ownership, code quality, feedback, responsive thinking, and calmer releases."
        eyebrow="The santi020k way"
        linkHref="/blog/series/the-santi020k-way/"
        linkLabel="Browse the full series"
        title="A clearer home for my engineering principles."
      />

      <div class="
        grid gap-6
        lg:grid-cols-[1.05fr_0.95fr]
      "
      >
        <article class="
          section-shell-subtle flex flex-col gap-5
          sm:gap-6
        "
        >
          <p class="text-base/8 text-ink-soft">
            This series turns a private set of notes into public writing. The throughline is simple:
            stronger teams care about the whole system, not just the local task in front of them.
          </p>

          <p class="text-base/8 text-ink-soft">
            The posts cover ownership, code smells, review language, Git habits, responsive standards,
            team conventions, release discipline, and small readability choices that compound over time.
          </p>

          <div class="section-actions">
            <ButtonLink href="/blog/series/the-santi020k-way/" showArrow>
              Explore the series
            </ButtonLink>
            <ButtonLink href="/blog/series/" showArrow variant="secondary">
              View all series
            </ButtonLink>
          </div>
        </article>

        <div class="
          panel-card flex flex-col gap-5 p-6
          sm:p-7
        "
        >
          <div class="flex flex-wrap items-center gap-2">
            <Pill label={`${santi020kWaySeries.postCount} posts`} tone="brand" />
            <Pill label="Newly imported" tone="outline" />
          </div>

          <div class="space-y-3">
            <p class="section-label">Focus areas</p>
            <div class="flex flex-wrap gap-2">
              {santi020kWaySeries.series.data.focusAreas.map(area => (
                <Pill label={area} tone="outline" />
              ))}
            </div>
          </div>

          <p class="text-sm/7 text-ink-soft">
            It is the right track if you want the cultural and operational rules behind how I like to
            build software teams, not only the framework-specific implementation details.
          </p>
        </div>
      </div>
    </section>
  )}

  {!!activeSeries.length && (
    <section class="editorial-section" data-animate>
      <SectionHeading
        description="Related posts now live in clearer tracks, so topics like Next.js delivery systems and ESLint tooling feel like connected reading instead of isolated entries."
        eyebrow="Series"
        linkHref="/blog/series/"
        linkLabel="Browse all series"
        title="Follow related posts in order."
      />

      <div
        class="
          grid gap-6
          lg:grid-cols-2
        "
        data-stagger
      >
        {activeSeries.map(item => (
          <SeriesCard postCount={item.postCount} series={item.series} />
        ))}
      </div>
    </section>
  )}

  <section class="editorial-section" data-animate>
    <SectionHeading
      description={cadenceDescription}
      eyebrow="Cadence"
      linkHref="/blog/content-calendar/"
      linkLabel="View the full content calendar"
      title="A documented monthly publishing rhythm."
    />

    <div class="space-y-6">
      <div
        class="
          grid gap-5
          md:grid-cols-3
        "
        data-stagger
      >
        {roadmapPreview.map(entry => (
          <article class="
            flex mini-note h-full flex-col gap-4 p-5
            sm:p-6
          "
          >
            <div class="flex flex-wrap items-center gap-2">
              <Pill label={entry.month} tone="brand" />
              <Pill label={entry.format} tone="outline" />
            </div>
            <h2 class="text-xl/tight text-ink">
              {entry.headline}
            </h2>
            <p class="text-sm/6 text-ink-soft">
              Refreshing: {entry.refreshTitle}
            </p>
          </article>
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href="/blog/content-calendar/" showArrow>
          See the roadmap
        </ButtonLink>
        <ButtonLink href="/blog/series/" showArrow variant="secondary">
          Browse series
        </ButtonLink>
        <ButtonLink href="/feed.xml" showArrow variant="secondary">
          Follow via RSS
        </ButtonLink>
      </div>
    </div>
  </section>
</PageLayout>
