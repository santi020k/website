---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { RevealGroup } from '@santi020k/lumen-astro'

import { getSeriesSummaries } from '@/data/series'
import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text
const seriesSummaries = await getSeriesSummaries()
const activeSeries = seriesSummaries.filter(item => item.postCount > 0 && item.series.data.status === 'active')
const postsGroupedIntoSeries = activeSeries.reduce((count, item) => count + item.postCount, 0)

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: 'Series', url: localizePath('/blog/series/', locale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: 'Grouped reading tracks for Santiago Molina\'s writing on architecture, tooling, testing, and delivery systems.',
    title: t('Blog Series — Santiago Molina')
  }}
>
  <PageHero
    description={t('Grouped reading paths — follow a topic from start to finish without hunting the archive.')}
    eyebrow="Series"
    gradientText="in order."
    metaItems={[t('Reading tracks'), t('Practical sequence'), t('Connected ideas')]}
    title={t('Follow related posts')}
  >
    <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('Back to blog')}</ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard
      description={t('Ongoing reading tracks with at least one published post.')}
      icon="library"
label={t('Active series')}
      value={activeSeries.length}
    />
    <StatCard
      description={t('Posts that belong to a series rather than standing alone in the archive.')}
      icon="files"
label={t('Posts grouped')}
      value={postsGroupedIntoSeries}
    />
    <StatCard
      description={t('Published reading tracks, including active and archived series.')}
      icon="book-open"
label={t('Reading tracks')}
      value={seriesSummaries.filter(item => item.postCount > 0).length}
    />
  </StatsGrid>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('Each series is a self-contained reading track — start at post one, follow the thread, finish with a complete mental model.')}
      eyebrow="Series"
      title={t('Current series on the site.')}
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
        lg:card-grid-3
      "
      stagger={70}
      threshold={0}
    >
      {activeSeries.map(item => (
        <SeriesCard postCount={item.postCount} series={item.series} />
      ))}
    </RevealGroup>
  </PageSection>
</PageLayout>
