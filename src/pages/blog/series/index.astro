---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCard from '@/components/molecules/SeriesCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { RevealGroup } from '@santi020k/lumen-astro'

import { getSeriesSummaries } from '@/data/series'
import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const seriesSummaries = await getSeriesSummaries()
const activeSeries = seriesSummaries.filter(item => item.postCount > 0 && item.series.data.status === 'active')
const postsGroupedIntoSeries = activeSeries.reduce((count, item) => count + item.postCount, 0)

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: 'Series', url: localizePath('/blog/series/', locale) }
]
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: 'Grouped reading tracks for Santiago Molina\'s writing on architecture, tooling, testing, and delivery systems.',
    title: t('collection.blogSeriesSantiagoMolina')
  }}
>
  <PageHero
    description={t('collection.groupedReadingPathsFollowATopic')}
    eyebrow="Series"
    gradientText="in order."
    metaItems={[t('collection.readingTracks'), t('collection.practicalSequence'), t('collection.connectedIdeas')]}
    title={t('collection.followRelatedPosts')}
  >
    <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('collection.backToBlog')}</ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard
      description={t('collection.ongoingReadingTracksWithAtLeast')}
      icon="library"
label={t('collection.activeSeries')}
      value={activeSeries.length}
    />
    <StatCard
      description={t('collection.postsThatBelongToASeries')}
      icon="files"
label={t('collection.postsGrouped')}
      value={postsGroupedIntoSeries}
    />
    <StatCard
      description={t('collection.publishedReadingTracksIncludingActiveAnd')}
      icon="book-open"
label={t('collection.readingTracks')}
      value={seriesSummaries.filter(item => item.postCount > 0).length}
    />
  </StatsGrid>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('collection.eachSeriesIsASelfContained')}
      eyebrow="Series"
      title={t('collection.currentSeriesOnTheSite')}
    />

    <RevealGroup
      class="
        grid grid-cols-1 gap-6
        sm:card-grid-2
        lg:card-grid-3
      "
      stagger={70}
      threshold={0}
    >
      {activeSeries.map(item => (
        <SeriesCard postCount={item.postCount} series={item.series} />
      ))}
    </RevealGroup>
  </PageSection>
</PageLayout>
