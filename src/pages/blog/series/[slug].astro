---
import { type CollectionEntry, render } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import GradientDivider from '@/components/atoms/GradientDivider.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCadenceCard from '@/components/molecules/SeriesCadenceCard.astro'
import SeriesFocusCard from '@/components/molecules/SeriesFocusCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getPostPath } from '@/utils/links'

import { getSeriesSummaries } from '@/data/series'

export const getStaticPaths = async () => {
  const seriesSummaries = await getSeriesSummaries()

  return seriesSummaries.map(item => ({
    params: { slug: item.series.id },
    props: {
      postCount: item.postCount,
      posts: item.posts,
      series: item.series
    }
  }))
}

export interface Props {
  postCount: number
  posts: CollectionEntry<'post'>[]
  series: CollectionEntry<'series'>
}

const { postCount, posts, series } = Astro.props
const { Content } = await render(series)
const metaTitle = series.data.seoTitle ?? series.data.title
const metaDescription = series.data.seoDescription ?? series.data.description

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: series.data.title, url: Astro.url.pathname }
]

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  description: metaDescription,
  hasPart: posts.map((post, index) => ({
    '@type': 'BlogPosting',
    name: post.data.title,
    position: index + 1,
    url: new URL(getPostPath(post.id), Astro.site).href
  })),
  name: metaTitle,
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<PageLayout
mainClass="remaining-pages"
  meta={{
    breadcrumbs,
    description: metaDescription,
    structuredData,
    title: metaTitle
  }}
>
  <PageHero
    description={series.data.description}
    eyebrow="Blog series"
    gradientText="A reading track."
    metaItems={['Start to finish', series.data.cadence, `${postCount} ${postCount === 1 ? 'post' : 'posts'}`]}
    title={series.data.title.includes('.') ? series.data.title : series.data.title + '.'}
  >
    <ButtonLink href="/blog/series/" showArrow>
      Browse all series
    </ButtonLink>
    <ButtonLink href="/blog/" showArrow variant="secondary">
      Back to blog
    </ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard description="Articles collected into this reading track." icon="file-text" label="Posts" value={postCount} />
    <SeriesCadenceCard cadence={series.data.cadence} />
    {!!series.data.focusAreas.length && (
      <StatCard description="Recurring themes shaping the articles in this track." icon="focus" label="Focus areas" value={series.data.focusAreas.length} />
    )}
  </StatsGrid>

  <GradientDivider class="pt-10" />

  <section
    class="
      section-container-wide grid grid-cols-1 gap-8 pt-10
      lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]
    "
  >
    <div class="prose-santi max-w-none">
      <Content />
    </div>

    {!!series.data.focusAreas.length && (
      <SeriesFocusCard areas={series.data.focusAreas} />
    )}
  </section>

  <section
    class="
      section-container-wide pt-20
      sm:pt-24
      lg:pt-28
    "
  >
    <SectionHeader
      description="Read these in order if you want the clearest progression from foundations to deeper implementation decisions."
      eyebrow="Posts"
      title="Articles in this series."
    />

    <div class="
      mt-10
      sm:mt-12
    "
    >
      <PostsGallery posts={posts} showSequence />
    </div>
  </section>
</PageLayout>
