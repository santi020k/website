---
import { type CollectionEntry, render } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import Pill from '@/components/atoms/Pill.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'

import { getPostPath } from '@/utils/links'

import { getSeriesSummaries } from '@/data/series'
import PageLayout from '@/layouts/Base.astro'

export const getStaticPaths = async () => {
  const seriesSummaries = await getSeriesSummaries()

  return seriesSummaries.map(item => ({
    params: { slug: item.series.id },
    props: {
      postCount: item.postCount,
      posts: item.posts,
      series: item.series
    }
  }))
}

interface Props {
  postCount: number
  posts: CollectionEntry<'post'>[]
  series: CollectionEntry<'series'>
}

const { postCount, posts, series } = Astro.props
const { Content } = await render(series)
const metaTitle = series.data.seoTitle ?? series.data.title
const metaDescription = series.data.seoDescription ?? series.data.description

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: series.data.title, url: Astro.url.pathname }
]

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  description: metaDescription,
  hasPart: posts.map((post, index) => ({
    '@type': 'BlogPosting',
    name: post.data.title,
    position: index + 1,
    url: new URL(getPostPath(post.id), Astro.site).href
  })),
  name: metaTitle,
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<PageLayout
  meta={{
    breadcrumbs,
    description: metaDescription,
    structuredData,
    title: metaTitle
  }}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Blog series"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          {series.data.title.includes('.') ? series.data.title : series.data.title + '.'}
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">A reading track.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          {series.data.description}
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/blog/series/" showArrow>
            Browse all series
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Back to blog
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <StatsGrid>
    <StatCard description="Articles collected into this reading track." label="Posts" value={String(postCount)} />
    <StatCard description="Publishing cadence for this series." label="Cadence" value={series.data.cadence} />
    {!!series.data.focusAreas.length && (
      <StatCard description="Recurring themes shaping the articles in this track." label="Focus areas" value={String(series.data.focusAreas.length)} />
    )}
  </StatsGrid>

  <section
    class="
      grid gap-8 pt-10
      lg:grid-cols-[1.1fr_0.9fr]
    "
    data-animate
  >
    <div class="prose-santi max-w-none border-y border-line/45 py-8">
      <Content />
    </div>

    {!!series.data.focusAreas.length && (
      <div class="space-y-4">
        <p class="section-label">Focus areas</p>
        <div class="flex flex-wrap gap-2">
          {series.data.focusAreas.map(area => (
            <Pill label={area} tone="outline" />
          ))}
        </div>
      </div>
    )}
  </section>

  <PageSection>
    <SectionHeader
      description="Read these in order if you want the clearest progression from foundations to deeper implementation decisions."
      eyebrow="Posts"
      title="Articles in this series."
    />

    <div class="space-y-6">
      {posts.map((post, index) => (
        <div class="space-y-3">
          <p class="section-label">Part {index + 1}</p>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </PageSection>
</PageLayout>
