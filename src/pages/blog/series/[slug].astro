---
import { type CollectionEntry, render } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import SeriesCadenceCard from '@/components/molecules/SeriesCadenceCard.astro'
import SeriesFocusCard from '@/components/molecules/SeriesFocusCard.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getPostPath } from '@/utils/links'

import { getSeriesSummaries } from '@/data/series'
import { getLocale, localizePath } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text

export const getStaticPaths = async () => {
  const seriesSummaries = await getSeriesSummaries()

  return seriesSummaries.map(item => ({
    params: { slug: item.series.id },
    props: {
      postCount: item.postCount,
      posts: item.posts,
      series: item.series
    }
  }))
}

export interface Props {
  postCount: number
  posts: CollectionEntry<'post'>[]
  series: CollectionEntry<'series'>
}

const { postCount, posts, series } = Astro.props
const { Content } = await render(series)
const metaTitle = series.data.seoTitle ?? series.data.title
const metaDescription = series.data.seoDescription ?? series.data.description
const heroTitle = series.data.title.trimEnd()

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', locale) },
  { name: 'Blog', url: localizePath('/blog/', locale) },
  { name: series.data.title, url: Astro.url.pathname }
]

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  description: metaDescription,
  hasPart: posts.map((post, index) => ({
    '@type': 'BlogPosting',
    name: post.data.title,
    position: index + 1,
    url: new URL(getPostPath(post.id), Astro.site).href
  })),
  name: metaTitle,
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<PageLayout
mainClass="remaining-pages series-detail-page"
  meta={{
    breadcrumbs,
    description: metaDescription,
    structuredData,
    title: metaTitle
  }}
>
  <PageHero
    description={series.data.description}
    eyebrow={t('Blog series')}
    gradientText={t('A reading track.')}
    metaItems={[t('Start to finish'), series.data.cadence, `${postCount} ${postCount === 1 ? t('post') : t('posts')}`]}
    title={/[.!?…]$/u.test(heroTitle) ? heroTitle : `${heroTitle}.`}
  >
    <ButtonLink href={localizePath('/blog/series/', locale)} showArrow>{t('Browse all series')}</ButtonLink>
    <ButtonLink href={localizePath('/blog/', locale)} showArrow variant="secondary">{t('Back to blog')}</ButtonLink>
  </PageHero>

  <div class="section-container-wide" data-series-summary>
  <StatsGrid columns={series.data.focusAreas.length > 0 ? 3 : 2} showDivider={false}>
    <StatCard description={t('Articles collected into this reading track.')} icon="file-text" label={t('Posts')} value={postCount} />
    <SeriesCadenceCard cadence={series.data.cadence} />
    {!!series.data.focusAreas.length && (
      <StatCard description={t('Recurring themes shaping the articles in this track.')} icon="focus" label={t('Focus areas')} value={series.data.focusAreas.length} />
    )}
  </StatsGrid>
  </div>

  <section class="section-container-wide" data-series-overview>
    <div data-series-overview-grid>
      <div data-series-introduction>
        <Content />
      </div>
      {!!series.data.focusAreas.length && (
        <SeriesFocusCard areas={series.data.focusAreas} />
      )}
    </div>
  </section>

  <PageSection layout="stacked">
    <SectionHeader
      description={t('Read these in order if you want the clearest progression from foundations to deeper implementation decisions.')}
      eyebrow={t('Posts')}
      title={t('Articles in this series.')}
    />

    <PostsGallery layout="chapters" posts={posts} showSequence />
  </PageSection>
</PageLayout>
