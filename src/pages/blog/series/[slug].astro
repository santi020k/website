---
import { type CollectionEntry, render } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import GradientDivider from '@/components/atoms/GradientDivider.astro'
import Pill from '@/components/atoms/Pill.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PostCard from '@/components/molecules/PostCard.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import { Card } from '@/components/ui'
import PageLayout from '@/layouts/Base.astro'

import { getPostPath } from '@/utils/links'

import { getSeriesSummaries } from '@/data/series'

export const getStaticPaths = async () => {
  const seriesSummaries = await getSeriesSummaries()

  return seriesSummaries.map(item => ({
    params: { slug: item.series.id },
    props: {
      postCount: item.postCount,
      posts: item.posts,
      series: item.series
    }
  }))
}

interface Props {
  postCount: number
  posts: CollectionEntry<'post'>[]
  series: CollectionEntry<'series'>
}

const { postCount, posts, series } = Astro.props as Props
const { Content } = await render(series)
const metaTitle = series.data.seoTitle ?? series.data.title
const metaDescription = series.data.seoDescription ?? series.data.description

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: series.data.title, url: Astro.url.pathname }
]

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  description: metaDescription,
  hasPart: posts.map((post, index) => ({
    '@type': 'BlogPosting',
    name: post.data.title,
    position: index + 1,
    url: new URL(getPostPath(post.id), Astro.site).href
  })),
  name: metaTitle,
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<PageLayout
  mainSpacing="home"
  meta={{
    breadcrumbs,
    description: metaDescription,
    structuredData,
    title: metaTitle
  }}
>
  <PageHero
    description={series.data.description}
    eyebrow="Blog series"
    gradientText="A reading track."
    title={series.data.title.includes('.') ? series.data.title : series.data.title + '.'}
  >
    <ButtonLink href="/blog/series/" showArrow>
      Browse all series
    </ButtonLink>
    <ButtonLink href="/blog/" showArrow variant="secondary">
      Back to blog
    </ButtonLink>
  </PageHero>

  <StatsGrid columns={3}>
    <StatCard description="Articles collected into this reading track." label="Posts" value={String(postCount)} />
    <Card
      as="article"
      class="
        h-full p-5
        sm:p-6
      "
      variant="muted"
    >
      <p class="section-label">Cadence</p>
      <p class="
        mt-4 max-w-[26ch] text-lg/7 font-semibold text-ink
        sm:text-xl/8
      "
      >
        {series.data.cadence}
      </p>
      <p class="mt-3 max-w-[24ch] text-sm/6 text-ink-soft">
        Publishing rhythm for this series.
      </p>
    </Card>
    {!!series.data.focusAreas.length && (
      <StatCard description="Recurring themes shaping the articles in this track." label="Focus areas" value={String(series.data.focusAreas.length)} />
    )}
  </StatsGrid>

  <GradientDivider class="pt-10" />

  <section
    class="
      section-container-wide grid gap-8 pt-10
      lg:grid-cols-[1.1fr_0.9fr]
    "
    data-animate
  >
    <div class="prose-santi max-w-none">
      <Content />
    </div>

    {!!series.data.focusAreas.length && (
      <Card
        class="
          h-fit space-y-4 p-5
          sm:p-6
        "
        variant="muted"
      >
        <p class="section-label">Focus areas</p>
        <div class="flex flex-wrap gap-2">
          {series.data.focusAreas.map(area => (
            <Pill label={area} tone="outline" />
          ))}
        </div>
      </Card>
    )}
  </section>

  <PageSection>
    <SectionHeader
      description="Read these in order if you want the clearest progression from foundations to deeper implementation decisions."
      eyebrow="Posts"
      title="Articles in this series."
    />

    <div class="space-y-6">
      {posts.map((post, index) => (
        <div class="space-y-3">
          <p class="section-label">Part {index + 1}</p>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </PageSection>
</PageLayout>
