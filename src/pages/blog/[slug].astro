---
import { z } from 'astro/zod'

import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import PostLayout from '@/layouts/Post.astro'

import { getCachedPosts } from '@/utils/content'
import { getPostSlug } from '@/utils/posts'

export const getStaticPaths = async () => {
  const posts = await getCachedPosts()

  return posts.map(post => ({
    params: { slug: getPostSlug(post.id) },
    props: { post }
  }))
}

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const figureCaptions = z.array(z.string()).parse(remarkPluginFrontmatter.articleFigureCaptions ?? [])
const recommendationUrls = z.array(z.string()).parse(remarkPluginFrontmatter.articleRecommendationUrls ?? [])
const printReferences = z.array(z.object({ href: z.url(), label: z.string().min(1) })).parse(remarkPluginFrontmatter.articlePrintReferences ?? [])
---

<PostLayout post={post} headings={headings} figureCaptions={figureCaptions} recommendationUrls={recommendationUrls} printReferences={printReferences}>
  <Content />
</PostLayout>
