---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import PageSection from '@/components/organisms/PageSection.astro'

import { usesHighlights, usesSections } from '@/data/profile'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const description =
  'A practical look at the tools, workflow defaults, and setup principles Santiago Molina uses for engineering leadership, architecture, writing, and delivery.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Uses', url: '/uses/' }
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    description,
    mainEntity: {
      '@type': 'Person',
      knowsAbout: [
        'TypeScript',
        'React',
        'Astro',
        'Node.js',
        'Developer Experience',
        'Engineering Leadership'
      ],
      name: siteConfig.author
    },
    name: 'Uses'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: 'Tools and workflow defaults used by Santiago Molina',
    itemListElement: usesSections.flatMap((section, sectionIndex) => section.items.map((item, itemIndex) => ({
      '@type': 'ListItem',
      description: item.value,
      name: `${section.title} — ${item.label}`,
      position: sectionIndex * 100 + itemIndex + 1
    }))),
    name: 'Uses & workflow setup'
  }
]
---

<PageLayout meta={{
  breadcrumbs,
  description,
  structuredData,
  title: 'Uses & Workflow'
}}
>
  <PageHero
    description="Tools, workflow defaults, and principles I keep returning to. Less gear shrine, more operating manual."
    eyebrow="Uses"
    gradientText="behind the day-to-day."
    title="Stack and workflow"
  >
    <ButtonLink href="/portfolio/" showArrow>
      See the portfolio
    </ButtonLink>
    <ButtonLink href="/speaking/" showArrow variant="secondary">
      Explore speaking
    </ButtonLink>
  </PageHero>

  <section
    class="
      grid gap-4
      sm:grid-cols-3
    "
    data-animate
  >
    {usesHighlights.map(highlight => (
      <div class="mini-note">
        <p class="section-label">{highlight.label}</p>
        <p class="mt-2 text-sm/7 text-ink-soft">{highlight.value}</p>
      </div>
    ))}
  </section>

  <PageSection>
    <SectionHeader
      eyebrow="Current setup"
      title="What I reach for most often."
    />
    <div class="space-y-6">
      {usesSections.map(section => (
        <section
          class="
            space-y-5 border-t border-line/45 pt-6
            first:border-t-0 first:pt-0
          "
          data-uses-section
        >
          <div class="space-y-2">
            <p class="section-label">{section.title}</p>
            <p class="text-base/7 text-ink-soft">{section.description}</p>
          </div>
          <dl
            class="
              grid gap-4
              lg:grid-cols-3
            "
            data-stagger="50"
          >
            {section.items.map(item => (
              <div class="panel-card p-5">
                <dt class="section-label">{item.label}</dt>
                <dd class="mt-3 text-sm/7 text-ink-soft">{item.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      eyebrow="Operating principle"
      title="Good tools disappear into the work."
    />
    <div class="space-y-6">
      <div
        class="
          grid gap-4
          sm:grid-cols-2
        "
        data-stagger="60"
      >
        <div class="mini-note">
          <p class="section-label">Worth optimizing</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            Fast local feedback, clear documentation, dependable testing, and automation that makes release work
            feel calmer.
          </p>
        </div>
        <div class="mini-note">
          <p class="section-label">Usually not worth it</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            Chasing novelty for its own sake, rebuilding stable systems without a product reason, or adding
            process that only looks rigorous from a distance.
          </p>
        </div>
      </div>
    </div>
  </PageSection>
</PageLayout>
