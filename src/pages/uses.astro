---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import { usesHighlights, usesSections } from '@/data/profile'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const description =
  'A practical look at the tools, workflow defaults, and setup principles Santiago Molina uses for engineering leadership, architecture, writing, and delivery.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Uses', url: '/uses/' }
]

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    description,
    mainEntity: {
      '@type': 'Person',
      knowsAbout: [
        'TypeScript',
        'React',
        'Astro',
        'Node.js',
        'Developer Experience',
        'Engineering Leadership'
      ],
      name: siteConfig.author
    },
    name: 'Uses'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    description: 'Tools and workflow defaults used by Santiago Molina',
    itemListElement: usesSections.flatMap((section, sectionIndex) => section.items.map((item, itemIndex) => ({
      '@type': 'ListItem',
      description: item.value,
      name: `${section.title} — ${item.label}`,
      position: sectionIndex * 100 + itemIndex + 1
    }))),
    name: 'Uses & workflow setup'
  }
]
---

<PageLayout meta={{
  breadcrumbs,
  description,
  structuredData,
  title: 'Uses & Workflow'
}}
>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Uses"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Stack and workflow
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">behind the day-to-day.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Less a gear shrine, more a map of the setup I keep returning to — tools, workflow defaults, and working principles that help me ship consistently.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href="/portfolio/" showArrow>
            See the portfolio
          </ButtonLink>
          <ButtonLink href="/speaking/" showArrow variant="secondary">
            Explore speaking
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <section
    class="
      grid gap-4
      sm:grid-cols-3
    "
    data-animate
  >
    {usesHighlights.map(highlight => (
      <div class="mini-note">
        <p class="section-label">{highlight.label}</p>
        <p class="mt-2 text-sm/7 text-ink-soft">{highlight.value}</p>
      </div>
    ))}
  </section>

  <PageSection>
    <SectionHeader
      description="The exact setup changes over time, but these are the patterns and tools that show up most often in how I build, lead, and keep work moving."
      eyebrow="Current setup"
      title="What I reach for most often."
    />
    <div class="space-y-6">
      {usesSections.map(section => (
        <article class="
          panel-card space-y-6 p-6
          sm:p-7
        "
        >
          <div class="space-y-3">
            <p class="section-label">{section.title}</p>
            <p class="text-base/7 text-ink-soft">{section.description}</p>
          </div>
          <div
            class="
              grid gap-4
              lg:grid-cols-3
            "
          >
            {section.items.map(item => (
              <div class="mini-note">
                <p class="section-label">{item.label}</p>
                <p class="mt-3 text-sm/7 text-ink-soft">{item.value}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </PageSection>

  <PageSection>
    <SectionHeader
      description="The tools matter because they support the work. The work itself is still about helping teams build better software with less avoidable friction."
      eyebrow="Operating principle"
      title="A useful setup should disappear into the background."
    />
    <div class="space-y-6">
      <article class="
        panel-card space-y-4 p-6
        sm:p-7
      "
      >
        <p class="text-base/7 text-ink-soft">
          If a tool improves clarity, feedback speed, quality, or collaboration, I keep it. If it turns into
          performative complexity, I lose interest quickly. That bias shows up in the technologies I choose,
          the standards I introduce, and the kind of delivery systems I build around a team.
        </p>
      </article>
      <div
        class="
          grid gap-4
          sm:grid-cols-2
        "
      >
        <div class="mini-note">
          <p class="section-label">Worth optimizing</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            Fast local feedback, clear documentation, dependable testing, and automation that makes release work
            feel calmer.
          </p>
        </div>
        <div class="mini-note">
          <p class="section-label">Usually not worth it</p>
          <p class="mt-3 text-sm/7 text-ink-soft">
            Chasing novelty for its own sake, rebuilding stable systems without a product reason, or adding
            process that only looks rigorous from a distance.
          </p>
        </div>
      </div>
    </div>
  </PageSection>
</PageLayout>
