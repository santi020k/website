---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import Link from '@santi020k/lumen-astro/components/Link'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

const description =
  t('page.accessibilityCommitmentForSanti020kComWcag')

/** Single source of truth for the review date shown in the hero and the footnote. */
const lastReviewed = t('page.july262026')

const breadcrumbs = [
  { name: t('nav.home'), url: localizePath('/', pageLocale) },
  { name: t('shared.accessibility'), url: localizePath('/accessibility/', pageLocale) }
]

const meta = {
  breadcrumbs,
  description,
  title: t('page.accessibilityStatement')
}

const sections = [
  {
    label: t('page.targetStandard'),
    body: t('page.wcag22LevelAaKeyboard')
  },
  {
    label: t('page.howWeWorkTowardIt'),
    body: t('page.semanticHtmlLandmarksAndLabeledInteractive')
  },
  {
    label: t('page.knownLimits'),
    body: t('page.personalSiteMaintainedAlongsideOtherWork')
  },
  {
    label: t('page.formalComplaints'),
    body: t('page.thisStatementDoesNotReplaceApplicable')
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <article class="space-y-12">
    <PageHero
      description={t('page.wcag22AaIsThe')}
      eyebrow={t('page.inclusion')}
      gradientText={t('page.statement')}
      metaItems={[t('page.keyboardFirst'), t('page.reducedMotion'), `${t('page.reviewed')} ${lastReviewed}`]}
      title={t('shared.accessibility')}
    />

    <PolicySections {sections} />

    <PolicyContactCard label={t('page.reportABarrier')} title={t('page.ifSomethingBlocksYouSendThe')}>
      <p>
        {t('page.email')}{' '}
        <Link
variant="inherit"
href={localizePath(`mailto:${siteConfig.contact.email}?subject=Accessibility%20issue%20on%20santi020k.com`, pageLocale)}
        >
          {siteConfig.contact.email}
        </Link>
        {' '}{t('page.withThePageUrlYourBrowser')}
      </p>
      <p slot="note">
        {t('page.lastReviewed')} {lastReviewed}{t('page.iAimToAcknowledgeReportsWithin')}
      </p>
    </PolicyContactCard>
  </article>

  <div class="section-container-wide section-actions">
    <ButtonLink href={localizePath('/', pageLocale)} showArrow variant="secondary">
      {t('page.backHome')}
    </ButtonLink>
    <ButtonLink href={localizePath('/privacy/', pageLocale)} showArrow variant="ghost">
      {t('page.privacyStatement')}
    </ButtonLink>
  </div>
</PageLayout>
