---
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const description =
  'Accessibility commitment for santi020k.com: WCAG 2.2 AA as the target, practical limits of a solo-maintained site, and how to report barriers.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Accessibility', url: '/accessibility/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Accessibility statement'
}
---

<PageLayout meta={meta}>
  <article
    class="
      mx-auto max-w-3xl space-y-10 animate-slide-up
      motion-reduce:animate-none
    "
  >
    <header class="space-y-3">
      <p class="section-label">Inclusion</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-ink">
        Accessibility statement
      </h1>
      <p class="text-base/7 text-ink-soft">
        Everyone should be able to use this site comfortably. This page summarizes the standard the project aims for,
        where gaps can still appear, and how to get help if something blocks you.
      </p>
    </header>

    <div class="prose-santi max-w-none space-y-8 text-ink-soft">
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">Goal</h2>
        <p>
          This site is built and tested with <strong class="font-semibold text-ink">WCAG 2.2 Level AA</strong> as the
          target. That includes keyboard use, visible focus, meaningful structure, sufficient contrast for core text
          and controls, and respect for <strong class="font-semibold text-ink">reduced motion</strong> preferences
          where animations are used.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">How we work toward it</h2>
        <ul class="list-disc space-y-2 pl-5">
          <li>Semantic HTML, landmarks, and labels on interactive components.</li>
          <li>Automated checks in CI (including accessibility-focused tests) alongside manual review.</li>
          <li>Readable typography and resilient layouts across common zoom levels and viewports.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">Known limits</h2>
        <p>
          This is a personal site maintained alongside other work. Third-party embeds (for example video or audio
          players if added later) may not always meet the same bar as first-party pages. Older articles or legacy
          markup can occasionally lag behind the current template until they are refreshed.
        </p>
        <p>
          If automated tooling flags something that is a false positive, or if a real issue is hard to fix quickly, it
          will be tracked and prioritized like any other defect affecting readers.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">Reporting a barrier</h2>
        <p>
          If you cannot complete a task on this site because of accessibility, please email{' '}
          <a class="font-medium text-brand hover:underline" href={`mailto:${siteConfig.contact.email}?subject=Accessibility%20issue%20on%20santi020k.com`}>
            {siteConfig.contact.email}
          </a>
          . Include the page URL, your browser and assistive technology if you can, and what you were trying to do.
          You should receive a substantive reply once the message is seen.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-ink">Formal complaints</h2>
        <p>
          This statement does not replace applicable law. If you need an escalation path beyond direct contact, you may
          use the same email to request alternative formats or further information about how issues are handled.
        </p>
      </section>
    </div>
  </article>
</PageLayout>
