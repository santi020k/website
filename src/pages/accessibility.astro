---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { translatePage } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = (source: string) => translatePage(pageLocale, source)

const description =
  t('Accessibility commitment for santi020k.com: WCAG 2.2 AA as the target, practical limits of a solo-maintained site, and how to report barriers.')

/** Single source of truth for the review date shown in the hero and the footnote. */
const lastReviewed = t('July 26, 2026')

const breadcrumbs = [
  { name: t('Home'), url: localizePath('/', pageLocale) },
  { name: t('Accessibility'), url: localizePath('/accessibility/', pageLocale) }
]

const meta = {
  breadcrumbs,
  description,
  title: t('Accessibility statement')
}

const sections = [
  {
    label: t('Target standard'),
    body: t('WCAG 2.2 Level AA — keyboard navigation, visible focus, meaningful structure, sufficient contrast, and reduced-motion respect throughout.')
  },
  {
    label: t('How we work toward it'),
    body: t('Semantic HTML, landmarks, and labeled interactive components. Automated CI checks alongside manual review. Resilient layouts across zoom levels and viewports.')
  },
  {
    label: t('Known limits'),
    body: t('Personal site maintained alongside other work. Third-party embeds may lag behind first-party pages. Older articles are refreshed on a rolling basis.')
  },
  {
    label: t('Formal complaints'),
    body: t('This statement does not replace applicable law. Use the email below to request alternative formats or further information about how issues are handled.')
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <article class="space-y-12">
    <PageHero
      description={t('WCAG 2.2 AA is the target. This is how the site is built, checked, and improved when something falls short.')}
      eyebrow={t('Inclusion')}
      gradientText={t('statement.')}
      metaItems={[t('Keyboard first'), t('Reduced motion'), `${t('Reviewed')} ${lastReviewed}`]}
      title={t('Accessibility')}
    />

    <PolicySections {sections} />

    <PolicyContactCard label={t('Report a barrier')} title={t('If something blocks you, send the exact page and task.')}>
      <p>
        {t('Email')}{' '}
        <Link
variant="inherit"
href={localizePath(`mailto:${siteConfig.contact.email}?subject=Accessibility%20issue%20on%20santi020k.com`, pageLocale)}
        >
          {siteConfig.contact.email}
        </Link>
        {' '}{t('with the page URL, your browser, assistive technology, and what you were trying to do.')}
      </p>
      <p slot="note">
        {t('Last reviewed')} {lastReviewed}{t('. I aim to acknowledge reports within five business days and share a resolution timeline once the barrier is reproduced.')}
      </p>
    </PolicyContactCard>
  </article>

  <div class="section-container-wide section-actions">
    <ButtonLink href={localizePath('/', pageLocale)} showArrow variant="secondary">
      {t('Back home')}
    </ButtonLink>
    <ButtonLink href={localizePath('/privacy/', pageLocale)} showArrow variant="ghost">
      {t('Privacy statement')}
    </ButtonLink>
  </div>
</PageLayout>
