---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import PolicyContactCard from '@/components/molecules/PolicyContactCard.astro'
import PolicySections from '@/components/molecules/PolicySections.astro'
import PageLayout from '@/layouts/Base.astro'

import { Link } from '@santi020k/lumen-astro'

import { siteConfig } from '@/site.config'

const description =
  'Accessibility commitment for santi020k.com: WCAG 2.2 AA as the target, practical limits of a solo-maintained site, and how to report barriers.'

/** Single source of truth for the review date shown in the hero and the footnote. */
const lastReviewed = 'July 26, 2026'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Accessibility', url: '/accessibility/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Accessibility statement'
}

const sections = [
  {
    label: 'Target standard',
    body: 'WCAG 2.2 Level AA — keyboard navigation, visible focus, meaningful structure, sufficient contrast, and reduced-motion respect throughout.'
  },
  {
    label: 'How we work toward it',
    body: 'Semantic HTML, landmarks, and labeled interactive components. Automated CI checks alongside manual review. Resilient layouts across zoom levels and viewports.'
  },
  {
    label: 'Known limits',
    body: 'Personal site maintained alongside other work. Third-party embeds may lag behind first-party pages. Older articles are refreshed on a rolling basis.'
  },
  {
    label: 'Formal complaints',
    body: 'This statement does not replace applicable law. Use the email below to request alternative formats or further information about how issues are handled.'
  }
]
---

<PageLayout mainClass="remaining-pages" footerVariant="compact" meta={meta}>
  <article class="space-y-12">
    <PageHero
      description="WCAG 2.2 AA is the target. This is how the site is built, checked, and improved when something falls short."
      eyebrow="Inclusion"
      gradientText="statement."
      metaItems={['Keyboard first', 'Reduced motion', `Reviewed ${lastReviewed}`]}
      title="Accessibility"
    />

    <PolicySections {sections} />

    <PolicyContactCard label="Report a barrier" title="If something blocks you, send the exact page and task.">
      <p>
        Email{' '}
        <Link
variant="inherit"
href={`mailto:${siteConfig.contact.email}?subject=Accessibility%20issue%20on%20santi020k.com`}
        >
          {siteConfig.contact.email}
        </Link>
        {' '}with the page URL, your browser, assistive technology, and what you were trying to do.
      </p>
      <p slot="note">
        Last reviewed {lastReviewed}. I aim to acknowledge reports within five business days and share a
        resolution timeline once the barrier is reproduced.
      </p>
    </PolicyContactCard>
  </article>

  <div class="section-container-wide section-actions">
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/privacy/" showArrow variant="ghost">
      Privacy statement
    </ButtonLink>
  </div>
</PageLayout>
