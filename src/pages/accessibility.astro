---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import PageLayout from '@/layouts/Base.astro'
import { siteConfig } from '@/site.config'

const description =
  'Accessibility commitment for santi020k.com: WCAG 2.2 AA as the target, practical limits of a solo-maintained site, and how to report barriers.'

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Accessibility', url: '/accessibility/' }
]

const meta = {
  breadcrumbs,
  description,
  title: 'Accessibility statement'
}

const sections = [
  {
    label: 'Target standard',
    body: 'WCAG 2.2 Level AA — keyboard navigation, visible focus, meaningful structure, sufficient contrast, and reduced-motion respect throughout.'
  },
  {
    label: 'How we work toward it',
    body: 'Semantic HTML, landmarks, and labeled interactive components. Automated CI checks alongside manual review. Resilient layouts across zoom levels and viewports.'
  },
  {
    label: 'Known limits',
    body: 'Personal site maintained alongside other work. Third-party embeds may lag behind first-party pages. Older articles are refreshed on a rolling basis.'
  },
  {
    label: 'Formal complaints',
    body: 'This statement does not replace applicable law. Use the email below to request alternative formats or further information about how issues are handled.'
  }
]
---

<PageLayout meta={meta}>
  <section class="relative pb-4">
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Inclusion"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Built for
          <span class="block bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent pb-4">everyone.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          WCAG 2.2 AA is the target. Here's what that means in practice and how to flag anything that falls short.
        </p>
      </div>
    </div>
  </section>

  <div
    class="
      grid gap-4
      sm:grid-cols-2
    "
    data-stagger="60"
  >
    {sections.map(({ label, body }) => (
      <div class="mini-note h-full">
        <p class="section-label">{label}</p>
        <p class="mt-3 text-sm/7 text-ink-soft">{body}</p>
      </div>
    ))}
  </div>

  <div class="mini-note max-w-xl" data-animate>
    <p class="section-label">Report a barrier</p>
    <p class="mt-2 text-sm/7 text-ink-soft">
      Can't complete a task? Email{' '}
      <a
        class="font-medium text-brand transition-colors hover:text-accent"
        href={`mailto:${siteConfig.contact.email}?subject=Accessibility%20issue%20on%20santi020k.com`}
      >
        {siteConfig.contact.email}
      </a>
      {' '}with the page URL, your browser, assistive technology, and what you were trying to do.
    </p>
  </div>

  <div class="section-actions" data-animate>
    <ButtonLink href="/" showArrow variant="secondary">
      Back home
    </ButtonLink>
    <ButtonLink href="/privacy/" showArrow variant="ghost">
      Privacy statement
    </ButtonLink>
  </div>
</PageLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-stagger] > * {
      opacity: 0;
      transform: translateY(14px);
      animation: a11y-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    [data-stagger="60"] > *:nth-child(1) { animation-delay: 0ms; }
    [data-stagger="60"] > *:nth-child(2) { animation-delay: 60ms; }
    [data-stagger="60"] > *:nth-child(3) { animation-delay: 120ms; }
    [data-stagger="60"] > *:nth-child(4) { animation-delay: 180ms; }

    [data-animate] {
      opacity: 0;
      transform: translateY(10px);
      animation: a11y-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
    }

    @keyframes a11y-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
