---
import type { TocItem } from '@/utils/generate-toc'

interface Props {
  heading: TocItem
}

const {
  heading: { children, slug, text }
} = Astro.props;
---

<li class="flex flex-col gap-2">
  <a
    aria-label={`Scroll to section: ${text}`}
    class="
      line-clamp-2 pl-[1ch] indent-[-1ch] wrap-break-word
      before:content-['#']
    "
    href={`#${slug}`}
  >{text}
  </a>
  {!!children.length && (
    <ul class="ml-4 flex flex-col gap-2">
      {children.map(subheading => (
        <Astro.self heading={subheading} />
      ))}
    </ul>
  )}
</li>
