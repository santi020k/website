---
import { Image } from 'astro:assets'
import { type CollectionEntry } from 'astro:content'

// import { Icon } from 'astro-icon/components'
import Badge from '@/components/Badge.astro'
import FormattedDate from '@/components/FormattedDate.astro'

import { dateWithoutDay } from '@/utils/date-format-presets'

interface Props {
  content: CollectionEntry<'project'>
}

const { content } = Astro.props

// const projectTypes = !!content.data.typesId && await getCollection('types')
//   .then(types => types.find(s => s.id === content.data.typesId))
//   .catch((err) => {
//     console.error('Failed to find types:', err)
//     return null
//   })
---

<div class="
  bg-white/95 px-2 py-4 backdrop-blur-xl
  md:sticky md:top-0 md:z-10
  dark:bg-black/80
"
>
  <div class="flex justify-between">
    <div class="flex flex-col">
      <h1
        class="
          line-clamp-none
          md:sticky md:top-4 md:z-20 md:line-clamp-1
        "
        title={content.data.title}
        data-pagefind-body
        transition:name={`project-title-${content.id}`}
      >
        {content.data.title}
      </h1>

      <div
        transition:name={`project-subtitle-${content.id}`}
        class="
          flex flex-col items-start gap-0
          sm:flex-row sm:items-center sm:gap-2
        "
      >
        <p>
          {content.data.rol}
        </p>
        <div class="flex flex-wrap items-center text-sm">
          (
          <span class="flex h-7 items-center">
            <!-- <Icon aria-hidden="true" class="me-1 flex size-4 items-center" focusable="false" name="hugeicons:calendar-03" /> -->
            <FormattedDate
              date={content.data.startingDate}
              dateTimeOptions={dateWithoutDay}
              class="flex shrink-0"
            />
            <span class="px-2">–</span>
            {
              content.data.endingDate ?
                (
                  <span class="
                    flex h-7 shrink-0 items-center gap-x-1 rounded-lg text-sm
                  "
                  >
                    <FormattedDate class="flex shrink-0" date={content.data.endingDate} dateTimeOptions={dateWithoutDay} />
                  </span>
                ) :
                (
                  <span class="
                    flex h-7 shrink-0 items-center gap-x-1 rounded-lg px-2 py-1
                    text-sm
                  "
                  >
                    Present
                  </span>
                )
            }
          </span>
          )
        </div>
      </div>
    </div>
    {content.data.draft && (
      <div class="flex items-center">
        <span class="ml-2 text-base text-red-500">(Draft)</span>
      </div>
    )}
  </div>
</div>

{
  content.data.coverImage && (
    <div class="
      mt-2 mb-4 overflow-auto rounded-lg shadow-xl
      dark:shadow-gray-900
    "
    >
      <Image
        alt={content.data.coverImage.alt}
        class="object-cover"
        fetchpriority="high"
        priority
        width="1600"
        height="900"
        src={content.data.coverImage.src}
        transition:name={`cover-image-${content.id}`}
      />
    </div>
  )
}

<p
  class="mx-2 max-w-none"
  data-pagefind-body
  transition:name={`project-description-${content.id}`}
>
  {content.data.description}
</p>

<div class="mx-1 mt-4 flex flex-wrap items-center gap-2" transition:name={`project-badges-${content.id}`}>
  {/* Tags */}
  {
    content.data.technologies?.length ?
      (
        <>
          {content.data.technologies.map(technology => (
            <a aria-label={`View all projects with the technology: ${technology}`} href={`/technologies/${technology}`}>
              <Badge variant="accent-two" title={technology} />
            </a>
          ))}
        </>
      ) :
      (
        <span class="text-sm">No tags</span>
      )
  }

  <!-- TODO: I want to have this information in another place -->
  <!-- {
    projectTypes
      ? (
          <div class="flex items-center gap-2">
            <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:notes-line-duotone" />
            <a
              aria-label={`About ${projectTypes.data.title} types`}
              href={`/types/${projectTypes.id}`}
              class="flex flex-wrap items-center gap-2"
            >
              <Badge variant="accent-base" showHash={false} title={projectTypes.data.title} />
            </a>
          </div>
        )
      : (
          <div class="flex items-center gap-2">
            <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:notes-line-duotone" />
            <span class="text-sm">Not in types</span>
          </div>
        )
  } -->
</div>
