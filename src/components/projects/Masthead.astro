---
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

import Badge from '@/components/Badge.astro'
import FormattedDate from '@/components/FormattedDate.astro'

import Separator from '../Separator.astro'

interface Props {
  content: CollectionEntry<'project'>
}

const { content } = Astro.props

const dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'long'
}

const projectTypes = !!content.data.typesId && await getCollection('types')
  .then(types => types.find(s => s.id === content.data.typesId))
  .catch((err) => {
    console.error('Failed to find types:', err)
    return null
  })
---

<div class="flex items-end md:sticky md:top-8 md:z-10">
  {
    !!projectTypes && (
      <button
        id="toggle-panel"
        class="mr-2 hidden size-8 shrink-0 items-center justify-center rounded-lg hover:brightness-110 md:flex"
        aria-label="Toggle Series Panel"
        aria-controls="series-panel"
      >
        <Icon aria-hidden="true" class="size-6 shrink-0" focusable="false" name="solar:notes-bold" />
      </button>
    )
  }

  {
    !!(content.rendered?.metadata?.headings as unknown[] | undefined)?.length && (
      <button
        id="toggle-toc"
        class="hidden size-8 shrink-0 items-center justify-center rounded-lg hover:brightness-110 md:flex"
        aria-label="Table of Contents"
      >
        <Icon aria-hidden="true" class="size-6" focusable="false" name="solar:clipboard-list-bold" />
      </button>
    )
  }

  <h1
    class="ml-2 line-clamp-none md:sticky md:top-4 md:z-20 md:line-clamp-1 md:max-w-[calc(100%-10rem)]"
    title={content.data.title}
    data-pagefind-body
  >
    {content.data.title}
  </h1>
</div>

<div class="mx-2 mb-2 flex flex-wrap items-center text-sm">
  <span class="flex h-7 items-center">
    <Icon aria-hidden="true" class="me-1 flex size-4 items-center" focusable="false" name="hugeicons:calendar-03" />
    <FormattedDate date={content.data.startingDate} dateTimeOptions={dateTimeOptions} class="flex shrink-0" />
  </span>
  <Separator type="dot" />
  <span class="flex h-7 items-center">
    <Icon aria-hidden="true" class="me-1 flex size-4 items-center" focusable="false" name="hugeicons:book-open-01" />
    {/* @ts-ignore:next-line. TODO: add reading time to collection schema? */}
    {content.rendered?.metadata?.frontmatter?.readingTime ? `${content.rendered.metadata.frontmatter.readingTime}` : 'Less than one minute read'}
  </span>
  {
    content.data.endingDate && (
      <Separator type="dot" />
      <span class="flex h-7 shrink-0 items-center gap-x-1 rounded-lg px-2 py-1 text-sm">
        Updated:<FormattedDate class="flex shrink-0" date={content.data.endingDate} dateTimeOptions={dateTimeOptions} />
      </span>
    )
  }
</div>

{content.data.draft ? <span class="ml-2 text-base text-red-500">(Draft)</span> : null}

{
  content.data.coverImage && (
    <div class="mb-4 mt-2 overflow-auto rounded-lg">
      <Image
        alt={content.data.coverImage.alt}
        class="object-cover"
        fetchpriority="high"
        loading="lazy"
        src={content.data.coverImage.src}
      />
    </div>
  )
}

<p
  class="mx-2 max-w-none"
  data-pagefind-body
>
  {content.data.description}
</p>

<div class="mx-1 mt-4 flex flex-wrap items-center gap-2">
  {/* Tags */}
  {
    content.data.technologies?.length
      ? (
      <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:tag-line-duotone" />
      <>
        {content.data.technologies.map(technology => (
          <a aria-label={`View all projects with the technology: ${technology}`} href={`/technologies/${technology}`}>
            <Badge variant="accent-two" title={technology} />
          </a>
        ))}
      </>
        )
      : (
      <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:tag-line-duotone" />
      <span class="text-sm">No tags</span>
        )
  }

  {
    projectTypes
      ? (
          <div class="flex items-center gap-2">
            <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:notes-line-duotone" />
            <a
              aria-label={`About ${projectTypes.data.title} types`}
              href={`/types/${projectTypes.id}`}
              class="flex flex-wrap items-center gap-2"
            >
              <Badge variant="accent-base" showHash={false} title={projectTypes.data.title} />
            </a>
          </div>
        )
      : (
          <div class="flex items-center gap-2">
            <Icon aria-hidden="true" class="inline-block size-6 shrink-0" focusable="false" name="solar:notes-line-duotone" />
            <span class="text-sm">Not in types</span>
          </div>
        )
  }
</div>
