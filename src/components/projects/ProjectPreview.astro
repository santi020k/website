---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import Badge from '@/components/Badge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import Separator, { SeparatorType } from '@/components/Separator.astro'

import { dateWithoutDay } from '@/utils/date-format-presets'

interface Props {
  project: CollectionEntry<'project'>
  withDesc?: boolean
}

const { project } = Astro.props;
---

<a href={`/portfolio/${project.id}/`} class="group relative flex flex-col gap-y-4 rounded-xl p-6 transition-all duration-300 hover:bg-stone-100 hover:shadow-xl dark:hover:bg-stone-800">
  {project.data.coverImage?.src && (
    <div class="relative block overflow-hidden rounded-xl shadow-xl dark:shadow-gray-900">
      <Image
        src={project.data.coverImage.src}
        alt={project.data.coverImage.alt || project.data.title}
        class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        transition:name="cover-image"
      />
    </div>
  )}

  <div class="flex flex-col gap-y-3">
    <div>
      <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
        {project.data.title}
      </h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {project.data.rol && (
          <>
            {project.data.rol}
            <Separator type={SeparatorType.Dot} />
          </>
        )}
        <FormattedDate dateTimeOptions={dateWithoutDay} date={project.data.startingDate} />
        {project.data.endingDate
          ? (
              <> – <FormattedDate dateTimeOptions={dateWithoutDay} date={project.data.endingDate} /></>
            )
          : '- Present'}
      </p>
    </div>

    <div class="flex flex-col gap-y-2">
      <p class="line-clamp-2 text-sm text-zinc-600 dark:text-zinc-400">
        {project.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-2">
        {
          project.data.technologies.slice(0, 5).map(technology => (
            <div class="flex items-center gap-x-2">
              <Badge variant="outline" class="hover:border-lightest" showHash={false} title={technology} />
            </div>
          ))
        }

        {project.data.technologies.length > 5 && (
          <div class="flex items-center gap-x-2">
            <Badge variant="outline" class="hover:border-lightest" showHash={false} title={`+${project.data.technologies.length - 5} more`} />
          </div>
        )}
      </div>
    </div>

  </div>
</a>
