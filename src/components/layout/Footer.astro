---
import { menuLinks, siteConfig } from '@/site.config'

const year = new Date().getFullYear();
---

<footer
  class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pb-4 pt-8 text-center align-top text-accent sm:flex-row sm:justify-between sm:text-sm"
>
  <div class="me-0 font-semibold sm:me-4">
    &copy; {siteConfig.author}
    {year}.<span class="inline-block">&nbsp;🚀&nbsp;</span>
  </div>
  <nav
    aria-label="More on this site"
    class="flex w-auto justify-between space-x-4 font-medium text-light md:w-56"
  >
    <a class="underline-offset-2 hover:text-accent hover:underline m-0 flex items-center" href="https://linkedin.com/in/santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-linkedin] w-6 h-6"></span>
    </a>
    <a class="underline-offset-2 hover:text-accent hover:underline m-0 flex items-center" href="https://www.instagram.com/santi020k/" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-instagram] w-6 h-6"></span>
    </a>
    <a class="underline-offset-2 hover:text-accent hover:underline m-0 flex items-center" href="https://github.com/santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-github] w-6 h-6"></span>
    </a>
    <a class="underline-offset-2 hover:text-accent hover:underline m-0 flex items-center" href="https://api.whatsapp.com/send?phone=573217156893&text=%F0%9F%98%86" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-whatsapp] w-6 h-6"></span>
    </a>
    <a class="underline-offset-2 hover:text-accent hover:underline m-0 flex items-center" href="https://medium.com/@santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-medium] w-6 h-6"></span>
    </a>
  </nav>
</footer>
