---
import { siteConfig } from '@/site.config'

const year = new Date().getFullYear();
---

<footer
  class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pb-4 pt-8 text-center align-top sm:flex-row sm:justify-between sm:text-sm"
>
  <div class="me-0 font-semibold sm:me-4">
    &copy; {siteConfig.author}
    {year}.<span class="inline-block">&nbsp;🚀&nbsp;</span>
  </div>
  <nav
    aria-label="More on this site"
    class="flex w-auto justify-between space-x-4 font-medium md:w-56"
  >
    <a class="m-0 flex items-center underline-offset-2 hover:underline" href="https://linkedin.com/in/santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-linkedin] size-6"></span>
    </a>
    <a class="m-0 flex items-center underline-offset-2 hover:underline" href="https://www.instagram.com/santi020k/" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-instagram] size-6"></span>
    </a>
    <a class="m-0 flex items-center underline-offset-2 hover:underline" href="https://github.com/santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-github] size-6"></span>
    </a>
    <a class="m-0 flex items-center underline-offset-2 hover:underline" href="https://api.whatsapp.com/send?phone=573217156893&text=Hi%2C%20I%20came%20across%20your%20website%20and%20wanted%20to%20get%20in%20touch" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-whatsapp] size-6"></span>
    </a>
    <a class="m-0 flex items-center underline-offset-2 hover:underline" href="https://medium.com/@santi020k" target="_blank" rel="noopener noreferrer">
      <span class="icon-[tabler--brand-medium] size-6"></span>
    </a>
  </nav>
</footer>
