---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

// TODO: Not Implemented yet
// import Search from '@/components/Search.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'

import LogoSVG from '@/assets/svg/logo.svg'
import { menuLinks, siteConfig } from '@/site.config';
---

<header
  id="main-header"
  class="fixed left-0 top-0 z-20 flex h-16 w-full items-center bg-white/20 px-4 backdrop-blur-xl md:relative md:px-0 md:backdrop-blur-none dark:bg-black/20"
>
  <div class="w-full justify-between sm:flex-col">
    <div class="flex items-center gap-x-2">
      <a
        aria-label={siteConfig.title}
        aria-current={Astro.url.pathname === '/' ? 'page' : false}
        class="group flex h-8 items-center hover:filter-none sm:relative"
        href="/"
      >
        <div title={siteConfig.title} class="p-2">
          <Image src={LogoSVG} alt="Santi020k Logo" width="140" height="100" fetchpriority="high" class="inline-block size-24 fill-current" />
        </div>
      </a>
      <nav
        aria-label="Main menu"
        class="top-20 mx-auto mr-4 hidden flex-col items-end justify-center gap-x-4 rounded-md text-base font-medium shadow backdrop-blur group-[.menu-open]:z-50 group-[.menu-open]:flex sm:static sm:z-auto sm:flex-row sm:items-center sm:rounded-none sm:bg-transparent sm:shadow-none sm:backdrop-blur-none md:flex"
        id="main-navigation-menu"
      >
        {
          menuLinks.map(link => (
            <a
              aria-current={Astro.url.pathname === link.path ? 'page' : false}
              class="underline-offset-2 hover:underline"
              data-astro-prefetch
              href={link.path}
            >
              {link.title}
            </a>
          ))
        }
        <!-- TODO: Temporal Blog link to medium -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 hover:underline"
          data-astro-prefetch
          href="https://medium.com/@santi020k"
        >
          Blog
        </a>
        <!-- Contact -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-2 hover:underline"
          data-astro-prefetch
          href="https://api.whatsapp.com/send?phone=573217156893&text=Hi%2C%20I%20came%20across%20your%20website%20and%20wanted%20to%20get%20in%20touch"
        >
          Contact
        </a>
      </nav>

      <div class="ml-auto w-fit md:ml-0">
        <div id="buttons-panel" class="top-4 ml-auto flex space-x-2 md:top-8 md:ml-0">
          <!-- TODO: Not Implemented yet -->
          <!-- <Search /> -->
          <ThemeToggle />
        </div>
      </div>

      <mobile-button
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="Open main menu"
        class="group relative size-8 cursor-pointer rounded-lg md:invisible md:hidden"
        id="toggle-nav-menu-mobile"
        type="button"
        role="button"
      >
        <Icon
          id="open-nav-menu-icon"
          aria-hidden="true"
          class="absolute start-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all"
          focusable="false"
          name="hugeicons:menu-01"
        />
        <Icon
          id="close-nav-menu-icon"
          aria-hidden="true"
          class="absolute start-1/2 top-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all"
          focusable="false"
          name="hugeicons:cancel-01"
        />
      </mobile-button>
    </div>
  </div>
</header>

<div id="drawer" class="fixed inset-0 z-10 hidden backdrop-blur-xl" aria-hidden="true">
  <div
    id="drawer-body"
    class="absolute inset-0 -translate-y-full transition-all duration-300 ease-in-out"
  >
    <nav
      aria-label="Mobile navigation menu"
      class="absolute inset-0 flex flex-col items-center justify-center gap-y-4 text-center text-lg font-medium"
      id="nav-menu-mobile"
    >
      {
        menuLinks.map(link => (
          <a
            aria-current={Astro.url.pathname === link.path ? 'page' : false}
            class="underline-offset-2 hover:underline"
            data-astro-prefetch
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
      <!-- TODO: Temporal Blog link to medium -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="underline-offset-2 hover:underline"
        data-astro-prefetch
        href="https://medium.com/@santi020k"
      >
        Blog
      </a>
    </nav>
  </div>
</div>

<script>
document.addEventListener('astro:page-load', () => {
  const toggleNavMenuMobileButton = document.getElementById('toggle-nav-menu-mobile')
  const openMenuIcon = document.getElementById('open-nav-menu-icon')
  const closeMenuIcon = document.getElementById('close-nav-menu-icon')
  const drawer = document.getElementById('drawer')

  if (!toggleNavMenuMobileButton || !openMenuIcon || !closeMenuIcon || !drawer) {
    console.error('One or more required elements are missing in the DOM.')

    return
  }

  const drawerBody = document.getElementById('drawer-body')

  if (!drawerBody) {
    console.error('Drawer body element is missing in the DOM.')

    return
  }

  toggleNavMenuMobileButton.addEventListener('click', () => {
    const isOpen = toggleNavMenuMobileButton.getAttribute('aria-expanded') === 'true'

    if (isOpen) {
      drawerBody.classList.add('opacity-0', '-translate-y-full')

      drawerBody.classList.remove('translate-y-0')

      setTimeout(() => {
        drawer.classList.add('hidden')
      }, 300)

      openMenuIcon.classList.add('scale-100', 'opacity-100')

      closeMenuIcon.classList.add('scale-0', 'opacity-0')

      closeMenuIcon.classList.remove('scale-100', 'opacity-100')
    } else {
      drawer.classList.remove('hidden')

      drawerBody.classList.add('translate-y-0')

      drawerBody.classList.remove('opacity-0', '-translate-y-full')

      openMenuIcon.classList.add('scale-0', 'opacity-0')

      closeMenuIcon.classList.add('scale-100', 'opacity-100')

      openMenuIcon.classList.remove('scale-100', 'opacity-100')
    }

    toggleNavMenuMobileButton.setAttribute('aria-expanded', (!isOpen).toString())
  })
})
</script>
