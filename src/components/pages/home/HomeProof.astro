---
import FaqList from '@/components/molecules/FaqList.astro'
import TestimonialCard from '@/components/molecules/TestimonialCard.astro'
import HomeSectionHeading from '@/components/pages/home/HomeSectionHeading.astro'

import { RevealGroup } from '@santi020k/lumen-astro'

import type { FaqItem } from '@/data/work-with-me'
import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'
import { getLocalizedProfile } from '@/i18n/profile'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)
const { testimonials } = getLocalizedProfile(pageLocale)

interface Props {
  faq: FaqItem[]
}

const { faq } = Astro.props
const homeTestimonials = testimonials.slice(0, 3)
---

<section aria-labelledby="home-testimonials-heading" class="studio-section" data-home-testimonials>
  <HomeSectionHeading
    action={t('page.readMoreRecommendations')}
    description={t('page.fromPeopleIVeManagedWorked')}
    eyebrow={t('page.inTheirWords')}
    href={localizePath('/about/#about-recommendations', pageLocale)}
    id="home-testimonials-heading"
    number="06"
    title={t('page.whatWorkingTogetherIsLike')}
  />
  <RevealGroup animation="slide-up" duration="slow" stagger={90} threshold={0} data-home-testimonial-grid>
    {homeTestimonials.map(({ avatarInitials, avatarUrl, name, quote, relationship, role }, index) => (
      <div data-home-testimonial data-featured={index === 0 || undefined}>
        <TestimonialCard authorName={name} avatarInitials={avatarInitials} avatarUrl={avatarUrl} quote={quote} relationship={relationship} role={role} />
      </div>
    ))}
  </RevealGroup>
</section>

<section aria-labelledby="home-faq-heading" class="studio-section" data-home-faq>
  <HomeSectionHeading
    action={t('shared.workWithMe')}
    description={t('page.talksRolesGrowingTeamsAiAnd')}
    eyebrow={t('page.questions')}
    href={localizePath(siteConfig.contact.workWithMe, pageLocale)}
    id="home-faq-heading"
    number="07"
    title={t('page.beforeYouWrite')}
  />
  <FaqList items={faq} />
</section>

<style>
  /* The community section above already ends with the section gap. */
  [data-home-testimonials] { padding-top: 0; }
  [data-home-testimonial-grid] { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 0 3rem; }
  [data-home-testimonial-grid] [data-home-testimonial] { min-width: 0; }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] { grid-row: span 2; }
  [data-home-testimonial-grid] [data-home-testimonial]:nth-child(2) { padding-bottom: 2rem; border-bottom: 1px solid var(--studio-rule); }
  [data-home-testimonial-grid] [data-home-testimonial]:nth-child(3) { padding-top: 2rem; }

  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial][data-slot='card']) {
    display: flex;
    flex-direction: column;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-body]) { display: block; padding: 0 0 1.5rem; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-quote]) { margin-bottom: 0.75rem; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-quote] svg) { width: 1.5rem; height: 1.5rem; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial] blockquote p) { font-size: 1.0625rem; line-height: 1.75; letter-spacing: -0.025em; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-identity]) {
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: start;
    gap: 0.375rem 0.875rem;
    margin: auto 0 0;
    padding: 0;
    border: 0;
  }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-avatar]) { grid-row: span 2; width: 2.75rem; height: 2.75rem; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-author]) { font-size: 0.9375rem; line-height: 1.6; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-identity] [data-testimonial-role]) { font-size: 0.8125rem; line-height: 1.65; }
  [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-identity] [data-testimonial-relationship]) {
    grid-column: 2;
    justify-self: start;
    max-width: none;
    font-size: 0.75rem;
    line-height: 1.65;
    text-align: left;
  }

  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial][data-slot='card']) { padding: 2.5rem; border-radius: 1.5rem; background: hsl(var(--surface-muted)); }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial-body]) { padding-bottom: 2.5rem; }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial-quote]) { margin-bottom: 1.5rem; }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial-quote] svg) { width: 2.5rem; height: 2.5rem; }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial] blockquote p) { font-size: 1.75rem; line-height: 1.5; letter-spacing: -0.04em; }
  [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial-identity]) { padding-top: 1.5rem; border-top: 1px solid var(--studio-rule); }
  [data-home-faq] { padding-bottom: 7rem; }

  @container home-content (width < 56rem) {
    [data-home-testimonial-grid] { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] { grid-row: auto; }
    [data-home-testimonial-grid] [data-home-testimonial]:nth-child(3) { padding-top: 0; }
  }
  @container home-content (width < 48rem) {
    [data-home-faq] { padding-bottom: 4.5rem; }
  }
  @container home-content (width < 28rem) {
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial][data-slot='card']) { padding: 1.5rem; }
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial-body]) { padding-bottom: 1.75rem; }
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial] blockquote p) { font-size: 1.375rem; }
  }
  @container home-content (width < 18rem) {
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial][data-slot='card']) { padding: 1.125rem; }
    [data-home-testimonial-grid] [data-home-testimonial][data-featured] :global([data-testimonial] blockquote p) { font-size: 1.125rem; line-height: 1.7; }
    [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-identity]) { grid-template-columns: minmax(0, 1fr); gap: 0.625rem; }
    [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-avatar]) { grid-row: auto; }
    [data-home-testimonial-grid] [data-home-testimonial] :global([data-testimonial-identity] [data-testimonial-relationship]) { grid-column: 1; }
  }
</style>
