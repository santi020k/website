---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'
import { getProjectOutcomeDisplay } from '@/utils/portfolio-metric'
import { getProjectBrandStyle } from '@/utils/project-brand'
import { getProjectCoverForUsage } from '@/utils/project-cover'
import { getProjectTimelineLabel } from '@/utils/project-meta'

import { Card, Icon } from '@santi020k/lumen-astro'

import SmithArtwork from '@/content/project/smith-commerce/cover-commerce-system.webp'

interface Props {
  project: CollectionEntry<'project'>
}

const { project } = Astro.props
const cover = project.id === 'smith-commerce' ? SmithArtwork : getProjectCoverForUsage(project.data.coverImage, 'hero')
const summary = project.data.impactMetrics[0]
const outcome = summary ? getProjectOutcomeDisplay(summary) : undefined
---

<Card as="article" class="studio-project" variant="unstyled" data-featured-work style={getProjectBrandStyle(project.data.brand)}>
  <a class="studio-project-link" href={getPortfolioPath(project.id)} data-project-card data-showcase-feature>
    <div data-work-spread>
      <div data-work-story>
        <p data-work-category>Selected experience</p>
        <h3>{project.data.title}</h3>
        <p data-work-description>{project.data.description}</p>
        <span data-work-action>View case study <Icon class="size-4" name="arrow-up-right" /></span>
      </div>
      <div data-work-artwork data-showcase-artwork>
        {cover && (
          <Image
            src={cover}
            alt=""
            width={960}
            widths={[400, 640, 960, 1280]}
            sizes="(min-width: 1200px) 680px, (min-width: 768px) 60vw, 100vw"
            format="webp"
            loading="lazy"
          />
        )}
      </div>
    </div>
    <div data-work-footer>
      {outcome && (
        <p data-work-outcome>
          {outcome.value ?
(
            <>
              <span class="sr-only">{summary}</span>
              <span data-work-score aria-hidden="true">
                {outcome.previous && <span data-work-previous>{outcome.previous}</span>}
                {outcome.previous && <Icon class="size-4" name="arrow-right" />}
                <strong>{outcome.value}</strong>
              </span>
              <span data-work-caption aria-hidden="true">{outcome.label}</span>
            </>
          ) :
<span data-work-caption>{outcome.label}</span>}
        </p>
      )}
      <div data-work-meta>
        <span>{project.data.role}</span>
        <span>{getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)}</span>
      </div>
    </div>
  </a>
</Card>

<style>
  [data-featured-work][data-slot='card'] {
    container: featured-work / inline-size;
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface-muted));
    overflow-wrap: anywhere;
  }

  .studio-project-link { padding: 1.125rem; }

  [data-work-spread] {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }

  [data-work-story] {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    align-self: center;
    min-width: 0;
    gap: 1.25rem;
    margin: 1.75rem -3rem 1.75rem 0;
    padding: 1.875rem;
    border: 1px solid var(--studio-rule);
    border-radius: 1.25rem 1.25rem 0.375rem 1.25rem;
    background: hsl(var(--surface));
  }

  [data-work-category] {
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 2.375rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.055em;
  }

  .studio-project-link:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  [data-work-description] {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.85;
  }

  [data-work-action] {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--studio-emphasis);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.8;
  }

  [data-work-action] :global(svg),
  [data-work-score] :global(svg) { flex-shrink: 0; }

  [data-work-artwork] {
    position: relative;
    min-width: 0;
    min-height: 27rem;
    overflow: hidden;
    border-radius: 1.125rem;
    background: hsl(var(--project-surface));
  }

  [data-work-artwork] img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-work-footer] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.625rem;
    margin-top: 1.125rem;
    padding: 1.25rem 1rem 0.5rem;
    border-top: 1px solid var(--studio-rule);
  }

  [data-work-outcome] {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 1.5rem;
  }

  [data-work-score] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    color: var(--studio-emphasis);
    font-size: 3rem;
    line-height: 1.15;
    letter-spacing: -0.055em;
  }

  [data-work-score] strong { font-weight: 500; }

  [data-work-previous] {
    color: hsl(var(--ink-soft));
    font-size: 1.75rem;
  }

  [data-work-caption] {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
  }

  [data-work-meta] {
    display: grid;
    min-width: 0;
    gap: 0.25rem;
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    line-height: 1.8;
    text-align: right;
    margin-left: auto;
  }

  @container featured-work (max-width: 38.75rem) {
    [data-work-spread] { display: flex; flex-direction: column; }
    [data-work-artwork] { order: -1; min-height: 0; height: auto; aspect-ratio: 16 / 10; }
    [data-work-story] { align-self: stretch; margin: -2.25rem 0.75rem 0; padding: 1.5rem; }
    h3 { font-size: 1.875rem; }
    [data-work-footer] { flex-direction: column; align-items: stretch; gap: 1.125rem; padding: 1.25rem 0.75rem 0.5rem; }
    [data-work-outcome] { justify-content: space-between; }
    [data-work-meta] { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; text-align: left; margin-left: 0; }
  }

  @container featured-work (max-width: 23.75rem) {
    .studio-project-link { padding: 0.75rem; }
    [data-work-story] { margin: -1.75rem 0 0; padding: 1.375rem 1.125rem; }
    h3 { font-size: 1.75rem; }
    [data-work-artwork] { height: auto; }
    [data-work-footer] { padding: 1.125rem 0.375rem 0.375rem; }
    [data-work-outcome] { flex-wrap: wrap; gap: 0.75rem; }
    [data-work-score] { flex-wrap: wrap; flex-shrink: 1; font-size: 2.625rem; }
  }
</style>
