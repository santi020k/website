---
import { ButtonLink, Card, Icon } from '@santi020k/lumen-astro'
---

<section aria-labelledby="community-heading" data-home-community>
  <Card variant="unstyled" data-community-folio>
    <div data-community-intro>
      <p data-community-eyebrow><span>04</span> Beyond the code</p>
      <h2 id="community-heading">Better when<br /> shared.</h2>
      <p data-community-description>Good ideas grow through conversation. I help bring people together to learn, build, and share what actually works.</p>
      <div data-community-symbol aria-hidden="true"><Icon class="size-16" name="messages-square" /></div>
    </div>
    <div data-community-sheet>
      <a data-community-link href="https://www.meetup.com/react-js-medellin/" target="_blank" rel="noopener noreferrer">
        <span data-community-eyebrow><span data-community-number aria-hidden="true">01</span><span>Community / Co-organizer</span></span>
        <h3>ReactJS Colombia</h3>
        <p>Meetups, workshops, and a local community of people who care about building for the web.</p>
        <span data-community-action>Join the community</span>
        <span data-community-arrow><Icon class="size-4.5" name="arrow-up-right" /></span>
      </a>
      <a data-community-link href="/speaking/">
        <span data-community-eyebrow><span data-community-number aria-hidden="true">02</span><span>Speaking / Knowledge sharing</span></span>
        <h3>Lessons from the work</h3>
        <p>Practical talks on developer experience, architecture, automation, and leading engineering teams.</p>
        <span data-community-action>Explore speaking</span>
        <span data-community-arrow><Icon class="size-4.5" name="arrow-up-right" /></span>
      </a>
      <div data-community-footer>
        <ButtonLink href="/speaking/" variant="unstyled" data-community-footer-link>
          Speaking &amp; Community <Icon class="size-4.5" name="arrow-right" />
        </ButtonLink>
      </div>
    </div>
  </Card>
</section>

<style>
  [data-home-community] { container: home-community / inline-size; margin-block: 7rem 2rem; }

  [data-community-folio][data-slot='card'] {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--studio-rule);
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--brand-soft));
    box-shadow: none;
    overflow-wrap: anywhere;
  }

  [data-community-intro] { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 1.75rem; }
  [data-community-eyebrow] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; font-weight: 500; line-height: 1.6; letter-spacing: 0.12em; text-transform: uppercase; }
  [data-community-intro] [data-community-eyebrow] > span { color: hsl(var(--ink)); }
  [data-community-number] { color: var(--studio-emphasis); font-variant-numeric: tabular-nums; white-space: nowrap; }
  h2 { margin-top: 0.25rem; font-size: 3rem; font-weight: 500; line-height: 1.08; letter-spacing: -0.065em; text-wrap: balance; hyphens: manual; }
  [data-community-description] { max-width: 22rem; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-community-symbol] { display: grid; place-items: center; width: 4rem; height: 4rem; margin-top: 1rem; color: hsl(var(--ink)); transform: rotate(-8deg); }
  [data-community-symbol] :global(svg) { stroke-width: 1; }

  [data-community-sheet] { min-width: 0; border: 1px solid var(--studio-rule); border-radius: 1.125rem 1.125rem 0.3125rem 1.125rem; background: hsl(var(--surface)); }
  [data-community-link] { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 1rem; padding: 1.875rem; border-bottom: 1px solid var(--studio-rule); color: hsl(var(--ink)); text-decoration: none; }
  [data-community-link] [data-community-eyebrow] { grid-column: 1 / -1; }
  h3 { grid-column: 1 / -1; margin-block: 1rem; font-size: 1.625rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.04em; hyphens: manual; }
  [data-community-link] p { grid-column: 1 / -1; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-community-action] { grid-column: 1; margin-top: 1.5rem; color: var(--studio-emphasis); font-size: 0.75rem; font-weight: 500; line-height: 1.8; }
  [data-community-arrow] { display: grid; grid-column: 2; align-self: end; place-items: center; padding-bottom: 0.1875rem; color: var(--studio-emphasis); }
  [data-community-link]:hover h3 { color: var(--studio-emphasis); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3125rem; }
  [data-community-footer] { padding: 1rem 1.875rem; }
  [data-community-footer-link] { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.75rem; color: var(--studio-emphasis); font-size: 0.75rem; font-weight: 500; line-height: 1.6; text-decoration: none; }
  [data-community-footer-link]:hover { text-decoration: underline; text-underline-offset: 0.3125rem; }

  @container home-content (width < 48rem) {
    [data-home-community] { margin-top: 4.5rem; }
  }

  @container home-community (width < 48rem) {
    [data-community-folio][data-slot='card'] { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding: 0.875rem; }
    [data-community-intro] { padding: 1.375rem; gap: 1.125rem; }
    h2 { font-size: 2.5rem; }
    h2 br, [data-community-symbol] { display: none; }
    [data-community-description] { max-width: 35rem; }
    [data-community-link] { padding: 1.75rem; }
  }

  @container home-community (width < 21.25rem) {
    [data-community-folio][data-slot='card'] { padding: 0.625rem; }
    [data-community-intro] { padding: 1.125rem; }
    [data-community-link] { padding: 1.375rem 1.125rem; }
    [data-community-footer] { padding: 0.875rem 1.125rem; }
    h2 { font-size: 2.125rem; }
    h3 { font-size: 1.5rem; }
  }

  @container home-community (width < 16rem) {
    [data-community-folio][data-slot='card'] { padding: 0.375rem; }
    [data-community-intro], [data-community-link], [data-community-footer] { padding-inline: 0.75rem; }
    [data-community-eyebrow] { letter-spacing: 0.06em; }
    h2 { font-size: 1.75rem; }
    h3 { font-size: 1.375rem; }
    [data-community-arrow] { display: none; }
    [data-community-action] { grid-column: 1 / -1; }
  }

  @container home-community (width < 12rem) {
    [data-community-intro], [data-community-link], [data-community-footer] { padding-inline: 0.5rem; }
    [data-community-footer-link] { flex-wrap: wrap; gap: 0.5rem; }
  }
</style>
