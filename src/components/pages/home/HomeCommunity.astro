---
import { ButtonLink, Icon } from '@santi020k/lumen-astro'
---

<section class="studio-community" aria-labelledby="community-heading">
  <div class="studio-community-intro">
    <p class="studio-eyebrow"><span>04</span> Beyond the code</p>
    <h2 class="studio-title" id="community-heading">Better when<br />shared.</h2>
    <p>Good ideas grow through conversation. I help bring people together to learn, build, and share what actually works.</p>
    <div class="studio-community-symbol" aria-hidden="true"><Icon data-community-symbol-icon name="messages-square" /></div>
  </div>
  <div class="studio-community-links">
    <a class="studio-community-link" href="https://www.meetup.com/react-js-medellin/" target="_blank" rel="noopener noreferrer">
      <span class="studio-eyebrow">Community / Co-organizer</span>
      <h3>ReactJS Colombia <Icon name="arrow-up-right" /></h3>
      <p>Meetups, workshops, and a local community of people who care about building for the web.</p>
    </a>
    <a class="studio-community-link" href="/speaking/">
      <span class="studio-eyebrow">Speaking / Knowledge sharing</span>
      <h3>Lessons from the work <Icon name="arrow-up-right" /></h3>
      <p>Practical talks on developer experience, architecture, automation, and leading engineering teams.</p>
    </a>
    <ButtonLink class="studio-text-link" href="/speaking/" variant="unstyled">Speaking &amp; Community <Icon name="arrow-right" /></ButtonLink>
  </div>
</section>
