---
import Button from '@santi020k/lumen-astro/components/Button'
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Dialog from '@santi020k/lumen-astro/components/Dialog'
import DialogClose from '@santi020k/lumen-astro/components/DialogClose'
import DialogTitle from '@santi020k/lumen-astro/components/DialogTitle'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'

const locale = getLocale(Astro.url.pathname)
const t = pageTranslator(locale)
const videoUrl = '/media/products/santi020k-products.mp4'
---

<home-product-film data-loading-label={t('home.film.loading')} data-error-label={t('home.film.error')}>
  <div data-film-stage>
    <div data-film-artwork><slot /></div>
    <ButtonLink data-film-fallback data-film-trigger href={videoUrl} variant="unstyled">
      <span data-film-control>
        <span data-film-play><Icon name="play" class="size-4" /></span>
        <span data-film-label>
          <span>{t('home.film.watch')}</span>
          <span data-film-duration>{t('home.film.duration')}</span>
        </span>
      </span>
    </ButtonLink>
    <Button data-film-open data-film-trigger data-ui-dialog-trigger="home-product-film" hidden variant="ghost">
      <span data-film-control>
        <span data-film-play><Icon name="play" class="size-4" /></span>
        <span data-film-label>
          <span>{t('home.film.watch')}</span>
          <span data-film-duration>{t('home.film.duration')}</span>
        </span>
      </span>
    </Button>
  </div>
  <noscript><details><summary>{t('home.film.transcriptLabel')}</summary><p>{t('home.film.transcript')}</p></details></noscript>
  <template data-film-tracks>
    <track kind="captions" src="/media/products/captions-en.vtt" srclang="en" label="English" />
    <track kind="captions" src="/media/products/captions-es.vtt" srclang="es" label="Español" default={locale === 'es'} />
  </template>
  <Dialog id="home-product-film" data-film-dialog aria-labelledby="home-product-film-title">
    <div data-film-heading>
      <div data-film-heading-copy>
        <p data-film-kicker><Icon name="film" class="size-3.5" /> {t('home.film.duration')}</p>
        <DialogTitle id="home-product-film-title">{t('home.film.title')}</DialogTitle>
      </div>
      <DialogClose autofocus variant="outline" aria-label={t('home.film.close')}>
        <Icon name="x" class="size-5" />
      </DialogClose>
    </div>
    <div data-film-screen>
      <video data-film-video data-src={videoUrl} data-portrait-src="/media/products/santi020k-products-portrait.mp4" controls playsinline preload="none" data-poster="/media/products/poster.webp" data-portrait-poster="/media/products/poster-portrait.webp" width="1920" height="1080" tabindex="0" aria-label={t('home.film.title')} />
    </div>
    <div data-film-feedback>
      <p data-film-error role="status" aria-atomic="true"></p>
      <Button data-film-retry hidden variant="outline">{t('home.film.retry')}</Button>
    </div>
    <div data-film-footer>
      <details>
        <summary>{t('home.film.transcriptLabel')}</summary>
        <p>{t('home.film.transcript')}</p>
      </details>
      <a data-film-file href={videoUrl}>
        <Icon name="external-link" class="size-4" />
        {t('home.film.openFile')}
      </a>
    </div>
  </Dialog>
</home-product-film>

<script>
  import './home-product-film'
</script>

<style>
  home-product-film { display: block; }
  [data-film-stage] { display: grid; isolation: isolate; }
  [data-film-artwork], [data-film-trigger] { grid-area: 1 / 1; min-width: 0; }
  [data-film-stage] > [data-film-trigger] {
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: end start;
    max-width: 100%;
    padding: clamp(0.375rem, 2vw, 0.875rem);
    border: 0;
    border-radius: var(--radius-folio);
    background: transparent;
    color: hsl(var(--ink));
    cursor: pointer;
    text-align: start;
    text-decoration: none;
    white-space: normal;
  }
  [data-film-stage] > [data-film-trigger]:focus-visible { outline: 2px solid hsl(var(--brand)); outline-offset: 0.25rem; }
  [data-film-trigger] :global(.ui-button__content) { display: block; min-width: 0; max-width: 100%; }
  [data-film-stage] > [data-film-trigger][hidden], [data-film-retry][hidden] { display: none; }
  [data-film-control] {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    max-width: 100%;
    padding: 0.375rem 0.875rem 0.375rem 0.375rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.875rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    box-shadow: var(--shadow-nav-scrolled);
    transition: border-color 180ms ease;
  }
  [data-film-play] { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: hsl(var(--brand-solid)); color: var(--color-portrait-ink); }
  [data-film-play] :global(svg) { fill: currentColor; }
  [data-film-label] { display: grid; min-width: 0; font: 600 0.875rem/1.35 var(--font-sans); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  [data-film-duration] { color: hsl(var(--ink-soft)); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0; }
  [data-film-trigger]:is(:hover, :focus-visible) [data-film-control] { border-color: hsl(var(--brand)); }

  [data-film-dialog] {
    inset: 0;
    translate: none;
    transform: none;
    width: min(68rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-sheet);
    background: hsl(var(--surface));
    color: hsl(var(--ink));
  }
  [data-film-dialog]::backdrop { background: color-mix(in srgb, var(--color-portrait-scrim) 82%, transparent); }
  [data-film-dialog][open] { display: block; }
  [data-film-dialog]:has([data-film-video][data-format='portrait']) { width: min(30rem, calc(100% - 1rem)); }
  [data-film-heading] {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: clamp(0.75rem, 2.5vw, 1.375rem);
    background: hsl(var(--surface));
  }
  [data-film-heading-copy] { min-width: 0; }
  [data-film-kicker] { display: flex; align-items: center; gap: 0.375rem; margin: 0 0 0.25rem; color: hsl(var(--ink-soft)); font: 600 0.6875rem/1.5 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; }
  [data-film-heading] :global([data-slot='dialog-title']) { margin: 0; padding: 0; border: 0; color: hsl(var(--ink)); font: 600 clamp(1.125rem, 2.6vw, 1.625rem)/1.2 var(--font-sans); letter-spacing: -0.04em; overflow-wrap: anywhere; }
  [data-film-heading] :global([data-slot='dialog-title'])::after { content: none; }
  [data-film-heading] :global(button) { flex: none; width: 2.75rem; min-height: 2.75rem; padding: 0; border-radius: 50%; }
  [data-film-screen] { display: grid; justify-items: center; background: var(--color-portrait-scrim); }
  [data-film-video] { display: block; width: min(100%, 115dvh); height: auto; aspect-ratio: 16 / 9; background: var(--color-portrait-scrim); }
  [data-film-video][data-format='portrait'] { width: min(100%, 52dvh); aspect-ratio: 4 / 5; }
  [data-film-footer] {
    display: flex;
    align-items: start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding: 0.375rem clamp(0.75rem, 2.5vw, 1.375rem);
    color: hsl(var(--ink-soft));
    font: 500 0.8125rem/1.6 var(--font-sans);
  }
  [data-film-footer] details { flex: 1 1 15rem; min-width: 0; }
  [data-film-footer] summary { cursor: pointer; min-height: 2.75rem; padding-block: 0.6875rem; }
  [data-film-footer] p { max-width: 65ch; margin: 0 0 0.75rem; }
  [data-film-footer] a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; color: hsl(var(--ink)); text-decoration: underline; text-underline-offset: 0.2em; }
  [data-film-footer] a :global(svg) { flex: none; }
  [data-film-feedback] { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem 1rem; padding: 0.75rem clamp(0.75rem, 2.5vw, 1.375rem) 0; }
  [data-film-feedback]:has([data-film-error]:empty) { display: none; }
  [data-film-error] { flex: 1 1 15rem; margin: 0; font-size: 0.8125rem; }
  [data-film-retry] { min-height: 2.75rem; max-width: 100%; white-space: normal; }
  @media (height < 32rem) { [data-film-heading] { position: relative; } }
  @media (prefers-reduced-motion: reduce) { [data-film-control] { transition: none; } }
  @media (forced-colors: active) {
    [data-film-control] { border-color: ButtonText; }
    [data-film-play] { border: 1px solid ButtonText; }
  }
</style>
