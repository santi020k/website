---
import { AnimatedNumber, Stat } from '@santi020k/lumen-astro'

interface Props {
  yearsOfExperience: string
}

const { yearsOfExperience } = Astro.props

const stats = [
  { value: Number.parseInt(yearsOfExperience, 10), suffix: '+', label: 'Years building', description: 'Across web, mobile, and the systems behind them.' },
  { value: 14, suffix: '', label: 'People, one team', description: 'The largest cross-functional team I’ve led.' },
  { value: -75, suffix: '%', label: 'Release cycle time', description: 'Through better pipelines and automated quality gates.' },
  { value: 100, suffix: '+', label: 'People learning together', description: 'Typical attendance at our community events.' }
]
---

<section class="studio-stats" aria-label="Experience and impact" id="home-stats">
  {stats.map(stat => (
    <Stat as="article" class="studio-stat" label={stat.label} variant="bare">
      <AnimatedNumber class="studio-stat-value" locale="en-US" suffix={stat.suffix} value={stat.value} />
      <p>{stat.description}</p>
    </Stat>
  ))}
</section>
