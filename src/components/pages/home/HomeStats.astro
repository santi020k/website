---
import StatCard from '../../molecules/StatCard.astro'

interface Props {
  yearsOfExperience: string
}

const { yearsOfExperience } = Astro.props
---

<section
  class="
    grid gap-6 border-t border-line/70 pt-10
    md:grid-cols-2
    xl:grid-cols-4
  "
  data-animate
>
  <StatCard description="Years shipping web and mobile products across full-stack, leadership, and automation roles." label="Experience" value={yearsOfExperience} />
  <StatCard description="Largest cross-functional team I have led across product, design, frontend, and backend." label="Team led" value="14" />
  <StatCard description="Reduced release lead times by optimizing CI/CD pipelines and automating quality gates." label="Cycle Time" value="-75%" />
  <StatCard description="Typical attendance for ReactJS Colombia meetups, workshops, and talks." label="Community" value="100+" />
</section>
