---
import AnimatedNumber from '@santi020k/lumen-astro/components/AnimatedNumber'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Stat from '@santi020k/lumen-astro/components/Stat'

import { getLocale } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

interface Props {
  yearsOfExperience: string
}

const { yearsOfExperience } = Astro.props

const stats = [
  { value: Number.parseInt(yearsOfExperience, 10), suffix: '+', icon: 'layers', label: t('page.yearsBuilding'), description: t('page.acrossWebMobileAndTheSystems') },
  { value: 14, suffix: '', icon: 'users', label: t('page.peopleOneTeam'), description: t('page.theLargestCrossFunctionalTeamI') },
  { value: -75, suffix: '%', icon: 'workflow', label: t('page.releaseCycleTime'), description: t('page.throughBetterPipelinesAndAutomatedQuality') },
  { value: 100, suffix: '+', icon: 'messages-square', label: t('page.peopleLearningTogether'), description: t('page.typicalAttendanceAtOurCommunityEvents') }
] as const
---

<section class="studio-stats" aria-label={t('page.experienceAndImpact')} id="home-stats">
  {stats.map(stat => (
    <Stat as="article" class="studio-stat" label={stat.label} variant="bare">
      <div class="studio-stat-metric">
        <AnimatedNumber class="studio-stat-value" locale="en-US" suffix={stat.suffix} value={stat.value} />
        <Icon class="studio-stat-icon" name={stat.icon} />
      </div>
      <p>{stat.description}</p>
    </Stat>
  ))}
</section>
