---
import { Image } from 'astro:assets'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import HomeSectionHeading from '@/components/pages/home/HomeSectionHeading.astro'

import City from '@/assets/photos/home/city-after-dark.webp'
import Dog from '@/assets/photos/home/dog-in-the-grass.webp'
import Sunset from '@/assets/photos/home/last-light.webp'

import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import RevealGroup from '@santi020k/lumen-astro/components/RevealGroup'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

const photographs = [
  { image: Dog, alt: t('home.photo.dogAlt'), caption: t('home.photo.dog'), kind: 'dog' },
  { image: City, alt: t('home.photo.nightAlt'), caption: t('home.photo.night'), kind: 'city' },
  { image: Sunset, alt: t('home.photo.sunsetAlt'), caption: t('home.photo.sunset'), kind: 'sunset' }
]
---

<section class="studio-section" aria-labelledby="home-life-heading" data-home-life>
  <HomeSectionHeading
    id="home-life-heading"
    number="04"
    eyebrow={t('home.life.eyebrow')}
    title={t('home.life.title')}
    description={t('home.life.description')}
    action={t('home.life.action')}
    href={localizePath('/about/', pageLocale)}
  />
  <RevealGroup animation="slide-up" duration="slow" stagger={90} threshold={0} data-home-life-photos>
    {photographs.map(({ image, alt, caption, kind }) => (
      <figure data-life-photo={kind}>
        <div data-home-life-photo-frame>
          <Image
            src={image}
            alt={alt}
            width={image.width}
            height={image.height}
            widths={[320, 480, 640, 960]}
            sizes={kind === 'city' ? '(min-width: 1024px) 560px, (min-width: 768px) 50vw, calc(100vw - 64px)' : '(min-width: 1024px) 280px, (min-width: 768px) 25vw, calc((100vw - 80px) / 2)'}
            format="webp"
            quality={80}
            loading="lazy"
          />
        </div>
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
  </RevealGroup>
  <div data-home-life-footer>
    <span>{t('home.photo.throughMyLens')}</span>
    <ButtonLink class="studio-text-link" data-text-link href={localizePath('/travel/', pageLocale)} variant="unstyled">
      <span data-text-link-label>{t('home.life.travel')}</span><ArrowExchange />
    </ButtonLink>
  </div>
</section>

<style>
  [data-home-life-photos] { display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; gap: 1.5rem; }
  figure { min-width: 0; margin: 0; }
  [data-home-life-photo-frame] { overflow: hidden; aspect-ratio: 4 / 5; border-radius: 0.75rem; background: hsl(var(--surface-muted)); }
  [data-life-photo='city'] [data-home-life-photo-frame] { aspect-ratio: 4 / 3; border-radius: 1.5rem 1.5rem 0.5rem 1.5rem; }
  [data-life-photo='sunset'] { padding-top: 5rem; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  [data-life-photo='sunset'] img { object-position: right center; }
  figcaption { margin-top: 0.875rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.7; }
  [data-home-life-footer] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--studio-rule); }
  [data-home-life-footer] > span { color: hsl(var(--ink-soft)); font-size: 0.75rem; }

  /* Each photo drifts a few percent inside its frame while it crosses the
     viewport. The frame, caption, and layout do not move. */
  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      [data-home-life-photo-frame] { view-timeline: --life-photo block; }
      [data-home-life-photo-frame] img {
        transform-origin: center;
        animation: home-life-drift linear both;
      }
      /* Kept apart from the shorthand: the minifier folds a timeline declared
         beside it into `animation`, which browsers then reject. */
      [data-home-life-photos] [data-home-life-photo-frame] img {
        animation-timeline: --life-photo;
        animation-range: cover;
      }
      [data-life-photo='sunset'] img { transform-origin: right center; }
    }
  }
  @keyframes home-life-drift {
    from { transform: scale(1.08) translateY(-3%); }
    to { transform: scale(1.08) translateY(3%); }
  }

  @container home-content (width < 42rem) {
    [data-home-life-photos] { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 1.5rem 1rem; }
    [data-life-photo='city'] { grid-column: 1 / -1; grid-row: 1; }
    [data-life-photo='city'] [data-home-life-photo-frame] { aspect-ratio: 16 / 10; }
    [data-life-photo='sunset'] { padding-top: 0; }
  }

  @container home-content (width < 20rem) {
    [data-home-life-photos] { grid-template-columns: minmax(0, 1fr); }
    [data-home-life-photo-frame] { aspect-ratio: 4 / 3; }
  }
</style>
