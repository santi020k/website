---
import { Picture } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import AboutMeImage from '@/assets/photos/originals/me-1-square.webp'
import { siteConfig } from '@/site.config'

interface Props {
  contactHref: string
  yearsOfExperience: string
}

const { contactHref, yearsOfExperience } = Astro.props
---

<section class="relative pb-4">
  <div class="
    relative grid gap-10
    lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center
  "
  >
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Santiago Molina (@santi020k)"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="sr-only">Santiago Molina (@santi020k) — Engineering Leader & Full-Stack Architect</h1>
        <h2
          aria-hidden="true"
          class="
            max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
            sm:text-6xl/[0.95]
            lg:text-[5.2rem]/[0.92]
          "
        >
          Calm systems.
          <span class="
            block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
            pb-4 text-transparent
          "
          >Clear delivery.
          </span>
        </h2>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="
          panel-card max-w-2xl p-5
          sm:p-6
        "
        >
          <div class="
            flex flex-col gap-4
            sm:flex-row sm:items-center sm:justify-between
          "
          >
            <div class="space-y-1.5">
              <p class="flex items-center gap-1.5 section-label text-brand">
                <span
                  class="
                    inline-block size-2 rounded-full bg-brand
                    motion-safe:animate-pulse
                    motion-reduce:animate-none
                  "
                  aria-hidden="true"
                />
                Open now
              </p>
              <p class="text-sm/6 text-ink">{siteConfig.availability}</p>
            </div>
            <ButtonLink className="shrink-0" href={contactHref} newTab showArrow variant="secondary">
              Message on WhatsApp
            </ButtonLink>
          </div>
        </div>

        <div class="section-actions">
          <ButtonLink href="/portfolio/" showArrow>
            See selected work
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.resume} showArrow variant="secondary">
            View resume
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Read the writing
          </ButtonLink>
        </div>

        <!-- <p class="text-sm text-ink-muted">
          {siteConfig.location} · {yearsOfExperience} years experience · ReactJS Colombia
        </p> -->
      </div>
    </div>

    <div
      class="
        relative isolate mx-auto w-full max-w-88 animate-reveal-lcp
        motion-reduce:animate-none
      "
    >
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[5%] z-10 rounded-4xl bg-radial
          from-brand/18 via-accent/8 to-transparent blur-3xl
          motion-safe:animate-pulse
          motion-reduce:animate-none
        "
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[-10%] z-20 rounded-full border-2
          border-brand/15 [animation-delay:800ms]
          motion-safe:animate-[spin_24s_linear_infinite]
          motion-reduce:animate-none
          dark:border-brand/20
        "
        style="border-image: linear-gradient(135deg, hsl(var(--brand)/0.3), hsl(var(--accent)/0.15), transparent) 1; border-radius: 9999px;"
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[8%] z-20 rounded-full border
          border-brand/10 [animation-delay:800ms]
          motion-safe:animate-[spin_18s_linear_infinite_reverse]
          motion-reduce:animate-none
        "
        style="border-image: linear-gradient(225deg, hsl(var(--accent)/0.2), hsl(var(--brand)/0.1), transparent) 1; border-radius: 9999px;"
      />

      <div class="
        panel-card relative z-0 overflow-hidden rounded-[2.25rem] p-3
        transition-shadow duration-500
        hover:shadow-[0_20px_60px_-15px_hsl(var(--brand)/0.15)]
        motion-reduce:transition-none
        sm:p-4
      "
      >
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 z-10 grid-fade opacity-20
            dark:opacity-30
          "
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 z-20 bg-linear-to-br
            from-brand/5 via-transparent to-accent/8
          "
        />
        <Picture
          alt="Portrait of Santiago Molina (@santi020k)"
          class="
            relative z-0 aspect-4/5 w-full rounded-[1.7rem] object-cover
            object-top
          "
          decoding="sync"
          fetchpriority="high"
          formats={['avif', 'webp']}
          height={440}
          loading="eager"
          sizes="(min-width: 1024px) 352px, 75vw"
          src={AboutMeImage}
          width={352}
          widths={[400, 600, 800]}
        />
      </div>

      <div class="
        mini-note absolute bottom-8 -left-4 z-30 hidden min-w-40 border-l-4
        border-l-brand/40 [animation-delay:600ms]
        motion-safe:animate-float-y
        motion-reduce:animate-none
        sm:-left-8 sm:block
      "
      >
        <p class="flex items-center gap-1.5 section-label">
          <span class="
            inline-block size-1.5 rounded-full bg-brand
            motion-safe:animate-pulse
          "
          />
          Base
        </p>
        <p class="mt-2 text-sm/6 text-ink">Medellin · Remote worldwide</p>
      </div>

      <div
        class="
          mini-note absolute top-8 -right-4 z-30 hidden min-w-32 border-r-4
          border-r-accent/40 [animation-delay:900ms]
          motion-safe:animate-float-y
          motion-reduce:animate-none
          sm:-right-8 sm:block
        "
      >
        <p class="section-label">Experience</p>
        <p class="
          mt-2 bg-linear-to-br from-ink to-ink-soft bg-clip-text text-2xl
          font-bold text-transparent
        "
        >{yearsOfExperience}
        </p>
      </div>
    </div>
  </div>
</section>
