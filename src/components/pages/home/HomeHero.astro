---
import { Icon } from 'astro-icon/components'

import { Picture } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import AboutMeImage from '@/assets/photos/originals/santiago-profile-with-dog.jpg'

import { siteConfig } from '@/site.config'

interface Props {
  contactHref: string
  yearsOfExperience: string
}

const { contactHref, yearsOfExperience } = Astro.props
---

<section
  class="
    relative left-1/2 isolate -mt-12 flex w-screen -translate-x-1/2 items-center
    overflow-hidden px-5 pt-24 pb-16
    sm:px-6 sm:pt-28 sm:pb-20
    lg:-mt-39 lg:min-h-svh lg:px-8 lg:pt-28 lg:pb-20
    2xl:px-10
  "
  data-home-hero
>
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute -inset-x-24 -top-32 -z-10 h-176 rounded-full
      bg-radial from-brand/18 via-accent/8 to-transparent blur-3xl
      motion-safe:animate-glow-pulse
      motion-reduce:animate-none
      dark:from-brand/24 dark:via-accent/12
    "
  />
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute inset-x-0 top-0 -z-10 h-full bg-linear-to-b
      from-canvas/70 via-surface/8 to-canvas/78
      dark:from-canvas/78 dark:via-surface/7 dark:to-canvas/86
    "
  />
  <div
    class="
      mx-auto grid w-full max-w-352 gap-10
      lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:gap-14
      2xl:grid-cols-[minmax(0,1fr)_27rem] 2xl:gap-20
    "
    data-home-hero-grid
  >
    <div class="relative z-10">
      <div
        class="
          flex flex-col gap-3
          sm:flex-row sm:items-center
        "
      >
        <Eyebrow
          label="Santiago Molina (@santi020k)"
          tone="brand"
          className="whitespace-normal"
        />
        <p class="
          hidden w-fit items-center rounded-full border border-line/35
          bg-surface/36 px-4 py-1.5 section-label text-ink-muted
          backdrop-blur-md
          sm:inline-flex
        "
        >
          Engineering leadership · Automation · DX
        </p>
      </div>

      <div class="mt-6 max-w-232 space-y-5">
        <h1
          class="
            text-4xl/[0.96] font-extrabold tracking-[-0.06em] wrap-break-word
            sm:text-6xl/[0.95]
            lg:text-[6rem]/[0.88]
            2xl:text-[6.8rem]/[0.86]
          "
          data-home-hero-heading
        >
          Calm systems.
          <span class="
            block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
            pb-4 text-transparent
          "
          >Clear delivery.
          </span>
        </h1>
        <p class="
          max-w-3xl text-base/7 text-ink-soft
          sm:text-xl/8
        "
        >
          Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
        </p>
      </div>

      <div class="mt-8 space-y-5">
        <div
          class="
            max-w-3xl rounded-[1.65rem] p-3
            shadow-[0_18px_56px_hsl(var(--brand)/0.08)] panel-surface
            sm:rounded-full sm:p-2
          "
        >
          <div class="
            flex flex-col gap-3
            sm:flex-row sm:items-center sm:justify-between
          "
          >
            <div class="
              min-w-0 px-2 py-1
              sm:py-0 sm:pl-3
            "
            >
              <p class="flex items-center gap-1.5 section-label text-brand">
                <span
                  class="
                    ui-marker
                    motion-safe:animate-pulse
                    motion-reduce:animate-none
                  "
                  aria-hidden="true"
                />
                Open now
              </p>
              <p class="mt-1 text-sm/6 text-ink">{siteConfig.availability}</p>
            </div>
            <ButtonLink
              className="
                min-h-12 shrink-0 px-5
                sm:min-h-11
              "
              href={contactHref}
              newTab
              showArrow
              variant="secondary"
            >
              Message on WhatsApp
            </ButtonLink>
          </div>
        </div>

        <div class="section-actions">
          <ButtonLink href="/portfolio/" showArrow>
            See selected work
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.resume} showArrow variant="secondary">
            View resume
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Read the writing
          </ButtonLink>
        </div>

        <ul
          aria-label="Professional highlights"
          class="
            hidden flex-wrap gap-x-3 gap-y-2 text-sm/6 text-ink-muted
            sm:flex sm:gap-x-4
          "
        >
          <li class="font-medium text-ink-soft">{yearsOfExperience} years experience</li>
          <li aria-hidden="true" class="text-brand/70">/</li>
          <li>Medellin · Remote worldwide</li>
          <li aria-hidden="true" class="text-brand/70">/</li>
          <li>ReactJS Colombia</li>
        </ul>
      </div>
    </div>

    <div
      class="
        relative isolate mx-auto w-full max-w-80 animate-reveal-lcp
        motion-reduce:animate-none
        sm:max-w-96
        2xl:max-w-108
      "
      data-home-hero-portrait
    >
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[5%] z-10 rounded-4xl bg-radial
          from-brand/24 via-accent/12 to-transparent blur-3xl
          motion-safe:animate-pulse
          motion-reduce:animate-none
        "
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[-10%] z-20 rounded-[2.75rem]
          border-2 border-brand/15 [animation-delay:800ms]
          motion-safe:animate-[hero-orbit-outer_28s_linear_infinite]
          motion-reduce:animate-none
          dark:border-brand/20
        "
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[8%] z-20 rounded-[2.25rem] border
          border-accent/10 [animation-delay:800ms]
          motion-safe:animate-[hero-orbit-inner_22s_linear_infinite]
          motion-reduce:animate-none
        "
      />

      <div class="
        glass-pro relative z-0 overflow-hidden rounded-[2.25rem] p-3
        transition-shadow duration-500
        hover:shadow-[0_24px_70px_-18px_hsl(var(--brand)/0.24)]
        motion-reduce:transition-none
        sm:p-4
      "
      >
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 z-10 grid-fade opacity-20
            dark:opacity-30
          "
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 z-20 bg-linear-to-br
            from-brand/5 via-transparent to-accent/8
          "
        />
        <Picture
          alt="Portrait of Santiago Molina (@santi020k)"
          class="
            relative z-0 aspect-2/3 w-full rounded-[1.7rem] object-cover
            object-top
          "
          decoding="sync"
          fetchpriority="high"
          formats={['avif', 'webp']}
          height={528}
          loading="eager"
          sizes="(min-width: 1536px) 448px, (min-width: 1024px) 384px, 75vw"
          src={AboutMeImage}
          width={352}
          widths={[400, 600, 800]}
        />
      </div>

      <div class="
        glass-pro absolute top-8 -left-4 z-30 hidden min-w-40 rounded-2xl
        border-l-4 border-l-brand/40 p-5 [animation-delay:600ms]
        motion-safe:animate-float-y
        motion-reduce:animate-none
        sm:-left-8 sm:block
      "
      >
        <p class="flex items-center gap-1.5 section-label">
          <span class="
            inline-block size-1.5 rounded-full bg-brand
            motion-safe:animate-pulse
          "
          />
          Base
        </p>
        <p class="mt-2 text-sm/6 text-ink">Medellin · Remote worldwide</p>
      </div>

      <div
        class="
          glass-pro absolute top-8 -right-4 z-30 hidden min-w-32 rounded-2xl
          border-r-4 border-r-accent/40 p-5 [animation-delay:900ms]
          motion-safe:animate-float-y
          motion-reduce:animate-none
          sm:-right-8 sm:block
        "
      >
        <p class="section-label">Experience</p>
        <p class="
          mt-2 bg-linear-to-br from-ink to-ink-soft bg-clip-text text-2xl
          font-bold text-transparent
        "
        >{yearsOfExperience}
        </p>
      </div>
    </div>
  </div>

  <a
    aria-label="Scroll to page highlights"
    class="
      group absolute bottom-8 left-1/2 z-30 hidden -translate-x-1/2 items-center
      justify-center rounded-full p-2 text-ink-muted transition-colors
      hover:text-brand
      focus-visible:ring-2 focus-visible:ring-brand/50
      focus-visible:outline-none
      motion-reduce:transition-none
      lg:flex
    "
    href="#home-stats"
  >
    <span class="sr-only">Scroll to page highlights</span>
    <span
      class="
        relative flex h-13 w-7 items-start justify-center rounded-full border
        border-brand/20 bg-surface/28 pt-2
        shadow-[0_16px_36px_hsl(var(--brand)/0.08)] backdrop-blur-sm
        transition-all
        group-hover:border-brand/40 group-hover:bg-brand-soft/28
        before:absolute before:-inset-1.5 before:rounded-full before:border
        before:border-brand/18 before:opacity-0 before:content-['']
        motion-safe:before:animate-[scroll-cue-ring_2.6s_ease-out_infinite]
        motion-reduce:transition-none
      "
    >
      <span
        aria-hidden="true"
        class="
          size-1.5 rounded-full bg-brand/70
          motion-safe:animate-[scroll-dot_1.8s_ease-in-out_infinite]
          motion-reduce:animate-none
        "
      />
    </span>
    <Icon
      aria-hidden="true"
      class="
        absolute top-full mt-1 size-3.5 text-brand/55 transition-transform
        group-hover:translate-y-0.5
        motion-safe:animate-[scroll-chevron_1.8s_ease-in-out_infinite]
        motion-reduce:animate-none motion-reduce:transition-none
      "
      name="tabler:chevron-down"
    />
  </a>
</section>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @keyframes scroll-dot {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }

    48% {
      opacity: 1;
      transform: translateY(1.15rem);
    }

    72% {
      opacity: 0;
      transform: translateY(1.55rem);
    }
  }

  @keyframes scroll-cue-ring {
    0% {
      opacity: 0;
      transform: scale(0.92);
    }

    28% {
      opacity: 0.55;
    }

    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  @keyframes scroll-chevron {
    0%,
    100% {
      opacity: 0.45;
      transform: translateY(0);
    }

    50% {
      opacity: 0.85;
      transform: translateY(0.18rem);
    }
  }

  @keyframes hero-orbit-outer {
    from {
      transform: rotate(14deg);
    }

    to {
      transform: rotate(374deg);
    }
  }

  @keyframes hero-orbit-inner {
    from {
      transform: rotate(-28deg);
    }

    to {
      transform: rotate(-388deg);
    }
  }

  @media (min-width: 2400px) {
    [data-home-hero-grid] {
      grid-template-columns: minmax(0, 1fr) 30rem;
      gap: 5rem;
    }

    [data-home-hero-heading] {
      font-size: 7.4rem;
      line-height: 0.84;
    }

    [data-home-hero-portrait] {
      max-width: 30rem;
    }
  }
</style>
