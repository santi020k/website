---
import { Image } from 'astro:assets'

import HeroArtwork from '@/assets/artwork/interlocking-forms.png'

import { ButtonLink, Icon } from '@santi020k/lumen-astro'

import LumenLogo from '@/content/project/lumen-ui/logo.webp'
import PostLensLogo from '@/content/project/postlens/logo.webp'
---

<section class="maker-hero" aria-labelledby="home-heading" data-home-hero>
  <div class="maker-hero-stage" data-home-hero-grid>
    <div class="maker-hero-copy">
      <p class="maker-hero-eyebrow">
        <span aria-hidden="true" class="maker-hero-signal"></span>
        Engineering &amp; independent making
      </p>
      <h1 id="home-heading" data-home-hero-heading>
        <span>I build products.</span>
        <span>And the tools</span>
        <span class="maker-hero-emphasis">behind them.</span>
      </h1>
      <p class="maker-hero-description">
        I’m Santiago. Engineer, maker, and technical lead.
        Turning complex problems into useful software,
        with care for every detail.
      </p>
      <div class="maker-hero-actions">
        <ButtonLink class="maker-hero-primary" href="/portfolio/" variant="unstyled">
          Explore my work
          <span class="maker-hero-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </ButtonLink>
        <ButtonLink class="maker-hero-secondary" href="/about/" variant="unstyled">
          A little about me <Icon name="arrow-right" />
        </ButtonLink>
      </div>
    </div>

    <div class="maker-hero-visual" aria-hidden="true">
      <div class="maker-hero-orbit"></div>
      <span class="maker-hero-coordinate top-0 right-0">Ideas / systems / craft</span>
      <Image
        alt=""
        class="maker-hero-artwork"
        src={HeroArtwork}
        widths={[400, 640, 960, 1280]}
        sizes="(min-width: 1024px) 560px, (min-width: 640px) 460px, 320px"
        width={640}
        height={640}
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
      <span class="maker-hero-coordinate maker-hero-coordinate-bottom">
        Separate ideas. Better together.
        <span class="maker-hero-cross">+</span>
      </span>
    </div>
  </div>

  <div class="maker-hero-shelf">
    <p class="maker-hero-shelf-label">A few things<br />I’m building <Icon name="arrow-down-right" /></p>
    <a class="maker-hero-project" href="/portfolio/lumen-ui/">
      <Image alt="" class="maker-hero-project-logo" src={LumenLogo} width={40} height={40} />
      <span><strong>Lumen UI</strong><span>One system. Many platforms.</span></span>
      <Icon class="maker-hero-project-arrow" name="arrow-up-right" />
    </a>
    <a class="maker-hero-project" href="/portfolio/postlens/">
      <Image alt="" class="maker-hero-project-logo" src={PostLensLogo} width={40} height={40} />
      <span><strong>PostLens</strong><span>A little more from every photo.</span></span>
      <Icon class="maker-hero-project-arrow" name="arrow-up-right" />
    </a>
    <a class="maker-hero-index" href="/projects/" aria-label="Explore all projects"><Icon name="plus" /></a>
  </div>
</section>
