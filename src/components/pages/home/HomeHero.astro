---
import { Picture } from 'astro:assets'

import AboutMeImage from '../../../assets/photos/about-me.webp'
import { siteConfig } from '../../../site.config'
import ButtonLink from '../../atoms/ButtonLink.astro'
import Eyebrow from '../../atoms/Eyebrow.astro'

interface Props {
  contactHref: string
  yearsOfExperience: string
}

const { contactHref, yearsOfExperience } = Astro.props
---

<section class="relative pb-4">
  <div class="
    relative grid gap-10
    lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center
  "
  >
    <div class="relative z-10 space-y-8">
      <Eyebrow
        label="Santiago Molina"
        tone="brand"
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
      />

      <div
        class="
          animate-slide-up space-y-4 [animation-delay:90ms]
          motion-reduce:animate-none
        "
      >
        <h1 class="
          max-w-4xl text-4xl/[0.98] tracking-[-0.06em] wrap-break-word
          sm:text-6xl/[0.95]
          lg:text-[5.2rem]/[0.92]
        "
        >
          Calm systems.
          <span class="block text-brand">Clear delivery.</span>
        </h1>
        <p class="
          max-w-xl text-base/7 text-ink-soft
          sm:text-lg/7
        "
        >
          Tech lead and full-stack engineer focused on architecture, automation, and developer experience.
        </p>
      </div>

      <div
        class="
          animate-slide-up space-y-5 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="
          panel-card max-w-2xl p-5
          sm:p-6
        "
        >
          <div class="
            flex flex-col gap-4
            sm:flex-row sm:items-center sm:justify-between
          "
          >
            <div class="space-y-2">
              <p class="section-label text-brand">Open now</p>
              <p class="text-sm/6 text-ink">{siteConfig.availability}</p>
            </div>
            <ButtonLink className="shrink-0" href={contactHref} newTab showArrow variant="secondary">
              Message on WhatsApp
            </ButtonLink>
          </div>
        </div>

        <div class="focus-pill">
          <span class="section-label">Focus</span>
          <span
            aria-hidden="true"
            class="
              hidden h-px w-8 bg-linear-to-r from-line to-transparent
              sm:block
            "
          />
          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5">
            <span class="text-sm font-semibold text-ink">Architecture systems</span>
            <span
              aria-hidden="true"
              class="
                hidden text-ink-muted/40
                sm:inline
              "
            >·
            </span>
            <span class="
              hidden text-sm font-semibold text-ink-soft
              sm:inline
            "
            >Automation flows
            </span>
            <span
              aria-hidden="true"
              class="
                hidden text-ink-muted/40
                sm:inline
              "
            >·
            </span>
            <span class="
              hidden text-sm font-semibold text-ink-soft
              sm:inline
            "
            >Developer experience
            </span>
          </div>
        </div>

        <div class="section-actions">
          <ButtonLink href="/portfolio/" showArrow>
            See selected work
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Read the writing
          </ButtonLink>
          <ButtonLink href={siteConfig.contact.resume} newTab showArrow variant="ghost">
            Open resume
          </ButtonLink>
        </div>

        <div class="flex flex-wrap gap-3 text-sm text-ink-muted">
          <span class="
            inline-flex items-center rounded-full border border-line/60
            bg-surface/72 px-3 py-2
          "
          >{siteConfig.location}
          </span>
          <span class="
            inline-flex items-center rounded-full border border-line/60
            bg-surface/72 px-3 py-2
          "
          >{yearsOfExperience} years building teams and systems
          </span>
          <span class="
            inline-flex items-center rounded-full border border-line/60
            bg-surface/72 px-3 py-2
          "
          >ReactJS Colombia
          </span>
        </div>
      </div>
    </div>

    <div
      class="
        relative isolate mx-auto w-full max-w-88 animate-spring-up-lcp
        motion-reduce:animate-none
      "
    >
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[12%] z-10 rounded-4xl
          bg-linear-to-br from-brand/10 via-transparent to-accent/10 blur-2xl
        "
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[-10%] z-20 rounded-full border
          border-brand/12 [animation-delay:800ms]
          motion-safe:animate-[spin_24s_linear_infinite]
          motion-reduce:animate-none
        "
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-[10%] z-20 rounded-full border
          border-brand/10 [animation-delay:800ms]
          motion-safe:animate-[spin_18s_linear_infinite_reverse]
          motion-reduce:animate-none
        "
      />

      <div class="
        panel-card relative z-0 overflow-hidden rounded-[2.25rem] p-3
        sm:p-4
      "
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 z-10 grid-fade opacity-30"
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 z-20 bg-linear-to-br
            from-transparent via-transparent to-brand/12
          "
        />
        <Picture
          alt="Portrait of Santiago Molina"
          class="
            relative z-0 aspect-4/5 w-full rounded-[1.7rem] object-cover
            object-top
          "
          decoding="sync"
          fetchpriority="high"
          formats={['avif', 'webp']}
          loading="eager"
          sizes="(min-width: 1024px) 352px, 75vw"
          src={AboutMeImage}
          widths={[400, 600, 800]}
        />
      </div>

      <div class="
        absolute bottom-8 -left-4 z-30 hidden mini-note min-w-40
        [animation-delay:600ms]
        motion-safe:animate-float-y
        motion-reduce:animate-none
        sm:-left-8 sm:block
      "
      >
        <p class="section-label">Base</p>
        <p class="mt-2 text-sm/6 text-ink">Medellin · Remote worldwide</p>
      </div>

      <div
        class="
          absolute top-8 -right-4 z-30 hidden mini-note min-w-32
          [animation-delay:900ms]
          motion-safe:animate-float-y
          motion-reduce:animate-none
          sm:-right-8 sm:block
        "
      >
        <p class="section-label">Experience</p>
        <p class="mt-2 text-lg font-semibold text-ink">{yearsOfExperience}</p>
      </div>
    </div>
  </div>
</section>
