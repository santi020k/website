---
import { Image } from 'astro:assets'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import HeroPortrait from '@/assets/photos/portraits/santiago-plum-soft-smile.png'

import { ButtonLink, Icon } from '@santi020k/lumen-astro'

import LumenLogo from '@/content/project/lumen-ui/logo.webp'
import PostLensLogo from '@/content/project/postlens/logo.webp'
import { getLocale, localizePath } from '@/i18n'
import { translatePage } from '@/i18n/page-copy'

const pageLocale = getLocale(Astro.url.pathname)
const t = (source: string) => translatePage(pageLocale, source)
---

<section class="signature-frame maker-hero" aria-labelledby="home-heading" data-home-hero>
  <div class="maker-hero-stage" data-home-hero-grid>
    <div class="maker-hero-copy">
      <p class="maker-hero-eyebrow">
        <span aria-hidden="true" class="maker-hero-signal"></span>
        {t('Hey, I’m Santiago')}
      </p>
      <h1 id="home-heading" data-home-hero-heading>
        <span>{t('I build products.')}</span>
        <span>{t('And the')} <span class="maker-hero-emphasis">{t('tools')}</span></span>
        <span>{t('behind them.')}</span>
      </h1>
      <p class="maker-hero-description">
        {t('Engineering lead and creator of')}{' '}
        <span class="whitespace-nowrap">Lumen UI</span>{t('. I build commerce platforms, native apps, and developer tools.')}
      </p>
      <div class="maker-hero-actions">
        <ButtonLink class="maker-hero-primary" href={localizePath('/portfolio/', pageLocale)} variant="unstyled">
          {t('See selected work')}
          <span class="maker-hero-arrow" aria-hidden="true"><ArrowExchange /></span>
        </ButtonLink>
        <ButtonLink class="maker-hero-secondary" data-text-link href={localizePath('/about/', pageLocale)} variant="unstyled">
          <span data-text-link-label>{t('About me')}</span> <ArrowExchange direction="right" />
        </ButtonLink>
      </div>
    </div>

    <figure class="maker-hero-visual">
      <div class="maker-hero-portrait-frame">
        <Image
          alt={t('Portrait of Santiago Molina, smiling')}
          class="maker-hero-portrait"
          src={HeroPortrait}
          widths={[56, 112, 168, 216, 288, 352, 480, 600, 704, 800]}
          sizes="(min-width: 1024px) 352px, (min-width: 768px) 36vw, 3.5rem"
          width={800}
          height={1200}
          format="webp"
          quality={75}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="maker-hero-caption">
        <span data-home-portrait-name>Santiago Molina</span>
        <span>Medellín, Colombia</span>
      </figcaption>
    </figure>
  </div>

  <nav class="maker-hero-shelf" aria-label={t('Featured products')} id="hero-products">
    <p class="maker-hero-shelf-label">{t('Selected products')}</p>
    <a class="maker-hero-project" href={localizePath('/portfolio/lumen-ui/', pageLocale)}>
      <Image alt="" class="maker-hero-project-logo" src={LumenLogo} width={44} height={44} widths={[44, 88]} sizes="2.75rem" />
      <span data-home-product-copy><strong>Lumen UI</strong><span>{t('Web and native components')}</span></span>
      <ArrowExchange class="maker-hero-project-arrow" direction="up-right" />
    </a>
    <a class="maker-hero-project" href={localizePath('/portfolio/postlens/', pageLocale)}>
      <Image alt="" class="maker-hero-project-logo" src={PostLensLogo} width={44} height={44} widths={[44, 88]} sizes="2.75rem" />
      <span data-home-product-copy><strong>PostLens</strong><span>{t('Private photo editing for iPhone')}</span></span>
      <ArrowExchange class="maker-hero-project-arrow" direction="up-right" />
    </a>
    <ButtonLink class="maker-hero-index" data-text-link href={localizePath('/projects/', pageLocale)} aria-label={t('Explore all projects')} variant="unstyled"><span data-text-link-label>{t('All projects')}</span> <Icon name="plus" /></ButtonLink>
  </nav>
</section>
