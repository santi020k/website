---
import { Image } from 'astro:assets'

import HeroPortrait from '@/assets/photos/portraits/santiago-plum-soft-smile.png'

import { ButtonLink, Icon } from '@santi020k/lumen-astro'

import LumenLogo from '@/content/project/lumen-ui/logo.webp'
import PostLensLogo from '@/content/project/postlens/logo.webp'
---

<section class="signature-frame maker-hero" aria-labelledby="home-heading" data-home-hero>
  <div class="maker-hero-stage" data-home-hero-grid>
    <div class="maker-hero-copy">
      <p class="maker-hero-eyebrow">
        <span aria-hidden="true" class="maker-hero-signal"></span>
        Hey, I’m Santiago
      </p>
      <h1 id="home-heading" data-home-hero-heading>
        <span>I build products.</span>
        <span>And the <span class="maker-hero-emphasis">tools</span></span>
        <span>behind them.</span>
      </h1>
      <p class="maker-hero-description">
        Engineering lead, product builder, and creator of
        <span class="whitespace-nowrap">Lumen UI</span>.
        I build commerce platforms, native apps, and tools for developers.
      </p>
      <div class="maker-hero-actions">
        <ButtonLink class="maker-hero-primary" href="/portfolio/" variant="unstyled">
          See selected work
          <span class="maker-hero-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </ButtonLink>
        <ButtonLink class="maker-hero-secondary" href="/about/" variant="unstyled">
          About me <Icon name="arrow-right" />
        </ButtonLink>
      </div>
    </div>

    <figure class="maker-hero-visual">
      <div class="maker-hero-portrait-frame">
        <Image
          alt="Portrait of Santiago Molina, smiling"
          class="maker-hero-portrait"
          src={HeroPortrait}
          widths={[72, 144, 216, 288, 352, 480, 600, 704, 800]}
          sizes="(min-width: 1024px) 352px, (min-width: 768px) 36vw, 4.5rem"
          width={800}
          height={1200}
          format="webp"
          quality={75}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="maker-hero-caption">
        <span data-home-portrait-name>Santiago Molina</span>
        <span>Medellín, Colombia</span>
      </figcaption>
    </figure>
  </div>

  <nav class="maker-hero-shelf" aria-label="Featured products" id="hero-products">
    <p class="maker-hero-shelf-label">Selected products</p>
    <a class="maker-hero-project" href="/portfolio/lumen-ui/">
      <Image alt="" class="maker-hero-project-logo" src={LumenLogo} width={44} height={44} widths={[44, 88]} sizes="2.75rem" />
      <span><strong>Lumen UI</strong><span>Web and native components</span></span>
      <Icon class="maker-hero-project-arrow" name="arrow-up-right" />
    </a>
    <a class="maker-hero-project" href="/portfolio/postlens/">
      <Image alt="" class="maker-hero-project-logo" src={PostLensLogo} width={44} height={44} widths={[44, 88]} sizes="2.75rem" />
      <span><strong>PostLens</strong><span>Private photo editing for iPhone</span></span>
      <Icon class="maker-hero-project-arrow" name="arrow-up-right" />
    </a>
    <ButtonLink class="maker-hero-index" href="/projects/" aria-label="Explore all projects" variant="unstyled">All projects <Icon name="plus" /></ButtonLink>
  </nav>
</section>
