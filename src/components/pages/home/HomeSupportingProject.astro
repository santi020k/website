---
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'

import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  project: CollectionEntry<'project'>
  position: number
}

const { project, position } = Astro.props
---

<Card as="article" class="studio-project" variant="unstyled" data-home-supporting-project>
  <a class="studio-project-link" href={getPortfolioPath(project.id)} data-showcase-item>
    <span data-supporting-number aria-hidden="true">{String(position).padStart(2, '0')}</span>
    <div data-supporting-heading>
      <h3>{project.data.title}</h3>
      <p data-supporting-role>{project.data.role}</p>
    </div>
    <p data-supporting-description>{project.data.description}</p>
    <span data-supporting-action>Read case study</span>
    <span data-supporting-arrow><Icon class="size-4.5" name="arrow-up-right" /></span>
  </a>
</Card>

<style>
  [data-home-supporting-project][data-slot='card'] {
    container: supporting-project / inline-size;
    min-width: 0;
    height: 100%;
    border-radius: 1.375rem 1.375rem 0.375rem 1.375rem;
    overflow-wrap: anywhere;
  }

  .studio-project-link {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr) auto;
    grid-template-rows: auto 1fr auto;
    min-height: 14rem;
  }

  [data-supporting-number] {
    grid-column: 1;
    grid-row: 1;
    padding: 1.5rem 1.625rem 0.75rem;
    background: hsl(var(--surface-muted));
    color: color-mix(in srgb, var(--studio-emphasis) 85%, hsl(var(--ink)));
    font-size: 0.6875rem;
    line-height: 1.7;
    font-variant-numeric: tabular-nums;
  }

  [data-supporting-heading] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-column: 1;
    grid-row: 2 / 4;
    align-content: start;
    min-width: 0;
    gap: 1rem;
    padding: 0 1.625rem 1.625rem;
    background: hsl(var(--surface-muted));
  }

  h3 {
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.055em;
  }

  .studio-project-link:hover h3 {
    color: var(--studio-emphasis);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  [data-supporting-role] {
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    line-height: 1.7;
  }

  [data-supporting-description] {
    grid-column: 2 / 4;
    grid-row: 1 / 3;
    min-width: 0;
    padding: 1.625rem 1.75rem 1.375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.8;
  }

  [data-supporting-action] {
    grid-column: 2;
    grid-row: 3;
    padding: 0 0 1.625rem 1.75rem;
    color: var(--studio-emphasis);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.8;
  }

  [data-supporting-arrow] {
    display: grid;
    grid-column: 3;
    grid-row: 3;
    place-items: center;
    padding: 0 1.75rem 1.625rem 1.25rem;
    color: var(--studio-emphasis);
  }

  @container supporting-project (max-width: 38.75rem) {
    .studio-project-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto 1fr auto;
    }
    [data-supporting-number] { grid-column: 1 / -1; padding: 1.25rem 1.5rem 0.625rem; }
    [data-supporting-heading] { grid-column: 1 / -1; grid-row: 2; gap: 0.625rem; padding: 0 1.5rem 1.375rem; }
    [data-supporting-description] { grid-column: 1 / -1; grid-row: 3; padding: 1.5rem; }
    [data-supporting-action] { grid-column: 1; grid-row: 4; padding: 0 0 1.5rem 1.5rem; }
    [data-supporting-arrow] { grid-column: 2; grid-row: 4; padding: 0 1.5rem 1.5rem 1rem; }
  }

  @container supporting-project (width < 20rem) {
    [data-supporting-number],
    [data-supporting-heading],
    [data-supporting-description] { padding-inline: 0.75rem; }
    [data-supporting-action] { padding-left: 0.75rem; }
    [data-supporting-arrow] { padding-right: 0.75rem; }
  }
</style>
