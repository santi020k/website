---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getPortfolioPath } from '@/utils/links'
import { getProjectBrandStyle } from '@/utils/project-brand'

import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  project: CollectionEntry<'project'>
  position: number
}

const { project, position } = Astro.props
const logo = project.data.coverImage?.logo
const evidence = project.data.typesId === 'professional' ? project.data.impactMetrics[0] : undefined
---

<Card as="article" class="studio-project" variant="unstyled" data-home-supporting-project style={getProjectBrandStyle(project.data.brand)}>
  <a class="studio-project-link" href={getPortfolioPath(project.id)} data-showcase-item>
    <div data-supporting-heading>
      <div data-supporting-identity>
        <span data-supporting-number aria-hidden="true">{String(position).padStart(2, '0')}</span>
        <h3>{project.data.title}</h3>
        <p data-supporting-role>{project.data.role}</p>
      </div>
      {logo && (
        <div data-supporting-mark data-logo-surface={project.data.coverImage?.logoSurface} data-logo-aspect={project.data.coverImage?.logoAspect}>
          <Image src={logo} alt="" width={96} widths={[96, 192]} sizes="4rem" loading="lazy" />
        </div>
      )}
    </div>
    <div data-supporting-body>
      <p data-supporting-description>{project.data.description}</p>
      {evidence && <p data-supporting-evidence><Icon name="trending-up" />{evidence}</p>}
      <div data-supporting-footer>
        <span data-supporting-action>Read case study</span>
        <span data-supporting-arrow><ArrowExchange class="size-4.5" direction="up-right" /></span>
      </div>
    </div>
  </a>
</Card>

<style>
  [data-home-supporting-project][data-slot='card'] {
    container: supporting-project / inline-size;
    min-width: 0;
    height: 100%;
    border-radius: 1.375rem 1.375rem 0.375rem 1.375rem;
    overflow-wrap: break-word;
  }

  .studio-project-link { display: flex; flex-direction: column; }

  [data-supporting-heading] {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem 1.5rem 0;
    border-top: 3px solid hsl(var(--project-primary));
    background: transparent;
  }

  [data-supporting-identity] { min-width: 0; }
  [data-supporting-number] { display: block; margin-bottom: 0.75rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.7; font-variant-numeric: tabular-nums; }
  [data-supporting-mark] { display: flex; flex: none; align-items: center; justify-content: center; width: 4.75rem; height: 3.5rem; padding: 0.5rem; border-radius: 0.75rem; background: hsl(var(--surface-muted)); }
  [data-supporting-mark][data-logo-aspect='square'] { width: 3.5rem; }
  [data-supporting-mark][data-logo-surface='dark'] { background: hsl(var(--project-surface)); }
  [data-supporting-mark][data-logo-surface='light'] { background: var(--color-white); }
  [data-supporting-mark] img { display: block; min-width: 0; min-height: 0; width: 100%; height: 100%; object-fit: contain; }

  h3 { font-size: 1.625rem; font-weight: 500; line-height: 1.25; letter-spacing: -0.055em; }
  .studio-project-link:hover h3 { color: var(--studio-emphasis); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3rem; }
  [data-supporting-role] { margin-top: 0.625rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.7; }
  [data-supporting-body] { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 1.25rem; padding: 1.5rem; }
  [data-supporting-description] { color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  [data-supporting-evidence] { display: flex; align-items: flex-start; gap: 0.625rem; color: hsl(var(--ink)); font-size: 0.75rem; line-height: 1.7; }
  [data-supporting-evidence] :global(svg) { flex: none; width: 1rem; height: 1rem; margin-top: 0.125rem; color: var(--studio-emphasis); }
  [data-supporting-footer] { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--studio-rule); color: var(--studio-emphasis); }
  [data-supporting-action] { font-size: 0.75rem; font-weight: 500; line-height: 1.8; }
  [data-supporting-arrow] { display: grid; place-items: center; flex: none; }

  @container supporting-project (width >= 36rem) {
    .studio-project-link { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    [data-supporting-heading] { padding: 1.75rem; border-top: 0; border-left: 3px solid hsl(var(--project-primary)); }
    [data-supporting-body] { padding: 1.75rem; }
  }

  @container supporting-project (width < 20rem) {
    [data-supporting-heading] { padding: 1.25rem 1.25rem 0; }
    [data-supporting-body] { padding: 1.25rem; }
  }

  @container supporting-project (width < 16rem) {
    [data-supporting-heading], [data-supporting-body] { padding-inline: 0.75rem; }
    [data-supporting-mark], [data-supporting-mark][data-logo-aspect='square'] { width: 2.75rem; height: 2.75rem; padding: 0.5rem; }
    h3 { font-size: 1.5rem; }
  }

  @container supporting-project (width < 12rem) {
    [data-supporting-mark] { display: none; }
    h3 { font-size: 1.25rem; }
  }
</style>
