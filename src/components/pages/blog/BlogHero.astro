---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import { getFormattedDate } from '@/utils/date'
import { getPostPath } from '@/utils/links'
import { getReadingTime } from '@/utils/reading-time'
import { getResponsiveImageDimensions } from '@/utils/responsive-image'

import { Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  latestPost: CollectionEntry<'post'> | null
  postCount: number
  topicCount: number
}

const { latestPost, postCount, topicCount } = Astro.props
const cover = latestPost?.data.coverImage?.src
const coverDimensions = cover ? getResponsiveImageDimensions(cover, 960, [320, 480, 640, 800]) : undefined
---

<section
  class="relative signature-frame"
  data-blog-hero
>
  <div data-blog-layout data-has-latest={Boolean(latestPost)}>
    <div class="space-y-6" data-blog-intro>
      <Eyebrow label={t('collection.thePersonalBlog')} tone="brand" />
      <h1
        class="editorial-page-title"
      >
        {t('collection.thingsIBuild')}{' '}
        <span
          class="editorial-page-emphasis"
        >
          {t('collection.enjoyAndLearn')}
        </span>
      </h1>
      <p class="editorial-page-description max-w-xl">
        {t('collection.notesOnSoftwareReadingGamingAndEveryday')}
      </p>
      <div data-blog-primary-path>
        <ButtonLink href="#posts" showArrow>{t('collection.exploreTheWriting')}</ButtonLink>
        <p>{postCount} {t('collection.posts7')} <span aria-hidden="true">·</span>{' '}{t('collection.latestFirst')}</p>
      </div>
      <nav aria-label={t('collection.chooseHowToRead')} data-blog-reading-paths>
        <Link data-blog-path href={localizePath('/blog/tags/', locale)} variant="inherit">
          <span>
            <span data-blog-path-caption>{topicCount} {t('collection.topics7')}</span>
            <span data-blog-path-title>{t('collection.browseTopics')}</span>
          </span>
          <ArrowExchange direction="up-right" size="sm" />
        </Link>
        <Link data-blog-path href={localizePath('/blog/series/', locale)} variant="inherit">
          <span>
            <span data-blog-path-caption>{t('collection.connectedPosts')}</span>
            <span data-blog-path-title>{t('collection.followASeries')}</span>
          </span>
          <ArrowExchange direction="up-right" size="sm" />
        </Link>
      </nav>
    </div>
    {latestPost && (
      <Card
        as="article"
        data-blog-latest
        variant="unstyled"
      >
        <a
          data-latest-link
          href={localizePath(getPostPath(latestPost.id), locale)}
        >
          <div data-latest-cover>
            {cover ?
              (
                <Picture
                  alt=""
                  class="size-full object-cover"
                  fetchpriority="high"
                  fallbackFormat="webp"
                  formats={['avif']}
                  {...coverDimensions}
                  loading="eager"
                  sizes="(min-width: 1280px) 480px, (min-width: 1024px) 40vw, (min-width: 640px) 90vw, 100vw"
                  src={cover}
                />
              ) :
              (
                <div aria-hidden="true" class="absolute inset-0 grid-fade" />
              )}
          </div>
          <div data-latest-sheet>
            <p data-latest-label>{t('collection.latestPost')}</p>
            <h2>
              {latestPost.data.title}
            </h2>
            <p data-latest-description>{latestPost.data.description}</p>
            <div data-latest-footer>
              <p data-latest-meta>
                <time datetime={latestPost.data.publishDate.toISOString()}>
                  {getFormattedDate(latestPost.data.publishDate, {}, locale === 'es' ? 'es-419' : 'en-US')}
                </time>
                <span aria-hidden="true">·</span>
                <span>{t('reading.duration', { minutes: getReadingTime(latestPost.body) })}</span>
              </p>
              <span data-latest-action>
                {t('collection.readPost')} <ArrowExchange
class="size-4 shrink-0"
direction="up-right"
                                           />
              </span>
            </div>
          </div>
        </a>
      </Card>
    )}
  </div>
</section>

<style>
  [data-blog-hero] { container: blog-hero / inline-size; }
  [data-blog-layout] { display: grid; gap: 2.5rem; }
  [data-blog-intro] { --path-accent: var(--brand); container: blog-intro / inline-size; min-width: 0; }
  :global(:root[data-theme='santi020k-dark']) [data-blog-intro] { --path-accent: var(--accent); }
  [data-blog-primary-path] { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  [data-blog-primary-path] p { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.8; }
  [data-blog-reading-paths] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; border-block: 1px solid hsl(var(--line)); }
  [data-blog-path][data-slot='link'] { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; min-height: 5.875rem; padding-block: 1rem; color: hsl(var(--ink)); text-decoration: none; overflow-wrap: anywhere; }
  [data-blog-path-caption] { display: block; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.8; letter-spacing: 0.06em; text-transform: uppercase; }
  [data-blog-path-title] { display: block; margin-top: 0.4375rem; font-size: 1rem; font-weight: 500; line-height: 1.5; letter-spacing: -0.025em; transition: color 160ms ease; }
  [data-blog-path] :global(svg) { color: hsl(var(--path-accent)); }
  [data-blog-path]:is(:hover, :focus-visible) [data-blog-path-title] { color: hsl(var(--path-accent)); text-decoration: underline; text-underline-offset: 0.25em; }
  [data-blog-path]:focus-visible { outline: 2px solid hsl(var(--path-accent)); outline-offset: 4px; }
  @container blog-intro (width < 26rem) {
    [data-blog-reading-paths] { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-blog-path] + [data-blog-path] { border-top: 1px solid hsl(var(--line)); }
    [data-blog-path][data-slot='link'] { min-height: 5.5rem; }
  }
  @container blog-hero (width >= 52rem) {
    [data-blog-layout][data-has-latest='true'] { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: center; gap: 3.5rem; }
  }
  @media (max-width: 47.999rem) {
    [data-blog-hero] { padding-inline: min(1.125rem, 18px); }
  }
  [data-blog-latest][data-slot='card'] {
    --latest-accent: var(--brand);
    container: latest-feature / inline-size;
    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
  }
  :global(:root[data-theme='santi020k-dark']) [data-blog-latest] { --latest-accent: var(--accent); }
  [data-latest-link] { display: block; height: 100%; padding-bottom: 1.125rem; border-radius: inherit; color: inherit; text-decoration: none; }
  [data-latest-link]:focus-visible { outline: 2px solid hsl(var(--latest-accent)); outline-offset: 4px; }
  [data-latest-cover] { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 1.5rem 1.5rem 0 0; background: hsl(var(--surface-muted)); }
  [data-latest-cover] :global(picture), [data-latest-cover] :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  [data-latest-sheet] { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin: -2.375rem 1.125rem 0; padding: 1.5rem; border: 1px solid hsl(var(--line)); border-radius: 1.125rem 1.125rem 0.375rem 1.125rem; background: hsl(var(--surface)); overflow-wrap: break-word; }
  [data-latest-label] { margin: 0; color: hsl(var(--latest-accent)); font-size: 0.6875rem; line-height: 1.818; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-latest-sheet] h2 { margin: 0; color: hsl(var(--ink)); font-size: 1.5625rem; line-height: 1.25; font-weight: 500; letter-spacing: -0.045em; hyphens: none; transition: color 160ms ease; }
  [data-latest-link]:is(:hover, :focus-visible) h2 { color: hsl(var(--latest-accent)); }
  [data-latest-description] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  [data-latest-footer] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid hsl(var(--line)); }
  [data-latest-meta] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.375rem; margin: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.833; letter-spacing: normal; }
  [data-latest-action] { display: inline-flex; align-items: center; gap: 0.625rem; color: hsl(var(--latest-accent)); font-size: 0.8125rem; line-height: 1.846; font-weight: 500; letter-spacing: normal; }
  @container latest-feature (width < 23.75rem) {
    [data-latest-link] { padding-bottom: 0.75rem; }
    [data-latest-sheet] { margin-inline: 0.75rem; padding: 1.25rem 1rem; }
    [data-latest-sheet] h2 { font-size: 1.4375rem; }
  }
  @container latest-feature (width < 17rem) {
    [data-latest-sheet] { margin-inline: min(0.375rem, 6px); margin-top: -1.125rem; padding-inline: min(0.5rem, 8px); }
    [data-latest-sheet] h2 { font-size: 1.0625rem; line-height: 1.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-blog-path-title],
    [data-latest-sheet] h2 { transition: none; }
  }
</style>
