---
import { Button, Card, Icon, WorldMap } from '@santi020k/lumen-astro'
import { lumenWorldMapCountries } from '@santi020k/lumen-core/world-map-data'

import { travelCountries, travelSummary } from '@/data/travel'

const labels = Object.fromEntries(travelCountries.map(country => [country.code, country.name]))
---

<section data-travel-explorer aria-labelledby="travel-heading">
  <div data-travel-atlas>
    <p data-travel-hint><Icon name="mouse-pointer-2" class="size-4" /><span>Pick a highlighted country.<br />Swipe or zoom to explore.</span></p>
    <WorldMap
      animated={false}
      countries={lumenWorldMapCountries}
      highlightedCountries={travelCountries.map(country => country.code)}
      label="Explore my home country and the countries I have visited"
      labels={labels}
      listLabel="Explore a country with the keyboard"
      variant="dotted"
      zoomLabels={{ reset: 'Reset' }}
    />
    <Card as="section" variant="unstyled" data-travel-selection aria-labelledby="travel-selected-country" hidden>
      <div data-travel-selection-header>
        <p data-travel-category>A place in my story</p>
        <Button aria-label="Close country details" data-travel-close size="icon" variant="ghost">
          <Icon name="x" class="size-4" />
        </Button>
      </div>
      <div data-travel-destination>
        <div>
          <p data-travel-code aria-hidden="true"></p>
          <h2 id="travel-selected-country" data-travel-country></h2>
        </div>
        <svg data-travel-silhouette aria-hidden="true" focusable="false"><path /></svg>
      </div>
      <div data-travel-ledger>
        <Icon name="map-pin" class="size-4 shrink-0" />
        <p data-travel-visits></p>
      </div>
      <div data-travel-places-section>
        <h3 data-travel-places-heading>Places in my notebook</h3>
        <ul data-travel-places></ul>
        <p data-travel-empty hidden></p>
        <p data-travel-note hidden></p>
      </div>
      <div data-travel-selection-footer>
        <Button data-travel-next variant="ghost">
          <span>Explore another country</span>
          <span data-travel-next-arrow><Icon name="arrow-right" class="size-4" /></span>
        </Button>
      </div>
    </Card>
  </div>
  <header data-travel-intro>
    <div>
      <p class="maker-hero-eyebrow"><span class="maker-hero-signal" aria-hidden="true"></span>Travel &amp; life abroad</p>
      <h1 id="travel-heading">A life in<br /><span class="maker-hero-emphasis">more than one place.</span></h1>
    </div>
    <div data-travel-context>
      <p>Colombian roots. A resident of Paraguay.<br />A growing collection of places and stories.</p>
      <p data-travel-counts aria-label={`${travelSummary.countriesAbroad} countries visited abroad and ${travelSummary.countryVisits} country visits`}>
        <span><strong>{travelSummary.countriesAbroad}</strong> countries abroad</span>
        <span aria-hidden="true">/</span>
        <span><strong>{travelSummary.countryVisits}</strong> visits</span>
      </p>
    </div>
  </header>
  <p aria-live="polite" aria-atomic="true" class="sr-only" data-travel-announcement></p>
  <noscript><p class="px-6 pb-6 text-sm text-ink-soft">Explore all countries and places in the travel notebook below. The interactive map needs JavaScript.</p></noscript>
</section>

<style>
  [data-travel-explorer] {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-top: -1rem;
    transform: translateX(-50%);
    isolation: isolate;
    color: hsl(var(--ink));
  }

  [data-travel-intro] {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    width: min(calc(100% - 3rem), 72rem);
    margin-inline: auto;
    margin-top: 2rem;
    padding-block: 2rem 0;
    border-top: 1px solid hsl(var(--line) / 0.65);
  }

  #travel-heading {
    margin: 0;
    font-size: clamp(2.375rem, 4.8vw, 4.625rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.073em;
  }

  [data-travel-context] {
    max-width: 19rem;
    padding-bottom: 0.25rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.8;
    letter-spacing: -0.012em;
  }

  [data-travel-counts] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.375rem; margin-top: 1.25rem; color: hsl(var(--ink)); }
  [data-travel-counts] strong { font-size: 1.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  [data-travel-counts] > [aria-hidden] { margin-inline: 0.25rem; color: hsl(var(--ink-soft)); }
  [data-travel-atlas] { position: relative; container: travel-atlas / inline-size; }

  [data-travel-hint] {
    position: absolute;
    z-index: 2;
    left: max(1.5rem, calc((100vw - 72rem) / 2));
    bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    color: hsl(var(--ink-soft));
    background: hsl(var(--theme-bg));
    font-size: 0.625rem;
    line-height: 1.7;
    pointer-events: none;
  }

  [data-travel-explorer] :global(.ui-world-map) {
    position: relative;
    display: block;
    width: 100%;
    --ui-world-map-surface: transparent;
    --ui-world-map-land: hsl(var(--ink-soft) / 0.28);
    --ui-world-map-highlight: hsl(var(--brand));
  }

  :global([data-theme="dark"]) [data-travel-explorer] :global(.ui-world-map) {
    --ui-world-map-highlight: hsl(var(--accent));
  }

  [data-travel-explorer] :global(.ui-world-map__frame) { border-radius: 0; }
  [data-travel-explorer] :global(.ui-world-map__viewport) { width: 100%; min-width: 0; min-height: 24rem; }
  [data-travel-explorer] :global(.ui-world-map__plot) { width: calc(max(100%, 48rem) * var(--ui-world-map-zoom, 1)); }
  [data-travel-explorer] :global(.ui-world-map__country) { stroke: transparent; }
  [data-travel-explorer] :global(.ui-world-map__selection) { stroke: var(--ui-world-map-highlight); }
  [data-travel-explorer] :global(.ui-world-map__highlights),
  [data-travel-explorer] :global([data-ui-world-map-zoom="fit"]) { display: none; }

  [data-travel-explorer] :global(.ui-world-map__zoom-controls) {
    position: absolute;
    z-index: 2;
    right: max(1.5rem, calc((100vw - 72rem) / 2));
    bottom: 1.5rem;
    flex-wrap: nowrap;
    gap: 0.25rem;
    padding: 0.375rem;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1rem;
    background: hsl(var(--surface));
    box-shadow: var(--shadow-sm);
  }

  [data-travel-explorer] :global(.ui-world-map__zoom-controls button) { border-color: transparent; border-radius: 0.625rem; background: transparent; }
  [data-travel-explorer] :global(.ui-world-map__inspection) { inset: 0.5rem 1.5rem auto auto; }

  /* Preserve Lumen's keyboard selector without a second visible navigation surface. */
  [data-travel-explorer] :global(.ui-world-map__select-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  [data-travel-explorer] :global(.ui-world-map__select-label:focus-within) {
    z-index: 4;
    top: 0.5rem;
    left: max(1.5rem, calc((100vw - 72rem) / 2));
    width: min(20rem, calc(100% - 3rem));
    height: auto;
    padding: 0.75rem;
    overflow: visible;
    clip-path: none;
    border: 1px solid hsl(var(--line));
    border-radius: 1rem;
    background: hsl(var(--surface));
  }

  [data-travel-selection] {
    position: absolute;
    z-index: 3;
    right: max(1.5rem, calc((100vw - 72rem) / 2));
    bottom: 5.75rem;
    width: min(24rem, calc(100% - 3rem));
    max-height: calc(100% - 7.25rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1.5rem 0.5rem;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.5rem;
    background: hsl(var(--surface));
    box-shadow: var(--shadow-nav);
    scroll-margin-block: 7rem 1.5rem;
  }

  [data-travel-selection-header] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  [data-travel-category] { color: hsl(var(--ink-soft)); font-size: 0.625rem; font-weight: 600; line-height: 1.6; letter-spacing: 0.13em; text-transform: uppercase; }
  [data-travel-destination] { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.5rem 1.25rem; }
  [data-travel-destination] > div { min-width: 0; }
  [data-travel-code] { margin-bottom: 0.375rem; color: hsl(var(--brand)); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; }
  [data-travel-country] { margin: 0; font-size: 2rem; font-weight: 500; line-height: 1.1; letter-spacing: -0.055em; overflow-wrap: break-word; }
  [data-travel-silhouette] { flex-shrink: 0; width: 4.5rem; height: 4.5rem; fill: hsl(var(--brand) / 0.12); stroke: hsl(var(--brand) / 0.65); stroke-width: 1; }
  [data-travel-silhouette] path { vector-effect: non-scaling-stroke; }
  [data-travel-ledger] { display: flex; align-items: center; gap: 0.625rem; padding-block: 0.875rem; border-block: 1px solid hsl(var(--line) / 0.65); color: hsl(var(--ink)); font-size: 0.75rem; font-weight: 500; line-height: 1.7; }
  [data-travel-places-section] { padding-block: 1.25rem; }
  [data-travel-places-heading] { margin-bottom: 0.75rem; color: hsl(var(--ink-soft)); font-size: 0.625rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-travel-places] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1rem; padding: 0; list-style: none; }
  [data-travel-places] :global(li) { display: flex; align-items: baseline; gap: 0.5rem; color: hsl(var(--ink)); font-size: 0.8125rem; line-height: 1.6; overflow-wrap: break-word; }
  [data-travel-places] :global(li::before) { content: ''; flex-shrink: 0; width: 0.25rem; height: 0.25rem; border-radius: 50%; background: hsl(var(--brand)); transform: translateY(-0.15rem); }
  [data-travel-empty], [data-travel-note] { color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.8; }
  [data-travel-note] { margin-top: 0.875rem; }
  [data-travel-selection-footer] { border-top: 1px solid hsl(var(--line) / 0.65); }
  [data-travel-explorer] :global([data-travel-close]) { flex-shrink: 0; width: 2.75rem; min-width: 2.75rem; height: 2.75rem; border-radius: 0.875rem; background: hsl(var(--surface-muted)); }
  [data-travel-explorer] :global([data-travel-next]) { position: relative; display: flex; justify-content: space-between; gap: 1rem; width: 100%; max-width: 100%; min-height: 3.5rem; padding: 0.5rem 3rem 0.5rem 0; scroll-margin-block: 1rem; color: hsl(var(--ink)); font-size: 0.75rem; font-weight: 500; text-align: left; white-space: normal; }
  [data-travel-next-arrow] { position: absolute; top: 50%; right: 0; transform: translateY(-50%); display: grid; flex-shrink: 0; place-items: center; width: 2rem; height: 2rem; border-radius: 0.625rem; color: hsl(var(--brand)); background: hsl(var(--brand-soft)); }
  :global([data-theme="dark"]) [data-travel-code],
  :global([data-theme="dark"]) [data-travel-next-arrow] { color: hsl(var(--accent)); }
  :global([data-theme="dark"]) [data-travel-silhouette] { fill: hsl(var(--accent) / 0.12); stroke: hsl(var(--accent) / 0.65); }

  @media (max-width: 63.999rem) {
    [data-travel-intro] { align-items: start; flex-direction: column; gap: 1.5rem; }
    [data-travel-context] { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 1.5rem; width: 100%; max-width: none; }
    [data-travel-counts] { flex-shrink: 0; max-width: 100%; margin-top: 0; }
  }

  @media (max-width: 47.999rem) {
    [data-travel-explorer] { margin-top: -1.5rem; }
    [data-travel-intro] { width: calc(100% - 2.5rem); padding-block: 1.75rem 0; }
    #travel-heading { font-size: clamp(2.375rem, 9.6vw, 4.5rem); line-height: 1.06; letter-spacing: -0.065em; }
    [data-travel-context] { display: block; font-size: 0.8125rem; }
    [data-travel-counts] { margin-top: 1rem; }
    [data-travel-atlas] { --travel-map-height: clamp(32rem, 68svh, 42rem); }
    [data-travel-explorer] :global(.ui-world-map__viewport) { aspect-ratio: auto; height: var(--travel-map-height); }
    [data-travel-explorer] :global(.ui-world-map__plot) { width: calc(max(100%, var(--travel-map-height) * 2.5) * var(--ui-world-map-zoom, 1)); }
    [data-travel-hint] { top: 0.75rem; bottom: auto; left: 0.75rem; }
    [data-travel-explorer] :global(.ui-world-map__zoom-controls) { right: 1.25rem; bottom: 1.25rem; }
    [data-travel-selection] { position: relative; inset: auto; width: auto; max-height: none; margin: 1rem 1.25rem 0; overflow: visible; box-shadow: var(--shadow-sm); }
  }

  /* Keep the map visible beside its details, including when text is enlarged. */
  @container travel-atlas (width < 30rem) {
    [data-travel-hint] { top: 0.75rem; bottom: auto; left: 0.75rem; }
    [data-travel-explorer] :global(.ui-world-map__zoom-controls) { right: 1.25rem; bottom: 1.25rem; }
    [data-travel-selection] { position: relative; inset: auto; width: auto; max-height: none; margin: 1rem 1.25rem 0; overflow: visible; box-shadow: var(--shadow-sm); }
  }

  /* Too narrow for overlays: the hint and zoom toolbar keep their source position
     above the map and the details follow it, so nothing covers the map or the details.
     The country name and place list keep the available width. */
  @container travel-atlas (width < 20rem) {
    [data-travel-hint] { position: static; margin: 0 1.25rem 0.75rem; padding: 0; background: none; }
    [data-travel-explorer] :global(.ui-world-map__zoom-controls) {
      position: static;
      flex-wrap: wrap;
      justify-content: start;
      width: fit-content;
      max-width: calc(100% - 2.5rem);
      margin-inline: 1.25rem;
    }
    [data-travel-selection] { position: relative; inset: auto; width: auto; max-height: none; margin: 1rem 0.5rem 0; padding: 0.75rem; overflow: visible; box-shadow: none; }
    [data-travel-destination] { align-items: start; }
    [data-travel-silhouette] { display: none; }
    [data-travel-places] { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { getTravelVisitLabel, travelCountries } from '@/data/travel'

  const initializeTravelMap = () => {
    const explorer = document.querySelector<HTMLElement>('[data-travel-explorer]')

    if (!explorer || explorer.dataset.bound === 'true') return

    const panel = explorer.querySelector<HTMLElement>('[data-travel-selection]')
    const heading = explorer.querySelector<HTMLElement>('[data-travel-country]')
    const category = explorer.querySelector<HTMLElement>('[data-travel-category]')
    const visits = explorer.querySelector<HTMLElement>('[data-travel-visits]')
    const places = explorer.querySelector<HTMLElement>('[data-travel-places]')
    const note = explorer.querySelector<HTMLElement>('[data-travel-note]')
    const empty = explorer.querySelector<HTMLElement>('[data-travel-empty]')
    const placesHeading = explorer.querySelector<HTMLElement>('[data-travel-places-heading]')
    const code = explorer.querySelector<HTMLElement>('[data-travel-code]')
    const silhouette = explorer.querySelector<SVGSVGElement>('[data-travel-silhouette]')
    const announcement = explorer.querySelector<HTMLElement>('[data-travel-announcement]')
    const chooser = explorer.querySelector<HTMLSelectElement>('select')
    const viewport = explorer.querySelector<HTMLElement>('[data-ui-world-map-viewport]')

    if (!panel || !heading || !category || !visits || !places || !note || !empty || !placesHeading) return

    if (!code || !silhouette || !announcement || !chooser || !viewport) return

    explorer.dataset.bound = 'true'

    let selectedCode = ''

    const revealCountry = (countryId: string, behavior: ScrollBehavior) => {
      const path = [...explorer.querySelectorAll<SVGPathElement>('[data-ui-world-map-country]')]
        .find(element => element.dataset.uiWorldMapCountry === countryId)

      if (!path) return

      const bounds = path.getBoundingClientRect()
      const frame = viewport.getBoundingClientRect()

      if (bounds.width < frame.width && (bounds.left < frame.left || bounds.right > frame.right)) {
        viewport.scrollTo({
          left: viewport.scrollLeft + bounds.left - frame.left + bounds.width / 2 - frame.width / 2,
          behavior
        })
      }

      return path
    }

    // Lumen initializes asynchronously and resets the viewport when it enables
    // the chooser. Center home after that reset, without selecting a country.
    const centerHome = () => {
      if (!selectedCode && window.matchMedia('(max-width: 47.999rem)').matches) revealCountry('CO', 'instant')
    }

    if (chooser.disabled) {
      const readiness = new MutationObserver((_changes, observer) => {
        if (chooser.disabled) return

        centerHome()

        observer.disconnect()
      })

      readiness.observe(chooser, { attributes: true, attributeFilter: ['disabled'] })

      document.addEventListener('astro:before-swap', () => readiness.disconnect(), { once: true })
    } else {
      centerHome()
    }

    const closeDetails = (restoreFocus = panel.contains(document.activeElement)) => {
      panel.hidden = true

      selectedCode = ''

      chooser.value = ''

      chooser.dispatchEvent(new Event('change', { bubbles: true }))

      announcement.textContent = 'Country details closed.'

      if (restoreFocus) viewport.focus({ preventScroll: true })
    }

    chooser.addEventListener('change', () => {
      if (!chooser.value && !panel.hidden) closeDetails()
    })

    explorer.querySelector('[data-travel-close]')?.addEventListener('click', () => closeDetails(true))

    explorer.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !panel.hidden) closeDetails()
    })

    explorer.querySelector('[data-travel-next]')?.addEventListener('click', () => {
      const index = travelCountries.findIndex(country => country.code === selectedCode)
      const next = travelCountries[(index + 1) % travelCountries.length]

      if (!next) return

      chooser.value = next.code

      chooser.dispatchEvent(new Event('change', { bubbles: true }))
    })

    explorer.addEventListener('ui:world-map-select', event => {
      if (!(event instanceof CustomEvent)) return

      const detail: unknown = event.detail

      if (typeof detail !== 'object' || detail === null || !('countryId' in detail) || typeof detail.countryId !== 'string') return

      const country = travelCountries.find(entry => entry.code === detail.countryId)

      selectedCode = detail.countryId

      heading.textContent = country?.name ?? ('label' in detail && typeof detail.label === 'string' ? detail.label : 'More places to discover')

      category.textContent = country ? 'A place in my story' : 'Beyond the notebook'

      code.textContent = selectedCode

      if (country?.connection === 'home') category.textContent = 'Where my story begins'

      if (country?.connection === 'resident') category.textContent = 'Country of residence'

      visits.textContent = country ? getTravelVisitLabel(country) : 'No entry in my travel journal'

      places.replaceChildren(...(country?.places ?? []).map(place => {
        const item = document.createElement('li')

        item.textContent = place

        return item
      }))

      places.hidden = !country?.places.length

      placesHeading.hidden = places.hidden

      empty.textContent = country?.connection === 'home' ? 'I’m from Colombia. This is where my story begins.' : 'Choose a highlighted country to explore the places I have visited.'

      empty.hidden = !places.hidden

      note.textContent = country?.note ?? ''

      note.hidden = !country?.note

      panel.hidden = false

      announcement.textContent = `${heading.textContent}. ${visits.textContent}. ${country?.places.length ? country.places.join(', ') : empty.textContent}`

      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
      const path = revealCountry(selectedCode, behavior)

      silhouette.style.display = path ? '' : 'none'

      if (path) {
        const bounds = path.getBBox()
        const padding = Math.max(bounds.width, bounds.height) * 0.08

        silhouette.setAttribute('viewBox', `${bounds.x - padding} ${bounds.y - padding} ${bounds.width + padding * 2} ${bounds.height + padding * 2}`)

        silhouette.querySelector('path')?.setAttribute('d', path.getAttribute('d') ?? '')
      }

      // The phone note follows the map instead of covering the selected country.
      // Keep keyboard selection in place; Tab naturally reaches the note next.
      if (getComputedStyle(panel).position === 'relative' && document.activeElement !== chooser && !panel.contains(document.activeElement)) {
        panel.scrollIntoView({ block: 'nearest', behavior })
      }
    })
  }

  document.addEventListener('astro:page-load', initializeTravelMap)
</script>
