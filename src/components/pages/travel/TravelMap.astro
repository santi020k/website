---
import { Card, WorldMap } from '@santi020k/lumen-astro'
import { lumenWorldMapCountries } from '@santi020k/lumen-core/world-map-data'

import { travelCountries } from '@/data/travel'

const labels = Object.fromEntries(travelCountries.map(country => [country.code, country.name]))
---

<div
class="
  grid min-w-0 gap-6
  xl:grid-cols-[minmax(0,1fr)_18rem]
"
data-travel-explorer
>
  <WorldMap
    animated={false}
    class="min-w-0"
    countries={lumenWorldMapCountries}
    highlightedCountries={travelCountries.map(country => country.code)}
    label="My home country and the countries I have visited"
    labels={labels}
    listLabel="Explore a country"
    selectedCountry="CO"
    variant="solid"
  />
  <Card
as="section"
aria-atomic="true"
aria-live="polite"
class="self-start p-6"
data-travel-selection
  >
    <p class="
      mb-3 text-xs font-semibold tracking-widest text-ink-muted uppercase
    "
    >A place in my story</p>
    <h3 class="text-2xl font-semibold" data-travel-country>Colombia</h3>
    <p class="mt-2 text-sm font-medium text-ink" data-travel-visits>Home country</p>
    <p class="mt-4 text-sm/7 text-ink-soft" data-travel-places>I’m from Colombia. This is where my story begins.</p>
    <p class="mt-3 text-sm/7 text-ink-soft" data-travel-note hidden></p>
    <a
class="
  mt-5 inline-flex min-h-11 items-center ui-label underline underline-offset-4
"
data-travel-link
href="#country-co"
    >See country details</a>
  </Card>
</div>

<script>
  import { getTravelVisitLabel, travelCountries } from '@/data/travel'

  const initializeTravelMap = () => {
    const explorer = document.querySelector<HTMLElement>('[data-travel-explorer]')

    if (!explorer || explorer.dataset.bound === 'true') return

    explorer.dataset.bound = 'true'

    const heading = explorer.querySelector<HTMLElement>('[data-travel-country]')
    const visits = explorer.querySelector<HTMLElement>('[data-travel-visits]')
    const places = explorer.querySelector<HTMLElement>('[data-travel-places]')
    const note = explorer.querySelector<HTMLElement>('[data-travel-note]')
    const link = explorer.querySelector<HTMLAnchorElement>('[data-travel-link]')

    if (!heading || !visits || !places || !note || !link) return

    explorer.addEventListener('ui:world-map-select', event => {
      if (!(event instanceof CustomEvent)) return

      const detail: unknown = event.detail

      if (typeof detail !== 'object' || detail === null || !('countryId' in detail) || typeof detail.countryId !== 'string') return

      const country = travelCountries.find(entry => entry.code === detail.countryId)

      heading.textContent = country?.name ?? 'More places to discover'

      visits.textContent = country ? getTravelVisitLabel(country) : 'No entry in my travel journal'

      places.textContent = country?.connection === 'home' ?
        'I’m from Colombia. This is where my story begins.' :
        country?.places.join(' · ') ?? 'Choose a highlighted country to explore the places I have visited.'

      note.textContent = country?.note ?? ''

      note.hidden = !country?.note

      link.hidden = !country

      if (country) link.href = `#country-${country.code.toLowerCase()}`
    })
  }

  document.addEventListener('astro:page-load', initializeTravelMap)
</script>
