---
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import { Button, Card, Icon, WorldMap } from '@santi020k/lumen-astro'
import { lumenWorldMapCountries } from '@santi020k/lumen-core/world-map-data'

import { travelCountries, travelSummary } from '@/data/travel'

const labels = Object.fromEntries(travelCountries.map(country => [country.code, country.name]))
---

<section data-travel-explorer aria-labelledby="travel-heading">
  <header data-travel-intro>
    <div>
      <Eyebrow label="Travel · Digital nomad" tone="brand" />
      <h1
class="
  mt-5 text-4xl font-semibold tracking-tight
  sm:text-6xl
  lg:text-6xl
"
id="travel-heading"
      >
        A life in<br />more than one place.
      </h1>
    </div>
    <div data-travel-context>
      <p class="text-sm/7 text-ink-soft">Colombian roots. A resident of Paraguay.<br />A growing collection of places and stories.</p>
      <p class="mt-4 text-sm text-ink" aria-label={`${travelSummary.countriesAbroad} countries visited abroad and ${travelSummary.countryVisits} country visits`}>
        <strong class="text-xl tabular-nums">{travelSummary.countriesAbroad}</strong> countries abroad
        <span class="mx-2 text-ink-muted" aria-hidden="true">/</span>
        <strong class="text-xl tabular-nums">{travelSummary.countryVisits}</strong> visits
      </p>
    </div>
  </header>

  <div data-travel-atlas>
    <p data-travel-hint class="text-xs text-ink-soft"><Icon
name="mouse-pointer-2"
class="size-4"
                                                      /> Pick a highlighted country. Swipe or zoom to explore.</p>
    <WorldMap
      animated={false}
      countries={lumenWorldMapCountries}
      highlightedCountries={travelCountries.map(country => country.code)}
      label="Explore my home country and the countries I have visited"
      labels={labels}
      listLabel="Explore a country with the keyboard"
      variant="dotted"
      zoomLabels={{ reset: 'Reset' }}
    />
    <Card as="section" data-travel-selection aria-labelledby="travel-selected-country" hidden>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p
class="mb-2 text-xs font-semibold tracking-widest text-ink-muted uppercase"
data-travel-category
          >A place in my story</p>
          <h2 class="text-2xl font-semibold" id="travel-selected-country" data-travel-country></h2>
        </div>
        <Button aria-label="Close country details" data-travel-close size="icon" variant="ghost"><Icon
name="x"
class="size-4"
                                                                                                 /></Button>
      </div>
      <p class="mt-2 text-sm font-medium text-ink" data-travel-visits></p>
      <p class="mt-4 text-sm/7 text-ink-soft" data-travel-places></p>
      <p class="mt-3 text-xs/6 text-ink-soft" data-travel-note hidden></p>
      <Button class="mt-5" data-travel-next size="sm" variant="outline">Explore another country <Icon
name="arrow-right"
class="size-4"
                                                                                                /></Button>
    </Card>
  </div>
  <p aria-live="polite" aria-atomic="true" class="sr-only" data-travel-announcement></p>
  <noscript><p class="px-6 pb-6 text-sm text-ink-soft">Explore all countries and places in the travel notebook below. The interactive map needs JavaScript.</p></noscript>
</section>

<style>
  [data-travel-explorer] {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-3xl);
    background: radial-gradient(ellipse at 100% 0, hsl(var(--brand) / 0.08), transparent 65%), hsl(var(--canvas));
  }

  [data-travel-intro] {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem clamp(1.5rem, 4vw, 4rem) 0.5rem;
  }

  [data-travel-context] { max-width: 19rem; padding-bottom: 0.5rem; }
  [data-travel-atlas] { position: relative; }
  [data-travel-hint] { display: flex; align-items: center; gap: 0.5rem; margin: 1rem 2rem; }

  [data-travel-explorer] :global(.ui-world-map) {
    position: relative;
    display: block;
    max-width: 75rem;
    margin-inline: auto;
    --ui-world-map-surface: transparent;
    --ui-world-map-land: hsl(var(--ink-soft) / 0.35);
    --ui-world-map-highlight: hsl(var(--accent));
  }

  [data-travel-explorer] :global(.ui-world-map__frame) { border-radius: 0; }
  [data-travel-explorer] :global(.ui-world-map__viewport) { width: 100%; min-width: 0; min-height: 16rem; }
  [data-travel-explorer] :global(.ui-world-map__plot) { width: calc(max(100%, 40rem) * var(--ui-world-map-zoom, 1)); }
  [data-travel-explorer] :global(.ui-world-map__country) { stroke: transparent; }
  [data-travel-explorer] :global(.ui-world-map__selection) { stroke: var(--ui-world-map-highlight); }
  [data-travel-explorer] :global(.ui-world-map__highlights),
  [data-travel-explorer] :global([data-ui-world-map-zoom="fit"]) { display: none; }

  [data-travel-explorer] :global(.ui-world-map__zoom-controls) {
    position: absolute;
    z-index: 2;
    right: 1.25rem;
    bottom: 1.25rem;
    flex-wrap: nowrap;
    gap: 0.25rem;
    padding: 0.375rem;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-2xl);
    background: hsl(var(--surface));
    box-shadow: var(--shadow-sm);
  }

  [data-travel-explorer] :global(.ui-world-map__zoom-controls button) { border-color: transparent; background: transparent; }
  [data-travel-explorer] :global(.ui-world-map__inspection) { inset: 0.5rem 1.25rem auto auto; }

  /* Preserve Lumen's keyboard selector without a second visible navigation surface. */
  [data-travel-explorer] :global(.ui-world-map__select-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  [data-travel-explorer] :global(.ui-world-map__select-label:focus-within) {
    z-index: 4;
    top: 0.5rem;
    left: 1rem;
    width: min(20rem, calc(100% - 2rem));
    height: auto;
    padding: 0.75rem;
    overflow: visible;
    clip-path: none;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-xl);
    background: hsl(var(--surface));
  }

  [data-travel-selection] {
    position: absolute;
    z-index: 3;
    right: 1.25rem;
    bottom: 5.5rem;
    width: min(21rem, calc(100% - 2.5rem));
    padding: 1.5rem;
    background: hsl(var(--surface));
    box-shadow: var(--shadow-xl);
  }

  @media (max-width: 47.99rem) {
    [data-travel-intro] { display: block; }
    [data-travel-context] { margin-top: 1.25rem; }
    [data-travel-hint] { margin: 0.75rem 1.5rem; max-width: 18rem; line-height: 1.6; }
    [data-travel-hint] :global(svg) { flex-shrink: 0; }
    [data-travel-explorer] :global(.ui-world-map__zoom-controls) { right: 0.75rem; bottom: 0.75rem; }
    [data-travel-selection] { right: 0.75rem; left: 0.75rem; bottom: 4.75rem; width: auto; max-height: 18rem; overflow-y: auto; padding: 1.25rem; }
  }
</style>

<script>
  import { getTravelVisitLabel, travelCountries } from '@/data/travel'

  const initializeTravelMap = () => {
    const explorer = document.querySelector<HTMLElement>('[data-travel-explorer]')

    if (!explorer || explorer.dataset.bound === 'true') return

    const panel = explorer.querySelector<HTMLElement>('[data-travel-selection]')
    const heading = explorer.querySelector<HTMLElement>('[data-travel-country]')
    const category = explorer.querySelector<HTMLElement>('[data-travel-category]')
    const visits = explorer.querySelector<HTMLElement>('[data-travel-visits]')
    const places = explorer.querySelector<HTMLElement>('[data-travel-places]')
    const note = explorer.querySelector<HTMLElement>('[data-travel-note]')
    const announcement = explorer.querySelector<HTMLElement>('[data-travel-announcement]')
    const chooser = explorer.querySelector<HTMLSelectElement>('select')
    const viewport = explorer.querySelector<HTMLElement>('[data-ui-world-map-viewport]')

    if (!panel || !heading || !category || !visits || !places || !note || !announcement || !chooser || !viewport) return

    explorer.dataset.bound = 'true'

    let selectedCode = ''

    const closeDetails = () => {
      const restoreFocus = panel.contains(document.activeElement)

      panel.hidden = true

      selectedCode = ''

      chooser.value = ''

      chooser.dispatchEvent(new Event('change', { bubbles: true }))

      announcement.textContent = 'Country details closed.'

      if (restoreFocus) viewport.focus({ preventScroll: true })
    }

    chooser.addEventListener('change', () => {
      if (!chooser.value && !panel.hidden) closeDetails()
    })

    explorer.querySelector('[data-travel-close]')?.addEventListener('click', closeDetails)

    explorer.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !panel.hidden) closeDetails()
    })

    explorer.querySelector('[data-travel-next]')?.addEventListener('click', () => {
      const index = travelCountries.findIndex(country => country.code === selectedCode)
      const next = travelCountries[(index + 1) % travelCountries.length]

      if (!next) return

      chooser.value = next.code

      chooser.dispatchEvent(new Event('change', { bubbles: true }))
    })

    explorer.addEventListener('ui:world-map-select', event => {
      if (!(event instanceof CustomEvent)) return

      const detail: unknown = event.detail

      if (typeof detail !== 'object' || detail === null || !('countryId' in detail) || typeof detail.countryId !== 'string') return

      const country = travelCountries.find(entry => entry.code === detail.countryId)

      selectedCode = detail.countryId

      heading.textContent = country?.name ?? ('label' in detail && typeof detail.label === 'string' ? detail.label : 'More places to discover')

      category.textContent = 'A place in my story'

      if (country?.connection === 'home') category.textContent = 'Where my story begins'

      if (country?.connection === 'resident') category.textContent = 'Country of residence'

      visits.textContent = country ? getTravelVisitLabel(country) : 'No entry in my travel journal'

      places.textContent = country?.connection === 'home' ? 'I’m from Colombia. This is where my story begins.' : country?.places.join(' · ') ?? 'Choose a highlighted country to explore the places I have visited.'

      note.textContent = country?.note ?? ''

      note.hidden = !country?.note

      panel.hidden = false

      announcement.textContent = `${heading.textContent}. ${visits.textContent}. ${places.textContent}`

      const path = [...explorer.querySelectorAll<SVGPathElement>('[data-ui-world-map-country]')]
        .find(element => element.dataset.uiWorldMapCountry === selectedCode)

      if (!path) return

      const bounds = path.getBoundingClientRect()
      const frame = viewport.getBoundingClientRect()

      if (bounds.width < frame.width && (bounds.left < frame.left || bounds.right > frame.right)) {
        viewport.scrollTo({
          left: viewport.scrollLeft + bounds.left - frame.left + bounds.width / 2 - frame.width / 2,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        })
      }
    })
  }

  document.addEventListener('astro:page-load', initializeTravelMap)
</script>
