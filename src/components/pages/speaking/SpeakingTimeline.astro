---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { Card, Icon, Link, Timeline } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)

interface Props {
  talks: CollectionEntry<'talk'>['data'][]
}

const { talks } = Astro.props

const dateFormatter = new Intl.DateTimeFormat(pageLocale === 'es' ? 'es-419' : 'en-US', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC'
})

const evidenceDetails = {
  private: { icon: 'briefcase-business', label: t('page.privateSessions') },
  public: { icon: 'check', label: t('page.publicRecord') },
  reconstructed: { icon: 'history', label: t('page.reconstructed') }
} as const
---

<Timeline data-speaking-timeline>
  {talks.map(talk => {
    const evidenceKey = talk.evidence ?? 'public'
    const evidence = evidenceDetails[evidenceKey]
    const hasLinks = talk.links.event ?? talk.links.slides ?? talk.links.video

    return (
      <li data-speaking-row data-evidence={evidenceKey}>
        <div data-session-date>
          {talk.date ?
(
            <time datetime={talk.date.toISOString().slice(0, 10)}>
              <span data-session-day>{dateFormatter.format(talk.date)}</span>{' '}
              <span data-session-year>{talk.date.getUTCFullYear()}</span>
            </time>
          ) :
(
            <span data-session-period>{talk.dateLabel ?? String(talk.year)}</span>
          )}
        </div>
        <Card as="article" variant="unstyled" data-session-folio>
          <div data-speaking-row-body>
            <div data-session-masthead>
              <p data-session-event>{talk.event}</p>
              <span data-session-evidence>
                <Icon class="size-3.5 shrink-0" name={evidence.icon} />
                <span>{evidence.label}</span>
              </span>
            </div>
            <h3 data-session-title>{talk.title}</h3>
            {(talk.location || talk.audience) && (
              <div data-session-location>
                {talk.location && <span>{talk.location}</span>}
                {talk.location && talk.audience && <span aria-hidden="true">·</span>}
                {talk.audience && <span>{talk.audience}</span>}
              </div>
            )}
            <p data-session-description>{talk.description}</p>
          </div>
          <div data-session-footer>
            <ul data-session-tags aria-label={t('page.topics')}>
              {talk.tags.map(tag => <li>{tag}</li>)}
            </ul>
            {hasLinks && (
              <div data-session-links>
                {talk.links.event && (
                  <div data-session-resource>
                    <p>{t('page.event')}</p>
                    <Link href={localizePath(talk.links.event, pageLocale)} newTab variant="inherit">
                      <span>{t('page.viewRecord')}</span><ArrowExchange data-session-resource-arrow direction="up-right" size="sm" />
                    </Link>
                  </div>
                )}
                {talk.links.slides && (
                  <div data-session-resource>
                    <p>{t('page.slides')}</p>
                    <Link href={localizePath(talk.links.slides, pageLocale)} newTab variant="inherit">
                      <span>{t('page.openDeck')}</span><ArrowExchange data-session-resource-arrow direction="up-right" size="sm" />
                    </Link>
                  </div>
                )}
                {talk.links.video && (
                  <div data-session-resource>
                    <p>{t('page.recording')}</p>
                    <Link href={localizePath(talk.links.video, pageLocale)} newTab variant="inherit">
                      <span>{t('page.watchTalk')}</span><ArrowExchange data-session-resource-arrow direction="up-right" size="sm" />
                    </Link>
                  </div>
                )}
              </div>
            )}
          </div>
        </Card>
      </li>
    )
  })}
</Timeline>

<style>
  [data-speaking-timeline] {
    --session-accent: var(--brand);
    container: speaking-timeline / inline-size;
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(:root[data-theme='santi020k-dark']) [data-speaking-timeline] { --session-accent: var(--accent); }
  [data-speaking-row] { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1.25rem; min-width: 0; }
  [data-session-date] { min-width: 0; padding-top: 1.5rem; border-top: 2px solid hsl(var(--session-accent)); color: hsl(var(--ink-soft)); }
  [data-session-date] time { display: flex; flex-direction: column; gap: 0.375rem; }
  [data-session-day] { font-size: 0.75rem; line-height: 1.667; }
  [data-session-year] { color: hsl(var(--session-accent)); font-size: 1.875rem; line-height: 1.2; font-weight: 500; letter-spacing: -0.05em; }
  [data-session-period] { font-size: 1.125rem; line-height: 1.6; font-weight: 500; }
  [data-session-folio][data-slot='card'] {
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 1.375rem 1.375rem 0.375rem 1.375rem;
    background: hsl(var(--surface));
  }
  [data-speaking-row-body] { padding: 1.75rem; }
  [data-session-masthead] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.625rem 1rem; }
  [data-session-event] { color: hsl(var(--session-accent)); font-size: 0.6875rem; line-height: 1.64; font-weight: 500; letter-spacing: 0.09em; text-transform: uppercase; }
  [data-session-evidence] { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.64; }
  [data-session-folio] [data-session-title] { margin: 1.375rem 0 0; font-size: 1.75rem; line-height: 1.2; font-weight: 500; letter-spacing: -0.045em; text-wrap: wrap; hyphens: manual; }
  [data-session-location] { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 1rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.833; }
  [data-session-description] { max-width: 68ch; margin-top: 1.125rem; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  [data-session-footer] { padding: 0.875rem 1.75rem; border-top: 1px solid hsl(var(--line)); background: hsl(var(--brand-soft)); }
  [data-session-tags] { display: flex; flex-wrap: wrap; gap: 0.375rem 1rem; margin: 0; padding: 0; list-style: none; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-session-tags] > li { min-width: 0; overflow-wrap: anywhere; }
  [data-session-links] { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 7rem), 1fr)); gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid hsl(var(--line)); }
  [data-session-resource] { min-width: 0; }
  [data-session-resource] > p { color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.8; letter-spacing: 0.08em; text-transform: uppercase; }
  [data-session-links] :global(a) { display: flex; align-items: center; justify-content: space-between; gap: 0.625rem; min-height: 2.75rem; color: hsl(var(--ink)); font-size: 0.75rem; font-weight: 500; line-height: 1.8; text-decoration: none; }
  [data-session-resource] span { min-width: 0; overflow-wrap: anywhere; }
  [data-session-links] :global([data-session-resource-arrow]) { flex-shrink: 0; color: hsl(var(--session-accent)); }
  [data-session-links] :global(a:hover) { color: hsl(var(--session-accent)); text-decoration: underline; text-underline-offset: 0.25rem; }
  [data-session-links] :global(a:focus-visible) { outline: 2px solid hsl(var(--session-accent)); outline-offset: 0.25rem; }
  :global(:root[data-theme='santi020k-dark']) [data-session-footer] { background: color-mix(in srgb, hsl(var(--brand-soft)) 55%, hsl(var(--surface))); }
  @container speaking-timeline (width < 32.5rem) {
    [data-speaking-row] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-session-date] { padding-top: 0.75rem; }
    [data-session-date] time { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 0.75rem; }
    [data-session-year] { font-size: 1.625rem; }
    [data-session-links] { grid-template-columns: minmax(0, 1fr); gap: 0.625rem; }
    [data-session-resource] + [data-session-resource] { padding-top: 0.625rem; border-top: 1px solid hsl(var(--line)); }
  }
  @container speaking-timeline (width < 25rem) {
    [data-speaking-row-body] { padding: 1.5rem 1.25rem; }
    [data-session-footer] { padding-inline: 1.25rem; }
    [data-session-folio] [data-session-title] { font-size: 1.5625rem; }
  }
  @container speaking-timeline (width < 16rem) {
    [data-speaking-row-body], [data-session-footer] { padding-inline: 0.5rem; }
    [data-session-folio] [data-session-title] { font-size: 1.125rem; line-height: 1.4; }
    [data-session-tags] { column-gap: 0.75rem; }
    [data-session-location] > [aria-hidden] { display: none; }
  }
  @media (forced-colors: active) {
    [data-session-date] { border-color: CanvasText; }
  }
</style>
