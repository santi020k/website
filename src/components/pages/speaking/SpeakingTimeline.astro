---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'

import { Card, Icon, Timeline, TimelineItem } from '@santi020k/lumen-astro'

interface Props {
  talks: CollectionEntry<'talk'>['data'][]
}

const { talks } = Astro.props

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'short',
  timeZone: 'UTC',
  year: 'numeric'
})

const evidenceDetails = {
  private: {
    icon: 'briefcase-business',
    label: 'Private sessions',
    tone: 'neutral'
  },
  public: {
    icon: 'check',
    label: 'Public record',
    tone: 'brand'
  },
  reconstructed: {
    icon: 'history',
    label: 'Reconstructed',
    tone: 'outline'
  }
} as const

type Talk = (typeof talks)[number]

const getDateLabel = (talk: Talk) => {
  if (talk.date) return dateFormatter.format(talk.date)

  return talk.dateLabel ?? String(talk.year)
}
---

<Card class="overflow-hidden rounded-[1.75rem] p-0" variant="default">
  <Timeline data-speaking-timeline class="relative">
    {talks.map((talk: Talk) => {
      const evidenceKey = talk.evidence ?? 'public'
      const evidence = evidenceDetails[evidenceKey]
      const hasLinks = talk.links.event ?? talk.links.slides ?? talk.links.video

      return (
        <TimelineItem data-evidence={evidenceKey} data-speaking-row>
          <span
            slot="dot"
            aria-hidden="true"
            class:list={[
              `
                flex size-7 items-center justify-center rounded-full border
                transition-[background-color,border-color,color] duration-200
                motion-reduce:transition-none
              `,
              evidenceKey === 'public' ?
                'border-brand/40 bg-brand text-white' :
                'border-line/70 bg-surface text-ink-muted'
            ]}
          >
            <Icon class="size-3.5" name={evidence.icon} />
          </span>

          <article
            class="
              py-6 pr-5 pl-16
              sm:py-7 sm:pr-7 sm:pl-20
            "
          >
            <div
              class="
                flex flex-col gap-4
                sm:flex-row sm:items-start sm:justify-between
              "
            >
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2.5">
                  <p class="section-label text-brand">{talk.event}</p>
                  <Pill label={evidence.label} tone={evidence.tone} />
                </div>
                <h3
                  class="
                    mt-2 text-xl/tight font-semibold tracking-[-0.02em] text-ink
                    sm:text-2xl/tight
                  "
                >
                  {talk.title}
                </h3>
              </div>

              <div
                class="
                  flex shrink-0 items-center gap-2 text-xs font-medium
                  text-ink-muted tabular-nums
                  sm:pt-1
                "
              >
                <Icon aria-hidden="true" class="size-3.5" name="calendar-days" />
                <time datetime={talk.date?.toISOString().slice(0, 10)}>{getDateLabel(talk)}</time>
              </div>
            </div>

            <div class="
              mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs
              text-ink-muted
            "
            >
              {talk.location && <span>{talk.location}</span>}
              {talk.location && talk.audience && <span aria-hidden="true">·</span>}
              {talk.audience && <span>{talk.audience}</span>}
            </div>

            <p class="
              mt-4 max-w-3xl text-sm/7 text-ink-soft
              sm:text-base/7
            "
            >
              {talk.description}
            </p>

            <div
              class="
                mt-5 flex flex-col gap-4 border-t border-line/35 pt-4
                sm:flex-row sm:items-center sm:justify-between
              "
            >
              <div class="flex flex-wrap gap-2">
                {talk.tags.map(tag => <Pill label={tag} tone="outline" />)}
              </div>

              {hasLinks && (
                <div class="
                  flex shrink-0 flex-wrap items-center gap-x-4 gap-y-2
                "
                >
                  {talk.links.event && (
                    <ButtonLink href={talk.links.event} newTab showArrow variant="inline">
                      Event record
                    </ButtonLink>
                  )}
                  {talk.links.slides && (
                    <ButtonLink href={talk.links.slides} newTab showArrow variant="inline">
                      Slides
                    </ButtonLink>
                  )}
                  {talk.links.video && (
                    <ButtonLink href={talk.links.video} newTab showArrow variant="inline">
                      Watch talk
                    </ButtonLink>
                  )}
                </div>
              )}
            </div>
          </article>
        </TimelineItem>
      )
    })}
  </Timeline>
</Card>

<style>
  [data-speaking-timeline] :global(.ui-timeline-item) {
    padding-bottom: 0;
  }

  [data-speaking-timeline] :global(.ui-timeline-item:not(:last-child)) {
    border-bottom: 1px solid hsl(var(--line) / 0.35);
  }

  [data-speaking-timeline] :global(.ui-timeline-item__content) {
    margin-left: 0;
  }

  [data-speaking-timeline] :global(.ui-timeline-item__dot) {
    top: 1.5rem;
    left: 1.15rem;
    width: 2rem;
    background: transparent;
    transform: none;
  }

  [data-speaking-timeline] :global(.ui-timeline-item__tail) {
    z-index: 1;
    top: 3.25rem;
    left: 2.15rem;
    width: 1px;
    height: calc(100% - 1.5rem);
    background: linear-gradient(
      to bottom,
      hsl(var(--brand) / 0.3),
      hsl(var(--line) / 0.55)
    );
  }

  @media (min-width: 40rem) {
    [data-speaking-timeline] :global(.ui-timeline-item__dot) {
      top: 1.75rem;
      left: 1.5rem;
    }

    [data-speaking-timeline] :global(.ui-timeline-item__tail) {
      top: 3.5rem;
      left: 2.5rem;
    }
  }
</style>
