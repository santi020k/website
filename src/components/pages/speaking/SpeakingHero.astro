---
import { Image } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import SpeakerPortrait from '@/assets/photos/originals/me-1-square.webp'

import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  linkedinHref: string
  whatsappHref: string
}

const { linkedinHref, whatsappHref } = Astro.props

const sessionTraits = [
  'Grounded in shipped work',
  'Tailored to the audience',
  'Community-led since 2017'
]
---

<section
  class="
    relative isolate section-container-wide py-4
    sm:pt-6
    lg:pt-8
  "
  data-speaking-hero
>
  <div class="grid grid-cols-1 items-center gap-12" data-speaking-hero-grid>
    <div class="relative z-10">
      <Eyebrow
        className="
          animate-slide-up whitespace-normal
          motion-reduce:animate-none
        "
        label="Speaking & community"
        tone="brand"
      />

      <div
        class="
          mt-7 animate-reveal-lcp space-y-5
          motion-reduce:animate-none
        "
      >
        <h1 class="editorial-page-title">
          Technical talks.
          <span class="editorial-page-emphasis">Practical takeaways.</span>
        </h1>
        <p class="
          max-w-2xl text-base/7 text-ink-soft
          sm:text-lg/8
        "
        >
          Technical sessions grounded in real delivery constraints, plus community
          work that helps engineers learn, connect, and share what they know.
        </p>
      </div>

      <div
        class="
          mt-7 animate-slide-up space-y-6 [animation-delay:180ms]
          motion-reduce:animate-none
        "
      >
        <div class="section-actions">
          <ButtonLink href={whatsappHref} newTab showArrow>
            Invite me to speak
          </ButtonLink>
          <ButtonLink href={linkedinHref} newTab showArrow variant="secondary">
            Connect on LinkedIn
          </ButtonLink>
        </div>

        <ul
          class="
            flex max-w-3xl flex-wrap gap-x-5 gap-y-2 border-t border-line/45
            pt-5 text-xs/6 font-semibold tracking-[0.12em] text-ink-muted
            uppercase
          "
        >
          {sessionTraits.map(trait => (
            <li class="flex min-w-0 items-center gap-2">
              <Icon class="text-brand" name="check" size="sm" />
              <span class="min-w-0">{trait}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <aside
      aria-label="Speaker profile"
      class="
        mx-auto w-full max-w-84
        sm:max-w-92
      "
      data-speaking-hero-profile
    >
      <Card
        class="
          relative overflow-hidden rounded-4xl p-3
          sm:p-4
        "
        variant="unstyled"
      >
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-x-8 top-4 h-44 rounded-full
            bg-brand/18 blur-3xl
          "
        />
        <Image
          alt="Santiago Molina, engineering leader and speaker"
          class="
            relative aspect-4/5 w-full rounded-[1.45rem] object-cover
            object-center contrast-[1.03] saturate-[0.92]
          "
          decoding="sync"
          fetchpriority="high"
          format="avif"
          loading="eager"
          sizes="(min-width: 1280px) 384px, (min-width: 1024px) 352px, (min-width: 640px) 368px, 336px"
          src={SpeakerPortrait}
          widths={[336, 384, 672, 768]}
        />
        <div class="space-y-4 px-2 pt-5 pb-2">
          <div>
            <p class="section-label text-brand">Speaker profile</p>
            <p class="mt-2 text-lg font-semibold text-ink">Santiago Molina</p>
            <p class="mt-1 text-sm/6 text-ink-soft">
              Engineering leader, full-stack architect, and ReactJS Colombia co-organizer.
            </p>
          </div>
          <dl class="
            grid grid-cols-[repeat(auto-fit,minmax(min(100%,7rem),1fr))] gap-4
            divider-soft pt-4
          "
          >
            <div class="min-w-0">
              <dt class="text-xs text-ink-muted">Community</dt>
              <dd class="mt-1 site-label">Since 2017</dd>
            </div>
            <div class="min-w-0">
              <dt class="text-xs text-ink-muted">Based in</dt>
              <dd class="mt-1 site-label">Medellín</dd>
            </div>
          </dl>
        </div>
      </Card>
    </aside>
  </div>
</section>

<style>
  /* The profile column sits beside the headline only while the hero keeps
     54rem in root-relative units, so enlarged text stacks it below the copy. */
  [data-speaking-hero] {
    container: speaking-hero / inline-size;
  }

  @container speaking-hero (width < 14rem) {
    .editorial-page-title { font-size: min(var(--text-editorial-title), 16cqi); }
  }

  @media (width >= 64rem) {
    @container speaking-hero (width >= 54rem) {
      [data-speaking-hero-grid] {
        grid-template-columns: minmax(0, 1fr) 22rem;
        gap: 4rem;
      }

      [data-speaking-hero-profile] {
        max-width: none;
      }
    }
  }

  @media (width >= 80rem) {
    @container speaking-hero (width >= 54rem) {
      [data-speaking-hero-grid] {
        grid-template-columns: minmax(0, 1fr) 24rem;
      }
    }
  }
</style>
