---
import { Image } from 'astro:assets'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import Portrait from '@/assets/photos/originals/santiago-profile-with-dog.jpg'

import { ButtonLink } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { localizePageSource, pageTranslator } from '@/i18n/page-copy'
import { siteConfig } from '@/site.config'

const pageLocale = getLocale(Astro.url.pathname)
const t = pageTranslator(pageLocale)
---

<section class="signature-frame about-hero" data-about-hero>
  <div class="about-hero-copy">
    <p class="about-eyebrow">{t('page.engineeringLeaderFullStackArchitect')}</p>
    <h1 data-about-hero-heading>{t('about.hero.craft')}{' '}<span>{t('about.hero.curiosity')}</span></h1>
    <p class="about-hero-intro">
      {t('about.hero.introduction')}
    </p>
    <div class="maker-hero-actions">
      <ButtonLink class="maker-hero-primary" href={localizePath('/portfolio/', pageLocale)} variant="unstyled">
        {t('page.seeSelectedWork')}
        <span class="maker-hero-arrow"><ArrowExchange /></span>
      </ButtonLink>
      <ButtonLink class="maker-hero-secondary" href={localizePath(siteConfig.contact.resume, pageLocale)} variant="unstyled">
        {t('shared.viewResume')} <ArrowExchange direction="right" />
      </ButtonLink>
    </div>
    <p class="about-availability"><span aria-hidden="true"></span>{localizePageSource(pageLocale, siteConfig.availability)}</p>
    <ul class="about-socials" aria-label={t('page.connectWithSantiago')}>
      {siteConfig.socialLinks.filter(({ label }) => label === 'LinkedIn' || label === 'GitHub').map(({ href, label }) => (
        <li><ButtonLink class="about-link" href={localizePath(href, pageLocale)} newTab variant="unstyled">{label}<ArrowExchange /></ButtonLink></li>
      ))}
    </ul>
  </div>
  <figure class="about-portrait" data-about-hero-portrait>
    <Image
      alt={t('about.hero.portraitAlt')}
      decoding="sync"
      fetchpriority="high"
      format="avif"
      height={600}
      loading="eager"
      src={Portrait}
      width={400}
      widths={[320, 400, 640, 800]}
      sizes="(min-width: 768px) 400px, calc(100vw - 48px)"
    />
    <figcaption>
      <div data-about-portrait-identity>
        <span data-about-portrait-handle>@santi020k</span>
        <span data-about-portrait-name>Santiago Molina</span>
      </div>
      <div data-about-portrait-location>
        <span>Medellín,<br /> Colombia</span>
        <span>{t('page.remote')}<br /> {t('page.worldwide')}</span>
      </div>
    </figcaption>
  </figure>
</section>
