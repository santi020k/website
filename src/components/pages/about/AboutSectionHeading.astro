---
interface Props {
  description: string
  eyebrow: string
  index: string
  title: string
}

const { description, eyebrow, index, title } = Astro.props
---

<header class="about-section-heading">
  <div>
    <p class="about-eyebrow"><span>{index}</span>{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  <p>{description}</p>
</header>
