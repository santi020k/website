---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getFormattedDate } from '@/utils/date'
import { getPostPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'
import { getReadingTime } from '@/utils/reading-time'

import { Card, Icon, Link } from '@santi020k/lumen-astro'

interface Props {
  columns?: 2 | 3
  posts: CollectionEntry<'post'>[]
  showSequence?: boolean
}

const { columns = 3, posts, showSequence = false } = Astro.props

const imageSizes = columns === 2 ?
  'auto, (min-width: 1280px) 35.25rem, (min-width: 640px) 50vw, 100vw' :
  'auto, (min-width: 1280px) 23rem, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'

const createGalleryItem = (post: CollectionEntry<'post'>) => {
  const { data } = post
  const coverSourceWidth = data.coverImage?.src.width ?? 1600
  const coverWidth = Math.min(1600, coverSourceWidth)

  const coverHeight = data.coverImage ?
    Math.round(coverWidth * data.coverImage.src.height / data.coverImage.src.width) :
    900

  const coverWidths = [...new Set([320, 480, 640, 800, 960, 1280, 1600, coverWidth])]
    .filter(width => width <= coverSourceWidth)
    .sort((firstWidth, secondWidth) => firstWidth - secondWidth)

  return {
    coverHeight,
    coverWidth,
    coverWidths,
    data,
    formattedDate: getFormattedDate(data.publishDate),
    href: getPostPath(post.id),
    readingTime: getReadingTime(post.body),
    slug: getPostSlug(post.id)
  }
}

const galleryItems = posts.map(createGalleryItem)
---

<div>
  {galleryItems.length > 0 && (
    <div
      class:list={[
        `
          grid grid-cols-1 gap-x-6 gap-y-12
          sm:card-grid-2
        `,
        columns === 3 && 'lg:card-grid-3'
      ]}
      data-post-gallery-grid
    >
      {galleryItems.map((item, index) => (
        <Card as="article" data-post-gallery-card variant="unstyled">
          <Link href={item.href} variant="inherit">
            <div
              class="
                relative aspect-video overflow-hidden rounded-2xl
                bg-surface-muted
              "
              transition:name={`post-cover-${item.slug}`}
            >
              {item.data.coverImage ?
                (
                  <Picture
                    alt=""
                    aria-hidden="true"
                    class="absolute inset-0 size-full object-cover"
                    fallbackFormat="webp"
                    formats={['avif']}
                    height={item.coverHeight}
                    loading="lazy"
                    sizes={imageSizes}
                    src={item.data.coverImage.src}
                    width={item.coverWidth}
                    widths={item.coverWidths}
                  />
                ) :
                (
                  <div aria-hidden="true" class="absolute inset-0 grid-fade" />
                )}
            </div>

            <div data-post-gallery-copy>
              <div data-post-gallery-meta>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span>{item.data.postType}</span>
                  {showSequence && <span>Part {item.data.seriesOrder ?? index + 1}</span>}
                  {item.data.draft && <span class="font-semibold">Draft</span>}
                </div>
                <time datetime={item.data.publishDate.toISOString()}>
                  {item.formattedDate}
                </time>
              </div>

              <h3>{item.data.title}</h3>
              <p>{item.data.cardDescription ?? item.data.description}</p>

              {!!item.data.tags.length && (
                <ul aria-label="Topics">
                  {item.data.tags.slice(0, 2).map(tag => <li>{tag}</li>)}
                </ul>
              )}

              <div data-post-gallery-footer>
                <span class="inline-flex items-center gap-2">
                  Read article
                  <Icon class="size-4 shrink-0" name="arrow-right" />
                </span>
                <span class="text-xs font-normal text-ink-soft">{item.readingTime} min read</span>
              </div>
            </div>
          </Link>
        </Card>
      ))}
    </div>
  )}
</div>
