---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getFormattedDate } from '@/utils/date'
import { getPostPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'
import { getReadingTime } from '@/utils/reading-time'
import { getResponsiveImageDimensions } from '@/utils/responsive-image'
import { getBlogTopicLabel } from '@/utils/tags'

import { Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  columns?: 2 | 3
  layout?: 'grid' | 'chapters' | 'focused'
  posts: CollectionEntry<'post'>[]
  showSequence?: boolean
}

const { columns = 3, layout = 'grid', posts, showSequence = false } = Astro.props

const gridImageSizes = columns === 2 ?
  'auto, (min-width: 1280px) 35.25rem, (min-width: 640px) 50vw, 100vw' :
  'auto, (min-width: 1280px) 23rem, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'

const imageSizes = {
  chapters: 'auto, (min-width: 640px) 14rem, 100vw',
  focused: 'auto, (min-width: 1280px) 33.5rem, (min-width: 768px) 48vw, 100vw',
  grid: gridImageSizes
}[layout]

const createGalleryItem = (post: CollectionEntry<'post'>) => {
  const { data } = post

  return {
    coverDimensions: data.coverImage ?
      getResponsiveImageDimensions(data.coverImage.src, 1600, [320, 480, 640, 800, 960, 1280, 1600]) :
      undefined,
    data,
    formattedDate: getFormattedDate(data.publishDate, {}, locale === 'es' ? 'es-419' : 'en-US'),
    href: localizePath(getPostPath(post.id), locale),
    readingTime: getReadingTime(post.body),
    slug: getPostSlug(post.id)
  }
}

const galleryItems = posts.map(createGalleryItem)
---

<div>
  {galleryItems.length > 0 && (
    <div
      class:list={[
        `
          grid grid-cols-1 gap-x-6 gap-y-12
          sm:card-grid-2
        `,
        columns === 3 && 'lg:card-grid-3'
      ]}
      data-post-gallery-grid={layout}
    >
      {galleryItems.map((item, index) => (
        <Card as="article" data-post-gallery-card variant="unstyled">
          <Link href={localizePath(item.href, locale)} variant="inherit">
            <div
              class="
                relative aspect-video overflow-hidden rounded-2xl
                bg-surface-muted
              "
              data-post-gallery-cover
              transition:name={`post-cover-${item.slug}`}
            >
              {item.data.coverImage ?
                (
                  <Picture
                    {...item.coverDimensions}
                    alt=""
                    aria-hidden="true"
                    class="absolute inset-0 size-full object-cover"
                    fallbackFormat="webp"
                    formats={['avif']}
                    loading="lazy"
                    sizes={imageSizes}
                    src={item.data.coverImage.src}
                  />
                ) :
                (
                  <div aria-hidden="true" class="absolute inset-0 grid-fade" />
                )}
            </div>

            <div data-post-gallery-copy>
              <div data-post-gallery-meta>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span>{localizeCollectionSource(locale, item.data.postType)}</span>
                  {showSequence && <span data-post-gallery-part>{t('collection.part')} {item.data.seriesOrder ?? index + 1}</span>}
                  {item.data.draft && <span class="font-semibold">{t('collection.draft')}</span>}
                </div>
                <time datetime={item.data.publishDate.toISOString()}>
                  {item.formattedDate}
                </time>
              </div>

              <h3 lang="en">{item.data.title}</h3>
              <p lang="en">{item.data.cardDescription ?? item.data.description}</p>

              {!!item.data.tags.length && (
                <ul aria-label={t('collection.topics')} data-post-gallery-topics>
                  {item.data.tags.slice(0, 2).map((tag, topicIndex) => (
                    <li>
                      {topicIndex > 0 && <span aria-hidden="true" data-post-topic-separator>·</span>}
                      <span lang="en">{getBlogTopicLabel(tag)}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div data-post-gallery-footer>
                <span class="inline-flex items-center gap-2">
                  {t('collection.readArticle')}
                  <ArrowExchange class="size-4 shrink-0" direction="right" />
                </span>
                <span class="text-xs font-normal text-ink-soft">{t('reading.duration', { minutes: item.readingTime })}</span>
              </div>
            </div>
          </Link>
        </Card>
      ))}
    </div>
  )}
</div>
