---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import CoverImage from '@/components/atoms/CoverImage.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getTagPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'

import readingTime from 'reading-time'

import { getSeriesContext } from '@/data/series'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate, tags } = post.data
const stats = readingTime(post.body ?? '')
const readingTimeText = stats.text
const wordCount = Math.round(stats.words)
const seriesContext = await getSeriesContext(post)

const coverAspectRatio = post.data.coverImage ?
  post.data.coverImage.src.width / post.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08
// Use the first tag as an editorial eyebrow label, fallback to "Article"
const eyebrowLabel = tags[0] ?? 'Article'
---

<section
  class="
    section-shell relative animate-slide-up space-y-10
    motion-reduce:animate-none
  "
>
  <div
    aria-hidden="true"
    class="brand-radial-glow"
  >
  </div>

  <div class="
    relative grid gap-10
    xl:grid-cols-[minmax(0,1.04fr)_18rem]
  "
  >
    <!-- ── Left column: title, meta, tags ─────────────────────── -->
    <div class="space-y-8">

      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-sm font-medium text-ink-muted">
        <a
          href="/blog/"
          class="
            transition-colors
            hover:text-brand
          "
        >Blog
        </a>
        <Icon
          aria-hidden="true"
          class="size-4"
          name="tabler:chevron-right"
        />
        <span class="text-ink-soft">Article</span>
      </div>

      <!-- Eyebrow + date row -->
      <div class="
        flex flex-wrap items-center gap-3
        sm:gap-4
      "
      >
        <Eyebrow label={eyebrowLabel} tone="brand" />
        <span class="
          text-xs font-semibold tracking-[0.18em] text-ink-muted uppercase
        "
        >
          <FormattedDate date={publishDate} />
        </span>
      </div>

      <!-- Title + description -->
      <div class="space-y-4">
        <h1 class="
          max-w-4xl text-4xl/tight font-bold
          sm:text-5xl/tight
          lg:text-6xl/tight
        "
        >
          {title}
        </h1>
        <p class="
          max-w-3xl text-lg/8 text-ink-soft
          sm:text-xl/8
        "
        >
          {description}
        </p>
      </div>

      <!-- Reading stat cards (mirrors ProjectHero's stat grid) -->
      <div class="
        grid gap-3
        sm:grid-cols-[repeat(auto-fit,minmax(12rem,1fr))]
      "
      >
        <!-- Published -->
        <div class="
          flex mini-note h-full gap-3
          sm:min-h-24
        "
        >
          <div class="
            mt-0.5 flex size-10 shrink-0 items-center justify-center
            rounded-full bg-brand-soft text-brand
          "
          >
            <Icon aria-hidden="true" class="size-5" name="tabler:calendar" />
          </div>
          <div class="min-w-0">
            <p class="section-label">Published</p>
            <p class="
              mt-2 text-sm/6 font-semibold text-ink
              sm:text-base/7
            "
            >
              <FormattedDate date={publishDate} />
            </p>
          </div>
        </div>

        <!-- Read time -->
        <div class="
          flex mini-note h-full gap-3
          sm:min-h-24
        "
        >
          <div class="
            mt-0.5 flex size-10 shrink-0 items-center justify-center
            rounded-full bg-brand-soft text-brand
          "
          >
            <Icon aria-hidden="true" class="size-5" name="tabler:clock" />
          </div>
          <div class="min-w-0">
            <p class="section-label">Read time</p>
            <p class="
              mt-2 text-sm/6 font-semibold text-ink
              sm:text-base/7
            "
            >
              {readingTimeText}
            </p>
          </div>
        </div>

        <!-- Word count -->
        <div class="
          flex mini-note h-full gap-3
          sm:min-h-24
        "
        >
          <div class="
            mt-0.5 flex size-10 shrink-0 items-center justify-center
            rounded-full bg-brand-soft text-brand
          "
          >
            <Icon aria-hidden="true" class="size-5" name="tabler:file-text" />
          </div>
          <div class="min-w-0">
            <p class="section-label">Words</p>
            <p class="
              mt-2 text-sm/6 font-semibold text-ink
              sm:text-base/7
            "
            >
              {wordCount.toLocaleString()}
            </p>
          </div>
        </div>

        <!-- Updated (conditional) -->
        {updatedDate && (
          <div class="
            flex mini-note h-full gap-3
            sm:min-h-24
          "
          >
            <div class="
              mt-0.5 flex size-10 shrink-0 items-center justify-center
              rounded-full bg-brand-soft text-brand
            "
            >
              <Icon aria-hidden="true" class="size-5" name="tabler:refresh" />
            </div>
            <div class="min-w-0">
              <p class="section-label">Updated</p>
              <p class="
                mt-2 text-sm/6 font-semibold text-ink
                sm:text-base/7
              "
              >
                <FormattedDate date={updatedDate} />
              </p>
            </div>
          </div>
        )}
      </div>

      <!-- Tags / topics -->
      {tags.length > 0 && (
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="section-label">Topics</span>
            <span
              aria-hidden="true"
              class="
                h-px flex-1 bg-linear-to-r from-line via-line/60 to-transparent
              "
            />
          </div>
          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <Pill href={getTagPath(tag)} label={tag} showHash tone="outline" />
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- ── Right aside: series · canonical · at a glance ─────── -->
    <aside
      aria-label="Article context"
      class="editorial-rail"
    >
      {seriesContext && (
        <div class="mini-note">
          <p class="section-label">Part of a series</p>
          <a
            href={`/blog/series/${seriesContext.series.id}/`}
            class="
              mt-3 inline-flex items-center gap-2 text-sm font-medium text-ink
              transition-colors
              hover:text-brand
            "
          >
            <Icon
              aria-hidden="true"
              class="size-4"
              name="tabler:route"
            />
            <span>{seriesContext.series.data.title}</span>
          </a>
          <p class="mt-3 text-sm/6 text-ink-soft">
            Article {seriesContext.position} of {seriesContext.total}.{' '}
            {seriesContext.series.data.description}
          </p>
        </div>
      )}

      {canonicalUrl && (
        <div class="mini-note">
          <p class="section-label">Originally published</p>
          <a
            href={canonicalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="
              mt-3 inline-flex items-center gap-2 text-sm font-medium text-ink
              transition-colors
              hover:text-brand
            "
          >
            <Icon
              aria-hidden="true"
              class="size-4"
              name="tabler:external-link"
            />
            <span>Read on Medium</span>
          </a>
        </div>
      )}

      <div class="mini-note">
        <p class="section-label">At a glance</p>
        <ul class="mt-4 space-y-3.5">
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-1.5 text-xs text-ink-muted">
              <Icon aria-hidden="true" class="size-3.5" name="tabler:clock" />
              Reading time
            </span>
            <span class="text-sm font-semibold text-ink">{readingTimeText}</span>
          </li>
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-1.5 text-xs text-ink-muted">
              <Icon aria-hidden="true" class="size-3.5" name="tabler:file-text" />
              Word count
            </span>
            <span class="text-sm font-semibold text-ink">{wordCount.toLocaleString()}</span>
          </li>
          <li class="flex items-center justify-between gap-3">
            <span class="flex items-center gap-1.5 text-xs text-ink-muted">
              <Icon aria-hidden="true" class="size-3.5" name="tabler:tag" />
              Topics
            </span>
            <span class="text-sm font-semibold text-ink">{tags.length}</span>
          </li>
        </ul>
      </div>
    </aside>
  </div>

  <!-- ── Cover image: full-width below the grid (mirrors ProjectHero) ── -->
  {post.data.coverImage && (
    <div class="space-y-4">
      <div class:list={[
        'panel-card relative overflow-hidden',
        !useWideCoverFrame && 'mx-auto w-full max-w-4xl'
      ]}
      >
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40
              bg-linear-to-t from-canvas/80 via-canvas/15 to-transparent
            "
          >
          </div>
        )}
        <CoverImage
          alt={post.data.coverImage.alt}
          ariaHidden={true}
          fetchpriority="high"
          image={post.data.coverImage.src}
          loading="eager"
          mode="detail"
          sizes="(min-width: 1024px) 1200px, 100vw"
          transitionName={`post-cover-${getPostSlug(post.id)}`}
        />
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-20 flex
              flex-wrap items-end justify-between gap-4 p-5
              sm:p-6
            "
          >
            <div>
              <p class="section-label text-white/70">Article cover</p>
              <p class="
                mt-2 text-lg font-semibold tracking-[-0.03em] text-white
                sm:text-xl
              "
              >
                {title}
              </p>
            </div>
            <p class="max-w-md text-sm/6 text-white/78">
              {readingTimeText} · {eyebrowLabel}
            </p>
          </div>
        )}
      </div>
    </div>
  )}
</section>
