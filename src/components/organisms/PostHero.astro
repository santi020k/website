---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import HoverableCover from '@/components/atoms/HoverableCover.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getTagPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'
import { getReadingStats } from '@/utils/reading-time'

import { Breadcrumb, CopyButton, Icon } from '@santi020k/lumen-astro'

import { getSeriesContext } from '@/data/series'
import { siteConfig } from '@/site.config'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate, tags } = post.data
const { minutes, words: wordCount } = getReadingStats(post.body)
const readingTimeText = `${minutes} min read`
const seriesContext = await getSeriesContext(post)
const copyUrl = new URL(Astro.url.pathname, Astro.site).href

const coverAspectRatio = post.data.coverImage ?
  post.data.coverImage.src.width / post.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08
// Use the first tag as an editorial eyebrow label, fallback to "Article"
const eyebrowLabel = tags[0] ?? 'Article'

---

<section class="editorial-detail-hero space-y-12">
  {/* ── Eyebrow + breadcrumb ─────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-4
      motion-reduce:animate-none
    "
  >
    <div class="
      flex min-w-0 flex-col items-start gap-3
      sm:flex-row sm:items-center sm:justify-between
    "
    >
      <Eyebrow label={eyebrowLabel} tone="brand" />
      <Breadcrumb
        class="
          flex max-w-full flex-wrap items-center gap-x-1.5 gap-y-1 text-sm
          font-medium text-ink-muted
        "
      >
        <ol>
          <li>
            <a
              href="/blog/"
              class="
                whitespace-nowrap transition-colors
                hover:text-brand
                motion-reduce:transition-none
              "
            >Blog
            </a>
          </li>
          <li><span aria-current="page" class="text-ink-soft">Article</span></li>
        </ol>
      </Breadcrumb>
    </div>
  </div>

  {/* ── Title + description ──────────────────────────────────── */}
  <div
    class="
      animate-reveal-lcp space-y-6
      motion-reduce:animate-none
    "
  >
    <div class="relative">
      <h1 class="p-name max-w-4xl wrap-break-word">
        {title}
      </h1>

    </div>
    <p
data-editorial-summary
class="p-summary text-ink-soft"
    >
      {description}
    </p>
    <p class="text-sm/6 text-ink-muted">
      By{' '}
      <a
        class="
          p-name u-url font-semibold text-ink-soft transition-colors
          hover:text-brand
          motion-reduce:transition-none
        "
        href="/about/"
        rel="author"
      >
        {siteConfig.author}
      </a>
    </p>
  </div>

  {/* ── Publication details — Margin imprint ─────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:160ms]
      motion-reduce:animate-none
    "
    data-editorial-meta-group
  >
    <dl data-publication-imprint data-has-update={Boolean(updatedDate)}>
      <div data-publication-field="published">
        <dt>Published</dt>
        <dd><FormattedDate date={publishDate} /></dd>
      </div>
      <div data-publication-field="reading">
        <dt>Read time</dt>
        <dd>{readingTimeText}</dd>
      </div>
      <div data-publication-field="words">
        <dt>Words</dt>
        <dd>{wordCount.toLocaleString()}</dd>
      </div>
      {updatedDate && (
        <div data-publication-field="updated">
          <dt>Updated</dt>
          <dd><FormattedDate date={updatedDate} /></dd>
        </div>
      )}
    </dl>
  </div>

  {/* ── Tags / topics ────────────────────────────────────────── */}
  {tags.length > 0 && (
    <div
      class="
        animate-slide-up space-y-4 [animation-delay:200ms]
        motion-reduce:animate-none
      "
    >
      <div class="flex items-center gap-3">
        <span class="section-label">Topics</span>
        <span
          aria-hidden="true"
          class="
            h-px flex-1 bg-linear-to-r from-transparent via-line/40
            to-transparent
          "
        />
      </div>
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <Pill href={getTagPath(tag)} label={tag} showHash tone="outline" />
        ))}
      </div>
    </div>
  )}

  {/* ── CTAs ────────────────────────────────────────────────── */}
  <div
    data-reading-actions
    class="
      animate-slide-up [animation-delay:240ms]
      motion-reduce:animate-none
    "
  >
    <div class="section-actions">
      {canonicalUrl && (
        <ButtonLink href={canonicalUrl} newTab showArrow>
          Read on Medium
        </ButtonLink>
      )}
      {!canonicalUrl && (
        <CopyButton
          className="btn-primary"
          copiedLabel="Copied! Article link copied"
          errorLabel="Copy link failed. Select and copy the address manually."
          label="Copy link to article"
          value={copyUrl}
        >
          <Icon class="size-4" data-copy-icon name="link" />
          <span data-copy-label>Copy link</span>
          <span slot="copied" class="inline-flex items-center gap-2">
            <Icon class="size-4" name="check" />
            <span data-copied-label>Copied!</span>
          </span>
          <span slot="error">Copy failed</span>
        </CopyButton>
      )}
      {seriesContext && (
        <ButtonLink
          href={`/blog/series/${seriesContext.series.id}/`}
          showArrow
          variant="secondary"
        >
          <span class="flex min-w-0 items-center gap-2">
            <Icon
              class="size-4"
              name="route"
            />
            {seriesContext.series.data.title}
          </span>
        </ButtonLink>
      )}
      <ButtonLink
        href="/blog/"
        showArrow
        variant="secondary"
        className="text-ink-soft"
      >
        Browse blog
      </ButtonLink>
    </div>
  </div>

  {/* ── Cover image: full-width below ────────────────────────── */}
  {post.data.coverImage && (
    <div class="space-y-4">
      <div
        class:list={[
          'relative',
          !useWideCoverFrame && 'mx-auto w-full max-w-4xl'
        ]}
        data-post-cover
      >
        <HoverableCover
          alt={post.data.coverImage.alt}
          ariaHidden={true}
          className={useWideCoverFrame ? '' : 'mx-auto w-full max-w-4xl'}
          fetchpriority="high"
          image={post.data.coverImage.src}
          loading="eager"
          preserveAspectRatio={useWideCoverFrame}
          showBottomGradient={useWideCoverFrame}
          sizes={useWideCoverFrame ? '(min-width: 1280px) 1152px, 100vw' : '(min-width: 1024px) 896px, 100vw'}
          transitionName={`post-cover-${getPostSlug(post.id)}`}
        />
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-20 flex-wrap
              items-end justify-between gap-4 p-5
              sm:p-6
            "
            data-post-cover-caption
          >
            <div>
              <p class="section-label text-white/70">Article cover</p>
              <p class="
                mt-2 text-lg font-semibold tracking-[-0.03em] text-white
                sm:text-xl
              "
              >
                {title}
              </p>
            </div>
            <p class="max-w-md text-sm/6 text-white/78">
              {readingTimeText} · {eyebrowLabel}
            </p>
          </div>
        )}
      </div>
    </div>
  )}
</section>

<style>
  [data-publication-imprint] {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: 1.5rem;
    margin: 0;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.5rem;
    color: hsl(var(--ink));
  }

  [data-publication-field] {
    min-width: 0;
    border-inline-start: 1px solid hsl(var(--line));
    padding-inline-start: 1.125rem;
  }

  [data-publication-imprint] dt {
    margin-bottom: 0.4375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
  }

  [data-publication-imprint] dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
  }

  [data-publication-field='published'] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-inline-start: 2px solid hsl(var(--brand));
  }

  :global([data-theme='dark']) [data-publication-field='published'] {
    border-color: hsl(var(--accent));
  }

  [data-has-update='true'] [data-publication-field='published'] {
    grid-row: 1 / 3;
  }

  [data-publication-field='published'] dd {
    font-size: 1.4375rem;
    line-height: 1.4;
    letter-spacing: -0.04em;
  }

  [data-publication-imprint] :global(time) { color: inherit; }

  [data-publication-field='updated'] {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2 / -1;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  [data-publication-field='updated'] dt { margin: 0; }
  [data-publication-field='updated'] dd {
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
  }

  @container editorial-meta (width < 32rem) {
    [data-publication-imprint] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    [data-publication-imprint] [data-publication-field='published'],
    [data-publication-field='updated'] {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @container editorial-meta (width < 16rem) {
    [data-publication-imprint] { grid-template-columns: minmax(0, 1fr); }
    [data-publication-field='updated'] { display: block; }
    [data-publication-field='updated'] dt { margin-bottom: 0.4375rem; }
  }
</style>
