---
import type { CollectionEntry } from 'astro:content'

import Eyebrow from '@/components/atoms/Eyebrow.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import HoverableCover from '@/components/atoms/HoverableCover.astro'
import ArticleLinkAction from '@/components/molecules/ArticleLinkAction.astro'
import CoverSpread from '@/components/molecules/CoverSpread.astro'

import { getTagPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'
import { getReadingStats } from '@/utils/reading-time'

import { Breadcrumb, Icon, Link } from '@santi020k/lumen-astro'

import { getSeriesContext } from '@/data/series'
import { siteConfig } from '@/site.config'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate, tags } = post.data
const { minutes, words: wordCount } = getReadingStats(post.body)
const readingTimeText = `${minutes} min read`
const seriesContext = await getSeriesContext(post)
const copyUrl = new URL(Astro.url.pathname, Astro.site).href

const coverAspectRatio = post.data.coverImage ?
  post.data.coverImage.src.width / post.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08
// Use the first tag as an editorial eyebrow label, fallback to "Article"
const eyebrowLabel = tags[0] ?? 'Article'

---

<section class="editorial-detail-hero space-y-12" data-article-opening>
  {/* ── Eyebrow + breadcrumb ─────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-4
      motion-reduce:animate-none
    "
  >
    <div class="
      flex min-w-0 flex-col items-start gap-3
      sm:flex-row sm:items-center sm:justify-between
    "
    >
      <Eyebrow label={eyebrowLabel} tone="brand" />
      <Breadcrumb
        class="
          flex max-w-full flex-wrap items-center gap-x-1.5 gap-y-1 text-sm
          font-medium text-ink-muted
        "
      >
        <ol>
          <li>
            <a
              href="/blog/"
              class="
                whitespace-nowrap transition-colors
                hover:text-brand
                motion-reduce:transition-none
              "
            >Blog
            </a>
          </li>
          <li><span aria-current="page" class="text-ink-soft">Article</span></li>
        </ol>
      </Breadcrumb>
    </div>
  </div>

  {/* ── Cover spread ────────────────────────────────────────── */}
  <div class="
    animate-reveal-lcp
    motion-reduce:animate-none
  "
  >
    <CoverSpread kind="article" hasCover={Boolean(post.data.coverImage)} wide={useWideCoverFrame}>
      <h1 slot="heading" class="p-name">{title}</h1>
      {post.data.coverImage && (
        <HoverableCover
          alt={post.data.coverImage.alt}
          ariaHidden={true}
          unstyled={useWideCoverFrame}
          fetchpriority="high"
          image={post.data.coverImage.src}
          loading="eager"
          preserveAspectRatio={useWideCoverFrame}
          sizes={useWideCoverFrame ? '(min-width: 1280px) 1152px, calc(100vw - 3rem)' : '(min-width: 1024px) 896px, calc(100vw - 3rem)'}
          transitionName={`post-cover-${getPostSlug(post.id)}`}
        />
      )}
    </CoverSpread>
    <div data-cover-lead>
      <p data-editorial-summary class="p-summary text-ink-soft">{description}</p>
      <p data-cover-byline class="text-sm/6 text-ink-muted">
        <span>Written by</span>
        <a
          class="
            p-author h-card font-semibold text-ink-soft transition-colors
            hover:text-brand
            motion-reduce:transition-none
          "
          href="/about/"
          rel="author"
        >{siteConfig.author}</a>
      </p>
    </div>
  </div>

  {/* ── Publication details — Reading imprint ────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:160ms]
      motion-reduce:animate-none
    "
    data-editorial-meta-group
  >
    <div data-publication-imprint>
      <dl data-publication-dates>
        <div data-publication-field="published">
          <dt>Published</dt>
          <dd><FormattedDate date={publishDate} /></dd>
        </div>
        {updatedDate && (
          <div data-publication-field="updated">
            <dt>Updated</dt>
            <dd><FormattedDate date={updatedDate} /></dd>
          </div>
        )}
      </dl>
      <dl data-publication-reading>
        <div data-publication-field="reading">
          <dt>Reading</dt>
          <dd>{readingTimeText}</dd>
        </div>
        <div data-publication-field="words">
          <dt class="sr-only">Word count</dt>
          <dd>{wordCount.toLocaleString()} words</dd>
        </div>
      </dl>
    </div>
  </div>

  {/* ── Topics — Margin topics ─────────────────────────────── */}
  {(tags.length > 0 || !seriesContext) && (
    <div
      class="
        animate-slide-up [animation-delay:200ms]
        motion-reduce:animate-none
      "
      data-article-topics-container
      data-has-utility={!seriesContext}
    >
      <div data-article-topics-header>
        <div data-article-topics-heading>
          <Icon
            name={tags.length > 0 ? 'hash' : 'share-2'}
            class="size-4.5 shrink-0"
          />
          <h2 id="article-topics-heading">{tags.length > 0 ? 'Topics' : 'Share'}</h2>
        </div>
        {!seriesContext && (
          <div data-topic-action>
            <ArticleLinkAction {canonicalUrl} {copyUrl} />
          </div>
        )}
      </div>
      {tags.length > 0 && (
        <nav aria-labelledby="article-topics-heading" data-article-topics>
          <ul>
            {tags.map(tag => (
              <li>
                <Link href={getTagPath(tag)} variant="inherit" data-topic-link>
                  <span data-topic-label>{tag}</span>
                  <Icon name="arrow-up-right" class="size-3.5 shrink-0" />
                </Link>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  )}

  {/* ── Hero actions — Series byline ─────────────────────────── */}
  {seriesContext && (
    <div
      data-reading-actions
      class="
        animate-slide-up [animation-delay:240ms]
        motion-reduce:animate-none
      "
    >
      <div data-series-byline>
        <div data-hero-series>
          <p data-hero-series-position>
            From the series · Post {seriesContext.position} of {seriesContext.total}
          </p>
          <Link
            href={`/blog/series/${seriesContext.series.id}/`}
            variant="inherit"
            data-hero-series-link
          >
            <span>{seriesContext.series.data.title}</span>
            <Icon name="arrow-right" class="size-4 shrink-0" data-hero-series-arrow />
          </Link>
        </div>
        <ArticleLinkAction {canonicalUrl} {copyUrl} />
      </div>
    </div>
  )}

</section>

<style>
  [data-article-opening] { container: article-opening / inline-size; }

  [data-article-opening] > :has(+ [data-reading-actions]) { margin-block-end: 1.5rem; }

  [data-series-byline] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  [data-hero-series] { min-width: 0; }
  [data-hero-series-position] {
    margin-bottom: 0.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
  }

  :global([data-hero-series-link]) {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    min-height: 2.75rem;
    color: hsl(var(--ink));
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  [data-article-opening] :global([data-article-utility]) {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 0.75rem;
    max-width: 100%;
    min-height: 2.75rem;
    height: auto;
    padding: 0.375rem 0;
    border: 0;
    border-bottom: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.6;
    white-space: normal;
    text-align: start;
    text-decoration: none;
  }

  :global([data-hero-series-link] > span),
  :global([data-article-utility] > span) { min-width: 0; overflow-wrap: anywhere; }
  :global([data-hero-series-arrow]),
  [data-series-byline] :global(a:hover),
  [data-article-opening] :global([data-article-utility]:hover) { color: hsl(var(--brand)); }
  [data-article-opening] :global(:is(a, button):focus-visible) {
    outline: 2px solid hsl(var(--brand));
    outline-offset: 4px;
  }

  :global(:root[data-theme='dark'] [data-hero-series-arrow]),
  :global(:root[data-theme='dark']) [data-series-byline] :global(a:hover),
  :global(:root[data-theme='dark']) [data-article-opening] :global([data-article-utility]:hover) { color: hsl(var(--accent)); }
  :global(:root[data-theme='dark']) [data-article-opening] :global(:is(a, button):focus-visible) { outline-color: hsl(var(--accent)); }

  @container reading-actions (width < 32rem) {
    [data-series-byline] { flex-direction: column; align-items: flex-start; gap: 1rem; }
    :global([data-hero-series-link]) { font-size: 1.25rem; }
  }

  [data-cover-lead] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.375rem 2.25rem;
    margin-top: 1.75rem;
  }

  [data-article-opening] [data-editorial-summary] {
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: -0.015em;
  }

  [data-cover-byline] {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    padding-top: 0.3125rem;
    font-size: 0.75rem;
    line-height: 1.7;
  }

  [data-cover-byline] a { display: block; min-height: 2.75rem; padding-top: 0.1875rem; }

  @container article-opening (width < 36.25rem) {
    [data-cover-lead] { grid-template-columns: minmax(0, 1fr); gap: 0.875rem; margin-top: 1.375rem; }
    [data-cover-byline] { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 0.3125rem; padding: 0; }
    [data-cover-byline] a { padding: 0; }
  }

  @container article-opening (width < 23.75rem) {
    [data-article-opening] [data-editorial-summary] { font-size: 0.9375rem; }
  }

  [data-article-topics-container] {
    container: article-topics / inline-size;
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    align-items: start;
    gap: 1.375rem;
    padding-bottom: 1.375rem;
    border-bottom: 1px solid hsl(var(--line));
  }

  [data-article-topics-container][data-has-utility='true'] { grid-template-columns: 6.75rem minmax(0, 1fr) auto; }
  [data-article-topics-header] { display: contents; }
  [data-topic-action] { grid-column: 3; grid-row: 1; min-width: 0; max-width: 100%; }
  [data-article-topics] { grid-column: 2; grid-row: 1; min-width: 0; }

  [data-article-topics-heading] {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding-top: 0.625rem;
    color: hsl(var(--brand));
  }

  [data-article-topics-heading] h2 {
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: normal;
  }

  [data-article-topics] ul {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.375rem 1.5rem;
    min-width: 0;
    margin: 0;
    padding: 0 0 0 1.375rem;
    border-left: 2px solid hsl(var(--brand));
    list-style: none;
  }

  [data-article-topics] li { max-width: 100%; }

  :global([data-topic-link]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.875rem;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    border-bottom: 1px solid hsl(var(--line));
    color: hsl(var(--ink));
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  [data-topic-label] { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
  [data-article-topics] :global([data-topic-link] > :last-child) { color: hsl(var(--brand)); }
  :global([data-topic-link]:is(:hover, :focus-visible)) { color: hsl(var(--brand)); }
  :global([data-topic-link]:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 3px; }

  :global(:root[data-theme='dark']) [data-article-topics-heading],
  :global(:root[data-theme='dark'] [data-topic-link]:is(:hover, :focus-visible)),
  :global(:root[data-theme='dark'] [data-topic-link] > :last-child) { color: hsl(var(--accent)); }
  :global(:root[data-theme='dark']) [data-article-topics] ul { border-color: hsl(var(--accent)); }
  :global(:root[data-theme='dark'] [data-topic-link]:focus-visible) { outline-color: hsl(var(--accent)); }

  @container article-opening (width < 48rem) {
    [data-article-topics-container][data-has-utility='true'] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-has-utility='true'] [data-article-topics-header] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
    [data-has-utility='true'] [data-article-topics-heading] { padding-top: 0; }
    [data-has-utility='true'] [data-article-topics] { grid-column: 1; grid-row: 2; }
  }

  @container article-opening (width < 32.5rem) {
    [data-article-topics-container] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-article-topics] { grid-column: 1; grid-row: 2; }
    [data-article-topics-heading] { padding-top: 0; }
  }

  @container article-topics (width < 18.75rem) {
    [data-article-topics] ul { padding-left: 1rem; }
    :global([data-topic-link]) { font-size: 1rem; }
  }

  @container article-topics (width < 14rem) {
    [data-article-topics] ul { padding-left: 0.5rem; }
    :global([data-topic-link]) { column-gap: 0.375rem; font-size: 0.875rem; }
  }

  [data-publication-imprint] {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.5rem;
    color: hsl(var(--ink));
  }

  [data-publication-imprint] dl {
    min-width: 0;
    margin: 0;
    border-inline-start: 1px solid hsl(var(--line));
    padding-inline-start: 1.125rem;
  }

  [data-publication-imprint] dt {
    margin-bottom: 0.4375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
  }

  [data-publication-imprint] dd {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.04em;
  }

  [data-publication-imprint] [data-publication-dates] {
    border-inline-start: 2px solid hsl(var(--brand));
  }

  :global([data-theme='dark']) [data-publication-imprint] [data-publication-dates] {
    border-color: hsl(var(--accent));
  }

  [data-publication-imprint] :global(time) { color: inherit; }

  [data-publication-field='updated'] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.5rem;
  }

  [data-publication-field='updated'],
  [data-publication-field='words'] { margin-top: 0.75rem; }
  [data-publication-field='updated'] dt { margin: 0; }
  [data-publication-field='updated'] dd,
  [data-publication-field='words'] dd {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.7;
    letter-spacing: normal;
  }

  @container editorial-meta (width < 32rem) {
    [data-publication-imprint] { gap: 1rem; }
    [data-publication-imprint] dl { padding-inline-start: 0.875rem; }
    [data-publication-field='published'] dd,
    [data-publication-field='reading'] dd { font-size: 1.25rem; }
  }

  @container editorial-meta (width < 20rem) {
    [data-publication-imprint] { gap: 0.75rem; }
    [data-publication-field='published'] dd,
    [data-publication-field='reading'] dd { font-size: 1.125rem; }
  }

  @container editorial-meta (width < 16rem) {
    [data-publication-imprint] { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  }
</style>
