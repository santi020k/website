---
import type { MarkdownHeading } from 'astro'

import type { CollectionEntry } from 'astro:content'

import ProjectFocusCard from '@/components/molecules/ProjectFocusCard.astro'
import ProjectGlanceCard from '@/components/molecules/ProjectGlanceCard.astro'
import ProjectSidebarCard from '@/components/molecules/ProjectSidebarCard.astro'
import ProjectStackCard from '@/components/molecules/ProjectStackCard.astro'
import TocCard from '@/components/molecules/TocCard.astro'

import { getProjectFocusLabel } from '@/utils/project-meta'

import { Icon } from '@santi020k/lumen-astro'

interface Props {
  headings: MarkdownHeading[]
  project: CollectionEntry<'project'>
}

const { headings, project } = Astro.props
const focusLabel = getProjectFocusLabel(project.data.typesId)
---

<aside aria-label="Project details" class="min-w-0 space-y-5" data-project-sidebar data-reading-rail>
  <div
    aria-hidden="true"
    class="
      -mx-4 mb-6 h-px bg-linear-to-r from-transparent via-brand/40
      to-transparent
      sm:mx-0
    "
    data-reading-rail-divider
  />

  {headings.length ?
    <TocCard headings={headings} /> :
    (
      <div class="glass-pro rounded-2xl px-5 py-4 text-sm/6 text-ink-muted">
        <Icon class="mb-2 size-4 text-brand/50" name="file-text" />
        <p>No sections to navigate — this project has a single-page write-up.</p>
      </div>
    )}

  <ProjectGlanceCard project={project} />

  <ProjectFocusCard focus={focusLabel} />

  <ProjectStackCard technologies={project.data.technologies} />

  {!!project.data.impactMetrics.length && (
    <ProjectSidebarCard icon="trophy" id="sidebar-outcomes" title="Outcomes">
      <ul class="mt-4 list-none space-y-2 p-0">
        {project.data.impactMetrics.map(metric => (
          <li
            class="
              group flex items-start gap-3 rounded-xl px-3 py-2.5
              transition-colors
              hover:bg-brand-soft/20
            "
          >
            <div
              class="
                mt-0.5 flex size-5 shrink-0 items-center justify-center
                rounded-full bg-brand/15 text-brand transition-colors
                group-hover:bg-brand/25
              "
            >
              <Icon class="size-3.5" name="check" />
            </div>
            <span class="text-sm/6 font-medium text-ink">{metric}</span>
          </li>
        ))}
      </ul>
    </ProjectSidebarCard>
  )}
</aside>
