---
import { Picture } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import ThemeToggle from '@/components/atoms/ThemeToggle.astro'

import LogoMark from '@/assets/logo.webp'
import { menuLinks, siteConfig } from '@/site.config'
import type { SiteLink } from '@/types'
---

<header class="
  sticky top-0 z-50 p-4
  sm:px-6
  lg:px-8
"
>
  <div
    class="site-header-shell"
    x-data="{
      open: false,
      toggleMenu() {
        this.open = !this.open;
        if (this.open) {
          this.$nextTick(() => {
            const firstLink = this.$el.querySelector('#mobile-nav a');
            if (firstLink) firstLink.focus();
          });
        }
      },
      closeMenu() {
        if (!this.open) return;
        this.open = false;
        this.$nextTick(() => {
          const toggle = this.$el.querySelector('[aria-controls=\mobile-nav\]');
          if (toggle) toggle.focus();
        });
      }
    }"
    @keydown.escape.window="closeMenu()"
  >
    <a
      aria-label="Home"
      class="
        group inline-flex items-center gap-4 transition duration-200
        motion-reduce:transition-none
      "
      href="/"
    >
      <Picture
        alt="Santi020k"
        class="
          aspect-11/4 h-9 w-auto object-contain transition duration-200
          group-hover:brightness-125
          motion-reduce:transition-none
        "
        fetchpriority="high"
        formats={['avif', 'webp']}
        height={36}
        loading="eager"
        src={LogoMark}
        width={99}
      />
      <span class="
        hidden flex-col
        sm:flex
      "
      >
        <span class="section-label">Santiago Molina
        </span>
        <span class="text-xs text-ink-soft">Leadership · Automation · DX</span>
      </span>
    </a>

    <nav
      aria-label="Main menu"
      class="
        hidden items-center gap-5
        lg:flex
      "
    >
      {
        menuLinks.map((link: SiteLink) => (
          <a
            aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
            class:list={[
              `
                relative inline-flex min-h-11 items-center px-1 py-2 text-sm
                font-medium transition-colors duration-200
                motion-reduce:transition-none
              `,
              Astro.url.pathname === link.path ?
                `
                  font-semibold text-ink
                  after:absolute after:inset-x-1 after:bottom-1 after:h-px
                  after:bg-brand after:content-['']
                ` :
                `
                  text-ink-soft
                  hover:text-ink
                `
            ]}
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <div class="
      hidden items-center gap-3
      lg:flex
    "
    >
      <ThemeToggle />
      <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
        Say hello
      </ButtonLink>
    </div>

    <div class="
      flex items-center gap-3
      lg:hidden
    "
    >
      <ThemeToggle />
      <button
        :aria-expanded="open.toString()"
        :aria-label="open ? 'Close navigation' : 'Open navigation'"
        aria-controls="mobile-nav"
        class="
          inline-flex size-11 cursor-pointer items-center justify-center
          rounded-full border border-line/70 bg-surface/76 text-ink
        "
        type="button"
        x-on:click="toggleMenu()"
      >
        <Icon aria-hidden="true" class="size-5" name="tabler:menu-2" x-show="!open" />
        <Icon aria-hidden="true" class="size-5" name="tabler:x" x-show="open" x-cloak />
      </button>
    </div>

    <div
      id="mobile-nav"
      class="
        absolute top-[calc(100%+1rem)] left-0 w-full px-4
        lg:hidden
      "
      x-cloak
      x-show="open"
      x-transition:enter="transition-all duration-200 ease-out"
      x-transition:enter-start="opacity-0 -translate-y-2 scale-[0.98]"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition-all duration-150 ease-in"
      x-transition:leave-start="opacity-100 translate-y-0 scale-100"
      x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.98]"
    >
      <div class="panel-card flex flex-col gap-2 p-4">
        {
          menuLinks.map((link: SiteLink) => (
            <a
              aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
              class:list={[
                `
                  rounded-2xl border px-4 py-3 text-sm font-medium transition
                  duration-200
                `,
                Astro.url.pathname === link.path ?
                  'border-brand/20 bg-brand-soft/80 font-semibold text-brand' :
                  `
                    border-transparent text-ink-soft
                    hover:border-line/70 hover:bg-surface-muted/70
                    hover:text-ink
                  `
              ]}
              href={link.path}
              @click="closeMenu()"
            >
              {link.title}
            </a>
          ))
        }
        <ButtonLink
          className="justify-center"
          href={siteConfig.contact.linkedin}
          newTab
          showArrow
          variant="secondary"
        >
          Say hello
        </ButtonLink>
      </div>
    </div>
  </div>
</header>
