---
/* eslint-disable @stylistic/jsx-indent-props */
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import LogoSVG from '../../assets/svg/logo.svg'
import { menuLinks, siteConfig } from '../../site.config'
import type { SiteLink } from '../../types.ts'
import ButtonLink from '../atoms/ButtonLink.astro'
import ThemeToggle from '../ThemeToggle.astro'
---

<header class="
  sticky top-0 z-50 p-4
  sm:px-6
  lg:px-8
"
>
  <div
    class="
      relative mx-auto flex max-w-6xl items-center justify-between gap-4
      rounded-[1.75rem] px-4 py-3 panel-surface
    "
    x-data="{ open: false }"
    @keydown.escape.window="open = false"
  >
    <a class="inline-flex items-center gap-3" href="/">
      <span class="
        flex size-11 items-center justify-center rounded-full bg-surface
        panel-surface
      "
      >
        <Image alt="" class="size-6" height={32} src={LogoSVG} width={32} />
      </span>
      <span class="flex flex-col">
        <span class="
          text-sm font-semibold tracking-[0.22em] text-ink-muted uppercase
        "
        >Santiago Molina
        </span>
        <span class="text-sm text-ink-soft">Frontend architecture, DX, and product systems</span>
      </span>
    </a>

    <nav
      aria-label="Main menu"
      class="
        hidden items-center gap-2
        md:flex
      "
    >
      {
        menuLinks.map((link: SiteLink) => (
          <a
            aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
            class:list={[
              `
                rounded-full px-4 py-2 text-sm font-medium transition-all
                duration-200
              `,
              Astro.url.pathname === link.path ?
                'bg-brand-soft text-brand' :
                `
                  text-ink-soft
                  hover:bg-surface-muted hover:text-ink
                `
            ]}
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <div class="
      hidden items-center gap-3
      md:flex
    "
    >
      <ThemeToggle />
      <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
        Say hello
      </ButtonLink>
    </div>

    <div class="
      flex items-center gap-3
      md:hidden
    "
    >
      <ThemeToggle />
      <button
        :aria-expanded="open.toString()"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation"
        class="
          inline-flex size-11 cursor-pointer items-center justify-center
          rounded-full text-ink panel-surface
        "
        type="button"
        x-on:click="open = !open"
      >
        <Icon aria-hidden="true" class="size-5" name="tabler:menu-2" x-show="!open" />
        <Icon aria-hidden="true" class="size-5" name="tabler:x" x-show="open" x-cloak />
      </button>
    </div>

    <div
      id="mobile-nav"
      class="
        absolute top-[calc(100%+1rem)] left-0 w-full px-4
        md:hidden
      "
      x-cloak
      x-show="open"
      x-transition.opacity.duration.200ms
    >
      <div class="flex flex-col gap-2 rounded-3xl p-4 panel-surface">
        {
          menuLinks.map((link: SiteLink) => (
            <a
              aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
              class:list={[
                `
                  rounded-2xl px-4 py-3 text-sm font-medium transition
                  duration-200
                `,
                Astro.url.pathname === link.path ?
                  'bg-brand-soft text-brand' :
                  `
                    text-ink-soft
                    hover:bg-surface-muted hover:text-ink
                  `
              ]}
              href={link.path}
              @click="open = false"
            >
              {link.title}
            </a>
          ))
        }
        <ButtonLink
          className="justify-center"
          href={siteConfig.contact.linkedin}
          newTab
          showArrow
          variant="secondary"
        >
          Say hello
        </ButtonLink>
      </div>
    </div>
  </div>
</header>
