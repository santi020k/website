---
/* eslint-disable @stylistic/jsx-indent-props */
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import LogoMark from '../../assets/logo.webp'
import { menuLinks, siteConfig } from '../../site.config'
import type { SiteLink } from '../../types.ts'
import ButtonLink from '../atoms/ButtonLink.astro'
import ThemeToggle from '../ThemeToggle.astro'
---

<header class="
  sticky top-0 z-50 p-4
  sm:px-6
  lg:px-8
"
>
  <div
    class="
      relative mx-auto flex w-full max-w-[calc(100vw-2rem)] items-center
      justify-between gap-2 rounded-[1.75rem] px-4 py-3 panel-surface
      sm:max-w-6xl sm:gap-4
    "
    x-data="{ open: false }"
    @keydown.escape.window="open = false"
  >
    <a
      aria-label="Home"
      class="
        group inline-flex items-center gap-4 transition duration-200
        motion-reduce:transition-none
      "
      href="/"
    >
      <Image
        alt="Santi020k"
        class="
          aspect-11/4 h-9 w-auto object-contain transition duration-200
          group-hover:brightness-125
          motion-reduce:transition-none
        "
        fetchpriority="high"
        height={36}
        loading="eager"
        src={LogoMark}
        width={99}
      />
      <span
        class="
          hidden h-7 w-px bg-line
          sm:block
        "
        aria-hidden="true"
      />
      <span class="
        hidden flex-col
        sm:flex
      "
      >
        <span class="
          text-xs font-semibold tracking-[0.22em] text-ink-muted uppercase
        "
        >Santiago Molina
        </span>
        <span class="text-xs text-ink-soft">Architecture · DX · Product</span>
      </span>
    </a>

    <nav
      aria-label="Main menu"
      class="
        hidden items-center gap-2
        md:flex
      "
    >
      {
        menuLinks.map((link: SiteLink) => (
          <a
            aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
            class:list={[
              `
                rounded-full px-4 py-2 text-sm font-medium transition-all
                duration-200
              `,
              Astro.url.pathname === link.path ?
                'bg-brand-soft font-semibold text-brand ring-1 ring-brand/25' :
                `
                  text-ink-soft
                  hover:bg-surface-muted hover:text-ink
                `
            ]}
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <div class="
      hidden items-center gap-3
      md:flex
    "
    >
      <ThemeToggle />
      <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
        Say hello
      </ButtonLink>
    </div>

    <div class="
      flex items-center gap-3
      md:hidden
    "
    >
      <ThemeToggle />
      <button
        :aria-expanded="open.toString()"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation"
        class="
          inline-flex size-11 cursor-pointer items-center justify-center
          rounded-full text-ink panel-surface
        "
        type="button"
        x-on:click="open = !open"
      >
        <Icon aria-hidden="true" class="size-5" name="tabler:menu-2" x-show="!open" />
        <Icon aria-hidden="true" class="size-5" name="tabler:x" x-show="open" x-cloak />
      </button>
    </div>

    <div
      id="mobile-nav"
      class="
        absolute top-[calc(100%+1rem)] left-0 w-full px-4
        md:hidden
      "
      x-cloak
      x-show="open"
      x-transition:enter="transition-all duration-200 ease-out"
      x-transition:enter-start="opacity-0 -translate-y-2 scale-[0.98]"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition-all duration-150 ease-in"
      x-transition:leave-start="opacity-100 translate-y-0 scale-100"
      x-transition:leave-end="opacity-0 -translate-y-2 scale-[0.98]"
    >
      <div class="flex flex-col gap-2 rounded-3xl p-4 panel-surface">
        {
          menuLinks.map((link: SiteLink) => (
            <a
              aria-current={Astro.url.pathname === link.path ? 'page' : undefined}
              class:list={[
                `
                  rounded-2xl px-4 py-3 text-sm font-medium transition
                  duration-200
                `,
                Astro.url.pathname === link.path ?
                  `
                    border-l-2 border-brand bg-brand-soft font-semibold
                    text-brand
                  ` :
                  `
                    text-ink-soft
                    hover:bg-surface-muted hover:text-ink
                  `
              ]}
              href={link.path}
              @click="open = false"
            >
              {link.title}
            </a>
          ))
        }
        <ButtonLink
          className="justify-center"
          href={siteConfig.contact.linkedin}
          newTab
          showArrow
          variant="secondary"
        >
          Say hello
        </ButtonLink>
      </div>
    </div>
  </div>
</header>
