---
import { Picture } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import ThemeToggle from '@/components/atoms/ThemeToggle.astro'

import LogoMark from '@/assets/logo.webp'
import { menuLinks, siteConfig } from '@/site.config'
import type { SiteLink } from '@/types'

const fallbackMenuLink: SiteLink = {
  path: '/',
  title: 'Home'
}

const activeMenuLinkIndex = menuLinks.findIndex(link => Astro.url.pathname === link.path)
const currentMenuLinkIndex = activeMenuLinkIndex >= 0 ? activeMenuLinkIndex : 0
const activeMenuLink = menuLinks.at(currentMenuLinkIndex) ?? fallbackMenuLink
---

<header class="
  sticky top-0 z-50 p-4
  sm:px-6
  lg:px-8
"
>
  <div class="site-header-shell">
    <div
      aria-hidden="true"
      class="
        pointer-events-none absolute inset-x-10 inset-y-0 grid-fade opacity-30
      "
    />
    <div
      aria-hidden="true"
      class="
        pointer-events-none absolute -top-14 -right-8 h-28 w-44 rounded-full
        bg-brand/12 blur-3xl
      "
    />

    <a
      aria-label="Home"
      class="
        group relative z-10 inline-flex min-w-0 items-center gap-4 transition
        duration-200
        motion-reduce:transition-none
      "
      href="/"
    >
      <span
        class="
          relative inline-flex shrink-0 items-center justify-center
          rounded-[1.35rem] border border-line/65 bg-surface/88 px-3 py-2
          shadow-[0_12px_28px_hsl(var(--ink)/0.06)]
        "
      >
        <span
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-0 rounded-[inherit]
            bg-linear-to-br from-white/25 via-transparent to-brand/8
          "
        />
        <Picture
          alt="Santi020k"
          class="
            relative aspect-11/4 h-8 w-auto object-contain transition
            duration-300
            group-hover:brightness-115 group-hover:contrast-125
            motion-reduce:transition-none
          "
          fetchpriority="high"
          formats={['avif', 'webp']}
          height={36}
          loading="eager"
          src={LogoMark}
          width={99}
        />
      </span>
      <span class="
        hidden min-w-0 flex-col
        sm:flex
      "
      >
        <span class="section-label">Santiago Molina</span>
        <span class="truncate text-sm font-semibold text-ink">
          Leadership systems · Automation · Developer experience
        </span>
        <span class="truncate text-xs text-ink-soft">{siteConfig.location}</span>
      </span>
    </a>

    <div
      class="
        hidden min-w-0 flex-1
        lg:flex lg:flex-col lg:items-center lg:gap-2
      "
    >
      <div class="flex w-full max-w-3xl items-center justify-between gap-4 px-1">
        <p class="section-label">Explore</p>
        <p class="
          text-[0.68rem] font-semibold tracking-[0.16em] text-ink-muted
          uppercase
        "
        >
          Current page · {activeMenuLink.title}
        </p>
      </div>

      <nav aria-label="Main menu" class="w-full max-w-3xl">
        <div
          class="site-nav-track"
          style={`--active-index: ${currentMenuLinkIndex}; --item-count: ${menuLinks.length}; grid-template-columns: repeat(${menuLinks.length}, minmax(0, 1fr));`}
        >
          <span aria-hidden="true" class="site-nav-indicator" />
          {
            menuLinks.map((link: SiteLink) => {
              const isActive = Astro.url.pathname === link.path

              return (
                <a
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    `
                      relative z-10 inline-flex min-h-12 items-center
                      justify-center rounded-full px-4 py-2 text-sm
                      font-semibold transition duration-300 ease-out
                      motion-reduce:transition-none
                    `,
                    isActive ?
                      'text-brand' :
                      `
                        text-ink-soft
                        hover:text-ink
                      `
                  ]}
                  href={link.path}
                >
                  {link.title}
                </a>
              )
            })
          }
        </div>
      </nav>
    </div>

    <div class="
      relative z-10 hidden items-center gap-3
      lg:flex
    "
    >
      <span class="
        hidden items-center gap-2 rounded-full border border-line/65
        bg-surface-muted/72 px-3.5 py-2
        xl:inline-flex
      "
      >
        <span
          aria-hidden="true"
          class="
            size-2 rounded-full bg-brand
            shadow-[0_0_0_4px_hsl(var(--brand)/0.14)]
          "
        />
        <span class="
          text-[0.68rem] font-semibold tracking-[0.16em] text-ink-muted
          uppercase
        "
        >
          Leadership roles
        </span>
      </span>
      <ThemeToggle />
      <ButtonLink href={siteConfig.contact.linkedin} newTab showArrow variant="secondary">
        Say hello
      </ButtonLink>
    </div>

    <div class="
      relative z-50 flex items-center gap-3
      lg:hidden
    "
    >
      <span class="
        hidden items-center rounded-full border border-line/65
        bg-surface-muted/78 px-3 py-2 text-[0.68rem] font-semibold
        tracking-[0.16em] text-ink-muted uppercase
        sm:inline-flex
      "
      >
        {activeMenuLink.title}
      </span>
      <ThemeToggle />
      <site-header-mobile-nav class="contents">
        <div class="relative" data-mobile-nav>
          <button
            aria-controls="mobile-nav"
            aria-expanded="false"
            aria-label="Open navigation"
            class="
              relative z-50 inline-flex min-h-11 cursor-pointer items-center
              gap-2 rounded-full border border-line/70 bg-surface/76 px-4
              text-ink transition duration-200
              hover:border-brand/35 hover:bg-surface hover:text-brand
              motion-reduce:transition-none
            "
            data-mobile-nav-toggle
            type="button"
          >
            <span class="relative flex size-5 items-center justify-center" aria-hidden="true">
              <span class="absolute inset-0 flex items-center justify-center" data-mobile-nav-menu-icon>
                <Icon aria-hidden="true" class="size-5" name="tabler:menu-2" />
              </span>
              <span
                class="absolute inset-0 items-center justify-center"
                data-mobile-nav-close-icon
                hidden
              >
                <Icon aria-hidden="true" class="size-5" name="tabler:x" />
              </span>
            </span>
            <span
              class="text-[0.68rem] font-semibold tracking-[0.18em] uppercase"
              data-mobile-nav-toggle-label
            >
              Menu
            </span>
          </button>

          <div
            class="
              fixed inset-0 z-40 bg-canvas/72 backdrop-blur-[2px]
              supports-backdrop-filter:bg-canvas/58
            "
            data-mobile-nav-backdrop
            hidden
          />

          <nav
            id="mobile-nav"
            aria-hidden="true"
            aria-label="Main menu"
            class="
              absolute top-[calc(100%+1rem)] right-0 z-50
              w-[min(22rem,calc(100vw-2rem))]
            "
            data-mobile-nav-panel
            hidden
          >
            <div
              class="
                panel-card max-h-[calc(100vh-7rem)] overflow-y-auto p-4
                shadow-[0_22px_56px_hsl(var(--ink)/0.18)]
              "
            >
              <div class="
                relative overflow-hidden rounded-[1.55rem] border border-line/60
                bg-surface-muted/76 p-4
              "
              >
                <div
                  aria-hidden="true"
                  class="
                    pointer-events-none absolute inset-0 grid-fade opacity-45
                  "
                />
                <div class="relative flex items-start justify-between gap-4">
                  <div class="space-y-2">
                    <p class="section-label">Navigation</p>
                    <p class="text-base font-semibold text-ink">
                      Browse the rest of Santiago's work
                    </p>
                    <p class="text-sm text-ink-soft">
                      Current page · {activeMenuLink.title}
                    </p>
                  </div>

                  <span class="
                    rounded-full border border-brand/12 bg-brand-soft/90 px-3
                    py-1 text-[0.68rem] font-semibold tracking-[0.16em]
                    text-brand uppercase
                  "
                  >
                    {siteConfig.location}
                  </span>
                </div>
              </div>

              <div class="mt-3 grid gap-2">
                {
                  menuLinks.map((link: SiteLink) => {
                    const isActive = Astro.url.pathname === link.path

                    return (
                      <a
                        aria-current={isActive ? 'page' : undefined}
                        class:list={[
                          `
                            flex min-h-12 items-center justify-between gap-3
                            rounded-[1.35rem] border px-4 py-3 text-sm
                            font-medium transition duration-200 ease-out
                            motion-reduce:transition-none
                          `,
                          isActive ?
                            `
                              border-brand/20 bg-brand-soft/80 font-semibold
                              text-brand
                              shadow-[0_14px_28px_hsl(var(--brand)/0.08)]
                            ` :
                            `
                              border-transparent text-ink-soft
                              hover:border-line/70 hover:bg-surface-muted/70
                              hover:text-ink
                            `
                        ]}
                        data-mobile-nav-link
                        href={link.path}
                      >
                        <span>{link.title}</span>
                        {
                          isActive && (
                            <span class="
                              rounded-full bg-brand/10 px-2.5 py-1
                              text-[0.68rem] font-semibold tracking-[0.14em]
                              uppercase
                            "
                            >
                              Current
                            </span>
                          )
                        }
                      </a>
                    )
                  })
                }
              </div>

              <div class="
                mt-3 grid gap-2 border-t border-line/55 pt-3
                sm:grid-cols-2
              "
              >
                <ButtonLink
                  className="justify-center"
                  href={siteConfig.contact.linkedin}
                  newTab
                  showArrow
                  variant="secondary"
                >
                  Say hello
                </ButtonLink>
                <ButtonLink
                  className="justify-center"
                  href={siteConfig.contact.resume}
                  newTab
                  showArrow
                  variant="ghost"
                >
                  Resume
                </ButtonLink>
              </div>
            </div>
          </nav>
        </div>
      </site-header-mobile-nav>
    </div>
  </div>
</header>

<script>
class SiteHeaderMobileNav extends HTMLElement {
  isOpen = false
  root: HTMLElement | null = null
  toggle: HTMLButtonElement | null = null
  toggleLabel: HTMLElement | null = null
  menuIcon: HTMLElement | null = null
  closeIcon: HTMLElement | null = null
  backdrop: HTMLElement | null = null
  panel: HTMLElement | null = null

  connectedCallback() {
    this.root = this.querySelector('[data-mobile-nav]')
    this.toggle = this.querySelector('[data-mobile-nav-toggle]')
    this.toggleLabel = this.querySelector('[data-mobile-nav-toggle-label]')
    this.menuIcon = this.querySelector('[data-mobile-nav-menu-icon]')
    this.closeIcon = this.querySelector('[data-mobile-nav-close-icon]')
    this.backdrop = this.querySelector('[data-mobile-nav-backdrop]')
    this.panel = this.querySelector('[data-mobile-nav-panel]')

    if (
      !(this.root instanceof HTMLElement) ||
      !(this.toggle instanceof HTMLButtonElement) ||
      !(this.toggleLabel instanceof HTMLElement) ||
      !(this.menuIcon instanceof HTMLElement) ||
      !(this.closeIcon instanceof HTMLElement) ||
      !(this.backdrop instanceof HTMLElement) ||
      !(this.panel instanceof HTMLElement)
    ) {
      return
    }

    this.toggle.addEventListener('click', this.handleToggleClick)
    this.backdrop.addEventListener('click', this.handleBackdropClick)
    this.panel.addEventListener('click', this.handlePanelClick)
    window.addEventListener('keydown', this.handleWindowKeydown)
    window.addEventListener('resize', this.handleWindowResize, { passive: true })
    window.addEventListener('pageshow', this.handlePageShow)
    document.addEventListener('astro:before-preparation', this.handleAstroPreparation)
    document.addEventListener('astro:page-load', this.handleAstroPreparation)

    this.sync()
  }

  disconnectedCallback() {
    this.toggle?.removeEventListener('click', this.handleToggleClick)
    this.backdrop?.removeEventListener('click', this.handleBackdropClick)
    this.panel?.removeEventListener('click', this.handlePanelClick)
    window.removeEventListener('keydown', this.handleWindowKeydown)
    window.removeEventListener('resize', this.handleWindowResize)
    window.removeEventListener('pageshow', this.handlePageShow)
    document.removeEventListener('astro:before-preparation', this.handleAstroPreparation)
    document.removeEventListener('astro:page-load', this.handleAstroPreparation)

    this.toggleScrollLock(false)
  }

  handleToggleClick = () => {
    if (this.isOpen) {
      this.closeMenu()
      return
    }

    this.openMenu()
  }

  handleBackdropClick = () => {
    this.closeMenu()
  }

  handlePanelClick = (event: MouseEvent) => {
    const target = event.target

    if (!(target instanceof Element)) {
      return
    }

    if (target.closest('a[href]')) {
      this.closeMenu({ restoreFocus: false })
    }
  }

  handleWindowKeydown = (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      this.closeMenu()
      return
    }

    if (event.key === 'Tab' && this.isOpen) {
      this.trapFocus(event)
    }
  }

  handleWindowResize = () => {
    if (window.innerWidth >= 1024) {
      this.closeMenu({ restoreFocus: false })
    }
  }

  handlePageShow = () => {
    this.closeMenu({ restoreFocus: false })
  }

  handleAstroPreparation = () => {
    this.closeMenu({ restoreFocus: false })
  }

  openMenu() {
    if (this.isOpen) {
      return
    }

    this.isOpen = true
    this.sync()

    window.requestAnimationFrame(() => {
      const firstLink = this.panel?.querySelector('a[href]')
      if (firstLink instanceof HTMLElement) {
        firstLink.focus()
      }
    })
  }

  closeMenu({ restoreFocus = true } = {}) {
    const wasOpen = this.isOpen
    this.isOpen = false
    this.sync()

    if (wasOpen && restoreFocus && this.toggle instanceof HTMLElement) {
      this.toggle.focus()
    }
  }

  sync() {
    if (
      !(this.root instanceof HTMLElement) ||
      !(this.toggle instanceof HTMLButtonElement) ||
      !(this.toggleLabel instanceof HTMLElement) ||
      !(this.menuIcon instanceof HTMLElement) ||
      !(this.closeIcon instanceof HTMLElement) ||
      !(this.backdrop instanceof HTMLElement) ||
      !(this.panel instanceof HTMLElement)
    ) {
      return
    }

    const isOpen = this.isOpen

    this.toggle.setAttribute('aria-expanded', String(isOpen))
    this.toggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation')
    this.toggleLabel.textContent = isOpen ? 'Close' : 'Menu'
    this.menuIcon.hidden = isOpen
    this.closeIcon.hidden = !isOpen
    this.backdrop.hidden = !isOpen
    this.panel.hidden = !isOpen
    this.panel.setAttribute('aria-hidden', String(!isOpen))
    this.toggleScrollLock(isOpen)
  }

  trapFocus(event: KeyboardEvent) {
    if (!(this.panel instanceof HTMLElement)) {
      return
    }

    const focusableElements = [
      ...this.panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    ].filter(element => !element.hasAttribute('hidden') && element.getAttribute('aria-hidden') !== 'true')

    const firstElement = focusableElements.at(0)
    const lastElement = focusableElements.at(-1)

    if (!(firstElement instanceof HTMLElement) || !(lastElement instanceof HTMLElement)) {
      return
    }

    const activeElement = document.activeElement

    if (!(activeElement instanceof HTMLElement) || !this.panel.contains(activeElement)) {
      event.preventDefault()
      firstElement.focus()
      return
    }

    if (event.shiftKey && activeElement === firstElement) {
      event.preventDefault()
      lastElement.focus()
      return
    }

    if (!event.shiftKey && activeElement === lastElement) {
      event.preventDefault()
      firstElement.focus()
    }
  }

  toggleScrollLock(locked: boolean) {
    document.documentElement.classList.toggle('mobile-nav-open', locked)
    document.body.classList.toggle('mobile-nav-open', locked)
  }
}

if (!customElements.get('site-header-mobile-nav')) {
  customElements.define('site-header-mobile-nav', SiteHeaderMobileNav)
}
</script>

<style is:global>
[data-mobile-nav-toggle][aria-expanded='true'] {
  background-color: hsl(var(--surface));
  border-color: hsl(var(--brand) / 0.35);
  color: hsl(var(--brand));
}
</style>
