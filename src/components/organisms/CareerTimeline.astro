---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { localizeProject } from '@/utils/content-translations'
import { getFormattedDate } from '@/utils/date'
import { getPortfolioPath } from '@/utils/links'
import { getProjectBrandStyle } from '@/utils/project-brand'
import { sortTechnologiesByInterest } from '@/utils/technologies'

import { Card, Timeline } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  projects: CollectionEntry<'project'>[]
}

const { projects: originalEntries } = Astro.props
const projects = await Promise.all(originalEntries.map(entry => localizeProject(entry, locale)))

const careerItems = projects.map((project, index) => ({
  brand: project.data.brand,
  company: project.data.title,
  companyId: project.id,
  description: project.data.description,
  endDate: project.data.endingDate?.toISOString().slice(0, 10),
  endLabel: project.data.endingDate ? getFormattedDate(project.data.endingDate, { day: undefined, month: 'short', year: 'numeric' }, locale === 'es' ? 'es-419' : 'en-US') : t('collection.present'),
  href: localizePath(getPortfolioPath(project.id), locale),
  isActive: !project.data.endingDate,
  isCompact: index >= 3 && Boolean(project.data.endingDate),
  logo: project.data.coverImage?.logo,
  logoAspect: project.data.coverImage?.logoAspect ?? 'square',
  logoSurface: project.data.coverImage?.logoSurface ?? 'dark',
  role: project.data.role ? localizeCollectionSource(locale, project.data.role) : t('collection.engineer'),
  startDate: project.data.startingDate.toISOString().slice(0, 10),
  startMonth: getFormattedDate(project.data.startingDate, { day: undefined, month: 'short', year: undefined }, locale === 'es' ? 'es-419' : 'en-US'),
  startYear: getFormattedDate(project.data.startingDate, { day: undefined, month: undefined, year: 'numeric' }),
  technologies: sortTechnologiesByInterest(project.data.technologies).slice(0, 3)
}))
---

<Timeline data-career-timeline aria-label={t('collection.professionalExperienceNewestFirst')}>
  {careerItems.map(item => (
    <li
data-timeline-row={item.isActive ? 'active' : 'completed'}
data-career-row
data-career-density={item.isCompact ? 'compact' : 'full'}
style={getProjectBrandStyle(item.brand)}
    >
      <a data-career-link href={localizePath(item.href, locale)}>
        <div data-career-date>
          <time datetime={item.startDate} data-career-start><span data-career-month>{item.startMonth}</span>{' '}<span data-career-year>{item.startYear}</span></time>
          <span data-career-end> - {item.endDate ? <time datetime={item.endDate}>{item.endLabel}</time> : item.endLabel}</span>
        </div>
        <Card as="div" variant="unstyled" data-career-folio>
          {item.logo && (
            <div data-career-identity data-company={item.companyId} data-logo-aspect={item.logoAspect} data-logo-surface={item.logoSurface}>
              <Image alt="" src={item.logo} width={Math.min(item.logo.width, 320)} loading="lazy" format="webp" sizes="(min-width: 768px) 116px, 100px" />
            </div>
          )}
          <div data-career-content>
            {!item.isCompact && (
<div data-career-masthead>
              <span data-career-status={item.isActive ? 'current' : 'completed'}>{item.isActive ? t('shared.current') : t('collection.completed')}</span>

            </div>
)}
            <h3 data-career-title>{item.company}</h3>
            <p data-career-role>{item.role}</p>
          </div>
          <p data-career-description>{item.description}</p>
          <div data-career-footer>
            {item.technologies.length > 0 && (
              <ul data-career-technologies aria-label={t('technology.collection', { name: item.company })}>
                {item.technologies.map(technology => <li>{technology}</li>)}
              </ul>
            )}
            <span data-career-action>{t('collection.readCaseStudy')}<ArrowExchange
direction="right"
class="size-4"
                                                                    /></span>
          </div>
        </Card>
      </a>
    </li>
  ))}
</Timeline>

<style>
  [data-career-timeline] {
    --career-emphasis: var(--brand);
    container: career-timeline / inline-size;
    margin: 0 0 4rem;
    padding: 0;
    list-style: none;
  }
  :global(:root[data-theme='santi020k-dark']) [data-career-timeline] { --career-emphasis: var(--accent); }
  :global(:root[data-theme='santi020k-dark']) [data-career-action] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  [data-career-row] {
    --career-project-ink: var(--project-primary-readable);
    --career-rail-x: 7.125rem;
    --career-full-year-size: 2.1875rem;
    --career-compact-year-size: 1.5rem;
    --career-year-size: var(--career-full-year-size);
    --career-node-y: calc(var(--career-year-size) * 0.6);
    --career-next-node-y: calc(var(--career-full-year-size) * 0.6);
  }
  [data-career-row]:has(+ [data-career-density='compact']) { --career-next-node-y: calc(var(--career-compact-year-size) * 0.6); }
  :global(:root[data-theme='santi020k-dark']) [data-career-row] { --career-project-ink: var(--project-primary-readable-dark); }
  [data-career-link] {
    position: relative;
    display: grid;
    grid-template-columns: 8.125rem minmax(0, 1fr);
    padding: 0 0 1.5rem;
    color: hsl(var(--ink));
    text-decoration: none;
  }
  [data-career-link]::before {
    content: '';
    position: absolute;
    top: var(--career-node-y);
    bottom: calc(-1 * var(--career-next-node-y));
    left: var(--career-rail-x);
    width: 1px;
    transform: translateX(-50%);
    background: color-mix(in srgb, hsl(var(--career-emphasis)) 25%, hsl(var(--line)));
    pointer-events: none;
  }
  /* Each segment reaches the next marker, including the space between cards.
     The last marker is the endpoint, without a tail beneath its card. */
  [data-career-row]:last-child [data-career-link] { padding-bottom: 0; }
  [data-career-row]:last-child [data-career-link]::before { display: none; }
  [data-career-link]::after {
    content: '';
    position: absolute;
    top: var(--career-node-y);
    left: var(--career-rail-x);
    width: 0.625rem;
    height: 0.625rem;
    border: 2px solid hsl(var(--career-emphasis));
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-canvas);
    box-shadow: 0 0 0 3px var(--color-canvas);
    pointer-events: none;
  }
  [data-timeline-row='active'] [data-career-link]::after {
    background: hsl(var(--career-emphasis));
    box-shadow: 0 0 0 3px var(--color-canvas), 0 0 0 5px hsl(var(--career-emphasis) / 0.15);
  }
  [data-career-link]:focus-visible { outline: 2px solid hsl(var(--accent)); outline-offset: -4px; }
  [data-career-date] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
    padding: 0 1.875rem 1rem 1.125rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.667;
  }
  [data-career-start] { display: flex; flex-direction: column; gap: 0.3125rem; }
  [data-career-year] {
    order: -1;
    color: hsl(var(--career-emphasis));
    font-size: var(--career-year-size);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.06em;
  }
  [data-career-folio] {
    position: static;
    min-width: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    column-gap: 2rem;
    padding: 1.5rem 1.5rem 0;
    border: 0;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  [data-career-content] { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; justify-content: center; min-width: 0; min-height: 6rem; padding: 0; }
  [data-career-identity] { grid-column: 2; grid-row: 1; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; align-self: start; min-width: 0; width: 9rem; aspect-ratio: 3 / 2; padding: 0; overflow: hidden; border-radius: 1.25rem 0.25rem 1.25rem 0.25rem; background: hsl(var(--project-surface)); }
  [data-career-identity][data-logo-surface='light'] { background: var(--color-logo-paper); }
  [data-career-identity][data-logo-surface='dark'] { background: hsl(var(--project-surface)); }
  [data-career-identity] img { display: block; width: 82%; height: 68%; object-fit: contain; }
  [data-career-identity][data-logo-aspect='tall'] img { height: 66%; }
  /* These source files include uneven transparent margins. Correct their optical
     bounds without cropping, stretching, or replacing the original brand assets. */
  [data-career-identity][data-company='tedx-medellin'] img { width: 78%; transform: scale(1.2) translate(2%, 5%); }
  [data-career-identity][data-company='nebular'] img { transform: scale(1.35) translate(-5%, -2%); }
  [data-career-masthead] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.625rem; }
  [data-career-status] { display: inline-flex; align-items: center; gap: 0.4375rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-career-status='current'] { color: hsl(var(--career-emphasis)); }
  [data-career-status='current']::before { content: ''; width: 0.3125rem; height: 0.3125rem; border-radius: 50%; background: currentColor; }
  [data-career-title] { margin: 0; font-size: 2rem; font-weight: 500; line-height: 1.21; letter-spacing: -0.045em; overflow-wrap: break-word; text-wrap: wrap; word-break: normal; hyphens: manual; }
  [data-career-role] { margin-top: 0.5rem; color: hsl(var(--career-emphasis)); font-size: 0.875rem; line-height: 1.64; letter-spacing: -0.02em; }
  [data-career-description] { grid-column: 1 / -1; max-width: 78ch; margin-top: 1.25rem; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.85; letter-spacing: -0.015em; text-wrap: pretty; }
  [data-career-footer] { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem 1.5rem; padding: 1.25rem 0; margin-top: 0.25rem; background: transparent; }
  [data-career-technologies] { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; padding: 0; list-style: none; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-career-technologies] > li { overflow-wrap: anywhere; min-width: 0; }
  [data-career-action] { display: inline-flex; align-items: center; gap: 0.5625rem; color: hsl(var(--career-emphasis)); font-size: 0.75rem; font-weight: 500; line-height: 1.667; }
  [data-career-density='compact'] { --career-year-size: var(--career-compact-year-size); }
  [data-career-density='compact']:not(:last-child) [data-career-link] { padding-bottom: 1.5rem; }
  [data-career-density='compact'] [data-career-date] { gap: 0.75rem; }
  [data-career-density='compact'] [data-career-folio] { padding-top: 1.5rem; }
  [data-career-density='compact'] [data-career-content] { padding: 0; }
  [data-career-density='compact'] [data-career-title] { font-size: 1.75rem; line-height: 1.3; }
  [data-career-density='compact'] [data-career-description] { margin-top: 0.75rem; }
  [data-career-density='compact'] [data-career-footer] { padding: 1.25rem 0; }
  [data-career-link]:is(:hover, :focus-visible) [data-career-folio] {
    border-color: hsl(var(--project-primary) / 0.5);
    background: color-mix(in srgb, hsl(var(--project-primary)) 4%, var(--color-canvas));
    box-shadow: inset 2px 0 0 hsl(var(--project-primary) / 0.72);
  }

  [data-career-link]:is(:hover, :focus-visible) :is([data-career-title], [data-career-role], [data-career-year], [data-career-action], [data-career-status='current']) {
    color: color-mix(in srgb, hsl(var(--career-project-ink)) 84%, hsl(var(--ink)));
  }
  [data-career-link]:is(:hover, :focus-visible)::after { border-color: hsl(var(--project-primary)); background: hsl(var(--project-primary)); box-shadow: 0 0 0 3px var(--color-canvas), 0 0 0 5px hsl(var(--project-primary) / 0.12); }
  @media (prefers-reduced-motion: no-preference) {
    [data-career-folio] { transition: border-color 480ms ease, background-color 480ms ease, box-shadow 480ms ease; }
    [data-career-footer] { transition: background-color 480ms ease; }
    [data-career-title], [data-career-role], [data-career-year], [data-career-action], [data-career-status] { transition: color 480ms ease; }
    [data-career-link]::after { transition: border-color 480ms ease, background-color 480ms ease, box-shadow 480ms ease; }
  }
  @container career-timeline (width < 48rem) {
    [data-career-folio] { grid-template-columns: minmax(0, 1fr) 7.5rem; gap: 0 1.5rem; padding-inline: 1.25rem; }
    [data-career-identity] { width: 7.5rem; }
    [data-career-content] { min-height: 5rem; }
  }
  @container career-timeline (width < 36.25rem) {
    [data-career-row] { --career-rail-x: 0.3125rem; --career-full-year-size: 2rem; }
    [data-career-link] { grid-template-columns: minmax(0, 1fr); padding: 0 0 2rem 1.25rem; }
    [data-career-date] { justify-content: flex-start; gap: 0.5625rem; width: calc(100% - 8.5rem); min-height: 5rem; padding: 0; margin-bottom: 1rem; }
    [data-career-start] { flex-direction: row; align-items: center; gap: 0.5625rem; }
    [data-career-year] { order: 0; }
    [data-career-folio] { grid-template-columns: minmax(0, 1fr); padding: 1.5rem 1.25rem 0; }
    [data-career-identity] { position: absolute; grid-area: auto; top: 0; right: 0; }
    [data-career-content] { min-height: 0; padding: 0; }
    [data-career-title] { font-size: 1.6875rem; line-height: 1.26; }
    [data-career-footer] { padding: 1.25rem 0; }
  }
  @container career-timeline (width < 20rem) {
    [data-career-link] { padding-left: 1.125rem; }
    [data-career-date], [data-career-start] { gap: 0.375rem; }
    [data-career-folio] { padding-inline: 0.75rem; }
    [data-career-identity] { max-width: 100%; }
    [data-career-row] [data-career-title] { font-size: min(1.6875rem, 10cqi); }
    [data-career-role], [data-career-description] { overflow-wrap: break-word; }
  }
  @container career-timeline (width < 16rem) {
    [data-career-link] { padding-left: 0.75rem; }
    [data-career-date] { width: 100%; min-height: 0; }
    [data-career-folio] { padding-inline: 0.25rem; }
    [data-career-identity] { position: static; grid-column: 1; grid-row: 1; margin-bottom: 1rem; }
    [data-career-content] { grid-row: 2; }
  }
  @media (forced-colors: active) {
    [data-career-link]::after { border-color: CanvasText; background: Canvas; }
    [data-timeline-row='active'] [data-career-link]::after, [data-career-link]:is(:hover, :focus-visible)::after, [data-career-status='current']::before { border-color: CanvasText; background: CanvasText; }
    [data-career-link]::before { background: GrayText; }
  }
</style>
