---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import Pill from '@/components/atoms/Pill.astro'

import { getPortfolioPath } from '@/utils/links'
import { getProjectTimelineLabel } from '@/utils/project-meta'
import { sortTechnologiesByInterest } from '@/utils/technologies'

interface Props {
  projects: CollectionEntry<'project'>[]
}

const { projects } = Astro.props

const careerItems = projects.map(project => ({
  company: project.data.title,
  description: project.data.description,
  href: getPortfolioPath(project.id),
  isActive: !project.data.endingDate,
  role: project.data.role ?? 'Engineer',
  technologies: sortTechnologiesByInterest(project.data.technologies).slice(0, 4),
  timeline: getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
}))
---

<div class="relative">
  {/* Timeline connector line */}
  <div
    aria-hidden="true"
    class="absolute inset-y-0 left-[1.125rem] w-px bg-linear-to-b from-brand/30 via-line to-line/50 sm:left-[1.375rem]"
  >
  </div>

  <div class="space-y-8">
    {careerItems.map(item => (
      <article class="relative pl-12 sm:pl-14">
        {/* Timeline node */}
        <div
          class:list={[
            `
              absolute left-0 top-1 flex size-9 items-center justify-center rounded-full
              border-2 sm:size-10
            `,
            item.isActive ? `
              border-brand bg-brand text-white shadow-[0_0_20px_rgba(var(--brand-rgb),0.3)]
            ` : `
              border-line bg-surface text-ink-muted
            `
          ]}
        >
          <Icon
            aria-hidden="true"
            class="size-4 sm:size-5"
            name={item.isActive ? 'tabler:briefcase' : 'tabler:check'}
          />
        </div>

        {/* Content card */}
        <div
          class:list={[
            `
              group card-interactive rounded-2xl border p-5 transition-all duration-200
              sm:p-6
              motion-reduce:transition-none
            `,
            item.isActive ? `
              border-brand/20 bg-brand-soft/20
            ` : `
              border-line/60 bg-surface/50
            `
          ]}
        >
          {/* Header */}
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-sm font-medium text-ink-soft">{item.role}</p>
              <h3 class="mt-1 text-xl font-semibold text-ink sm:text-2xl">
                <a
                  class="transition-colors hover:text-brand motion-reduce:transition-none"
                  href={item.href}
                >
                  {item.company}
                </a>
              </h3>
            </div>

            <div class="flex items-center gap-2">
              <Pill
                label={item.isActive ? 'Current' : 'Completed'}
                tone={item.isActive ? 'brand' : 'neutral'}
              />
            </div>
          </div>

          {/* Timeline badge */}
          <div class="mt-4 flex items-center gap-2 text-sm text-ink-muted">
            <Icon aria-hidden="true" class="size-4" name="tabler:calendar" />
            <span class="font-medium">{item.timeline}</span>
          </div>

          {/* Description */}
          <p class="mt-4 line-clamp-2 text-sm/6 text-ink-soft sm:line-clamp-3">
            {item.description}
          </p>

          {/* Technologies */}
          {item.technologies.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {item.technologies.map(tech => (
                <Pill label={tech} tone="outline" />
              ))}
            </div>
          )}

          {/* View link */}
          <div class="mt-5 flex items-center gap-2 text-sm font-medium">
            <a
              class="
                inline-flex items-center gap-1.5 text-brand transition-colors
                hover:text-brand-solid
              "
              href={item.href}
            >
              View case study
              <Icon
                aria-hidden="true"
                class="size-4 transition-transform group-hover:translate-x-0.5"
                name="tabler:arrow-right"
              />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
