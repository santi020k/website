---
import type { CollectionEntry } from 'astro:content'

import { getFormattedDate } from '@/utils/date'
import { getPortfolioPath } from '@/utils/links'
import { sortTechnologiesByInterest } from '@/utils/technologies'

import { Card, Icon, Timeline } from '@santi020k/lumen-astro'

interface Props {
  projects: CollectionEntry<'project'>[]
}

const { projects } = Astro.props

const careerItems = projects.map(project => ({
  company: project.data.title,
  description: project.data.description,
  endDate: project.data.endingDate?.toISOString().slice(0, 10),
  endLabel: project.data.endingDate ? getFormattedDate(project.data.endingDate, { day: undefined, month: 'short', year: 'numeric' }) : 'Present',
  href: getPortfolioPath(project.id),
  isActive: !project.data.endingDate,
  role: project.data.role ?? 'Engineer',
  startDate: project.data.startingDate.toISOString().slice(0, 10),
  startMonth: getFormattedDate(project.data.startingDate, { day: undefined, month: 'short', year: undefined }),
  startYear: getFormattedDate(project.data.startingDate, { day: undefined, month: undefined, year: 'numeric' }),
  technologies: sortTechnologiesByInterest(project.data.technologies).slice(0, 3)
}))
---

<Timeline data-career-timeline>
  {careerItems.map(item => (
    <li
data-timeline-row={item.isActive ? 'active' : 'completed'}
data-career-row
    >
      <a data-career-link href={item.href}>
        <div data-career-date>
          <time datetime={item.startDate} data-career-start><span data-career-month>{item.startMonth}</span>{' '}<span data-career-year>{item.startYear}</span></time>
          <span data-career-end> - {item.endDate ? <time datetime={item.endDate}>{item.endLabel}</time> : item.endLabel}</span>
        </div>
        <Card as="article" variant="unstyled" data-career-folio>
          <div data-career-content>
            <div data-career-masthead>
              <span data-career-status={item.isActive ? 'current' : 'completed'}>{item.isActive ? 'Current' : 'Completed'}</span>
              <span data-career-icon><Icon
name={item.isActive ? 'briefcase-business' : 'check'}
class="size-4"
                                     /></span>
            </div>
            <h3 data-career-title>{item.company}</h3>
            <p data-career-role>{item.role}</p>
            <p data-career-description>{item.description}</p>
          </div>
          <div data-career-footer>
            {item.technologies.length > 0 && (
              <ul data-career-technologies aria-label={`${item.company} technologies`}>
                {item.technologies.map(technology => <li>{technology}</li>)}
              </ul>
            )}
            <span data-career-action>Read case study <Icon
name="arrow-right"
class="size-4"
                                                     /></span>
          </div>
        </Card>
      </a>
    </li>
  ))}
</Timeline>

<style>
  [data-career-timeline] {
    --career-emphasis: var(--brand);
    container: career-timeline / inline-size;
    margin: 0 0 4rem;
    padding: 0;
    list-style: none;
  }
  :global(:root[data-theme='dark']) [data-career-timeline] { --career-emphasis: var(--accent); }
  :global(:root[data-theme='dark']) [data-career-footer] { background: color-mix(in srgb, hsl(var(--brand-soft)) 55%, hsl(var(--surface))); }
  :global(:root[data-theme='dark']) [data-career-action] { color: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink))); }
  [data-career-row] { border-top: 1px solid hsl(var(--line) / 0.65); }
  [data-career-row]:last-child { border-bottom: 1px solid hsl(var(--line) / 0.65); }
  [data-career-link] {
    position: relative;
    display: grid;
    grid-template-columns: 8.125rem minmax(0, 1fr);
    padding: 1.5rem 1rem 1.5rem 0;
    color: hsl(var(--ink));
    text-decoration: none;
  }
  [data-career-link]::before {
    content: '';
    position: absolute;
    top: 3.3125rem;
    bottom: 0;
    left: 7.125rem;
    width: 1px;
    background: hsl(var(--line) / 0.65);
  }
  [data-career-link]::after {
    content: '';
    position: absolute;
    top: 2.75rem;
    left: 6.9375rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: hsl(var(--career-emphasis));
  }
  [data-career-link]:focus-visible { outline: 2px solid hsl(var(--accent)); outline-offset: -4px; }
  [data-career-date] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
    padding: 0.625rem 1.875rem 1rem 1.125rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.667;
  }
  [data-career-start] { display: flex; flex-direction: column; gap: 0.3125rem; }
  [data-career-year] {
    order: -1;
    color: hsl(var(--career-emphasis));
    font-size: 2.1875rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.06em;
  }
  [data-career-folio] {
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.125rem 1.125rem 0.375rem 1.125rem;
    background: hsl(var(--surface));
    box-shadow: var(--shadow-nav);
  }
  [data-career-content] { padding: 1.5rem 1.625rem; }
  [data-career-masthead] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1.25rem; }
  [data-career-status] { display: inline-flex; align-items: center; gap: 0.4375rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-career-status='current'] { color: hsl(var(--career-emphasis)); }
  [data-career-status='current']::before { content: ''; width: 0.3125rem; height: 0.3125rem; border-radius: 50%; background: currentColor; }
  [data-career-icon] { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 0.625rem; color: hsl(var(--career-emphasis)); background: hsl(var(--brand-soft)); }
  [data-career-title] { margin: 0; font-size: 1.8125rem; font-weight: 500; line-height: 1.21; letter-spacing: -0.045em; overflow-wrap: break-word; text-wrap: wrap; word-break: normal; hyphens: manual; }
  [data-career-role] { margin-top: 0.5rem; color: hsl(var(--career-emphasis)); font-size: 0.875rem; line-height: 1.64; letter-spacing: -0.02em; }
  [data-career-description] { max-width: 68ch; margin-top: 1.25rem; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; letter-spacing: -0.015em; text-wrap: pretty; }
  [data-career-footer] { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem 1.5rem; padding: 1rem 1.625rem; border-top: 1px solid hsl(var(--line) / 0.65); background: hsl(var(--brand-soft)); }
  [data-career-technologies] { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; padding: 0; list-style: none; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-career-technologies] > li { overflow-wrap: anywhere; min-width: 0; }
  [data-career-action] { display: inline-flex; align-items: center; gap: 0.5625rem; color: hsl(var(--career-emphasis)); font-size: 0.75rem; font-weight: 500; line-height: 1.667; }
  [data-career-link]:is(:hover, :focus-visible) [data-career-title] { color: hsl(var(--career-emphasis)); }
  @media (prefers-reduced-motion: no-preference) { [data-career-title] { transition: color 160ms ease; } }
  @container career-timeline (width < 36.25rem) {
    [data-career-row], [data-career-row]:last-child { border: 0; }
    [data-career-link] { grid-template-columns: minmax(0, 1fr); padding: 0 0 1.5rem 1.25rem; }
    [data-career-link]::before { top: 1.625rem; left: 0.1875rem; }
    [data-career-link]::after { top: 1.125rem; left: 0; }
    [data-career-date] { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.5625rem; padding: 0 0 1.25rem; }
    [data-career-start] { flex-direction: row; align-items: center; gap: 0.5625rem; }
    [data-career-year] { order: 0; font-size: 2rem; }
    [data-career-content] { padding: 1.375rem 1.25rem; }
    [data-career-title] { font-size: 1.6875rem; line-height: 1.26; }
    [data-career-footer] { padding: 1rem 1.25rem; }
  }
  @container career-timeline (width < 20rem) {
    [data-career-link] { padding-left: 0.75rem; }
    [data-career-content], [data-career-footer] { padding-inline: 0.75rem; }
    [data-career-title] { font-size: min(1.6875rem, 10cqi); }
    [data-career-role], [data-career-description] { overflow-wrap: break-word; }
  }
  @media (forced-colors: active) {
    [data-career-link]::after, [data-career-status='current']::before { background: CanvasText; }
    [data-career-link]::before { background: GrayText; }
  }
</style>
