---
import GradientDivider from '@/components/atoms/GradientDivider.astro'

interface Props {
  class?: string | undefined
  divider?: boolean
  layout?: 'split' | 'stacked'
}

const { class: className, divider = false, layout = 'split' } = Astro.props
---

{divider && (
  <GradientDivider class="
    pt-6
    sm:pt-8
  "
  />
)}
<section
  class:list={[
    'section-container-wide page-section-space',
    className
  ]}
  data-page-section={layout}
>
  <div class="grid items-start gap-6" data-page-section-grid>
    <slot />
  </div>
</section>
