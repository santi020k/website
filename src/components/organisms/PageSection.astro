---
import GradientDivider from '@/components/atoms/GradientDivider.astro'

interface Props {
  class?: string | undefined
  divider?: boolean
  layout?: 'split' | 'stacked'
}

const { class: className, divider = false, layout = 'split' } = Astro.props
---

{divider && (
  <GradientDivider class="
    pt-6
    sm:pt-8
  "
  />
)}
<section
  class:list={[
    'section-container-wide',
    className
  ]}
  data-page-section={layout}
>
  <div class="grid items-start gap-6" data-page-section-grid>
    <slot />
  </div>
</section>

<style>
  [data-page-section] { --section-space: 4.5rem; padding-top: var(--section-space); }
  /* The page's flex gap already supplies part of the distance between sections. */
  :global(.page-flow) > [data-page-section] {
    padding-top: max(0px, calc(var(--section-space) - var(--page-flow-gap)));
  }
  @media (width >= 40rem) { [data-page-section] { --section-space: 6rem; } }
  @media (width >= 64rem) { [data-page-section] { --section-space: 7rem; } }
</style>
