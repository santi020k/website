---
import GradientDivider from '@/components/atoms/GradientDivider.astro'

interface Props {
  class?: string | undefined
  divider?: boolean
}

const { class: className, divider = false } = Astro.props
---

{divider && (
  <GradientDivider class="
    pt-6
    sm:pt-8
  "
  />
)}
<section
  class:list={[
    `
      section-container-wide grid items-start gap-6 pt-20
      sm:pt-24
      lg:grid-cols-[minmax(18rem,0.58fr)_minmax(0,1.42fr)] lg:gap-8
      lg:pt-28
      2xl:grid-cols-[minmax(18rem,0.36fr)_minmax(0,1.64fr)] 2xl:gap-10
    `,
    className
  ]}
>
  <slot />
</section>
