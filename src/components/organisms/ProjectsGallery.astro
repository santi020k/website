---
import type { CollectionEntry } from 'astro:content'

import Pill from '@/components/atoms/Pill.astro'
import ProjectGalleryBody from '@/components/molecules/ProjectGalleryBody.astro'

import { getPortfolioPath, getTechnologySlug } from '@/utils/links'
import { getProjectBrandStyle } from '@/utils/project-brand'
import { getProjectCoverForUsage } from '@/utils/project-cover'
import { getProjectPrimaryDestination } from '@/utils/project-destinations'
import { getProjectDateRangeLabel, getProjectStatusLabel } from '@/utils/project-meta'

import { ButtonLink, Card, CoverImage, Icon, Link } from '@santi020k/lumen-astro'

interface Props {
  matchedTechnology?: string
  productFirst?: boolean
  projects: CollectionEntry<'project'>[]
}

const { matchedTechnology, productFirst = false, projects } = Astro.props
const matchedSlug = matchedTechnology ? getTechnologySlug(matchedTechnology) : undefined

const projectItems = projects.map(project => {
  const hasMatch = Boolean(matchedTechnology && project.data.technologies.some(technology => getTechnologySlug(technology) === matchedSlug))

  const technologies = hasMatch && matchedTechnology ?
    [matchedTechnology, ...project.data.technologies.filter(technology => getTechnologySlug(technology) !== matchedSlug)].slice(0, 3) :
    project.data.technologies.slice(0, 3)

  return {
    editorialImage: getProjectCoverForUsage(project.data.coverImage, 'hero'),
    brand: project.data.brand,
    dateRange: getProjectDateRangeLabel(project.data.startingDate, project.data.endingDate),
    cardDescription: project.data.cardDescription ?? project.data.description,
    destination: productFirst ? getProjectPrimaryDestination(project.data) : undefined,
    hasMatch,
    href: getPortfolioPath(project.id),
    status: getProjectStatusLabel(project.data.draft, project.data.endingDate),
    technologies,
    title: project.data.title
  }
})
---

<div class="projects-editorial-grid">
  {projectItems.map((project, index) => (
    <Card as="article" class="projects-editorial-card" variant="unstyled" data-project-gallery-card style={getProjectBrandStyle(project.brand)}>
      <ProjectGalleryBody href={productFirst ? undefined : project.href}>
        <div class="projects-editorial-image">
          {project.editorialImage ?
(
            <CoverImage
              fallbackFormat="webp"
              alt=""
              ariaHidden={true}
              className="size-full rounded-none border-0 object-cover"
              image={project.editorialImage}
              loading="lazy"
              mode="card"
              sizes={index === 0 ? 'auto, (min-width: 80rem) 40rem, (min-width: 1024px) 60vw, 100vw' : 'auto, (min-width: 80rem) 35rem, (min-width: 768px) 50vw, 100vw'}
            />
          ) :
(
            <Icon class="size-16 text-ink-muted" name="code-2" />
          )}
        </div>
        <div class="projects-editorial-copy">
          <div class="projects-editorial-meta">
            <span>{String(index + 1).padStart(2, '0')} / {project.dateRange}</span>
            <Pill label={project.status} tone="outline" />
          </div>
          <h3>{project.title}</h3>
          <p>{project.cardDescription}</p>
          {project.technologies.length > 0 && (
            <ul aria-label={project.hasMatch ? undefined : 'Core technologies'} data-matched-stack={project.hasMatch ? '' : undefined}>
              {project.technologies.map((technology, technologyIndex) => (
                <li data-technology-match={project.hasMatch && technologyIndex === 0 ? '' : undefined}>
                  {project.hasMatch && technologyIndex === 0 && (
<><Icon name="check" size="sm" /><span class="sr-only">Archive match: </span></>
)}
                  <span>{technology}</span>
                </li>
              ))}
            </ul>
          )}
          {productFirst ?
(
            <div data-project-destinations>
              {project.destination && (
                <ButtonLink data-project-visit href={project.destination.href} newTab variant="unstyled">
                  <span>{project.destination.action}</span>
                  <Icon name="arrow-up-right" />
                </ButtonLink>
              )}
              <Link
                aria-label={`Read the case study: ${project.title}`}
                data-project-case-study
                href={project.href}
                variant="inherit"
              >
                <span>Read the case study</span>
                <Icon name="arrow-right" />
              </Link>
            </div>
          ) :
(
            <span class="projects-editorial-action">
              View project
              <Icon class="size-4.5 shrink-0" name="arrow-right" />
            </span>
          )}
        </div>
      </ProjectGalleryBody>
    </Card>
  ))}
</div>

<style>
  [data-project-destinations] { display: grid; gap: 0.75rem; margin-top: auto; }
  [data-project-destinations] :global(a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    min-height: 2.75rem;
    color: hsl(var(--ink-soft));
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.7;
  }
  [data-project-destinations] :global([data-project-visit]) {
    min-height: 3.375rem;
    padding: 1rem 1.125rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.875rem 0.875rem 0.25rem 0.875rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }
  [data-project-destinations] :global(a > span) { min-width: 0; overflow-wrap: anywhere; }
  [data-project-destinations] :global([data-slot='icon']) { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
  [data-project-destinations] :global(a:is(:hover, :focus-visible)) {
    color: color-mix(in srgb, hsl(var(--project-primary-readable)) 80%, hsl(var(--ink)));
  }
  :global([data-product-first]):focus-within h3 { color: hsl(var(--project-primary-readable)); }
  :global([data-theme='dark']) [data-project-destinations] :global(a:is(:hover, :focus-visible)) {
    color: color-mix(in srgb, hsl(var(--project-primary-readable-dark)) 80%, hsl(var(--ink)));
  }
  :global([data-theme='dark'] [data-product-first]):focus-within h3 { color: hsl(var(--project-primary-readable-dark)); }
  [data-project-destinations] :global(a:focus-visible) {
    outline: 2px solid hsl(var(--accent));
    outline-offset: 4px;
    border-radius: 0.875rem;
  }
  [data-project-destinations]:not(:has([data-project-visit])) :global([data-project-case-study]) {
    min-height: 3.375rem;
    border-bottom: 1px solid hsl(var(--line));
    color: hsl(var(--ink));
    font-size: 0.8125rem;
    font-weight: 500;
  }
  @container project-card (width < 14rem) {
    [data-project-destinations] :global([data-project-visit]) { padding-inline: 0.75rem; gap: 0.5rem; }
  }

  [data-matched-stack] { align-items: center; }
  [data-technology-match] {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.375rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--accent));
    font-weight: 500;
  }
  [data-technology-match] :global([data-slot='icon']) { flex-shrink: 0; }
  [data-technology-match] > span:last-child { min-width: 0; overflow-wrap: anywhere; }
  :global([data-theme='dark']) [data-technology-match] { color: hsl(var(--ink)); }
</style>
