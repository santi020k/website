---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getNavigationCurrent } from '@/utils/links'

import { ButtonLink } from '@santi020k/lumen-astro'

import { getLocale, localizePath, sharedTranslator, stripLocale } from '@/i18n'
import { getMenuLinks, siteConfig } from '@/site.config'

import { version } from '../../../package.json'

interface Props {
  variant?: 'compact' | 'default'
}

const { variant = 'default' } = Astro.props
const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)
const year = new Date().getFullYear()
const currentPath = Astro.url.pathname

const navLinks = [
  ...getMenuLinks(locale).map(link => ({
    ...link,
    title: link.path === '/speaking/' ? t('nav.speaking') : link.title
  })),
  { path: siteConfig.contact.workWithMe, title: t('shared.workWithMe') }
].map(link => ({ ...link, path: localizePath(link.path, locale) }))

const resourceLinks = [
  { path: '/history/', title: t('shared.websiteHistory') },
  { path: '/accessibility/', title: t('shared.accessibility') },
  { path: '/privacy/', title: t('shared.privacy') },
  { path: '/terms/', title: t('shared.terms') }
].map(link => ({ path: localizePath(link.path, locale), title: link.title }))

const activePath = [...navLinks, ...resourceLinks]
  .filter(link => getNavigationCurrent(stripLocale(currentPath), stripLocale(link.path)))
  .sort((a, b) => b.path.length - a.path.length)[0]?.path
---

<footer class="maker-footer" data-site-footer data-variant={variant} id="site-footer">
  <div class="maker-footer-shell">
    {variant !== 'compact' && (
      <section class="maker-footer-invitation" aria-labelledby="footer-heading">
        <div class="maker-footer-intro">
          <p class="maker-footer-label"><span class="maker-hero-signal" aria-hidden="true"></span><span>{t('shared.goodThingsStartWithAConversation')}</span></p>
          <h2 id="footer-heading">{t('shared.letSBuild')}<span>{t('shared.somethingUseful')}</span></h2>
          <p class="maker-footer-description">{t('shared.inviteMeToGiveATalk')}</p>
        </div>
        <div class="maker-footer-contact">
          <div class="maker-footer-action-sheet">
            <ButtonLink class="maker-footer-action" href={localizePath(`${siteConfig.contact.workWithMe}#start`, locale)} variant="unstyled">
              <ArrowExchange
direction="up-right"
class="maker-footer-action-arrow"
              />
              <span class="maker-footer-action-copy"><span>{t('shared.letSTalk')}</span><span>{t('shared.pickATopicAndMessageMe')}</span></span>
            </ButtonLink>
          </div>
          <a class="maker-footer-email" href={siteConfig.contact.calendar} rel="noopener noreferrer" target="_blank">
            <span><span>{t('shared.ratherTalkFirst')}</span><span>{t('shared.bookACall')}</span></span><ArrowExchange
class="maker-footer-email-arrow"
direction="up-right"
                                                                                                       />
          </a>
          <a class="maker-footer-email" href={`mailto:${siteConfig.contact.email}`}>
            <span><span>{t('shared.preferEmail')}</span><span>{siteConfig.contact.email}</span></span><ArrowExchange
class="maker-footer-email-arrow"
direction="up-right"
                                                                                                      />
          </a>
        </div>
      </section>
    )}

    <div class="maker-footer-directory">
      <div class="maker-footer-identity">
        <a class="maker-footer-wordmark" href="https://santi020k.com" aria-label="Santiago Molina — santi020k">santi020k<span>.</span></a>
        <p>{t('shared.engineerMakerAlwaysCurious')}</p>
        <p class="maker-footer-location">{siteConfig.location}</p>
        <a class="maker-footer-resume" data-text-link href={localizePath(siteConfig.contact.resume, locale)}><span data-text-link-label>{t('shared.viewResume')}</span><ArrowExchange direction="up-right" /></a>
      </div>

      <nav class="maker-footer-navigation" aria-label={t('shared.footerNavigation')}>
        <p class="maker-footer-label">{t('shared.explore')}</p>
        <ul>
          {navLinks.map(link => (
            <li><a data-text-link href={link.path} aria-current={activePath === link.path ? getNavigationCurrent(stripLocale(currentPath), stripLocale(link.path)) : undefined}><span data-text-link-label>{link.title}</span></a></li>
          ))}
        </ul>
      </nav>

      <nav class="maker-footer-social" aria-label={t('shared.connectWithSantiago')}>
        <p class="maker-footer-label">{t('shared.elsewhere')}</p>
        <ul>
          {siteConfig.socialLinks.map(({ href, indieAuthRelMe, label }) => (
            <li>
              <a data-text-link href={href} target="_blank" rel={`noopener noreferrer${indieAuthRelMe === false ? '' : ' me'}`}>
                <span data-text-link-label>{label}</span><ArrowExchange direction="up-right" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="maker-footer-colophon">
      <p>&copy; {year} {siteConfig.author}<span aria-hidden="true"> / </span><a data-text-link href="https://lumen.santi020k.com" rel="noopener noreferrer" target="_blank"><span data-text-link-label>{t('shared.builtWithLumen')}</span></a></p>
      <nav aria-label={t('shared.siteInformation')}>
        {resourceLinks.map(({ path, title }) => (
          <a data-text-link href={path} aria-current={activePath === path ? getNavigationCurrent(stripLocale(currentPath), stripLocale(path)) : undefined}><span data-text-link-label>{title}</span></a>
        ))}
        <a data-text-link href="https://github.com/santi020k/website/issues/new/choose" rel="noopener noreferrer" target="_blank"><span data-text-link-label>{t('shared.reportAnIssue')}</span></a>
      </nav>
      <a class="maker-footer-version" data-text-link href="https://github.com/santi020k/website" rel="noopener noreferrer" target="_blank" aria-label={`v${version} — Website source`}><span data-text-link-label>v{version}</span><ArrowExchange direction="up-right" /></a>
    </div>
  </div>
</footer>
