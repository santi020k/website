---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getNavigationCurrent } from '@/utils/links'

import { ButtonLink } from '@santi020k/lumen-astro'

import { menuLinks, siteConfig } from '@/site.config'

import { version } from '../../../package.json'

interface Props {
  variant?: 'compact' | 'default'
}

const { variant = 'default' } = Astro.props
const year = new Date().getFullYear()
const currentPath = Astro.url.pathname

const navLinks = [
  ...menuLinks.map(link => ({
    ...link,
    title: link.path === '/speaking/' ? 'Speaking' : link.title
  })),
  { path: siteConfig.contact.workWithMe, title: 'Work with me' }
]

const resourceLinks = [
  { path: '/history/', title: 'Website history' },
  { path: '/accessibility/', title: 'Accessibility' },
  { path: '/privacy/', title: 'Privacy' },
  { path: '/terms/', title: 'Terms' }
]

const activePath = [...navLinks, ...resourceLinks]
  .filter(link => getNavigationCurrent(currentPath, link.path))
  .sort((a, b) => b.path.length - a.path.length)[0]?.path
---

<footer class="maker-footer" data-site-footer data-variant={variant} id="site-footer">
  <div class="maker-footer-shell">
    {variant !== 'compact' && (
      <section class="maker-footer-invitation" aria-labelledby="footer-heading">
        <div class="maker-footer-intro">
          <p class="maker-footer-label"><span class="maker-hero-signal" aria-hidden="true"></span><span>Good things start with a conversation</span></p>
          <h2 id="footer-heading">Let’s build <span>something useful.</span></h2>
          <p class="maker-footer-description">Invite me to give a talk, tell me about an engineering role, or let’s grow your team with better code quality and practical AI.</p>
        </div>
        <div class="maker-footer-contact">
          <div class="maker-footer-action-sheet">
            <ButtonLink class="maker-footer-action" href={`${siteConfig.contact.workWithMe}#start`} variant="unstyled">
              <ArrowExchange
direction="up-right"
class="maker-footer-action-arrow"
              />
              <span class="maker-footer-action-copy"><span>Let’s talk</span><span>Pick a topic and message me on WhatsApp</span></span>
            </ButtonLink>
          </div>
          <a class="maker-footer-email" href={siteConfig.contact.calendar} rel="noopener noreferrer" target="_blank">
            <span><span>Rather talk first?</span><span>Book a call</span></span><ArrowExchange
class="maker-footer-email-arrow"
direction="up-right"
                                                                                />
          </a>
          <a class="maker-footer-email" href={`mailto:${siteConfig.contact.email}`}>
            <span><span>Prefer email?</span><span>{siteConfig.contact.email}</span></span><ArrowExchange
class="maker-footer-email-arrow"
direction="up-right"
                                                                                          />
          </a>
        </div>
      </section>
    )}

    <div class="maker-footer-directory">
      <div class="maker-footer-identity">
        <a class="maker-footer-wordmark" href="https://santi020k.com" aria-label="Santiago Molina — santi020k">santi020k<span>.</span></a>
        <p>Engineer. Maker. Always curious.</p>
        <p class="maker-footer-location">{siteConfig.location}</p>
        <a class="maker-footer-resume" data-text-link href={siteConfig.contact.resume}><span data-text-link-label>View resume</span><ArrowExchange direction="up-right" /></a>
      </div>

      <nav class="maker-footer-navigation" aria-label="Footer navigation">
        <p class="maker-footer-label">Explore</p>
        <ul>
          {navLinks.map(link => (
            <li><a data-text-link href={link.path} aria-current={activePath === link.path ? getNavigationCurrent(currentPath, link.path) : undefined}><span data-text-link-label>{link.title}</span></a></li>
          ))}
        </ul>
      </nav>

      <nav class="maker-footer-social" aria-label="Connect with Santiago">
        <p class="maker-footer-label">Elsewhere</p>
        <ul>
          {siteConfig.socialLinks.map(({ href, indieAuthRelMe, label }) => (
            <li>
              <a data-text-link href={href} target="_blank" rel={`noopener noreferrer${indieAuthRelMe === false ? '' : ' me'}`}>
                <span data-text-link-label>{label}</span><ArrowExchange direction="up-right" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="maker-footer-colophon">
      <p>&copy; {year} {siteConfig.author}<span aria-hidden="true"> / </span><a data-text-link href="https://lumen.santi020k.com" rel="noopener noreferrer" target="_blank"><span data-text-link-label>Built with Lumen</span></a></p>
      <nav aria-label="Site information">
        {resourceLinks.map(({ path, title }) => (
          <a data-text-link href={path} aria-current={activePath === path ? getNavigationCurrent(currentPath, path) : undefined}><span data-text-link-label>{title}</span></a>
        ))}
        <a data-text-link href="https://github.com/santi020k/website/issues/new/choose" rel="noopener noreferrer" target="_blank"><span data-text-link-label>Report an issue</span></a>
      </nav>
      <a class="maker-footer-version" data-text-link href="https://github.com/santi020k/website" rel="noopener noreferrer" target="_blank" aria-label={`v${version} — Website source`}><span data-text-link-label>v{version}</span><ArrowExchange direction="up-right" /></a>
    </div>
  </div>
</footer>
