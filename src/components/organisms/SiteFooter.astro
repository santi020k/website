---
import { version } from '../../../package.json'
import ContactSection from '../../components/molecules/ContactSection.astro'
import NewsletterBox from '../../components/molecules/NewsletterBox.astro'
import { siteConfig } from '../../site.config'

const year = new Date().getFullYear()
---

<footer class="
  px-4 pt-20 pb-10
  sm:px-6
  lg:px-8
"
>
  <div class="mx-auto w-full max-w-6xl space-y-20">
    <ContactSection />

    <NewsletterBox />

    <div class="
      grid gap-8 border-t border-line pt-10
      md:grid-cols-[2fr_1fr]
    "
    >
      <div class="space-y-4">
        <h3 class="text-xl font-bold">{siteConfig.author}</h3>
        <p class="max-w-md text-sm/6 text-ink-soft">
          Engineering leader and full-stack architect specializing in resilient systems,
          technical leadership, and developer experience.
        </p>
      </div>

      <div class="
        space-y-6
        md:text-right
      "
      >
        <div class="space-y-2 text-sm text-ink-muted">
          <p>{siteConfig.location}</p>
          <p>{siteConfig.availability}</p>
          <p>&copy; {year} {siteConfig.author}. Version v{version}.</p>
        </div>
      </div>
    </div>
  </div>
</footer>
