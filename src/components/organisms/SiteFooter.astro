---
import { Icon } from 'astro-icon/components'

import AnimatedLogo from '@/components/atoms/AnimatedLogo.astro'
import ContactSection from '@/components/molecules/ContactSection.astro'
import NewsletterSignup from '@/components/molecules/NewsletterSignup.astro'

import { menuLinks, siteConfig } from '@/site.config'

import { version } from '../../../package.json'

const year = new Date().getFullYear()

const navLinks = [...menuLinks]

const resourceLinks = [
  { icon: 'tabler:calendar-month', path: '/blog/content-calendar/', title: 'Content Calendar' },
  { icon: 'tabler:rss', path: '/feed.xml', title: 'RSS Feed' },
  { icon: 'tabler:sitemap', path: '/sitemap.xml', title: 'Sitemap' }
]

const currentPath = Astro.url.pathname
const isAvailable = siteConfig.availability.toLowerCase().startsWith('open')

const connectLinks = [
  ...siteConfig.socialLinks.map(({ href, icon, indieAuthRelMe, label }) => ({
    href,
    icon,
    label,
    rel: `noreferrer noopener${indieAuthRelMe === false ? '' : ' me'}`
  })),
  { href: siteConfig.contact.resume, icon: 'tabler:file-text', label: 'Resume', rel: 'noreferrer noopener' }
]

const policyLinks = [
  { href: '/accessibility/', icon: 'tabler:accessible', label: 'Accessibility' },
  { href: '/privacy/', icon: 'tabler:shield-lock', label: 'Privacy & analytics' }
]

const footerMeta = [
  { icon: 'tabler:map-pin', label: 'Location', value: siteConfig.location },
  { icon: 'tabler:briefcase-2', label: 'Availability', value: siteConfig.availability }
]

const isLinkActive = (linkPath: string): boolean => {
  if (linkPath === '/') return currentPath === '/'

  const allLinks = [...navLinks, ...resourceLinks]

  const bestMatch = allLinks
    .filter(l => l.path !== '/' && currentPath.startsWith(l.path))
    .sort((a, b) => b.path.length - a.path.length)[0]

  return bestMatch?.path === linkPath
}
---

<footer class="
  relative mt-12 overflow-hidden px-4 pb-12
  sm:mt-14 sm:px-6 sm:pb-14
  lg:mt-16 lg:px-8 lg:pb-16
"
>
  <!-- Top ambient glow with floating animation -->
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute top-0 left-1/2 h-96 w-[80%] max-w-3xl
      -translate-x-1/2 rounded-full opacity-25 blur-3xl
      motion-safe:animate-float-y-slow
      motion-reduce:animate-none
    "
    style="background: radial-gradient(ellipse at center, hsl(var(--brand) / 0.08), transparent 70%);"
  />

  <!-- Subtle radial glow behind footer content with pulse -->
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute top-[10%] left-1/2 h-80 w-[70%] max-w-3xl
      -translate-x-1/2 rounded-full opacity-20 blur-3xl
      motion-safe:animate-pulse-slow
      motion-reduce:animate-none
    "
    style="background: radial-gradient(ellipse at center, hsl(var(--accent) / 0.1), transparent 70%);"
  />

  <!-- Subtle grid texture in background -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 grid-fade opacity-40"
  />

  <div class="section-container-wide relative">
    <!-- Morphing organic blob behind content -->
    <div
      aria-hidden="true"
      class="
        pointer-events-none absolute top-1/2 left-1/2 z-0 size-96 -translate-1/2
        opacity-25 blur-3xl
        motion-safe:animate-morph
        motion-reduce:animate-none
        sm:size-112
      "
      style="background: linear-gradient(135deg, hsl(var(--brand) / 0.12), hsl(var(--accent) / 0.08), hsl(var(--glow) / 0.05));"
    />

    <!-- Unified Contact & Newsletter Section -->
    <section
      class="
        relative z-10 mt-8 grid gap-8 pt-10 pb-8
        before:pointer-events-none before:absolute before:inset-y-0
        before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2
        before:bg-surface-muted/10
        sm:mt-10 sm:pt-12 sm:pb-9
        lg:mt-14 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:gap-12 lg:pb-8
      "
    >
      <!-- Left: copy -->
      <div class="space-y-3 lg:pt-3">
        <div class="flex flex-wrap items-center gap-3">
          <p class="section-label text-brand dark:text-accent">Get in touch</p>
          {isAvailable && (
            <span class="
              inline-flex items-center gap-1.5 rounded-full border
              border-success/25 bg-success/8 px-2.5 py-0.5 text-xs font-medium
              text-success
            "
            >
              <span class="relative flex size-1.5 shrink-0">
                <span class="
                  absolute inline-flex size-full animate-ping rounded-full
                  bg-success/75 opacity-75
                  motion-reduce:animate-none
                "
                />
                <span class="
                  relative inline-flex size-1.5 rounded-full bg-success
                "
                />
              </span>
              Available
            </span>
          )}
        </div>

        <h2 class="
          text-2xl font-semibold tracking-tight
          sm:text-3xl
        "
        >
          Let's build something{' '}
          <span
            class="
              bg-linear-to-r from-brand via-accent to-brand bg-clip-text
              text-transparent
              motion-safe:animate-shimmer
            "
            style="background-size: 200% 100%;"
          >
            useful
          </span>{' '}
          together.
        </h2>

        <p class="max-w-md text-sm text-ink-soft">
          Have a project in mind or want to compare notes on engineering?
          Pick a channel below and I'll get back to you quickly.
        </p>
      </div>

      <!-- Right: contact + newsletter -->
      <div class="grid gap-5">
        <ContactSection compact />
        {siteConfig.newsletter?.formAction && (
          <NewsletterSignup formAction={siteConfig.newsletter.formAction} label="Newsletter signup (footer)" variant="compact" />
        )}
      </div>
    </section>

    <section
      class="
        relative z-10 pt-8 pb-10
        before:pointer-events-none before:absolute before:inset-y-0
        before:left-1/2 before:-z-10 before:w-screen before:-translate-x-1/2
        before:bg-surface-muted/25
        sm:pt-9 sm:pb-12
      "
      aria-label="Footer directory"
    >
      <div
        class="
          grid gap-8
          md:grid-cols-[minmax(0,1.1fr)_minmax(0,1.45fr)]
          lg:gap-12
        "
      >
        <div class="flex flex-col justify-between gap-7">
          <div class="space-y-5">
            <a
              aria-label="Santiago Molina home"
              class="
                inline-flex transition duration-200
                hover:opacity-80
                motion-reduce:transition-none
              "
              href="/"
            >
              <span class="
                h-8 w-auto
                dark:hidden
              "
              >
                <AnimatedLogo variant="light" class="h-full w-auto" />
              </span>
              <span class="
                hidden h-8 w-auto
                dark:block
              "
              >
                <AnimatedLogo variant="dark" class="h-full w-auto" />
              </span>
            </a>

            <p class="max-w-sm text-sm/6 text-ink-soft">
              Engineering leader and full-stack architect building resilient systems, useful tools, and steady developer teams.
            </p>
          </div>

          <dl class="grid gap-3 text-sm">
            {footerMeta.map(({ icon, label, value }) => {
              const availabilityItem = label === 'Availability'

              return (
                <div
                  class="
                    grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 rounded-2xl
                    border border-line/45 bg-surface/35 px-3.5 py-3
                  "
                >
                  <Icon
                    aria-hidden="true"
                    class:list={[
                      'mt-0.5 size-4 shrink-0',
                      availabilityItem && isAvailable ? 'text-success' : 'text-brand'
                    ]}
                    name={icon}
                  />
                  <dt class="section-label text-[0.65rem]">{label}</dt>
                  <dd
                    class:list={[
                      'col-start-2 mt-0.5 text-sm/5',
                      availabilityItem && isAvailable ? 'text-success' : 'text-ink-soft'
                    ]}
                  >
                    {value}
                  </dd>
                </div>
              )
            })}
          </dl>
        </div>

        <div
          class="
            grid gap-8
            md:pl-8
            lg:grid-cols-3 lg:gap-8 lg:pl-12
          "
        >
          <nav aria-label="Footer navigation">
            <p class="mb-4 section-label">Navigate</p>
            <ul class="grid gap-1.5">
              {navLinks.map(link => {
                const active = isLinkActive(link.path)

                return (
                  <li>
                    <a
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        `
                          group flex min-h-9 items-center gap-2 rounded-xl px-2.5
                          text-sm/6 transition-[background-color,color,transform]
                          duration-200
                          hover:bg-brand/8 hover:text-ink
                          motion-safe:hover:translate-x-0.5
                          motion-reduce:transition-none
                          motion-reduce:hover:translate-x-0
                        `,
                        active ?
                          'bg-brand/10 font-semibold text-brand' :
                          'text-ink-soft'
                      ]}
                      href={link.path}
                    >
                      <Icon
                        aria-hidden="true"
                        class:list={[
                          'size-4 shrink-0 transition-colors duration-200 motion-reduce:transition-none',
                          active ? 'text-brand' : 'text-ink-muted group-hover:text-brand'
                        ]}
                        name={link.icon}
                      />
                      {link.title}
                    </a>
                  </li>
                )
              })}
            </ul>
          </nav>

          <div>
            <p class="mb-4 section-label">Connect</p>
            <ul class="grid gap-1.5">
              {connectLinks.map(({ href, icon, label, rel }) => (
                <li>
                  <a
                    class="
                      group flex min-h-9 items-center gap-2 rounded-xl px-2.5
                      text-sm/6 text-ink-soft
                      transition-[background-color,color,transform] duration-200
                      hover:bg-brand/8 hover:text-ink
                      motion-safe:hover:translate-x-0.5
                      motion-reduce:transition-none
                      motion-reduce:hover:translate-x-0
                    "
                    href={href}
                    rel={rel}
                    target={href.startsWith('http') ? '_blank' : undefined}
                  >
                    <Icon
                      aria-hidden="true"
                      class="
                        size-4 shrink-0 text-ink-muted transition-colors duration-200
                        group-hover:text-brand
                        motion-reduce:transition-none
                      "
                      name={icon}
                    />
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="mb-4 section-label">Resources</p>
            <ul class="grid gap-1.5">
              {resourceLinks.map(({ icon, path, title }) => {
                const active = isLinkActive(path)

                return (
                  <li>
                    <a
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        `
                          group flex min-h-9 items-center gap-2 rounded-xl px-2.5
                          text-sm/6 transition-[background-color,color,transform]
                          duration-200
                          hover:bg-brand/8 hover:text-ink
                          motion-safe:hover:translate-x-0.5
                          motion-reduce:transition-none
                          motion-reduce:hover:translate-x-0
                        `,
                        active ?
                          'bg-brand/10 font-semibold text-brand' :
                          'text-ink-soft'
                      ]}
                      href={path}
                    >
                      <Icon
                        aria-hidden="true"
                        class:list={[
                          'size-4 shrink-0 transition-colors duration-200 motion-reduce:transition-none',
                          active ? 'text-brand' : 'text-ink-muted group-hover:text-brand'
                        ]}
                        name={icon}
                      />
                      {title}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom bar -->
    <div
      class="
        mt-5 flex flex-col gap-3 px-1 text-xs text-ink-muted
        opacity-100
        sm:mt-6
        sm:flex-row sm:items-center sm:justify-between
      "
    >
      <p>&copy; {year} {siteConfig.author}.</p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {policyLinks.map(({ href, icon, label }) => (
          <a
            class="
              inline-flex items-center gap-1.5 text-ink-muted transition-colors
              hover:text-brand
              motion-reduce:transition-none
            "
            href={href}
          >
            <Icon aria-hidden="true" class="size-3 shrink-0" name={icon} />
            {label}
          </a>
        ))}

        <a
          class="
            inline-flex items-center gap-1 rounded-full border border-line/60
            bg-surface-muted/60 px-2 py-0.5 font-medium text-ink-muted
            transition-colors
            hover:border-brand/40 hover:text-brand
            motion-reduce:transition-none
          "
          href="https://github.com/santi020k/website"
          rel="noreferrer noopener"
          target="_blank"
        >
          <Icon aria-hidden="true" class="size-3" name="tabler:brand-github" />
          v{version}
        </a>
      </div>
    </div>

  </div>
</footer>
