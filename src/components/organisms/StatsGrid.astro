---
import GradientDivider from '@/components/atoms/GradientDivider.astro'

interface Props {
  columns?: 3 | 4
  showDivider?: boolean
}

const { columns = 4, showDivider = true } = Astro.props
---

{showDivider && (
  <GradientDivider class="
    pt-6
    sm:pt-8
  "
  />
)}
<section
  class:list={[
    `
      relative section-container-wide grid grid-cols-1 gap-5
      sm:card-grid-2
    `,
    showDivider ? 'pt-8' : '',
    columns === 3 ? 'xl:card-grid-3' : 'xl:card-grid-4'
  ]}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-30"
    style="background: radial-gradient(ellipse at top, transparent 0%, hsl(var(--brand) / 0.04) 32%, transparent 72%);"
  />
  <slot />
</section>
