---
import GradientDivider from '@/components/atoms/GradientDivider.astro'

interface Props {
  columns?: 3 | 4
  showDivider?: boolean
}

const { columns = 4, showDivider = true } = Astro.props
---

{showDivider && (
  <GradientDivider class="
    pt-6
    sm:pt-8
  "
  />
)}
<section
  class:list={[
    `
      relative section-container-wide grid gap-5
      sm:grid-cols-2
    `,
    showDivider ? 'pt-8' : '',
    columns === 3 ? 'xl:grid-cols-3' : 'xl:grid-cols-4'
  ]}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-30"
    style="background: radial-gradient(ellipse at top, hsl(var(--brand)/0.04), transparent 70%);"
  />
  <slot />
</section>
