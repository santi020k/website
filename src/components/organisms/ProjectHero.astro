---
import type { CollectionEntry } from 'astro:content'

import { getTechnologyPath } from '@/utils/links'

import {
  getProjectDateRangeLabel,
  getProjectDurationLabel,
  getProjectTimelineLabel,
  getProjectTypeLabel
} from '../../utils/project-meta'
import { sortTechnologiesByInterest } from '../../utils/technologies'
import ButtonLink from '../atoms/ButtonLink.astro'
import CoverImage from '../atoms/CoverImage.astro'
import Eyebrow from '../atoms/Eyebrow.astro'
import GradientDivider from '../atoms/GradientDivider.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  parentPage?: { name: string, url: string }
  project: CollectionEntry<'project'>
}

const { parentPage = { name: 'Portfolio', url: '/portfolio/' }, project } = Astro.props
const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const timelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const durationLabel = getProjectDurationLabel(project.data.startingDate, project.data.endingDate)
const dateRangeLabel = getProjectDateRangeLabel(project.data.startingDate, project.data.endingDate)
const technologies = sortTechnologiesByInterest(project.data.technologies)

const titleWords = project.data.title.split(' ')
const gradientWord = titleWords.length > 1 ? titleWords[titleWords.length - 1] : project.data.title
const plainWords = titleWords.length > 1 ? titleWords.slice(0, -1).join(' ') : ''

const metaItems = [
  { label: 'Role', value: project.data.role ?? 'Hands-on builder' },
  { label: 'Timeline', value: timelineLabel },
  { label: 'Duration', value: durationLabel },
]
---

<section class="relative space-y-10">
  {/* ── Eyebrow + breadcrumb ─────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-3
      motion-reduce:animate-none
    "
  >
    <Eyebrow label={projectTypeLabel} tone="brand" />
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm font-medium text-ink-muted">
      <a
        href={parentPage.url}
        class="transition-colors hover:text-brand motion-reduce:transition-none"
      >{parentPage.name}
      </a>
      <span aria-hidden="true" class="text-line">/</span>
      <span class="text-ink-soft">{projectTypeLabel}</span>
    </nav>
  </div>

  {/* ── Title + description ──────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-4 [animation-delay:80ms]
      motion-reduce:animate-none
    "
  >
    <h1 class="
      max-w-4xl text-4xl/[0.98] font-bold tracking-[-0.05em] wrap-break-word
      sm:text-5xl/[0.96]
      lg:text-[3.6rem]/[0.94]
    "
    >
      {plainWords && <span>{plainWords} </span>}
      <span class="bg-linear-to-r from-brand via-accent to-brand bg-clip-text text-transparent">
        {gradientWord}
      </span>
    </h1>
    <p class="max-w-2xl text-base/7 text-ink-soft sm:text-lg/8">
      {project.data.description}
    </p>
  </div>

  {/* ── Meta row — flat, inline ──────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:160ms]
      motion-reduce:animate-none
    "
  >
    <GradientDivider class="mb-6" />
    <dl class="flex flex-wrap gap-x-8 gap-y-4">
      {metaItems.map(item => (
        <div>
          <dt class="section-label">{item.label}</dt>
          <dd class="mt-1 text-sm/6 font-semibold text-ink">{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  {/* ── CTAs ────────────────────────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:240ms]
      motion-reduce:animate-none
    "
  >
    <div class="section-actions">
      {project.data.liveDemoUrl && (
        <ButtonLink href={project.data.liveDemoUrl} newTab showArrow>
          View live project
        </ButtonLink>
      )}
      {project.data.githubUrl && (
        <ButtonLink href={project.data.githubUrl} newTab showArrow variant="secondary">
          Open repository
        </ButtonLink>
      )}
      <ButtonLink href={parentPage.url} showArrow variant="ghost">
        Browse {parentPage.name.toLowerCase()}
      </ButtonLink>
    </div>
  </div>

  {/* ── Full-width cover ─────────────────────────────────────── */}
  {project.data.coverImage && (
    <div
      class="
        animate-slide-up [animation-delay:300ms]
        motion-reduce:animate-none
      "
    >
      <div class="relative overflow-hidden rounded-2xl">
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-x-0 bottom-0 z-10 h-32
            bg-linear-to-t from-black/50 via-black/10 to-transparent
          "
        />
        <CoverImage
          alt={project.data.coverImage.alt}
          ariaHidden={true}
          className="w-full"
          fetchpriority="high"
          image={project.data.coverImage.src}
          loading="eager"
          sizes="(min-width: 1280px) 1200px, 100vw"
          mode="detail"
        />
        <div
          aria-hidden="true"
          class="
            pointer-events-none absolute inset-x-0 bottom-0 z-20 flex
            items-end justify-between gap-4 px-6 py-5
          "
        >
          <p class="text-xs font-semibold tracking-[0.18em] uppercase text-white/60">
            {dateRangeLabel}
          </p>
          <p class="text-xs font-semibold tracking-[0.18em] uppercase text-white/60">
            {projectTypeLabel}
          </p>
        </div>
      </div>
    </div>
  )}

  {/* ── Technologies strip ───────────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:360ms]
      motion-reduce:animate-none
    "
  >
    <GradientDivider class="mb-6" />
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <span class="section-label">Stack</span>
      <span class="text-xs font-bold tabular-nums text-brand">
        {technologies.length}
      </span>
      <span aria-hidden="true" class="h-px w-4 shrink-0 bg-line/50" />
      <div class="flex flex-wrap gap-2" id="technologies">
        {technologies.map(technology => (
          <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
        ))}
      </div>
    </div>
  </div>
</section>
