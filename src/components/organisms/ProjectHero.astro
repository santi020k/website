---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import { getTechnologyPath } from '@/utils/links'

import {
  getProjectDateRangeLabel,
  getProjectDurationLabel,
  getProjectFocusLabel,
  getProjectScopeHighlights,
  getProjectTimelineLabel,
  getProjectTypeLabel
} from '../../utils/project-meta'
import { sortTechnologiesByInterest } from '../../utils/technologies'
import ButtonLink from '../atoms/ButtonLink.astro'
import CoverImage from '../atoms/CoverImage.astro'
import Eyebrow from '../atoms/Eyebrow.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  project: CollectionEntry<'project'>
}

const { project } = Astro.props
const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const focusLabel = getProjectFocusLabel(project.data.typesId)
const scopeHighlights = getProjectScopeHighlights(project.data.typesId)
const timelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const durationLabel = getProjectDurationLabel(project.data.startingDate, project.data.endingDate)
const dateRangeLabel = getProjectDateRangeLabel(project.data.startingDate, project.data.endingDate)
const technologies = sortTechnologiesByInterest(project.data.technologies)

const coverAspectRatio = project.data.coverImage?.src ?
  project.data.coverImage.src.width / project.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08

const projectStats = [
  {
    icon: 'tabler:user-star',
    label: 'Role',
    value: project.data.rol ?? 'Hands-on builder'
  },
  {
    icon: 'tabler:calendar-time',
    label: 'Timeline',
    value: timelineLabel
  },
  {
    icon: 'tabler:hourglass',
    label: 'Duration',
    value: durationLabel
  },
  {
    icon: 'tabler:stack-2',
    label: 'Stack',
    value: `${technologies.length} technologies`
  }
]
---

<section
  class="section-shell relative space-y-10"
  data-animate
>
  <div
    aria-hidden="true"
    class="brand-radial-glow"
  >
  </div>

  <div class="
    relative grid gap-10
    xl:grid-cols-[minmax(0,1.04fr)_18rem]
  "
  >
    <div class="space-y-8">
      <div class="flex items-center gap-2 text-sm font-medium text-ink-muted">
        <a
          href="/portfolio/"
          class="
            transition-colors
            hover:text-brand
          "
        >Portfolio
        </a>
        <Icon aria-hidden="true" class="size-4" name="tabler:chevron-right" />
        <span class="text-ink-soft">Case study</span>
      </div>

      <div class="space-y-5">
        <div class="
          flex flex-wrap items-center gap-3
          sm:gap-4
        "
        >
          <Eyebrow label={projectTypeLabel} tone="brand" />
          <span class="
            text-xs font-semibold tracking-[0.18em] text-ink-muted uppercase
          "
          >{dateRangeLabel}
          </span>
        </div>

        <div class="space-y-4">
          <h1 class="
            max-w-4xl text-4xl/tight
            sm:text-5xl/tight
            lg:text-6xl/tight
          "
          >{project.data.title}
          </h1>
          <p class="
            max-w-3xl text-lg/8 text-ink-soft
            sm:text-xl/8
          "
          >{project.data.description}
          </p>
        </div>
      </div>

      <div class="
        grid gap-3
        sm:grid-cols-[repeat(auto-fit,minmax(14rem,1fr))]
      "
      >
        {projectStats.map(stat => (
          <div class="
            flex mini-note h-full gap-3
            sm:min-h-32
          "
          >
            <div class="
              mt-0.5 flex size-10 shrink-0 items-center justify-center
              rounded-full bg-brand-soft text-brand
            "
            >
              <Icon aria-hidden="true" class="size-5" name={stat.icon} />
            </div>
            <div class="min-w-0">
              <p class="section-label">{stat.label}</p>
              <p class="
                mt-2 text-sm/6 font-semibold text-ink
                sm:text-base/7
              "
              >{stat.value}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="section-actions">
        {project.data.liveDemoUrl && (
          <ButtonLink href={project.data.liveDemoUrl} newTab showArrow>
            View live project
          </ButtonLink>
        )}
        {project.data.githubUrl && (
          <ButtonLink href={project.data.githubUrl} newTab showArrow variant="secondary">
            Open repository
          </ButtonLink>
        )}
        <ButtonLink href="/portfolio/" showArrow variant="ghost">
          Browse all case studies
        </ButtonLink>
      </div>

      <div class="space-y-4">
        <div class="flex items-center gap-3 text-sm font-medium text-ink-muted">
          <span class="section-label">Technologies</span>
          <span
            aria-hidden="true"
            class="
              h-px flex-1 bg-linear-to-r from-line via-line/60 to-transparent
            "
          />
        </div>
        <div class="flex flex-wrap gap-2" id="technologies">
          {technologies.map(technology => (
            <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
          ))}
        </div>
      </div>
    </div>

    <aside class="space-y-4">
      <div class="mini-note">
        <p class="section-label">Project frame</p>
        <p class="mt-3 text-sm/6 text-ink-soft">{focusLabel}</p>
      </div>

      <div class="mini-note">
        <p class="section-label">What shaped the work</p>
        <ul class="mt-4 space-y-3">
          {scopeHighlights.map(item => (
            <li class="flex gap-3 text-sm/6 text-ink-soft">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-brand"/>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

  {project.data.coverImage && (
    <div class="space-y-4">
      <div class:list={[
        'panel-card relative overflow-hidden',
        !useWideCoverFrame && 'mx-auto w-full max-w-4xl'
      ]}
      >
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40
              bg-linear-to-t from-canvas/80 via-canvas/15 to-transparent
            "
          >
          </div>
        )}
        <CoverImage
          alt={project.data.coverImage.alt}
          fetchpriority="high"
          image={project.data.coverImage.src}
          loading="eager"
          sizes="(min-width: 1024px) 1200px, 100vw"
          mode="detail"
        />
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-20 flex
              flex-wrap items-end justify-between gap-4 p-5
              sm:p-6
            "
          >
            <div>
              <p class="section-label text-white/70">Project snapshot</p>
              <p class="
                mt-2 text-lg font-semibold tracking-[-0.03em] text-white
                sm:text-xl
              "
              >{project.data.title} · {project.data.rol ?? projectTypeLabel}
              </p>
            </div>
            <p class="max-w-md text-sm/6 text-white/78">{focusLabel}</p>
          </div>
        )}
      </div>

      {!useWideCoverFrame && (
        <div class="
          grid gap-4
          lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]
        "
        >
          <div class="mini-note">
            <p class="section-label">Project snapshot</p>
            <p class="mt-3 text-lg font-semibold tracking-[-0.03em] text-ink">
              {project.data.title} · {project.data.rol ?? projectTypeLabel}
            </p>
          </div>
          <div class="mini-note">
            <p class="section-label">Why this shape</p>
            <p class="mt-3 text-sm/6 text-ink-soft">{focusLabel}</p>
          </div>
        </div>
      )}
    </div>
  )}
</section>
