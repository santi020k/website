---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import GradientDivider from '@/components/atoms/GradientDivider.astro'
import ProjectHeroCover from '@/components/molecules/ProjectHeroCover.astro'
import ProjectHeroStack from '@/components/molecules/ProjectHeroStack.astro'

import {
  getProjectDurationLabel,
  getProjectTimelineLabel,
  getProjectTypeLabel
} from '@/utils/project-meta'

interface Props {
  parentPage?: { name: string, url: string }
  project: CollectionEntry<'project'>
}

const { parentPage = { name: 'Portfolio', url: '/portfolio/' }, project } = Astro.props
const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const timelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const durationLabel = getProjectDurationLabel(project.data.startingDate, project.data.endingDate)
const titleWords = project.data.title.split(' ')
const gradientWord = titleWords.length > 1 ? titleWords[titleWords.length - 1] : project.data.title
const plainWords = titleWords.length > 1 ? titleWords.slice(0, -1).join(' ') : ''
const startIso = project.data.startingDate.toISOString().slice(0, 7)
const endIso = project.data.endingDate?.toISOString().slice(0, 7)

const metaItems = [
  { label: 'Role', value: project.data.role ?? 'Hands-on builder', datetime: undefined as string | undefined },
  { label: 'Timeline', value: timelineLabel, datetime: endIso ? `${startIso}/${endIso}` : startIso },
  { label: 'Duration', value: durationLabel, datetime: undefined as string | undefined }
]
---

<section class="relative space-y-12">
  {/* ── Eyebrow + breadcrumb ─────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-4
      motion-reduce:animate-none
    "
  >
    <div class="
      flex min-w-0 flex-col items-start gap-3
      sm:flex-row sm:items-center sm:justify-between
    "
    >
      <Eyebrow label={projectTypeLabel} tone="brand" />
      <nav
        aria-label="Breadcrumb"
        class="
          flex max-w-full flex-wrap items-center gap-x-1.5 gap-y-1
          text-sm font-medium text-ink-muted
        "
      >
        <a
          href={parentPage.url}
          class="
            whitespace-nowrap transition-colors
            hover:text-brand
            motion-reduce:transition-none
          "
        >{parentPage.name}
        </a>
        <span aria-hidden="true" class="text-line">/</span>
        <span aria-current="page" class="min-w-0 text-ink-soft">{projectTypeLabel}</span>
      </nav>
    </div>
  </div>

  {/* ── Title + description ──────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-6 [animation-delay:80ms]
      motion-reduce:animate-none
    "
  >
    <div class="relative">
      <h1 class="
        max-w-4xl text-4xl/[0.98] font-bold tracking-tighter wrap-break-word
        sm:text-5xl/[0.96]
        lg:text-[3.6rem]/[0.94]
      "
      >
        {plainWords && <span>{plainWords} </span>}
        <span class="
          relative bg-linear-to-r from-brand via-accent to-brand bg-clip-text
          text-transparent
        "
        >
          {gradientWord}
          <span class="
            absolute inset-0 -z-10 bg-linear-to-r from-brand via-accent to-brand
            bg-clip-text text-transparent opacity-50 blur-sm
          "
          >
          </span>
        </span>
      </h1>
      <div class="
        absolute -inset-x-4 -inset-y-2 -z-10 rounded-3xl bg-linear-to-br
        from-brand/5 to-transparent blur-3xl
      "
      >
      </div>
    </div>
    <p class="
      max-w-3xl text-lg/7 font-medium text-ink-soft
      sm:text-xl/8
    "
    >
      {project.data.description}
    </p>
  </div>

  {/* ── Meta row — enhanced cards ──────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:160ms]
      motion-reduce:animate-none
    "
  >
    <GradientDivider class="mb-8" />
    <dl class="
      grid grid-cols-1 gap-4
      sm:grid-cols-3
    "
    >
      {metaItems.map((item, index) => (
        <div
          class="
            relative overflow-hidden rounded-2xl border border-line/30
            bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300
            hover:-translate-y-1 hover:border-brand/40 hover:bg-brand-soft/10
            hover:shadow-lg hover:shadow-brand/5
          "
          style={`animation-delay: ${160 + (index * 40)}ms`}
        >
          <div class="space-y-2">
            <dt class="
              section-label text-xs font-semibold tracking-wider
              text-ink-muted/80 uppercase
            "
            >
              {item.label}
            </dt>
            <dd class="
              text-lg/6 font-bold text-ink
              sm:text-xl/6
            "
            >
              {item.datetime ?
                <time datetime={item.datetime}>{item.value}</time> :
                item.value}
            </dd>
          </div>
          <div class="
            absolute inset-0 bg-linear-to-br from-brand/5 to-transparent
            opacity-0 transition-opacity duration-300
            hover:opacity-100
          "
          >
          </div>
        </div>
      ))}
    </dl>
  </div>

  {/* ── CTAs ────────────────────────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:240ms]
      motion-reduce:animate-none
    "
  >
    <div class="section-actions">
      {project.data.liveDemoUrl && (
        <ButtonLink href={project.data.liveDemoUrl} newTab showArrow>
          View live project
        </ButtonLink>
      )}
      {project.data.githubUrl && (
        <ButtonLink
          href={project.data.githubUrl}
          newTab
          showArrow
          variant="secondary"
          className="group"
        >
          <span class="flex items-center gap-2">
            <Icon
              aria-hidden="true"
              class="
                size-4 transition-transform
                group-hover:translate-x-1
              "
              name="tabler:brand-github"
            />
            Open repository
          </span>
        </ButtonLink>
      )}
      <ButtonLink
        href={parentPage.url}
        showArrow
        variant="secondary"
        className="text-ink-soft"
      >
        Browse {parentPage.name.toLowerCase()}
      </ButtonLink>
    </div>
  </div>

  {/* ── Full-width cover ─────────────────────────────────────── */}
  <ProjectHeroCover project={project} />

  {/* ── Technologies strip ───────────────────────────────────── */}
  <ProjectHeroStack technologies={project.data.technologies} />
</section>
