---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getTechnologyPath } from '../../utils/links'
import ButtonLink from '../atoms/ButtonLink.astro'
import Eyebrow from '../atoms/Eyebrow.astro'
import FormattedDate from '../atoms/FormattedDate.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  project: CollectionEntry<'project'>
}

const { project } = Astro.props
---

<section class="
  grid gap-8
  lg:grid-cols-[1.15fr_0.85fr]
"
>
  <div class="space-y-6">
    <Eyebrow label={project.data.typesId === 'personal' ? 'Personal project' : 'Professional work'} tone="brand" />
    <div class="space-y-4">
      <h1 class="
        max-w-4xl text-4xl
        sm:text-5xl
        lg:text-6xl
      "
      >{project.data.title}
      </h1>
      <p class="max-w-3xl text-lg/8 text-ink-soft">{project.data.description}</p>
    </div>

    <div class="flex flex-wrap gap-3">
      {project.data.liveDemoUrl && (
        <ButtonLink href={project.data.liveDemoUrl} newTab showArrow>
          View live project
        </ButtonLink>
      )}
      {project.data.githubUrl && (
        <ButtonLink href={project.data.githubUrl} newTab showArrow variant="secondary">
          Open repository
        </ButtonLink>
      )}
    </div>

    <div class="flex flex-wrap gap-2">
      {project.data.technologies.map(technology => (
        <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
      ))}
    </div>
  </div>

  <div
    class="
      flex h-fit flex-col gap-5 rounded-[1.75rem] p-6 panel-surface
      lg:sticky lg:top-32
    "
  >
    <div class="space-y-1">
      <p class="text-sm font-semibold tracking-[0.2em] text-ink-muted uppercase">Role</p>
      <p class="text-lg font-semibold text-ink">{project.data.rol}</p>
    </div>
    <div class="space-y-1">
      <p class="text-sm font-semibold tracking-[0.2em] text-ink-muted uppercase">Timeline</p>
      <p class="text-lg font-semibold text-ink">
        <FormattedDate date={project.data.startingDate} />
        <span class="px-2 text-ink-muted">-</span>
        {project.data.endingDate ? <FormattedDate date={project.data.endingDate} /> : 'Present'}
      </p>
    </div>
    <div class="space-y-1">
      <p class="text-sm font-semibold tracking-[0.2em] text-ink-muted uppercase">Focus</p>
      <p class="text-base/7 text-ink-soft">
        {
          project.data.typesId === 'personal' ?
            'Open source, community building, and practical developer experience.' :
            'Frontend architecture, delivery leadership, and product quality.'
        }
      </p>
    </div>
  </div>

  {project.data.coverImage && (
    <div class="
      overflow-hidden rounded-4xl panel-surface
      lg:col-span-2
    "
    >
      <Image
        alt={project.data.coverImage.alt}
        class="size-full object-cover"
        fetchpriority="high"
        height={900}
        loading="eager"
        sizes="(min-width: 1024px) 1200px, 100vw"
        src={project.data.coverImage.src}
        width={1600}
        widths={[400, 800, 1200, 1600]}
      />
    </div>
  )}
</section>
