<script is:inline>
const MAX_REPORTED_ERRORS = 5
const reportedErrors = new Set()

const ensureAnalyticsQueue = () => {
  if (typeof window.va === 'function') {
    return
  }

  window.va = (...params) => {
    window.vaq = window.vaq || []
    window.vaq.push(params)
  }
}

const normalizeMessage = (value) => {
  if (value instanceof Error) {
    return value.message
  }

  if (typeof value === 'string') {
    return value
  }

  try {
    return JSON.stringify(value)
  } catch {
    return String(value)
  }
}

const normalizeSource = (value) => {
  if (!value) {
    return null
  }

  try {
    return new URL(value, window.location.origin).pathname
  } catch {
    return String(value)
  }
}

const reportClientError = (payload) => {
  if (reportedErrors.size >= MAX_REPORTED_ERRORS) {
    return
  }

  const signature = [
    payload.kind,
    payload.message,
    payload.source,
    payload.line,
    payload.column,
    payload.path
  ]
    .filter(Boolean)
    .join('|')

  if (!signature || reportedErrors.has(signature)) {
    return
  }

  reportedErrors.add(signature)
  ensureAnalyticsQueue()
  window.va?.('event', {
    name: 'client_error',
    data: payload
  })
}

window.addEventListener('error', (event) => {
  reportClientError({
    column: Number.isFinite(event.colno) ? event.colno : undefined,
    kind: 'error',
    line: Number.isFinite(event.lineno) ? event.lineno : undefined,
    message: normalizeMessage(event.error ?? event.message).slice(0, 240),
    path: window.location.pathname,
    source: normalizeSource(event.filename)
  })
})

window.addEventListener('unhandledrejection', (event) => {
  reportClientError({
    kind: 'unhandledrejection',
    message: normalizeMessage(event.reason).slice(0, 240),
    path: window.location.pathname,
    source: null
  })
})
</script>
