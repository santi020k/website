<div
  aria-label="Reading progress"
  aria-valuemax="100"
  aria-valuemin="0"
  aria-valuenow="0"
  class="ui-scroll-progress"
  data-scroll-progress-compat
  role="progressbar"
>
  <span class="ui-scroll-progress__bar"></span>
</div>

<script>
  const setupReadingProgress = function () {
    const root = document.querySelector<HTMLElement>('[data-scroll-progress-compat]')
    const bar = root?.querySelector<HTMLElement>('.ui-scroll-progress__bar')

    if (!root || !bar) return () => undefined

    let frame = 0

    const update = () => {
      frame = 0

      const scrollingElement = document.scrollingElement ?? document.documentElement
      const maximum = scrollingElement.scrollHeight - scrollingElement.clientHeight

      const percentage = maximum > 0 ?
        Math.min(100, Math.max(0, (scrollingElement.scrollTop / maximum) * 100)) :
        0

      root.setAttribute('aria-valuenow', `${Math.round(percentage)}`)

      bar.style.transform = `scaleX(${percentage / 100})`
    }

    const scheduleUpdate = () => {
      if (frame) return

      frame = requestAnimationFrame(update)
    }

    window.addEventListener('resize', scheduleUpdate, { passive: true })

    window.addEventListener('scroll', scheduleUpdate, { passive: true })

    scheduleUpdate()

    return () => {
      if (frame) cancelAnimationFrame(frame)

      window.removeEventListener('resize', scheduleUpdate)

      window.removeEventListener('scroll', scheduleUpdate)
    }
  }

  let cleanupProgress = setupReadingProgress()

  document.addEventListener('astro:after-swap', () => {
    cleanupProgress()

    cleanupProgress = setupReadingProgress()
  })
</script>
