---

/**
 * NavProgress — thin top bar that shows during page transitions.
 *
 * Lifecycle:
 *   astro:before-preparation  → bar animates to ~70% (fake progress)
 *   astro:before-swap         → marks the tracked navigation as swapped
 *   astro:page-load           → bar snaps to 100% then fades out, unless a
 *                               newer navigation has not reached its swap yet
 *   preparation signal abort  → same as page-load; Astro dispatches no
 *                               page-load for a navigation it cancels
 *
 * Hidden entirely when prefers-reduced-motion is active.
 */
---

<div
  id="nav-progress"
  aria-hidden="true"
  role="presentation"
  transition:animate="none"
  transition:name="site-progress"
  transition:persist
>
</div>

<style>
  #nav-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(
      to right,
      hsl(var(--brand)),
      hsl(var(--brand-soft))
    );
    box-shadow: 0 0 8px hsl(var(--brand) / 0.45);
    opacity: 0;
    pointer-events: none;
    /* Reset immediately before the next navigation starts. */
    transition: none;
  }

  /* Loading: slowly crawl to 70% to simulate in-progress */
  #nav-progress.is-loading {
    opacity: 1;
    transform: scaleX(0.7);
    transition:
      transform 8s cubic-bezier(0.05, 0.3, 0.5, 0.9),
      opacity 0.15s ease;
  }

  /* Complete: snap to 100%, then fade out */
  #nav-progress.is-complete {
    opacity: 0;
    transform: scaleX(1);
    transition:
      transform 0.15s ease,
      opacity 0.35s ease 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    #nav-progress {
      display: none;
    }
  }
</style>

<script>
  import { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client'

  let resetFrame = 0
  // Removes the abort listener of the navigation the bar currently tracks.
  let activeListeners: AbortController | undefined
  // Signal of the tracked navigation until its own before-swap. Astro reuses
  // the preparation signal for that navigation's swap event.
  let awaitingSwapSignal: AbortSignal | undefined

  const retireActiveListeners = () => {
    activeListeners?.abort()

    activeListeners = undefined
  }

  const cancelResetFrame = () => {
    if (!resetFrame) return

    cancelAnimationFrame(resetFrame)

    resetFrame = 0
  }

  const completeProgress = () => {
    retireActiveListeners()

    cancelResetFrame()

    awaitingSwapSignal = undefined

    const bar = document.getElementById('nav-progress')

    if (!bar) return

    bar.classList.remove('is-loading')

    bar.classList.add('is-complete')
  }

  document.addEventListener('astro:before-preparation', event => {
    if (!(event instanceof TransitionBeforePreparationEvent) || event.signal.aborted) return

    const bar = document.getElementById('nav-progress')

    if (!bar) return

    retireActiveListeners()

    cancelResetFrame()

    awaitingSwapSignal = event.signal

    // Let the zero state paint before starting the next transform transition.
    // One frame alone coalesces the reset with loading and animates backward
    // from the previous completed state instead.
    bar.classList.remove('is-loading', 'is-complete')

    resetFrame = requestAnimationFrame(() => {
      resetFrame = requestAnimationFrame(() => {
        bar.classList.add('is-loading')

        resetFrame = 0
      })
    })

    // Astro aborts this signal when a newer navigation or a same-page anchor
    // replaces it. Only the navigation still being tracked may settle the bar.
    const listeners = new AbortController()

    activeListeners = listeners

    event.signal.addEventListener('abort', () => {
      if (activeListeners === listeners) completeProgress()
    }, { once: true, signal: listeners.signal })
  })

  document.addEventListener('astro:before-swap', event => {
    if (event instanceof TransitionBeforeSwapEvent && event.signal === awaitingSwapSignal) {
      awaitingSwapSignal = undefined
    }
  })

  // page-load carries no navigation identity. A page-load while the tracked
  // navigation is still preparing belongs to an older navigation, so it must
  // not settle the bar.
  document.addEventListener('astro:page-load', () => {
    if (awaitingSwapSignal) return

    completeProgress()
  })
</script>
