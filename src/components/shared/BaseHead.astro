---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from 'astro:env/client'

import type { SiteMeta } from '@/types/site'
import { createSeoDescription, createSeoTitle } from '@/utils/seo'
import { getSocialImageURL } from '@/utils/social-image'

import MetadataHead from '@santi020k/og/astro/head'
import type { MetadataTag } from '@santi020k/og/metadata'
import {
  breadcrumbSchema,
  organizationSchema,
  personSchema,
  serializeJsonLd,
  webSiteSchema
} from '@santi020k/og/schema'
import { defineSite } from '@santi020k/og/site'
import logoWordmarkUrl from '@santi020k/theme/assets/logos/logo-santi020k.svg?url'
import logoWordmarkDarkUrl from '@santi020k/theme/assets/logos/logo-santi020k-dark.svg?url'
import logoSquareUrl from '@santi020k/theme/assets/logos/logo-square.webp?url'

import {
  AUTHOR_JOB_TITLE,
  createSchemaEntityId,
  sameAsProfiles,
  siteConfig
} from '@/site.config'

type Props = SiteMeta

const {
  articleDate,
  articleUpdated,
  breadcrumbs,
  canonicalUrl,
  description = siteConfig.description,
  noindex = false,
  ogImage,
  ogImageAlt,
  preloadImage,
  seoTitle,
  structuredData,
  title
} = Astro.props

const resolvedOgImageAlt = ogImageAlt ?? `${title} — ${siteConfig.title}`
const socialTitle = title
const siteTitle = createSeoTitle(seoTitle ?? title, siteConfig.title)
const metaDescription = createSeoDescription(description, title)

const canonicalURL = new URL(
  canonicalUrl ?? Astro.url.pathname, Astro.site ?? 'https://santi020k.com/'
).href

const organizationLogoURL = new URL(logoSquareUrl, Astro.site ?? 'https://santi020k.com/').href
const socialImageURL = getSocialImageURL(Astro.url.pathname, Astro.site ?? Astro.url, ogImage)

const site = defineSite({
  siteName: siteConfig.title,
  siteUrl: Astro.site ?? 'https://santi020k.com/'
})

const article = articleDate ?
    {
      authors: [siteConfig.author],
      ...(articleUpdated ? { modifiedTime: articleUpdated } : {}),
      publishedTime: articleDate
    } :
    undefined

const page = site.page({
  ...(article ? { article } : {}),
  authors: [siteConfig.author],
  canonical: canonicalURL,
  description: metaDescription,
  image: { alt: resolvedOgImageAlt, url: socialImageURL },
  locale: siteConfig.ogLocale,
  pathname: Astro.url.pathname,
  robots: { index: !noindex },
  title: socialTitle,
  twitter: { creator: '@santi020k', site: '@santi020k' },
  type: articleDate ? 'article' : 'website'
})

const transform = (tags: readonly MetadataTag[]) => tags.map(tag => {
  if (tag.tag === 'title') return { ...tag, content: siteTitle }

  if (tag.tag === 'meta' && tag.name === 'robots') {
    return {
      ...tag,
      content: noindex ?
        'noindex, follow' :
        'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'
    }
  }

  return tag
})

const structuredDataJsonLd = structuredData ? JSON.stringify(structuredData) : null

const websiteJsonLd = serializeJsonLd(webSiteSchema({
  id: createSchemaEntityId('website', Astro.site),
  inLanguage: siteConfig.lang,
  name: siteConfig.author,
  searchAction: { target: `${Astro.site?.href ?? 'https://santi020k.com/'}?q={search_term_string}` },
  url: Astro.site?.href ?? 'https://santi020k.com/'
}, { alternateName: 'santi020k' }))

const breadcrumbsJsonLd = breadcrumbs && breadcrumbs.length > 0 ?
  serializeJsonLd(breadcrumbSchema(breadcrumbs.map(crumb => ({
    name: crumb.name,
    url: new URL(crumb.url, Astro.site ?? 'https://santi020k.com/').href
  })))) :
  null
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<MetadataHead {page} site={site.options} {transform} />

{/* Icons */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.webp" sizes="32x32" type="image/webp" />
<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp" type="image/webp" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" type="image/png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="preload" href="/fonts/montserrat-variable-font-wght.woff2" as="font" type="font/woff2" crossorigin />
{/* Preload the header logos — LCP elements */}
<link rel="preload" as="image" href={logoWordmarkUrl} type="image/svg+xml" fetchpriority="high" />
<link rel="preload" as="image" href={logoWordmarkDarkUrl} type="image/svg+xml" fetchpriority="high" />
{
  preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage.href}
      media={preloadImage.media}
      imagesizes={preloadImage.imagesizes}
      imagesrcset={preloadImage.imagesrcset}
      type={preloadImage.type}
      fetchpriority="high"
    />
  )
}

{/* Canonical */}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.title} RSS feed`}
  href="/feed.xml"
/>
<link
  rel="alternate"
  type="application/feed+json"
  title={`${siteConfig.title} JSON feed`}
  href="/feed.json"
/>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Primary Meta */}
<meta name="title" content={siteTitle} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#FAF9FB" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1B141F" media="(prefers-color-scheme: dark)" />

{/* SEO Improvements */}
<meta name="twitter:url" content={canonicalURL} />

{/* Webmentions */}
{WEBMENTION_URL && (
  <>
    <link rel="webmention" href={WEBMENTION_URL} />
    {WEBMENTION_PINGBACK && <link rel="pingback" href={WEBMENTION_PINGBACK} />}
  </>
)}

{/* IndieAuth.com — hosted authorization + token (Micropub / IndieAuth clients) */}
<link rel="authorization_endpoint" href="https://indieauth.com/auth" />
<link rel="token_endpoint" href="https://tokens.indieauth.com/token" />
<link rel="me" href={`mailto:${siteConfig.contact.email}`} />

<meta name="generator" content={Astro.generator} />

<script
  type="application/ld+json"
  is:inline
  set:html={websiteJsonLd}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(personSchema({
    id: createSchemaEntityId('person', Astro.site),
    name: siteConfig.author,
    url: new URL('/about/', Astro.site ?? 'https://santi020k.com/').href
  }, {
    alternateName: 'santi020k',
    jobTitle: AUTHOR_JOB_TITLE,
    description: siteConfig.description,
    sameAs: sameAsProfiles,
    knowsAbout: [
      'Full-Stack Engineering',
      'Software Architecture',
      'Technical Leadership',
      'Developer Experience',
      'Automation Systems'
    ]
  }))}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(organizationSchema({
    id: createSchemaEntityId('organization', Astro.site),
    name: siteConfig.title,
    url: Astro.site?.href ?? 'https://santi020k.com/'
  }, {
    logo: {
      '@type': 'ImageObject',
      url: organizationLogoURL,
      width: 512,
      height: 512
    },
    founder: {
      '@type': 'Person',
      '@id': createSchemaEntityId('person', Astro.site),
      name: siteConfig.author
    },
    sameAs: sameAsProfiles,
    contactPoint: {
      '@type': 'ContactPoint',
      email: siteConfig.contact.email,
      telephone: `+${siteConfig.contact.whatsappPhone}`,
      url: siteConfig.contact.whatsapp,
      contactType: 'professional inquiries'
    }
  }))}
/>

{structuredDataJsonLd && (
  <script type="application/ld+json" is:inline set:html={structuredDataJsonLd} />
)}

{breadcrumbsJsonLd && (
  <script type="application/ld+json" is:inline set:html={breadcrumbsJsonLd} />
)}
