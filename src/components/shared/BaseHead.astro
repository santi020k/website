---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from 'astro:env/client'

import ErrorMonitoring from './ErrorMonitoring.astro'

import { siteConfig } from '../../site.config'
import type { SiteMeta } from '../../types'
import { getSocialImageURL } from '../../utils/social-image'

import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

type Props = SiteMeta

const {
  articleDate,
  articleUpdated,
  breadcrumbs,
  description,
  ogImage,
  ogImageAlt,
  preloadImage,
  structuredData,
  title
} = Astro.props

const resolvedOgImageAlt = ogImageAlt ?? description ?? `${title} — ${siteConfig.title}`
const titleSeparator = '—'
const siteTitle = title === siteConfig.title ? title : `${title} ${titleSeparator} ${siteConfig.title}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://santi020k.me/')
const socialImageURL = getSocialImageURL(Astro.url.pathname, Astro.site ?? Astro.url, ogImage)
const structuredDataJsonLd = structuredData ? JSON.stringify(structuredData) : null

const breadcrumbsJsonLd = breadcrumbs && breadcrumbs.length > 0 ?
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.url, Astro.site ?? 'https://santi020k.me/').href
    }))
  }) :
  null
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{siteTitle}</title>

{/* Icons */}
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="preload" href="/fonts/montserrat-variable-font-wght.ttf" as="font" type="font/ttf" crossorigin />
{
  import.meta.env.PROD && (
    <>
      <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    </>
  )
}
{
  preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage.href}
      imagesizes={preloadImage.imagesizes}
      imagesrcset={preloadImage.imagesrcset}
      type={preloadImage.type}
    />
  )
}

{/* Canonical */}
<link rel="canonical" href={canonicalURL} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.title} RSS feed`}
  href="/feed.xml"
/>

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Primary Meta */}
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#FAF9FB" />

{/* SEO Improvements */}
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="language" content="en-us" />
<meta name="revisit-after" content="7 days" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

{/* Open Graph */}
<meta property="og:type" content={articleDate ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.ogLocale} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{articleDate && (
  <>
    <meta property="article:author" content={siteConfig.author} />
    <meta property="article:published_time" content={articleDate} />
    {articleUpdated && <meta property="article:modified_time" content={articleUpdated} />}
  </>
)}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:site" content="@santi020k" />
<meta name="twitter:creator" content="@santi020k" />

{/* Additional Social */}
<meta property="og:image:alt" content={resolvedOgImageAlt} />
<meta name="twitter:image:alt" content={resolvedOgImageAlt} />

{/* Webmentions */}
{WEBMENTION_URL && (
  <>
    <link rel="webmention" href={WEBMENTION_URL} />
    {WEBMENTION_PINGBACK && <link rel="pingback" href={WEBMENTION_PINGBACK} />}
  </>
)}

<meta name="generator" content={Astro.generator} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${Astro.site?.href ?? 'https://santi020k.me/'}#person`,
    name: siteConfig.author,
    url: Astro.site?.href,
    jobTitle: 'Engineering Leader & Full-Stack Architect',
    description: siteConfig.description,
    sameAs: [
      siteConfig.contact.github,
      siteConfig.contact.linkedin,
      siteConfig.contact.medium
    ].filter(Boolean),
    knowsAbout: [
      'Full-Stack Engineering',
      'Software Architecture',
      'Technical Leadership',
      'Developer Experience',
      'Automation Systems'
    ]
  })}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${Astro.site?.href ?? 'https://santi020k.me/'}#organization`,
    name: siteConfig.title,
    url: Astro.site?.href,
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.site?.href ?? 'https://santi020k.me/'}logo-square.webp`,
      width: 512,
      height: 512
    },
    founder: {
      '@type': 'Person',
      '@id': `${Astro.site?.href ?? 'https://santi020k.me/'}#person`,
      name: siteConfig.author
    },
    sameAs: [
      siteConfig.contact.github,
      siteConfig.contact.linkedin,
      siteConfig.contact.medium
    ].filter(Boolean)
  })}
/>

{structuredDataJsonLd && (
  <script type="application/ld+json" is:inline set:html={structuredDataJsonLd} />
)}

{breadcrumbsJsonLd && (
  <script type="application/ld+json" is:inline set:html={breadcrumbsJsonLd} />
)}

{
  import.meta.env.PROD && !import.meta.env.PUBLIC_IS_CI && (
    <>
      <ErrorMonitoring />
      <SpeedInsights />
      <Analytics />
    </>
  )
}
