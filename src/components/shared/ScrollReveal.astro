---

/**
 * ScrollReveal — centralized scroll-triggered animation controller.
 *
 * Mark any element with `data-animate` to opt in.
 * Optionally set `data-animate-delay="150ms"` for stagger effects.
 * Optionally set `data-animate="fade"` or `data-animate="scale"` for
 * alternate entry variants (see global.css).
 *
 * Mark a grid/list container with `data-stagger` to animate its direct
 * children in sequence. Optionally set `data-stagger="80"` to control
 * the delay step in ms between children (default: 60ms).
 *
 * The script properly tears down and re-creates the IntersectionObserver
 * on every Astro page transition so stale observers never accumulate.
 */
---

<script>
  let observer: IntersectionObserver | null = null
  let fallbackTimer: number | null = null

  // Yield to the browser so any pending user interaction (INP) can be processed
  // before we continue with non-urgent DOM mutations.
  interface SchedulerWithYield {
    yield(): Promise<void>
  }

  type GlobalWithScheduler = typeof globalThis & { scheduler?: SchedulerWithYield }

  const yieldToMain = (): Promise<void> => {
    const s = (globalThis as GlobalWithScheduler).scheduler
    // Use scheduler.yield() when available (Chrome 115+), fall back to setTimeout.
    // Optional chaining returns Promise<void>|undefined; ?? handles the undefined case.
    return s?.yield() ?? new Promise<void>(resolve => setTimeout(resolve, 0))
  }

  function revealElement(el: HTMLElement): void {
    if (el.hasAttribute('data-stagger')) {
      const step = Number(el.dataset.stagger) || 60
      const children = Array.from(el.children) as HTMLElement[]
      // Apply all stagger delays up-front so the CSS animation timing is
      // correct, then add is-visible in a single class-list update per child.
      // We chunk the work so a large grid (e.g. many portfolio cards) never
      // blocks the main thread long enough to inflate INP.
      const CHUNK = 8
      const applyChunk = (start: number) => {
        const end = Math.min(start + CHUNK, children.length)
        for (let i = start; i < end; i++) {
          const child = children[i]
          if (child) {
            child.style.transitionDelay = `${i * step}ms`
            child.classList.add('is-visible')
          }
        }
        if (end < children.length) {
          // Yield, then continue with the next chunk
          yieldToMain().then(() => applyChunk(end))
        }
      }
      applyChunk(0)
    } else {
      const delay = el.dataset.animateDelay
      if (delay) {
        el.style.transitionDelay = delay
      }
      el.classList.add('is-visible')
    }

    observer?.unobserve(el)
  }

  // Fallback: only reveal elements that are actually visible in the current
  // viewport.  Revealing ALL pending elements (old behaviour) would expose
  // below-fold sections immediately, defeating scroll-triggered animations.
  function revealInViewport(): void {
    const vh = window.innerHeight
    document.querySelectorAll<HTMLElement>('[data-animate], [data-stagger]').forEach((el) => {
      if (el.hasAttribute('data-stagger')) {
        const children = Array.from(el.children) as HTMLElement[]
        if (children.every(c => c.classList.contains('is-visible'))) return
      } else if (el.classList.contains('is-visible')) {
        return
      }
      const { top, bottom } = el.getBoundingClientRect()
      if (top < vh && bottom > 0) {
        revealElement(el)
      }
    })
  }

  function resetFallback(): void {
    if (fallbackTimer) {
      window.clearTimeout(fallbackTimer)
    }

    fallbackTimer = window.setTimeout(() => {
      revealInViewport()
      fallbackTimer = null
    }, 800)
  }

  function initScrollReveal(fromTransition = false): void {
    // Always start clean — disconnect any observer left over from the
    // previous page so orphaned entries can't interfere.
    if (observer) {
      observer.disconnect()
      observer = null
    }

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return

          revealElement(entry.target as HTMLElement)
        })
      },
      {
        threshold: 0,
        // Negative bottom margin: IO fires only when the element has scrolled
        // at least 80 px inside the viewport, so the 0.55 s fade-up plays while
        // the element is already visible at any normal scroll speed.
        rootMargin: '0px 0px -80px 0px',
      }
    )

    const observeAll = () => {
      document.querySelectorAll<HTMLElement>('[data-animate], [data-stagger]').forEach((el) => {
        observer?.observe(el)
      })
      resetFallback()
    }

    if (fromTransition) {
      // During a View Transition the outgoing page already painted opacity:0
      // via data-scroll-reveal="ready" on the <html> element. The incoming DOM
      // is swapped in while that attribute is still present, so [data-animate]
      // elements start hidden without needing an extra rAF hide phase.
      // Skip the double-rAF to avoid a one-frame flash and just observe directly.
      document.documentElement.setAttribute('data-scroll-reveal', 'ready')
      requestAnimationFrame(observeAll)
    } else {
      // Double-rAF: the first frame commits data-scroll-reveal="ready" to paint
      // so [data-animate] elements are rendered at opacity:0. The second frame
      // then observes them, letting IO and the CSS transition fire correctly from
      // opacity:0 → 1.  A single rAF is not enough — IO can fire in the same
      // frame the attribute is set, collapsing the transition to a no-op.
      document.documentElement.setAttribute('data-scroll-reveal', 'ready')
      requestAnimationFrame(() => {
        requestAnimationFrame(observeAll)
      })
    }
  }

  // Tear down before Astro swaps the DOM so we never hold references to
  // elements from the outgoing page. Also strip data-scroll-reveal so the
  // incoming elements don't inherit opacity:0 before the observer reinits.
  document.addEventListener('astro:before-swap', () => {
    if (fallbackTimer) {
      window.clearTimeout(fallbackTimer)
      fallbackTimer = null
    }

    if (observer) {
      observer.disconnect()
      observer = null
    }

    document.documentElement.removeAttribute('data-scroll-reveal')
  })

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initScrollReveal(false), { once: true })
  } else {
    initScrollReveal(false)
  }

  // Fires on client-routed pages when the router is enabled.
  document.addEventListener('astro:page-load', () => initScrollReveal(true))
</script>
