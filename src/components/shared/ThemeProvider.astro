{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
const lightModePref = window.matchMedia('(prefers-color-scheme: light)')
// Keep an explicit choice for this document even when browser storage is blocked.
let selectedTheme = null

const normalizeTheme = theme => {
  if (theme === 'light' || theme === 'santi020k-light') return 'santi020k-light'

  if (theme === 'dark' || theme === 'santi020k-dark') return 'santi020k-dark'

  return null
}

const getStoredTheme = () => {
  try {
    const storedTheme = typeof localStorage !== 'undefined' && localStorage.getItem('theme')

    return normalizeTheme(storedTheme)
  } catch {
    return null
  }
}

const getUserPref = () => {
  const storedTheme = getStoredTheme()

  return selectedTheme || storedTheme || (lightModePref.matches ? 'santi020k-light' : 'santi020k-dark')
}

const setTheme = newTheme => {
  if (newTheme !== 'santi020k-light' && newTheme !== 'santi020k-dark') {
    return
  }

  const root = document.documentElement
  const themeChanged = newTheme !== root.getAttribute('data-theme')

  if (themeChanged) {
    root.setAttribute('data-theme', newTheme)
  }

  root.classList.toggle('dark', newTheme === 'santi020k-dark')

  document.querySelectorAll('[data-ui-theme-toggle]').forEach(control => {
    control.setAttribute('aria-pressed', String(newTheme === 'santi020k-dark'))

    control.setAttribute('data-ui-theme', newTheme)
  })

  // Select the canvas color from the head without forcing style recalculation.
  document.head.querySelectorAll('meta[name="theme-color"][data-site-theme]').forEach(meta => {
    const media = meta.dataset.siteTheme === newTheme ? 'all' : 'not all'

    if (meta.media !== media) meta.media = media
  })
}

// initial setup
setTheme(getUserPref())

// Apply the selected theme before Astro installs the destination root attributes.
// Restoring it only after the swap can expose light colors for the first frame.
document.addEventListener('astro:before-swap', event => {
  if (!('newDocument' in event) || !(event.newDocument instanceof Document)) {
    return
  }

  const theme = getUserPref()
  const nextRoot = event.newDocument.documentElement

  nextRoot.setAttribute('data-theme', theme)

  nextRoot.classList.toggle('dark', theme === 'santi020k-dark')
})

// View Transitions hook to restore theme
document.addEventListener('astro:after-swap', () => setTheme(getUserPref()))

// Newly mounted controls can read an older stored value if saving was denied.
document.addEventListener('astro:page-load', () => setTheme(getUserPref()))

// V5 enhancement is asynchronous and may read a legacy stored choice when saving is blocked.
document.addEventListener('ui:ready', () => setTheme(getUserPref()))

// Keep browser chrome metadata in sync after Lumen applies a user-selected theme.
document.addEventListener('ui:theme-change', e => {
  if (!(e instanceof CustomEvent) || !e.detail ||
    !normalizeTheme(e.detail.theme)) return

  selectedTheme = normalizeTheme(e.detail.theme)

  setTheme(selectedTheme)
})

// listen for prefers-color-scheme change.
// Only auto-switch when the user has not made an explicit choice (no stored
// theme); a saved preference takes precedence over the OS toggling.
lightModePref.addEventListener('change', e => {
  if (selectedTheme || getStoredTheme()) return

  setTheme(e.matches ? 'santi020k-light' : 'santi020k-dark')
})
</script>
