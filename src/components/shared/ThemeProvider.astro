{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
const lightModePref = window.matchMedia('(prefers-color-scheme: light)')

const getUserPref = () => {
  const storedTheme = typeof localStorage !== 'undefined' && localStorage.getItem('theme')

  return storedTheme || (lightModePref.matches ? 'light' : 'dark')
}

const setTheme = newTheme => {
  if (newTheme !== 'light' && newTheme !== 'dark') {
    return
  }

  const root = document.documentElement

  // root already set to newTheme, exit early
  if (newTheme === root.getAttribute('data-theme')) {
    return
  }

  root.setAttribute('data-theme', newTheme)

  // Defer the getComputedStyle read to avoid a forced synchronous style
  // recalculation immediately after the DOM write above (forced reflow).
  const colorThemeMetaTag = document.querySelector('meta[name="theme-color"]')
  if (colorThemeMetaTag) {
    requestAnimationFrame(() => {
      const bgColor = getComputedStyle(document.body).getPropertyValue('--theme-bg')
      if (bgColor) {
        colorThemeMetaTag.setAttribute('content', `hsl(${bgColor})`)
      }
    })
  }

  if (typeof localStorage !== 'undefined' && newTheme) {
    localStorage.setItem('theme', newTheme)
  }
}

// initial setup
setTheme(getUserPref())

// View Transitions hook to restore theme
document.addEventListener('astro:after-swap', () => setTheme(getUserPref()))

// listen for theme-change custom event, fired in src/components/ThemeToggle.astro
document.addEventListener('theme-change', e => {
  setTheme(e.detail.theme)
})

// listen for prefers-color-scheme change.
lightModePref.addEventListener('change', e => setTheme(e.matches ? 'light' : 'dark'))
</script>
