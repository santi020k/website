---
import { type CollectionEntry, getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

const { seriesId } = Astro.props
const currentPath = Astro.url.pathname
const posts = await getCollection('post')
const series = await getCollection('series')
const postsSeries = series.find(s => s.id === seriesId)

if (!postsSeries) {
  throw new Error(`Post(s) with Series ID '${seriesId}' not found.`)
}
// console.log("Post(s) Series:", postsSeries); // Debug. Логируем найденную серию

let seriesPosts: CollectionEntry<'post'>[] = []

if (seriesId) {
  seriesPosts = posts
    .filter(p => p.data.seriesId === seriesId)
    .sort((a, b) => (a.data.orderInSeries ?? 0) - (b.data.orderInSeries ?? 0))
}
---

<aside
  id="series-panel"
  class="
    fixed top-0 left-0 z-50 h-full w-64 transform overflow-y-auto border-line
    bg-canvas px-4 py-8 shadow-2xl transition-all duration-300
    lg:static lg:z-0 lg:block lg:transform-none lg:shadow-none
  "
>
  <div class="
    fixed top-0 -z-10 h-screen w-screen bg-linear-to-b from-orange-300
    via-pink-300 to-purple-300 opacity-30
    md:w-72 md:max-w-72 md:min-w-72
    dark:opacity-0
  "
  >
  </div>

  <div class="
    flex h-full w-screen flex-col border-r border-line bg-accent/5 px-8 pt-4
    md:w-72 md:max-w-72 md:min-w-72 md:pt-8
  "
  >
    <div class="flex gap-x-1">
      <!--
      <Icon aria-hidden="true" class="shrink-0 h-8 w-6 py-1" focusable="false" name="solar:notes-line-duotone" />
      -->
      <h4 class="mb-18 flex items-center font-semibold">
        Docs Series panel
      </h4>
    </div>
    <button
      id="close-panel"
      class="
        relative flex h-8 w-16 items-center justify-center rounded-lg
        bg-accent/5 text-accent hover:bg-accent/10 hover:text-brand
      "
      aria-label="Close Series Panel"
    >
      <Icon class="size-6" name="hugeicons:cancel-01" />
    </button>
    <div class="sticky top-8">
      {postsSeries.id ?
        (
        <a
          href={`/series/${postsSeries.id}`}
          aria-label={`About ${postsSeries.data.title} series`}
          class="
            sticky top-4 flex h-8 w-full items-center justify-center gap-x-1
            rounded-lg bg-accent font-medium text-canvas shadow-lg
            transition-all duration-300
            hover:brightness-110
          "
        >
          <Icon class="inline-block size-6 text-canvas" name="solar:notes-bold" />
          {postsSeries.data.title}
        </a>

        <ul class="mt-4.25 text-sm font-medium text-ink-soft">
          {seriesPosts.map(p => {
            const isActive = currentPath === `/posts/${p.id}/`

            // eslint-disable-next-line @typescript-eslint/no-unsafe-return
            return (
              <li class={`
                line-clamp-2 flex items-center px-4 py-1
                ${isActive ?
                'rounded-lg bg-surface-muted' :
                ''}
              `}
              >
                <a
                  href={`/posts/${p.id}/`}
                  class={`
                    hover:text-brand
                    ${isActive ?
                    'pointer-events-none cursor-default text-accent' :
                    ''}
                  `}
                >
                  {p.data.title}
                </a>
              </li>
            )
          })}
        </ul>
        ) :
        null}
    </div>
  </div>
</aside>
