---
import { type CollectionEntry, getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

const { typesId } = Astro.props
const currentPath = Astro.url.pathname

const projects = await getCollection('project')
const types = await getCollection('types')
console.log('🚀 ~ types:', types, typesId)

const projectsTypes = types.find(type => type.id === typesId)
if (!projectsTypes) {
  throw new Error(`Project(s) with Types ID '${typesId}' not found.`)
}

let typesPosts: CollectionEntry<'project'>[] = []
if (typesId) {
  typesPosts = projects
    .filter(p => p.data.typesId === typesId)
    .sort((a, b) => (a.data.orderInTypes || 0) - (b.data.orderInTypes || 0))
}
---

<aside
  id="types-panel"
  class="fixed z-40 grid min-h-screen transition-all duration-300 ease-in-out lg:relative lg:block"
>
  <div class="fixed top-0 -z-10 h-screen w-screen from-orange-300 via-pink-300 to-purple-300 opacity-30 md:w-72 md:min-w-72 md:max-w-72 dark:opacity-0">
  </div>

  <div class="flex h-full w-screen flex-col border-r px-8 pt-4 md:w-72 md:min-w-72 md:max-w-72 md:pt-8">
    <div class="flex gap-x-1">
      <!--
      <Icon aria-hidden="true" class="shrink-0 h-8 w-6 py-1" focusable="false" name="solar:notes-line-duotone" />
      -->
      <h4 class="mb-16 flex items-center">
        Docs Types panel
      </h4>
    </div>
    <button
      id="close-panel"
      class="absolute right-4 top-4 flex size-8 items-center justify-center rounded-lg md:right-8 md:top-8"
      aria-label="Close Types Panel"
    >
      <Icon class="size-6" name="hugeicons:cancel-01" />
    </button>
    <div class="sticky top-8">
      {projectsTypes.id
        ? (
        <a
          href={`/types/${projectsTypes.id}`}
          aria-label={`About ${projectsTypes.data.title} types`}
          class="sticky top-4 flex h-8 w-full items-center justify-center gap-x-1 rounded-lg font-medium shadow-lg transition-all duration-300 hover:brightness-110"
        >
          <Icon class="inline-block size-6" name="solar:notes-bold" />
          {projectsTypes.data.title}
        </a>

        <ul class="mt-4 text-sm font-medium">
          {typesPosts.map((p) => {
            const isActive = currentPath === `/projects/${p.id}/`
            return (
              <li class={`flex items-center px-4 py-1 ${isActive ? 'rounded-lg' : ''}`}>
                <a
                  href={`/projects/${p.id}/`}
                  class={`${isActive ? 'pointer-events-none cursor-default' : ''}`}
                >
                  {p.data.title}
                </a>
              </li>
            )
          })}
        </ul>
          )
        : null}
    </div>
  </div>
</aside>
