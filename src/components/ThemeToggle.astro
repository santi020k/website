---
import { Icon } from 'astro-icon/components';
---

<theme-toggle class="contents">
  <button
    class="
      panel-surface relative flex h-11 w-11 cursor-pointer items-center
      justify-center rounded-full text-ink transition duration-200
      hover:-translate-y-0.5 hover:text-brand motion-reduce:hover:translate-y-0
      motion-reduce:transition-none
    "
    type="button"
  >
    <span class="sr-only">Toggle color theme</span>
    <Icon
      aria-hidden="true"
      class="
        absolute inset-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-100
        opacity-100 transition-all motion-reduce:transition-none
        dark:scale-0 dark:opacity-0
      "
      focusable="false"
      name="tabler:sun"
    />
    <Icon
      aria-hidden="true"
      class="
        absolute inset-1/2 size-5 -translate-x-1/2 -translate-y-1/2 scale-0
        opacity-0 transition-all motion-reduce:transition-none
        dark:scale-100 dark:opacity-100
      "
      focusable="false"
      name="tabler:moon-filled"
    />
  </button>
</theme-toggle>

<script>
// Note that if you fire the theme-change event outside of this component, it will not be reflected in the button's aria-checked attribute. You will need to add an event listener if you want that.
import { rootInDarkMode } from '@/utils/dom-element'

class ThemeToggle extends HTMLElement {
  connectedCallback() {
    // eslint-disable-next-line @typescript-eslint/no-non-null-assertion
    const button = this.querySelector<HTMLButtonElement>('button')!

    button.setAttribute('role', 'switch')
    button.setAttribute('aria-checked', String(rootInDarkMode()))
    button.addEventListener('click', () => {
      const themeChangeEvent = new CustomEvent('theme-change', {
        detail: {
          theme: rootInDarkMode() ? 'light' : 'dark'
        }
      })

      document.dispatchEvent(themeChangeEvent)
      button.setAttribute('aria-checked', String(rootInDarkMode()))
    })
  }
}

customElements.define('theme-toggle', ThemeToggle)
</script>
