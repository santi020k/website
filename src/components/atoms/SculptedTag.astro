---
import type { HTMLAttributes } from 'astro/types'

import { Link } from '@santi020k/lumen-astro'

interface Props {
  'aria-current'?: HTMLAttributes<'a'>['aria-current']
  count?: number
  href: string
  label: string
}

const { 'aria-current': ariaCurrent, count, href, label } = Astro.props
---

<Link aria-current={ariaCurrent} data-sculpted-tag href={href} variant="inherit">
  <span data-sculpted-tag-label>{label}</span>
  <span data-sculpted-tag-count><slot name="count">{count}</slot></span>
</Link>

<style>
  :global([data-sculpted-tag]) {
    --sculpted-tag-accent: hsl(var(--brand));

    display: inline-flex;
    align-items: stretch;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    padding: 0 0 0 0.875rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1rem 0.375rem 1rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    font: 500 0.875rem/1.5 var(--font-sans);
    text-decoration: none;
  }

  :global(:root[data-theme='dark'] [data-sculpted-tag]) {
    --sculpted-tag-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-sculpted-tag-label] {
    min-width: 0;
    padding-block: 0.6875rem;
    overflow-wrap: anywhere;
  }

  [data-sculpted-tag-count] {
    display: grid;
    flex-shrink: 0;
    min-width: 2.375rem;
    padding: 0.5rem;
    place-items: center;
    border-left: 1px solid hsl(var(--line));
    border-radius: 0 0.9375rem 0.3125rem 0;
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  :global([data-sculpted-tag][aria-current]) {
    border-color: hsl(var(--ink));
    background: hsl(var(--ink));
    color: hsl(var(--surface));
  }

  :global([data-sculpted-tag][aria-current]) [data-sculpted-tag-count] {
    border-color: transparent;
    background: color-mix(in srgb, hsl(var(--surface)) 14%, hsl(var(--ink)));
    color: hsl(var(--surface));
  }

  :global([data-sculpted-tag]:hover:not([aria-current])) {
    border-color: var(--sculpted-tag-accent);
    color: var(--sculpted-tag-accent);
  }

  :global([data-sculpted-tag]:focus-visible) {
    outline: 2px solid var(--sculpted-tag-accent);
    outline-offset: 3px;
  }
  @container sculpted-tags (width < 12rem) {
    :global([data-sculpted-tag]) { gap: 0.25rem; padding-left: 0.25rem; }
    [data-sculpted-tag-count] { min-width: 1.5rem; padding-inline: 0.25rem; }
  }
</style>
