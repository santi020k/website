---
interface Props {
  label: string
  className?: string
  borderPosition?: 'left' | 'right'
  animationDelay?: string
}

const { label, className = '', borderPosition = 'left', animationDelay = '0ms' } = Astro.props

const borderClasses = borderPosition === 'left' ?
  'border-l-4 border-l-brand/40 -left-4 sm:-left-8' :
  'border-r-4 border-r-accent/40 -right-4 sm:-right-8'
---

<div
  class:list={[
    `
      mini-note absolute z-30 hidden min-w-32
      sm:block
    `,
    borderPosition === 'left' ? 'min-w-40' : 'min-w-32',
    borderClasses,
    `
      motion-safe:animate-float-y
      motion-reduce:animate-none
    `,
    className
  ]}
  style={`animation-delay: ${animationDelay};`}
>
  <p class="flex items-center gap-1.5 section-label">
    {borderPosition === 'left' && (
      <span class="
        inline-block size-1.5 rounded-full bg-brand
        motion-safe:animate-pulse
      "
      />
    )}
    {label}
  </p>
  <div class="mt-2">
    <slot />
  </div>
</div>
