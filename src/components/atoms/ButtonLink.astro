---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import LumenButtonLink from '@santi020k/lumen-astro/components/ButtonLink'

import { getLocale, localizePath } from '@/i18n'

interface Props {
  ariaLabel?: string
  className?: string
  href: string
  newTab?: boolean
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary'
}

const {
  ariaLabel,
  className = '',
  href,
  newTab = false,
  showArrow = false,
  variant = 'primary'
} = Astro.props

---

<LumenButtonLink
  aria-label={ariaLabel}
  class:list={[
    variant === 'primary' && 'btn-primary',
    variant === 'secondary' && 'btn-secondary',
    variant === 'ghost' && 'btn-ghost',
    variant === 'inline' && 'btn-inline',
    showArrow && 'site-action-aligned',
    className
  ]}
  data-text-link={variant === 'inline' ? '' : undefined}
  href={localizePath(href, getLocale(Astro.url.pathname))}
  newTab={newTab}
  variant="unstyled"
>
  {variant === 'inline' || showArrow ?
    <span data-text-link-label={variant === 'inline' ? '' : undefined}><slot /></span> :
    <slot />}
  {showArrow && (
    <span aria-hidden="true" class="site-action-arrow">
      <ArrowExchange direction={newTab ? 'up-right' : 'right'} size="sm" />
    </span>
  )}
</LumenButtonLink>
