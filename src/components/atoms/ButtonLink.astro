---
import { Icon } from 'astro-icon/components'

interface Props {
  ariaLabel?: string
  className?: string
  href: string
  newTab?: boolean
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary'
}

const {
  ariaLabel,
  className = '',
  href,
  newTab = false,
  showArrow = false,
  variant = 'primary'
} = Astro.props

const typographyClass = 'text-sm font-semibold tracking-[0.01em]'
---

<a
  aria-label={ariaLabel}
  class:list={[
    'group inline-flex cursor-pointer items-center justify-center gap-2',
    typographyClass,
    variant !== 'inline' && 'min-h-11 rounded-full border',
    variant === 'primary' && 'btn-primary',
    variant === 'secondary' && 'btn-secondary',
    variant === 'ghost' && 'btn-ghost',
    variant === 'inline' && 'btn-inline',
    className
  ]}
  data-magnetic={variant !== 'inline' ? 'true' : undefined}
  href={href}
  rel={newTab ? 'noreferrer noopener' : undefined}
  target={newTab ? '_blank' : undefined}
>
  <slot />
  {showArrow && (
    <Icon
      aria-hidden="true"
      class="
        size-4 shrink-0 transition-transform duration-200
        motion-safe:group-hover:translate-x-0.5
        motion-reduce:transition-none
      "
      name={newTab ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
    />
  )}
</a>

<script>
  document.addEventListener('astro:page-load', () => {
    // Only apply on devices with hover capability to avoid mobile touch stickiness
    if (window.matchMedia('(hover: none)').matches) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const magneticElements = document.querySelectorAll<HTMLElement>('[data-magnetic]')

    for (const el of magneticElements) {
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect()
        const hx = rect.left + rect.width / 2
        const hy = rect.top + rect.height / 2

        // Calculate distance from center
        const dx = e.clientX - hx
        const dy = e.clientY - hy

        // Magnet strength (pull factor)
        const pullX = dx * 0.15
        const pullY = dy * 0.25

        el.style.transform = `translate(${pullX}px, ${pullY}px)`
      })

      el.addEventListener('mouseleave', () => {
        // Reset transform so CSS handles the transition back
        el.style.transform = ''
      })
    }
  })
</script>
