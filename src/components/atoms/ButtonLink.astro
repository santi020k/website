---
import { Icon } from 'astro-icon/components'

interface Props {
  ariaLabel?: string
  className?: string
  href: string
  newTab?: boolean
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary'
}

const {
  ariaLabel,
  className = '',
  href,
  newTab = false,
  showArrow = false,
  variant = 'primary'
} = Astro.props

const typographyClass =
  variant === 'primary' ?
    // ≥14pt bold qualifies as “large text” (3:1) so white on dark brand passes a11y.
    'text-[1.17rem] font-bold tracking-[0.01em]' :
    'text-sm font-semibold tracking-[0.01em]'
---

<a
  aria-label={ariaLabel}
  class:list={[
    `
      group inline-flex min-h-11 cursor-pointer items-center justify-center
      gap-2 rounded-full border transition duration-200
      motion-reduce:transform-none motion-reduce:transition-none
      motion-reduce:hover:translate-y-0
      motion-reduce:active:scale-100
    `,
    typographyClass,
    variant === 'primary' && `
      border-brand bg-brand px-5 py-3 text-white
      shadow-[0_10px_24px_hsl(var(--brand)/0.14)]
      hover:-translate-y-0.5 hover:bg-brand/92
      active:scale-[0.98]
    `,
    variant === 'secondary' && `
      border-line/70 bg-surface/72 px-5 py-3 text-ink
      hover:-translate-y-0.5 hover:border-brand/30 hover:bg-surface
      hover:text-brand
      active:scale-[0.98]
    `,
    variant === 'ghost' && `
      border-transparent px-4 py-2.5 text-ink-soft
      hover:bg-surface-muted/72 hover:text-ink
      active:scale-[0.98]
    `,
    variant === 'inline' && `
      min-h-0 rounded-none border-none p-0 text-brand underline-offset-4
      hover:text-accent hover:underline
    `,
    className
  ]}
  href={href}
  rel={newTab ? 'noreferrer noopener' : undefined}
  target={newTab ? '_blank' : undefined}
>
  <slot />
  {showArrow && (
    <Icon
      aria-hidden="true"
      class="
        size-4 shrink-0 transition-transform duration-200
        motion-safe:group-hover:translate-x-0.5
        motion-reduce:transition-none
      "
      name={newTab ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
    />
  )}
</a>
