---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { ButtonLink as LumenButtonLink } from '@santi020k/lumen-astro'

interface Props {
  ariaLabel?: string
  className?: string
  href: string
  newTab?: boolean
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary'
}

const {
  ariaLabel,
  className = '',
  href,
  newTab = false,
  showArrow = false,
  variant = 'primary'
} = Astro.props

---

<LumenButtonLink
  aria-label={ariaLabel}
  class:list={[
    variant === 'primary' && 'btn-primary',
    variant === 'secondary' && 'btn-secondary',
    variant === 'ghost' && 'btn-ghost',
    variant === 'inline' && 'btn-inline',
    className
  ]}
  href={href}
  newTab={newTab}
  variant="unstyled"
>
  <slot />
  {showArrow && (
    <span aria-hidden="true" class="site-action-arrow">
      <ArrowExchange direction={newTab ? 'up-right' : 'right'} size="sm" />
    </span>
  )}
</LumenButtonLink>
