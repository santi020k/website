---
import type { HTMLAttributes } from 'astro/types'

import { Icon } from '@santi020k/lumen-astro'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  direction?: 'down' | 'down-right' | 'left' | 'right' | 'up' | 'up-right'
  size?: 'default' | 'lg' | 'sm' | 'xl'
}

const { class: className = '', direction = 'up-right', size = 'default', ...attributes } = Astro.props
---

<Icon class={className} size={size} data-arrow-exchange={direction} {...attributes}>
  <span data-arrow-track>
    <span data-arrow-glyph><Icon class="size-full" name={`arrow-${direction}`} /></span>
    <span data-arrow-glyph data-arrow-incoming><Icon class="size-full" name={`arrow-${direction}`} /></span>
  </span>
</Icon>
