---
import type { HTMLAttributes } from 'astro/types'

import { Icon } from '@santi020k/lumen-astro'

interface Props extends HTMLAttributes<'span'> {
  class?: string
  direction?: 'down' | 'down-right' | 'left' | 'right' | 'up' | 'up-right'
  size?: 'default' | 'lg' | 'sm' | 'xl'
}

const { class: className = '', direction = 'up-right', size = 'default', ...attributes } = Astro.props
---

<Icon class={className} size={size} data-arrow-exchange={direction} {...attributes}>
  <span data-arrow-track>
    <span data-arrow-glyph><Icon class="size-full" name={`arrow-${direction}`} /></span>
    <span data-arrow-glyph data-arrow-incoming><Icon class="size-full" name={`arrow-${direction}`} /></span>
  </span>
</Icon>

<style>
  :global([data-arrow-exchange]) {
    --arrow-step: calc(125% + var(--arrow-overflow, 0px) * 2.5);
    --arrow-exit-x: var(--arrow-step);
    --arrow-exit-y: 0%;
    /* Oversized SVGs can retain their original footprint without clipping. */
    clip-path: inset(calc(-1 * var(--arrow-overflow, 0px)));
    pointer-events: none;
  }

  :global([data-arrow-exchange='up-right']) { --arrow-exit-y: calc(-1 * var(--arrow-step)); }
  :global([data-arrow-exchange='down-right']) { --arrow-exit-y: var(--arrow-step); }
  :global([data-arrow-exchange='left']) { --arrow-exit-x: calc(-1 * var(--arrow-step)); }
  :global([data-arrow-exchange='down']) { --arrow-exit-x: 0%; --arrow-exit-y: var(--arrow-step); }
  :global([data-arrow-exchange='up']) { --arrow-exit-x: 0%; --arrow-exit-y: calc(-1 * var(--arrow-step)); }

  [data-arrow-track] { position: relative; display: block; width: 100%; height: 100%; }
  [data-arrow-glyph] { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
  [data-arrow-incoming] {
    position: absolute;
    inset: 0;
    transform: translate(calc(-1 * var(--arrow-exit-x)), calc(-1 * var(--arrow-exit-y)));
  }

  /* A single track keeps the outgoing and incoming arrows in step. Resetting
     reveals the identical resting arrow, ready for the next interaction. */
  @keyframes arrow-exchange {
    from { transform: translate(0, 0); }
    to { transform: translate(var(--arrow-exit-x), var(--arrow-exit-y)); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:is(a, button):not(:disabled, [aria-disabled='true']):focus-visible) [data-arrow-track],
    :global([data-arrow-owner]:has(a:focus-visible)) [data-arrow-track] {
      animation: arrow-exchange 480ms cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(:is(a, button):not(:disabled, [aria-disabled='true']):hover) [data-arrow-track],
    :global([data-arrow-owner]:has(a:hover)) [data-arrow-track] {
      animation: arrow-exchange 480ms cubic-bezier(0.25, 0.8, 0.25, 1) both;
    }
  }
</style>
