---
const { variant = 'default', showHash = true, className = '', title } = Astro.props

const badgeClasses = {
  base:
    'inline-flex items-center gap-1 px-2 h-6 rounded-2xl text-xs font-semibold tracking-wide transition-all duration-200 truncate overflow-hidden text-ellipsis whitespace-nowrap max-w-[200px] sm:max-w-full',
  variants: {
    default: 'bg-ink/90 text-canvas backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)] hover:bg-ink-soft/90',
    accent: 'bg-accent/85 text-white backdrop-blur-sm shadow-[0_0_10px_hsl(var(--accent)/0.25),inset_0_1px_0_hsl(0_0%_100%/0.15)] hover:bg-brand/85',
    'brand-accent': 'bg-brand/85 text-white backdrop-blur-sm shadow-[0_0_10px_hsl(var(--brand)/0.22),inset_0_1px_0_hsl(0_0%_100%/0.15)] hover:bg-brand-solid/90',
    muted: 'bg-surface/60 border border-line/40 text-ink-soft backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)] hover:border-line/65 hover:bg-surface/80 hover:text-ink',
    outline: 'border border-line/55 text-ink-soft bg-surface/40 backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)] hover:border-brand/40 hover:bg-brand-soft/25 hover:text-brand',
    inactive: 'bg-surface-muted/60 text-ink-muted border border-line/25 cursor-default opacity-60',
    subtle: 'bg-surface/35 text-ink-muted border border-line/25 backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)]',
    ghost: 'bg-transparent text-ink-soft backdrop-blur-sm hover:bg-surface/60 hover:text-ink hover:shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)]',
    warning: 'bg-warning/15 text-warning border border-warning/30 backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)] dark:bg-warning/20 dark:text-warning dark:border-warning/30',
    danger: 'bg-danger/15 text-danger border border-danger/30 backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)] dark:bg-danger/20 dark:text-danger dark:border-danger/30'
  }
}

const variantClasses = badgeClasses.variants[variant as keyof typeof badgeClasses.variants]
---
<div class={`
  ${badgeClasses.base}
  ${variantClasses}
  ${className}
`}
>
  {showHash && <span class="text-xs font-normal opacity-60">#</span>}
  <span class="truncate">{title}</span>
  <slot />
</div>
