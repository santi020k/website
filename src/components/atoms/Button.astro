---
import type { HTMLAttributes } from 'astro/types'
import { Icon } from 'astro-icon/components'

import { Button as UIButton } from '@/components/ui'

type Props = Omit<HTMLAttributes<'button'>, 'class'> & {
  className?: string
  showArrow?: boolean
  variant?: 'ghost' | 'inline' | 'primary' | 'secondary'
}

const {
  className = '',
  disabled,
  showArrow = false,
  type = 'button',
  variant = 'primary',
  ...rest
} = Astro.props

const uiVariant = {
  ghost: 'ghost',
  inline: 'link',
  primary: 'default',
  secondary: 'secondary'
} as const

const buttonClassName = [
  'group inline-flex cursor-pointer items-center justify-center gap-2',
  'text-sm font-semibold tracking-[0.01em]',
  variant === 'inline' ? 'min-h-0 border-transparent px-0 py-0' : '',
  className
].filter(Boolean).join(' ')
---

<UIButton
  className={buttonClassName}
  disabled={disabled}
  type={type}
  variant={uiVariant[variant]}
  {...rest}
>
  <slot />
  {showArrow && (
    <Icon
      aria-hidden="true"
      class="
        size-4 shrink-0 transition-transform duration-200
        motion-safe:group-hover:translate-x-0.5
        motion-reduce:transition-none
      "
      name="tabler:arrow-right"
    />
  )}
</UIButton>
