---
import type { ImageMetadata, ImageOutputFormat } from 'astro'

import { type LocalImageProps, Picture } from 'astro:assets'

import { getResponsiveImageDimensions } from '@/utils/responsive-image'

import { CoverImage } from '@santi020k/lumen-astro'

interface Props {
  alt: string
  unstyled?: boolean
  fetchpriority?: 'auto' | 'high' | 'low'
  image: ImageMetadata
  loading?: 'eager' | 'lazy'
  preserveAspectRatio?: boolean
  sizes: string
  transitionName?: string
  ariaHidden?: boolean
}

const {
  alt,
  unstyled = false,
  fetchpriority = 'auto',
  image,
  loading = 'lazy',
  preserveAspectRatio = false,
  sizes,
  transitionName,
  ariaHidden = false
} = Astro.props

const nativeImageProps = {
  ...getResponsiveImageDimensions(image, 1600, [400, 800, 1200]),
  alt: ariaHidden ? '' : alt,
  'aria-hidden': ariaHidden ? 'true' : undefined,
  class: 'block h-auto w-full',
  fetchpriority,
  fallbackFormat: 'webp',
  formats: ['avif'],
  loading,
  sizes,
  src: image
} satisfies LocalImageProps & { formats: ImageOutputFormat[], fallbackFormat: ImageOutputFormat }
---

<div
  class:list={[
    'relative overflow-hidden',
    !unstyled && 'rounded-3xl shadow-2xl shadow-ink/10'
  ]}
>
  {/* Passive reading cover: no hover feedback because it is not a control */}
  {preserveAspectRatio && transitionName && (
    <div class:list={['overflow-hidden', !unstyled && 'rounded-3xl']} transition:name={transitionName}>
      <Picture {...nativeImageProps} />
    </div>
  )}
  {preserveAspectRatio && !transitionName && <Picture {...nativeImageProps} />}
  {!preserveAspectRatio &&
    (
      <CoverImage
        fallbackFormat="webp"
        alt={alt}
        ariaHidden={ariaHidden}
        className="w-full"
        fetchpriority={fetchpriority}
        image={image}
        loading={loading}
        mode="detail"
        sizes={sizes}
        {...(transitionName ? { transitionName } : {})}
      />
    )}
</div>
