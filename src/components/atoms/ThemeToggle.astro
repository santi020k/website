---
import { ThemeToggle } from '@santi020k/lumen-astro'

import { getLocale, sharedTranslator } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)

---

<ThemeToggle
  aria-label={t('shared.switchTheme')}
  darkTheme="santi020k-dark"
  data-theme-toggle-btn
  lightTheme="santi020k-light"
  storageKey="theme"
/>

<style is:global>
  /* Header action styling lives in nav.css. Lumen offsets these icons with fixed
     negative margins; translate centers them at whatever size they render. */
  [data-theme-toggle-btn] :is([data-slot="theme-toggle-sun"], [data-slot="theme-toggle-moon"]) {
    margin: 0;
    translate: -50% -50%;
  }
</style>
