---
import { ThemeToggle } from '@santi020k/lumen-astro'
---

<theme-toggle class="contents">
  <ThemeToggle
    controlled
    data-theme-toggle-btn
  />
</theme-toggle>

<style>
  [data-theme-toggle-btn] {
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.2s ease;
  }

  [data-theme-toggle-btn]:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px hsl(var(--canvas)),
      0 0 0 4px hsl(var(--brand));
  }

  /* Spinning border arc — same technique as btn-secondary and stat-card */
  [data-theme-toggle-btn]::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--border-angle),
      hsl(var(--line) / 0.15) 0%,
      hsl(var(--line) / 0.15) 60%,
      hsl(var(--brand) / 0.6) 75%,
      hsl(var(--glow) / 0.7) 83%,
      hsl(var(--brand) / 0.6) 91%,
      hsl(var(--line) / 0.15) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-theme-toggle-btn]:hover {
      transform: translateY(-3px);
      border-color: transparent;
      background-color: hsl(var(--brand-soft) / 0.35);
      color: hsl(var(--brand));
      box-shadow:
        0 8px 24px hsl(230 30% 8% / 0.08),
        0 0 16px color-mix(in srgb, hsl(var(--brand)) 14%, transparent),
        inset 0 1px 0 hsl(0 0% 100% / 0.1);
    }

    [data-theme-toggle-btn]:hover::before {
      opacity: 1;
      animation: var(--animate-border-spin);
    }

    [data-theme-toggle-btn]:active {
      transform: scale(0.93);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-theme-toggle-btn]:hover {
      border-color: hsl(var(--brand) / 0.35);
      color: hsl(var(--brand));
    }
  }
</style>

<script>
import { rootInDarkMode } from '@/utils/dom-element'

class ThemeToggle extends HTMLElement {
  #isAnimating = false

  connectedCallback() {
    const button = this.querySelector<HTMLButtonElement>('button')
    if (!button) return

    button.setAttribute('aria-pressed', String(rootInDarkMode()))

    button.addEventListener('click', () => {
      if (this.#isAnimating) return

      const isDark = rootInDarkMode()
      const newTheme = isDark ? 'light' : 'dark'
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (prefersReducedMotion) {
        document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
        button.setAttribute('aria-pressed', String(rootInDarkMode()))
        return
      }

      this.#circularReveal(button, isDark, newTheme)
    })
  }

  #circularReveal(button: HTMLButtonElement, isDark: boolean, newTheme: string) {
    // Skip animation on touch/coarse-pointer devices — the clip-path animation is
    // GPU-expensive on mobile and directly causes high INP on those devices.
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches

    // Also skip if mobile nav is open to avoid z-index conflict with the panel
    const mobileNavOpen = document.querySelector('[data-mobile-nav-panel]:not([hidden])')

    if (isTouchDevice || mobileNavOpen) {
      document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
      button.setAttribute('aria-pressed', String(rootInDarkMode()))
      return
    }

    this.#isAnimating = true

    const rect = button.getBoundingClientRect()
    const x = Math.round(rect.left + rect.width / 2)
    const y = Math.round(rect.top + rect.height / 2)
    const maxRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    )

    // Overlay covers screen with old theme bg, then collapses to reveal new theme
    const oldBg = isDark ? 'hsl(277 20% 10%)' : 'hsl(268 20% 98%)'

    const overlay = document.createElement('div')
    overlay.setAttribute('aria-hidden', 'true')
    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      zIndex: '99999',
      pointerEvents: 'none',
      backgroundColor: oldBg,
      clipPath: `circle(${maxRadius}px at ${x}px ${y}px)`,
      willChange: 'clip-path',
    })
    document.body.appendChild(overlay)

    // Switch theme immediately while hidden under full-screen overlay
    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
    button.setAttribute('aria-pressed', String(rootInDarkMode()))

    // Double rAF: first frame lets the browser commit the append + initial clip-path
    // to the compositor; second frame starts the transition. This avoids the
    // forced synchronous layout that `void overlay.offsetHeight` would cause.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.transition = 'clip-path 580ms cubic-bezier(0.4, 0, 0.2, 1)'
        overlay.style.clipPath = `circle(0px at ${x}px ${y}px)`

        const done = () => {
          overlay.remove()
          this.#isAnimating = false
        }
        overlay.addEventListener('transitionend', done, { once: true })
        setTimeout(done, 750)
      })
    })
  }
}

customElements.define('theme-toggle', ThemeToggle)
</script>
