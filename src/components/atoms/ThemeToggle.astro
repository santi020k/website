---
import { Icon } from 'astro-icon/components'
---

<theme-toggle class="contents">
  <button
    class="
      relative flex size-11 cursor-pointer items-center justify-center
      rounded-full border border-line/70 bg-surface/80 text-ink transition
      duration-200
      hover:-translate-y-0.5 hover:border-brand/35 hover:text-brand
      motion-reduce:transition-none
      motion-reduce:hover:translate-y-0
    "
    type="button"
  >
    <span class="sr-only">Toggle color theme</span>
    <Icon
      aria-hidden="true"
      class="
        absolute inset-1/2 size-5 -translate-1/2 scale-100 rotate-0 opacity-100
        transition duration-300 ease-out
        motion-reduce:transition-none
        dark:scale-0 dark:rotate-90 dark:opacity-0
      "
      focusable="false"
      name="tabler:sun"
    />
    <Icon
      aria-hidden="true"
      class="
        absolute inset-1/2 size-5 -translate-1/2 scale-0 -rotate-90 opacity-0
        transition duration-300 ease-out
        motion-reduce:transition-none
        dark:scale-100 dark:rotate-0 dark:opacity-100
      "
      focusable="false"
      name="tabler:moon-filled"
    />
  </button>
</theme-toggle>

<script>
import { rootInDarkMode } from '@/utils/dom-element'

class ThemeToggle extends HTMLElement {
  #isAnimating = false

  connectedCallback() {
    const button = this.querySelector<HTMLButtonElement>('button')
    if (!button) return

    button.setAttribute('role', 'switch')
    button.setAttribute('aria-checked', String(rootInDarkMode()))

    button.addEventListener('click', () => {
      if (this.#isAnimating) return

      const isDark = rootInDarkMode()
      const newTheme = isDark ? 'light' : 'dark'
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (prefersReducedMotion) {
        document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
        button.setAttribute('aria-checked', String(rootInDarkMode()))
        return
      }

      this.#circularReveal(button, isDark, newTheme)
    })
  }

  #circularReveal(button: HTMLButtonElement, isDark: boolean, newTheme: string) {
    // Skip animation on touch/coarse-pointer devices — the clip-path animation is
    // GPU-expensive on mobile and directly causes high INP on those devices.
    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches

    // Also skip if mobile nav is open to avoid z-index conflict with the panel
    const mobileNavOpen = document.querySelector('[data-mobile-nav-panel]:not([hidden])')

    if (isTouchDevice || mobileNavOpen) {
      document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
      button.setAttribute('aria-checked', String(rootInDarkMode()))
      return
    }

    this.#isAnimating = true

    const rect = button.getBoundingClientRect()
    const x = Math.round(rect.left + rect.width / 2)
    const y = Math.round(rect.top + rect.height / 2)
    const maxRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    )

    // Overlay covers screen with old theme bg, then collapses to reveal new theme
    const oldBg = isDark ? 'hsl(262 20% 10%)' : 'hsl(262 20% 98%)'

    const overlay = document.createElement('div')
    overlay.setAttribute('aria-hidden', 'true')
    Object.assign(overlay.style, {
      position: 'fixed',
      inset: '0',
      zIndex: '99999',
      pointerEvents: 'none',
      backgroundColor: oldBg,
      clipPath: `circle(${maxRadius}px at ${x}px ${y}px)`,
      willChange: 'clip-path',
    })
    document.body.appendChild(overlay)

    // Switch theme immediately while hidden under full-screen overlay
    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }))
    button.setAttribute('aria-checked', String(rootInDarkMode()))

    // Double rAF: first frame lets the browser commit the append + initial clip-path
    // to the compositor; second frame starts the transition. This avoids the
    // forced synchronous layout that `void overlay.offsetHeight` would cause.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.style.transition = 'clip-path 580ms cubic-bezier(0.4, 0, 0.2, 1)'
        overlay.style.clipPath = `circle(0px at ${x}px ${y}px)`

        const done = () => {
          overlay.remove()
          this.#isAnimating = false
        }
        overlay.addEventListener('transitionend', done, { once: true })
        setTimeout(done, 750)
      })
    })
  }
}

customElements.define('theme-toggle', ThemeToggle)
</script>
