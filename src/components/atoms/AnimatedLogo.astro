---
interface Props {
  variant?: 'light' | 'dark'
  class?: string
}

const { variant = 'light', class: className = '' } = Astro.props

const isDark = variant === 'dark'
const fillColor = isDark ? '#713bf7' : '#5a0fdb'
const strokeColor = isDark ? '#110c1d' : '#FFFFFF'
const textColor = isDark ? '#faf9fb' : '#332e38'
---

<svg
  class:list={['h-full w-auto', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 504 80"
  role="img"
  aria-label="Santi020k"
>
  {/* Logo mark with draw-in animation */}
  <g data-logo-mark>
    <rect
      width="80"
      height="80"
      rx="18"
      fill={fillColor}
      style="transform: scale(0); transform-origin: 40px 40px; animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;"
    />
    <path
      d="M 26 28 L 40 40 L 26 52"
      fill="none"
      stroke={strokeColor}
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
      style="stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw 0.6s ease forwards; animation-delay: 0.3s;"
    />
    <line
      x1="48"
      y1="52"
      x2="62"
      y2="52"
      stroke={strokeColor}
      stroke-width="8"
      stroke-linecap="round"
      style="stroke-dasharray: 60; stroke-dashoffset: 60; animation: draw 0.6s ease forwards; animation-delay: 0.5s;"
    />
  </g>

  {/* Text with fade-in animation */}
  <text
    x="100"
    y="40"
    dominant-baseline="central"
    font-family="Montserrat, Inter, sans-serif"
    font-weight="800"
    font-size="48"
    fill={textColor}
    letter-spacing="-0.04em"
    style="opacity: 0; transform: translateX(-10px); animation: fade-slide 0.5s ease forwards; animation-delay: 0.7s;"
  >
    Santi<tspan fill={fillColor} font-weight="600" letter-spacing="-0.02em">020k</tspan>
  </text>
</svg>

<style>
  @keyframes pop-in {
    to {
      transform: scale(1);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-slide {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Subtle hover - only brightness change */
  :global(a:hover) rect {
    filter: brightness(1.1);
  }

  :global(a:hover) tspan {
    filter: brightness(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    rect,
    path,
    line,
    text {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>
