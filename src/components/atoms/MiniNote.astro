---
interface Props {
  label: string
  className?: string
  borderPosition?: 'left' | 'right' | 'none'
}

const { label, className = '', borderPosition = 'none' } = Astro.props

const borderClasses = {
  left: 'border-l-4 border-l-brand/40',
  right: 'border-r-4 border-r-accent/40',
  none: ''
}[borderPosition]
---

<div class:list={['mini-note', borderClasses, className]}>
  <p class="section-label">{label}</p>
  <div class="mt-2">
    <slot />
  </div>
</div>
