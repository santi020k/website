---
import { Icon } from 'astro-icon/components'
---

<button
  id="back-to-top"
  aria-label="Back to top"
  class="
    fixed right-6 bottom-6 z-40 flex size-11 cursor-pointer items-center
    justify-center rounded-full border border-line/40 bg-surface/80 text-brand
    shadow-xl backdrop-blur-md transition-all duration-500
    hover:scale-110 hover:bg-surface hover:shadow-brand/20
    focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2
    active:scale-95
    motion-reduce:transition-none
  "
  x-data="{
    shown: false,
    init() {
      window.addEventListener('scroll', () => {
        this.shown = window.scrollY > 400
      })
    },
    scrollToTop() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' })
    }
  }"
  x-show="shown"
  x-transition:enter="transition cubic-bezier(0.34, 1.56, 0.64, 1) duration-500"
  x-transition:enter-start="opacity-0 translate-y-10 scale-50"
  x-transition:enter-end="opacity-100 translate-y-0 scale-100"
  x-transition:leave="transition ease-in duration-300"
  x-transition:leave-start="opacity-100 translate-y-0 scale-100"
  x-transition:leave-end="opacity-0 translate-y-10 scale-50"
  @click="scrollToTop()"
>
  <Icon name="tabler:arrow-up" class="size-5" />
</button>
