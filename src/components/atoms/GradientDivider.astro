---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<div
  aria-hidden="true"
  class:list={[
    'pointer-events-none flex justify-center',
    className
  ]}
>
  <div class="
    h-px w-full max-w-4xl bg-linear-to-r from-transparent via-line/28
    to-transparent
  "
  >
  </div>
</div>
