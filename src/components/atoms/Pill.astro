---
import LumenPill from '@santi020k/lumen-astro/components/Pill'

interface Props {
  label: string
  tone?: 'brand' | 'neutral' | 'outline'
}

const { label, tone = 'neutral' } = Astro.props
---

<LumenPill
  class="group gap-1.5"
  data-site-pill
  variant={tone}
>
  <span data-site-pill-label>{label}</span>
</LumenPill>
