---
interface Props {
  className?: string
  href?: string
  label: string
  showHash?: boolean
  tone?: 'brand' | 'neutral' | 'outline'
}

const {
  className = '',
  href,
  label,
  showHash = false,
  tone = 'neutral'
} = Astro.props

const Tag = href ? 'a' : 'span'
---

<Tag
  class:list={[
    `
      items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium
      transition duration-200
    `,
    href && `
      cursor-pointer
      hover:-translate-y-0.5
    `,
    tone === 'neutral' && `
      bg-surface-muted text-ink-soft
      hover:bg-surface-strong hover:text-ink
    `,
    tone === 'brand' && `
      bg-brand-soft text-brand
      hover:bg-brand hover:text-white
    `,
    tone === 'outline' && `
      border border-line/80 bg-transparent text-ink-soft
      hover:border-brand/50 hover:text-brand
    `,
    className
  ]}
  href={href}
>
  {showHash && <span class="text-xs opacity-60">#</span>}
  <span class="wrap-break-word">{label}</span>
  <slot />
</Tag>
