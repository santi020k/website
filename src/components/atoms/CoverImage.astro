---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  alt: string
  className?: string
  featured?: boolean
  featuredMinHeightClass?: string
  fetchpriority?: 'auto' | 'high' | 'low'
  image: ImageMetadata
  loading?: 'eager' | 'lazy'
  mode?: 'card' | 'detail'
  sizes: string
  transitionName?: string
}

const {
  alt,
  className = '',
  featured = false,
  featuredMinHeightClass = 'lg:min-h-88',
  fetchpriority = 'auto',
  image,
  loading = 'lazy',
  mode = 'card',
  sizes,
  transitionName
} = Astro.props

// When no explicit transition name is given, use a stable per-image fallback so
// transition:name always receives a string (required by strict types) and two
// CoverImage instances of the SAME image file still morph naturally.
const effectiveTransitionName = transitionName ?? `cover:${image.src}`
const aspectRatio = image.width / image.height
let orientation: 'landscape' | 'portrait' | 'square' = 'landscape'

if (aspectRatio < 0.92) {
  orientation = 'portrait'
} else if (aspectRatio <= 1.08) {
  orientation = 'square'
}

const useContainedFrame = orientation !== 'landscape'
let cardAspectClass = 'aspect-16/10'

if (orientation === 'portrait') {
  cardAspectClass = 'aspect-4/5'
} else if (orientation === 'square') {
  cardAspectClass = 'aspect-square'
}

let cardWrapperClass = `${cardAspectClass} border-b border-line/45`

if (featured && orientation === 'landscape') {
  cardWrapperClass = `
    aspect-16/10 border-b border-line/45
  `
} else if (useContainedFrame) {
  cardWrapperClass = `
    ${cardAspectClass} flex items-center justify-center border-b border-line/45
    bg-linear-to-br from-surface-muted via-surface to-brand-soft/30 p-4
    sm:p-5
  `
}

let detailWrapperClass = 'aspect-video'
let detailImageClass = 'size-full object-cover'

let cardImageClass = `
  size-full object-cover
  motion-safe:group-hover:scale-[1.03]
`

if (useContainedFrame) {
  detailWrapperClass = `
    flex min-h-[22rem] items-center justify-center bg-linear-to-br
    from-surface-muted via-surface to-brand-soft/35 p-4
    sm:min-h-[28rem] sm:p-6
    lg:min-h-[34rem] lg:p-8
  `

  if (orientation === 'portrait') {
    detailImageClass = 'mx-auto h-full w-auto max-w-full object-contain'
  } else {
    detailImageClass = 'mx-auto h-full w-full max-w-[34rem] object-contain'
  }

  cardImageClass = `
    mx-auto h-full w-full object-contain
    motion-safe:group-hover:scale-[1.02]
  `
}

const wrapperClasses =
  mode === 'card' ?
    [
      'relative overflow-hidden bg-surface-muted',
      cardWrapperClass,
      featured && orientation === 'landscape' && featuredMinHeightClass
    ] :
    [
      'relative overflow-hidden bg-surface-muted',
      detailWrapperClass
    ]

const imageClasses = ['relative z-10 transition duration-500 motion-reduce:transition-none']

if (mode === 'detail') {
  imageClasses.push(detailImageClass)
} else {
  imageClasses.push(cardImageClass)
}
---

<div class:list={[...wrapperClasses, className]} transition:name={effectiveTransitionName}>
  {mode === 'detail' && useContainedFrame && (
    <div
      aria-hidden="true"
      class="absolute inset-0 grid-fade opacity-45"
    />
  )}

  <Picture
    alt={alt}
    class:list={imageClasses}
    fetchpriority={fetchpriority}
    formats={['avif', 'webp']}
    height={mode === 'detail' ? 1200 : 960}
    loading={loading}
    sizes={sizes}
    src={image}
    width={mode === 'detail' ? 1600 : 1280}
    widths={mode === 'detail' ? [400, 800, 1200, 1600] : [400, 800]}
  />

  {mode === 'card' && !useContainedFrame && (
    <div
      aria-hidden="true"
      class="
        absolute inset-0 bg-linear-to-t from-canvas/55 via-canvas/10
        to-transparent
      "
    />
  )}
</div>
