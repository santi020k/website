---
import { Card, Icon } from '@santi020k/lumen-astro'

import { getLocale } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  areas: string[]
}

const { areas } = Astro.props
---

<Card as="section" aria-labelledby="series-focus-heading" data-series-focus variant="unstyled">
  <h2 id="series-focus-heading">{t('collection.focusAreas')}<Icon
name="focus"
class="size-4 shrink-0"
                                                            />
  </h2>
  <ul role="list">
    {areas.map((area, index) => (
      <li>
        <span data-focus-number aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span data-focus-name>{area}</span>
      </li>
    ))}
  </ul>
</Card>

<style>
  [data-series-focus][data-slot='card'] {
    --focus-accent: var(--brand);
    container: series-focus / inline-size;
    height: fit-content;
    min-width: 0;
    padding: 1.5rem 0 0;
    border: 0;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  :global(:root[data-theme='dark']) [data-series-focus] { --focus-accent: var(--accent); }
  [data-series-focus] h2 { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0; color: hsl(var(--focus-accent)); font-size: 0.875rem; line-height: 1.571; font-weight: 500; letter-spacing: normal; }
  [data-series-focus] ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; margin: 1.375rem 0 0; padding: 0; list-style: none; }
  [data-series-focus] li { display: flex; align-items: baseline; gap: 0.75rem; min-width: 0; padding: 1rem 0; border-bottom: 1px solid hsl(var(--line)); }
  [data-focus-number] { flex: 0 0 1.125rem; color: hsl(var(--focus-accent)); font-size: 0.6875rem; line-height: 1.818; font-weight: 500; letter-spacing: normal; }
  [data-focus-name] { min-width: 0; color: hsl(var(--ink)); font-size: 1.125rem; line-height: 1.444; font-weight: 500; letter-spacing: -0.025em; }
  @container series-focus (width < 22rem) {
    [data-series-focus] ul { grid-template-columns: minmax(0, 1fr); margin-top: 0.875rem; }
    [data-series-focus] li { padding-block: 0.75rem; }
  }
  @container series-overview (width >= 52rem) {
    [data-series-focus][data-slot='card'] { padding: 0 0 0 2rem; border-top: 0; border-inline-start: 1px solid hsl(var(--line)); }
    [data-series-focus] ul { grid-template-columns: minmax(0, 1fr); }
  }
  @container series-focus (width < 13rem) {
    [data-series-focus] h2 { gap: 0.5rem; }
    [data-series-focus] li { gap: 0.5rem; }
    [data-focus-number] { flex-basis: auto; }
    [data-focus-name] { font-size: 1rem; line-height: 1.5; }
  }
</style>
