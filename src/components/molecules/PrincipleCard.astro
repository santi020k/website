---
import { Card } from '@santi020k/lumen-astro'

interface Props {
  index: number
  title: string
  body: string
  featured?: boolean
}

const { index, title, body, featured = false } = Astro.props
const formattedIndex = String(index + 1).padStart(2, '0')
---

<Card
  as="article"
  class:list={[
    `
      principle-card h-full space-y-3 rounded-[1.75rem] p-6
      sm:p-7
    `,
    featured && 'sm:col-span-2'
  ]}
  data-principle
  glass="strong"
  variant="interactive"
>
  <p class="section-label transition-colors duration-300" data-principle-index>{formattedIndex}</p>
  <h3 class="text-xl font-semibold text-ink transition-colors duration-200" data-principle-title>{title}</h3>
  <p class="text-sm/7 text-ink-soft">{body}</p>
</Card>

<style>
  .principle-card {
    isolation: isolate;
  }

  /* Brand glow blob top-left */
  .principle-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 60% 50% at 0% 0%,
      hsl(var(--brand) / 0.07),
      transparent 60%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .principle-card:hover::before {
      opacity: 1;
    }

    [data-principle-index] {
      transition: color 0.25s ease, letter-spacing 0.25s ease;
    }

    .principle-card:hover [data-principle-index] {
      color: hsl(var(--brand));
      letter-spacing: 0.28em;
    }

    [data-principle-title] {
      transition: color 0.2s ease;
    }

    .principle-card:hover [data-principle-title] {
      color: hsl(var(--brand));
    }
  }
</style>
