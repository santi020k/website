---
import { Card } from '@santi020k/lumen-astro'

interface Props {
  appearance?: 'default' | 'editorial'
  index: number
  title: string
  body: string
}

const { appearance = 'default', index, title, body } = Astro.props
const formattedIndex = String(index + 1).padStart(2, '0')
---

<Card
  as="article"
  class:list={[
    `
      h-full space-y-3 p-6
      sm:p-7
    `,
    appearance === 'editorial' && 'about-principle'
  ]}
  data-principle
  variant={appearance === 'editorial' ? 'unstyled' : 'default'}
>
  <p class="section-label" data-principle-index>{formattedIndex}</p>
  <h3 class="text-xl font-semibold text-ink" data-principle-title>{title}</h3>
  <p class="text-sm/7 text-ink-soft">{body}</p>
</Card>
