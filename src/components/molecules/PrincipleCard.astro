---
interface Props {
  index: number
  title: string
  body: string
  featured?: boolean
}

const { index, title, body, featured = false } = Astro.props
const formattedIndex = String(index + 1).padStart(2, '0')
---

<div
  class:list={[
    'principle-card h-full space-y-3 p-6 sm:p-7',
    featured && 'sm:col-span-2'
  ]}
  data-principle
>
  <p class="section-label transition-colors duration-300" data-principle-index>{formattedIndex}</p>
  <h3 class="text-xl font-semibold text-ink transition-colors duration-200" data-principle-title>{title}</h3>
  <p class="text-sm/7 text-ink-soft">{body}</p>
</div>

<style>
  .principle-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.75rem;
    background: linear-gradient(
      145deg,
      hsl(var(--surface) / 0.76) 0%,
      hsl(var(--surface-muted) / 0.54) 100%
    );
    border: 1px solid hsl(var(--line) / 0.38);
    backdrop-filter: blur(16px) saturate(145%);
    -webkit-backdrop-filter: blur(16px) saturate(145%);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.1),
      0 8px 24px hsl(230 30% 8% / 0.035),
      0 3px 8px hsl(230 30% 8% / 0.02);
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease;
  }

  /* Brand glow blob top-left */
  .principle-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 50% at 0% 0%,
      hsl(var(--brand) / 0.07),
      transparent 60%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .principle-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--brand) / 0.26);
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.14),
        0 20px 48px hsl(230 30% 8% / 0.08),
        0 6px 18px hsl(var(--brand) / 0.09);
    }

    .principle-card:hover::before {
      opacity: 1;
    }

    [data-principle-index] {
      transition: color 0.25s ease, letter-spacing 0.25s ease;
    }

    .principle-card:hover [data-principle-index] {
      color: hsl(var(--brand));
      letter-spacing: 0.28em;
    }

    [data-principle-title] {
      transition: color 0.2s ease;
    }

    .principle-card:hover [data-principle-title] {
      color: hsl(var(--brand));
    }
  }
</style>
