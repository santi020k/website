---
interface Props {
  index: number
  title: string
  body: string
  featured?: boolean
}

const { index, title, body, featured = false } = Astro.props
const formattedIndex = String(index + 1).padStart(2, '0')
---

<div
  class:list={[
    'panel-card h-full space-y-3 p-6 sm:p-7',
    featured && 'sm:col-span-2 border-b-2 border-b-brand/25'
  ]}
>
  <p class="section-label">{formattedIndex}</p>
  <h3 class="text-xl font-semibold text-ink">{title}</h3>
  <p class="text-sm/7 text-ink-soft">{body}</p>
</div>
