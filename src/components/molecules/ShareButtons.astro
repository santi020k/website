---
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareLinks = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: 'tabler:brand-linkedin',
    label: 'Share on LinkedIn',
    platform: 'LinkedIn'
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: 'tabler:brand-x',
    label: 'Share on X',
    platform: 'X'
  },
  {
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    icon: 'tabler:brand-whatsapp',
    label: 'Share on WhatsApp',
    platform: 'WhatsApp'
  }
]
---

<div class="flex flex-col gap-6 py-10">
  <div class="flex items-center gap-4">
    <span class="text-xs font-bold tracking-[0.2em] text-ink-muted uppercase">Share this piece</span>
    <div class="h-px flex-1 bg-line/30"></div>
  </div>

  <div class="flex flex-wrap justify-center gap-4">
    {shareLinks.map(link => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        data-track-event="share"
        data-track-platform={link.platform}
        class="
          group flex cursor-pointer items-center gap-2.5 rounded-full border
          border-line/40 bg-surface-muted/50 px-5 py-2.5 text-sm font-semibold
          text-ink-soft transition duration-300
          hover:border-brand hover:bg-brand/5 hover:text-brand
        "
      >
        <Icon
          name={link.icon}
          class="
            size-5 transition-transform
            group-hover:scale-110
          "
        />
        <span>{link.platform}</span>
      </a>
    ))}

    <button
      id="copy-link-btn"
      type="button"
      class="
        group flex cursor-pointer items-center gap-2.5 rounded-full border
        border-line/40 bg-surface-muted/50 px-5 py-2.5 text-sm font-semibold
        text-ink-soft transition duration-300
        hover:border-brand hover:bg-brand/5 hover:text-brand
      "
    >
      <Icon
        name="tabler:link"
        data-copy-icon
        class="
          size-5 transition-transform
          group-hover:rotate-45
        "
      />
      <Icon
        name="tabler:check"
        data-check-icon
        class="hidden size-5 animate-spring-up motion-reduce:animate-none"
        aria-hidden="true"
      />
      <span id="copy-label" aria-live="polite">Copy link</span>
    </button>
  </div>
</div>

<style>
  #copy-link-btn.copied {
    background-color: hsl(var(--brand) / 0.1) !important;
    color: hsl(var(--brand)) !important;
    border-color: hsl(var(--brand)) !important;
  }

  @keyframes spring-up {
    0% { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .animate-spring-up { animation: spring-up 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
</style>

<script>
  function setup() {
    const btn = document.getElementById('copy-link-btn')
    if (!btn) return () => {}

    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
    const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
    const label = document.getElementById('copy-label')

    let timer: ReturnType<typeof setTimeout> | null = null

    const onClick = async () => {
      await navigator.clipboard.writeText(window.location.href)

      btn.classList.add('copied')
      copyIcon?.classList.add('hidden')
      checkIcon?.classList.remove('hidden')
      if (label) label.textContent = 'Link copied!'

      if (timer) clearTimeout(timer)
      timer = setTimeout(() => {
        btn.classList.remove('copied')
        copyIcon?.classList.remove('hidden')
        checkIcon?.classList.add('hidden')
        if (label) label.textContent = 'Copy link'
        timer = null
      }, 2000)
    }

    btn.addEventListener('click', onClick)
    return () => {
      btn.removeEventListener('click', onClick)
      if (timer) clearTimeout(timer)
    }
  }

  let cleanup = setup()

  document.addEventListener('astro:after-swap', () => {
    cleanup()
    cleanup = setup()
  })
</script>
