---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { Button, Card, Icon } from '@santi020k/lumen-astro'

import { getLocale, translate } from '@/i18n'

interface Props {
  title: string
  url: string
  variant?: 'sleeve' | 'colophon'
}

const { title, url, variant = 'sleeve' } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareLinks = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    label: 'Share on LinkedIn',
    platform: 'LinkedIn'
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    label: 'Share on X',
    platform: 'X'
  },
  {
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    label: 'Share on WhatsApp',
    platform: 'WhatsApp'
  }
]

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => translate(locale, text)

---

<Card aria-labelledby="share-heading" as="section" data-share-card data-share-variant={variant} variant="unstyled">
  {variant === 'colophon' && <h2 id="share-heading">{t('Share')}</h2>}
  <header data-share-header>
    <div>
      {variant === 'sleeve' && <h2 id="share-heading">{t('Share this piece')}</h2>}
      <p data-share-lead>{t('Pass it on.')}</p>
    </div>
    <Button
      id="copy-link-btn"
      data-share-url={url}
      type="button"
      class="article-copy-action"
      variant="outline"
    >
      <span data-copy-action-content>
        <span id="copy-label">{t('Copy link')}</span>
        <span data-copy-action-icon>
          <Icon name="link" data-copy-icon class="size-4" />
          <Icon name="check" data-check-icon class="hidden size-4" />
          <Icon name="circle-alert" data-failed-icon class="hidden size-4" />
        </span>
      </span>
    </Button>
  </header>
  <div data-share-platforms>
    {shareLinks.map(link => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={t(link.label)}>
        <span>{link.platform}</span>
        <ArrowExchange direction="up-right" class="size-4 shrink-0" />
      </a>
    ))}
  </div>
  <!-- Only results are announced here; the button's own name and idle labels stay silent. -->
  <p aria-atomic="true" aria-live="polite" class="sr-only" id="copy-status" role="status"></p>
</Card>

<style>
  :global([data-share-card]) {
    --share-accent: hsl(var(--brand));
    container: share-card / inline-size;
    display: block;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 0.375rem 1.75rem 0.375rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    box-shadow: 0 0.5rem 0 hsl(var(--brand-soft));
  }

  :global(:root[data-theme="dark"] [data-share-card]) {
    --share-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-share-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem;
  }

  [data-share-header] > div { min-width: 0; }

  #share-heading {
    margin: 0 0 0.625rem;
    color: var(--share-accent);
    font: 500 0.8125rem/1.7 var(--font-sans);
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }

  [data-share-lead] {
    margin: 0;
    color: hsl(var(--ink));
    font: 500 1.375rem/1.4 var(--font-sans);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  [data-share-platforms] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.625rem;
    padding: 0.8125rem 1.75rem;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0 0 1.6875rem 0.3125rem;
    background: hsl(var(--brand-soft));
  }

  [data-share-platforms] a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 0.75rem;
    min-width: min(100%, 6.5625rem);
    min-height: 2.75rem;
    color: hsl(var(--ink));
    font: 500 0.875rem/1.6 var(--font-sans);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  [data-share-platforms] a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  [data-share-platforms] :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--share-accent);
  }

  /* Keep focus and ignore repeats in the controller while the native sheet is open. */
  :global(#copy-link-btn[aria-busy="true"]) {
    opacity: 1;
    pointer-events: auto;
  }

  @container share-card (width < 28.75rem) {
    [data-share-header] { align-items: flex-start; flex-direction: column; padding: 1.5rem; gap: 1.25rem; }
    :global([data-share-variant='sleeve'] #copy-link-btn) { width: 100%; }
    [data-share-platforms] { padding: 0.75rem 1.5rem; gap: 0.25rem 1.375rem; }
  }

  @container share-card (width < 18rem) {
    [data-share-header] { padding: 1.125rem; }
    [data-share-platforms] { padding: 0.75rem 1.125rem; }
  }

  :global([data-share-card][data-share-variant='colophon'][data-slot='card']) {
    display: grid;
    grid-template-columns: 5.375rem minmax(0, 1fr);
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem;
    border: 0;
    border-bottom: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  :global([data-share-variant='colophon']) #share-heading {
    grid-row: 1 / 3;
    margin: 0;
    padding-top: 0.4375rem;
  }
  :global([data-share-variant='colophon']) [data-share-header] {
    grid-column: 2;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding: 0;
  }
  :global([data-share-variant='colophon']) [data-share-lead] { font-size: 1.25rem; }
  :global([data-share-variant='colophon']) [data-share-platforms] {
    grid-column: 2;
    gap: 0.5rem 1.5rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  :global([data-share-variant='colophon']) [data-share-platforms] a { flex: none; min-width: 0; font-size: 0.8125rem; }
  :global([data-share-variant='colophon'] :is(a, button):focus-visible) { outline: 2px solid var(--share-accent); outline-offset: 4px; }

  @container share-card (width < 32rem) {
    :global([data-share-variant='colophon']) #share-heading { grid-row: auto; padding-top: 0; }
    :global([data-share-variant='colophon']) #share-heading,
    :global([data-share-variant='colophon']) [data-share-header],
    :global([data-share-variant='colophon']) [data-share-platforms] { grid-column: 1 / -1; }
  }
</style>

<script>
  import { getLocale, translate } from '@/i18n'

  const clientTranslate = (text: string) => translate(getLocale(window.location.pathname), text)

  const setup = function () {
    const btn = document.getElementById('copy-link-btn')

    if (!btn) return () => undefined

    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
    const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
    const failedIcon = btn.querySelector<HTMLElement>('[data-failed-icon]')
    const label = document.getElementById('copy-label')
    const status = document.getElementById('copy-status')
    let timer: ReturnType<typeof setTimeout> | null = null
    let announcementTimer: ReturnType<typeof setTimeout> | null = null
    let pending = false
    // Cleared before Astro swaps the body, so a share sheet that settles after
    // the visitor leaves cannot copy the previous article or touch its control.
    let active = true

    const setPending = (value: boolean) => {
      pending = value

      if (value) btn.setAttribute('aria-busy', 'true')
      else btn.removeAttribute('aria-busy')
    }

    const supportsWebShare = (): boolean => {
      if (typeof navigator === 'undefined' || typeof navigator.share !== 'function') {
        return false
      }

      const isCoarsePointer = window.matchMedia?.('(pointer: coarse)').matches === true

      return isCoarsePointer
    }

    const idleLabel = clientTranslate(supportsWebShare() ? 'Share link' : 'Copy link')
    const STATE_RESET_MS = 2000
    const ANNOUNCEMENT_DELAY_MS = 100

    if (label) label.textContent = idleLabel

    const clearAnnouncement = () => {
      if (announcementTimer) clearTimeout(announcementTimer)

      announcementTimer = null
    }

    const resetState = () => {
      clearAnnouncement()

      btn.classList.remove('copied', 'copy-failed')

      copyIcon?.classList.remove('hidden')

      checkIcon?.classList.add('hidden')

      failedIcon?.classList.add('hidden')

      if (label) label.textContent = idleLabel

      if (status) status.textContent = ''
    }

    /** Shows a transient result state and announces it through `#copy-status`. */
    const showResultState = (outcome: 'copied' | 'failed') => {
      if (!active || !btn.isConnected) return

      const succeeded = outcome === 'copied'

      btn.classList.remove('copied', 'copy-failed')

      btn.classList.add(succeeded ? 'copied' : 'copy-failed')

      copyIcon?.classList.add('hidden')

      checkIcon?.classList.toggle('hidden', !succeeded)

      failedIcon?.classList.toggle('hidden', succeeded)

      // Kept short so the control still fits a 320px viewport with enlarged text.
      if (label) label.textContent = clientTranslate(succeeded ? 'Link copied!' : 'Copy failed')

      clearAnnouncement()

      // Empty the region, then write the result in a later task: restoring the
      // same text within the task that cleared it leaves no distinct change.
      if (status) {
        const message = clientTranslate(succeeded ? 'Link copied!' : 'Copy failed. Select and copy the address manually.')

        status.textContent = ''

        announcementTimer = setTimeout(() => {
          announcementTimer = null

          if (active && status.isConnected) status.textContent = message
        }, ANNOUNCEMENT_DELAY_MS)
      }

      if (timer) clearTimeout(timer)

      timer = setTimeout(() => {
        resetState()

        timer = null
      }, STATE_RESET_MS)
    }

    const share = async (shareUrl: string, shareTitle: string) => {
      if (supportsWebShare()) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl
          })

          return
        } catch (error) {
          // Cancellation leaves the clipboard unchanged; other errors use the fallback.
          if (error instanceof DOMException && error.name === 'AbortError') {
            return
          }
        }

        if (!active || !btn.isConnected) return
      }

      try {
        await navigator.clipboard.writeText(shareUrl)

        showResultState('copied')
      } catch {
        // Insecure contexts and denied permissions both land here. Telling the
        // visitor beats a button that appears to do nothing at all.
        showResultState('failed')
      }
    }

    const onClick = async () => {
      // One share sheet or clipboard write at a time: a second `navigator.share`
      // call rejects while the first is open and would otherwise fall back to copying.
      if (pending) return

      // Share the server-rendered permalink, like the social links, never the
      // live address bar with its fragment or query. Read both values before any
      // await so a route change during the share sheet cannot swap the page.
      const shareUrl = btn.dataset.shareUrl ?? ''
      const shareTitle = document.title

      // A previous result must not reset the label in the middle of this operation.
      if (timer) {
        clearTimeout(timer)

        timer = null

        resetState()
      }

      if (!shareUrl) {
        showResultState('failed')

        return
      }

      setPending(true)

      try {
        await share(shareUrl, shareTitle)
      } finally {
        if (active && btn.isConnected) setPending(false)
      }
    }

    btn.addEventListener('click', onClick)

    return () => {
      active = false

      btn.removeEventListener('click', onClick)

      if (timer) clearTimeout(timer)

      timer = null

      clearAnnouncement()
    }
  }

  let cleanup = setup()

  document.addEventListener('astro:before-swap', () => {
    cleanup()

    cleanup = () => undefined
  })

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
