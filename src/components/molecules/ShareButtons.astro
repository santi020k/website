---
import { Button, Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareLinks = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    label: 'Share on LinkedIn',
    platform: 'LinkedIn'
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    label: 'Share on X',
    platform: 'X'
  },
  {
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    label: 'Share on WhatsApp',
    platform: 'WhatsApp'
  }
]
---

<Card aria-labelledby="share-heading" as="section" data-share-card variant="unstyled">
  <header data-share-header>
    <div>
      <h2 id="share-heading">Share this piece</h2>
      <p data-share-lead>Pass it on.</p>
    </div>
    <Button
      id="copy-link-btn"
      data-share-url={url}
      type="button"
      class="motion-reduce:transition-none"
    >
      <span data-share-copy-content>
        <span id="copy-label">Copy link</span>
        <Icon name="link" data-copy-icon class="size-5" />
        <Icon name="check" data-check-icon class="hidden size-5" />
        <Icon name="circle-alert" data-failed-icon class="hidden size-5" />
      </span>
    </Button>
  </header>
  <div data-share-platforms>
    {shareLinks.map(link => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
        <span>{link.platform}</span>
        <Icon name="arrow-up-right" />
      </a>
    ))}
  </div>
  <!-- Only results are announced here; the button's own name and idle labels stay silent. -->
  <p aria-atomic="true" aria-live="polite" class="sr-only" id="copy-status" role="status"></p>
</Card>

<style>
  :global([data-share-card]) {
    --share-accent: hsl(var(--brand));
    container: share-card / inline-size;
    display: block;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 0.375rem 1.75rem 0.375rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    box-shadow: 0 0.5rem 0 hsl(var(--brand-soft));
  }

  :global(:root[data-theme="dark"] [data-share-card]) {
    --share-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-share-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.75rem;
  }

  [data-share-header] > div { min-width: 0; }

  #share-heading {
    margin: 0 0 0.625rem;
    color: var(--share-accent);
    font: 500 0.8125rem/1.7 var(--font-sans);
    letter-spacing: normal;
    overflow-wrap: anywhere;
  }

  [data-share-lead] {
    margin: 0;
    color: hsl(var(--ink));
    font: 500 1.375rem/1.4 var(--font-sans);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  :global(#copy-link-btn) {
    --ui-button-gap: 0.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: stretch;
    min-width: 0;
    min-height: 2.75rem;
    flex-shrink: 0;
    padding: 0.875rem 1.125rem;
    border: 1px solid hsl(var(--ink));
    border-radius: 0.375rem 1.125rem 0.375rem 1.125rem;
    background: hsl(var(--ink));
    color: hsl(var(--surface));
    font: 500 0.875rem/1.6 var(--font-sans);
    white-space: normal;
    overflow-wrap: anywhere;
    box-shadow: none;
  }

  [data-share-copy-content] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    width: 100%;
  }

  #copy-label { min-width: 0; }

  :global(#copy-link-btn:hover) { transform: none; }
  :global(#copy-link-btn:hover) #copy-label {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  [data-share-platforms] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.625rem;
    padding: 0.8125rem 1.75rem;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0 0 1.6875rem 0.3125rem;
    background: hsl(var(--brand-soft));
  }

  [data-share-platforms] a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: 0.75rem;
    min-width: min(100%, 6.5625rem);
    min-height: 2.75rem;
    color: hsl(var(--ink));
    font: 500 0.875rem/1.6 var(--font-sans);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  [data-share-platforms] a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  [data-share-platforms] :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--share-accent);
  }

  :global(#copy-link-btn.copied) {
    background: hsl(var(--brand-soft));
    color: var(--share-accent);
    border-color: var(--share-accent);
  }

  /* An opaque surface keeps the label contrast independent of page gradients. */
  :global(#copy-link-btn.copy-failed) {
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    border-color: hsl(var(--danger));
  }

  :global(#copy-link-btn.copy-failed) :global([data-failed-icon]) {
    color: hsl(var(--danger));
  }

  /* Keep focus and ignore repeats in the controller while the native sheet is open. */
  :global(#copy-link-btn[aria-busy="true"]) {
    opacity: 1;
    pointer-events: auto;
  }

  @container share-card (width < 28.75rem) {
    [data-share-header] { align-items: flex-start; flex-direction: column; padding: 1.5rem; gap: 1.25rem; }
    :global(#copy-link-btn) { width: 100%; }
    [data-share-platforms] { padding: 0.75rem 1.5rem; gap: 0.25rem 1.375rem; }
  }

  @container share-card (width < 18rem) {
    [data-share-header] { padding: 1.125rem; }
    [data-share-platforms] { padding: 0.75rem 1.125rem; }
  }
</style>

<script>
  const setup = function () {
    const btn = document.getElementById('copy-link-btn')

    if (!btn) return () => undefined

    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
    const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
    const failedIcon = btn.querySelector<HTMLElement>('[data-failed-icon]')
    const label = document.getElementById('copy-label')
    const status = document.getElementById('copy-status')
    let timer: ReturnType<typeof setTimeout> | null = null
    let pending = false
    // Cleared before Astro swaps the body, so a share sheet that settles after
    // the visitor leaves cannot copy the previous article or touch its control.
    let active = true

    const setPending = (value: boolean) => {
      pending = value

      if (value) btn.setAttribute('aria-busy', 'true')
      else btn.removeAttribute('aria-busy')
    }

    const supportsWebShare = (): boolean => {
      if (typeof navigator === 'undefined' || typeof navigator.share !== 'function') {
        return false
      }

      const isCoarsePointer = window.matchMedia?.('(pointer: coarse)').matches === true

      return isCoarsePointer
    }

    const idleLabel = supportsWebShare() ? 'Share link' : 'Copy link'
    const STATE_RESET_MS = 2000

    if (label) label.textContent = idleLabel

    const resetState = () => {
      btn.classList.remove('copied', 'copy-failed')

      copyIcon?.classList.remove('hidden')

      checkIcon?.classList.add('hidden')

      failedIcon?.classList.add('hidden')

      if (label) label.textContent = idleLabel

      if (status) status.textContent = ''
    }

    /** Shows a transient result state and announces it through `#copy-status`. */
    const showResultState = (outcome: 'copied' | 'failed') => {
      if (!active || !btn.isConnected) return

      const succeeded = outcome === 'copied'

      btn.classList.remove('copied', 'copy-failed')

      btn.classList.add(succeeded ? 'copied' : 'copy-failed')

      copyIcon?.classList.add('hidden')

      checkIcon?.classList.toggle('hidden', !succeeded)

      failedIcon?.classList.toggle('hidden', succeeded)

      // Kept short so the control still fits a 320px viewport with enlarged text.
      if (label) label.textContent = succeeded ? 'Link copied!' : 'Copy failed'

      if (status) status.textContent = succeeded ? 'Link copied!' : 'Copy failed. Select and copy the address manually.'

      if (timer) clearTimeout(timer)

      timer = setTimeout(() => {
        resetState()

        timer = null
      }, STATE_RESET_MS)
    }

    const share = async (shareUrl: string, shareTitle: string) => {
      if (supportsWebShare()) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl
          })

          return
        } catch (error) {
          // Cancellation leaves the clipboard unchanged; other errors use the fallback.
          if (error instanceof DOMException && error.name === 'AbortError') {
            return
          }
        }

        if (!active || !btn.isConnected) return
      }

      try {
        await navigator.clipboard.writeText(shareUrl)

        showResultState('copied')
      } catch {
        // Insecure contexts and denied permissions both land here. Telling the
        // visitor beats a button that appears to do nothing at all.
        showResultState('failed')
      }
    }

    const onClick = async () => {
      // One share sheet or clipboard write at a time: a second `navigator.share`
      // call rejects while the first is open and would otherwise fall back to copying.
      if (pending) return

      // Share the server-rendered permalink, like the social links, never the
      // live address bar with its fragment or query. Read both values before any
      // await so a route change during the share sheet cannot swap the page.
      const shareUrl = btn.dataset.shareUrl ?? ''
      const shareTitle = document.title

      // A previous result must not reset the label in the middle of this operation.
      if (timer) {
        clearTimeout(timer)

        timer = null

        resetState()
      }

      if (!shareUrl) {
        showResultState('failed')

        return
      }

      setPending(true)

      try {
        await share(shareUrl, shareTitle)
      } finally {
        if (active && btn.isConnected) setPending(false)
      }
    }

    btn.addEventListener('click', onClick)

    return () => {
      active = false

      btn.removeEventListener('click', onClick)

      if (timer) clearTimeout(timer)

      timer = null
    }
  }

  let cleanup = setup()

  document.addEventListener('astro:before-swap', () => {
    cleanup()

    cleanup = () => undefined
  })

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
