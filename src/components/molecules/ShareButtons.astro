---
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareLinks = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: 'tabler:brand-linkedin',
    label: 'Share on LinkedIn',
    platform: 'LinkedIn'
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: 'tabler:brand-x',
    label: 'Share on X',
    platform: 'X'
  },
  {
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    icon: 'tabler:brand-whatsapp',
    label: 'Share on WhatsApp',
    platform: 'WhatsApp'
  }
]
---

<div
  class="flex flex-col gap-6 py-10"
  x-data="{
    copied: false,
    copyToClipboard() {
      navigator.clipboard.writeText(window.location.href);
      this.copied = true;
      setTimeout(() => this.copied = false, 2000);
    }
  }"
>
  <div class="flex items-center gap-4">
    <span class="text-xs font-bold tracking-[0.2em] text-ink-muted uppercase">Share this piece</span>
    <div class="h-px flex-1 bg-line/30"></div>
  </div>

  <div class="flex flex-wrap justify-center gap-4">
    {shareLinks.map(link => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        class="
          group flex cursor-pointer items-center gap-2.5 rounded-full border
          border-line/40 bg-surface-muted/50 px-5 py-2.5 text-sm font-semibold
          text-ink-soft transition-all duration-300
          hover:border-brand hover:bg-brand/5 hover:text-brand
        "
      >
        <Icon
          name={link.icon}
          class="
            size-5 transition-transform
            group-hover:scale-110
          "
        />
        <span>{link.platform}</span>
      </a>
    ))}

    <button
      @click="copyToClipboard()"
      class="
        group flex cursor-pointer items-center gap-2.5 rounded-full border
        border-line/40 bg-surface-muted/50 px-5 py-2.5 text-sm font-semibold
        text-ink-soft transition-all duration-300
        hover:border-brand hover:bg-brand/5 hover:text-brand
      "
      :class="copied ? 'bg-brand/10! text-brand! border-brand!' : ''"
    >
      <Icon
        name="tabler:link"
        class="
          size-5 transition-transform
          group-hover:rotate-45
        "
        x-show="!copied"
      />
      <Icon name="tabler:check" class="size-5 animate-spring-up" x-show="copied" x-cloak />
      <span x-text="copied ? 'Link copied!' : 'Copy link'"></span>
    </button>
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
  @keyframes spring-up {
    0% { transform: translateY(10px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .animate-spring-up { animation: spring-up 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
</style>
