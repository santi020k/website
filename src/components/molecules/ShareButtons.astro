---
import { Icon as AstroIcon } from 'astro-icon/components'

import Button from '@/components/atoms/Button.astro'

import { Icon } from '@santi020k/lumen-astro'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)

const shareLinks = [
  {
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: 'tabler:brand-linkedin',
    label: 'Share on LinkedIn',
    platform: 'LinkedIn'
  },
  {
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: 'tabler:brand-x',
    label: 'Share on X',
    platform: 'X'
  },
  {
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    icon: 'tabler:brand-whatsapp',
    label: 'Share on WhatsApp',
    platform: 'WhatsApp'
  }
]
---

<div class="flex flex-col gap-6 py-10">
  <div class="flex items-center gap-4">
    <span class="text-xs font-bold tracking-[0.2em] text-ink-muted uppercase">Share this piece</span>
    <div class="
      h-px flex-1 bg-linear-to-r from-transparent via-line/40 to-transparent
    "
    >
    </div>
  </div>

  <div class="flex flex-wrap justify-center gap-4">
    {shareLinks.map(link => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
        class="group btn-secondary"
      >
        <Icon class="
          size-5 transition-transform
          motion-safe:group-hover:scale-110
          motion-reduce:transition-none
        "
        >
          <AstroIcon aria-hidden="true" class="size-full" focusable="false" name={link.icon} />
        </Icon>
        <span>{link.platform}</span>
      </a>
    ))}

    <Button
      id="copy-link-btn"
      data-share-url={url}
      type="button"
      className="group"
      variant="secondary"
    >
      <Icon
        name="link"
        data-copy-icon
        class="
          size-5 transition-transform
          motion-safe:group-hover:rotate-45
          motion-reduce:transition-none
        "
      />
      <Icon
        name="check"
        data-check-icon
        class="
          hidden size-5 animate-spring-up
          motion-reduce:animate-none
        "
      />
      <Icon
        name="circle-alert"
        data-failed-icon
        class="hidden size-5"
      />
      <span id="copy-label">Copy link</span>
    </Button>
    <!-- Only results are announced here; the button's own name and idle labels stay silent. -->
    <p aria-atomic="true" aria-live="polite" class="sr-only" id="copy-status" role="status"></p>
  </div>
</div>

<style>
  /* Background shorthand clears the inherited Lumen gradient so the state is one solid color. */
  #copy-link-btn.copied {
    background: hsl(var(--brand-soft)) !important;
    color: hsl(var(--brand)) !important;
    border-color: hsl(var(--brand)) !important;
  }

  :global(:root[data-theme="dark"]) #copy-link-btn.copied {
    color: hsl(var(--ink)) !important;
    border-color: hsl(var(--accent)) !important;
  }

  /* An opaque surface keeps the label contrast independent of page gradients;
     the danger border and icon carry the failure alongside the visible words. */
  #copy-link-btn.copy-failed {
    background: hsl(var(--surface)) !important;
    color: hsl(var(--ink)) !important;
    border-color: hsl(var(--danger)) !important;
  }

  #copy-link-btn.copy-failed [data-failed-icon] {
    color: hsl(var(--danger));
  }

  /* `aria-busy` announces an in-flight share or copy. Lumen dims busy buttons and
     drops their hit area; this control keeps its look and ignores repeats in script. */
  #copy-link-btn[aria-busy="true"] {
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script>
  const setup = function () {
    const btn = document.getElementById('copy-link-btn')

    if (!btn) return () => undefined

    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
    const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
    const failedIcon = btn.querySelector<HTMLElement>('[data-failed-icon]')
    const label = document.getElementById('copy-label')
    const status = document.getElementById('copy-status')
    let timer: ReturnType<typeof setTimeout> | null = null
    let pending = false
    // Cleared before Astro swaps the body, so a share sheet that settles after
    // the visitor leaves cannot copy the previous article or touch its control.
    let active = true

    const setPending = (value: boolean) => {
      pending = value

      if (value) btn.setAttribute('aria-busy', 'true')
      else btn.removeAttribute('aria-busy')
    }

    const supportsWebShare = (): boolean => {
      if (typeof navigator === 'undefined' || typeof navigator.share !== 'function') {
        return false
      }

      const isCoarsePointer = window.matchMedia?.('(pointer: coarse)').matches === true

      return isCoarsePointer
    }

    const idleLabel = supportsWebShare() ? 'Share link' : 'Copy link'
    const STATE_RESET_MS = 2000

    if (label) label.textContent = idleLabel

    const resetState = () => {
      btn.classList.remove('copied', 'copy-failed')

      copyIcon?.classList.remove('hidden')

      checkIcon?.classList.add('hidden')

      failedIcon?.classList.add('hidden')

      if (label) label.textContent = idleLabel

      if (status) status.textContent = ''
    }

    /** Shows a transient result state and announces it through `#copy-status`. */
    const showResultState = (outcome: 'copied' | 'failed') => {
      if (!active || !btn.isConnected) return

      const succeeded = outcome === 'copied'

      btn.classList.remove('copied', 'copy-failed')

      btn.classList.add(succeeded ? 'copied' : 'copy-failed')

      copyIcon?.classList.add('hidden')

      checkIcon?.classList.toggle('hidden', !succeeded)

      failedIcon?.classList.toggle('hidden', succeeded)

      // Kept short so the control still fits a 320px viewport alongside the share links.
      if (label) label.textContent = succeeded ? 'Link copied!' : 'Copy failed'

      if (status) status.textContent = succeeded ? 'Link copied!' : 'Copy failed. Select and copy the address manually.'

      if (timer) clearTimeout(timer)

      timer = setTimeout(() => {
        resetState()

        timer = null
      }, STATE_RESET_MS)
    }

    const share = async (shareUrl: string, shareTitle: string) => {
      if (supportsWebShare()) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl
          })

          return
        } catch (error) {
          // Cancellation leaves the clipboard unchanged; other errors use the fallback.
          if (error instanceof DOMException && error.name === 'AbortError') {
            return
          }
        }

        if (!active || !btn.isConnected) return
      }

      try {
        await navigator.clipboard.writeText(shareUrl)

        showResultState('copied')
      } catch {
        // Insecure contexts and denied permissions both land here. Telling the
        // visitor beats a button that appears to do nothing at all.
        showResultState('failed')
      }
    }

    const onClick = async () => {
      // One share sheet or clipboard write at a time: a second `navigator.share`
      // call rejects while the first is open and would otherwise fall back to copying.
      if (pending) return

      // Share the server-rendered permalink, like the social links, never the
      // live address bar with its fragment or query. Read both values before any
      // await so a route change during the share sheet cannot swap the page.
      const shareUrl = btn.dataset.shareUrl ?? ''
      const shareTitle = document.title

      // A previous result must not reset the label in the middle of this operation.
      if (timer) {
        clearTimeout(timer)

        timer = null

        resetState()
      }

      if (!shareUrl) {
        showResultState('failed')

        return
      }

      setPending(true)

      try {
        await share(shareUrl, shareTitle)
      } finally {
        if (active && btn.isConnected) setPending(false)
      }
    }

    btn.addEventListener('click', onClick)

    return () => {
      active = false

      btn.removeEventListener('click', onClick)

      if (timer) clearTimeout(timer)

      timer = null
    }
  }

  let cleanup = setup()

  document.addEventListener('astro:before-swap', () => {
    cleanup()

    cleanup = () => undefined
  })

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
