---
/* eslint-disable @stylistic/indent */
import { Icon } from 'astro-icon/components'

import { siteConfig } from '../../site.config'

---

<section
  id="contact"
  class="
    grid gap-12
    lg:grid-cols-2 lg:items-start
  "
  x-data="{
    status: 'idle', // idle, sending, success, error
    formData: { name: '', email: '', message: '' },
    async submit() {
      this.status = 'sending';
      try {
        // Mocking a successful submission
        await new Promise(resolve => setTimeout(resolve, 1500));
        this.status = 'success';
        this.formData = { name: '', email: '', message: '' };
      } catch (e) {
        this.status = 'error';
      }
    }
  }"
>
  <div class="space-y-6">
    <div class="space-y-4">
      <p class="text-sm font-semibold tracking-[0.2em] text-brand uppercase">Contact</p>
      <h2 class="
        text-4xl font-bold
        sm:text-5xl
      "
      >Let’s build something useful together.
      </h2>
      <p class="text-lg text-ink-soft">
        Whether you have a specific project in mind or just want to chat about engineering leadership
        , I’m always open to a conversation.
      </p>
    </div>

    <div class="space-y-4">
      <div class="
        flex items-center gap-4 rounded-2xl bg-surface-muted p-4 subtle-outline
      "
      >
        <div class="
          flex size-12 items-center justify-center rounded-xl bg-brand/10
          text-brand
        "
        >
          <Icon name="tabler:mail" class="size-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-ink-muted uppercase">Email</p>
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="
              text-lg font-medium text-ink transition-colors
              hover:text-brand
            "
          >
            {siteConfig.contact.email}
          </a>
        </div>
      </div>

      <div class="
        flex items-center gap-4 rounded-2xl bg-surface-muted p-4 subtle-outline
      "
      >
        <div class="
          flex size-12 items-center justify-center rounded-xl bg-brand/10
          text-brand
        "
        >
          <Icon name="tabler:brand-linkedin" class="size-6" />
        </div>
        <div>
          <p class="text-xs font-semibold text-ink-muted uppercase">LinkedIn</p>
          <a
            href={siteConfig.contact.linkedin}
            target="_blank"
            rel="noopener"
            class="
              text-lg font-medium text-ink transition-colors
              hover:text-brand
            "
          >
            santi020k
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-4xl p-8 panel-surface">
    <form
      x-show="status !== 'success'"
      @submit.prevent="submit()"
      class="space-y-6"
    >
      <div class="
        grid gap-6
        sm:grid-cols-2
      "
      >
        <div class="space-y-2">
          <label
            for="name"
            class="text-sm font-semibold tracking-wide text-ink/80"
          >Full Name
          </label>
          <input
            type="text"
            id="name"
            x-model="formData.name"
            placeholder="Santiago Molina"
            required
            class="
              w-full rounded-xl border border-line/50 bg-surface-muted/50 px-4
              py-3.5 text-ink transition-all outline-none
              placeholder:text-ink-muted/50
              focus:border-brand focus:ring-2 focus:ring-brand/10
            "
          />
        </div>
        <div class="space-y-2">
          <label
            for="email"
            class="text-sm font-semibold tracking-wide text-ink/80"
          >Email address
          </label>
          <input
            type="email"
            id="email"
            x-model="formData.email"
            placeholder="you@example.com"
            required
            class="
              w-full rounded-xl border border-line/50 bg-surface-muted/50 px-4
              py-3.5 text-ink transition-all outline-none
              placeholder:text-ink-muted/50
              focus:border-brand focus:ring-2 focus:ring-brand/10
            "
          />
        </div>
      </div>
      <div class="space-y-2">
        <label
          for="message"
          class="text-sm font-semibold tracking-wide text-ink/80"
        >How can I help?
        </label>
        <textarea
          id="message"
          x-model="formData.message"
          placeholder="Tell me about your project or goal..."
          required
          rows="5"
          class="
            w-full resize-none rounded-xl border border-line/50
            bg-surface-muted/50 px-4 py-3.5 text-ink transition-all outline-none
            placeholder:text-ink-muted/50
            focus:border-brand focus:ring-2 focus:ring-brand/10
          "
        >
        </textarea>
      </div>

      <button
        type="submit"
        :disabled="status === 'sending'"
          class="
            group flex w-full cursor-pointer items-center justify-center gap-3
            rounded-xl bg-brand py-4 font-bold text-white transition-all
            hover:translate-y-[-2px] hover:shadow-lg hover:shadow-brand/20
            active:translate-y-0
            disabled:cursor-not-allowed disabled:opacity-50
          "
      >
        <span x-text="status === 'sending' ? 'Sending...' : 'Send Message'"></span>
        <Icon
          name="tabler:send-2"
          class="
            size-5 transition-transform
            group-hover:translate-x-1 group-hover:-translate-y-1
          "
          x-show="status !== 'sending'"
        />
        <Icon name="tabler:loader-2" class="size-5 animate-spin" x-show="status === 'sending'" x-cloak />
      </button>
    </form>

    <div
      x-show="status === 'success'"
      class="flex flex-col items-center gap-8 py-12 text-center"
      x-transition:enter="transition ease-out duration-500"
      x-transition:enter-start="opacity-0 scale-90"
      x-transition:enter-end="opacity-100 scale-100"
      x-cloak
    >
      <div class="
        relative flex size-24 items-center justify-center rounded-full
        bg-brand/10 text-brand
      "
      >
        <div class="
          absolute inset-0 animate-ping rounded-full bg-brand/20 opacity-40
        "
        >
        </div>
        <Icon name="tabler:circle-check-filled" class="relative z-10 size-16" />
      </div>
      <div class="space-y-3">
        <h3 class="text-3xl font-bold text-ink">Message Received!</h3>
        <p class="mx-auto max-w-sm text-lg text-ink-soft">
          Thanks for reaching out. I'll get back to you personally within 24-48 hours.
        </p>
      </div>
      <button
        @click="status = 'idle'"
        class="
          cursor-pointer text-sm font-semibold text-brand transition-colors
          hover:text-brand-soft
        "
      >
        Send another message
      </button>
    </div>
  </div>
</section>

<style>
  [x-cloak] { display: none !important; }
</style>
