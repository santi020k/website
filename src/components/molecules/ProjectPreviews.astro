---
import type { CollectionEntry } from 'astro:content'

import { Image } from '@santi020k/lumen-astro'

interface Props {
  previews: NonNullable<CollectionEntry<'project'>['data']['previews']>
}

const { previews } = Astro.props
---

<section aria-labelledby="product-previews" class="space-y-8" data-product-previews>
  <div class="space-y-3">
    <h2 class="text-2xl font-medium text-ink" id="product-previews">Inside the product</h2>
    <p class="text-sm/7 text-ink-soft">{previews.description}</p>
  </div>
  {previews.images.map((preview, index) => (
    <figure class="
      grid items-center gap-6 border-t border-line/65 py-6
      sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] sm:gap-8
    "
    >
      <Image
        alt={preview.alt}
        class="h-auto max-h-128 w-full object-contain"
        fit="contain"
        format="webp"
        loading="lazy"
        radius="none"
        sizes="(min-width: 1024px) 480px, (min-width: 640px) 60vw, calc(100vw - 48px)"
        src={preview.src}
        widths={[320, 480, 640, 960]}
      />
      <figcaption class="space-y-3">
        <p class="section-label text-ink-soft">{String(index + 1).padStart(2, '0')} / In practice</p>
        <h3 class="text-xl/7 font-medium text-ink">{preview.title}</h3>
        <p class="text-sm/7 text-ink-soft">{preview.caption}</p>
      </figcaption>
    </figure>
  ))}
</section>
