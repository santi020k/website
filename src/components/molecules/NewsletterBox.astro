---
import { Icon } from 'astro-icon/components'

import { siteConfig } from '../../site.config'
import ButtonLink from '../atoms/ButtonLink.astro'

const writingChannels = [
  {
    description: 'The cleanest way to catch every new post without relying on algorithms or inbox sequences.',
    icon: 'tabler:rss',
    title: 'RSS feed'
  },
  {
    description: 'The full on-site archive for architecture, automation, delivery systems, and developer experience.',
    icon: 'tabler:archive',
    title: 'Blog archive'
  },
  {
    description: 'Cross-posted essays and articles that still live in the wider writing stack around this site.',
    icon: 'tabler:brand-medium',
    title: 'Medium'
  }
]
---

<section class="
  panel-card overflow-hidden p-6
  sm:p-7
"
>
  <div class="
    grid gap-6
    lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]
  "
  >
    <div class="space-y-5">
      <div class="space-y-3">
        <p class="section-label">Follow the writing</p>
        <h2 class="text-3xl">Get new posts without checking back manually.</h2>
        <p class="max-w-2xl text-base/7 text-ink-soft">
          I publish irregularly, and when I do it is usually about architecture, automation,
          developer experience, and calmer delivery systems. RSS is the cleanest follow channel here right now.
        </p>
      </div>

      <div class="section-actions">
        <ButtonLink href="/feed.xml" showArrow>
          Subscribe via RSS
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="secondary">
          Browse the archive
        </ButtonLink>
        <ButtonLink href={siteConfig.contact.medium} newTab showArrow variant="ghost">
          Follow on Medium
        </ButtonLink>
      </div>
    </div>

    <div class="
      grid gap-3
      sm:grid-cols-3
      lg:grid-cols-1
    "
    >
      {writingChannels.map(({ description, icon, title }) => (
        <article class="mini-note h-full">
          <div class="flex items-center gap-3">
            <div class="
              flex size-10 shrink-0 items-center justify-center rounded-2xl
              bg-brand-soft text-brand
            "
            >
              <Icon aria-hidden="true" class="size-5" name={icon} />
            </div>
            <p class="section-label">{title}</p>
          </div>
          <p class="mt-3 text-sm/7 text-ink-soft">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
