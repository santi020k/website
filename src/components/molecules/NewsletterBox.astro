---
import { Icon } from 'astro-icon/components'

import Eyebrow from '../atoms/Eyebrow.astro'
---

<section
  class="
    section-shell grid gap-8
    lg:grid-cols-[1fr_0.95fr] lg:items-center
  "
  data-animate
  x-data="{
    subscribed: false,
    email: '',
    subscribe() {
      if (!this.email) return;
      this.subscribed = true;
      this.email = '';
    }
  }"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 grid-fade opacity-25"
  />

  <div class="relative z-10 space-y-4">
    <Eyebrow label="Newsletter" tone="brand" />
    <h2 class="
      max-w-3xl text-3xl
      sm:text-4xl
      lg:text-5xl
    "
    >
      Engineering that ships and systems that last.
    </h2>
    <p class="max-w-2xl section-copy">
      Get my latest thoughts on software architecture, full-stack systems, automation, and technical leadership
      delivered with the same practical lens I use on product teams.
    </p>
  </div>

  <div class="
    panel-card relative z-10 p-6
    sm:p-7
  "
  >
    <p
      aria-atomic="true"
      aria-live="polite"
      class="sr-only"
      x-text="subscribed ? 'Subscription successful' : ''"
    >
    </p>

    <div x-show="!subscribed" class="space-y-4" x-transition>
      <form
        @submit.prevent="subscribe()"
        class="
          flex flex-col gap-3
          sm:flex-row
        "
      >
        <input
          class="
            field-surface
            sm:flex-1
          "
          placeholder="Enter your email"
          required
          type="email"
          x-model="email"
        />
        <button
          class="
            flex min-h-12 cursor-pointer items-center justify-center
            rounded-full border border-brand bg-brand px-6 py-3 text-sm
            font-semibold tracking-[0.01em] text-white transition-all
            duration-200
            hover:-translate-y-0.5 hover:bg-brand/90
            motion-reduce:transition-none
            motion-reduce:hover:translate-y-0
          "
          type="submit"
        >
          Subscribe
        </button>
      </form>
      <p class="text-sm/6 text-ink-soft">
        No spam, ever. Just high-signal notes on systems, delivery, and engineering craft.
      </p>
    </div>

    <div
      x-show="subscribed"
      class="
        flex flex-col items-center gap-4 text-center
        sm:items-start sm:text-left
      "
      x-cloak
      x-transition
    >
      <div class="
        flex size-16 items-center justify-center rounded-full bg-brand-soft
        text-brand
      "
      >
        <Icon aria-hidden="true" class="size-8" name="tabler:check" />
      </div>
      <div class="space-y-2">
        <p class="section-label text-brand">Subscribed</p>
        <h3 class="text-2xl font-bold text-ink">You’re in.</h3>
        <p class="text-sm/6 text-ink-soft">
          Thanks for subscribing. Check your inbox to confirm your email.
        </p>
      </div>
      <button
        class="
          cursor-pointer text-sm font-medium text-ink-muted underline
          underline-offset-4
          hover:text-ink
        "
        type="button"
        @click="subscribed = false"
      >
        Subscribe another email
      </button>
    </div>
  </div>
</section>
