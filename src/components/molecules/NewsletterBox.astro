---
import SectionHeading from './SectionHeading.astro'

import { siteConfig } from '../../site.config'
import ButtonLink from '../atoms/ButtonLink.astro'

const writingChannels = [
  {
    description: 'New essays usually land here first, especially the timely ones about systems and delivery.',
    title: 'Medium'
  },
  {
    description: 'The strongest pieces stay on-site, organized as a cleaner long-term archive.',
    title: 'Blog archive'
  }
]
---

<section
  class="editorial-section"
  data-animate
>
  <div>
    <SectionHeading
      description="I publish practical notes on software architecture, delivery systems, and technical leadership. The goal is signal, not volume."
      eyebrow="Writing updates"
      title="Keep up with the ideas without adding noise to your inbox."
    />
  </div>

  <div class="
    panel-card p-6
    sm:p-7
  "
  >
    <div class="space-y-6">
      <div class="
        grid gap-3
        sm:grid-cols-2
      "
      >
        {writingChannels.map(({ description, title }) => (
          <div class="mini-note">
            <p class="section-label">{title}</p>
            <p class="mt-2 text-sm/7 text-ink-soft">{description}</p>
          </div>
        ))}
      </div>

      <div class="section-actions">
        <ButtonLink href={siteConfig.contact.medium} newTab showArrow>
          Follow on Medium
        </ButtonLink>
        <ButtonLink href="/blog/" showArrow variant="secondary">
          Browse the archive
        </ButtonLink>
      </div>

      <div class="mini-note">
        <p class="section-label">Inbox policy</p>
        <p class="mt-2 text-sm/7 text-ink-soft">
          If a proper newsletter comes back, it will stay high-signal: architecture, automation, and delivery
          notes only.
        </p>
      </div>
    </div>
  </div>
</section>
