---
import ButtonLink from '@santi020k/lumen-astro/components/ButtonLink'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale, localizePath, sharedTranslator } from '@/i18n'

interface Props {
  variant?: 'header' | 'menu'
}

const { variant = 'header' } = Astro.props
const locale = getLocale(Astro.url.pathname)
const target = locale === 'en' ? 'es' : 'en'
const t = sharedTranslator(locale)
const label = t(target === 'es' ? 'language.spanishInterface' : 'language.englishInterface')
const accessibleLabel = variant === 'header' ? `${target.toUpperCase()}: ${label}` : label
const destination = localizePath(`${Astro.url.pathname}${Astro.url.search}`, target)
---

<ButtonLink
  ariaLabel={accessibleLabel}
  data-language-switch={variant}
  href={destination}
  hreflang={target}
  lang={locale}
  title={label}
  variant="unstyled"
>
  <Icon name="languages" class="size-4 shrink-0" />
  <span data-language-switch-label aria-hidden="true">{variant === 'menu' ? label : target.toUpperCase()}</span>
</ButtonLink>

<style>
  [data-language-switch] {
    display: inline-flex;
    flex-shrink: 0;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .5rem .75rem;
    border: 1px solid hsl(var(--line) / .8);
    border-radius: .625rem;
    background: hsl(var(--surface) / .6);
    color: hsl(var(--ink-soft));
    font-size: .75rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  [data-language-switch]:hover {
    border-color: hsl(var(--accent) / .5);
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
  }
  [data-language-switch]:focus-visible { outline: 2px solid hsl(var(--accent)); outline-offset: 3px; }
  [data-language-switch="menu"] {
    min-width: 0;
    justify-content: start;
    gap: .75rem;
    font-size: .8125rem;
    font-weight: 500;
  }
  [data-language-switch-label] { min-width: 0; overflow-wrap: anywhere; }
  @container site-header (width < 26rem) {
    [data-language-switch="header"] { display: none; }
  }
  @media (max-width: 639px) {
    [data-language-switch="header"] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-language-switch] { transition: none; }
  }
  @media (forced-colors: active) {
    [data-language-switch] { border-color: ButtonText; }
    [data-language-switch]:focus-visible { outline-color: Highlight; }
  }
</style>

<script>
  document.addEventListener('click', event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-language-switch]') : null

    if (!link) return

    const destination = new URL(link.href)

    destination.search = window.location.search

    destination.hash = window.location.hash

    link.href = destination.href
  }, { capture: true })
</script>
