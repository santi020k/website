---
import { Card, Collapsible, Icon } from '@santi020k/lumen-astro'

interface Props {
  technologies: string[]
}

const { technologies } = Astro.props
const stackPreview = technologies.slice(0, 6)
const extraTechnologies = technologies.slice(6)
---

<Card as="section" aria-labelledby="sidebar-stack" data-project-stack-card variant="unstyled">
  <h2 id="sidebar-stack">Core stack<Icon class="size-4 shrink-0" name="layers-3" /></h2>
  <ul data-stack-preview role="list">
    {stackPreview.map(technology => <li>{technology}</li>)}
  </ul>
  {extraTechnologies.length > 0 && (
    <Collapsible data-project-stack-disclosure>
      <summary><span>More technologies ({extraTechnologies.length})</span></summary>
      <ul data-stack-extra role="list">
        {extraTechnologies.map(technology => <li>{technology}</li>)}
      </ul>
    </Collapsible>
  )}
</Card>

<style>
  [data-project-stack-card][data-slot='card'] {
    padding: 1.5rem 1.5rem 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  [data-project-stack-card] h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    letter-spacing: normal;
  }
  [data-project-stack-card] ul { margin: 0; padding: 0; list-style: none; }
  [data-project-stack-card] li { margin: 0; padding: 0.8125rem 0; border-bottom: 1px solid hsl(var(--line)); color: hsl(var(--ink)); font-size: 0.9375rem; line-height: 1.533; font-weight: 500; letter-spacing: -0.023em; }
  [data-project-stack-card] [data-stack-preview] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; margin-top: 1.375rem; }
  [data-project-stack-card] :global([data-project-stack-disclosure]) { margin-top: 0.75rem; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  [data-project-stack-card] summary { min-height: 2.75rem; margin: 0; padding: 0.6875rem 1.25rem 0.6875rem 0; border-radius: 0.5rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.692; font-weight: 500; letter-spacing: normal; }
  [data-project-stack-card] summary::before { display: none; }
  [data-project-stack-card] summary::after { inset-inline-end: 0.125rem; top: 1rem; border-color: currentColor; }
  [data-project-stack-card] summary:hover { background: transparent; color: hsl(var(--brand)); }
  [data-project-stack-card] :global(details[open]) > summary { margin-bottom: 0.75rem; }
  [data-project-stack-card] [data-stack-extra] li { padding-block: 0.5625rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.692; font-weight: 400; letter-spacing: normal; }
  :global(:root[data-theme='dark']) [data-project-stack-card] :is(h2, summary:hover) { color: hsl(var(--accent)); }
  @container project-sidebar (width < 17rem) {
    [data-project-stack-card][data-slot='card'] { padding-inline: 1.25rem; }
  }
  @container project-sidebar (width < 16rem) {
    [data-project-stack-card][data-slot='card'] { padding-inline: 0.375rem; }
    [data-project-stack-card] [data-stack-preview] { grid-template-columns: minmax(0, 1fr); }
    [data-project-stack-card] summary { padding-inline-end: 0; }
    [data-project-stack-card] summary::after { position: static; margin-inline-start: 0.5rem; }
  }
</style>
