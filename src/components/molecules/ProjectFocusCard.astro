---
import type { CollectionEntry } from 'astro:content'

import { Card, Icon } from '@santi020k/lumen-astro'

import { getLocale } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  contentLocale?: 'en' | 'es'
  focusAreas: CollectionEntry<'project'>['data']['focusAreas']
}

const { contentLocale = 'en', focusAreas } = Astro.props
---

<Card as="section" aria-labelledby="sidebar-focus" data-project-focus variant="unstyled">
  <h2 id="sidebar-focus">{t('collection.focus')}<Icon class="size-4 shrink-0" name="target" /></h2>
  <dl lang={contentLocale}>
    {focusAreas.map(({ label, description }) => (
      <div>
        <dt>{label}</dt>
        <dd>{description}</dd>
      </div>
    ))}
  </dl>
</Card>

<style>
  [data-project-focus][data-slot='card'] {
    padding: 1.5rem;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-sheet);
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    letter-spacing: normal;
  }
  dl { margin: 1.5rem 0 0; }
  dl > div {
    padding-block: 1.125rem;
    border-block-start: 1px solid hsl(var(--line));
  }
  dl > div:first-child { padding-block-start: 0; border: 0; }
  dl > div:last-child { padding-block-end: 0; }
  dt {
    border-inline-start: 2px solid hsl(var(--brand));
    padding-inline-start: 0.875rem;
    color: hsl(var(--ink));
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  dd {
    margin: 0.4375rem 0 0;
    padding-inline-start: 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.75;
    letter-spacing: normal;
  }
  :global(:root[data-theme='santi020k-dark']) h2 { color: hsl(var(--accent)); }
  :global(:root[data-theme='santi020k-dark']) dt { border-inline-start-color: hsl(var(--accent)); }
  @container project-sidebar (width < 16rem) {
    [data-project-focus][data-slot='card'] { padding-inline: 0.375rem; }
    dt { padding-inline-start: 0.25rem; font-size: 0.875rem; }
    dd { padding-inline-start: calc(0.25rem + 2px); font-size: 0.75rem; }
  }
</style>
