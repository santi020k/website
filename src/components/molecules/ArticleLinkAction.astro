---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { CopyButton, Icon, Link } from '@santi020k/lumen-astro'

interface Props {
  canonicalUrl: string | undefined
  copyUrl: string
}

const { canonicalUrl, copyUrl } = Astro.props
---

{canonicalUrl ?
(
  <Link href={canonicalUrl} newTab variant="inherit" data-article-utility>
    <span>Read on Medium</span>
    <ArrowExchange direction="up-right" class="size-4 shrink-0" />
  </Link>
) :
(
  <CopyButton
    variant="outline"
    class="article-copy-action"
    data-article-copy
    copiedLabel="Copied! Article link copied"
    errorLabel="Copy link failed. Select and copy the address manually."
    label="Copy link to article"
    value={copyUrl}
  >
    <span data-copy-action-content>
      <span data-copy-label>Copy link</span>
      <span data-copy-action-icon><Icon class="size-4" data-copy-icon name="link" /></span>
    </span>
    <span slot="copied" data-copy-action-content>
      <span data-copied-label>Copied!</span>
      <span data-copy-action-icon><Icon class="size-4" name="check" /></span>
    </span>
    <span slot="error" data-copy-action-content>
      <span>Copy failed</span>
      <span data-copy-action-icon><Icon class="size-4" name="circle-alert" /></span>
    </span>
  </CopyButton>
)}
