---
import { Button, Empty, Icon } from '@santi020k/lumen-astro'

interface Props {
  idle?: boolean
}

const { idle = false } = Astro.props
---

<li data-site-search-empty-row>
  <Empty data-site-search-empty>
    <span data-site-search-empty-icon>
      <Icon class="size-6" name={idle ? 'search' : 'search-x'} />
    </span>
    <div data-site-search-empty-copy>
      <h3 data-site-search-empty-title>{idle ? 'Start typing to search' : 'No results found'}</h3>
      <p data-site-search-empty-description>{idle ?
        'Enter at least 2 characters to find posts, projects, and community work.' :
        'Try different keywords or check your spelling.'}</p>
    </div>
    {!idle && (
      <div data-site-search-empty-actions>
        <Button data-site-search-clear type="button">
          <span data-site-search-empty-action-content>
            <span>Clear search</span>
            <Icon class="size-4" name="rotate-ccw" />
          </span>
        </Button>
      </div>
    )}
  </Empty>
</li>

<style is:global>
  #site-search-results [data-site-search-empty-row] { container: search-empty / inline-size; }
  #site-search-results [data-site-search-empty] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem;
    align-items: start;
    justify-items: stretch;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1.625rem 1.625rem 1.625rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    text-align: left;
    overflow-wrap: anywhere;
  }
  #site-search-results [data-site-search-empty-icon] { grid-column: 2; grid-row: 1; display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; color: hsl(var(--accent)); }
  #site-search-results [data-site-search-empty-copy] { grid-column: 1; grid-row: 1; min-width: 0; }
  #site-search-results [data-site-search-empty-title] { margin: 0 0 1rem; color: hsl(var(--ink)); font-size: 1.875rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.05em; }
  #site-search-results [data-site-search-empty-description] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  #site-search-results [data-site-search-empty-actions] { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid hsl(var(--line)); }
  #site-search-results [data-site-search-clear] { min-width: 10rem; max-width: 100%; min-height: 2.75rem; height: auto; padding: 0.5rem 1rem; border: 1px solid hsl(var(--ink)); border-radius: 0.75rem; background: hsl(var(--ink)); color: hsl(var(--surface)); font-size: 0.75rem; font-weight: 500; line-height: 1.6; white-space: normal; transition: background-color 160ms ease; }
  #site-search-results [data-site-search-clear]:hover { background: hsl(var(--ink-soft)); }
  #site-search-results [data-site-search-empty-action-content] { display: flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 0; }

  @container search-empty (width < 26.875rem) {
    #site-search-results [data-site-search-empty] { gap: 1.125rem; padding: 1.375rem; }
    #site-search-results [data-site-search-empty-title] { font-size: 1.625rem; }
  }
  @container search-empty (width < 18.125rem) {
    #site-search-results [data-site-search-empty] { grid-template-columns: minmax(0, 1fr); padding: 1.25rem; }
    #site-search-results [data-site-search-empty-icon] { grid-column: 1; grid-row: 1; }
    #site-search-results [data-site-search-empty-copy] { grid-row: 2; }
    #site-search-results [data-site-search-clear] { width: 100%; min-width: 0; }
  }
  @container search-empty (width < 13rem) {
    #site-search-results [data-site-search-empty] { gap: 0.75rem; padding: 0.75rem; }
    #site-search-results [data-site-search-empty-title] { font-size: 1.375rem; }
    #site-search-results [data-site-search-empty-action-content] { gap: 0.5rem; }
    #site-search-results [data-site-search-empty-action-content] > :last-child { display: none; }
  }
  @container site-search (height < 31.25rem) {
    #site-search-results [data-site-search-empty] { gap: 0.75rem; padding-block: 0.875rem; }
    #site-search-results [data-site-search-empty-title] { margin-bottom: 0.5rem; font-size: 1.375rem; }
    #site-search-results [data-site-search-empty-actions] { padding-top: 0.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #site-search-results [data-site-search-clear] { transition: none; }
  }
</style>
