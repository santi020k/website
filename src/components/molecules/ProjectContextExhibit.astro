---
import type { ImageMetadata } from 'astro'

import Image from '@santi020k/lumen-astro/components/Image'

import { getLocale } from '@/i18n'
import { projectStoryTranslator } from '@/i18n/project-story'

const locale = getLocale(Astro.url.pathname)
const t = projectStoryTranslator(locale)

interface Props {
  src: ImageMetadata
  alt: string
  caption: string
}

const { src, alt, caption } = Astro.props
---

<div class="not-prose" data-context-exhibit>
  <div data-context-layout>
    <div data-context-copy><slot /></div>
    <figure data-context-figure>
      <Image
        alt={alt}
        data-context-image
        fit="contain"
        format="webp"
        loading="lazy"
        radius="none"
        sizes="240px"
        src={src}
        widths={[240, 480, 720]}
      />
      <figcaption><span>{t('exhibit.conceptIllustration')}</span>{caption}</figcaption>
    </figure>
  </div>
</div>

<style>
  [data-context-exhibit] { container: context-exhibit / inline-size; margin-block: 1.25rem 2.5rem; }
  [data-context-layout] { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; align-items: start; gap: 1.75rem; }
  [data-context-copy] { min-width: 0; }
  [data-context-copy] :global(p) { margin: 0; color: hsl(var(--ink-soft)); font-size: 1rem; line-height: 1.9; }
  [data-context-copy] :global(p + p) { margin-top: 1rem; }
  [data-context-figure] { margin: 0; min-width: 0; border-inline-start: 1px solid hsl(var(--line)); padding-inline-start: 1.25rem; }
  [data-context-image] { display: block; width: 100%; height: auto; margin: 0; border: 0; border-radius: 1.25rem 1.25rem 0.3125rem 1.25rem; box-shadow: none; }
  [data-context-figure] figcaption { padding-top: 0.75rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.7; overflow-wrap: anywhere; }
  [data-context-figure] figcaption span { display: block; color: hsl(var(--brand)); font-weight: 500; }
  :global([data-theme='santi020k-dark']) [data-context-figure] figcaption span { color: hsl(var(--accent)); }
  @container context-exhibit (width < 35rem) {
    [data-context-layout] { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    [data-context-figure] { width: 15rem; max-width: 100%; border: 0; padding: 0; }
  }
</style>
