---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getPortfolioPath } from '@/utils/links'
import { getProjectBrandStyle } from '@/utils/project-brand'

import Button from '@santi020k/lumen-astro/components/Button'

import type { SocialProofItem } from '@/data/profile'
import { getLocale, localizePath } from '@/i18n'
import { pageTranslator } from '@/i18n/page-copy'

interface OrganizationLogoRailItem extends SocialProofItem {
  project: CollectionEntry<'project'>
}

interface Props {
  organizations: OrganizationLogoRailItem[]
}

type LogoAspect = 'square' | 'tall' | 'wide'

const { organizations } = Astro.props
const logoFrameWidth = { square: 8, tall: 5, wide: 13 } satisfies Record<LogoAspect, number>

const getLogoWidths = (displayWidth: number, maximumWidth: number) => [...new Set([displayWidth, displayWidth * 2, maximumWidth])]
  .filter(width => width > 0 && width <= maximumWidth)
  .sort((left, right) => left - right)

const locale = getLocale(Astro.url.pathname)
const t = pageTranslator(locale)
---

<section
  aria-label={t('page.selectedProductsCompaniesAndCommunities')}
  aria-roledescription={t('page.carousel')}
  class="min-w-0"
  data-organization-carousel
>
  <ul
    class="grid list-none gap-4 p-0"
    data-carousel-list
    id="organization-carousel-items"
  >
    {organizations.map(({ context, label, logoSurface, project }, index) => {
      const logo = project.data.coverImage?.logo
      const logoAspect: LogoAspect = project.data.coverImage?.logoAspect ?? 'square'
      const surface = logoSurface ?? project.data.coverImage?.logoSurface ?? 'dark'
      const logoDisplayWidth = logoFrameWidth[logoAspect] * 16
      const logoWidth = logo ? Math.min(logo.width, logoDisplayWidth * 4) : 0
      const logoWidths = getLogoWidths(logoDisplayWidth, logoWidth)

      return (
        <li class="min-w-0" data-carousel-item style={getProjectBrandStyle(project.data.brand)}>
          <a
            class="
              group flex h-full flex-col overflow-hidden
              focus-visible:ring-2 focus-visible:ring-brand/50
              focus-visible:outline-hidden
            "
            href={localizePath(getPortfolioPath(project.id), locale)}
          >
            <span
              data-carousel-logo
              data-logo-aspect={logoAspect}
              data-logo-surface={surface}
            >
              {logo ?
                (
                  <Image
                    alt=""
                    data-carousel-mark
                    loading="lazy"
                    sizes={`${logoFrameWidth[logoAspect]}rem`}
                    src={logo}
                    width={logoWidth}
                    widths={logoWidths}
                  />
                ) :
                (
                  <span
                    aria-hidden="true"
                    class="text-xl font-bold"
                    data-carousel-mark
                  >
                    {label.charAt(0)}
                  </span>
                )}
            </span>

            <div data-carousel-copy>
              <span aria-hidden="true" data-carousel-index>{String(index + 1).padStart(2, '0')}</span>
              <h3 data-carousel-title>{label}</h3>
              <p data-carousel-description>{context}</p>
              <span data-carousel-action>
                {t('page.readCaseStudy')}
                <ArrowExchange
                  class="size-4"
                  direction="right"
                />
              </span>
            </div>
          </a>
        </li>
      )
    })}
  </ul>

  <div data-carousel-controls hidden>
    <p aria-live="polite" class="text-sm font-medium text-ink-muted" data-carousel-status />
    <nav aria-label={t('page.chooseAnOrganization')}>
      <ol data-organization-index>
        {organizations.map(({ label }, index) => (
          <li>
            <Button aria-controls="organization-carousel-items" aria-pressed="false" data-organization-select={index} variant="ghost">
              <span data-organization-label><span data-organization-number>{String(index + 1).padStart(2, '0')}</span>{' '}<span>{label}</span></span>
            </Button>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  [data-carousel-controls] { margin-top: 1.25rem; }
  [data-organization-carousel] { container: organization-rail / inline-size; }
  [data-organization-index] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem 1rem; margin-top: 1rem; padding: 0; list-style: none; }
  [data-organization-index] li { min-width: 0; }
  [data-organization-select] { display: flex; align-items: center; justify-content: flex-start; gap: 0.625rem; min-height: 2.75rem; width: 100%; padding: 0.5rem 0; border: 0; border-top: 1px solid hsl(var(--line) / 0.65); border-radius: 0; background: transparent; color: hsl(var(--ink-soft)); font-size: 0.75rem; font-weight: 400; line-height: 1.6; text-align: left; white-space: normal; overflow-wrap: anywhere; box-shadow: none; }
  [data-organization-label] { display: flex; align-items: center; gap: 0.625rem; min-width: 0; }
  [data-organization-number] { flex-shrink: 0; font-size: 0.6875rem; }
  [data-organization-select][aria-pressed="true"] { color: var(--about-accent, hsl(var(--brand))); border-top-color: currentColor; box-shadow: inset 0 1px currentColor; }
  [data-organization-select]:hover { color: var(--about-accent, hsl(var(--brand))); text-decoration: underline; text-underline-offset: 0.25rem; }
  [data-organization-select]:focus-visible { outline: 2px solid var(--about-accent, hsl(var(--brand))); outline-offset: 3px; }
  @container organization-rail (width < 33.75rem) {
    [data-organization-index] { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 0.75rem; }
  }
  @container organization-rail (width < 16rem) {
    [data-organization-index] { grid-template-columns: minmax(0, 1fr); }
  }
  [data-carousel-item] { container: organization-card / inline-size; }
  [data-carousel-item] > a {
    padding: 0 0.75rem 0.75rem;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    text-decoration: none;
  }
  [data-carousel-logo] {
    --organization-logo-surface: hsl(var(--project-surface));
    position: relative;
    isolation: isolate;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    height: 11rem;
    margin-inline: -0.75rem;
    padding-bottom: 1rem;
    overflow: hidden;
    background: radial-gradient(ellipse at 10% 50%, hsl(var(--project-primary) / 0.06), transparent 70%), var(--organization-logo-surface);
    color: var(--color-portrait-ink);
  }
  [data-logo-surface="light"], [data-logo-surface="neutral"] {
    --organization-logo-surface: var(--color-logo-paper);
    color: var(--color-portrait-scrim);
  }
  [data-carousel-logo]::before {
    content: '';
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    right: -39%;
    bottom: -75%;
    border-radius: 40%;
    transform: rotate(-25deg);
    background: color-mix(in srgb, hsl(var(--project-primary)) 54%, var(--organization-logo-surface));
    box-shadow: 0 0 0 1.0625rem color-mix(in srgb, hsl(var(--project-primary)) 31%, var(--organization-logo-surface)), 0 0 0 2.1875rem color-mix(in srgb, hsl(var(--project-primary)) 16%, var(--organization-logo-surface)), 0 0 0 3.3125rem color-mix(in srgb, hsl(var(--project-primary)) 7%, var(--organization-logo-surface));
  }
  [data-carousel-logo]::after {
    content: '';
    position: absolute;
    width: 5rem;
    aspect-ratio: 1;
    left: -3.75rem;
    top: -3.375rem;
    border: 1px solid color-mix(in srgb, hsl(var(--project-primary)) 20%, var(--organization-logo-surface));
    border-radius: 50%;
    box-shadow: 0 0 0 0.75rem color-mix(in srgb, hsl(var(--project-primary)) 5%, var(--organization-logo-surface));
  }
  [data-carousel-mark] { position: relative; z-index: 1; width: auto; height: auto; max-width: 60%; max-height: 4.625rem; object-fit: contain; }
  [data-logo-aspect="square"] [data-carousel-mark] { max-height: 6.25rem; }
  [data-logo-aspect="tall"] [data-carousel-mark] { max-width: 30%; max-height: 5.75rem; }
  [data-carousel-copy] {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    margin-top: -1.5rem;
    padding: 1.375rem 1.125rem 1.125rem;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.125rem 1.125rem 0.25rem 1.125rem;
    background: hsl(var(--surface));
  }
  [data-carousel-index] { margin-bottom: 0.75rem; color: var(--about-accent, hsl(var(--brand))); font-size: 0.6875rem; line-height: 1.5; letter-spacing: 0.12em; }
  [data-carousel-title] { font-size: 1.5rem; font-weight: 500; line-height: 1.4; letter-spacing: -0.05em; }
  [data-carousel-description] { margin-block: 0.75rem 1.5rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.9; }
  [data-carousel-action] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid hsl(var(--line) / 0.65); color: var(--about-accent, hsl(var(--brand))); font-size: 0.75rem; font-weight: 500; line-height: 1.8; }
  [data-carousel-action] :global(svg) { flex-shrink: 0; }

  @container organization-card (width < 16rem) {
    [data-carousel-item] > a { padding-inline: 0.5rem; padding-bottom: 0.5rem; }
    [data-carousel-copy] { padding: 1rem 0.75rem; }
    [data-carousel-logo] { margin-inline: -0.5rem; }
  }
  @container organization-card (width < 14rem) {
    [data-carousel-title] { font-size: 1.125rem; }
    [data-carousel-action] { flex-wrap: wrap; }
  }

  /* Up to three columns of at least 18rem, so enlarged text earns wider cards.
     The script reads the resolved column count as the page size. */
  [data-carousel-list] {
    grid-template-columns: repeat(auto-fill, minmax(max(min(100%, 18rem), calc((100% - 2rem) / 3)), 1fr));
  }
</style>

<script>
  import { getLocale, sharedTranslator } from '@/i18n'

  const initializeOrganizationCarousels = (): void => {
    const t = sharedTranslator(() => getLocale(window.location.pathname))
    const carousels = document.querySelectorAll<HTMLElement>('[data-organization-carousel]')

    for (const carousel of carousels) {
      if (carousel.dataset.carouselBound === 'true') continue

      const list = carousel.querySelector<HTMLElement>('[data-carousel-list]')
      const items = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-item]')]
      const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]')
      const selectors = [...carousel.querySelectorAll<HTMLButtonElement>('[data-organization-select]')]
      const status = carousel.querySelector<HTMLElement>('[data-carousel-status]')

      if (!list || !controls || !status || items.length === 0 || selectors.length !== items.length) continue

      carousel.dataset.carouselBound = 'true'

      const controller = new AbortController()
      const { signal } = controller
      let selectedIndex = 0
      let resizeFrame = 0
      // The grid's resolved columns are the single source of the page size, so
      // root text scaling and container width both apply.
      const getPageSize = (): number => Math.max(1, getComputedStyle(list).gridTemplateColumns.split(' ').filter(Boolean).length)

      const render = (): void => {
        const pageSize = getPageSize()
        const focusedElement = document.activeElement
        const focusedIndex = items.findIndex(item => item.contains(focusedElement))
        const maximumStart = Math.max(0, items.length - pageSize)
        const currentStart = Math.min(selectedIndex, maximumStart)

        // Resizing may change the page size. Keep the focused case study visible
        // so a keyboard user never loses their place to a hidden card.
        if (focusedIndex >= 0 && (focusedIndex < currentStart || focusedIndex >= currentStart + pageSize)) {
          selectedIndex = focusedIndex
        }

        const startIndex = Math.min(selectedIndex, maximumStart)

        for (const [index, item] of items.entries()) {
          item.hidden = index < startIndex || index >= startIndex + pageSize
        }

        for (const [index, selector] of selectors.entries()) selector.setAttribute('aria-pressed', String(index === selectedIndex))

        controls.hidden = items.length <= pageSize

        const statusText = pageSize === 1 ?
          t('carousel.showingOne', { start: startIndex + 1, total: items.length }) :
          t('carousel.showingRange', { start: startIndex + 1, end: Math.min(startIndex + pageSize, items.length), total: items.length })

        if (status.textContent !== statusText) status.textContent = statusText

        // Content above the carousel also reflows. Keep the active link on screen
        // after the new layout settles, without adding scrolling animation.
        if (focusedIndex >= 0 && focusedElement instanceof HTMLElement) {
          focusedElement.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' })
        }
      }

      for (const [index, selector] of selectors.entries()) {
        selector.addEventListener('click', () => {
          selector.focus()

          selectedIndex = index

          render()
        }, { signal })
      }

      // Viewport and root text changes both resize the list, through its width or card heights.
      const resizeObserver = new ResizeObserver(() => {
        window.cancelAnimationFrame(resizeFrame)

        resizeFrame = window.requestAnimationFrame(render)
      })

      resizeObserver.observe(list)

      document.addEventListener('astro:before-swap', () => {
        window.cancelAnimationFrame(resizeFrame)

        resizeObserver.disconnect()

        controller.abort()
      }, { once: true })

      render()
    }
  }

  document.addEventListener('astro:page-load', initializeOrganizationCarousels)

  initializeOrganizationCarousels()
</script>
