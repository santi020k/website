---
interface Props {
  description: string
  label: string
  value: string
}

const { description, label, value } = Astro.props
---

<article class="panel-surface rounded-[1.5rem] p-6">
  <p class="text-3xl font-bold tracking-[-0.05em] text-ink sm:text-4xl">{value}</p>
  <p class="mt-3 text-sm font-semibold uppercase tracking-[0.2em] text-ink-muted">{label}</p>
  <p class="mt-3 text-sm leading-6 text-ink-soft">{description}</p>
</article>
