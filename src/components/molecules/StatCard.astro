---
import { AnimatedNumber, Stat } from '@santi020k/lumen-astro'

interface Props {
  description?: string
  label: string
  suffix?: string
  value: number | string
}

const { description, label, suffix = '', value } = Astro.props
---

<Stat
  as="article"
  class="h-full"
  label={label}
  {...(typeof value === 'string' ? { value } : {})}
  variant="accent"
>
  {typeof value === 'number' && (
    <AnimatedNumber
      class="
        editorial-page-emphasis text-[2rem]/[1.1] font-medium
        tracking-[-0.055em]
      "
      locale="en-US"
      suffix={suffix}
      value={value}
    />
  )}
  {description && <p class="mt-2 text-sm/6 text-ink-soft">{description}</p>}
</Stat>
