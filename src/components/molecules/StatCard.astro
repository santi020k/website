---
interface Props {
  description: string
  label: string
  value: string
}

const { description, label, value } = Astro.props
---

<article class="rounded-3xl p-6 panel-surface">
  <p class="
    text-3xl font-bold tracking-[-0.05em] text-ink
    sm:text-4xl
  "
  >{value}
  </p>
  <p class="
    mt-3 text-sm font-semibold tracking-[0.2em] text-ink-muted uppercase
  "
  >{label}
  </p>
  <p class="mt-3 text-sm/6 text-ink-soft">{description}</p>
</article>
