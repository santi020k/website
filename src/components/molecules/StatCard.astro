---
interface Props {
  description: string
  label: string
  value: string
}

const { description, label, value } = Astro.props
---

<article class="
  panel-card h-full p-6 transition duration-300
  hover:-translate-y-0.5 hover:border-brand/25
  motion-reduce:transition-none
  motion-reduce:hover:translate-y-0
  sm:p-7
"
>
  <p class="section-label">{label}</p>
  <p class="
    mt-4 text-4xl font-bold tracking-[-0.06em] text-ink
    sm:text-5xl
  "
  ><span class="text-brand">{value}</span>
  </p>
  <p class="mt-4 max-w-xs text-sm/6 text-ink-soft">{description}</p>
</article>
