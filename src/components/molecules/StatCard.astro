---
interface Props {
  description: string
  label: string
  value: string
}

const { description, label, value } = Astro.props
---

<article class="
  h-full border-t border-line/70 pt-4 transition-colors duration-200
  hover:border-brand/35
  motion-reduce:transition-none
"
>
  <p class="section-label">{label}</p>
  <p class="
    mt-5 text-4xl font-bold tracking-[-0.06em] text-ink
    sm:text-5xl
  "
  ><span class="text-brand">{value}</span>
  </p>
  <p class="mt-3 max-w-[24ch] text-sm/6 text-ink-soft">{description}</p>
</article>
