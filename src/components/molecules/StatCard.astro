---
import { Stat } from '@santi020k/lumen-astro'

interface Props {
  description?: string
  label: string
  value: string
}

const { description, label, value } = Astro.props
---

<article class="h-full">
  <Stat
    className="h-full"
    label={label}
    value={value}
  >
    {description && <p class="mt-2 text-sm/6 text-ink-soft">{description}</p>}
  </Stat>
</article>
