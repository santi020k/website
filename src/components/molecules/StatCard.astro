---
import { Stat } from '@santi020k/lumen-astro'

type StatVariant = 'accent' | 'default' | 'glass'

interface Props {
  description?: string
  label: string
  value: string
  variant?: StatVariant
}

const { description, label, value, variant = 'accent' } = Astro.props
const variantClasses: Record<StatVariant, string | false> = {
  accent: 'ui-stat--accent',
  default: false,
  glass: 'ui-stat--glass'
}
---

<article class="h-full">
  <Stat
    class:list={['h-full', variantClasses[variant]]}
    data-stat-card-compat
    data-variant={variant}
    label={label}
    value={value}
  >
    {description && <p class="mt-2 text-sm/6 text-ink-soft">{description}</p>}
  </Stat>
</article>

<!-- Remove these compatibility rules after adopting @santi020k/lumen-astro 0.4.0. -->
<style is:global>
  [data-stat-card-compat].ui-stat--accent,
  [data-stat-card-compat].ui-stat--glass {
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--ui-radius-lg);
  }

  [data-stat-card-compat].ui-stat--accent {
    border-color: hsl(var(--brand) / 0.2);
    background: linear-gradient(145deg, hsl(var(--surface)), hsl(var(--brand-soft) / 0.28));
    box-shadow: var(--ui-shadow-sm);
  }

  [data-stat-card-compat].ui-stat--glass {
    border-color: hsl(var(--glass-border));
    background:
      radial-gradient(140% 100% at 12% -8%, hsl(var(--glass-highlight)) 0%, transparent 42%),
      radial-gradient(120% 90% at 88% 110%, hsl(var(--glass-refraction)) 0%, transparent 44%),
      hsl(var(--glass-bg));
    box-shadow:
      inset 0 1px 0 hsl(var(--glass-edge)),
      inset 0 0 0 1px hsl(var(--glass-edge-soft)),
      inset 0 -20px 32px -20px hsl(var(--glass-shade)),
      var(--glass-shadow);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate))
      brightness(var(--glass-brightness));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate))
      brightness(var(--glass-brightness));
  }

  [data-stat-card-compat].ui-stat--accent .ui-stat-value,
  [data-stat-card-compat].ui-stat--glass .ui-stat-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  [data-stat-card-compat].ui-stat--accent .ui-stat-value {
    color: hsl(var(--brand));
  }

  @media (prefers-reduced-transparency: reduce) {
    [data-stat-card-compat].ui-stat--glass {
      background: hsl(var(--surface));
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
