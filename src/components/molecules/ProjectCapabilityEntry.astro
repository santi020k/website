---
interface Props {
  number: number
  title: string
}

const { number, title } = Astro.props
---

<li data-project-capability>
  <span aria-hidden="true" data-capability-number>{String(number).padStart(2, '0')}</span>
  <h4>{title}</h4>
  <div data-capability-copy><slot /></div>
</li>

<style>
  [data-project-capability] {
    --capability-accent: var(--brand);
    min-width: 0;
    margin: 0;
    border-top: 1px solid hsl(var(--line));
    padding-top: 1.5rem;
    overflow-wrap: anywhere;
  }
  :global([data-theme='dark']) [data-project-capability] { --capability-accent: var(--accent); }
  [data-capability-number] { display: block; margin-bottom: 0.75rem; color: hsl(var(--capability-accent)); font-size: 0.75rem; line-height: 1.5; font-weight: 500; }
  [data-project-capability] h4 { margin: 0 0 0.75rem; color: hsl(var(--ink)); font: 500 1.25rem/1.4 var(--font-sans); letter-spacing: -0.02em; }
  [data-capability-copy] :global(p) { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.733; }
  [data-capability-copy] :global(code) { border-radius: 0.25rem; background: hsl(var(--brand-soft)); padding: 0.125rem 0.25rem; color: hsl(var(--capability-accent)); font-size: 0.9em; overflow-wrap: anywhere; }
</style>
