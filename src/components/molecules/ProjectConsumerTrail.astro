---
import { Icon, Link } from '@santi020k/lumen-astro'

interface Props {
  introduction: string
  responsibility: string
  examples: {
    label: string
    href: string
    description: string
    component: string
  }[]
}

const { introduction, responsibility, examples } = Astro.props
---

<div class="not-prose" data-project-consumer-trail>
  <p data-consumer-introduction>{introduction}</p>
  <nav aria-label="See Lumen in use" data-consumer-examples>
    {examples.map(example => (
      <Link
        href={example.href}
        variant="inherit"
        data-consumer-link
      >
        <strong>{example.label}</strong>
        <span data-consumer-description>{example.description} <code>{example.component}</code>.</span>
        <span data-consumer-arrow><Icon name="arrow-up-right" size="sm" /></span>
      </Link>
    ))}
  </nav>
  <p data-consumer-responsibility>{responsibility}</p>
  <div data-consumer-learning><slot /></div>
</div>

<style>
  [data-project-consumer-trail] {
    --consumer-accent: var(--brand);
    container: consumer-trail / inline-size;
    color: hsl(var(--ink-soft));
  }
  :global([data-theme='dark']) [data-project-consumer-trail] { --consumer-accent: var(--accent); }
  [data-consumer-introduction] { margin: 0; font-size: 1.125rem; line-height: 1.8; overflow-wrap: anywhere; }
  [data-consumer-examples] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-block: 1.75rem; }
  [data-consumer-link][data-slot='link'] {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    gap: 0.625rem 0.75rem;
    min-width: 0;
    min-height: 2.75rem;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.5rem;
    color: hsl(var(--consumer-accent));
    text-decoration: none;
  }
  [data-consumer-link] strong { min-width: 0; color: hsl(var(--ink)); font-size: 1.125rem; font-weight: 500; line-height: 1.5; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  [data-consumer-description] { grid-column: 1; min-width: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.75; overflow-wrap: anywhere; }
  [data-consumer-description] code { border-radius: 0.25rem; background: hsl(var(--brand-soft) / 0.45); padding: 0.125rem 0.25rem; color: hsl(var(--consumer-accent)); font-size: 0.85em; }
  [data-consumer-arrow] { grid-column: 2; grid-row: 1; align-self: center; }
  [data-consumer-link]:is(:hover, :focus-visible) strong { color: hsl(var(--consumer-accent)); text-decoration: underline; text-underline-offset: 0.25rem; }
  [data-project-consumer-trail] :global(a:focus-visible) { outline: 2px solid hsl(var(--consumer-accent)); outline-offset: 4px; }
  [data-consumer-responsibility] { margin: 0; font-size: 1rem; line-height: 1.8; overflow-wrap: anywhere; }
  [data-consumer-learning] { margin-top: 1.5rem; }
  [data-consumer-learning] :global(p) { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.8; overflow-wrap: anywhere; }
  [data-consumer-learning] :global(a) { color: hsl(var(--consumer-accent)); text-decoration: underline; text-underline-offset: 0.25rem; }

  @container consumer-trail (width < 35rem) {
    [data-consumer-introduction] { font-size: 1.0625rem; }
    [data-consumer-examples] { grid-template-columns: minmax(0, 1fr); gap: 0; }
    [data-consumer-link] + [data-consumer-link] { border-top: 0; }
  }
  @container consumer-trail (width < 16rem) {
    [data-consumer-link][data-slot='link'] { grid-template-columns: minmax(0, 1fr); }
    [data-consumer-arrow] { display: none; }
  }
</style>
