---
import type { CollectionEntry } from 'astro:content'

import ProjectTimeline from '@/components/atoms/ProjectTimeline.astro'

import { getProjectDurationLabel, getProjectTypeLabel } from '@/utils/project-meta'

import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  project: CollectionEntry<'project'>
}

const { project } = Astro.props
---

<Card as="section" aria-labelledby="sidebar-glance" data-project-glance variant="unstyled">
  <header>
    <h2 id="sidebar-glance">At a glance<Icon class="size-4 shrink-0" name="info" /></h2>
    <dl data-glance-role>
      <div>
        <dt>Role</dt>
        <dd>{project.data.role ?? 'Hands-on builder'}</dd>
      </div>
    </dl>
  </header>
  <dl data-glance-facts>
    <div>
      <dt>Type</dt>
      <dd>{getProjectTypeLabel(project.data.typesId)}</dd>
    </div>
    <div>
      <dt>Timeline</dt>
      <dd><ProjectTimeline endingDate={project.data.endingDate} startingDate={project.data.startingDate} /></dd>
    </div>
    <div>
      <dt>Duration</dt>
      <dd>{getProjectDurationLabel(project.data.startingDate, project.data.endingDate)}</dd>
    </div>
  </dl>
</Card>

<style>
  [data-project-glance][data-slot='card'] {
    padding: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  header { padding: 1.5rem; }
  [data-project-glance] h2 { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin: 0; color: hsl(var(--brand)); font-size: 0.75rem; line-height: 1.667; font-weight: 500; letter-spacing: normal; }
  :global(:root[data-theme='dark']) [data-project-glance] h2 { color: hsl(var(--accent)); }
  dl, dt, dd { margin: 0; }
  dt { color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  dd { margin-top: 0.25rem; font-size: 0.875rem; line-height: 1.714; font-weight: 500; }
  [data-glance-role] { margin-top: 1.375rem; }
  [data-glance-role] dd { margin-top: 0.5rem; font-size: 1.125rem; line-height: 1.611; letter-spacing: -0.02em; }
  [data-glance-facts] { padding: 0 1.5rem 0.625rem; }
  [data-glance-facts] > div { padding-block: 1rem; border-top: 1px solid hsl(var(--line)); }
  @container (width < 16rem) {
    header { padding-inline: 0.75rem; }
    [data-glance-facts] { padding-inline: 0.75rem; }
  }
</style>
