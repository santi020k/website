---
import { Button, Dialog, Icon, Kbd, SearchField } from '@santi020k/lumen-astro'
---

<Dialog
  aria-labelledby="site-search-title"
  class="
    fixed inset-0 z-100 m-0 size-full max-h-none max-w-none border-0
    bg-transparent p-0
  "
  data-site-search-dialog
  id="site-search-dialog"
  layout="fullscreen"
>
  <div data-site-search-shell>
    <div aria-hidden="true" data-site-search-scrim></div>
    <div data-site-search-panel role="document">
      <div data-site-search-heading>
        <div data-site-search-identity>
          <span aria-hidden="true" data-site-search-label>Site index</span>
          <h2 id="site-search-title">Search</h2>
        </div>
        <Button data-site-search-close size="icon" type="button" variant="ghost">
          <Icon class="size-5" name="x" />
          <span class="sr-only">Close search</span>
        </Button>
      </div>

      <div data-site-search-body>
        <p data-site-search-description>Posts, projects, and community.</p>
        <div data-site-search-field>
          <Icon class="size-5 shrink-0" name="search" />
          <label class="sr-only" for="site-search-input">Search posts, projects, and community work</label>
          <SearchField
            aria-describedby="site-search-help"
            autocomplete="off"
            class="peer"
            id="site-search-input"
            placeholder="Search the site…"
            spellcheck="false"
            type="search"
          />
          <Button
            aria-label="Clear search"
            class="peer-placeholder-shown:invisible"
            data-site-search-input-clear
            size="icon"
            type="button"
            variant="ghost"
          >
            <Icon class="size-4" name="x" />
          </Button>
        </div>

        <p aria-atomic="true" aria-live="polite" class="sr-only" id="site-search-status"></p>
        <ul id="site-search-results"></ul>

        <div data-site-search-footer id="site-search-help">
          <span><Kbd><span aria-hidden="true">↑ ↓</span><span class="sr-only">Arrow keys</span></Kbd> Move</span>
          <span><Kbd><span aria-hidden="true">↵</span><span class="sr-only">Enter</span></Kbd> Open</span>
          <span><Kbd>Esc</Kbd> Close</span>
        </div>
      </div>
    </div>
  </div>
</Dialog>

<style is:global>
  #site-search-dialog [data-site-search-shell] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 8dvh, 6rem) 1.25rem max(1rem, env(safe-area-inset-bottom));
    pointer-events: none;
  }

  #site-search-dialog [data-site-search-scrim] {
    position: absolute;
    inset: 0;
    pointer-events: auto;
  }

  #site-search-dialog [data-site-search-panel] {
    --search-inset: 1.75rem;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 42rem;
    max-height: 100%;
    color: hsl(var(--ink));
    pointer-events: auto;
  }

  #site-search-dialog [data-site-search-identity] {
    position: relative;
    padding: 1.125rem var(--search-inset) 0.875rem;
    border-radius: 1.5rem 1.5rem 0 0;
    background: hsl(var(--surface));
    isolation: isolate;
  }

  #site-search-dialog [data-site-search-identity]::after {
    position: absolute;
    z-index: -1;
    right: -1.75rem;
    bottom: 0;
    width: 2.25rem;
    height: 3.5rem;
    background: hsl(var(--surface));
    content: '';
    clip-path: polygon(0 0, 30% 0, 100% 100%, 0 100%);
  }

  #site-search-dialog [data-site-search-label] {
    display: block;
    margin-bottom: 0.25rem;
    color: hsl(var(--ink-soft));
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  #site-search-dialog [data-site-search-heading] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-right: 0.375rem;
  }

  #site-search-title {
    font-size: 1.875rem;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.25;
  }

  #site-search-dialog [data-site-search-body] {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-radius: 0 1.5rem 1.5rem 1.5rem;
    background: hsl(var(--surface));
    box-shadow: var(--shadow-nav-scrolled);
  }

  #site-search-dialog [data-site-search-description] {
    padding: 1.125rem var(--search-inset) 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
  }

  #site-search-dialog :is([data-site-search-close], [data-site-search-input-clear]) {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    background: transparent;
    color: hsl(var(--ink-soft));
    box-shadow: none;
  }

  #site-search-dialog [data-site-search-close] {
    background: hsl(var(--brand-soft));
    color: hsl(var(--brand));
  }

  :root[data-theme="dark"] #site-search-dialog [data-site-search-close] { color: hsl(var(--accent)); }

  #site-search-dialog :is([data-site-search-close], [data-site-search-input-clear]):hover {
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink));
  }

  #site-search-dialog [data-site-search-field] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem var(--search-inset) 0;
    padding: 0.25rem 0;
    border-bottom: 1px solid hsl(var(--line));
    background: transparent;
    color: hsl(var(--ink-soft));
  }

  #site-search-dialog [data-site-search-field]:focus-within {
    border-color: hsl(var(--accent));
    box-shadow: 0 1px 0 hsl(var(--accent));
  }

  #site-search-input {
    width: 100%;
    min-width: 0;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: hsl(var(--ink));
    font-size: 1.125rem;
    box-shadow: none;
    outline: none;
  }

  #site-search-input::placeholder { color: hsl(var(--ink-soft)); opacity: 1; }
  #site-search-input::-webkit-search-cancel-button { appearance: none; }
  #site-search-dialog [data-site-search-input-clear] { border-color: transparent; }

  #site-search-results {
    flex: 0 1 auto;
    min-height: 0;
    margin: 1.25rem var(--search-inset);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.25rem;
    scrollbar-gutter: stable;
    list-style: none;
  }

  #site-search-dialog [data-site-search-footer] {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.25rem;
    padding: 0.875rem var(--search-inset);
    border-top: 1px solid hsl(var(--line) / 0.6);
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    line-height: 1rem;
  }

  #site-search-dialog [data-site-search-footer] > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  #site-search-dialog [data-site-search-footer] > span:last-child { margin-left: auto; }

  #site-search-dialog kbd {
    min-width: 1.5rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.25rem;
    background: hsl(var(--surface-muted));
    color: hsl(var(--ink-soft));
    font-size: 0.625rem;
    box-shadow: none;
  }

  #site-search-dialog :is(a, button):focus-visible {
    outline: 2px solid hsl(var(--accent));
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    #site-search-dialog [data-site-search-panel] { --search-inset: 1rem; }
    #site-search-dialog [data-site-search-footer] { gap: 0.75rem; flex-wrap: wrap; }
  }

  @media (max-height: 500px) {
    #site-search-dialog [data-site-search-shell] { padding-block: 0.75rem 0.5rem; }
    #site-search-dialog [data-site-search-identity] { padding-block: 0.5rem; }
    #site-search-dialog [data-site-search-label],
    #site-search-dialog [data-site-search-description] { display: none; }
    #site-search-dialog [data-site-search-identity]::after { height: 2rem; }
    #site-search-dialog [data-site-search-field] { margin-top: 0.75rem; }
    #site-search-results { margin-block: 0.75rem; }
  }
</style>
