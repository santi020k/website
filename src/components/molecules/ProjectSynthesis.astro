---
interface Props {
  headingId: string
  introduction: string
  perspectives: { name: string, description: string }[]
  takeaway: { lead: string, emphasis: string }
}

const { headingId, introduction, perspectives, takeaway } = Astro.props
---

<section aria-labelledby={headingId} class="not-prose" data-project-synthesis>
  <header>
    <p data-synthesis-label>What carries forward</p>
    <slot />
  </header>
  <p data-synthesis-introduction>{introduction}</p>
  <ul data-synthesis-perspectives role="list">
    {perspectives.map(perspective => (
      <li>
        <h3>{perspective.name}</h3>
        <p>{perspective.description}</p>
      </li>
    ))}
  </ul>
  <p data-synthesis-takeaway>{takeaway.lead}{' '}<strong>{takeaway.emphasis}</strong></p>
</section>

<style>
  [data-project-synthesis] { container: project-synthesis / inline-size; margin-block: 3rem; color: hsl(var(--ink)); }
  [data-synthesis-label] { display: flex; align-items: center; gap: 1rem; margin: 0 0 1.125rem; color: hsl(var(--brand)); font: 500 0.6875rem/1.7 var(--font-sans); }
  [data-synthesis-label]::after { content: ''; flex: 1; height: 1px; background: hsl(var(--line)); }
  :global([data-theme='dark']) [data-synthesis-label] { color: hsl(var(--accent)); }
  [data-project-synthesis] :global(h2) { margin: 0; border: 0; padding: 0; color: hsl(var(--ink)); font: 500 2rem/1.25 var(--font-sans); letter-spacing: -0.035em; overflow-wrap: anywhere; scroll-margin-top: 9rem; }
  [data-project-synthesis] :global(h2::after) { content: none; }
  [data-synthesis-introduction] { margin: 1.5rem 0 0; color: hsl(var(--ink-soft)); font-size: 1.125rem; line-height: 1.8; }
  [data-synthesis-perspectives] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  [data-synthesis-perspectives] li { min-width: 0; margin: 0; border-top: 1px solid hsl(var(--line)); padding-top: 1.25rem; }
  [data-synthesis-perspectives] h3 { margin: 0; color: hsl(var(--ink)); font: 500 1.125rem/1.5 var(--font-sans); letter-spacing: -0.02em; overflow-wrap: anywhere; }
  [data-synthesis-perspectives] p { margin: 0.625rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.9375rem; line-height: 1.8; }
  [data-synthesis-takeaway] { margin: 1.75rem 0 0; border-top: 1px solid hsl(var(--line)); padding-top: 1.5rem; font-size: 1.125rem; line-height: 1.75; }
  [data-synthesis-takeaway] strong { font-weight: 500; }
  @container project-synthesis (width < 35rem) {
    [data-project-synthesis] :global(h2) { font-size: 1.875rem; }
    [data-synthesis-introduction], [data-synthesis-takeaway] { font-size: 1rem; line-height: 1.75; }
    [data-synthesis-perspectives] { grid-template-columns: minmax(0, 1fr); gap: 1.375rem; }
  }
</style>
