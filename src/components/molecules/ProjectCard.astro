---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath, getTechnologyPath } from '../../utils/links'
import FormattedDate from '../atoms/FormattedDate.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  className?: string
  featured?: boolean
  project: CollectionEntry<'project'>
}

const { className = '', featured = false, project } = Astro.props
const projectLink = getPortfolioPath(project.id)
const imageSizes = featured ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
---

<article
  class:list={[
    `
      group panel-card relative overflow-hidden transition duration-300
      hover:-translate-y-0.5 hover:border-brand/25
      motion-reduce:transition-none
      motion-reduce:hover:translate-y-0
    `,
    featured ?
      `
        grid
        lg:grid-cols-[minmax(0,1.12fr)_minmax(0,0.88fr)] lg:items-stretch
      ` :
      'flex h-full flex-col',
    className
  ]}
>
  <a aria-label={project.data.title} class="block" href={projectLink}>
    <div
      class:list={[
        'relative overflow-hidden bg-surface-muted',
        featured ?
          `
            aspect-16/10 border-b border-line/45
            lg:aspect-auto lg:h-full lg:min-h-92 lg:border-r lg:border-b-0
          ` :
          'aspect-16/10 border-b border-line/45'
      ]}
    >
      {project.data.coverImage?.src ?
        (
          <Image
            alt={project.data.coverImage.alt || project.data.title}
            class="
              size-full object-cover transition duration-500
              group-hover:scale-[1.03]
              motion-reduce:transform-none motion-reduce:transition-none
            "
            height={720}
            loading="lazy"
            sizes={imageSizes}
            src={project.data.coverImage.src}
            width={1280}
            widths={[400, 800, 1200]}
          />
        ) :
        (
          <div class="size-full grid-fade" />
        )}
      <div class="
        absolute inset-0 bg-linear-to-t from-canvas/55 via-canvas/10
        to-transparent
      "
      />
    </div>
  </a>

  <div class:list={[`
    flex grow flex-col gap-6 p-6
    sm:p-7
  `, featured && `
    justify-between
    lg:p-8
  `]}
  >
    <div class="
      flex flex-wrap items-center gap-2 text-sm text-ink-muted
      sm:gap-3
    "
    >
      {featured && <Pill label="Featured case study" tone="brand" />}
      {project.data.rol && <span>{project.data.rol}</span>}
      {project.data.rol && (
        <span
          aria-hidden="true"
          class="size-1 rounded-full bg-line"
        />
      )}
      <FormattedDate date={project.data.startingDate} />
      <span aria-hidden="true">-</span>
      {project.data.endingDate ? <FormattedDate date={project.data.endingDate} /> : <span>Present</span>}
    </div>

    <div class="space-y-3">
      <h3
        class:list={[
          `
            leading-tight transition-colors duration-200
            group-hover:text-brand
            motion-reduce:transition-none
          `,
          featured ?
            `
              text-[1.95rem]
              sm:text-[2.3rem]
            ` :
            'text-[1.7rem]'
        ]}
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={projectLink}
        >
          {project.data.title}
        </a>
      </h3>
      <p class:list={[featured ?
        'max-w-2xl text-base/7' :
        'line-clamp-4 text-sm/7', 'text-ink-soft']}
      >
        {project.data.description}
      </p>
    </div>

    <div class="mt-auto flex flex-wrap gap-2">
      {project.data.technologies.slice(0, featured ? 5 : 4).map(technology => (
        <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
      ))}
      {project.data.technologies.length > (featured ? 5 : 4) && (
        <Pill label={`+${project.data.technologies.length - (featured ? 5 : 4)} more`} tone="neutral" />
      )}
    </div>
  </div>
</article>
