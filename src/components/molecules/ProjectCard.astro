---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import CoverImage from '@/components/atoms/CoverImage.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPortfolioPath, getTechnologyPath } from '@/utils/links'
import { getProjectDateRangeLabel, getProjectTypeLabel } from '@/utils/project-meta'
import { sortTechnologiesByInterest } from '@/utils/technologies'

interface Props {
  className?: string
  featured?: boolean
  project: CollectionEntry<'project'>
}

const { className = '', featured = false, project } = Astro.props
const projectLink = getPortfolioPath(project.id)
const technologyLimit = featured ? 5 : 4
const sortedTechnologies = sortTechnologiesByInterest(project.data.technologies)
const hiddenTechnologyCount = Math.max(0, sortedTechnologies.length - technologyLimit)
const hiddenTechnologyLabel = `+${hiddenTechnologyCount} ${hiddenTechnologyCount === 1 ? 'technology' : 'technologies'}`

const imageSizes = featured ?
  '(min-width: 1024px) 72vw, 100vw' :
  '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'

const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const projectYearsLabel = getProjectDateRangeLabel(project.data.startingDate, project.data.endingDate)
const useImageOverlay = Boolean(project.data.coverImage?.src)
const visibleImpactMetrics = project.data.impactMetrics.slice(0, featured ? 3 : 2)
---

<article
  class:list={[
    `
      group panel-card relative overflow-hidden transition duration-300
      hover:-translate-y-0.5 hover:border-brand/25
      motion-reduce:transition-none
      motion-reduce:hover:translate-y-0
    `,
    'flex flex-col',
    className
  ]}
>
  <a aria-label={project.data.title} class="relative block overflow-hidden" href={projectLink}>
    {project.data.coverImage?.src ?
      (
        <>
          <CoverImage
            alt={project.data.coverImage.alt || project.data.title}
            featured={featured}
            image={project.data.coverImage.src}
            mode="card"
            sizes={imageSizes}
          />
          {useImageOverlay && (
            <>
              <div
                aria-hidden="true"
                class="
                  pointer-events-none absolute inset-x-0 bottom-0 h-32
                  bg-linear-to-t from-canvas/88 via-canvas/16 to-transparent
                "
              >
              </div>
              <div class="
                pointer-events-none absolute inset-x-0 top-0 flex items-start
                justify-between gap-3 p-4
                sm:p-5
              "
              >
                <Pill label={featured ? 'Featured case study' : projectTypeLabel} tone="brand" />
                <span class="
                  rounded-full border border-white/12 bg-canvas/60 px-3 py-1.5
                  text-xs font-semibold tracking-[0.16em] text-white/80
                  uppercase backdrop-blur-sm
                "
                >{projectYearsLabel}
                </span>
              </div>
            </>
          )}
        </>
      ) :
      (
        <div class="
          aspect-16/10 border-b border-line/45 bg-surface-muted grid-fade
        "
        />
      )}
  </a>

  <div class:list={[`
    flex grow flex-col gap-6 p-6
    sm:p-7
  `, featured && `
    justify-between
    lg:p-8
  `]}
  >
    <div class="
      flex flex-wrap items-center gap-2 text-sm text-ink-muted
      sm:gap-3
    "
    >
      {featured && !useImageOverlay && <Pill label="Featured case study" tone="brand" />}
      {!featured && <Pill label={projectTypeLabel} tone="outline" />}
      {project.data.rol && <span>{project.data.rol}</span>}
      {project.data.rol && (
        <span
          aria-hidden="true"
          class="size-1 rounded-full bg-line"
        />
      )}
      <FormattedDate date={project.data.startingDate} />
      <span aria-hidden="true">-</span>
      {project.data.endingDate ? <FormattedDate date={project.data.endingDate} /> : <span>Present</span>}
    </div>

    <div class="space-y-3">
      <h3
        class:list={[
          `
            leading-tight transition-colors duration-200
            group-hover:text-brand
            motion-reduce:transition-none
          `,
          featured ?
            `
              text-[1.95rem]
              sm:text-[2.3rem]
            ` :
            'text-[1.7rem]'
        ]}
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={projectLink}
        >
          {project.data.title}
        </a>
      </h3>
      <p
        class:list={[
          featured ? 'max-w-2xl text-base/7' : 'line-clamp-4 text-sm/7',
          'text-ink-soft'
        ]}
      >
        {project.data.description}
      </p>

      {!!visibleImpactMetrics.length && (
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {visibleImpactMetrics.map(metric => (
            <li class="
              rounded-full border border-brand/15 bg-brand-soft/55 px-3 py-1.5
              text-xs font-semibold text-brand
            "
            >
              {metric}
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {sortedTechnologies.slice(0, technologyLimit).map(technology => (
          <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
        ))}
        {hiddenTechnologyCount > 0 && (
          <Pill href={`${projectLink}#technologies`} label={hiddenTechnologyLabel} tone="neutral" />
        )}
      </div>

      <ButtonLink
        ariaLabel={`Read case study about ${project.data.title}`}
        href={projectLink}
        showArrow
        variant="inline"
      >
        Read case study
      </ButtonLink>
    </div>
  </div>
</article>
