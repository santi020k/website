---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import CoverImage from '@/components/atoms/CoverImage.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPortfolioPath, getTechnologyPath } from '@/utils/links'
import { getProjectFeaturedLabel, getProjectTimelineLabel, getProjectTypeLabel } from '@/utils/project-meta'
import { sortTechnologiesByInterest } from '@/utils/technologies'

interface Props {
  className?: string
  coverFeatured?: boolean
  featured?: boolean
  project: CollectionEntry<'project'>
}

const { className = '', coverFeatured, featured = false, project } = Astro.props
const projectLink = getPortfolioPath(project.id)
const technologyLimit = featured ? 5 : 4
const sortedTechnologies = sortTechnologiesByInterest(project.data.technologies)
const hiddenTechnologyCount = Math.max(0, sortedTechnologies.length - technologyLimit)
const hiddenTechnologyLabel = `+${hiddenTechnologyCount} ${hiddenTechnologyCount === 1 ? 'technology' : 'technologies'}`
const useCoverFeatured = coverFeatured ?? featured

const imageSizes = useCoverFeatured ?
  '(min-width: 1024px) 72vw, 100vw' :
  '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'

const projectTypeLabel = getProjectTypeLabel(project.data.typesId)
const projectFeaturedLabel = getProjectFeaturedLabel(project.data.typesId)
const projectTimelineLabel = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const isActive = !project.data.endingDate
const visibleImpactMetrics = project.data.impactMetrics.slice(0, featured ? 3 : 2)
---

<article
  class:list={[
    'group card-interactive',
    className
  ]}
>
  <a
    aria-label={project.data.title}
    class:list={[
      'block',
      featured ?
        `
          px-4 pt-4
          sm:px-5 sm:pt-5
        ` :
        `
          px-3 pt-3
          sm:px-4 sm:pt-4
        `
    ]}
    href={projectLink}
  >
    <span class="sr-only">{project.data.title}</span>
    {project.data.coverImage?.src ?
      (
        <CoverImage
          alt={project.data.coverImage.alt || project.data.title}
          className="
            rounded-[1.35rem] border border-line/40
            shadow-[0_18px_42px_hsl(var(--ink)/0.08)]
          "
          featured={useCoverFeatured}
          image={project.data.coverImage.src}
          loading={useCoverFeatured ? 'eager' : 'lazy'}
          mode="card"
          showCardOverlay={false}
          sizes={imageSizes}
        />
      ) :
      (
        <div
          class="
            aspect-16/10 rounded-[1.35rem] border border-line/40
            bg-surface-muted grid-fade
          "
        />
      )}
  </a>

  <div class:list={[`
    flex grow flex-col gap-5 p-6 pt-5
    sm:p-7 sm:pt-6
  `, featured && `
    justify-between
    lg:p-8 lg:pt-7
  `]}
  >
    <div class="space-y-3">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="
          flex flex-wrap items-center gap-2
          sm:gap-3
        "
        >
          <Pill label={featured ? projectFeaturedLabel : projectTypeLabel} tone={featured ? 'brand' : 'outline'} />
          {project.data.role && (
            <span class="text-sm font-medium text-ink-muted">
              {project.data.role}
            </span>
          )}
        </div>

        <Pill label={isActive ? 'Active' : 'Completed'} tone={isActive ? 'brand' : 'neutral'} />
      </div>

      <p class="text-sm text-ink-muted">
        {projectTimelineLabel}
      </p>
    </div>

    <div class="space-y-3">
      <h3
        class:list={[
          `
            leading-tight transition-colors duration-200
            group-hover:text-brand
            motion-reduce:transition-none
          `,
          featured ?
            `
              text-[1.95rem]
              sm:text-[2.3rem]
            ` :
            'text-[1.7rem]'
        ]}
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={projectLink}
        >
          {project.data.title}
        </a>
      </h3>
      <p
        class:list={[
          featured ? 'max-w-2xl text-base/7' : 'line-clamp-4 text-sm/7',
          'text-ink-soft'
        ]}
      >
        {project.data.description}
      </p>

      {!!visibleImpactMetrics.length && (
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {visibleImpactMetrics.map(metric => (
            <li class="
              rounded-full border border-brand/15 bg-brand-soft/55 px-3 py-1.5
              text-xs font-semibold text-brand
            "
            >
              {metric}
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {sortedTechnologies.slice(0, technologyLimit).map(technology => (
          <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
        ))}
        {hiddenTechnologyCount > 0 && (
          <Pill href={`${projectLink}#technologies`} label={hiddenTechnologyLabel} tone="neutral" />
        )}
      </div>

      <ButtonLink
        href={projectLink}
        showArrow
        variant="inline"
      >
        View project
        <span class="sr-only"> about {project.data.title}</span>
      </ButtonLink>
    </div>
  </div>
</article>
