---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath, getTechnologyPath } from '../../utils/links'
import FormattedDate from '../atoms/FormattedDate.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  project: CollectionEntry<'project'>
}

const { project } = Astro.props
const projectLink = getPortfolioPath(project.id)
---

<article class="
  group panel-card relative flex h-full flex-col overflow-hidden transition
  duration-300
  hover:-translate-y-0.5 hover:border-brand/25
  motion-reduce:transition-none
  motion-reduce:hover:translate-y-0
"
>
  <a aria-label={project.data.title} class="block" href={projectLink}>
    <div class="
      relative aspect-16/10 overflow-hidden border-b border-line/45
      bg-surface-muted
    "
    >
      {project.data.coverImage?.src ?
        (
          <Image
            alt={project.data.coverImage.alt || project.data.title}
            class="
              size-full object-cover transition duration-500
              group-hover:scale-[1.03]
              motion-reduce:transform-none motion-reduce:transition-none
            "
            height={720}
            loading="lazy"
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            src={project.data.coverImage.src}
            width={1280}
            widths={[400, 800, 1200]}
          />
        ) :
        (
          <div class="size-full grid-fade" />
        )}
      <div class="
        absolute inset-0 bg-linear-to-t from-canvas/55 via-canvas/10
        to-transparent
      "
      />
    </div>
  </a>

  <div class="
    flex grow flex-col gap-6 p-6
    sm:p-7
  "
  >
    <div class="
      flex flex-wrap items-center gap-2 text-sm text-ink-muted
      sm:gap-3
    "
    >
      {project.data.rol && <span>{project.data.rol}</span>}
      {project.data.rol && (
        <span
          aria-hidden="true"
          class="size-1 rounded-full bg-line"
        />
      )}
      <FormattedDate date={project.data.startingDate} />
      <span aria-hidden="true">-</span>
      {project.data.endingDate ? <FormattedDate date={project.data.endingDate} /> : <span>Present</span>}
    </div>

    <div class="space-y-3">
      <h3 class="
        text-[1.7rem] leading-tight transition-colors duration-200
        group-hover:text-brand
        motion-reduce:transition-none
      "
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={projectLink}
        >
          {project.data.title}
        </a>
      </h3>
      <p class="line-clamp-4 text-sm/7 text-ink-soft">{project.data.description}</p>
    </div>

    <div class="mt-auto flex flex-wrap gap-2">
      {project.data.technologies.slice(0, 4).map(technology => (
        <Pill href={getTechnologyPath(technology)} label={technology} tone="outline" />
      ))}
      {project.data.technologies.length > 4 && (
        <Pill label={`+${project.data.technologies.length - 4} more`} tone="neutral" />
      )}
    </div>
  </div>
</article>
