---
interface Props {
  title: string
  description?: string
  icon?: string
  tone?: 'brand' | 'accent' | 'success' | 'warning' | 'neutral'
  badge?: string
  className?: string
}

const {
  title,
  description,
  icon,
  tone = 'brand',
  badge,
  className = ''
} = Astro.props

const toneMap = {
  brand: {
    iconBg: 'bg-brand/10 text-brand',
    badgeBg: 'bg-brand/15 text-brand'
  },
  accent: {
    iconBg: 'bg-accent/10 text-accent',
    badgeBg: 'bg-accent/15 text-accent'
  },
  success: {
    iconBg: 'bg-success/10 text-success',
    badgeBg: 'bg-success/15 text-success'
  },
  warning: {
    iconBg: 'bg-warning/10 text-warning',
    badgeBg: 'bg-warning/15 text-warning'
  },
  neutral: {
    iconBg: 'bg-surface-strong text-ink-soft',
    badgeBg: 'bg-surface-muted text-ink-muted'
  }
}

const styles = toneMap[tone]
---

<div
  class:list={[
    // eslint-disable-next-line better-tailwindcss/no-unknown-classes
    'mini-card-static relative',
    'flex items-start gap-4',
    'p-4 sm:p-5',
    'rounded-2xl',
    'transition-colors duration-200',
    className
  ]}
  data-minicard-static
>
  {/* Icon */}
  {icon && (
    <div
      class:list={[
        'icon-wrapper relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl',
        styles.iconBg
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <Fragment set:html={icon} />
      </svg>
    </div>
  )}

  {/* Content */}
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 flex-wrap">
      <h3 class="text-sm font-semibold text-ink">
        {title}
      </h3>
      {badge && (
        <span
          class:list={[
            'badge inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium',
            styles.badgeBg
          ]}
        >
          {badge}
        </span>
      )}
    </div>
    {description && (
      <p class="mt-1.5 text-sm text-ink-soft leading-relaxed line-clamp-2">
        {description}
      </p>
    )}
  </div>
</div>

<style>
  .mini-card-static {
    background: linear-gradient(
      145deg,
      hsl(var(--surface) / 0.6) 0%,
      hsl(var(--surface-muted) / 0.4) 100%
    );
    border: 1px solid hsl(var(--line) / 0.25);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }

  .mini-card-static::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      145deg,
      hsl(0 0% 100% / 0.08) 0%,
      transparent 50%,
      hsl(0 0% 100% / 0.03) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.4;
  }

  /* Static cards have minimal styling - no hover effects */
  @media (prefers-reduced-motion: reduce) {
    .mini-card-static {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
