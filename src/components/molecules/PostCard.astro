---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPostPath } from '../../utils/links'
import ButtonLink from '../atoms/ButtonLink.astro'
import FormattedDate from '../atoms/FormattedDate.astro'
import Pill from '../atoms/Pill.astro'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { data } = post
---

<article class="
  group panel-card flex h-full flex-col overflow-hidden transition duration-300
  hover:-translate-y-0.5 hover:border-brand/25
  motion-reduce:transition-none
  motion-reduce:hover:translate-y-0
"
>
  <a aria-hidden="true" class="block" href={getPostPath(post.id)} tabindex="-1">
    <div class="relative aspect-16/10 overflow-hidden border-b border-line/45">
      {data.coverImage ?
        (
          <Image
            alt={data.coverImage.alt}
            height={720}
            class="
              size-full object-cover transition duration-500
              group-hover:scale-[1.03]
              motion-reduce:transform-none motion-reduce:transition-none
            "
            src={data.coverImage.src}
            width={1280}
          />
        ) :
        (
          <div class="size-full grid-fade" />
        )}
      <div class="
        absolute inset-0 bg-linear-to-t from-canvas/55 via-canvas/10
        to-transparent
      "
      />
    </div>
  </a>

  <div class="
    flex grow flex-col gap-6 p-6
    sm:p-7
  "
  >
    <div class="flex flex-wrap items-center gap-3 text-sm text-ink-muted">
      <Pill label="Writing" tone="brand" />
      <FormattedDate date={data.publishDate} />
    </div>

    <div class="space-y-3">
      <h2 class="
        text-[1.65rem] leading-tight transition-colors duration-200
        group-hover:text-brand
        motion-reduce:transition-none
      "
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={getPostPath(post.id)}
        >
          {data.title}
        </a>
      </h2>
      <p class="line-clamp-4 text-sm/7 text-ink-soft">{data.description}</p>
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {data.tags.slice(0, 3).map(tag => (
          <Pill label={tag} showHash tone="outline" />
        ))}
      </div>
      <ButtonLink href={getPostPath(post.id)} showArrow variant="inline">
        Read more
      </ButtonLink>
    </div>
  </div>
</article>
