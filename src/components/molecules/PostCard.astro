---
import { type CollectionEntry, getEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPostPath, getSeriesPath, getTagPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'
import { getReadingTime } from '@/utils/reading-time'

import { CoverImage } from '@santi020k/lumen-astro'

interface Props {
  className?: string
  featured?: boolean
  post: CollectionEntry<'post'>
}

const { className = '', featured = false, post } = Astro.props
const { data } = post
const series = data.seriesId ? await getEntry('series', data.seriesId) : null
const readingTime = getReadingTime(post.body)
const postLink = getPostPath(post.id)

const imageSizes = featured ?
  '(min-width: 1024px) 72vw, 100vw' :
  '(min-width: 1024px) 48vw, (min-width: 768px) 62vw, 100vw'
---

<article
  class:list={[
    'group relative overflow-hidden rounded-[1.75rem]',
    className
  ]}
  data-post-card={featured ? 'featured' : 'default'}
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-100"
    data-post-card-glow
  />

  <a
    aria-label={data.title}
    class:list={[
      'relative z-10 block',
      featured ?
        `
          px-4 pt-4
          sm:px-5 sm:pt-5
        ` :
        `
          px-3 pt-3
          sm:px-4 sm:pt-4
        `
    ]}
    href={postLink}
  >
    <span class="sr-only">{data.title}</span>
    {data.coverImage ?
      (
        <CoverImage
          alt={data.coverImage.alt}
          ariaHidden={true}
          className="rounded-none border-0"
          featured={featured}
          image={data.coverImage.src}
          loading={featured ? 'eager' : 'lazy'}
          mode="card"
          showCardOverlay={false}
          sizes={imageSizes}
          transitionName={`post-cover-${getPostSlug(post.id)}`}
        />
      ) :
      (
        <div class="aspect-16/10 bg-surface-muted grid-fade"/>
      )}
  </a>

  <div
    class:list={[
      `
        relative z-10 flex grow flex-col gap-5 p-5
        sm:p-6
      `,
      featured && `
        justify-between
        lg:px-8 lg:py-7
      `
    ]}
    data-post-card-panel
  >
    <div class="space-y-3">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="
          flex flex-wrap items-center gap-2
          sm:gap-3
        "
        >
          <Pill label={featured ? 'Featured article' : 'Writing'} tone={featured ? 'brand' : 'outline'} />
          <span
            class="
              rounded-full border border-line/35 bg-surface/35 px-2.5 py-1
              text-xs font-semibold tracking-[0.12em] text-ink-muted uppercase
              backdrop-blur-sm
            "
          >
            {data.postType}
          </span>
        </div>
        <div class="flex items-center gap-2 text-sm text-ink-muted">
          <FormattedDate date={data.publishDate} />
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <h2
        class:list={[
          `
            leading-tight transition-colors duration-200
            group-hover:text-ink
            motion-reduce:transition-none
          `,
          featured ?
            `
              text-[1.95rem]
              sm:text-[2.25rem]
            ` :
            'text-[1.35rem]'
        ]}
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={postLink}
        >
          {data.title}
        </a>
      </h2>
      <p
        class:list={[
          featured ? 'max-w-2xl text-base/7' : 'line-clamp-3 text-sm/7',
          'text-ink-soft'
        ]}
      >
        {data.description}
      </p>

      {series && (
        <p class="text-sm/6 text-ink-muted">
          In series:{' '}
          <a
            class="
              font-medium text-brand transition-colors
              hover:text-accent
            "
            href={getSeriesPath(series.id)}
          >
            {series.data.title}
          </a>
          {data.seriesOrder && ` · Part ${data.seriesOrder}`}
        </p>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {data.tags.slice(0, featured ? 4 : 3).map(tag => (
          <Pill href={getTagPath(tag)} label={tag} showHash tone="outline" />
        ))}
      </div>
      <ButtonLink
        href={postLink}
        showArrow
        variant="inline"
      >
        Read article
        <span class="sr-only"> about {data.title}</span>
      </ButtonLink>
    </div>
  </div>

</article>

<style>
  [data-post-card] {
    display: flex;
    flex-direction: column;
    background: linear-gradient(
      145deg,
      hsl(var(--surface) / 0.78),
      hsl(var(--surface-muted) / 0.58)
    );
    border: 1px solid hsl(var(--line) / 0.38);
    backdrop-filter: blur(14px);
    box-shadow:
      0 12px 30px hsl(230 30% 8% / 0.04),
      0 4px 12px hsl(230 30% 8% / 0.02),
      inset 0 1px 0 hsl(0 0% 100% / 0.08);
  }

  [data-post-card]::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--border-angle),
      hsl(var(--line) / 0.2) 0%,
      hsl(var(--line) / 0.2) 62%,
      hsl(var(--brand) / 0.5) 76%,
      hsl(var(--accent) / 0.58) 84%,
      hsl(var(--brand) / 0.5) 92%,
      hsl(var(--line) / 0.2) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  [data-post-card-glow] {
    background:
      radial-gradient(
        circle 350px at var(--mouse-x, 50%) var(--mouse-y, -20%),
        hsl(var(--brand) / 0.12),
        transparent 80%
      ),
      radial-gradient(ellipse 70% 44% at 18% 0%, hsl(var(--brand) / 0.07), transparent 66%),
      radial-gradient(ellipse 62% 46% at 92% 92%, hsl(var(--accent) / 0.06), transparent 64%);
    opacity: 0.8;
    transition: opacity 0.35s ease;
  }

  [data-post-card-panel] {
    background: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-post-card] {
      transition:
        transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }

    [data-post-card]:hover {
      transform: translateY(-5px);
      border-color: transparent;
      box-shadow:
        0 26px 66px hsl(230 30% 8% / 0.12),
        0 12px 28px hsl(var(--brand) / 0.1),
        inset 0 1px 0 hsl(0 0% 100% / 0.1);
    }

    [data-post-card]:hover::before {
      opacity: 1;
      animation: border-spin 5s linear infinite;
    }

    [data-post-card]:hover [data-post-card-glow] {
      opacity: 1;
    }

    [data-post-card] > a {
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-post-card='default']:hover > a {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-post-card],
    [data-post-card]::before,
    [data-post-card-glow] {
      transition: none;
    }

    [data-post-card]::before {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll<HTMLElement>('[data-post-card]')

    for (const card of cards) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect()
        const x = e.clientX - rect.left
        const y = e.clientY - rect.top

        card.style.setProperty('--mouse-x', `${x}px`)
        card.style.setProperty('--mouse-y', `${y}px`)
      })
    }
  })
</script>
