---
import MediumPostImage from './MediumPostImage.astro'

import type { MediumPost } from '../../types'
import { getPostPath } from '../../utils/links'
import ButtonLink from '../atoms/ButtonLink.astro'
import Pill from '../atoms/Pill.astro'
import FormattedDate from '../FormattedDate.astro'

interface Props {
  post: MediumPost
}

const { post } = Astro.props
---

<article class="
  group flex h-full flex-col overflow-hidden rounded-[1.75rem] panel-surface
"
>
  <a class="block" href={getPostPath(post.slug)}>
    <div class="relative aspect-16/10 overflow-hidden">
      {post.imageUrl ?
        (
          <MediumPostImage
            alt=""
            height={720}
            imageClass="
            transition duration-500 group-hover:scale-[1.03]
            motion-reduce:transform-none motion-reduce:transition-none
          "
            src={post.imageUrl}
            wrapperClass="h-full w-full"
            width={1280}
          />
        ) :
        (
          <div class="size-full grid-fade" />
        )}
      <div class="
        absolute inset-0 bg-linear-to-t from-canvas/40 via-transparent
        to-transparent
      "
      />
    </div>
  </a>

  <div class="flex grow flex-col gap-5 p-6">
    <div class="flex flex-wrap items-center gap-3 text-sm text-ink-muted">
      <Pill label={post.publication} tone="brand" />
      <FormattedDate date={new Date(post.publishedAt)} />
    </div>

    <div class="space-y-3">
      <h3 class="
        text-2xl
        group-hover:text-brand
      "
      >
        <a
          class="
            transition
            hover:text-brand
            motion-reduce:transition-none
          "
          href={getPostPath(post.slug)}
        >
          {post.title}
        </a>
      </h3>
      <p class="line-clamp-4 text-sm/7 text-ink-soft">{post.excerpt}</p>
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {post.tags.slice(0, 3).map(tag => (
          <Pill label={tag} showHash tone="outline" />
        ))}
      </div>
      <ButtonLink href={getPostPath(post.slug)} showArrow variant="inline">
        Read preview
      </ButtonLink>
    </div>
  </div>
</article>
