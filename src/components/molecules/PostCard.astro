---
import { Image } from 'astro:assets'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import { getPostPath } from '@/utils/links'
import type { MediumPost } from '@/types'

interface Props {
  post: MediumPost
}

const { post } = Astro.props
---

<article class="panel-surface group flex h-full flex-col overflow-hidden rounded-[1.75rem]">
  <a class="block" href={getPostPath(post.slug)}>
    <div class="relative aspect-[16/10] overflow-hidden bg-surface-muted">
      {post.imageUrl ? (
        <Image
          alt=""
          class="
            h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]
            motion-reduce:transform-none motion-reduce:transition-none
          "
          height={720}
          loading="lazy"
          src={post.imageUrl}
          width={1280}
        />
      ) : (
        <div class="grid-fade h-full w-full" />
      )}
      <div class="absolute inset-0 bg-linear-to-t from-canvas/40 via-transparent to-transparent" />
    </div>
  </a>

  <div class="flex grow flex-col gap-5 p-6">
    <div class="flex flex-wrap items-center gap-3 text-sm text-ink-muted">
      <Pill label={post.publication} tone="brand" />
      <FormattedDate date={new Date(post.publishedAt)} />
    </div>

    <div class="space-y-3">
      <h3 class="text-2xl group-hover:text-brand">
        <a class="transition hover:text-brand motion-reduce:transition-none" href={getPostPath(post.slug)}>
          {post.title}
        </a>
      </h3>
      <p class="line-clamp-4 text-sm leading-7 text-ink-soft">{post.excerpt}</p>
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {post.tags.slice(0, 3).map(tag => (
          <Pill label={tag} showHash tone="outline" />
        ))}
      </div>
      <ButtonLink href={getPostPath(post.slug)} showArrow variant="inline">
        Read summary
      </ButtonLink>
    </div>
  </div>
</article>
