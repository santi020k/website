---
import { Icon } from 'astro-icon/components'

import { siteConfig } from '../../site.config'
---

<div class="
  flex flex-col gap-3
  sm:flex-row sm:items-center sm:justify-between
"
>
  <p class="section-label">Elsewhere</p>
  <ul class="flex flex-wrap gap-3">
    {siteConfig.socialLinks.map(({ href, icon, label }) => (
      <li class="flex">
        <a
          class="
            inline-flex size-11 items-center justify-center rounded-full border
            border-line/70 bg-surface/80 text-ink-soft transition duration-200
            hover:-translate-y-0.5 hover:border-brand/35 hover:text-brand
            motion-reduce:transition-none
            motion-reduce:hover:translate-y-0
          "
          href={href}
          rel="noreferrer noopener"
          target="_blank"
        >
          <Icon aria-hidden="true" class="size-5" focusable="false" name={icon} />
          <span class="sr-only">{label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
