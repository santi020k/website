---
import Card from '@santi020k/lumen-astro/components/Card'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

interface CaseStudyRow {
  body: string
  label: string
}

interface Props {
  contentLocale?: 'en' | 'es'
  rows: CaseStudyRow[]
}

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const { contentLocale = 'en', rows } = Astro.props
---

{!!rows.length && (
  <Card as="section" aria-label={t('collection.caseStudySummary')} data-project-case-study variant="unstyled">
    <h2>{t('collection.caseStudy7')}<Icon class="size-4 shrink-0" name="notebook-text" /></h2>
    <ol role="list">
      {rows.map((row, i) => (
        <li data-project-case-row>
          <span aria-hidden="true" data-project-case-number>{String(i + 1).padStart(2, '0')}</span>
          <div data-project-case-copy>
            <h3>{localizeCollectionSource(locale, row.label)}</h3>
            <p lang={contentLocale}>{row.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Card>
)}

<style>
  [data-project-case-study][data-slot='card'] {
    container: project-case-study / inline-size;
    padding: 1.625rem 1.75rem 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: var(--radius-sheet);
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    letter-spacing: normal;
  }
  ol { margin: 1.875rem 0 0; padding: 0; list-style: none; }
  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.125rem;
    padding-block: 0 1.625rem;
  }
  li + li { padding-block-start: 0.375rem; }
  [data-project-case-number] {
    color: hsl(var(--brand));
    font-size: 1.75rem;
    line-height: 1.143;
    font-weight: 500;
    letter-spacing: -0.0357em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  [data-project-case-copy] { min-width: 0; padding-inline-start: 1.25rem; border-inline-start: 2px solid hsl(var(--line)); }
  h3 {
    margin: 0 0 0.625rem;
    font-size: 1.1875rem;
    line-height: 1.474;
    font-weight: 500;
    letter-spacing: -0.021em;
  }
  p { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.714; }
  :global(:root[data-theme='santi020k-dark']) :is(h2, [data-project-case-number]) { color: hsl(var(--accent)); }
  @container reading-layout (width < 26rem) {
    [data-project-case-study][data-slot='card'] { padding-inline: 1.25rem; }
  }
  @container project-case-study (width < 21.25rem) {
    li { grid-template-columns: 2.25rem minmax(0, 1fr); gap: 0.75rem; }
    [data-project-case-copy] { padding-inline-start: 0.875rem; }
    [data-project-case-number] { font-size: 1.5rem; }
  }
  @container reading-layout (width < 18rem) {
    [data-project-case-study][data-slot='card'] { padding-inline: 0.5rem; }
  }
  @container project-case-study (width < 16rem) {
    li { grid-template-columns: minmax(0, 1fr); }
    [data-project-case-copy] { padding-inline-start: 0.375rem; }
  }
</style>
