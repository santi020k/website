---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { localizeProject } from '@/utils/content-translations'
import { getPortfolioPath } from '@/utils/links'
import { getPortfolioMetricDisplay } from '@/utils/portfolio-metric'
import { getProjectBrandStyle } from '@/utils/project-brand'
import { getProjectCoverForUsage } from '@/utils/project-cover'
import { getProjectStatusLabel, getProjectTimelineLabel } from '@/utils/project-meta'
import { sortTechnologiesByInterest } from '@/utils/technologies'

import Badge from '@santi020k/lumen-astro/components/Badge'
import Card from '@santi020k/lumen-astro/components/Card'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  featured?: boolean
  imagePriority?: boolean
  project: CollectionEntry<'project'>
}

const { featured = false, imagePriority = false, project: originalEntry } = Astro.props
const project = await localizeProject(originalEntry, getLocale(Astro.url.pathname))
const projectLink = localizePath(getPortfolioPath(project.id), locale)
const previewImage = getProjectCoverForUsage(project.data.coverImage, 'hero')
const timeline = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const projectStatus = getProjectStatusLabel(project.data.draft, project.data.endingDate)
const technologies = sortTechnologiesByInterest(project.data.technologies).slice(0, featured ? 5 : 4)

const impactMetrics = project.data.impactMetrics.slice(0, featured ? 2 : 1).map(metric => ({
  ...getPortfolioMetricDisplay(metric),
  summary: metric
}))

const previewTargetWidth = previewImage ? Math.min(1600, previewImage.width) : 0
const previewTargetHeight = Math.round(previewTargetWidth * 10 / 16)
---

<Card as="article" variant="unstyled" data-portfolio-project={featured ? 'featured' : 'supporting'} data-arrow-owner style={getProjectBrandStyle(project.data.brand)}>
  <div data-portfolio-composition>
    <div data-portfolio-visual transition:name={`project-cover-${project.id}`}>
      {previewImage ?
(
        <Picture
          alt=""
          class="absolute inset-0 size-full object-cover"
          fetchpriority={imagePriority ? 'high' : 'auto'}
          fallbackFormat="webp"
          formats={['avif']}
          height={previewTargetHeight}
          loading={imagePriority ? 'eager' : 'lazy'}
          sizes={featured ? '(min-width: 1280px) 672px, (min-width: 1024px) 58vw, calc(100vw - 48px)' : '(min-width: 1280px) 560px, (min-width: 768px) 48vw, calc(100vw - 48px)'}
          src={previewImage}
          width={previewTargetWidth}
          widths={[400, 640, 800, 1200, 1600]}
          fit="cover"
        />
      ) :
(
        <div data-portfolio-placeholder aria-hidden="true"><Icon class="size-12" name="code-2" /></div>
      )}
      <Badge variant="outline" data-project-status>{projectStatus}</Badge>
    </div>

    <div data-portfolio-project-body>
      <p data-portfolio-date>{timeline}</p>
      <h3 data-portfolio-title>{project.data.title}</h3>
      <p data-portfolio-role>{project.data.role ?? t('collection.engineering')}</p>
      <p data-portfolio-description>{project.data.description}</p>

      {impactMetrics.length > 0 && (
        <ul data-portfolio-outcomes aria-label={t('collection.projectOutcomes')}>
          {impactMetrics.map(metric => (
            <li data-portfolio-metric={metric.value ? 'measured' : 'qualitative'}>
              <span data-portfolio-evidence-label aria-hidden="true">{t('collection.selectedOutcome')}</span>
              {metric.value ?
(
                <>
                  <span class="sr-only">{metric.summary}</span>
                  <strong data-portfolio-value aria-hidden="true">{metric.value}</strong>
                  <span data-portfolio-label aria-hidden="true">{metric.label}</span>
                </>
              ) :
<span data-portfolio-label>{metric.label}</span>}
            </li>
          ))}
        </ul>
      )}

      <div data-portfolio-footer>
        {technologies.length > 0 && (
          <ul data-portfolio-technologies aria-label={t('collection.technologies')}>
            {technologies.map(technology => <li>{technology}</li>)}
          </ul>
        )}
        <span data-portfolio-action>{t('collection.readCaseStudy')}<ArrowExchange
class="size-4"
direction="up-right"
                                                                   /></span>
      </div>
    </div>
  </div>
  <a data-portfolio-link href={projectLink} aria-label={t('project.caseStudyAction', { title: project.data.title })} ></a>
</Card>

<style>
  [data-portfolio-project][data-slot='card'] {
    --portfolio-emphasis: var(--brand);
    --portfolio-project-ink: var(--project-primary-readable);
    container: portfolio-card / inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 1.5rem;
    background: transparent;
  }
  :global(:root[data-theme='santi020k-dark']) [data-portfolio-project] { --portfolio-emphasis: var(--accent); --portfolio-project-ink: var(--project-primary-readable-dark); }
  [data-portfolio-composition] { display: flex; flex: 1; flex-direction: column; min-width: 0; }
  [data-portfolio-link] { position: absolute; inset: 0; z-index: 1; color: hsl(var(--ink)); text-decoration: none; border-radius: inherit; }
  [data-portfolio-visual] { position: relative; flex-shrink: 0; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 1.5rem; background: hsl(var(--surface-muted)); }
  [data-portfolio-project='featured'] [data-portfolio-visual] { aspect-ratio: 2; }
  [data-portfolio-placeholder] { position: absolute; inset: 0; display: grid; place-items: center; background: hsl(var(--brand-soft)); color: hsl(var(--portfolio-emphasis)); }
  [data-project-status] { position: absolute; top: 1.375rem; left: 1.375rem; display: inline-flex; align-items: center; gap: 0.4375rem; max-width: calc(100% - 2.75rem); padding: 0.375rem 0.75rem; border: 1px solid hsl(var(--line) / 0.65); border-radius: 999px; background: hsl(var(--surface)); color: hsl(var(--ink)); font-size: 0.75rem; font-weight: 400; line-height: 1.667; white-space: normal; }
  [data-project-status]::before { content: ''; width: 0.3125rem; height: 0.3125rem; flex-shrink: 0; border-radius: 50%; background: hsl(var(--portfolio-project-ink)); }
  [data-portfolio-project-body] { position: relative; display: flex; flex: 1; flex-direction: column; min-width: 0; margin: -3rem 1.25rem 0; padding: 1.75rem 1.875rem 0; border: 1px solid hsl(var(--line) / 0.65); border-radius: 1.125rem 1.125rem 0.375rem 1.125rem; background: hsl(var(--surface)); box-shadow: var(--shadow-nav); }
  [data-portfolio-date] { margin: 0 0 0.75rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-portfolio-title] { margin: 0; font-size: 2.25rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.05em; text-wrap: wrap; overflow-wrap: break-word; hyphens: manual; }
  [data-portfolio-role] { margin: 0.5rem 0 0; color: hsl(var(--portfolio-emphasis)); font-size: 0.75rem; line-height: 1.667; }
  [data-portfolio-description] { margin: 1.25rem 0 0; max-width: 75ch; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; text-wrap: pretty; }
  [data-portfolio-outcomes] { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1.5rem; margin: 1.5rem 0; padding: 0; list-style: none; }
  [data-portfolio-metric] { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; padding-left: 1.125rem; border-left: 2px solid hsl(var(--portfolio-emphasis)); overflow-wrap: break-word; }
  [data-portfolio-evidence-label] { margin-bottom: 0.125rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.8; letter-spacing: 0.1em; text-transform: uppercase; }
  [data-portfolio-value] { color: hsl(var(--ink)); font-size: 2.5rem; font-weight: 500; line-height: 1.1; letter-spacing: -0.06em; }
  [data-portfolio-label] { color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.7; }
  [data-portfolio-metric='qualitative'] [data-portfolio-label] { color: hsl(var(--ink)); font-size: 1.0625rem; line-height: 1.6; letter-spacing: -0.02em; }
  [data-portfolio-footer] { margin-top: auto; padding-top: 1.5rem; }
  [data-portfolio-outcomes] + [data-portfolio-footer] { padding-top: 0; }
  [data-portfolio-technologies] { display: flex; flex-wrap: wrap; gap: 0.4375rem 0.875rem; margin: 0; padding: 0 0 1.4375rem; list-style: none; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.667; }
  [data-portfolio-technologies] > li { min-width: 0; overflow-wrap: anywhere; }
  [data-portfolio-action] { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1875rem 0; border-top: 1px solid hsl(var(--line) / 0.65); color: hsl(var(--ink)); font-size: 0.8125rem; font-weight: 500; line-height: 1.7; }
  [data-portfolio-action] > :global(svg) { flex-shrink: 0; }
  [data-portfolio-project]:is(:hover, :focus-within) :is([data-portfolio-project-body], [data-portfolio-metric]) { border-color: hsl(var(--portfolio-project-ink)); }
  [data-portfolio-project]:is(:hover, :focus-within) :is([data-portfolio-title], [data-portfolio-role], [data-portfolio-action]) { color: hsl(var(--portfolio-project-ink)); }
  @media (prefers-reduced-motion: no-preference) {
    [data-portfolio-project-body], [data-portfolio-metric] { transition: border-color 160ms ease; }
    [data-portfolio-title], [data-portfolio-role], [data-portfolio-action] { transition: color 160ms ease; }
  }
  @container portfolio-card (width >= 56rem) {
    [data-portfolio-project='featured'] [data-portfolio-composition] {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;

    }
    [data-portfolio-project='featured'] [data-portfolio-visual] {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      aspect-ratio: 4 / 3;
    }
    [data-portfolio-project='featured'] [data-portfolio-project-body] {
      grid-column: 2;
      grid-row: 1;
      margin: 0 0 0 -2rem;
      padding: 2rem 2rem 0;
    }
    [data-portfolio-project='featured'] [data-portfolio-title] { font-size: 2.5rem; }
    [data-portfolio-project='featured'] [data-portfolio-outcomes] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container portfolio-card (width < 36.25rem) {
    [data-portfolio-visual], [data-portfolio-project='featured'] [data-portfolio-visual] { aspect-ratio: 4 / 3; border-radius: 1.375rem; }
    [data-project-status] { top: 1.0625rem; left: 1.0625rem; }
    [data-portfolio-project-body] { margin: -2.375rem 0.625rem 0; padding: 1.4375rem 1.25rem 0; }
    [data-portfolio-title] { font-size: 1.875rem; }
    [data-portfolio-outcomes] { gap: 1.25rem; }
  }
  @container portfolio-card (width < 20rem) {
    [data-portfolio-project-body] { margin-inline: 0.375rem; padding-inline: 1rem; }
    [data-portfolio-outcomes] { gap: 0.875rem; }
    [data-portfolio-title] { font-size: min(1.875rem, 12cqi); }
    [data-portfolio-role], [data-portfolio-description], [data-portfolio-date] { overflow-wrap: break-word; }
  }
  @media (forced-colors: active) { [data-project-status]::before { background: CanvasText; } }
</style>
