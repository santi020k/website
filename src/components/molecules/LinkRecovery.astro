---
import { Textarea } from '@santi020k/lumen-astro'

import { getLocale, localeLanguage, sharedTranslator } from '@/i18n'

interface Props {
  buttonId: string
  url: string
  nativeShare?: boolean
  copiedLabel?: string
  copiedAnnouncement?: string
  idleLabel?: string
  retryAnnouncement?: string
  addressLabel?: string
  statusId?: string
}

const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)

const {
  buttonId,
  url,
  nativeShare = false,
  copiedLabel = t('shared.linkCopied'),
  copiedAnnouncement = copiedLabel,
  idleLabel = t('shared.copyLink'),
  retryAnnouncement = t('shared.tryAgain'),
  addressLabel = t('shared.selectAndCopyTheAddress'),
  statusId = `${buttonId}-status`
} = Astro.props

const id = `${buttonId}-recovery`
---

<div
  lang={localeLanguage(locale)}
  id={id}
  data-link-recovery
  data-link-button={buttonId}
  data-native-share={nativeShare}
  data-copied-label={copiedLabel}
  data-copied-announcement={copiedAnnouncement}
  data-idle-label={idleLabel}
  data-retry-announcement={retryAnnouncement}
  data-status-id={statusId}
  hidden
>
  <p id={`${id}-notice`}>{t('shared.automaticCopyingIsnTAvailable')}</p>
  <label for={`${id}-address`}>{addressLabel}</label>
  <Textarea id={`${id}-address`} readonly spellcheck="false" rows={3}>{url}</Textarea>
</div>
<p
lang={localeLanguage(locale)}
id={statusId}
aria-atomic="true"
aria-live="polite"
class="sr-only"
role="status"
></p>

<style>
  [data-link-recovery] {
    --link-recovery-accent: hsl(var(--brand));
    min-width: 0;
    margin-block-start: 1.5rem;
    padding-inline-start: 1.125rem;
    border-inline-start: 2px solid var(--link-recovery-accent);
    color: hsl(var(--ink));
  }

  :global(:root[data-theme='dark']) [data-link-recovery] { --link-recovery-accent: hsl(var(--accent)); }
  [data-link-recovery][hidden] { display: none; }
  [data-link-recovery] p { margin: 0 0 .5rem; font: 500 .875rem/1.6 var(--font-sans); }
  [data-link-recovery] label { display: block; margin-bottom: .625rem; color: hsl(var(--ink-soft)); font: 400 .8125rem/1.6 var(--font-sans); }
  [data-link-recovery] :global(textarea) {
    display: block;
    width: 100%;
    max-width: 100%;
    min-height: 0;
    padding: .75rem;
    border: 1px solid hsl(var(--line));
    border-radius: .5rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    font: 400 1rem/1.6 var(--font-sans);
    resize: none;
  }
  [data-link-recovery] :global(textarea:focus-visible) { outline: 2px solid var(--link-recovery-accent); outline-offset: 3px; }
  @media print { [data-link-recovery] { display: none; } }
</style>

<script>
  import { getLocale, sharedTranslator } from '@/i18n'

  const t = sharedTranslator(() => getLocale(window.location.pathname))

  const setupControl = (recovery: HTMLElement) => {
    const btn = document.getElementById(recovery.dataset.linkButton ?? '')

    if (!btn) return () => undefined

    const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
    const shareIcon = btn.querySelector<HTMLElement>('[data-share-icon]')
    const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')
    const status = document.getElementById(recovery.dataset.statusId ?? '')
    const address = recovery.querySelector('textarea')
    const originalName = btn.getAttribute('aria-label')
    const originalDescription = btn.getAttribute('aria-describedby')
    const successLabel = recovery.dataset.copiedLabel ?? t('shared.linkCopied')
    const successAnnouncement = recovery.dataset.copiedAnnouncement ?? successLabel
    let resizeFrame = 0
    let selectionFrame = 0
    let observedWidth = -1

    const resizeAddress = () => {
      if (resizeFrame) return

      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0

        if (!address?.getClientRects().length) return

        address.style.height = 'auto'

        address.style.height = `${address.scrollHeight + 2}px`
      })
    }

    const observer = new ResizeObserver(entries => {
      const width = entries[0]?.contentRect.width

      if (width === undefined || width === observedWidth) return

      observedWidth = width

      if (width > 0) resizeAddress()
    })

    observer.observe(recovery)

    const selectAddress = () => {
      address?.select()

      // WebKit restores its keyboard caret after focus handlers finish.
      // Select again after that default action, while this field still owns focus.
      cancelAnimationFrame(selectionFrame)

      selectionFrame = requestAnimationFrame(() => {
        selectionFrame = 0

        if (document.activeElement === address) address?.select()
      })
    }

    address?.addEventListener('focus', selectAddress)

    let timer: ReturnType<typeof setTimeout> | null = null
    let announcementTimer: ReturnType<typeof setTimeout> | null = null
    let pending = false
    // Cleared before Astro swaps the body, so a share sheet that settles after
    // the visitor leaves cannot copy the previous article or touch its control.
    let active = true

    const setPending = (value: boolean) => {
      pending = value

      if (value) btn.setAttribute('aria-busy', 'true')
      else btn.removeAttribute('aria-busy')
    }

    const supportsWebShare = (): boolean => {
      if (recovery.dataset.nativeShare !== 'true' || typeof navigator.share !== 'function') {
        return false
      }

      const isCoarsePointer = window.matchMedia?.('(pointer: coarse)').matches === true

      return isCoarsePointer
    }

    const idleLabel = supportsWebShare() ? t('shared.shareLink') : recovery.dataset.idleLabel ?? t('shared.copyLink')
    const idleIcon = supportsWebShare() && shareIcon ? shareIcon : copyIcon
    const STATE_RESET_MS = 2000
    const ANNOUNCEMENT_DELAY_MS = 100

    if (label) label.textContent = idleLabel

    copyIcon?.classList.toggle('hidden', idleIcon !== copyIcon)

    shareIcon?.classList.toggle('hidden', idleIcon !== shareIcon)

    const idleName = supportsWebShare() ? idleLabel : originalName ?? idleLabel

    const hideRecovery = () => {
      recovery.hidden = true

      btn.removeAttribute('data-link-recovery-active')

      if (originalDescription) btn.setAttribute('aria-describedby', originalDescription)
      else btn.removeAttribute('aria-describedby')
    }

    const clearAnnouncement = () => {
      if (announcementTimer) clearTimeout(announcementTimer)

      announcementTimer = null
    }

    const resetState = () => {
      clearAnnouncement()

      btn.classList.remove('copied')

      idleIcon?.classList.remove('hidden')

      checkIcon?.classList.add('hidden')

      if (label) label.textContent = idleLabel

      btn.setAttribute('aria-label', idleName)

      if (status) status.textContent = ''
    }

    // Success is transient; recovery remains available until a later success.
    const showResultState = (outcome: 'copied' | 'failed') => {
      if (!active || !btn.isConnected) return

      const succeeded = outcome === 'copied'

      btn.classList.toggle('copied', succeeded)

      idleIcon?.classList.toggle('hidden', succeeded)

      checkIcon?.classList.toggle('hidden', !succeeded)

      // Kept short so the control still fits a 320px viewport with enlarged text.
      if (label) label.textContent = succeeded ? successLabel : t('shared.tryAgain')

      btn.setAttribute('aria-label', succeeded ? successAnnouncement : recovery.dataset.retryAnnouncement ?? t('shared.tryAgain'))

      if (succeeded) {
        hideRecovery()
      } else {
        recovery.hidden = false

        btn.setAttribute('data-link-recovery-active', '')

        btn.setAttribute('aria-describedby', `${recovery.id}-notice`)

        resizeAddress()

        // Size the address again if a web font is still swapping in. Waiting here, not at
        // setup, avoids reading document.fonts.ready on every page, which forces a style pass.
        void document.fonts.ready.then(() => {
          if (active && !recovery.hidden) resizeAddress()

          return undefined
        })
      }

      clearAnnouncement()

      // Empty the region, then write the result in a later task: restoring the
      // same text within the task that cleared it leaves no distinct change.
      if (status) {
        const message = succeeded ? successAnnouncement : t('shared.copyFailedSelectAndCopyThe')

        status.textContent = ''

        announcementTimer = setTimeout(() => {
          announcementTimer = null

          if (active && status.isConnected) status.textContent = message
        }, ANNOUNCEMENT_DELAY_MS)
      }

      if (timer) clearTimeout(timer)

      timer = null

      if (succeeded) {
        timer = setTimeout(() => {
          resetState()

          timer = null
        }, STATE_RESET_MS)
      }
    }

    const share = async (shareUrl: string, shareTitle: string) => {
      if (supportsWebShare()) {
        try {
          await navigator.share({
            title: shareTitle,
            url: shareUrl
          })

          if (active && btn.isConnected) {
            hideRecovery()

            resetState()
          }

          return
        } catch (error) {
          // Cancellation leaves the clipboard unchanged; other errors use the fallback.
          if (error instanceof DOMException && error.name === 'AbortError') {
            return
          }
        }

        if (!active || !btn.isConnected) return
      }

      try {
        await navigator.clipboard.writeText(shareUrl)

        showResultState('copied')
      } catch {
        // Insecure contexts and denied permissions both land here. Telling the
        // visitor beats a button that appears to do nothing at all.
        showResultState('failed')
      }
    }

    const onClick = async () => {
      // One share sheet or clipboard write at a time: a second `navigator.share`
      // call rejects while the first is open and would otherwise fall back to copying.
      if (pending) return

      // Copy the server-rendered destination, including an authored section
      // fragment, never the live address bar's query or fragment. Read both values before any
      // await so a route change during the share sheet cannot swap the page.
      const shareUrl = btn.dataset.shareUrl ?? ''
      const shareTitle = document.title

      // A previous result must not reset the label in the middle of this operation.
      if (timer) {
        clearTimeout(timer)

        timer = null

        resetState()
      }

      if (!shareUrl) {
        showResultState('failed')

        return
      }

      setPending(true)

      try {
        await share(shareUrl, shareTitle)
      } finally {
        if (active && btn.isConnected) setPending(false)
      }
    }

    btn.addEventListener('click', onClick)

    return () => {
      active = false

      btn.removeEventListener('click', onClick)

      observer.disconnect()

      cancelAnimationFrame(resizeFrame)

      cancelAnimationFrame(selectionFrame)

      address?.removeEventListener('focus', selectAddress)

      if (timer) clearTimeout(timer)

      timer = null

      clearAnnouncement()
    }
  }

  const setup = () => {
    const cleanups = [...document.querySelectorAll<HTMLElement>('[data-link-recovery]')].map(setupControl)

    return () => cleanups.forEach(dispose => dispose())
  }

  let cleanup = setup()

  document.addEventListener('astro:before-swap', () => {
    cleanup()

    cleanup = () => undefined
  })

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
