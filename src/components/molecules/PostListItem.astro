---
import type { CollectionEntry } from 'astro:content'

import { getPostPath } from '@/utils/links'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const postLink = getPostPath(post.id)
const formattedDate = post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
---

<a
  href={postLink}
  class="group flex items-start justify-between gap-4 py-5 list-divider"
>
  <div class="space-y-1 min-w-0 flex-1">
    <h3 class="font-medium text-ink group-hover:text-brand transition-colors line-clamp-1">
      {post.data.title}
    </h3>
    <p class="text-sm text-ink-soft line-clamp-1">
      {post.data.description}
    </p>
  </div>
  <span class="text-xs text-ink-muted shrink-0">
    {formattedDate}
  </span>
</a>
