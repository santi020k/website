---
import { Icon } from 'astro-icon/components'
---

<div class="relative flex shrink-0 items-center" data-site-search>
  <button
    aria-controls="site-search-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open site search"
    class="relative flex size-11 cursor-pointer items-center justify-center rounded-full border border-line/50 bg-surface/68 backdrop-blur-sm text-ink-soft shadow-[inset_0_1px_0_hsl(0_0%_100%/0.12)] motion-reduce:transition-none"
    data-site-search-trigger
    type="button"
  >
    <Icon aria-hidden="true" class="size-5 shrink-0" name="tabler:search" />
  </button>

  <dialog
    aria-labelledby="site-search-title"
    class="
      fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none border-0
      bg-transparent p-0
    "
    data-site-search-dialog
    id="site-search-dialog"
  >
    <!--
      `pointer-events-none` on the shell so clicks in the letterboxed margin hit the scrim
      (otherwise the flex box captures them and outside-click never closes).
    -->
    <div
      class="
        pointer-events-none absolute inset-0 flex min-h-[100dvh] w-full items-center
        justify-center p-4 sm:p-6
      "
    >
      <div
        aria-hidden="true"
        class="pointer-events-auto absolute inset-0 z-0 cursor-default"
        data-site-search-scrim
      >
      </div>

      <div
        class="
          pointer-events-auto panel-card glass-pro relative z-10 flex max-h-[min(90dvh,40rem)] w-full
          max-w-lg flex-col gap-4 overflow-hidden p-5
          shadow-[0_24px_80px_hsl(var(--ink)/0.2)]
          sm:p-6
        "
        data-site-search-panel
        role="document"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-ink" id="site-search-title">
              Search
            </h2>
            <p class="mt-1 text-sm text-ink-soft">
              Match titles, tags, and descriptions. Arrow keys to move,
              <kbd class="rounded-sm bg-surface-muted px-1.5 py-0.5 text-xs">Enter</kbd> to open,
              <kbd class="rounded-sm bg-surface-muted px-1.5 py-0.5 text-xs">Esc</kbd> to close.
            </p>
          </div>
          <button
            class="
              inline-flex min-h-10 min-w-10 items-center justify-center
              rounded-full border border-line/50 bg-surface/65 backdrop-blur-sm
              text-ink-soft shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)] transition
              duration-200
              hover:scale-105 hover:border-brand/40 hover:text-brand
              active:scale-95
              motion-reduce:transition-none
              motion-reduce:hover:scale-100
              motion-reduce:active:scale-100
            "
            data-site-search-close
            type="button"
          >
            <Icon aria-hidden="true" class="size-5" name="tabler:x" />
            <span class="sr-only">Close search</span>
          </button>
        </div>

        <label class="sr-only" for="site-search-input">Search posts and projects</label>
        <input
          autocomplete="off"
          class="
            w-full rounded-xl border border-line/55 bg-surface/75 backdrop-blur-sm
            px-4 py-3 text-sm text-ink ring-brand/30
            shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)]
            transition duration-200 outline-none
            focus:border-brand/40 focus:ring-2 focus:bg-surface/90
            motion-reduce:transition-none
          "
          id="site-search-input"
          placeholder="Search by title, tag, or keyword…"
          spellcheck="false"
          type="search"
        />

        <p class="text-xs leading-relaxed text-ink-muted">
          <span class="text-ink-soft">Open from the page</span> (not while typing in a field):
          <kbd class="rounded-sm bg-surface-muted px-1 py-0.5">/</kbd>
          · <kbd class="rounded-sm bg-surface-muted px-1 py-0.5">⌘</kbd><kbd class="rounded-sm bg-surface-muted px-1 py-0.5">K</kbd>
          or <kbd class="rounded-sm bg-surface-muted px-1 py-0.5">Ctrl</kbd><kbd class="rounded-sm bg-surface-muted px-1 py-0.5">K</kbd>
        </p>

        <p aria-atomic="true" aria-live="polite" class="sr-only" id="site-search-status"></p>

        <ul
          class="
            max-h-[min(50vh,24rem)] min-h-0 space-y-2 overflow-y-auto
            [-webkit-overflow-scrolling:touch]
          "
          id="site-search-results"
        >
        </ul>
      </div>
    </div>
  </dialog>
</div>

<style>
  [data-site-search-trigger] {
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.2s ease;
  }

  [data-site-search-trigger]::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--border-angle),
      hsl(var(--line) / 0.15) 0%,
      hsl(var(--line) / 0.15) 60%,
      hsl(var(--brand) / 0.6) 75%,
      hsl(var(--glow) / 0.7) 83%,
      hsl(var(--brand) / 0.6) 91%,
      hsl(var(--line) / 0.15) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-site-search-trigger]:hover {
      transform: translateY(-3px);
      border-color: transparent;
      background-color: hsl(var(--brand-soft) / 0.35);
      color: hsl(var(--brand));
      box-shadow:
        0 8px 24px hsl(230 30% 8% / 0.08),
        0 0 16px color-mix(in srgb, hsl(var(--brand)) 14%, transparent),
        inset 0 1px 0 hsl(0 0% 100% / 0.1);
    }

    [data-site-search-trigger]:hover::before {
      opacity: 1;
      animation: var(--animate-border-spin);
    }

    [data-site-search-trigger]:active {
      transform: scale(0.93);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-site-search-trigger]:hover {
      border-color: hsl(var(--brand) / 0.35);
      color: hsl(var(--brand));
    }
  }
</style>

<style is:global>
  /* Tailwind `flex` beats UA `dialog:not([open])`; without this, the panel stays in the header row. */
  #site-search-dialog:not([open]) {
    display: none;
  }

  /* Dimmed layer is animated inside the dialog (`[data-site-search-scrim]`). */
  #site-search-dialog::backdrop {
    background-color: transparent;
  }

  #site-search-dialog [data-site-search-scrim] {
    background-color: hsl(var(--theme-bg) / 0.82);
    backdrop-filter: blur(6px);
  }

  @keyframes site-search-scrim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes site-search-scrim-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes site-search-panel-in {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translateY(1.1rem) scale(0.94);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0) scale(1);
    }
  }

  @keyframes site-search-panel-out {
    from {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      filter: blur(3px);
      transform: translateY(0.65rem) scale(0.96);
    }
  }

  @keyframes site-search-hint-in {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-scrim] {
    animation: site-search-scrim-in 0.28s ease-out both;
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-panel] {
    animation: site-search-panel-in 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-scrim] {
    animation: site-search-scrim-out 0.22s ease-in both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-panel] {
    animation: site-search-panel-out 0.26s ease-in both;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-scrim],
    #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-panel],
    #site-search-dialog[data-site-search-anim="closing"] [data-site-search-scrim],
    #site-search-dialog[data-site-search-anim="closing"] [data-site-search-panel] {
      animation: none;
    }

    #site-search-dialog[open] [data-site-search-scrim] {
      opacity: 1;
    }

    #site-search-dialog[open] [data-site-search-panel] {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  #site-search-results a[data-site-search-active="true"] {
    border-color: hsl(var(--brand) / 0.5);
    background-color: hsl(var(--brand-soft) / 0.35);
    box-shadow:
      0 12px 36px hsl(var(--ink) / 0.07),
      inset 0 1px 0 hsl(var(--ink) / 0.03);
  }

  #site-search-results > li.site-search-hint {
    animation: site-search-hint-in 0.32s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-search-results > li.site-search-hint {
      animation: none;
    }
  }

  /*
    Thumbnails from inline JS: fixed square frame; image uses object-fit contain inside
    so aspect ratio is preserved (letterboxed), matching the pre-stretch layout.
  */
  #site-search-results [data-site-search-thumb-frame] {
    position: relative;
    flex-shrink: 0;
    align-self: center;
    width: 4.75rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid hsl(var(--line) / 0.45);
    background-color: hsl(var(--surface-muted));
    box-shadow: inset 0 1px 0 hsl(var(--ink) / 0.04);
  }

  @media (min-width: 640px) {
    #site-search-results [data-site-search-thumb-frame] {
      width: 5.5rem;
    }
  }

  #site-search-results [data-site-search-thumb] {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 160ms ease-out;
    /* Full row height slot, but never crop or squash the bitmap — letterbox if needed. */
    object-fit: contain;
    object-position: center;
  }

  #site-search-results [data-site-search-thumb-state="loaded"] {
    opacity: 1;
  }

  #site-search-results [data-site-search-thumb-state="error"] {
    display: none;
  }

  #site-search-results [data-site-search-thumb-placeholder] {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(
        110deg,
        hsl(var(--surface-muted)) 8%,
        hsl(var(--surface) / 0.96) 18%,
        hsl(var(--surface-muted)) 33%
      );
    background-size: 220% 100%;
    animation: site-search-thumb-shimmer 1.05s linear infinite;
  }

  #site-search-results [data-site-search-thumb-frame][data-site-search-thumb-loaded="true"]
    [data-site-search-thumb-placeholder] {
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  @keyframes site-search-thumb-shimmer {
    to {
      background-position-x: -220%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-search-results [data-site-search-thumb] {
      transition: none;
    }

    #site-search-results [data-site-search-thumb-placeholder] {
      animation: none;
    }

    #site-search-results [data-site-search-thumb-frame][data-site-search-thumb-loaded="true"]
      [data-site-search-thumb-placeholder] {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    /**
     * @type {Array<{
     *   title: string
     *   description: string
     *   path: string
     *   tags: string[]
     *   type: 'post' | 'project'
     *   coverUrl?: string
     *   coverAvifUrl?: string
     *   coverAlt?: string
     *   coverWidth?: number
     *   coverHeight?: number
     * }>}
     */
    let entries = []
    let selectedResultIndex = -1
    let closeAnimTimer = 0
    /** @type {'idle' | 'loading' | 'ready' | 'error'} */
    let indexLoadState = 'idle'
    /** @type {Promise<boolean> | null} */
    let indexLoadPromise = null
    /** @type {string[]} */
    let popularTopics = []

    const RECENT_SEARCHES_KEY = 'site-search-recent'
    const RECENT_SEARCHES_LIMIT = 5

    /** @returns {string[]} */
    const getRecentSearches = () => {
      try {
        const raw = window.localStorage?.getItem(RECENT_SEARCHES_KEY)
        if (!raw) return []
        const parsed = JSON.parse(raw)
        return Array.isArray(parsed) ? parsed.filter((v) => typeof v === 'string') : []
      } catch {
        return []
      }
    }

    /** @param {string} query */
    const rememberRecentSearch = (query) => {
      const trimmed = query.trim()
      if (trimmed.length < 2) return
      try {
        const list = getRecentSearches().filter((v) => v.toLowerCase() !== trimmed.toLowerCase())
        list.unshift(trimmed)
        const next = list.slice(0, RECENT_SEARCHES_LIMIT)
        window.localStorage?.setItem(RECENT_SEARCHES_KEY, JSON.stringify(next))
      } catch {
        /* localStorage may be unavailable (private mode); fail silently. */
      }
    }

    const computePopularTopics = () => {
      /** @type {Map<string, number>} */
      const counts = new Map()
      for (const entry of entries) {
        for (const tag of entry.tags) {
          counts.set(tag, (counts.get(tag) ?? 0) + 1)
        }
      }
      popularTopics = [...counts.entries()]
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
        .slice(0, 8)
        .map(([tag]) => tag)
    }

    const getDialog = () => document.querySelector('#site-search-dialog')
    const getInput = () => document.querySelector('#site-search-input')
    const getResults = () => document.querySelector('#site-search-results')
    const getStatus = () => document.querySelector('#site-search-status')
    const getTrigger = () => document.querySelector('[data-site-search-trigger]')
    const getPanel = () => document.querySelector('[data-site-search-panel]')

    const setScrollLock = (locked) => {
      document.documentElement.classList.toggle('site-search-open', locked)
      document.body.classList.toggle('site-search-open', locked)
    }

    const prefersReducedMotion = () =>
      window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches === true

    const setTriggerExpanded = (open) => {
      const trigger = getTrigger()
      if (trigger instanceof HTMLButtonElement) {
        trigger.setAttribute('aria-expanded', String(open))
      }
    }

    const syncResultSelection = () => {
      const results = getResults()
      if (!results) return
      const anchors = results.querySelectorAll('a[href]')
      anchors.forEach((a, i) => {
        if (i === selectedResultIndex) {
          a.setAttribute('data-site-search-active', 'true')
          a.scrollIntoView({
            block: 'nearest',
            behavior: prefersReducedMotion() ? 'auto' : 'smooth'
          })
        } else {
          a.removeAttribute('data-site-search-active')
        }
      })
    }

    /**
     * @param {string} message
     */
    const setStatusMessage = (message) => {
      const status = getStatus()
      if (!(status instanceof HTMLElement)) return
      if (status.textContent === message) return
      status.textContent = message
    }

    /**
     * Renders the empty state shown before the user starts typing. Prefers a
     * "Recent searches" list when localStorage has prior queries, otherwise
     * falls back to "Popular topics" derived from the loaded index.
     * @param {HTMLElement} results
     */
    const renderEmptyState = (results) => {
      const recents = getRecentSearches()
      const useRecents = recents.length > 0
      const items = useRecents ? recents : popularTopics

      if (items.length === 0) {
        results.innerHTML = `
          <li class="
            site-search-hint rounded-xl border border-dashed border-line/55
            bg-surface-muted/35 px-4 py-5 text-center text-sm text-ink-soft
          ">
            Type at least two characters to see results.
          </li>
        `
        setStatusMessage('Type at least two characters to search.')
        return
      }

      const heading = useRecents ? 'Recent searches' : 'Popular topics'
      const li = document.createElement('li')
      li.className = `
        site-search-hint rounded-xl border border-dashed border-line/55
        bg-surface-muted/35 px-4 py-4 text-sm text-ink-soft
      `.trim().replace(/\s+/g, ' ')

      const label = document.createElement('p')
      label.className = 'mb-3 text-xs font-semibold tracking-[0.18em] text-ink-muted uppercase'
      label.textContent = heading
      li.appendChild(label)

      const chips = document.createElement('div')
      chips.className = 'flex flex-wrap gap-2'

      for (const item of items) {
        const chip = document.createElement('button')
        chip.type = 'button'
        chip.dataset.siteSearchSuggestion = item
        chip.className = `
          inline-flex items-center rounded-full border border-line/50
          bg-surface/65 backdrop-blur-sm px-3 py-1 text-xs font-medium text-ink-soft
          shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)] transition
          hover:border-brand/40 hover:bg-brand-soft/30 hover:text-brand
          motion-reduce:transition-none
        `.trim().replace(/\s+/g, ' ')
        chip.textContent = item
        chips.appendChild(chip)
      }

      li.appendChild(chips)
      results.innerHTML = ''
      results.appendChild(li)
      setStatusMessage(`${items.length} ${heading.toLowerCase()} available.`)
    }

    /**
     * @param {typeof entries[number]} entry
     * @param {string} normalizedQuery
     */
    const rankEntry = (entry, normalizedQuery) => {
      const normalizedTitle = entry.title.toLowerCase()
      const normalizedDescription = entry.description.toLowerCase()
      const normalizedTags = entry.tags.map((tag) => tag.toLowerCase())
      const terms = normalizedQuery.split(/\s+/).filter(Boolean)

      let score = 0

      if (normalizedTitle === normalizedQuery) score += 120
      if (normalizedTitle.startsWith(normalizedQuery)) score += 90
      else if (normalizedTitle.includes(normalizedQuery)) score += 55

      if (normalizedTags.some((tag) => tag === normalizedQuery)) score += 48
      else if (normalizedTags.some((tag) => tag.startsWith(normalizedQuery))) score += 36

      if (normalizedDescription.includes(normalizedQuery)) score += 16

      for (const term of terms) {
        let termMatched = false

        if (normalizedTitle.startsWith(term)) {
          score += 22
          termMatched = true
        } else if (normalizedTitle.includes(term)) {
          score += 14
          termMatched = true
        }

        if (normalizedTags.some((tag) => tag === term)) {
          score += 16
          termMatched = true
        } else if (normalizedTags.some((tag) => tag.startsWith(term))) {
          score += 11
          termMatched = true
        } else if (normalizedTags.some((tag) => tag.includes(term))) {
          score += 7
          termMatched = true
        }

        if (normalizedDescription.includes(term)) {
          score += 6
          termMatched = true
        }

        if (!termMatched) return 0
      }

      return score
    }

    const render = (query) => {
      const results = getResults()
      if (!results) return

      results.innerHTML = ''
      const trimmed = query.trim()

      if (indexLoadState === 'loading') {
        selectedResultIndex = -1
        results.innerHTML = `
          <li class="
            site-search-hint rounded-xl border border-dashed border-line/55
            bg-surface-muted/35 px-4 py-5 text-center text-sm text-ink-soft
          ">
            Loading search index…
          </li>
        `
        setStatusMessage('Loading search index.')
        return
      }

      if (indexLoadState === 'error') {
        selectedResultIndex = -1
        results.innerHTML = `
          <li
            class="
              site-search-hint rounded-xl border border-dashed border-line/55
              bg-surface-muted/35 px-4 py-5 text-center text-sm text-ink-soft
            "
          >
            <p class="mb-3">Search is temporarily unavailable.</p>
            <button
              class="
                inline-flex min-h-10 items-center rounded-full border border-line/60
                px-3 py-1.5 text-xs font-medium text-ink-soft transition
                hover:border-brand/40 hover:text-brand
                motion-reduce:transition-none
              "
              data-site-search-retry
              type="button"
            >
              Retry loading index
            </button>
          </li>
        `
        setStatusMessage('Search is temporarily unavailable.')
        return
      }

      if (trimmed.length < 2) {
        selectedResultIndex = -1
        renderEmptyState(results)
        return
      }

      const normalized = trimmed.toLowerCase()
      const matches = entries
        .map((entry) => {
          const score = rankEntry(entry, normalized)
          return { entry, score }
        })
        .filter((item) => item.score > 0)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score
          return a.entry.title.localeCompare(b.entry.title)
        })
        .slice(0, 8)

      if (matches.length === 0) {
        selectedResultIndex = -1
        results.innerHTML =
          '<li class="site-search-hint px-1 py-2 text-sm text-ink-muted">No matching results.</li>'
        setStatusMessage(`No matching results for ${trimmed}.`)
        return
      }

      selectedResultIndex = Math.min(Math.max(selectedResultIndex, 0), matches.length - 1)

      for (const match of matches) {
        const e = match.entry
        const li = document.createElement('li')
        const a = document.createElement('a')
        a.href = e.path
        a.className = `
          group flex gap-3 rounded-xl border border-line/50 bg-surface/62 backdrop-blur-sm p-2.5
          shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08),0_2px_8px_hsl(230_30%_8%/0.02)]
          transition duration-200 hover:border-brand/45 hover:bg-brand-soft/28
          hover:shadow-[0_12px_40px_hsl(var(--ink)/0.06),inset_0_1px_0_hsl(var(--brand)/0.12)]
          motion-reduce:transition-none
          sm:gap-3.5 sm:p-3
        `.trim().replace(/\s+/g, ' ')

        const thumbHost = document.createElement('span')
        thumbHost.setAttribute('data-site-search-thumb-frame', '')

        if (e.coverUrl) {
          const placeholder = document.createElement('span')
          placeholder.setAttribute('aria-hidden', 'true')
          placeholder.setAttribute('data-site-search-thumb-placeholder', '')

          const picture = document.createElement('picture')

          if (e.coverAvifUrl) {
            const avifSource = document.createElement('source')
            avifSource.type = 'image/avif'
            avifSource.srcset = e.coverAvifUrl
            picture.appendChild(avifSource)
          }

          const img = document.createElement('img')
          img.src = e.coverUrl
          img.alt = e.coverAlt || e.title
          img.decoding = 'async'
          img.loading = 'eager'
          img.setAttribute('data-site-search-thumb', '')
          img.setAttribute('data-site-search-thumb-state', 'loading')

          img.addEventListener('load', () => {
            img.setAttribute('data-site-search-thumb-state', 'loaded')
            thumbHost.setAttribute('data-site-search-thumb-loaded', 'true')
          })

          img.addEventListener('error', () => {
            img.setAttribute('data-site-search-thumb-state', 'error')
            thumbHost.removeAttribute('data-site-search-thumb-loaded')
            img.alt = ''
          })

          picture.appendChild(img)
          thumbHost.append(placeholder, picture)
        } else {
          const ph = document.createElement('span')
          ph.className = 'block size-full grid-fade'
          ph.setAttribute('aria-hidden', 'true')
          thumbHost.appendChild(ph)
        }

        const body = document.createElement('span')
        body.className = 'flex min-w-0 flex-1 flex-col justify-center gap-0.5'

        const typeEl = document.createElement('span')
        typeEl.className = 'section-label'
        typeEl.textContent = e.type === 'post' ? 'Post' : 'Project'

        const titleEl = document.createElement('span')
        titleEl.className = 'text-sm font-semibold text-ink transition group-hover:text-brand'
        titleEl.textContent = e.title

        const descEl = document.createElement('span')
        descEl.className = 'line-clamp-2 text-xs/5 text-ink-soft sm:text-sm/6'
        descEl.textContent = e.description

        body.append(typeEl, titleEl, descEl)
        a.append(thumbHost, body)
        li.appendChild(a)
        results.appendChild(li)
      }

      syncResultSelection()
      setStatusMessage(
        `${matches.length} ${matches.length === 1 ? 'result' : 'results'} available. Use arrow keys to navigate.`
      )
    }

    const openSearch = () => {
      const dialog = getDialog()
      const input = getInput()
      if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)) return

      window.clearTimeout(closeAnimTimer)
      dialog.removeAttribute('data-site-search-anim')

      if (!dialog.open) {
        dialog.showModal()
      }
      setScrollLock(true)
      setTriggerExpanded(true)
      window.requestAnimationFrame(() => {
        input.focus()
        input.select()
        render(input.value)
      })
    }

    /**
     * @param {{ focusTrigger?: boolean }} [options]
     */
    const closeSearch = (options = {}) => {
      const { focusTrigger = false } = options
      const dialog = getDialog()
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return

      const finish = () => {
        window.clearTimeout(closeAnimTimer)
        if (dialog.open) {
          dialog.close()
        }
        setScrollLock(false)
        /* Remove after `close()` so `[open]` never pairs with "not closing" (intro CSS). */
        dialog.removeAttribute('data-site-search-anim')
        if (focusTrigger) {
          const t = getTrigger()
          if (t instanceof HTMLElement) {
            t.focus()
          }
        }
      }

      if (prefersReducedMotion()) {
        finish()
        return
      }

      const panel = getPanel()
      if (!(panel instanceof HTMLElement)) {
        finish()
        return
      }

      dialog.setAttribute('data-site-search-anim', 'closing')

      const onAnimEnd = (e) => {
        if (e.animationName !== 'site-search-panel-out') return
        panel.removeEventListener('animationend', onAnimEnd)
        finish()
      }

      panel.addEventListener('animationend', onAnimEnd)
      closeAnimTimer = window.setTimeout(() => {
        panel.removeEventListener('animationend', onAnimEnd)
        finish()
      }, 420)
    }

    const isEditableTarget = (target) => {
      if (!(target instanceof HTMLElement)) return false
      if (target.isContentEditable) return true
      const tag = target.tagName
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true
      return false
    }

    /**
     * @param {{ force?: boolean }} [options]
     */
    const loadIndex = async (options = {}) => {
      const { force = false } = options
      if (!force && indexLoadState === 'ready' && entries.length > 0) return true
      if (!force && indexLoadPromise) return indexLoadPromise

      indexLoadState = 'loading'
      render(getInput()?.value ?? '')

      indexLoadPromise = fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) {
            throw new Error('Failed search index response')
          }
          return response.json()
        })
        .then((json) => {
          entries = Array.isArray(json) ? json : []
          computePopularTopics()
          indexLoadState = 'ready'
          return true
        })
        .catch(() => {
          entries = []
          indexLoadState = 'error'
          return false
        })
        .finally(() => {
          indexLoadPromise = null
          render(getInput()?.value ?? '')
        })

      return indexLoadPromise
    }

    const bindUi = () => {
      const root = document.querySelector('[data-site-search]')
      if (!root || root.getAttribute('data-site-search-bound') === 'true') return

      const trigger = root.querySelector('[data-site-search-trigger]')
      const closeBtn = root.querySelector('[data-site-search-close]')
      const input = getInput()
      const results = getResults()
      const dialog = getDialog()

      const scrim = dialog.querySelector('[data-site-search-scrim]')

      if (!(trigger instanceof HTMLButtonElement) || !(closeBtn instanceof HTMLButtonElement) ||
          !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement) ||
          !(dialog instanceof HTMLDialogElement)) {
        return
      }

      root.setAttribute('data-site-search-bound', 'true')

      trigger.addEventListener('click', () => {
        if (dialog.open) {
          closeSearch({ focusTrigger: true })
          return
        }
        openSearch()
        void loadIndex()
      })

      closeBtn.addEventListener('click', () => {
        closeSearch({ focusTrigger: true })
      })

      if (scrim instanceof HTMLElement) {
        scrim.addEventListener('click', () => {
          closeSearch({ focusTrigger: true })
        })
      }

      dialog.addEventListener('close', () => {
        setScrollLock(false)
        setTriggerExpanded(false)
        const url = new URL(window.location.href)
        if (url.searchParams.has('q')) {
          url.searchParams.delete('q')
          window.history.replaceState({}, '', url)
        }
      })

      dialog.addEventListener('cancel', (e) => {
        e.preventDefault()
        closeSearch({ focusTrigger: true })
      })

      dialog.addEventListener('keydown', (e) => {
        if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return
        const links = [...results.querySelectorAll('a[href]')]
        if (links.length === 0) return
        e.preventDefault()
        if (e.key === 'ArrowDown') {
          if (selectedResultIndex < 0) {
            selectedResultIndex = 0
          } else {
            selectedResultIndex = (selectedResultIndex + 1) % links.length
          }
        } else if (selectedResultIndex < 0) {
          selectedResultIndex = links.length - 1
        } else {
          selectedResultIndex = (selectedResultIndex - 1 + links.length) % links.length
        }
        syncResultSelection()
      })

      input.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return
        const links = [...results.querySelectorAll('a[href]')]
        if (selectedResultIndex < 0 || selectedResultIndex >= links.length) return
        e.preventDefault()
        rememberRecentSearch(input.value)
        links[selectedResultIndex].click()
      })

      input.addEventListener('input', () => {
        const value = input.value
        render(value)
        const next = new URL(window.location.href)
        const trimmed = value.trim()
        if (trimmed.length >= 2) {
          next.searchParams.set('q', trimmed)
        } else {
          next.searchParams.delete('q')
        }
        window.history.replaceState({}, '', next)
      })

      results.addEventListener('click', (event) => {
        const retryButton =
          event.target instanceof Element ? event.target.closest('[data-site-search-retry]') : null
        if (retryButton instanceof HTMLButtonElement) {
          event.preventDefault()
          void loadIndex({ force: true })
          return
        }

        const suggestion =
          event.target instanceof Element ?
            event.target.closest('[data-site-search-suggestion]') :
            null
        if (suggestion instanceof HTMLButtonElement) {
          event.preventDefault()
          const term = suggestion.dataset.siteSearchSuggestion ?? ''
          if (term) {
            input.value = term
            input.dispatchEvent(new Event('input', { bubbles: true }))
            input.focus()
          }
          return
        }

        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null
        if (!anchor) return
        rememberRecentSearch(input.value)
        closeSearch()
      })

      results.addEventListener('mousemove', (event) => {
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null
        if (!anchor) return
        const links = [...results.querySelectorAll('a[href]')]
        const next = links.indexOf(anchor)
        if (next < 0 || next === selectedResultIndex) return
        selectedResultIndex = next
        syncResultSelection()
      })

      // Defer the search-index fetch until the user actually opens the modal
      // (trigger click, Cmd/Ctrl+K, or '/'), or arrives with a `?q=` deep-link.
      // This avoids a network + parse cost on every page navigation.
      const params = new URLSearchParams(window.location.search)
      const queryFromURL = params.get('q')
      if (queryFromURL && queryFromURL.trim().length >= 2) {
        openSearch()
        input.value = queryFromURL
        void loadIndex().then(() => {
          render(queryFromURL)
        })
      }
    }

    const onGlobalKeydown = (event) => {
      const dialog = getDialog()
      const isOpen = dialog instanceof HTMLDialogElement && dialog.open

      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        if (!isOpen && isEditableTarget(event.target)) return
        event.preventDefault()
        if (!isOpen) {
          openSearch()
        }
        void loadIndex()
        return
      }

      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        if (isOpen) return
        if (isEditableTarget(event.target)) return
        event.preventDefault()
        openSearch()
        void loadIndex()
      }
    }

    if (!window.__siteSearchGlobalKeys) {
      window.__siteSearchGlobalKeys = true
      document.addEventListener('keydown', onGlobalKeydown)
    }

    bindUi()
    document.addEventListener('astro:after-swap', bindUi)
  })()
</script>
