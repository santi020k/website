---
import { Button, Icon } from '@santi020k/lumen-astro'

import SearchDialog from './SearchDialog.astro'
---

<div class="relative flex shrink-0 items-center" data-site-search>
  <Button
    aria-controls="site-search-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open site search"
    class="
      relative flex size-11 cursor-pointer items-center justify-center
      rounded-full border border-line/50 bg-surface/68 text-ink-soft
      shadow-inset-soft backdrop-blur-sm
      motion-reduce:transition-none
    "
    data-site-search-trigger
    size="icon"
    type="button"
    variant="ghost"
  >
    <Icon class="size-5 shrink-0" name="search" />
  </Button>

  <SearchDialog />
</div>

<style>
  [data-site-search-trigger] {
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.2s ease;
  }

  [data-site-search-trigger]:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px hsl(var(--canvas)),
      0 0 0 4px hsl(var(--brand));
  }

  [data-site-search-trigger]::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--border-angle),
      hsl(var(--line) / 0.15) 0%,
      hsl(var(--line) / 0.15) 60%,
      hsl(var(--brand) / 0.6) 75%,
      hsl(var(--glow) / 0.7) 83%,
      hsl(var(--brand) / 0.6) 91%,
      hsl(var(--line) / 0.15) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-site-search-trigger]:hover {
      transform: translateY(-3px);
      border-color: transparent;
      background-color: hsl(var(--brand-soft) / 0.35);
      color: hsl(var(--brand));
      box-shadow:
        0 8px 24px hsl(230 30% 8% / 0.08),
        0 0 16px color-mix(in srgb, hsl(var(--brand)) 14%, transparent),
        inset 0 1px 0 hsl(0 0% 100% / 0.1);
    }

    [data-site-search-trigger]:hover::before {
      opacity: 1;
      animation: var(--animate-border-spin);
    }

    [data-site-search-trigger]:active {
      transform: scale(0.93);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-site-search-trigger]:hover {
      border-color: hsl(var(--brand) / 0.35);
      color: hsl(var(--brand));
    }
  }
</style>

<style is:global>
  #site-search-dialog { transform: none; }
  #site-search-dialog:not([open]) { display: none; }
  #site-search-dialog::backdrop { background: transparent; }

  #site-search-dialog [data-site-search-scrim] {
    background: hsl(var(--theme-bg) / 0.24);
    backdrop-filter: blur(7px) saturate(0.8);
  }

  @keyframes site-search-scrim-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes site-search-scrim-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes site-search-panel-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes site-search-panel-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-6px); }
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-scrim] {
    animation: site-search-scrim-in 280ms ease both;
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-panel] {
    animation: site-search-panel-in 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-scrim] {
    animation: site-search-scrim-out 180ms ease both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-panel] {
    animation: site-search-panel-out 180ms ease both;
  }

  #site-search-results [data-site-search-group-title] {
    margin-bottom: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.625rem;
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #site-search-results [data-site-search-topics] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
  }

  #site-search-results [data-site-search-suggestion] {
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.25rem;
    border-bottom: 1px solid hsl(var(--line) / 0.6);
    color: hsl(var(--ink));
    font-size: 0.8125rem;
    text-align: left;
    overflow-wrap: anywhere;
    transition: background-color 160ms ease;
  }

  #site-search-results [data-site-search-suggestion] > [aria-hidden] {
    flex-shrink: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.5625rem;
    font-variant-numeric: tabular-nums;
  }

  #site-search-results [data-site-search-suggestion]:hover {
    background: hsl(var(--surface-muted));
  }

  #site-search-results [data-site-search-result] {
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem 0.5rem;
    border-bottom: 1px solid hsl(var(--line) / 0.6);
    border-radius: 0.5rem;
    transition: background-color 160ms ease;
  }

  #site-search-results [data-site-search-active="true"],
  #site-search-results [data-site-search-result]:hover {
    background: hsl(var(--surface-muted));
  }

  #site-search-results [data-site-search-result-type] {
    color: hsl(var(--ink-soft));
    font-size: 0.5625rem;
    font-weight: 550;
    letter-spacing: 0.12em;
    line-height: 1rem;
    text-transform: uppercase;
  }

  #site-search-results [data-site-search-result-title] {
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }

  #site-search-results [data-site-search-active="true"] [data-site-search-result-title] {
    text-decoration: underline;
    text-decoration-color: hsl(var(--brand));
    text-underline-offset: 0.2em;
  }

  #site-search-results [data-site-search-thumb-frame] {
    position: relative;
    flex-shrink: 0;
    align-self: center;
    width: 4rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.375rem;
    background: hsl(var(--surface-muted));
  }

  #site-search-results [data-site-search-thumb] {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    object-fit: contain;
    object-position: center;
    transition: opacity 160ms ease;
  }

  #site-search-results [data-site-search-thumb-state="loaded"] { opacity: 1; }
  #site-search-results [data-site-search-thumb-state="error"] { display: none; }

  #site-search-results [data-site-search-thumb-placeholder] {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: hsl(var(--surface-muted));
  }

  #site-search-results [data-site-search-thumb-loaded="true"] [data-site-search-thumb-placeholder] {
    opacity: 0;
  }

  @media (max-width: 639px) {
    #site-search-results [data-site-search-topics] { column-gap: 0.75rem; }
    #site-search-results [data-site-search-thumb-frame] { width: 3rem; }
  }

  @media (max-width: 359px) {
    #site-search-results [data-site-search-topics] { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-search-dialog[open] :is([data-site-search-panel], [data-site-search-scrim]) {
      animation: none;
    }
    #site-search-results :is([data-site-search-suggestion], [data-site-search-result], [data-site-search-thumb]) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    /** @type {import('@/types/search').SearchIndexEntry[]} */
    let entries = []
    let selectedResultIndex = -1
    let closeAnimTimer = 0
    let closeAnimPanel = /** @type {HTMLElement | null} */ (null)
    let closeAnimHandler = /** @type {((event: AnimationEvent) => void) | null} */ (null)
    let indexLoadState = /** @type {'idle' | 'loading' | 'ready' | 'error'} */ ('idle')
    let indexLoadPromise = /** @type {Promise<boolean> | null} */ (null)
    let popularTopics = /** @type {string[]} */ ([])
    /** @param {unknown} value @returns {value is Record<string, unknown>} */
    const isRecord = value => typeof value === 'object' && value !== null && !Array.isArray(value)

    /** @param {unknown} value @returns {value is string} */
    const isLocalPath = value => {
      if (typeof value !== 'string' || !value.startsWith('/') || value.startsWith('//') || value.includes('\\')) {
        return false
      }

      try {
        return new URL(value, window.location.origin).origin === window.location.origin
      } catch {
        return false
      }
    }

    /** @param {unknown} value */
    const isImageDimension = value => value === undefined ||
      (typeof value === 'number' && Number.isInteger(value) && value > 0)

    /** @param {unknown} value @returns {value is import('@/types/search').SearchIndexEntry} */
    const isSearchEntry = value => {
      if (!isRecord(value)) return false

      return typeof value.title === 'string' && value.title.trim().length > 0 &&
        typeof value.description === 'string' && isLocalPath(value.path) &&
        Array.isArray(value.tags) && value.tags.every(/** @param {unknown} tag */ tag => typeof tag === 'string') &&
        typeof value.type === 'string' && ['community', 'post', 'project'].includes(value.type) &&
        (value.coverAlt === undefined || typeof value.coverAlt === 'string') &&
        (value.coverUrl === undefined || isLocalPath(value.coverUrl)) &&
        (value.coverAvifUrl === undefined || isLocalPath(value.coverAvifUrl)) &&
        isImageDimension(value.coverWidth) && isImageDimension(value.coverHeight)
    }

    const RECENT_SEARCHES_KEY = 'site-search-recent'
    const RECENT_SEARCHES_LIMIT = 5

    /** @returns {string[]} */
    const getRecentSearches = () => {
      try {
        const raw = window.localStorage?.getItem(RECENT_SEARCHES_KEY)

        if (!raw) return []

        /** @type {unknown} */
        const parsed = JSON.parse(raw)

        return Array.isArray(parsed) ? parsed.filter(/** @param {unknown} value */ value => typeof value === 'string') : []
      } catch {
        return []
      }
    }

    /** @param {string} query */
    const rememberRecentSearch = query => {
      const trimmed = query.trim()

      if (trimmed.length < 2) return

      try {
        const list = getRecentSearches().filter(v => v.toLowerCase() !== trimmed.toLowerCase())

        list.unshift(trimmed)

        const next = list.slice(0, RECENT_SEARCHES_LIMIT)

        window.localStorage?.setItem(RECENT_SEARCHES_KEY, JSON.stringify(next))
      } catch {
        /* localStorage may be unavailable (private mode); fail silently. */
      }
    }

    const computePopularTopics = () => {
      // Blog tags ("typescript") and project technologies ("TypeScript") name the
      // same topic with different casing; merge them by lowercase key so the list
      // doesn't show visible near-duplicates, keeping whichever casing reads best.
      /** @type {Map<string, { count: number, label: string, upperCount: number }>} */
      const counts = new Map()

      for (const entry of entries) {
        for (const tag of entry.tags) {
          const key = tag.toLowerCase()
          const upperCount = (tag.match(/[A-Z]/g) ?? []).length
          const existing = counts.get(key)

          if (existing) {
            existing.count += 1

            if (upperCount > existing.upperCount) {
              existing.label = tag

              existing.upperCount = upperCount
            }
          } else {
            counts.set(key, { count: 1, label: tag, upperCount })
          }
        }
      }

      popularTopics = [...counts.values()]
        .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
        .slice(0, 8)
        .map(entry => entry.label)
    }

    const getDialog = () => document.querySelector('#site-search-dialog')
    const getInput = () => document.querySelector('#site-search-input')
    const getResults = () => document.querySelector('#site-search-results')
    const getStatus = () => document.querySelector('#site-search-status')
    const getTrigger = () => document.querySelector('[data-site-search-trigger]')
    const getPanel = () => document.querySelector('[data-site-search-panel]')

    const setScrollLock = locked => {
      document.documentElement.classList.toggle('site-search-open', locked)

      document.body.classList.toggle('site-search-open', locked)
    }

    const prefersReducedMotion = () => window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches === true

    const setTriggerExpanded = open => {
      const trigger = getTrigger()

      if (trigger instanceof HTMLButtonElement) {
        trigger.setAttribute('aria-expanded', String(open))
      }
    }

    const syncResultSelection = () => {
      const results = getResults()

      if (!results) return

      const anchors = results.querySelectorAll('a[href]')

      anchors.forEach((a, i) => {
        if (i === selectedResultIndex) {
          a.setAttribute('data-site-search-active', 'true')

          a.scrollIntoView({
            block: 'nearest',
            behavior: prefersReducedMotion() ? 'auto' : 'smooth'
          })
        } else {
          a.removeAttribute('data-site-search-active')
        }
      })
    }

    /**
     * @param {string} message
     */
    const setStatusMessage = message => {
      const status = getStatus()

      if (!(status instanceof HTMLElement)) return

      if (status.textContent === message) return

      status.textContent = message
    }

    /**
     * Announces the highlighted result while keyboard focus remains in the input.
     * @param {number} index
     * @param {number} total
     * @returns {string}
     */
    const describeResultAt = (index, total) => {
      const results = getResults()

      if (!results) return ''

      const anchors = [...results.querySelectorAll('a[href]')]
      const title = anchors[index]?.querySelector('[data-site-search-result-title]')?.textContent?.trim()

      if (!title) return ''

      return `${title}, ${index + 1} of ${total}`
    }

    /**
     * Renders the empty state shown before the user starts typing. Prefers a
     * "Recent searches" list when localStorage has prior queries, otherwise
     * falls back to "Popular topics" derived from the loaded index.
     * @param {HTMLElement} results
     */
    const renderEmptyState = results => {
      const recentSearches = getRecentSearches()
      const hasRecentSearches = recentSearches.length > 0
      const items = hasRecentSearches ? recentSearches : popularTopics

      if (items.length === 0) {
        results.innerHTML = `
          <li class="
            site-search-hint flex flex-col items-center justify-center gap-3
            px-4 py-10 text-center
          ">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface-muted/80 text-ink-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
                <path d="M11 8v6" />
                <path d="M8 11h6" />
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-sm font-medium text-ink">Start typing to search</p>
              <p class="text-xs text-ink-soft">Enter at least 2 characters to find posts, projects, and community work.</p>
            </div>
          </li>
        `

        setStatusMessage('Type at least two characters to search.')

        return
      }

      const heading = hasRecentSearches ? 'Recent searches' : 'Popular topics'
    const li = document.createElement('li')

      li.className = 'site-search-hint'

      const label = document.createElement('div')

      label.setAttribute('data-site-search-group-title', '')

      label.textContent = heading

      li.appendChild(label)

      const chips = document.createElement('div')

      chips.setAttribute('data-site-search-topics', '')

      for (const [index, item] of items.entries()) {
        const chip = document.createElement('button')

        chip.type = 'button'

        chip.dataset.siteSearchSuggestion = item

        const number = document.createElement('span')

        number.setAttribute('aria-hidden', 'true')

        number.textContent = String(index + 1).padStart(2, '0')

        const text = document.createElement('span')

        text.textContent = item

        chip.append(number, text)

        chips.appendChild(chip)
      }

      li.appendChild(chips)

      results.innerHTML = ''

      results.appendChild(li)

      setStatusMessage(`${items.length} ${heading.toLowerCase()} available.`)
    }

    /**
     * @param {typeof entries[number]} entry
     * @param {string} normalizedQuery
     */
    const rankEntry = (entry, normalizedQuery) => {
      const normalizedTitle = entry.title.toLowerCase()
      const normalizedDescription = entry.description.toLowerCase()
      const normalizedTags = entry.tags.map(tag => tag.toLowerCase())
      const terms = normalizedQuery.split(/\s+/).filter(Boolean)
      let score = 0

      if (normalizedTitle === normalizedQuery) score += 120

      if (normalizedTitle.startsWith(normalizedQuery)) score += 90
      else if (normalizedTitle.includes(normalizedQuery)) score += 55

      if (normalizedTags.some(tag => tag === normalizedQuery)) score += 48
      else if (normalizedTags.some(tag => tag.startsWith(normalizedQuery))) score += 36

      if (normalizedDescription.includes(normalizedQuery)) score += 16

      for (const term of terms) {
        let termMatched = false

        if (normalizedTitle.startsWith(term)) {
          score += 22

          termMatched = true
        } else if (normalizedTitle.includes(term)) {
          score += 14

          termMatched = true
        }

        if (normalizedTags.some(tag => tag === term)) {
          score += 16

          termMatched = true
        } else if (normalizedTags.some(tag => tag.startsWith(term))) {
          score += 11

          termMatched = true
        } else if (normalizedTags.some(tag => tag.includes(term))) {
          score += 7

          termMatched = true
        }

        if (normalizedDescription.includes(term)) {
          score += 6

          termMatched = true
        }

        if (!termMatched) return 0
      }

      return score
    }

    const render = query => {
      const results = getResults()

      if (!results) return

      results.innerHTML = ''

      const trimmed = query.trim()

      if (indexLoadState === 'loading') {
        selectedResultIndex = -1

        results.innerHTML = `
          <li class="
            site-search-hint flex flex-col items-center justify-center gap-3
            px-4 py-8 text-center
          ">
            <span class="relative flex h-8 w-8">
              <span class="absolute inset-0 rounded-full border-2 border-line/30"></span>
              <span
                class="absolute inset-0 animate-spin rounded-full border-2 border-brand/60 border-t-transparent motion-reduce:animate-none"
              ></span>
            </span>
            <span class="text-sm text-ink-soft">Loading search index…</span>
          </li>
        `

        setStatusMessage('Loading search index.')

        return
      }

      if (indexLoadState === 'error') {
        selectedResultIndex = -1

        results.innerHTML = `
          <li
            class="
              site-search-hint flex flex-col items-center justify-center gap-4
              px-4 py-8 text-center
            "
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-danger/10 text-danger">
              <svg
                xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <line x1="12" x2="12" y1="8" y2="12" />
                <line x1="12" x2="12.01" y1="16" y2="16" />
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-sm font-medium text-ink">Search unavailable</p>
              <p class="text-xs text-ink-soft">We couldn't load the search index.</p>
            </div>
            <button
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-line bg-surface-muted px-4 py-2 text-xs font-medium text-ink"
              data-site-search-retry
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                <path d="M21 3v5h-5" />
                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                <path d="M8 16H3v5" />
              </svg>
              Try again
            </button>
          </li>
        `

        setStatusMessage('Search is temporarily unavailable.')

        return
      }

      if (trimmed.length < 2) {
        selectedResultIndex = -1

        renderEmptyState(results)

        return
      }

      const normalized = trimmed.toLowerCase()

      const matches = entries
        .map(entry => {
          const score = rankEntry(entry, normalized)

          return { entry, score }
        })
        .filter(item => item.score > 0)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score

          const typeOrder = { community: 0, project: 1, post: 2 }
          const typeDiff = (typeOrder[a.entry.type] ?? 2) - (typeOrder[b.entry.type] ?? 2)

          if (typeDiff !== 0) return typeDiff

          return a.entry.title.localeCompare(b.entry.title)
        })
        .slice(0, 8)

      if (matches.length === 0) {
        selectedResultIndex = -1

        results.innerHTML = `
          <li class="
            site-search-hint flex flex-col items-center justify-center gap-3
            px-4 py-10 text-center
          ">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-surface-muted/80 text-ink-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
                <path d="m8 8 6 6" />
                <path d="m14 8-6 6" />
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-sm font-medium text-ink">No results found</p>
              <p class="text-xs text-ink-soft">Try different keywords or check your spelling.</p>
            </div>
            <button
              type="button"
              data-site-search-clear
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-line bg-surface-muted px-4 py-2 text-xs font-medium text-ink"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              >
                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                <path d="M21 3v5h-5" />
              </svg>
              Clear search
            </button>
          </li>
        `

        setStatusMessage(`No matching results for ${trimmed}. Try different keywords.`)

        return
      }

      selectedResultIndex = Math.min(Math.max(selectedResultIndex, 0), matches.length - 1)

      for (const match of matches) {
        const e = match.entry
        const li = document.createElement('li')
        const a = document.createElement('a')

        a.href = e.path

        a.setAttribute('data-site-search-result', '')

        const thumbHost = document.createElement('span')

        thumbHost.setAttribute('data-site-search-thumb-frame', '')

        if (e.coverUrl) {
          const placeholder = document.createElement('span')

          placeholder.setAttribute('aria-hidden', 'true')

          placeholder.setAttribute('data-site-search-thumb-placeholder', '')

          const picture = document.createElement('picture')

          if (e.coverAvifUrl) {
            const avifSource = document.createElement('source')

            avifSource.type = 'image/avif'

            avifSource.srcset = e.coverAvifUrl

            picture.appendChild(avifSource)
          }

          const img = document.createElement('img')

          img.src = e.coverUrl

          img.alt = e.coverAlt || e.title

          img.decoding = 'async'

          img.loading = 'eager'

          img.setAttribute('data-site-search-thumb', '')

          img.setAttribute('data-site-search-thumb-state', 'loading')

          img.addEventListener('load', () => {
            img.setAttribute('data-site-search-thumb-state', 'loaded')

            thumbHost.setAttribute('data-site-search-thumb-loaded', 'true')
          })

          img.addEventListener('error', () => {
            img.setAttribute('data-site-search-thumb-state', 'error')

            thumbHost.removeAttribute('data-site-search-thumb-loaded')

            img.alt = ''
          })

          picture.appendChild(img)

          thumbHost.append(placeholder, picture)
        } else {
          const ph = document.createElement('span')

          ph.className = 'block size-full grid-fade'

          ph.setAttribute('aria-hidden', 'true')

          thumbHost.appendChild(ph)
        }

        const body = document.createElement('span')

        body.className = 'flex min-w-0 flex-1 flex-col justify-center gap-0.5'

        const typeEl = document.createElement('span')

        typeEl.setAttribute('data-site-search-result-type', '')

        let resultTypeLabel = 'Project'

        if (e.type === 'post') {
          resultTypeLabel = 'Post'
        } else if (e.type === 'community') {
          resultTypeLabel = 'Community'
        }

        typeEl.textContent = resultTypeLabel

        const titleEl = document.createElement('span')

        titleEl.setAttribute('data-site-search-result-title', '')

        titleEl.textContent = e.title

        const descEl = document.createElement('span')

        descEl.className = 'line-clamp-2 text-xs/5 text-ink-soft'

        descEl.textContent = e.description

        body.append(typeEl, titleEl, descEl)

        a.append(thumbHost, body)

        li.appendChild(a)

        results.appendChild(li)
      }

      syncResultSelection()

      setStatusMessage(
        `${matches.length} ${matches.length === 1 ? 'result' : 'results'} available. Use arrow keys to navigate.`
      )
    }

    // Keep only one close cycle alive so a stale callback cannot close a reopened dialog.
    const cancelPendingClose = () => {
      window.clearTimeout(closeAnimTimer)

      closeAnimTimer = 0

      if (closeAnimHandler) {
        closeAnimPanel?.removeEventListener('animationend', closeAnimHandler)

        closeAnimHandler = null
      }

      closeAnimPanel = null
    }

    const openSearch = () => {
      const dialog = getDialog()
      const input = getInput()

      if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)) return

      cancelPendingClose()

      dialog.removeAttribute('data-site-search-anim')

      if (!dialog.open) {
        dialog.showModal()
      }

      setScrollLock(true)

      setTriggerExpanded(true)

      window.requestAnimationFrame(() => {
        input.focus()

        input.select()

        render(input.value)
      })
    }

    /**
     * @param {{ focusTrigger?: boolean }} [options]
     */
    const closeSearch = (options = {}) => {
      const { focusTrigger = false } = options
      const dialog = getDialog()

      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return

      cancelPendingClose()

      const finish = () => {
        cancelPendingClose()

        if (dialog.open) {
          dialog.close()
        }

        setScrollLock(false)

        /* Remove after `close()` so `[open]` never pairs with "not closing" (intro CSS). */
        dialog.removeAttribute('data-site-search-anim')

        if (focusTrigger) {
          const t = getTrigger()

          if (t instanceof HTMLElement) {
            t.focus()
          }
        }
      }

      if (prefersReducedMotion()) {
        finish()

        return
      }

      const panel = getPanel()

      if (!(panel instanceof HTMLElement)) {
        finish()

        return
      }

      dialog.setAttribute('data-site-search-anim', 'closing')

      const onAnimEnd = e => {
        if (e.animationName !== 'site-search-panel-out') return

        finish()
      }

      closeAnimPanel = panel

      closeAnimHandler = onAnimEnd

      panel.addEventListener('animationend', onAnimEnd)

      closeAnimTimer = window.setTimeout(finish, 420)
    }

    const isEditableTarget = target => {
      if (!(target instanceof HTMLElement)) return false

      if (target.isContentEditable) return true

      const tag = target.tagName

      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true

      return false
    }

    /**
     * @param {{ force?: boolean }} [options]
     */
    const loadIndex = async (options = {}) => {
      const { force = false } = options

      if (!force && indexLoadState === 'ready' && entries.length > 0) return true

      if (!force && indexLoadPromise) return indexLoadPromise

      indexLoadState = 'loading'

      render(getInput()?.value ?? '')

      indexLoadPromise = fetch('/search-index.json')
        .then(response => {
          if (!response.ok) {
            throw new Error('Failed search index response')
          }

          return response.json()
        })
        .then(/** @param {unknown} json */ json => {
          if (!Array.isArray(json) || !json.every(isSearchEntry)) {
            throw new TypeError('Invalid search index response')
          }

          entries = json

          computePopularTopics()

          indexLoadState = 'ready'

          return true
        })
        .catch(() => {
          entries = []

          indexLoadState = 'error'

          return false
        })
        .finally(() => {
          indexLoadPromise = null

          render(getInput()?.value ?? '')
        })

      return indexLoadPromise
    }

    const bindUi = () => {
      const root = document.querySelector('[data-site-search]')

      if (!root || root.getAttribute('data-site-search-bound') === 'true') return

      const trigger = root.querySelector('[data-site-search-trigger]')
      const closeBtn = root.querySelector('[data-site-search-close]')
      const inputClearBtn = root.querySelector('[data-site-search-input-clear]')
      const input = getInput()
      const results = getResults()
      const dialog = getDialog()
      const scrim = dialog.querySelector('[data-site-search-scrim]')

      if (!(trigger instanceof HTMLButtonElement) || !(closeBtn instanceof HTMLButtonElement) ||
        !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement) ||
        !(dialog instanceof HTMLDialogElement)) {
        return
      }

      root.setAttribute('data-site-search-bound', 'true')

      trigger.addEventListener('click', () => {
        if (dialog.open) {
          closeSearch({ focusTrigger: true })

          return
        }

        openSearch()

        loadIndex()
      })

      closeBtn.addEventListener('click', () => {
        closeSearch({ focusTrigger: true })
      })

      if (inputClearBtn instanceof HTMLButtonElement) {
        inputClearBtn.addEventListener('click', () => {
          input.value = ''

          input.dispatchEvent(new Event('input', { bubbles: true }))

          input.focus()
        })
      }

      if (scrim instanceof HTMLElement) {
        scrim.addEventListener('click', () => {
          closeSearch({ focusTrigger: true })
        })
      }

      dialog.addEventListener('close', () => {
        // Native close events may arrive after a rapid reopen or a page swap.
        if (dialog.open || !dialog.isConnected) return

        cancelPendingClose()

        setScrollLock(false)

        setTriggerExpanded(false)

        const url = new URL(window.location.href)

        if (url.searchParams.has('q')) {
          url.searchParams.delete('q')

          window.history.replaceState({}, '', url)
        }
      })

      dialog.addEventListener('cancel', e => {
        e.preventDefault()

        closeSearch({ focusTrigger: true })
      })

      dialog.addEventListener('keydown', e => {
        if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return

        // The native dialog may tab into browser chrome when the loading state
        // leaves the input last. Keep both ends inside as results come and go.
        if (e.key === 'Tab') {
          const focusable = [...dialog.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')]
            .filter(element => element instanceof HTMLElement && element.getClientRects().length > 0 &&
              element.tabIndex >= 0 && getComputedStyle(element).visibility === 'visible')

          const first = focusable.at(0)
          const last = focusable.at(-1)
          const boundary = e.shiftKey ? first : last
          const destination = e.shiftKey ? last : first

          if (document.activeElement === boundary && destination instanceof HTMLElement) {
            e.preventDefault()

            destination.focus({ preventScroll: true })
          }

          return
        }

        if (e.key === 'Escape') {
          // Override the native search-input clear action and keep the underlying menu open.
          e.preventDefault()

          e.stopPropagation()

          closeSearch({ focusTrigger: true })

          return
        }

        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return

        const links = [...results.querySelectorAll('a[href]')]

        if (links.length === 0) return

        e.preventDefault()

        if (e.key === 'ArrowDown') {
          if (selectedResultIndex < 0) {
            selectedResultIndex = 0
          } else {
            selectedResultIndex = (selectedResultIndex + 1) % links.length
          }
        } else if (selectedResultIndex < 0) {
          selectedResultIndex = links.length - 1
        } else {
          selectedResultIndex = (selectedResultIndex - 1 + links.length) % links.length
        }

        syncResultSelection()

        const description = describeResultAt(selectedResultIndex, links.length)

        if (description) setStatusMessage(description)
      })

      input.addEventListener('keydown', e => {
        if (e.key !== 'Enter') return

        const links = [...results.querySelectorAll('a[href]')]

        if (selectedResultIndex < 0 || selectedResultIndex >= links.length) return

        e.preventDefault()

        rememberRecentSearch(input.value)

        links[selectedResultIndex].click()
      })

      input.addEventListener('input', () => {
        const value = input.value

        render(value)

        const next = new URL(window.location.href)
        const trimmed = value.trim()

        if (trimmed.length >= 2) {
          next.searchParams.set('q', trimmed)
        } else {
          next.searchParams.delete('q')
        }

        window.history.replaceState({}, '', next)
      })

      results.addEventListener('click', event => {
        const retryButton =
          event.target instanceof Element ? event.target.closest('[data-site-search-retry]') : null

        if (retryButton instanceof HTMLButtonElement) {
          event.preventDefault()

          input.focus()

          loadIndex({ force: true })

          return
        }

        const suggestion =
          event.target instanceof Element ?
            event.target.closest('[data-site-search-suggestion]') :
            null

        if (suggestion instanceof HTMLButtonElement) {
          event.preventDefault()

          const term = suggestion.dataset.siteSearchSuggestion ?? ''

          if (term) {
            input.value = term

            input.dispatchEvent(new Event('input', { bubbles: true }))

            input.focus()
          }

          return
        }

        const clearButton =
          event.target instanceof Element ?
            event.target.closest('[data-site-search-clear]') :
            null

        if (clearButton instanceof HTMLButtonElement) {
          event.preventDefault()

          input.value = ''

          input.dispatchEvent(new Event('input', { bubbles: true }))

          input.focus()

          return
        }

        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null

        if (!anchor) return

        rememberRecentSearch(input.value)

        closeSearch()
      })

      results.addEventListener('mousemove', event => {
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null

        if (!anchor) return

        const links = [...results.querySelectorAll('a[href]')]
        const next = links.indexOf(anchor)

        if (next < 0 || next === selectedResultIndex) return

        selectedResultIndex = next

        syncResultSelection()
      })

      // Defer the search-index fetch until the user actually opens the modal
      // (trigger click, Cmd/Ctrl+K, or '/'), or arrives with a `?q=` deep-link.
      // This avoids a network + parse cost on every page navigation.
      const params = new URLSearchParams(window.location.search)
      const queryFromURL = params.get('q')

      if (queryFromURL && queryFromURL.trim().length >= 2) {
        openSearch()

        input.value = queryFromURL

        loadIndex()
          .then(() => render(queryFromURL))
          .catch(() => undefined)
      }
    }

    const onGlobalKeydown = event => {
      const dialog = getDialog()
      const isOpen = dialog instanceof HTMLDialogElement && dialog.open

      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        if (!isOpen && isEditableTarget(event.target)) return

        event.preventDefault()

        if (!isOpen) {
          openSearch()
        }

        loadIndex()

        return
      }

      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        if (isOpen) return

        if (isEditableTarget(event.target)) return

        event.preventDefault()

        openSearch()

        loadIndex()
      }
    }

    if (!window.__siteSearchGlobalKeys) {
      window.__siteSearchGlobalKeys = true

      document.addEventListener('keydown', onGlobalKeydown)
    }

    bindUi()

    document.addEventListener('astro:before-swap', () => {
      cancelPendingClose()

      setScrollLock(false)
    })

    document.addEventListener('astro:after-swap', bindUi)
  })()
</script>
