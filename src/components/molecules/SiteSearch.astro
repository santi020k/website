---
import { Button, Icon } from '@santi020k/lumen-astro'

import SearchDialog from './SearchDialog.astro'
import SearchEmptyState from './SearchEmptyState.astro'
---

<div class="relative flex shrink-0 items-center" data-site-search>
  <Button
    aria-controls="site-search-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open site search"
    data-site-search-trigger
    size="icon"
    type="button"
    variant="ghost"
  >
    <Icon class="size-5 shrink-0" name="search" />
  </Button>

  <SearchDialog />
  <template data-site-search-empty-template>
    <SearchEmptyState />
  </template>
  <template data-site-search-idle-template>
    <SearchEmptyState idle />
  </template>
  <template data-site-search-result-arrow-template>
    <Icon class="size-4.5" name="arrow-up-right" />
  </template>
</div>

<style is:global>
  #site-search-dialog { transform: none; }
  #site-search-dialog:not([open]) { display: none; }
  #site-search-dialog::backdrop { background: transparent; }

  #site-search-dialog [data-site-search-scrim] {
    background: hsl(var(--theme-bg) / 0.24);
    backdrop-filter: blur(7px) saturate(0.8);
  }

  @keyframes site-search-scrim-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes site-search-scrim-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes site-search-panel-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes site-search-panel-out {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-6px); }
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-scrim] {
    animation: site-search-scrim-in 280ms ease both;
  }

  #site-search-dialog[open]:not([data-site-search-anim="closing"]) [data-site-search-panel] {
    animation: site-search-panel-in 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-scrim] {
    animation: site-search-scrim-out 180ms ease both;
  }

  #site-search-dialog[data-site-search-anim="closing"] [data-site-search-panel] {
    animation: site-search-panel-out 180ms ease both;
  }

  #site-search-results [data-site-search-group-title] {
    margin-bottom: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.625rem;
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #site-search-results [data-site-search-topics] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
  }

  #site-search-results [data-site-search-suggestion] {
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.25rem;
    border-bottom: 1px solid hsl(var(--line) / 0.6);
    color: hsl(var(--ink));
    font-size: 0.8125rem;
    text-align: left;
    overflow-wrap: anywhere;
    transition: background-color 160ms ease;
  }

  #site-search-results [data-site-search-suggestion] > [aria-hidden] {
    flex-shrink: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.5625rem;
    font-variant-numeric: tabular-nums;
  }

  #site-search-results [data-site-search-suggestion]:hover {
    background: hsl(var(--surface-muted));
  }

  #site-search-results [data-site-search-result] {
    display: flex;
    align-items: flex-start;
    gap: 1.375rem;
    min-height: 2.75rem;
    padding: 1.375rem 1rem;
    border-bottom: 1px solid hsl(var(--line) / 0.6);
    border-radius: 0;
    overflow-wrap: anywhere;
    transition: background-color 160ms ease;
  }

  #site-search-results [data-site-search-active="true"],
  #site-search-results [data-site-search-result]:hover {
    background: hsl(var(--brand-soft));
  }

  #site-search-results [data-site-search-result-body] { display: flex; flex: 1; flex-direction: column; gap: 0.5rem; min-width: 0; padding-block: 0.25rem; }

  #site-search-results [data-site-search-result-type] {
    color: hsl(var(--accent));
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.6;
  }
  :root[data-theme='dark'] #site-search-results [data-site-search-result-type] {
    color: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  #site-search-results [data-site-search-result-title] {
    color: hsl(var(--ink));
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.04em;
  }

  #site-search-results :is([data-site-search-active="true"], [data-site-search-result]:hover, [data-site-search-result]:focus-visible) [data-site-search-result-title] {
    text-decoration: underline;
    text-decoration-color: hsl(var(--accent));
    text-underline-offset: 0.2em;
  }

  #site-search-results [data-site-search-result-description] { color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.7; }
  /* The row owns the inset, so the arrow stays clear of every hover/focus edge. */
  #site-search-results [data-site-search-result-arrow] { display: flex; align-self: flex-end; flex-shrink: 0; color: hsl(var(--accent)); }

  #site-search-results [data-site-search-thumb-frame] {
    position: relative;
    flex-shrink: 0;
    align-self: flex-start;
    width: 7.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.25rem 1.125rem 1.125rem 0.25rem;
    background: hsl(var(--brand-soft));
  }

  #site-search-results [data-site-search-thumb] {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0.75rem;
    opacity: 0;
    object-fit: contain;
    object-position: center;
    transition: opacity 160ms ease;
  }

  #site-search-results [data-site-search-thumb-state="loaded"] { opacity: 1; }
  #site-search-results [data-site-search-thumb-state="error"] { display: none; }

  #site-search-results [data-site-search-thumb-placeholder] {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: hsl(var(--brand-soft));
  }

  #site-search-results [data-site-search-thumb-loaded="true"] [data-site-search-thumb-placeholder] {
    opacity: 0;
  }

  /* Queries the dialog container from SearchDialog, so they also follow root text size. */
  @container site-search (width < 40rem) {
    #site-search-results [data-site-search-topics] { column-gap: 0.75rem; }
    #site-search-results [data-site-search-thumb-frame] { width: 4rem; }
    #site-search-results [data-site-search-thumb] { padding: 0.375rem; }
    #site-search-results [data-site-search-result] { gap: 1rem; padding: 1.125rem 0.75rem; }
    #site-search-results [data-site-search-result-title] { font-size: 1.125rem; }
    #site-search-results [data-site-search-result-arrow] { display: none; }
  }

  @container site-search (width < 22.5rem) {
    #site-search-results [data-site-search-topics] { grid-template-columns: 1fr; }
  }

  @container site-search (height < 31.25rem) {
    #site-search-results [data-site-search-result] { padding-block: 0.75rem; }
    #site-search-results [data-site-search-thumb-frame] { width: 4rem; }
    #site-search-results [data-site-search-thumb] { padding: 0.375rem; }
    #site-search-results [data-site-search-result-title] { font-size: 1.125rem; }
    #site-search-results [data-site-search-result-arrow] { display: none; }
  }

  /* At enlarged text sizes, give the title the full row instead of a narrow
     column beside a decorative thumbnail. Keep the title and description. */
  @container site-search (width < 20rem) {
    #site-search-results [data-site-search-thumb-frame] { display: none; }
    #site-search-results [data-site-search-result] { gap: 0; padding: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-search-dialog[open] :is([data-site-search-panel], [data-site-search-scrim]) {
      animation: none;
    }
    #site-search-results :is([data-site-search-suggestion], [data-site-search-result], [data-site-search-thumb]) {
      transition: none;
    }
  }
</style>

<script>
  import './site-search'
</script>
