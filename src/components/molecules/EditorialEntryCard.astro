---
import Pill from '@/components/atoms/Pill.astro'
import { Card } from '@/components/ui'

import { getSeriesPath } from '@/utils/links'

interface Props {
  format: string
  headline: string
  month: string
  refreshTitle: string
  searchIntent?: string
  seriesId: string | undefined
  variant?: 'full' | 'compact'
}

const {
  format,
  headline,
  month,
  refreshTitle,
  searchIntent,
  seriesId,
  variant = 'full'
} = Astro.props
---

{
  variant === 'full' ?
    (
      <Card
        as="article"
        class="
          flex h-full flex-col gap-5 p-6
          sm:p-7
        "
      >
        <div class="flex flex-wrap items-center gap-2">
          <Pill label={month} tone="brand" />
          <Pill label={format} tone="outline" />
        </div>

        <div class="space-y-3">
          <h2 class="text-2xl/tight text-ink">{headline}</h2>
          {searchIntent && (
            <p class="text-sm/7 text-ink-soft">Search intent: {searchIntent}</p>
          )}
        </div>

        <div class="border-t border-line/35 pt-5">
          <p class="section-label">Evergreen refresh</p>
          <p class="mt-3 text-sm/6 font-semibold text-ink">{refreshTitle}</p>
        </div>

        {seriesId && (
          <a
            class="
              inline-flex items-center gap-2 text-sm font-medium text-brand
              transition-colors
              hover:text-accent
            "
            href={getSeriesPath(seriesId)}
          >
            Continue the related series
          </a>
        )}
      </Card>
    ) :
    (
      <article class="
        mini-note flex h-full flex-col gap-5 p-5
        sm:p-6
      "
      >
        <div class="flex flex-wrap items-center gap-2">
          <Pill label={month} tone="brand" />
          <Pill label={format} tone="outline" />
        </div>
        <h2 class="text-[1.05rem]/snug font-semibold text-ink">{headline}</h2>
        <div class="mt-auto space-y-1.5 pt-4">
          <div class="flex items-center gap-2">
            <span class="h-px w-3 rounded-full bg-brand/40"></span>
            <span class="
              text-[0.7rem] font-medium tracking-wide text-brand uppercase
            "
            >Also refreshing
            </span>
          </div>
          <p class="pl-5 text-sm/6 text-ink-muted">{refreshTitle}</p>
        </div>
      </article>
    )
}
