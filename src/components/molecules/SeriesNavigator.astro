---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import ButtonLink from '@/components/atoms/ButtonLink.astro'

import { getPostPath, getSeriesPath } from '@/utils/links'

import { Collapsible, Icon } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  currentPostId: string
  next?: CollectionEntry<'post'> | undefined
  position: number
  posts: CollectionEntry<'post'>[]
  previous?: CollectionEntry<'post'> | undefined
  series: CollectionEntry<'series'>
  total: number
}

const { currentPostId, next, position, posts, previous, series, total } = Astro.props
const seriesPath = getSeriesPath(series.id)
const isLatestChapter = !next
---

<section class="not-prose mt-16 py-8" data-series-content data-series-close={isLatestChapter || undefined} id="series-navigation">
  <header data-series-intro>
    <div data-series-context>
      <span>{isLatestChapter ? t('collection.latestPublishedChapter') : t('collection.continueTheSeries')}</span>
      <span data-series-position>{locale === 'es' ? `Artículo ${position} de ${total}` : `Post ${position} of ${total}`}</span>
    </div>
    {isLatestChapter ?
(
      <>
        <h2 data-series-heading>{t('collection.atTheLatestChapter')}</h2>
        <a data-series-navigator-title href={localizePath(seriesPath, locale)}>{series.data.title}</a>
        <p data-series-description>
          {previous ? t('collection.revisitAnEarlierChapterOrExplore') : t('collection.exploreTheSeriesOverview')}
        </p>
      </>
    ) :
(
      <>
        <h2 data-series-heading>
          <a data-series-navigator-title href={localizePath(seriesPath, locale)}>{series.data.title}</a>
        </h2>
        <p data-series-description>{series.data.description}</p>
      </>
    )}
  </header>

  {(previous ?? next) && (
    <nav
      aria-label={(locale === 'es' ? `Continúa leyendo ${series.data.title}` : `Continue reading ${series.data.title}`)}
      data-series-pagination
      data-single={!(previous && next) || undefined}
    >
      {previous && (
        <a
          data-series-adjacent="previous"
          href={localizePath(getPostPath(previous.id), locale)}
          rel="prev"
        >
          {isLatestChapter ?
(
            <span data-series-close-meta>
              <span data-series-adjacent-direction>{t('collection.previous')}<span class="
                sr-only
              "
                                                                             >{t('collection.inSeries')}</span></span>
              <span data-series-adjacent-part>{t('collection.part')} {String(position - 1).padStart(2, '0')}</span>
            </span>
          ) :
(
            <span data-series-adjacent-direction>
            <ArrowExchange
class="
  size-4.5 shrink-0 text-brand
  dark:text-accent
"
direction="left"
            />
            <span>{t('collection.previousInSeries')}</span>
            </span>
          )}
          <h3 data-series-adjacent-title>{previous.data.title}</h3>
          {isLatestChapter ?
(
            <ArrowExchange
class="
  size-4 shrink-0 text-brand
  dark:text-accent
"
direction="left"
            />
          ) :
(
            <span data-series-adjacent-part>{t('collection.part')} {String(position - 1).padStart(2, '0')}</span>
          )}
        </a>
      )}

      {next && (
        <a
          data-series-adjacent="next"
          href={localizePath(getPostPath(next.id), locale)}
          rel="next"
        >
          <span data-series-adjacent-direction>
            <span>{t('collection.nextInSeries')}</span>
            <ArrowExchange
class="
  size-4.5 shrink-0 text-brand
  dark:text-accent
"
direction="right"
            />
          </span>
          <h3 data-series-adjacent-title>{next.data.title}</h3>
          <span data-series-adjacent-part>{t('collection.part')} {String(position + 1).padStart(2, '0')}</span>
        </a>
      )}
    </nav>
  )}

  <Collapsible data-series-fold>
    <summary data-series-fold-summary>
      <span>{locale === 'es' ? `Los ${total} capítulos` : `All ${total} ${total === 1 ? 'chapter' : 'chapters'}`}</span>
      <Icon class="size-4 shrink-0" name="chevron-down" />
    </summary>
    <nav aria-label={(locale === 'es' ? `Capítulos de ${series.data.title}` : `Chapters in ${series.data.title}`)} data-series-index>
      <ol data-series-track>
        {posts.map((seriesPost, index) => {
          const isCurrentPost = seriesPost.id === currentPostId

          return (
            <li>
              <a
                data-series-step
                aria-current={isCurrentPost ? 'step' : undefined}
                href={localizePath(getPostPath(seriesPost.id), locale)}
              >
                <span data-series-step-number>
                  <span class="sr-only">{t('collection.part')} {index + 1}</span>
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                </span>
                <span data-series-step-copy>
                  <span data-series-step-label>{isCurrentPost ? t('collection.readingNow') : t('collection.inThisSeries')}</span>
                  <span data-series-step-title>{seriesPost.data.title}</span>
                </span>
              </a>
            </li>
          )
        })}
      </ol>
    </nav>
  </Collapsible>

  <div data-series-footer>
    <ButtonLink href={localizePath(seriesPath, locale)} showArrow variant="inline">{t('collection.exploreTheSeries')}</ButtonLink>
  </div>
</section>

<style>
  [data-series-content] {
    --series-emphasis: hsl(var(--brand));
    container: series-navigation / inline-size;
  }

  [data-series-context] {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    color: var(--series-emphasis);
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
  }
  [data-series-position] { color: hsl(var(--ink-soft)); }
  [data-series-heading] {
    margin: 1rem 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }
  [data-series-navigator-title] { display: block; border-radius: 0.125rem; }
  [data-series-navigator-title]:is(:hover, :focus-visible) { color: var(--series-emphasis); }
  [data-series-description] { max-width: 44rem; margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-series-fold] {
    margin-block-start: 2rem;
    padding: 0;
    border: 0;
    border-block: 1px solid hsl(var(--line));
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  [data-series-fold-summary] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    margin: 0;
    padding-block: 1.25rem;
    padding-inline: 0;
    border-radius: 0;
    color: var(--series-emphasis);
    background: transparent;
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  [data-series-fold-summary]::-webkit-details-marker { display: none; }
  [data-series-fold-summary]::before, [data-series-fold-summary]::after { display: none; }
  [data-series-fold][open] > [data-series-fold-summary] { margin: 0; }
  [data-series-fold][open] [data-series-fold-summary] :global(.ui-icon) { transform: rotate(180deg); }
  [data-series-footer] { padding-top: 1rem; }

  [data-series-index] {
    container: series-track / inline-size;
    padding-block-end: 1rem;
    color: hsl(var(--ink));
  }

  :global([data-theme='dark']) [data-series-content] {
    --series-emphasis: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink)));
  }

  [data-series-track] { margin: 0; padding: 0; list-style: none; }
  [data-series-track] > li + li { border-top: 1px solid hsl(var(--line)); }

  [data-series-step] {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.625rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: break-word;
    transition: background-color 180ms ease, color 180ms ease;
  }

  [data-series-step-number] {
    color: hsl(var(--ink-soft));
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  [data-series-step-copy] { min-width: 0; }

  [data-series-step-label] {
    display: block;
    margin-bottom: 0.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }

  [data-series-step-title] {
    display: block;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.018em;
  }

  [data-series-step]:is([aria-current='step'], :hover, :focus-visible) {
    background: hsl(var(--brand-soft));
    color: var(--series-emphasis);
  }

  [data-series-step]:is([aria-current='step'], :hover, :focus-visible) :is([data-series-step-number], [data-series-step-label]) {
    color: inherit;
  }

  /* Keep the Reading index focus treatment on every chapter row. */
  [data-series-track] a:focus-visible {
    outline-offset: -4px;
  }

  [data-series-pagination] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
    margin-block-start: 2rem;
  }

  [data-series-pagination][data-single] { grid-template-columns: minmax(0, 1fr); }

  [data-series-adjacent] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-top: 1px solid hsl(var(--line));
    padding-block: 1.5rem 0.25rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: break-word;
  }

  [data-series-adjacent-direction] {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }

  [data-series-adjacent-title] {
    margin-block: 1.25rem 0;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.8125rem;
    font-weight: 500;
    letter-spacing: -0.025rem;
    transition: color 180ms ease;
  }

  [data-series-adjacent]:is(:hover, :focus-visible) [data-series-adjacent-title] {
    color: var(--series-emphasis);
  }

  [data-series-adjacent-part] {
    margin-top: auto;
    padding-top: 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  [data-series-close] [data-series-navigator-title] {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  [data-series-close] [data-series-description] { margin-block-start: 0.25rem; }
  [data-series-close] [data-series-adjacent] {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr) 1rem;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.5rem;
  }
  [data-series-close-meta] {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  [data-series-close] [data-series-adjacent-direction] { color: var(--series-emphasis); }
  [data-series-close] [data-series-adjacent-part] { margin: 0; padding: 0; }
  [data-series-close] [data-series-adjacent-title] {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
  }
  [data-series-close] [data-series-pagination] + [data-series-fold] { margin-block-start: 0.5rem; }

  @container series-navigation (width < 32.5rem) {
    [data-series-close] [data-series-adjacent] {
      grid-template-columns: minmax(0, 1fr) 1rem;
      gap: 0.75rem 1rem;
    }
    [data-series-close-meta] {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.875rem;
    }
  }

  @container series-navigation (width < 25rem) {
    [data-series-heading] { font-size: 1.5rem; }
    [data-series-pagination] {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @container series-track (width < 28rem) {
    [data-series-step] {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.25rem;
    }

    [data-series-step-number] {
      font-size: 1.5rem;
      line-height: 1.875rem;
    }
  }

  @container series-track (width < 20rem) {
    [data-series-step] {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 1rem;
    }

    [data-series-step-title] { font-size: 1rem; }
    [data-series-step-number] { font-size: 1.25rem; }
  }

  @container series-track (width < 16rem) {
    [data-series-step] { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-series-step], [data-series-adjacent-title] { transition: none; }
  }
</style>
