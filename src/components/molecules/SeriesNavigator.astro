---
/* eslint-disable better-tailwindcss/no-unknown-classes -- not-prose is supplied by Tailwind Typography. */

import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPostPath, getSeriesPath } from '@/utils/links'

import { Icon, Progress } from '@santi020k/lumen-astro'

interface Props {
  currentPostId: string
  next?: CollectionEntry<'post'> | undefined
  position: number
  posts: CollectionEntry<'post'>[]
  previous?: CollectionEntry<'post'> | undefined
  series: CollectionEntry<'series'>
  total: number
}

const { currentPostId, next, position, posts, previous, series, total } = Astro.props
const seriesPath = getSeriesPath(series.id)
---

<section class="not-prose mt-16 py-8">
  <div class="
    grid gap-8
    lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)]
  "
  >
    <div class="space-y-5">
      <div class="flex flex-wrap items-center gap-2">
        <Pill label="Series" tone="brand" />
        <Pill label={`Post ${position} of ${total}`} tone="outline" />
      </div>

      <div class="space-y-3.5">
        <h2 class="
          text-2xl/tight font-semibold text-ink
          sm:text-3xl/tight
        "
        >
          <a
            class="
              transition-colors
              hover:text-brand
            "
            href={seriesPath}
          >
            {series.data.title}
          </a>
        </h2>
        <p class="max-w-xl text-sm/7 text-ink-soft">
          {series.data.description}
        </p>
      </div>

      <div class="space-y-3">
        <Progress
          aria-label={`Series progress: post ${position} of ${total}`}
          class="h-1.5 bg-surface-strong/35"
          max={total}
          value={position}
        />
        <ButtonLink href={seriesPath} showArrow variant="secondary">
          View full series
        </ButtonLink>
      </div>
    </div>

    <div class="min-w-0 space-y-5">
      <ol class="
        divide-y divide-line/35 overflow-hidden rounded-2xl border
        border-line/35 bg-surface/24 backdrop-blur-sm
      "
      >
        {posts.map((seriesPost, index) => {
          const isCurrentPost = seriesPost.id === currentPostId

          return (
            <li>
              <a
                aria-current={isCurrentPost ? 'step' : undefined}
                class:list={[
                  `
                    group grid grid-cols-[2.25rem_minmax(0,1fr)_1rem]
                    items-center gap-3 p-3 text-left transition-colors
                    hover:bg-brand-soft/18 hover:text-brand
                    motion-reduce:transition-none
                    sm:px-4
                  `,
                  isCurrentPost && 'bg-brand-soft/24 text-brand'
                ]}
                href={getPostPath(seriesPost.id)}
              >
                <span
                  class:list={[
                    `
                      inline-flex size-8 items-center justify-center
                      rounded-full border text-xs font-semibold
                      transition-colors
                      motion-reduce:transition-none
                    `,
                    isCurrentPost ?
                      'border-brand/45 bg-brand/12 text-brand' :
                      `
                        border-line/45 bg-surface/35 text-ink-muted
                        group-hover:border-brand/40 group-hover:text-brand
                      `
                  ]}
                >
                  {index + 1}
                </span>
                <span class="min-w-0">
                  <span class="block section-label text-[0.64rem]">
                    Part {index + 1}
                  </span>
                  <span
                    class:list={[
                      `
                        mt-0.5 block text-sm/6 font-semibold transition-colors
                        motion-reduce:transition-none
                      `,
                      isCurrentPost ?
                        'text-brand' :
                        `
                          text-ink
                          group-hover:text-brand
                        `
                    ]}
                  >
                    {seriesPost.data.title}
                  </span>
                </span>
                <Icon
                  class:list={[
                    `
                      size-4 text-ink-muted opacity-0 transition-all
                      group-hover:translate-x-0.5 group-hover:text-brand
                      group-hover:opacity-100
                      motion-reduce:transition-none
                      motion-reduce:group-hover:translate-x-0
                    `,
                    isCurrentPost && 'text-brand opacity-100'
                  ]}
                  name={isCurrentPost ? 'circle-dot' : 'arrow-right'}
                />
              </a>
            </li>
          )
        })}
      </ol>

      {(previous ?? next) && (
        <div
          class:list={[
            `
              grid gap-px overflow-hidden rounded-2xl border border-line/30
              bg-line/30
            `,
            previous && next && 'sm:grid-cols-2'
          ]}
        >
          {previous && (
            <a
              class="
                group block bg-surface/32 p-4 transition-colors
                hover:bg-brand-soft/18
                motion-reduce:transition-none
              "
              href={getPostPath(previous.id)}
            >
              <p class="section-label">Previous in series</p>
              <p class="
                mt-2 text-sm/6 font-semibold text-ink transition-colors
                group-hover:text-brand
                motion-reduce:transition-none
              "
              >
                {previous.data.title}
              </p>
            </a>
          )}

          {next && (
            <a
              class="
                group block bg-surface/32 p-4 transition-colors
                hover:bg-brand-soft/18
                motion-reduce:transition-none
              "
              href={getPostPath(next.id)}
            >
              <p class="section-label">Next in series</p>
              <p class="
                mt-2 text-sm/6 font-semibold text-ink transition-colors
                group-hover:text-brand
                motion-reduce:transition-none
              "
              >
                {next.data.title}
              </p>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
