---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPostPath, getSeriesPath } from '@/utils/links'

interface Props {
  currentPostId: string
  next?: CollectionEntry<'post'> | undefined
  position: number
  posts: CollectionEntry<'post'>[]
  previous?: CollectionEntry<'post'> | undefined
  series: CollectionEntry<'series'>
  total: number
}

const { currentPostId, next, position, posts, previous, series, total } = Astro.props
const seriesPath = getSeriesPath(series.id)
---

<section class="not-prose mt-16 space-y-6 border-y border-line/45 py-8">
  <div class="
    grid gap-8
    lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]
  "
  >
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <Pill label="Series" tone="brand" />
        <Pill label={`Post ${position} of ${total}`} tone="outline" />
      </div>

      <div class="space-y-3">
        <h2 class="
          text-3xl/tight
          sm:text-[2.35rem]
        "
        >
          <a
            class="
              transition-colors
              hover:text-brand
            "
            href={seriesPath}
          >
            {series.data.title}
          </a>
        </h2>
        <p class="max-w-2xl text-sm/7 text-ink-soft">
          {series.data.description}
        </p>
      </div>

      <ButtonLink href={seriesPath} showArrow variant="secondary">
        View full series
      </ButtonLink>
    </div>

    <ol class="grid gap-3">
      {posts.map((seriesPost, index) => {
        const isCurrentPost = seriesPost.id === currentPostId

        return (
          <li>
            <a
              aria-current={isCurrentPost ? 'step' : undefined}
              class:list={[
                `
                  panel-card flex p-4 transition-colors
                  motion-reduce:transition-none
                `,
                isCurrentPost ?
                  'border-brand/40 text-brand' :
                  `
                    hover:border-brand/30 hover:text-brand
                  `
              ]}
              href={getPostPath(seriesPost.id)}
            >
              <div class="space-y-1">
                <p class="section-label">Part {index + 1}</p>
                <p class="text-sm/6 font-semibold text-ink">
                  {seriesPost.data.title}
                </p>
              </div>
            </a>
          </li>
        )
      })}
    </ol>
  </div>

  {(previous ?? next) && (
    <div class="
      grid gap-4
      sm:grid-cols-2
    "
    >
      {previous && (
        <a
          class="
            panel-card block p-5 transition-colors
            hover:border-brand/30 hover:text-brand
          "
          href={getPostPath(previous.id)}
        >
          <p class="section-label">Previous in series</p>
          <p class="mt-3 text-base/7 font-semibold text-ink">
            {previous.data.title}
          </p>
        </a>
      )}

      {next && (
        <a
          class="
            panel-card block p-5 transition-colors
            hover:border-brand/30 hover:text-brand
          "
          href={getPostPath(next.id)}
        >
          <p class="section-label">Next in series</p>
          <p class="mt-3 text-base/7 font-semibold text-ink">
            {next.data.title}
          </p>
        </a>
      )}
    </div>
  )}
</section>
