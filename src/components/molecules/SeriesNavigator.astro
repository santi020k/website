---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getPostPath, getSeriesPath } from '@/utils/links'

import { Card, Icon, Progress } from '@santi020k/lumen-astro'

interface Props {
  currentPostId: string
  next?: CollectionEntry<'post'> | undefined
  position: number
  posts: CollectionEntry<'post'>[]
  previous?: CollectionEntry<'post'> | undefined
  series: CollectionEntry<'series'>
  total: number
}

const { currentPostId, next, position, posts, previous, series, total } = Astro.props
const seriesPath = getSeriesPath(series.id)
---

<section class="not-prose mt-16 py-8" id="series-navigation">
  <div class="
    grid gap-8
    lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)]
  "
  >
    <div class="space-y-5">
      <div class="flex flex-wrap items-center gap-2">
        <Pill label="Series" tone="brand" />
        <Pill label={`Post ${position} of ${total}`} tone="outline" />
      </div>

      <div class="space-y-3.5">
        <h2 class="
          text-2xl/tight font-medium text-ink
          sm:text-3xl/tight
        "
        >
          <a
            data-series-navigator-title
            class="
              block rounded-sm transition-colors
              hover:text-brand
              motion-reduce:transition-none
            "
            href={seriesPath}
          >
            {series.data.title}
          </a>
        </h2>
        <p class="max-w-xl text-sm/7 text-ink-soft">
          {series.data.description}
        </p>
      </div>

      <div class="space-y-3">
        <Progress
          aria-label={`Series progress: post ${position} of ${total}`}
          class="h-1.5 bg-surface-strong/35"
          max={total}
          value={position}
        />
        <ButtonLink href={seriesPath} showArrow variant="secondary">
          View full series
        </ButtonLink>
      </div>
    </div>

    <div class="min-w-0 space-y-5" data-series-content>
      <Card data-series-index variant="unstyled">
        <nav aria-label={`Chapters in ${series.data.title}`}>
          <ol data-series-track>
            {posts.map((seriesPost, index) => {
              const isCurrentPost = seriesPost.id === currentPostId

              return (
                <li>
                  <a
                    data-series-step
                    aria-current={isCurrentPost ? 'step' : undefined}
                    href={getPostPath(seriesPost.id)}
                  >
                    <span data-series-step-number>
                      <span class="sr-only">Part {index + 1}</span>
                      <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <span data-series-step-copy>
                      <span data-series-step-label>{isCurrentPost ? 'Reading now' : 'In this series'}</span>
                      <span data-series-step-title>{seriesPost.data.title}</span>
                    </span>
                  </a>
                </li>
              )
            })}
          </ol>
        </nav>
      </Card>

      {(previous ?? next) && (
        <nav
          aria-label={`Continue reading ${series.data.title}`}
          data-series-pagination
          data-single={!(previous && next) || undefined}
        >
          {previous && (
            <a
              data-series-adjacent="previous"
              href={getPostPath(previous.id)}
              rel="prev"
            >
              <span data-series-adjacent-direction>
                <Icon
class="
  size-4.5 shrink-0 text-brand
  dark:text-accent
"
name="arrow-left"
                />
                <span>Previous in series</span>
              </span>
              <h3 data-series-adjacent-title>{previous.data.title}</h3>
              <span data-series-adjacent-part>Part {String(position - 1).padStart(2, '0')}</span>
            </a>
          )}

          {next && (
            <a
              data-series-adjacent="next"
              href={getPostPath(next.id)}
              rel="next"
            >
              <span data-series-adjacent-direction>
                <span>Next in series</span>
                <Icon
class="
  size-4.5 shrink-0 text-brand
  dark:text-accent
"
name="arrow-right"
                />
              </span>
              <h3 data-series-adjacent-title>{next.data.title}</h3>
              <span data-series-adjacent-part>Part {String(position + 1).padStart(2, '0')}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</section>

<style>
  [data-series-content] {
    --series-emphasis: hsl(var(--brand));
    container: series-navigation / inline-size;
  }

  [data-series-index][data-slot='card'] {
    container: series-track / inline-size;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
  }

  :global([data-theme='dark']) [data-series-content] {
    --series-emphasis: color-mix(in srgb, hsl(var(--accent)) 85%, hsl(var(--ink)));
  }

  [data-series-track] > li + li { border-top: 1px solid hsl(var(--line)); }

  [data-series-step] {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.625rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: break-word;
    transition: background-color 180ms ease, color 180ms ease;
  }

  [data-series-step-number] {
    color: hsl(var(--ink-soft));
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  [data-series-step-copy] { min-width: 0; }

  [data-series-step-label] {
    display: block;
    margin-bottom: 0.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }

  [data-series-step-title] {
    display: block;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.018em;
  }

  [data-series-step]:is([aria-current='step'], :hover, :focus-visible) {
    background: hsl(var(--brand-soft));
    color: var(--series-emphasis);
  }

  [data-series-step]:is([aria-current='step'], :hover, :focus-visible) :is([data-series-step-number], [data-series-step-label]) {
    color: inherit;
  }

  /* Keep focus inside the rounded, clipped rows, including the first and last. */
  [data-series-track] a:focus-visible {
    outline-offset: -4px;
  }

  [data-series-pagination] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }

  [data-series-pagination][data-single] { grid-template-columns: minmax(0, 1fr); }

  [data-series-adjacent] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-top: 1px solid hsl(var(--line));
    padding-block: 1.5rem 0.25rem;
    color: hsl(var(--ink));
    text-decoration: none;
    overflow-wrap: break-word;
  }

  [data-series-adjacent-direction] {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }

  [data-series-adjacent-title] {
    margin-block: 1.25rem 0;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.8125rem;
    font-weight: 500;
    letter-spacing: -0.025rem;
    transition: color 180ms ease;
  }

  [data-series-adjacent]:is(:hover, :focus-visible) [data-series-adjacent-title] {
    color: var(--series-emphasis);
  }

  [data-series-adjacent-part] {
    margin-top: auto;
    padding-top: 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  @container series-navigation (width < 25rem) {
    [data-series-pagination] {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @container series-track (width < 28rem) {
    [data-series-step] {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.25rem;
    }

    [data-series-step-number] {
      font-size: 1.5rem;
      line-height: 1.875rem;
    }
  }

  @container series-track (width < 20rem) {
    [data-series-step] {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 1rem;
    }

    [data-series-step-title] { font-size: 1rem; }
    [data-series-step-number] { font-size: 1.25rem; }
  }

  @container series-track (width < 16rem) {
    [data-series-step] { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-series-step], [data-series-adjacent-title] { transition: none; }
  }
</style>
