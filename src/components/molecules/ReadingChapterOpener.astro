---
import type { MarkdownHeading } from 'astro'

import ReadingContents from '@/components/molecules/ReadingContents.astro'

import { Collapsible, Icon } from '@santi020k/lumen-astro'

import { getLocale } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  headings: MarkdownHeading[]
  companion?: boolean
}

const { headings, companion = false } = Astro.props
const tocHeadings = headings.filter(heading => heading.depth <= 3)
const sectionCount = tocHeadings.filter(heading => heading.depth <= 2).length || tocHeadings.length
---

{tocHeadings.length > 0 && (
  <reading-chapter-opener
    data-chapter-opener
    data-companion={companion || undefined}
    data-position-template={companion ? t('reading.chapterPosition', { current: '{current}', total: sectionCount }) : undefined}
  >
    <Collapsible data-toc-opener>
      <summary data-toc-summary>
        <span>{t('collection.onThisPage')}</span>{' '}
        <span data-toc-count>{t(sectionCount === 1 ? 'reading.sectionCountOne' : 'reading.sectionCount', { count: sectionCount })}</span>
        <Icon class="size-4 shrink-0" data-toc-toggle-icon name="chevron-down" />
        {companion && <span data-toc-current lang={locale} hidden />}
      </summary>
      <ReadingContents embedded headings={tocHeadings} />
    </Collapsible>
  </reading-chapter-opener>
)}

<script>
  import './reading-chapter-opener'
</script>

<style>
  [data-chapter-opener] { display: block; container: chapter-opener / inline-size; }
  [data-toc-opener] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    box-shadow: none;
    overflow-wrap: break-word;
  }
  [data-toc-summary] {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    min-height: 4.25rem;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border-radius: inherit;
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    background: transparent;
  }
  [data-toc-summary]::-webkit-details-marker { display: none; }
  [data-toc-summary]::before, [data-toc-summary]::after { display: none; }
  [data-toc-opener][open] > [data-toc-summary] { margin-bottom: 0; }
  [data-toc-count] { margin-inline-start: auto; color: hsl(var(--ink-soft)); }
  [data-toc-opener][open] [data-toc-summary] :global([data-toc-toggle-icon]) { transform: rotate(180deg); }
  :global(:root[data-theme='santi020k-dark']) [data-toc-summary] { color: hsl(var(--accent)); }

  [data-companion-ready] [data-toc-opener] { position: relative; overflow: visible; }
  /* The overlay supplies the bottom corners while the companion is open. */
  [data-companion-ready] [data-toc-opener][open] {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }
  [data-companion-ready] [data-toc-opener]::details-content { transition: none; }
  [data-companion-ready] [data-toc-opener][open]::details-content { overflow: visible; }
  [data-companion-ready] [data-toc-summary] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 0.625rem;
    padding: 0.875rem 1.125rem;
  }
  [data-companion-ready] [data-toc-summary] :global([data-toc-toggle-icon]) { grid-column: 2; grid-row: 2; justify-self: end; }
  [data-companion-ready] [data-toc-current] {
    display: -webkit-box;
    grid-column: 1 / span 2;
    grid-row: 2;
    min-height: 3.1em;
    padding-inline-end: 1.625rem;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    color: hsl(var(--ink));
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  [data-companion-ready] :global(reading-contents) {
    position: absolute;
    inset-inline: -1px;
    inset-block-start: calc(100% - 0.375rem);
    z-index: 1;
    max-height: var(--chapter-menu-height);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    border: 1px solid hsl(var(--line));
    border-top: 0;
    border-radius: 0 0 0.5rem 1.5rem;
    background: hsl(var(--surface));
  }

  @container chapter-opener (width < 16rem) {
    [data-toc-summary] { padding-inline: 0.75rem; }
  }

  @container chapter-opener (width < 9rem) {
    [data-toc-summary] { padding-inline: 0.5rem; }
  }
</style>
