---
import { Callout, Icon } from '@santi020k/lumen-astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<Callout aria-label={title} class="not-prose" data-article-update-note>
  <header data-update-note-header>
    <p>{title}</p>
    <Icon name="notebook-pen" />
  </header>
  <div data-update-note-body>
    <slot />
  </div>
</Callout>

<style>
  :global([data-article-update-note]) {
    --update-note-accent: hsl(var(--brand));
    container: update-note / inline-size;
    display: block;
    margin-block: 2.5rem;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1.75rem 1.75rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    box-shadow: none;
  }

  :global(:root[data-theme="santi020k-dark"] [data-article-update-note]) {
    --update-note-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-update-note-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.1875rem 1.625rem;
    border-radius: 0.3125rem 1.6875rem 0 0;
    background: hsl(var(--brand-soft));
    color: var(--update-note-accent);
  }

  [data-update-note-header] p {
    min-width: 0;
    margin: 0;
    color: inherit;
    font: 500 0.875rem/1.6 var(--font-sans);
    overflow-wrap: anywhere;
  }

  [data-update-note-header] :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  [data-update-note-body] {
    padding: 1.5625rem 1.75rem 1.75rem;
    font: 400 1.125rem/1.8 var(--font-sans);
    overflow-wrap: anywhere;
  }

  [data-update-note-body] :global(p) {
    margin: 0;
    color: inherit;
  }

  [data-update-note-body] :global(p + p) {
    margin-top: 1em;
  }

  [data-update-note-body] :global(a) {
    color: var(--update-note-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25rem;
  }

  [data-update-note-body] :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  @container update-note (width < 30rem) {
    [data-update-note-header] { padding: 1.125rem 1.25rem; }
    [data-update-note-body] { padding: 1.375rem; }
  }

  @container update-note (width < 18rem) {
    [data-update-note-header] { gap: 0.75rem; padding: 1rem; }
    [data-update-note-body] { padding: 1.125rem; }
  }
</style>
