---
interface Props {
  title: string
  subtitle: string
  description: string
  icon: string
  tone?: 'brand' | 'accent'
}

const { title, subtitle, description, icon, tone = 'brand' } = Astro.props

const toneClasses = tone === 'brand' ?
  'bg-brand/12 text-brand backdrop-blur-sm border border-brand/15 shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)]' :
  'bg-accent/12 text-accent backdrop-blur-sm border border-accent/15 shadow-[inset_0_1px_0_hsl(0_0%_100%/0.1)]'
---

<div class="mini-note space-y-4 p-6">
  <div class="flex items-center gap-3">
    <div class:list={['flex size-10 items-center justify-center rounded-xl', toneClasses]}>
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <Fragment set:html={icon} />
      </svg>
    </div>
    <div>
      <p class="font-medium text-ink">{title}</p>
      <p class="text-xs text-ink-muted">{subtitle}</p>
    </div>
  </div>
  <p class="text-sm text-ink-soft">
    {description}
  </p>
</div>
