---
import GradientDivider from '@/components/atoms/GradientDivider.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getTechnologyPath } from '@/utils/links'
import { sortTechnologiesByInterest } from '@/utils/technologies'

interface Props {
  technologies: string[]
}

const { technologies: raw } = Astro.props
const technologies = sortTechnologiesByInterest(raw)
---

<div
  class="
    animate-slide-up [animation-delay:360ms]
    motion-reduce:animate-none
  "
>
  <GradientDivider class="mb-8" />
  <div class="
    relative rounded-2xl border border-line/30 bg-surface/30 p-6
    backdrop-blur-sm
  "
  >
    <div class="
      absolute inset-0 bg-linear-to-br from-brand/3 via-transparent to-accent/3
    "
    >
    </div>
    <div class="relative flex flex-wrap items-center gap-x-6 gap-y-4">
      <div class="flex items-center gap-3">
        <span class="
          section-label text-sm font-bold tracking-wider text-ink-muted/90
          uppercase
        "
        >Stack
        </span>
        <span class="
          inline-flex items-center justify-center rounded-full border
          border-brand/20 bg-brand/10 px-3 py-1 text-sm font-bold text-brand
          tabular-nums
        "
        >
          {technologies.length}
        </span>
      </div>
      <span
        aria-hidden="true"
        class="
          hidden h-6 w-px shrink-0 bg-line/40
          sm:block
        "
      >
      </span>
      <div class="flex flex-wrap gap-2" id="technologies">
        {technologies.map(technology => (
          <Pill
            href={getTechnologyPath(technology)}
            label={technology}
            tone="outline"
            className="
              animate-slide-up transition-all duration-300
              hover:scale-105 hover:border-brand/40 hover:bg-brand-soft/20
              motion-reduce:animate-none
            "
          />
        ))}
      </div>
    </div>
  </div>
</div>
