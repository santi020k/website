---
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologiesByInterest } from '@/utils/technologies'

import Card from '@santi020k/lumen-astro/components/Card'
import Collapsible from '@santi020k/lumen-astro/components/Collapsible'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Link from '@santi020k/lumen-astro/components/Link'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  technologies: string[]
}

const { technologies } = Astro.props
const coreTechnologies = technologies.slice(0, 6)
const extraTechnologies = sortTechnologiesByInterest(technologies.slice(6))
---

<div
  class="
    animate-slide-up [animation-delay:360ms]
    motion-reduce:animate-none
  "
  data-project-stack-container
>
  <Card as="section" variant="unstyled" aria-labelledby="project-stack-heading" data-project-stack id="sidebar-stack">
    <header data-project-stack-margin>
      <span data-project-stack-symbol><Icon name="layers" class="size-5" /></span>
      <h2 id="project-stack-heading">{t('collection.stack')}</h2>
      <span data-project-stack-count>{technologies.length}</span>
      <p>{t('collection.technologies')}</p>
    </header>
    <div data-project-stack-content id="technologies">
      <ul data-project-stack-pills data-project-stack-preview aria-label={t('collection.coreTechnologies')}>
        {coreTechnologies.map(technology => (
          <li>
            <Link href={localizePath(getTechnologyPath(technology), locale)} variant="inherit" data-project-stack-link>
              <span>{technology}</span>
            </Link>
          </li>
        ))}
      </ul>
      {extraTechnologies.length > 0 && (
        <Collapsible data-project-stack-more>
          <summary>{t('collection.moreTechnologies')} ({extraTechnologies.length})</summary>
          <ul data-project-stack-pills aria-label={t('collection.moreTechnologies')}>
            {extraTechnologies.map(technology => (
              <li>
                <Link href={localizePath(getTechnologyPath(technology), locale)} variant="inherit" data-project-stack-link>
                  <span>{technology}</span>
                </Link>
              </li>
            ))}
          </ul>
        </Collapsible>
      )}
    </div>
  </Card>
</div>

<style>
  [data-project-stack-container] { container: project-stack / inline-size; }

  :global([data-project-stack]) {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 2rem 0.375rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
  }

  [data-project-stack-margin] {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
    padding: 1.625rem 1.5rem;
    background: hsl(var(--ink));
    color: hsl(var(--surface));
  }

  [data-project-stack-margin]::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-top-left-radius: 1.5rem;
    background: hsl(var(--brand-soft));
    content: '';
  }

  [data-project-stack-margin] h2 {
    overflow-wrap: anywhere;
    color: inherit;
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.045em;
  }

  [data-project-stack-count] {
    margin-top: 0.5rem;
    font-size: 3rem;
    line-height: 1.3;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }

  [data-project-stack-margin] p { color: inherit; margin-top: -0.75rem; font-size: 0.75rem; line-height: 1.6; }

  [data-project-stack-content] { min-width: 0; padding: 1.75rem; align-self: center; }

  [data-project-stack-pills] {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 0.625rem;
    min-width: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  [data-project-stack-pills] li { max-width: 100%; }

  /* Keep WebKit from clipping the summary to rounded disclosure bounds. */
  :global([data-project-stack-more]) { overflow: visible; margin-top: 1.25rem; padding: 0; border: 0; border-top: 1px solid hsl(var(--line)); border-radius: 0; background: transparent; box-shadow: none; }
  [data-project-stack-content] summary { min-height: 2.75rem; margin: 0; padding: 0.875rem 1.5rem 0.875rem 0; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.7; font-weight: 500; overflow-wrap: anywhere; }
  [data-project-stack-content] summary::before { display: none; }
  [data-project-stack-content] summary::after { inset-inline-end: 0.125rem; top: 1.125rem; border-color: currentColor; }
  [data-project-stack-content] summary:hover { background: transparent; color: hsl(var(--brand)); }
  [data-project-stack-content] :global(details[open]) > summary { margin-bottom: 0.5rem; }
  :global(:root[data-theme='santi020k-dark']) [data-project-stack-content] summary:hover { color: hsl(var(--accent)); }

  :global([data-project-stack-link]) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5625rem 0.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.625rem 0.1875rem;
    background: hsl(var(--canvas));
    color: hsl(var(--ink));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  :global([data-project-stack-link])::before {
    align-self: stretch;
    flex-shrink: 0;
    width: 0.1875rem;
    min-height: 1.25rem;
    border-radius: 0.125rem;
    background: hsl(var(--brand));
    content: '';
  }

  :global([data-project-stack-link]:is(:hover, :focus-visible)) {
    border-color: hsl(var(--project-primary-readable));
    background: color-mix(in srgb, hsl(var(--project-primary)) 8%, hsl(var(--surface)));
    color: hsl(var(--project-primary-readable));
  }

  :global([data-project-stack-link]:focus-visible) {
    outline: 2px solid hsl(var(--brand));
    outline-offset: 3px;
  }

  :global(:root[data-theme='santi020k-dark'] [data-project-stack-link])::before { background: hsl(var(--accent)); }
  :global(:root[data-theme='santi020k-dark'] [data-project-stack-link]:focus-visible) { outline-color: hsl(var(--accent)); }
  :global(:root[data-theme='santi020k-dark'] [data-project-stack-link]:is(:hover, :focus-visible)) {
    border-color: hsl(var(--project-primary-readable-dark));
    color: hsl(var(--project-primary-readable-dark));
  }

  @container project-stack (width < 35rem) {
    :global([data-project-stack]) { grid-template-columns: minmax(0, 1fr); }
    [data-project-stack-margin] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1.25rem;
      padding: 1.375rem 1.5rem;
    }
    [data-project-stack-symbol] { display: none; }
    [data-project-stack-count] { grid-column: 2; grid-row: 1 / 3; margin: 0; font-size: 2.5rem; }
    [data-project-stack-margin] p { margin: 0; }
    [data-project-stack-content] { padding: 1.375rem; }
  }

  @container project-stack (width < 18rem) {
    [data-project-stack-margin] { padding: 1rem; }
    [data-project-stack-content] { padding: 0.75rem; }
  }

  @container project-stack (width < 14rem) {
    [data-project-stack-margin] { gap: 0.25rem 0.5rem; padding: 0.75rem; }
    [data-project-stack-margin] h2 { font-size: 1.125rem; }
    [data-project-stack-count] { grid-row: 1; font-size: 1.75rem; }
    [data-project-stack-margin] p { grid-column: 1 / -1; }
    [data-project-stack-content] { padding: 0.375rem; }
    [data-project-stack-content] summary { padding-inline-end: 0; }
    [data-project-stack-content] summary::after { position: static; margin-inline-start: 0.5rem; }
    :global([data-project-stack-link]) { gap: 0; padding: 0.375rem 0.125rem; font-size: 0.75rem; }
    :global([data-project-stack-link])::before { display: none; }
  }
</style>
