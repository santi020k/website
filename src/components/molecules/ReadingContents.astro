---
import type { MarkdownHeading } from 'astro'

import { getReadingChapters } from '@/utils/reading-chapters'

import { Anchor, Collapsible, Icon } from '@santi020k/lumen-astro'

import { getLocale } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text

interface Props {
  headings: MarkdownHeading[]
  embedded?: boolean
}

const { headings, embedded = false } = Astro.props
const chapterOverview = (text: string) => locale === 'es' ? `Resumen del capítulo: ${text}` : `Chapter overview: ${text}`
const namedOverview = (name: string) => locale === 'es' ? `Resumen de ${name}` : `${name} overview`

const chapters = getReadingChapters(headings).map(chapter => {
  const separator = chapter.heading.text.indexOf(': ')
  const name = chapter.heading.text.slice(0, separator).trim()
  const caption = separator > 0 ? chapter.heading.text.slice(separator + 2).trim() : ''

  return { ...chapter, label: name && caption ? { name, caption } : undefined }
})
---

{chapters.length > 0 && (
  <reading-contents>
    <Anchor activationOffset={120} aria-label={t('Table of contents')} data-reading-contents data-contents-embedded={embedded || undefined}>
      {!embedded && (
        <p data-chapters-title>{t('On this page')}<Icon class="size-4 shrink-0" name="list" />
        </p>
      )}
      <ol data-chapter-list role="list">
        {chapters.map(({ heading, sections, label }) => (
          <li>
            {sections.length > 0 ?
(
              <Collapsible data-chapter-group open={chapters.length === 1}>
                <summary data-chapter-summary>
                  {label ?
(
                    <span data-chapter-captioned>
                      <span data-chapter-name>{label.name}<span class="sr-only">:</span></span>{' '}
                      <span data-chapter-caption>{label.caption}</span>
                    </span>
                  ) :
<span>{heading.text}</span>}
                  <Icon class="size-4 shrink-0" data-chapter-toggle-icon name="chevron-down" />
                </summary>
                <ol data-chapter-sections role="list">
                  <li><a href={`#${heading.slug}`} aria-label={label ? undefined : chapterOverview(heading.text)}>{label ? namedOverview(label.name) : t('Chapter overview')}</a></li>
                  {sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
                </ol>
              </Collapsible>
            ) :
<a data-chapter-standalone href={`#${heading.slug}`}>{heading.text}</a>}
          </li>
        ))}
      </ol>
    </Anchor>
  </reading-contents>
)}

<script>
  import './reading-contents'
</script>

<style>
  reading-contents { display: block; container: chapter-groups / inline-size; }
  [data-reading-contents] { padding: 1.5rem; border: 1px solid hsl(var(--line)); border-radius: 1.5rem 1.5rem 0.5rem 1.5rem; background: hsl(var(--surface)); overflow-wrap: break-word; }
  [data-chapters-title] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin: 0; color: hsl(var(--brand)); font-size: 0.75rem; line-height: 1.667; font-weight: 500; letter-spacing: normal; }
  [data-chapter-list], [data-chapter-sections] { padding: 0; list-style: none; }
  [data-chapter-list] { margin: 1.5rem 0 0; }
  [data-reading-contents][data-contents-embedded] { border: 0; border-radius: 0; padding-top: 0; background: transparent; }
  [data-contents-embedded] [data-chapter-list] { margin-top: 0; }
  [data-chapter-list] > li + li { border-top: 1px solid hsl(var(--line)); }
  [data-reading-contents] a { margin: 0; border: 0; background: transparent; font-weight: 400; }
  [data-chapter-group] { padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
  [data-chapter-summary], [data-chapter-standalone] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 2.75rem; margin: 0; padding: 0.875rem 0; color: hsl(var(--ink)); font-size: 0.875rem; line-height: 1.65; font-weight: 500; letter-spacing: normal; text-decoration: none; background: transparent; }
  [data-chapter-summary] { cursor: pointer; list-style: none; border-radius: 0.25rem; }
  [data-chapter-captioned] { flex: 1; min-width: 0; }
  [data-chapter-name] { display: block; font-size: 1rem; line-height: 1.5; }
  [data-chapter-caption] { display: block; padding-top: 0.1875rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; font-weight: 400; line-height: 1.65; }
  [data-chapter-caption]::first-letter { text-transform: uppercase; }
  [data-chapter-standalone] { position: relative; }
  [data-reading-contents] [data-chapter-standalone] { font-weight: 500; }
  [data-chapter-summary]::-webkit-details-marker { display: none; }
  [data-chapter-summary]::before, [data-chapter-summary]::after { display: none; }
  [data-chapter-group][open] > [data-chapter-summary] { margin-bottom: 0; }
  [data-chapter-group][open] > [data-chapter-summary] :global([data-chapter-toggle-icon]) { transform: rotate(180deg); }
  [data-chapter-sections] { margin: 0 0 0.875rem; border-inline-start: 1px solid hsl(var(--line)); }
  [data-chapter-sections] a { position: relative; display: block; min-height: 2.75rem; padding: 0.6875rem 0 0.6875rem 0.875rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.7; font-weight: 400; letter-spacing: normal; text-decoration: none; }
  [data-chapter-sections] a[aria-current='location']::before { content: ''; position: absolute; inset-inline-start: -1px; inset-block: 0.625rem; width: 3px; border-inline-start: 3px solid currentColor; border-radius: 2px; }
  [data-chapter-standalone][aria-current='location']::before { content: ''; position: absolute; inset-inline-start: -0.75rem; inset-block: 0.625rem; width: 3px; border-inline-start: 3px solid currentColor; border-radius: 2px; }
  [data-reading-contents] a:is(:hover, [aria-current='location']), [data-chapter-group][open] > summary { color: hsl(var(--brand)); }
  :global(:root[data-theme='dark']) [data-chapters-title],
  :global(:root[data-theme='dark']) [data-reading-contents] a:is(:hover, [aria-current='location']),
  :global(:root[data-theme='dark']) [data-chapter-group][open] > summary { color: hsl(var(--accent)); }
  @container chapter-groups (width < 16rem) {
    [data-reading-contents] { padding-inline: 0.75rem; }
    [data-chapter-summary], [data-chapter-standalone] { font-size: 0.8125rem; }
    [data-chapter-sections] a { padding-inline-start: 0.5rem; }
  }
  @container chapter-groups (width < 9rem) {
    [data-reading-contents] { padding-inline: 0.5rem; }
    [data-chapter-sections] a { padding-inline-start: 0.375rem; }
    [data-chapter-name] { font-size: 0.875rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-reading-contents] a, [data-chapter-summary] { transition: color 160ms ease; }
  }
</style>
