---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getPostPath } from '@/utils/links'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  stories: { label: string, post: CollectionEntry<'post'> }[]
}

const { stories } = Astro.props
---

{stories.length > 0 && (
  <section aria-labelledby="project-writing-heading" data-project-story-pair>
    <header>
      <p data-writing-eyebrow>{t('collection.fromThisProject')}</p>
      <h2 id="project-writing-heading">{t('collection.insideTheWork')}</h2>
    </header>
    <div data-writing-grid data-single-story={stories.length === 1}>
      {stories.map(({ label, post }, index) => (
        <article data-writing-story data-featured={index === 0}>
          <p lang="en" data-writing-label>{label}</p>
          <h3 lang="en">{post.data.title}</h3>
          <p lang="en" data-writing-description>{post.data.cardDescription ?? post.data.description}</p>
          <Link href={localizePath(getPostPath(post.id), locale)} variant="inherit" aria-label={locale === 'es' ? `${t('collection.readArticle')}: ${post.data.title}` : `Read ${label.toLowerCase()}: ${post.data.title}`}  data-writing-link>
            <span>{locale === 'es' ? t('collection.readArticle') : `Read ${label.toLowerCase()}`}</span>
            <ArrowExchange direction="right" size="sm" />
          </Link>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  [data-project-story-pair] { --writing-accent: hsl(var(--brand)); container: story-pair / inline-size; margin-bottom: 1rem; color: hsl(var(--ink)); }
  :global([data-theme='dark']) [data-project-story-pair] { --writing-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-writing-eyebrow], [data-writing-label] { margin: 0; color: var(--writing-accent); font-size: 0.75rem; font-weight: 500; line-height: 1.7; }
  h2 { margin: 0.75rem 0 1.5rem; font-size: 1.75rem; line-height: 1.3; font-weight: 500; letter-spacing: -0.035em; }
  [data-writing-grid] { display: grid; grid-template-columns: 1.25fr 1fr; gap: 1.125rem 1.5rem; }
  [data-writing-story] { position: relative; display: grid; grid-template-rows: subgrid; grid-row: span 4; min-width: 0; padding: 1.625rem; }
  [data-writing-story][data-featured='true'] { border-radius: 0.25rem 1.875rem 1.875rem 1.875rem; background: hsl(var(--brand-soft)); }
  [data-writing-story][data-featured='false']::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: hsl(var(--line)); }
  h3 { margin: 0; font-size: 1.3125rem; line-height: 1.45; font-weight: 500; letter-spacing: -0.025em; overflow-wrap: anywhere; }
  [data-writing-description] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; overflow-wrap: anywhere; }
  [data-writing-link][data-slot='link'] { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.75rem; border-top: 1px solid hsl(var(--line)); padding-top: 1rem; color: var(--writing-accent); font-size: 0.8125rem; font-weight: 500; line-height: 1.7; text-decoration: none; }
  [data-writing-link] span { min-width: 0; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.3rem; }
  [data-writing-link] :global(svg) { flex-shrink: 0; }
  [data-writing-link]:is(:hover, :focus-visible) span { text-decoration-color: currentColor; }
  [data-writing-link]:focus-visible { outline: 2px solid var(--writing-accent); outline-offset: 4px; }
  [data-single-story='true'] { grid-template-columns: minmax(0, 1fr); }

  @container story-pair (width < 40rem) {
    [data-writing-grid] { grid-template-columns: minmax(0, 1fr); row-gap: 1.125rem; }
    [data-writing-story] { padding: 1.5rem; }
    [data-writing-story] + [data-writing-story] { margin-top: 0.5rem; }
  }
</style>
