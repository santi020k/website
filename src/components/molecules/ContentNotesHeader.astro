---
import { getLocale } from '@/i18n'
import { translateCollection } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = (text: string) => locale === 'es' ? translateCollection(text) : text

interface Props {
  description: string
  label: string
  pill: string
}

const { description, label, pill } = Astro.props
---

<div data-content-notes>
  <div data-notes-spread>
    <div data-notes-margin>
      <p data-notes-label>{t(label)}</p>
      <p data-notes-type>{t(pill)}</p>
    </div>
    <p data-notes-description>{t(description)}</p>
  </div>
</div>

<style>
  [data-content-notes] {
    --notes-accent: hsl(var(--brand));
    container: content-notes / inline-size;
    border-block: 1px solid hsl(var(--line));
    padding-block: 1.625rem;
    color: hsl(var(--ink));
  }

  :global([data-theme="dark"]) [data-content-notes] {
    --notes-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-notes-spread] {
    display: grid;
    grid-template-columns: 9.375rem minmax(0, 1fr);
    gap: 1.625rem;
  }

  [data-notes-margin] {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
  }

  p {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  [data-notes-label] {
    color: var(--notes-accent);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
  }

  [data-notes-type] {
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  [data-notes-description] {
    border-inline-start: 2px solid var(--notes-accent);
    padding-inline-start: 1.625rem;
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  @container content-notes (width < 28.75rem) {
    [data-notes-spread] {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.3125rem;
    }

    [data-notes-margin] {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.625rem 1.25rem;
    }

    [data-notes-description] {
      padding-inline-start: 1.25rem;
    }
  }
</style>
