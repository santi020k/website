---
interface Props {
  countLabel: string
  description: string
  headingId: string
  technology: string
  title: string
}

const { countLabel, description, headingId, technology, title } = Astro.props
---

<header data-technology-chapter>
  <div data-technology-chapter-meta>
    <p data-technology-chapter-label>{technology}</p>
    <p data-technology-chapter-count>{countLabel}</p>
  </div>
  <div data-technology-chapter-columns>
    <h2 id={headingId}>{title}</h2>
    <p>{description}</p>
  </div>
</header>

<style>
  [data-technology-chapter] {
    container: technology-chapter / inline-size;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid hsl(var(--line));
  }
  [data-technology-chapter-meta] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  [data-technology-chapter-label] { color: hsl(var(--accent)); overflow-wrap: anywhere; }
  [data-technology-chapter-columns] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
  }
  h2 {
    max-width: 18ch;
    scroll-margin-top: 7rem;
    color: hsl(var(--ink));
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.055em;
    overflow-wrap: break-word;
  }
  [data-technology-chapter-columns] p {
    max-width: 42rem;
    color: hsl(var(--ink-soft));
    font-size: 0.9375rem;
    line-height: 1.85;
  }
  @container technology-chapter (width < 40rem) {
    [data-technology-chapter-columns] { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  }
</style>
