---
import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  label: string
  title: string
}

const { label, title } = Astro.props
---

<div class="section-container-wide" data-policy-contact-container>
  <Card as="section" id="policy-contact" aria-labelledby="policy-contact-heading" data-policy-contact variant="unstyled">
    <header data-policy-contact-label>
      <p>{label}</p>
      <Icon name="mail" size="sm" />
    </header>
    <h2 id="policy-contact-heading">{title}</h2>
    <div data-policy-contact-copy><slot /></div>
    <div data-policy-contact-note><slot name="note" /></div>
  </Card>
</div>

<style>
  [data-policy-contact-container] { container: policy-contact / inline-size; }
  [data-policy-contact][data-slot='card'] {
    --policy-contact-emphasis: hsl(var(--brand));
    max-width: 48rem;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.375rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow: hidden;
    overflow-wrap: break-word;
  }
  :global([data-theme='santi020k-dark']) [data-policy-contact] { --policy-contact-emphasis: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-policy-contact-label] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.375rem 1.75rem;
    border-bottom: 1px solid hsl(var(--line));
    background: hsl(var(--brand-soft));
    color: var(--policy-contact-emphasis);
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
  [data-policy-contact-label] p { margin: 0; color: inherit; }
  [data-policy-contact-label] :global(svg) { flex-shrink: 0; }
  :global(.remaining-pages) [data-policy-contact] h2 {
    margin: 0;
    padding: 1.625rem 1.75rem 0;
    font-size: 1.875rem;
    line-height: 1.25;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: manual;
  }
  [data-policy-contact-copy] {
    padding: 1rem 1.75rem 1.5rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.75rem;
  }
  [data-policy-contact-copy] :global(p), [data-policy-contact-note] :global(p) { margin: 0; }
  [data-policy-contact-copy] :global(a) {
    color: var(--policy-contact-emphasis);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
    white-space: nowrap;
  }
  [data-policy-contact-copy] :global(a:hover) { color: hsl(var(--ink)); }
  [data-policy-contact-note] {
    padding: 1.125rem 1.75rem 1.375rem;
    border-top: 1px solid hsl(var(--line));
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.5rem;
  }
  @container policy-contact (width < 27.5rem) {
    [data-policy-contact-label] { padding: 1.25rem; }
    :global(.remaining-pages) [data-policy-contact] h2 { padding: 1.375rem 1.25rem 0; font-size: 1.625rem; line-height: 1.3; }
    [data-policy-contact-copy] { padding: 1rem 1.25rem 1.375rem; }
    [data-policy-contact-note] { padding: 1.125rem 1.25rem 1.375rem; }
  }
  @container policy-contact (width < 16rem) {
    [data-policy-contact][data-slot='card'] { width: calc(100% + 2rem); margin-inline: -1rem; }
    [data-policy-contact-label], [data-policy-contact-copy], [data-policy-contact-note] { padding-inline: 0.375rem; }
    :global(.remaining-pages) [data-policy-contact] h2 { padding-inline: 0.375rem; font-size: 1rem; line-height: 1.5; }
  }
</style>
