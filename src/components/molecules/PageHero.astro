---
import Eyebrow from '@/components/atoms/Eyebrow.astro'

interface Props {
  compact?: boolean
  description: string
  eyebrow: string
  gradientText: string
  metaItems?: string[] | undefined
  title: string
}

const { compact = false, description, eyebrow, gradientText, metaItems = [], title } = Astro.props
const hasActions = Astro.slots.has('default')
const hasMetaItems = metaItems.length > 0
---

<section
  class:list={[
    'relative section-container-wide',
    compact ?
      `
        py-2
        sm:pt-3
        lg:pt-4
      ` :
      `
        py-4
        sm:pt-6
        lg:pt-8
      `
  ]}
>
  <div
    aria-hidden="true"
    class="
      pointer-events-none absolute top-4 right-0 -z-10 h-112 w-2xl max-w-[90vw]
      rounded-full bg-radial from-brand/12 via-brand-soft/8 to-transparent
      opacity-80 blur-2xl
    "
  />

  <div class:list={['relative z-10', compact ? 'space-y-5' : 'space-y-8']}>
    <Eyebrow
      className="
        animate-slide-up whitespace-normal
        motion-reduce:animate-none
      "
      label={eyebrow}
      tone="brand"
    />

    <div class="
      animate-slide-up space-y-4 [animation-delay:90ms]
      motion-reduce:animate-none
    "
    >
      <h1
        class:list={[
          'max-w-5xl font-extrabold tracking-[-0.06em] wrap-break-word',
          compact ?
            `
              text-3xl/[1]
              sm:text-5xl/[0.98]
              lg:text-6xl/[0.95]
            ` :
            `
              text-4xl/[0.98]
              sm:text-6xl/[0.95]
              lg:text-[5.2rem]/[0.92]
            `
        ]}
      >
        {title}{' '}
        <span
          class:list={[
            `
              block bg-linear-to-r from-brand via-accent to-brand bg-clip-text
              text-transparent
            `,
            compact ? 'pb-2' : 'pb-4'
          ]}
        >
          {gradientText}
        </span>
      </h1>
      <p class="
        max-w-2xl text-base/7 text-ink-soft
        sm:text-lg/8
      "
      >{description}
      </p>
    </div>

    {(hasActions || hasMetaItems) && (
      <div class="
        animate-slide-up space-y-5 [animation-delay:180ms]
        motion-reduce:animate-none
      "
      >
        {hasActions && (
          <div class="section-actions">
            <slot />
          </div>
        )}

        {hasMetaItems && (
          <ul
            class="
              flex max-w-3xl flex-wrap gap-x-4 gap-y-2 border-t border-line/45
              pt-5 text-xs/6 font-semibold tracking-[0.16em] text-ink-muted
              uppercase
            "
          >
            {metaItems.map(item => (
              <li class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-brand/70" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    )}
  </div>
</section>
