---
import { getLocale } from '@/i18n'
import { localizeCollectionSource } from '@/i18n/collection-copy'
import { localizePageSource } from '@/i18n/page-copy'

interface Props {
  compact?: boolean
  description: string
  eyebrow: string
  gradientText: string
  metaItems?: string[] | undefined
  title: string
}

const { compact = false, description, eyebrow, gradientText, metaItems = [], title } = Astro.props
const locale = getLocale(Astro.url.pathname)
const localizeMeta = (item: string) => locale === 'es' ? localizePageSource(locale, localizeCollectionSource(locale, item)) : item
const hasActions = Astro.slots.has('default')
const hasMetaItems = metaItems.length > 0
---

<section class="section-container-wide editorial-page-hero" data-editorial-compact={compact ? 'true' : undefined}>
  <p class="editorial-eyebrow">{eyebrow}</p>
  <h1 class="editorial-page-title">
    {title}{' '}
    <span class="editorial-page-emphasis">{gradientText}</span>
  </h1>
  <p class="editorial-page-description">{description}</p>
  <slot name="after-description" />
  {hasActions && <div class="editorial-page-actions section-actions"><slot /></div>}
  {hasMetaItems && (
    <ul class="editorial-page-meta">
      {metaItems.map(item => <li>{localizeMeta(item)}</li>)}
    </ul>
  )}
</section>
