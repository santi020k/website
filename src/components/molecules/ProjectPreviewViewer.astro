---
import { getImage } from 'astro:assets'

import GalleryViewer from '@/components/molecules/GalleryViewer.astro'

import { Image } from '@santi020k/lumen-astro'

import type { ProjectPreviewImage } from '@/types'

interface Props {
  id: string
  preview: ProjectPreviewImage
}

const { id, preview } = Astro.props
const fullImage = await getImage({ src: preview.src, fit: 'contain', format: 'webp', quality: 90, width: preview.src.width })
---

<project-preview-viewer>
  <GalleryViewer id={id} title={preview.title} caption={preview.caption} source={{ kind: 'asset', src: fullImage.src, width: preview.src.width }}>
    <Image alt={preview.alt} fit="contain" format="webp" loading="eager" quality={90} radius="none" src={preview.src} width={preview.src.width} />
  </GalleryViewer>
</project-preview-viewer>
