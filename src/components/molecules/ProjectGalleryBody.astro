---
import Link from '@santi020k/lumen-astro/components/Link'

interface Props {
  href: string | undefined
}

const { href } = Astro.props
---

{href ?
(
  <Link class="projects-editorial-link" href={href} variant="inherit"><slot /></Link>
) :
(
  <div class="projects-editorial-link" data-product-first><slot /></div>
)}
