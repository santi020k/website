---
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'

import { getRelatedPosts, getRelatedTopics } from '@/utils/content'
import { getTagPath } from '@/utils/links'
import { getBlogTopicLabel } from '@/utils/tags'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

import SectionHeader from './SectionHeader.astro'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  currentPostId: string
  excludeSeriesId?: string | undefined
  excludeUrls?: string[]
  tags: string[]
}

const { currentPostId, excludeSeriesId, excludeUrls = [], tags } = Astro.props

const developerExperienceTags = new Set([
  'ai',
  'automation',
  'ci-cd',
  'code-quality',
  'developer-experience',
  'engineering-standards',
  'eslint',
  'testing'
])

const belongsToDeveloperExperienceHub = tags.some(tag => developerExperienceTags.has(tag))

const relatedPosts = await getRelatedPosts({
  currentPostId,
  ...(excludeSeriesId ? { excludeSeriesId } : {}),
  excludeUrls,
  limit: 2,
  tags
})

const relatedTopics = getRelatedTopics(tags, relatedPosts)
---

{relatedPosts.length > 0 && (
  <PageSection layout="stacked">
    <SectionHeader
      eyebrow={t('collection.relatedWriting')}
      id="related-writing"
      linkHref={localizePath(belongsToDeveloperExperienceHub ? '/developer-experience/' : '/blog/', locale)}
      linkLabel={belongsToDeveloperExperienceHub ? t('collection.exploreTheDeveloperExperienceGuide') : t('collection.browseAllPosts')}
      title={t('collection.keepReadingInTheSameThread')}
      variant="margin"
    >
      {relatedTopics.length > 0 && (
        <div slot="description" data-related-topic-context>
          <p>{t('collection.connectedThrough')}</p>
          <nav aria-label={t('collection.topicsSharedWithTheseRecommendations')}>
            <ul data-related-topic-list>
              {relatedTopics.map((topic, index) => (
                <li>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <Link href={localizePath(getTagPath(topic), locale)} variant="inherit">{getBlogTopicLabel(topic)}</Link>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}
    </SectionHeader>

    <PostsGallery layout="chapters" posts={relatedPosts} />
  </PageSection>
)}

<style>
  [data-related-topic-context] { margin-top: 1.5rem; }
  [data-related-topic-context] p {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  [data-related-topic-list] {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-related-topic-list] li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    max-width: 100%;
  }
  [data-related-topic-list] span { color: hsl(var(--ink-soft)); }
  [data-related-topic-list] :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 0;
    color: var(--margin-emphasis);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: hsl(var(--line));
    text-underline-offset: 0.3125rem;
    overflow-wrap: anywhere;
  }
  [data-related-topic-list] :global(a:hover) { color: hsl(var(--ink)); }
  [data-related-topic-list] :global(a:focus-visible) {
    outline: 2px solid var(--margin-emphasis);
    outline-offset: 4px;
  }
</style>
