---
import { getCollection } from 'astro:content'

import PostCard from './PostCard.astro'
import SectionHeading from './SectionHeading.astro'

interface Props {
  currentPostId: string
  excludeSeriesId?: string | undefined
  tags: string[]
}

const { currentPostId, excludeSeriesId, tags } = Astro.props
const allPosts = await getCollection('post')

// Filter out current post and score others based on shared tags
const relatedPosts = allPosts
  .filter(post => post.id !== currentPostId && (!excludeSeriesId || post.data.seriesId !== excludeSeriesId))
  .map(post => {
    const sharedTags = post.data.tags.filter(tag => tags.includes(tag)).length

    return { post, sharedTags }
  })
  .filter(item => item.sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime())
  .slice(0, 3)
  .map(item => item.post)

---

{relatedPosts.length > 0 && (
  <section class="mt-20 space-y-8 border-t border-line pt-20">
    <div data-animate>
      <SectionHeading
        description="A few more posts that overlap in topic, tooling, or the engineering tradeoffs behind this article."
        eyebrow="Keep reading"
        title="More writing in the same thread."
      />
    </div>

    <div
      class="
        grid gap-6
        sm:grid-cols-2
        lg:grid-cols-3
      "
      data-animate
    >
      {relatedPosts.map(post => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
)}
