---
import PageSection from '@/components/organisms/PageSection.astro'
import PostsGallery from '@/components/organisms/PostsGallery.astro'

import { getRelatedPosts } from '@/utils/content'

import SectionHeader from './SectionHeader.astro'

interface Props {
  currentPostId: string
  excludeSeriesId?: string | undefined
  excludeUrls?: string[]
  tags: string[]
}

const { currentPostId, excludeSeriesId, excludeUrls = [], tags } = Astro.props

const developerExperienceTags = new Set([
  'ai',
  'automation',
  'ci-cd',
  'code-quality',
  'developer-experience',
  'engineering-standards',
  'eslint',
  'testing'
])

const belongsToDeveloperExperienceHub = tags.some(tag => developerExperienceTags.has(tag))

const relatedPosts = await getRelatedPosts({
  currentPostId,
  ...(excludeSeriesId ? { excludeSeriesId } : {}),
  excludeUrls,
  limit: 2,
  tags
})
---

{relatedPosts.length > 0 && (
  <PageSection layout="stacked">
    <SectionHeader
      description="More writing from a similar lane — overlapping topics, tooling choices, and the tradeoffs behind the article you just read."
      eyebrow="Related writing"
      id="related-writing"
      linkHref={belongsToDeveloperExperienceHub ? '/developer-experience/' : '/blog/'}
      linkLabel={belongsToDeveloperExperienceHub ? 'Explore the developer experience guide' : 'Browse all posts'}
      title="Keep reading in the same thread."
      variant="margin"
    />

    <PostsGallery columns={2} posts={relatedPosts} />
  </PageSection>
)}
