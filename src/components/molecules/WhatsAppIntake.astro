---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { Icon } from '@santi020k/lumen-astro'

import { workTopics } from '@/data/work-with-me'
import { siteConfig } from '@/site.config'

---

<div data-whatsapp-intake-shell>
  <header data-intake-header>
    <span data-intake-icon><Icon class="size-6" name="message-circle" /></span>
    <div>
      <h3 id="intake-heading">Message me on WhatsApp</h3>
      <p>Pick a topic and add a line of context. I’ll write the message for you; you review it before sending.</p>
    </div>
  </header>

  <p data-intake-fallback>
    <a href={siteConfig.contact.whatsapp} rel="noopener noreferrer" target="_blank">Open WhatsApp directly</a>{' '}
    or choose another contact option below.
  </p>

  <form
    aria-labelledby="intake-heading"
    data-whatsapp-intake
    data-whatsapp-phone={siteConfig.contact.whatsappPhone}
    hidden
  >
    <fieldset data-intake-topics>
      <legend>What would you like to talk about?</legend>
      <div data-intake-topic-grid>
        {workTopics.map((topic, index) => (
          <label data-intake-topic>
            <input checked={index === 0} data-opener={topic.opener} name="topic" required type="radio" value={topic.id} />
            <span>{topic.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div data-intake-fields>
      <label data-intake-field>
        <span>Your name <em>optional</em></span>
        <input autocomplete="name" data-intake-name maxlength="80" type="text" />
      </label>
      <label data-intake-field>
        <span>Company or event <em>optional</em></span>
        <input autocomplete="organization" data-intake-company maxlength="120" type="text" />
      </label>
      <label data-intake-field data-intake-wide>
        <span>A line of context <em>optional</em></span>
        <textarea data-intake-context maxlength="600" placeholder="Dates, team size, the problem you want to solve…" rows="3"></textarea>
      </label>
    </div>

    <div data-intake-actions>
      <button data-intake-submit type="submit">
        <span>Open WhatsApp</span>
        <ArrowExchange class="size-4.5 shrink-0" direction="up-right" />
      </button>
      <p data-intake-note>Opens WhatsApp in a new tab. Nothing is stored on this site.</p>
    </div>

    <div data-intake-handoff hidden>
      <p data-intake-status role="status"></p>
      <p>If WhatsApp didn’t open, try again. You can edit your details above before retrying.</p>
      <a data-intake-retry href={siteConfig.contact.whatsapp} rel="noopener noreferrer" target="_blank">Try WhatsApp again</a>
    </div>
  </form>
</div>

<script>
  const buildMessage = (form: HTMLFormElement) => {
    const topic = form.querySelector<HTMLInputElement>('input[name="topic"]:checked')
    const name = form.querySelector<HTMLInputElement>('[data-intake-name]')?.value.trim()
    const company = form.querySelector<HTMLInputElement>('[data-intake-company]')?.value.trim()
    const context = form.querySelector<HTMLTextAreaElement>('[data-intake-context]')?.value.trim()
    const intro = name ? `Hi Santiago, I’m ${name}${company ? ` from ${company}` : ''}.` : `Hi Santiago${company ? `, I’m reaching out from ${company}` : ''}.`

    return [intro, topic?.dataset.opener ?? '', context ?? ''].filter(Boolean).join(' ')
  }

  const setupIntake = () => {
    document.querySelectorAll<HTMLFormElement>('[data-whatsapp-intake]').forEach(form => {
      if (form.dataset.intakeReady) return

      const shell = form.closest<HTMLElement>('[data-whatsapp-intake-shell]')
      const fallback = shell?.querySelector<HTMLElement>('[data-intake-fallback]')
      const handoff = form.querySelector<HTMLElement>('[data-intake-handoff]')
      const status = form.querySelector<HTMLElement>('[data-intake-status]')
      const retry = form.querySelector<HTMLAnchorElement>('[data-intake-retry]')
      const phone = form.dataset.whatsappPhone

      if (!fallback || !handoff || !status || !retry || !phone) return

      const updateRetry = () => {
        retry.href = `https://wa.me/${phone}?text=${encodeURIComponent(buildMessage(form))}`
      }

      form.addEventListener('input', updateRetry)

      form.addEventListener('submit', event => {
        event.preventDefault()

        updateRetry()

        // Keep the draft in this document so blocked or failed handoffs can be retried.
        handoff.hidden = false

        status.textContent = 'Your message is ready. Review it in WhatsApp, then press send.'

        window.open(retry.href, '_blank', 'noopener,noreferrer')
      })

      form.dataset.intakeReady = 'true'

      fallback.hidden = true

      form.hidden = false
    })
  }

  setupIntake()

  document.addEventListener('astro:page-load', setupIntake)
</script>

<style>
  [data-whatsapp-intake-shell] {
    --intake-accent: var(--brand);
    container: whatsapp-intake / inline-size;
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    padding: 1.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  :global(:root[data-theme='dark']) [data-whatsapp-intake-shell] { --intake-accent: var(--accent); }
  [data-whatsapp-intake]:not([hidden]) { display: grid; gap: 1.75rem; min-width: 0; }
  [data-intake-handoff]:not([hidden]) { display: grid; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid hsl(var(--line)); }
  [data-intake-handoff] p { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  [data-intake-status] { color: hsl(var(--ink)); font-weight: 500; }
  [data-intake-retry] { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; color: hsl(var(--intake-accent)); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 0.25em; }
  [data-intake-retry]:focus-visible, [data-intake-fallback] a:focus-visible { outline: 2px solid hsl(var(--intake-accent)); outline-offset: 3px; }
  [data-intake-header] { display: flex; align-items: start; gap: 1rem; }
  [data-intake-icon] { display: grid; flex: none; width: 3rem; height: 3rem; place-items: center; border-radius: 1rem; background: hsl(var(--brand-soft)); color: hsl(var(--intake-accent)); }
  [data-intake-header] h3 { margin: 0; font-size: 1.5rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.045em; }
  [data-intake-header] p { margin: 0.5rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  legend, [data-intake-field] > span { margin-bottom: 0.75rem; padding: 0; color: hsl(var(--ink)); font-size: 0.8125rem; font-weight: 600; line-height: 1.6; }
  [data-intake-field] em { margin-left: 0.375rem; color: hsl(var(--ink-soft)); font-style: normal; font-weight: 400; }
  [data-intake-topic-grid] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.625rem; }
  [data-intake-topic] { position: relative; display: flex; min-width: 0; }
  [data-intake-topic] input { position: absolute; opacity: 0; pointer-events: none; }
  [data-intake-topic] span {
    display: flex;
    width: 100%;
    min-height: 3rem;
    align-items: center;
    padding: 0.625rem 0.875rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.75rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    line-height: 1.4;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  [data-intake-topic]:hover span { border-color: hsl(var(--intake-accent) / 0.6); color: hsl(var(--ink)); }
  [data-intake-topic] input:checked + span { border-color: hsl(var(--intake-accent)); background: hsl(var(--brand-soft)); color: hsl(var(--ink)); font-weight: 600; }
  [data-intake-topic] input:focus-visible + span { outline: 2px solid hsl(var(--intake-accent)); outline-offset: 2px; }
  [data-intake-fields] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  [data-intake-field] { display: flex; min-width: 0; flex-direction: column; }
  [data-intake-wide] { grid-column: 1 / -1; }
  [data-intake-field] :is(input, textarea) {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  [data-intake-field] textarea { resize: vertical; }
  [data-intake-field] :is(input, textarea):focus-visible { border-color: hsl(var(--intake-accent)); outline: 2px solid hsl(var(--intake-accent) / 0.35); outline-offset: 1px; }
  [data-intake-actions] { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  [data-intake-submit] {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid hsl(var(--ink));
    border-radius: 0.75rem;
    background: hsl(var(--ink));
    color: hsl(var(--surface));
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  [data-intake-submit]:hover { background: hsl(var(--intake-accent)); border-color: hsl(var(--intake-accent)); }
  [data-intake-submit]:focus-visible { outline: 2px solid hsl(var(--intake-accent)); outline-offset: 3px; }
  [data-intake-note], [data-intake-fallback] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.7; }
  [data-intake-fallback] a { color: hsl(var(--intake-accent)); text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    [data-intake-topic] span, [data-intake-submit] { transition: none; }
  }
  @media (forced-colors: active) {
    [data-intake-topic] input:checked + span { border: 2px solid Highlight; }
  }
  @container whatsapp-intake (width < 36rem) {
    [data-intake-topic-grid] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    [data-intake-fields] { grid-template-columns: minmax(0, 1fr); }
  }
  @container whatsapp-intake (width < 22rem) {
    [data-whatsapp-intake-shell] { padding: 1.25rem; }
    [data-intake-topic-grid] { grid-template-columns: minmax(0, 1fr); }
  }
</style>
