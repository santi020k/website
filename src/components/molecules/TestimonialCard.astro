---
interface Props {
  quote: string
  authorName: string
  role: string
  relationship: string
  avatarInitials: string
  avatarUrl?: string | undefined
}

const { quote, authorName, role, relationship, avatarInitials, avatarUrl } = Astro.props
---

<article class="card-interactive h-full flex flex-col p-6 sm:p-7">
  {/* Decorative quote mark */}
  <div class="mb-4 text-brand/20" aria-hidden="true">
    <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
    </svg>
  </div>

  <blockquote class="flex-1">
    <p class="text-base/7 text-ink sm:text-[0.95rem]/[1.75] font-medium">
      "{quote}"
    </p>
  </blockquote>

  <div class="mt-6 flex items-center gap-4 pt-5 border-t border-line/30">
    {avatarUrl ? (
      <img
        alt={authorName}
        class="size-12 shrink-0 rounded-full object-cover ring-2 ring-line/20"
        decoding="async"
        height="48"
        loading="lazy"
        src={avatarUrl}
        width="48"
      />
    ) : (
      <div
        class="
          grid size-12 shrink-0 place-items-center rounded-full
          bg-gradient-to-br from-brand/15 to-accent/10
          text-sm font-semibold text-brand ring-2 ring-line/20
        "
      >
        {avatarInitials}
      </div>
    )}
    <div class="min-w-0">
      <p class="text-sm font-semibold text-ink truncate">{authorName}</p>
      <p class="text-xs text-ink-muted truncate">{role} · {relationship}</p>
    </div>
  </div>
</article>
