---
import { Image } from 'astro:assets'

import { Avatar, Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  quote: string
  authorName: string
  role: string
  relationship: string
  avatarInitials: string
  avatarUrl?: string | undefined
}

const { quote, authorName, role, relationship, avatarInitials, avatarUrl } = Astro.props
---

<Card
  as="article"
  data-testimonial
  glass={false}
  variant="unstyled"
>
  <div data-testimonial-body>
    <div aria-hidden="true" data-testimonial-quote>
      <Icon class="size-10" name="quote" />
    </div>
    <blockquote><p>“{quote}”</p></blockquote>
  </div>

  <footer data-testimonial-identity>
    {avatarUrl ?
      (
        <Avatar data-testimonial-avatar aria-hidden="true">
          <Image
            alt=""
            decoding="async"
            height={48}
            loading="lazy"
            src={avatarUrl}
            width={48}
            inferSize={true}
          />
        </Avatar>
      ) :
      (
        <Avatar
          data-testimonial-avatar
          aria-hidden="true"
          fallback={avatarInitials}
        />
      )}
    <div data-testimonial-author-copy>
      <p data-testimonial-author>{authorName}</p>
      <p data-testimonial-role>{role}</p>
    </div>
    <p data-testimonial-relationship>{relationship}</p>
  </footer>
</Card>

<style>
  [data-testimonial][data-slot='card'] {
    --testimonial-accent: var(--about-accent, hsl(var(--brand)));
    container: testimonial / inline-size;
    min-width: 0;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--testimonial-accent) 22%, hsl(var(--line) / 0.65));
    border-radius: var(--radius-quote-sleeve);
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    box-shadow: var(--shadow-quote-sleeve);
  }
  [data-testimonial-body] { display: grid; grid-template-columns: 2.875rem minmax(0, 1fr); gap: 1.375rem; min-width: 0; padding: 2.125rem; }
  [data-testimonial-quote] { color: var(--testimonial-accent); }
  [data-testimonial-quote] :global(svg) { width: 2.5rem; height: 2.5rem; }
  [data-testimonial] blockquote { margin: 0; }
  [data-testimonial] blockquote p { color: hsl(var(--ink)); font-size: 1.375rem; line-height: 1.65; font-weight: 400; letter-spacing: -0.035em; }
  [data-testimonial-identity] {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(6.25rem, 0.8fr);
    align-items: center;
    gap: 1rem;
    margin-inline: 2.125rem;
    padding-block: 1.375rem 1.625rem;
    border-top: 1px solid hsl(var(--line) / 0.65);
  }
  [data-testimonial-author-copy] { min-width: 0; }
  [data-testimonial-avatar] {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 0;
    background: color-mix(in srgb, var(--testimonial-accent) 12%, hsl(var(--surface)));
    color: color-mix(in srgb, var(--testimonial-accent) 80%, hsl(var(--ink)));
    font-size: 0.8125rem;
    font-weight: 600;
  }
  [data-testimonial] p { margin: 0; overflow-wrap: anywhere; text-wrap: pretty; }
  [data-testimonial-author] { color: hsl(var(--ink)); font-size: 1rem; line-height: 1.4375rem; font-weight: 600; letter-spacing: -0.03em; }
  [data-testimonial-identity] [data-testimonial-role] { margin-top: 0.1875rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.25rem; }
  [data-testimonial-identity] [data-testimonial-relationship] {
    justify-self: end;
    max-width: 10.625rem;
    color: hsl(var(--ink-soft));
    font-size: 0.6875rem;
    line-height: 1.125rem;
    text-align: right;
  }

  @container testimonial (width < 32.5rem) {
    [data-testimonial-body] { grid-template-columns: minmax(0, 1fr); gap: 1.125rem; padding: 1.5rem; }
    [data-testimonial-quote] :global(svg) { width: 2rem; height: 2rem; }
    [data-testimonial] blockquote p { font-size: 1.1875rem; line-height: 1.7; }
    [data-testimonial-identity] { grid-template-columns: 2.625rem minmax(0, 1fr); gap: 0.875rem; margin-inline: 1.5rem; }
    [data-testimonial-avatar] { width: 2.625rem; height: 2.625rem; }
    [data-testimonial-identity] [data-testimonial-relationship] { grid-column: 1 / -1; justify-self: start; max-width: none; text-align: left; }
  }
  @container testimonial (width < 17.5rem) {
    [data-testimonial-body] { padding: 1.375rem 1.125rem; }
    [data-testimonial-identity] { margin-inline: 1.125rem; }
    [data-testimonial] blockquote p { font-size: 1.125rem; }
  }
  @container testimonial (width < 14rem) {
    [data-testimonial-identity] { grid-template-columns: minmax(0, 1fr); }
  }
</style>
