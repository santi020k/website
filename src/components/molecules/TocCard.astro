---
interface HeadingLink {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: HeadingLink[]
}

const { headings } = Astro.props
---

<nav aria-label="Table of contents" class="mini-note">
  <p class="section-label">On this page</p>
  <ul class="mt-4 space-y-3">
    {headings.map(heading => (
      <li class:list={['text-sm/6', heading.depth > 2 && 'pl-4']}>
        <a
          class="
            text-ink-soft transition-colors duration-200
            hover:text-brand
          "
          href={`#${heading.slug}`}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
