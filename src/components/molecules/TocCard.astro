---
import { Anchor, Icon } from '@santi020k/lumen-astro'

interface HeadingLink {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: HeadingLink[]
}

const { headings } = Astro.props
const tocHeadings = headings.filter(heading => heading.depth <= 3)
---

<div data-toc-shell>
  <Anchor
    activationOffset={120}
    data-editorial-toc
    aria-label="Table of contents"
  >
    <p data-toc-title>
      On this page
      <Icon class="size-4 shrink-0" name="list" />
    </p>

    <ol role="list" data-toc-tree>
      {tocHeadings.map((heading, index) => (
        <li>
          <a
            data-active={index === 0 ? 'true' : 'false'}
            data-depth={heading.depth}
            href={`#${heading.slug}`}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </Anchor>
</div>

<style>
  [data-toc-shell] { container: toc-rail / inline-size; }
  [data-editorial-toc] {
    padding: 1.5rem 1.5rem 1.125rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    overflow-wrap: break-word;
  }
  [data-toc-title] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin: 0; color: hsl(var(--brand)); font-size: 0.75rem; line-height: 1.667; font-weight: 500; letter-spacing: normal; }
  [data-toc-tree] { margin: 1.625rem 0 0; padding: 0; border-inline-start: 1px solid hsl(var(--line)); list-style: none; }
  [data-toc-tree] a {
    position: relative;
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    margin: 0;
    padding: 0.6875rem 0 0.6875rem 1.125rem;
    border: 0;
    color: hsl(var(--ink));
    font-size: 1rem;
    line-height: 1.625;
    font-weight: 500;
    transition: color 200ms ease;
  }

  [data-toc-tree] a[data-depth="3"] {
    padding-inline-start: 1.875rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    font-weight: 400;
  }
  [data-toc-tree] a:is(:hover, [data-active='true'], [aria-current='location']) { color: hsl(var(--brand)); }
  [data-toc-tree] a:is([data-active='true'], [aria-current='location'])::before {
    content: '';
    position: absolute;
    inset-block: 0.625rem;
    inset-inline-start: -2px;
    width: 3px;
    border-radius: 2px;
    border-inline-start: 3px solid currentColor;
  }
  :global(:root[data-theme='dark']) [data-toc-title],
  :global(:root[data-theme='dark']) [data-toc-tree] a:is(:hover, [data-active='true'], [aria-current='location']) { color: hsl(var(--accent)); }

  @container toc-rail (width < 16rem) {
    [data-editorial-toc] { padding-inline: 0.75rem; }
    [data-toc-tree] a { padding-inline-start: 0.5rem; font-size: 0.9375rem; }
    [data-toc-tree] a[data-depth='3'] { padding-inline-start: 1rem; font-size: 0.8125rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-tree] a {
      transition: none;
    }
  }
</style>
