---
import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  icon: string
  id: string
  title: string
}

const { icon, id, title } = Astro.props
---

<Card
  as="section"
  aria-labelledby={id}
  class="rounded-2xl p-5"
  data-project-sidebar-card
  variant="default"
>
  <h2 class="flex items-center gap-2 font-sans section-label" id={id}>
    <Icon class="size-4 text-brand" name={icon} />
    {title}
  </h2>
  <slot />
</Card>
