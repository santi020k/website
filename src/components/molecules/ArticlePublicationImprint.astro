---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import type { getPublicationImprint } from '@/utils/article-publication'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, sharedTranslator } from '@/i18n'

interface Props {
  imprint: NonNullable<ReturnType<typeof getPublicationImprint>['imprint']>
}

const { imprint } = Astro.props
const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)
---

<aside data-article-publication aria-labelledby="original-publication-label">
  <div data-publication-credit>
    <p id="original-publication-label" data-publication-label>{t('publication.original')}</p>
    <div data-publication-origin>
      <div data-publication-publisher-row>
        <Link href={imprint.url} newTab variant="inherit" data-publication-publisher>{imprint.name}</Link>
        <sup data-print-reference><a href={`#article-print-reference-${imprint.publisherReference}`}>{imprint.publisherReference}</a></sup>
      </div>
      <p data-publication-platform>{t('publication.platform', { platform: imprint.platform })}</p>
    </div>
    <div data-publication-destination>
      <Link href={imprint.originalUrl} newTab variant="inherit" data-publication-original>
        <span data-publication-original-label>{t('publication.readOriginal')}</span>
        <span data-publication-arrow>
          <ArrowExchange direction="up-right" class="size-4 shrink-0" />
        </span>
      </Link>
      <sup data-print-reference><a href={`#article-print-reference-${imprint.articleReference}`}>{imprint.articleReference}</a></sup>
    </div>
  </div>
</aside>

<style>
  [data-article-publication] {
    --publication-accent: hsl(var(--brand));
    container: publication-imprint / inline-size;
    margin-block-start: 2rem;
    color: hsl(var(--ink));
  }

  :global(:root[data-theme='santi020k-dark']) [data-article-publication] {
    --publication-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  [data-publication-credit] {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-block: 1px solid hsl(var(--line));
  }

  [data-publication-label], [data-publication-platform] {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  [data-publication-origin] {
    min-width: 0;
    border-inline-start: 2px solid var(--publication-accent);
    padding-inline-start: 1.125rem;
  }

  :global([data-publication-publisher]) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    max-width: 100%;
    color: hsl(var(--ink));
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-color: hsl(var(--line));
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25rem;
    overflow-wrap: anywhere;
    transition: color 240ms ease, text-decoration-color 240ms ease;
  }

  :global([data-publication-publisher]:is(:hover, :focus-visible)) {
    color: var(--publication-accent);
    text-decoration-color: currentColor;
  }

  [data-publication-destination] { min-width: 0; }

  :global([data-publication-original]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.375rem 0.375rem 0.375rem 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.875rem;
    color: hsl(var(--ink-soft));
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: normal;
    text-decoration: none;
    transition: background-color 240ms ease, border-color 240ms ease, color 240ms ease;
  }

  [data-publication-original-label] {
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: hsl(var(--line));
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3125rem;
    transition: text-decoration-color 240ms ease;
  }

  [data-publication-arrow] {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--publication-accent);
    transition: background-color 240ms ease;
  }

  :global([data-publication-original]:is(:hover, :focus-visible)) {
    border-color: hsl(var(--line));
    background: hsl(var(--surface-muted));
    color: var(--publication-accent);
  }

  :global([data-publication-original]:is(:hover, :focus-visible)) [data-publication-original-label] { text-decoration-color: currentColor; }
  :global([data-publication-original]:is(:hover, :focus-visible)) [data-publication-arrow] { background: hsl(var(--brand-soft)); }
  [data-article-publication] :global(a:focus-visible) { outline: 2px solid var(--publication-accent); outline-offset: 4px; }

  @container publication-imprint (width < 30rem) {
    [data-publication-credit] { grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; }
    [data-publication-label] { grid-column: 1 / -1; }
    [data-publication-origin] { padding-inline-start: 0.875rem; }
    :global([data-publication-publisher]) { font-size: 1.125rem; }
    :global([data-publication-original]) { gap: 0.5rem; padding-inline-start: 0.5rem; }
  }

  @container publication-imprint (width < 20rem) {
    [data-publication-credit] { grid-template-columns: minmax(0, 1fr); }
    [data-publication-destination] { justify-self: start; max-width: 100%; margin-inline-start: 0.375rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-publication-publisher]), :global([data-publication-original]),
    [data-publication-original-label], [data-publication-arrow] { transition: none; }
  }

  @media print {
    [data-article-publication] { margin-block-start: 1.5rem; break-inside: avoid; }
    [data-publication-credit] { grid-template-columns: 6rem minmax(0, 1fr) auto; gap: 1rem; padding-block: 0.75rem; }
    [data-publication-label], [data-publication-platform] { font-size: 9pt; }
    [data-publication-origin] { padding-inline-start: 0.75rem; }
    :global([data-publication-publisher]) { min-height: 0; font-size: 11pt; }
    :global([data-publication-original]) { display: inline; min-height: 0; padding: 0; border: 0; border-radius: 0; font-size: 9pt; }
    [data-publication-arrow] { display: none; }
  }
</style>
