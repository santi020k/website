---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getPortfolioPath } from '@/utils/links'

import { Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

interface Props {
  compact?: boolean
  project: CollectionEntry<'project'>
}

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const { compact = false, project } = Astro.props
---

<div class="print:hidden" data-resume-evidence-note data-compact={compact || undefined} data-print-hidden>
  {!compact && <p>{t('collection.theDecisionsBehindTheseResults')}</p>}
  <Link href={localizePath(getPortfolioPath(project.id), locale)} variant="inherit">
    <span data-resume-evidence-label>{t('collection.readNamedCaseStudy', { project: project.data.title })}</span>
    <span data-resume-evidence-arrow><ArrowExchange direction="right" /></span>
  </Link>
</div>
