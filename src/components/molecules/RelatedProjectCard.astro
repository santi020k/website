---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { localizeProject } from '@/utils/content-translations'
import { getPortfolioPath } from '@/utils/links'
import { getProjectBrandStyle } from '@/utils/project-brand'
import { getProjectCoverForUsage } from '@/utils/project-cover'

import Card from '@santi020k/lumen-astro/components/Card'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

interface Props {
  index: number
  project: CollectionEntry<'project'>
}

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)
const { index, project: originalEntry } = Astro.props
const project = await localizeProject(originalEntry, getLocale(Astro.url.pathname))
const cover = getProjectCoverForUsage(project.data.coverImage, 'hero')
---

<Card as="article" variant="unstyled" data-related-project data-arrow-owner style={getProjectBrandStyle(project.data.brand)}>
  <span data-related-number aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <div data-related-artwork>
    {cover ?
(
      <Picture
        alt=""
        class="absolute inset-0 size-full object-cover"
        fallbackFormat="webp"
        formats={['avif']}
        height={450}
        loading="lazy"
        sizes="auto, (min-width: 1280px) 396px, (min-width: 768px) 256px, 88px"
        src={cover}
        width={800}
        widths={[176, 264, 400, 600, 800, 1200]}
        fit="cover"
      />
    ) :
<Icon class="size-12" name="code-2" />}
  </div>
  <div data-related-body>
    <div data-related-heading>
      <p data-related-role lang={project.data.role ? 'en' : undefined}>{project.data.role ?? t('collection.engineering')}</p>
      <h3 lang={project.data.contentLocale}>{project.data.title}</h3>
    </div>
    <p data-related-description lang={project.data.contentLocale}>{project.data.description}</p>
    <div data-related-footer>
      <span data-related-action>
        {t('collection.readCaseStudy')}
        <span data-related-arrow><ArrowExchange class="size-4" direction="right" /></span>
      </span>
    </div>
  </div>
  <a data-related-link href={localizePath(getPortfolioPath(project.id), locale)} aria-label={`${t('collection.readCaseStudy')}: ${project.data.title}`}></a>
</Card>

<style>
  [data-related-project][data-slot='card'] {
    --related-emphasis: var(--brand);
    --related-project-ink: var(--project-primary-readable);
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 0.9fr) minmax(0, 1.45fr);
    align-items: stretch;
    gap: 2.5rem;
    min-width: 0;
    padding: 2rem 0;
    border: 0;
    border-top: 1px solid hsl(var(--line) / 0.65);
    border-radius: 0;
    background: transparent;
  }
  :global(:root[data-theme='santi020k-dark']) [data-related-project] { --related-emphasis: var(--accent); --related-project-ink: var(--project-primary-readable-dark); }
  [data-related-project][data-slot='card']:last-child { border-bottom: 1px solid hsl(var(--line) / 0.65); }
  [data-related-number] { padding-top: 0.25rem; color: hsl(var(--related-project-ink)); font-family: var(--font-code); font-size: 0.875rem; font-weight: 500; line-height: 1.5; font-variant-numeric: tabular-nums; }
  [data-related-artwork] { position: relative; display: grid; align-self: start; place-items: center; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 0.75rem; background: hsl(var(--brand-soft)); color: hsl(var(--related-emphasis)); }
  [data-related-body] { position: relative; display: grid; grid-template-rows: auto 1fr auto; align-content: start; gap: 0.875rem; min-width: 0; }
  [data-related-heading] { min-width: 0; }
  [data-related-heading] h3 { margin: 0; color: hsl(var(--ink)); font-size: 1.75rem; font-weight: 500; line-height: 1.25; letter-spacing: -0.055em; overflow-wrap: anywhere; }
  [data-related-role] { margin: 0 0 0.625rem; color: hsl(var(--related-project-ink)); font-size: 0.625rem; font-weight: 600; line-height: 1.7; letter-spacing: 0.12em; text-transform: uppercase; overflow-wrap: break-word; }
  [data-related-description] { max-width: 58ch; margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; text-wrap: pretty; overflow-wrap: break-word; }
  [data-related-footer] { margin-top: 0.25rem; }
  [data-related-action] { display: flex; align-items: center; gap: 0.875rem; min-height: 2.75rem; color: hsl(var(--related-project-ink)); font-size: 0.75rem; font-weight: 500; line-height: 1.7; }
  [data-related-arrow] { display: grid; flex-shrink: 0; place-items: center; }
  [data-related-link] { position: absolute; inset: 0; z-index: 1; border-radius: 0.75rem; }
  [data-related-link]:focus-visible { outline: 2px solid hsl(var(--related-project-ink)); outline-offset: 4px; }
  [data-related-project]:is(:hover, :focus-within) h3 { color: hsl(var(--related-project-ink)); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  @media (prefers-reduced-motion: no-preference) {
    [data-related-heading] h3 { transition: color 160ms ease; }
  }
  @container related-list (42rem <= width < 72rem) {
    [data-related-project][data-slot='card'] { grid-template-columns: clamp(12rem, 24cqi, 16rem) minmax(0, 1fr); gap: 2rem; padding: 1.75rem 0; }
    [data-related-number] { grid-area: 1 / 2; justify-self: end; align-self: start; padding-top: 0; font-size: 0.75rem; line-height: 1.7; }
    [data-related-artwork] { grid-area: 1 / 1; align-self: center; aspect-ratio: 1; }
    [data-related-body] { grid-area: 1 / 2; }
    [data-related-heading] h3 { font-size: 1.5rem; line-height: 1.3; letter-spacing: -0.045em; }
    [data-related-role] { padding-right: 2rem; }
    [data-related-description] { line-height: 1.75; }
    [data-related-action] { justify-content: space-between; font-size: 0.8125rem; }
  }
  @container related-list (width < 42rem) {
    [data-related-project][data-slot='card'] { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; padding: 1.5rem 0 1rem; }
    [data-related-number] { grid-area: 1 / 2; justify-self: end; align-self: start; padding-top: 0; font-size: 0.6875rem; line-height: 1.7; }
    [data-related-artwork] { grid-area: 1 / 1; aspect-ratio: 1; }
    [data-related-body] { display: contents; }
    [data-related-heading] { grid-area: 1 / 2; align-self: start; }
    [data-related-heading] h3 { font-size: 1.375rem; line-height: 1.3; letter-spacing: -0.045em; }
    [data-related-role] { margin-bottom: 0.5rem; padding-right: 2rem; }
    [data-related-description] { grid-column: 1 / -1; max-width: none; line-height: 1.75; }
    [data-related-footer] { grid-column: 1 / -1; margin-top: 0; }
    [data-related-action] { justify-content: space-between; font-size: 0.8125rem; }
  }
  @container related-list (width < 20rem) {
    [data-related-project][data-slot='card'] { grid-template-columns: 4.5rem minmax(0, 1fr); }
    [data-related-heading] h3 { font-size: 1.25rem; }
  }
  @container related-list (width < 16rem) {
    [data-related-project][data-slot='card'] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-related-number], [data-related-artwork] { display: none; }
    [data-related-heading] { grid-column: 1; }
    [data-related-role] { padding-right: 0; }
  }
  @container related-list (width < 14rem) {
    [data-related-arrow] { display: none; }
  }
</style>
