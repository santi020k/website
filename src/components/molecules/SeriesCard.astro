---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { localizePost } from '@/utils/content-translations'
import { getPostPath, getSeriesPath } from '@/utils/links'
import { getReadingTime } from '@/utils/reading-time'

import { Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  firstPost: CollectionEntry<'post'> | undefined
  postCount: number
  readingMinutes: number
  series: CollectionEntry<'series'>
}

const { firstPost: originalEntry, postCount, readingMinutes, series } = Astro.props
const firstPost = originalEntry ? await localizePost(originalEntry, getLocale(Astro.url.pathname)) : originalEntry
const postCountLabel = `${postCount} ${postCount === 1 ? t('collection.article7') : t('collection.articles')}`
const seriesPath = getSeriesPath(series.id)
const statusLabel = series.data.status === 'planned' ? t('collection.plannedSeries') : t('collection.activeSeries')

const exploreLabel = postCount > 0 ?
  t(postCount === 1 ? 'series.exploreArticle' : 'series.exploreArticles', { count: postCount }) :
  t('collection.exploreSeries')
---

<Card as="article" data-series-card data-series-card-has-start={firstPost ? '' : undefined}>
  <Link data-series-card-link href={localizePath(seriesPath, locale)} variant="inherit">
    <div data-series-card-meta>
      <span data-series-card-status>{statusLabel}</span>
      <span>{postCountLabel}</span>
    </div>

    <h3 lang="en">{series.data.title}</h3>
    <p lang="en">{series.data.description}</p>

    {!!series.data.focusAreas.length && (
      <ul aria-label={t('collection.focusAreas')}>
        {series.data.focusAreas.map(area => <li lang="en">{area}</li>)}
      </ul>
    )}

    <div data-series-card-footer>
      <span data-series-card-action>
        <span data-series-card-action-copy>
          <span>{exploreLabel}</span>
          {postCount > 0 && readingMinutes > 0 && (
            <span data-series-card-estimate>{t('series.readingEstimate', { minutes: readingMinutes })}</span>
          )}
        </span>
        <ArrowExchange class="size-4.5 shrink-0" direction="right" />
      </span>
    </div>
  </Link>
  {firstPost && (
    <Link data-series-card-start href={localizePath(getPostPath(firstPost.id), locale)} variant="inherit">
      <span data-series-card-start-label>{t('series.startFirstArticle')}</span>
      <span data-series-card-start-title lang={firstPost.data.contentLocale}>{firstPost.data.title}</span>
      <ArrowExchange class="size-4.5 shrink-0" />
      <span data-series-card-start-meta>
        <span>{localizeCollectionSource(locale, firstPost.data.postType)}</span>
        <span aria-hidden="true">·</span>
        <span>{t('reading.duration', { minutes: getReadingTime(firstPost.body) })}</span>
      </span>
    </Link>
  )}
</Card>

<style>
  [data-series-card][data-slot='card'] {
    --series-card-accent: hsl(var(--brand));
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    row-gap: 0;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.625rem 1.625rem 0.375rem 1.625rem;
    background: hsl(var(--surface));
    box-shadow: -0.375rem 0.375rem 0 hsl(var(--brand-soft));
    overflow: visible;
  }
  :global([data-theme='dark']) [data-series-card] { --series-card-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-series-card][data-slot='card']::before {
    display: block;
    position: absolute;
    inset-block: 1.625rem;
    inset-inline-start: -1px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--series-card-accent);
    content: '';
    pointer-events: none;
    z-index: 1;
  }
  [data-series-card] :global([data-series-card-link]) {
    container: series-card / inline-size;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem 1.5rem 1.3125rem;
    border-radius: 1.625rem 1.625rem 0 0;
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }
  [data-series-card] :global(a:focus-visible) {
    outline: 2px solid var(--series-card-accent);
    outline-offset: 5px;
  }
  [data-series-card-meta] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
  }
  [data-series-card-status] { display: inline-flex; align-items: center; gap: 0.4375rem; }
  [data-series-card-status]::before {
    content: '';
    width: 0.3125rem;
    height: 0.3125rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: hsl(var(--accent));
  }
  [data-series-card] h3 {
    margin-block: 1.5rem 0.875rem;
    color: hsl(var(--ink));
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.045em;
    text-wrap: balance;
    hyphens: manual;
    overflow-wrap: anywhere;
  }
  [data-series-card] p {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.8;
  }
  [data-series-card] ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem 0.875rem;
    margin-top: 1.125rem;
    padding: 0;
    list-style: none;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  [data-series-card-footer] {
    margin-top: auto;
    padding-top: 1.25rem;
  }
  [data-series-card-action] {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9375rem;
    border-top: 1px solid hsl(var(--line));
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.7;
  }
  [data-series-card-action-copy] { min-width: 0; }
  [data-series-card-estimate] {
    display: block;
    margin-top: 0.375rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  [data-series-card] :global([data-series-card-start]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.125rem;
    align-content: start;
    gap: 0.625rem 1.125rem;
    min-width: 0;
    padding: 1.4375rem 1.5rem 1.625rem;
    border-top: 1px solid hsl(var(--line));
    border-radius: 0 0 0.375rem 1.625rem;
    background: hsl(var(--brand-soft));
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }
  [data-series-card-start-label] {
    grid-column: 1 / -1;
    color: var(--series-card-accent);
    font-size: 0.6875rem;
    line-height: 1.8;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  [data-series-card-start-title] {
    min-width: 0;
    color: hsl(var(--ink));
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }
  [data-series-card] :global([data-series-card-start] > [data-arrow-exchange]) {
    align-self: center;
    color: var(--series-card-accent);
  }
  [data-series-card-start-meta] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    grid-column: 1 / -1;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.8;
  }
  [data-series-card] :global([data-series-card-link]:is(:hover, :focus-visible)) h3,
  [data-series-card] :global([data-series-card-start]:is(:hover, :focus-visible)) [data-series-card-start-title] {
    color: var(--series-card-accent);
  }
  [data-series-card]:not([data-series-card-has-start]) :global([data-series-card-link]) {
    grid-row: span 2;
    border-radius: inherit;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-series-card] h3, [data-series-card-start-title] { transition: color 180ms ease; }
  }
  @media (min-width: 640px) {
    [data-series-card] :global([data-series-card-link]) { padding: 1.75rem 1.75rem 1.3125rem; }
    [data-series-card] :global([data-series-card-start]) { padding-inline: 1.75rem; }
  }
  @media (max-width: 440px) {
    [data-series-card] h3 { font-size: 1.5625rem; }
  }
  @container page-section (width < 20rem) {
    [data-series-card] :global([data-series-card-link]),
    [data-series-card] :global([data-series-card-start]) { padding: 0.75rem; }
    [data-series-card] :global([data-series-card-start]) { column-gap: 0.5rem; }
    [data-series-card-start-title] { font-size: min(1.125rem, 13cqi); }
    [data-series-card] h3 { font-size: min(1.5625rem, 18cqi); }
  }
</style>
