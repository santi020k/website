---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getSeriesPath } from '@/utils/links'

import { Card, Link } from '@santi020k/lumen-astro'

interface Props {
  postCount: number
  series: CollectionEntry<'series'>
}

const { postCount, series } = Astro.props
const postCountLabel = `${postCount} ${postCount === 1 ? 'article' : 'articles'}`
const seriesPath = getSeriesPath(series.id)
const statusLabel = series.data.status === 'planned' ? 'Planned series' : 'Active series'
---

<Card as="article" data-series-card>
  <Link data-series-card-link href={seriesPath} variant="inherit">
    <div data-series-card-meta>
      <span data-series-card-status>{statusLabel}</span>
      <span>{postCountLabel}</span>
    </div>

    <h3>{series.data.title}</h3>
    <p>{series.data.description}</p>

    {!!series.data.focusAreas.length && (
      <ul aria-label="Focus areas">
        {series.data.focusAreas.map(area => <li>{area}</li>)}
      </ul>
    )}

    <div data-series-card-footer>
      <span data-series-card-action>
        <span>Explore series</span>
        <ArrowExchange class="size-4.5 shrink-0" direction="right" />
      </span>
    </div>
  </Link>
</Card>

<style>
  [data-series-card][data-slot='card'] {
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 1px solid hsl(var(--line) / 0.65);
    border-radius: 1.25rem;
    background: hsl(var(--surface));
    box-shadow: none;
    overflow: visible;
  }
  [data-series-card-link] {
    container: series-card / inline-size;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    border-radius: inherit;
    color: inherit;
    font-weight: 400;
    text-decoration: none;
  }
  [data-series-card-link]:focus-visible {
    outline: 2px solid hsl(var(--accent));
    outline-offset: 5px;
  }
  [data-series-card-meta] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
  }
  [data-series-card-status] { display: inline-flex; align-items: center; gap: 0.4375rem; }
  [data-series-card-status]::before {
    content: '';
    width: 0.3125rem;
    height: 0.3125rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: hsl(var(--accent));
  }
  [data-series-card] h3 {
    margin-block: 1.5rem 0.875rem;
    color: hsl(var(--ink));
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.045em;
    text-wrap: balance;
    hyphens: manual;
    overflow-wrap: anywhere;
  }
  [data-series-card] p {
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.8;
  }
  [data-series-card] ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem 0.875rem;
    margin-top: 1.125rem;
    padding: 0;
    list-style: none;
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  [data-series-card-footer] {
    margin-top: auto;
    padding-top: 1.625rem;
  }
  [data-series-card-action] {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9375rem;
    border-top: 1px solid hsl(var(--line));
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.7;
  }
  [data-series-card-link]:is(:hover, :focus-visible) h3 { color: hsl(var(--brand)); }
  :global([data-theme='dark']) [data-series-card-link]:is(:hover, :focus-visible) h3 { color: hsl(var(--accent)); }
  @media (prefers-reduced-motion: no-preference) {
    [data-series-card] h3 { transition: color 180ms ease; }
  }
  @media (min-width: 640px) {
    [data-series-card-link] { padding: 1.75rem; }
  }
  @media (max-width: 440px) {
    [data-series-card] h3 { font-size: 1.5625rem; }
  }
  @container page-section (width < 20rem) {
    [data-series-card-link] { padding: 0.75rem; }
    [data-series-card] h3 { font-size: min(1.5625rem, 18cqi); }
  }
</style>
