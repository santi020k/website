---
interface Props {
  kind: 'article' | 'project'
  hasCover: boolean
  wide: boolean
}

const { kind, hasCover, wide } = Astro.props
---

<div data-cover-spread-container>
  <div data-cover-spread data-has-wide-cover={hasCover && wide}>
    <header data-cover-headline><slot name="heading" /></header>
    {hasCover && (
      <div
        data-cover-art
        data-wide-cover={wide}
        data-post-cover={kind === 'article' ? true : undefined}
        data-project-cover={kind === 'project' ? true : undefined}
      >
        <slot />
      </div>
    )}
  </div>
</div>

<style>
  [data-cover-spread-container] { container: cover-spread / inline-size; }

  [data-cover-spread] {
    --cover-overlap: clamp(2.625rem, 6.5cqi, 4.375rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    --cover-tail: 25%;
    --cover-corner: 2rem;
    --cover-corner-offset: 0.5rem;
    isolation: isolate;
  }

  [data-cover-headline] {
    z-index: 1;
    grid-column: 1 / -1;
    min-width: 0;
    padding-bottom: 1.875rem;
  }

  [data-cover-spread][data-has-wide-cover='true'] [data-cover-headline] {
    grid-column: 1 / 10;
    padding-right: 1.75rem;
    margin-bottom: calc(-1 * var(--cover-overlap));
    border-bottom-right-radius: 2rem;
  }

  [data-cover-spread] [data-cover-headline] :global(h1) {
    padding-block: 0.1em;
    font-size: clamp(2rem, 6.5cqi, 4.25rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
    hyphens: manual;
    text-wrap: balance;
  }

  [data-cover-art] {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    overflow: hidden;
    border-radius: 0 2rem 2rem 0.25rem;
  }

  /* The transparent notch follows the page backdrop without an opaque title patch. */
  [data-cover-art][data-wide-cover='true'] {
    mask:
      linear-gradient(#000 0 0) bottom / 100% calc(100% - var(--cover-overlap)) no-repeat,
      linear-gradient(#000 0 0) right / var(--cover-tail) 100% no-repeat,
      radial-gradient(circle at top left, transparent calc(var(--cover-corner) - 0.5px), #000 var(--cover-corner))
        left calc(100% - var(--cover-tail) - var(--cover-corner-offset)) top calc(var(--cover-overlap) - var(--cover-corner)) /
        var(--cover-corner) var(--cover-corner) no-repeat;
  }

  [data-cover-art][data-wide-cover='false'] {
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    border-radius: 1.5rem;
  }

  @container cover-spread (width < 36.25rem) {
    [data-cover-spread] {
      --cover-overlap: 2.125rem;
      --cover-tail: 16.666667%;
      --cover-corner: 1.625rem;
      --cover-corner-offset: 0.270833rem;
    }
    [data-cover-spread][data-has-wide-cover='true'] [data-cover-headline] {
      grid-column: 1 / 11;
      padding-right: 1.375rem;
      padding-bottom: 1.5rem;
      border-bottom-right-radius: 1.625rem;
    }
    [data-cover-spread] [data-cover-headline] :global(h1) { font-size: clamp(1.875rem, 6.5cqi, 2.375rem); }
  }

  @container cover-spread (width < 23.75rem) {
    [data-cover-spread][data-has-wide-cover='true'] [data-cover-headline] {
      grid-column: 1 / -1;
      padding: 0 0 1.375rem;
      margin: 0;
      border-radius: 0;
      background: transparent;
    }
    [data-cover-spread] [data-cover-headline] :global(h1) { font-size: 1.875rem; line-height: 1.12; letter-spacing: -0.045em; }
    [data-cover-art][data-wide-cover='true'] { mask: none; }
    [data-cover-art] { border-radius: 1.375rem 0.25rem 1.375rem 0.25rem; }
  }

  @container cover-spread (width < 16rem) {
    [data-cover-spread] [data-cover-headline] :global(h1) { font-size: 1.125rem; }
  }

  @container cover-spread (width < 8rem) {
    [data-cover-spread] [data-cover-headline] :global(h1) { font-size: 1rem; }
  }

</style>
