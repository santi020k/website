---
import Button from '@santi020k/lumen-astro/components/Button'
import Empty from '@santi020k/lumen-astro/components/Empty'
import Icon from '@santi020k/lumen-astro/components/Icon'

import { getLocale, sharedTranslator } from '@/i18n'

interface Props {
  state?: 'empty' | 'idle' | 'error'
}

const { state = 'empty' } = Astro.props

const content = {
  empty: {
    title: 'shared.noResultsFound',
    description: 'shared.tryDifferentKeywordsOrCheckYour',
    icon: 'search-x',
    action: 'shared.clearSearch',
    actionIcon: 'rotate-ccw'
  },
  idle: {
    title: 'shared.startTypingToSearch',
    description: 'shared.enterAtLeast2CharactersTo',
    icon: 'search',
    action: '',
    actionIcon: 'search'
  },
  error: {
    title: 'shared.searchUnavailable',
    description: 'search.loadFailure',
    icon: 'circle-alert',
    action: 'shared.tryAgain',
    actionIcon: 'refresh-cw'
  }
} as const

const { title, description, icon, action, actionIcon } = content[state]
const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)

---

<li data-site-search-recovery-row>
  <Empty data-site-search-recovery={state}>
    <span data-site-search-recovery-icon>
      <Icon class="size-6" name={icon} />
    </span>
    <div data-site-search-recovery-copy>
      <h3 data-site-search-recovery-title>{t(title)}</h3>
      <p data-site-search-recovery-description>{t(description)}</p>
    </div>
    {action && (
      <div data-site-search-recovery-actions>
        <Button
          data-site-search-recovery-action
          data-site-search-clear={state === 'empty' ? '' : undefined}
          data-site-search-retry={state === 'error' ? '' : undefined}
          type="button"
        >
          <span data-site-search-recovery-action-content>
            <span>{t(action)}</span>
            <Icon class="size-4" name={actionIcon} />
          </span>
        </Button>
      </div>
    )}
  </Empty>
</li>

<style is:global>
  #site-search-results [data-site-search-recovery-row] { container: search-recovery / inline-size; }
  #site-search-results [data-site-search-recovery] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem;
    align-items: start;
    justify-items: stretch;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.75rem;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1.625rem 1.625rem 1.625rem;
    background: hsl(var(--brand-soft));
    color: hsl(var(--ink));
    text-align: left;
    overflow-wrap: anywhere;
  }
  #site-search-results [data-site-search-recovery-icon] { grid-column: 2; grid-row: 1; display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; color: hsl(var(--accent)); }
  #site-search-results [data-site-search-recovery="error"] [data-site-search-recovery-icon] { color: hsl(var(--danger)); }
  #site-search-results [data-site-search-recovery-copy] { grid-column: 1; grid-row: 1; min-width: 0; }
  #site-search-results [data-site-search-recovery-title] { margin: 0 0 1rem; color: hsl(var(--ink)); font-size: 1.875rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.05em; }
  #site-search-results [data-site-search-recovery-description] { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  #site-search-results [data-site-search-recovery-actions] { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid hsl(var(--line)); }
  #site-search-results [data-site-search-recovery-action] { min-width: 10rem; max-width: 100%; min-height: 2.75rem; height: auto; scroll-margin-block: 0.5rem; padding: 0.5rem 1rem; border: 1px solid hsl(var(--ink)); border-radius: 0.75rem; background: hsl(var(--ink)); color: hsl(var(--surface)); font-size: 0.75rem; font-weight: 500; line-height: 1.6; white-space: normal; transition: background-color 160ms ease; }
  #site-search-results [data-site-search-recovery-action]:hover { background: hsl(var(--ink-soft)); }
  #site-search-results [data-site-search-recovery-action-content] { display: flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 0; }

  @container search-recovery (width < 26.875rem) {
    #site-search-results [data-site-search-recovery] { gap: 1.125rem; padding: 1.375rem; }
    #site-search-results [data-site-search-recovery-title] { font-size: 1.625rem; }
  }
  @container search-recovery (width < 18.125rem) {
    #site-search-results [data-site-search-recovery] { grid-template-columns: minmax(0, 1fr); padding: 1.25rem; }
    #site-search-results [data-site-search-recovery-icon] { grid-column: 1; grid-row: 1; }
    #site-search-results [data-site-search-recovery-copy] { grid-row: 2; }
    #site-search-results [data-site-search-recovery-action] { width: 100%; min-width: 0; }
  }
  @container search-recovery (width < 13rem) {
    #site-search-results [data-site-search-recovery] { gap: 0.75rem; padding: 0.75rem; }
    #site-search-results [data-site-search-recovery-title] { font-size: 1.375rem; }
    #site-search-results [data-site-search-recovery-action-content] { gap: 0.5rem; }
    #site-search-results [data-site-search-recovery-action-content] > :last-child { display: none; }
  }
  @container site-search (height < 31.25rem) {
    #site-search-results [data-site-search-recovery] { gap: 0.75rem; padding-block: 0.875rem; }
    #site-search-results [data-site-search-recovery-title] { margin-bottom: 0.5rem; font-size: 1.375rem; }
    #site-search-results [data-site-search-recovery-actions] { padding-top: 0.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    #site-search-results [data-site-search-recovery-action] { transition: none; }
  }
</style>
