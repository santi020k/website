---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'

import Card from '@santi020k/lumen-astro/components/Card'

interface Props {
  align?: 'center' | 'left'
  description?: string | undefined
  eyebrow?: string | undefined
  id?: string
  level?: 'h1' | 'h2' | 'h3'
  linkHref?: string | undefined
  linkLabel?: string | undefined
  title: string
  variant?: 'default' | 'margin' | 'shelf'
}

const {
  align = 'left',
  description,
  eyebrow,
  id,
  level = 'h2',
  linkHref,
  linkLabel,
  title,
  variant = 'default'
} = Astro.props

const HeadingTag = level
const isShelf = variant === 'shelf'

const titleClasses = {
  h1: 'max-w-4xl text-4xl sm:text-5xl lg:text-6xl',
  h2: 'max-w-4xl text-3xl sm:text-4xl lg:text-[2.8rem]',
  h3: 'max-w-3xl text-2xl sm:text-3xl'
}[level]

const headingId = id ? `${id}-heading` : undefined
---

{variant === 'margin' &&
  (
    <div data-margin-header-container>
      <header id={id} data-section-header data-section-header-margin>
        {eyebrow && <p data-margin-header-label>{eyebrow}</p>}
        <div data-margin-header-copy>
          <HeadingTag id={headingId}>{title}</HeadingTag>
          <slot name="description">
            {description && <p data-margin-header-description>{description}</p>}
          </slot>
          {linkHref && linkLabel && (
            <ButtonLink href={linkHref} showArrow variant="inline">
              {linkLabel}
            </ButtonLink>
          )}
        </div>
      </header>
    </div>
  )}
{isShelf &&
  (
    <div data-chapter-header-container>
      <Card
        as="section"
        id={id}
        aria-labelledby={headingId}
        data-section-header
        data-section-header-shelf
        variant="unstyled"
      >
        <header data-chapter-copy>
          {eyebrow && <p data-chapter-tab>{eyebrow}</p>}
          <HeadingTag id={headingId} data-chapter-heading>{title}</HeadingTag>
          <slot name="description">
            {description && <p data-chapter-description>{description}</p>}
          </slot>
        </header>
        {linkHref && linkLabel && (
          <div data-chapter-footer>
            <ButtonLink href={linkHref} showArrow variant="inline">
              {linkLabel}
            </ButtonLink>
          </div>
        )}
      </Card>
    </div>
  )}
{variant === 'default' &&
  (
    <div
      id={id}
      data-section-header
      class:list={[
        'flex flex-col gap-5',
        align === 'center' && 'items-center text-center'
      ]}
    >
      {eyebrow && <Eyebrow className={align === 'center' ? 'justify-center' : ''} label={eyebrow} tone="brand" />}
      <div class="space-y-4">
        <HeadingTag class={`
          leading-[1.08] font-medium tracking-[-0.065em] text-balance
          ${titleClasses}
        `}
        >{title}
        </HeadingTag>
        <slot name="description">
          {description && (
            <p
              class:list={[
                'max-w-2xl section-copy',
                align === 'center' && 'mx-auto'
              ]}
            >
              {description}
            </p>
          )}
        </slot>
      </div>
      {linkHref && linkLabel && (
        <ButtonLink
          className={align === 'center' ? 'self-center' : 'self-start'}
          href={linkHref}
          showArrow
          variant="inline"
        >
          {linkLabel}
        </ButtonLink>
      )}
    </div>
  )}

<style>
  [data-margin-header-container] { container: margin-header / inline-size; }
  [data-section-header-margin] {
    --margin-emphasis: hsl(var(--brand));
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.625rem;
    align-items: start;
  }
  [data-section-header-margin]:not(:has(> [data-margin-header-label])) { grid-template-columns: minmax(0, 1fr); }
  :global([data-theme='santi020k-dark']) [data-section-header-margin] { --margin-emphasis: hsl(var(--accent)); }
  [data-margin-header-label] {
    max-width: 100%;
    margin: 0;
    padding-top: 0.4375rem;
    color: var(--margin-emphasis);
    font-size: 0.75rem;
    line-height: 1.7;
    font-weight: 500;
    overflow-wrap: normal;
  }
  [data-margin-header-copy] {
    position: relative;
    min-width: 0;
    padding-inline-start: 1.75rem;
    border-inline-start: 1px solid hsl(var(--line));
  }
  [data-margin-header-copy]::before {
    content: '';
    position: absolute;
    inset-inline-start: -1px;
    top: 0;
    width: 2px;
    height: 3.375rem;
    background: var(--margin-emphasis);
  }
  [data-margin-header-copy] :is(h1, h2, h3) {
    max-width: 20ch;
    margin: 0;
    color: hsl(var(--ink));
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  [data-margin-header-description] {
    max-width: 46ch;
    margin: 1.25rem 0 0;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.9;
  }
  [data-margin-header-copy] :global([data-slot='button-link']) {
    max-width: 100%;
    min-height: 2.75rem;
    margin-top: 1.5rem;
    gap: 1.75rem;
    padding: 0;
    color: var(--margin-emphasis);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  [data-margin-header-copy] :global([data-slot='button-link']:hover) { color: hsl(var(--ink)); }
  @container margin-header (width < 35rem) {
    [data-section-header-margin] { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    [data-margin-header-label] { max-width: none; padding-top: 0; }
    [data-margin-header-copy] { padding-inline-start: 1.25rem; }
    [data-margin-header-copy] :is(h1, h2, h3) { font-size: 1.875rem; }
  }
  @container margin-header (width < 18rem) {
    [data-margin-header-copy] { padding-inline-start: 0.625rem; }
    [data-margin-header-copy] :is(h1, h2, h3) { font-size: 1.5rem; }
    [data-margin-header-copy] :global([data-slot='button-link']) { gap: 0.75rem; }
  }
  [data-chapter-header-container] { container: chapter-header / inline-size; }
  [data-section-header-shelf][data-slot='card'] {
    --chapter-emphasis: hsl(var(--brand));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem 3rem;
    padding: 1.5rem 0 0;
    border: 0;
    border-top: 1px solid hsl(var(--line) / 0.65);
    border-radius: 0;
    background: transparent;
    color: hsl(var(--ink));
  }
  :global([data-theme='santi020k-dark']) [data-section-header-shelf] { --chapter-emphasis: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink))); }
  [data-chapter-tab] {
    margin: 0;
    color: var(--chapter-emphasis);
    font-size: 0.6875rem;
    line-height: 1.7;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  [data-section-header-shelf] [data-chapter-heading] {
    max-width: 25ch;
    margin: 0.75rem 0;
    font-size: 2.25rem;
    line-height: 1.15;
    letter-spacing: -0.045em;
    font-weight: 500;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: manual;
  }
  [data-chapter-description] {
    max-width: 45ch;
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.85;
  }
  [data-chapter-footer] {
    display: flex;
    justify-content: flex-end;
    padding-bottom: 0.125rem;
  }
  [data-chapter-footer] :global([data-slot='button-link']) {
    gap: 1.25rem;
    max-width: 100%;
    justify-content: space-between;
    padding: 0;
    color: var(--chapter-emphasis);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  [data-chapter-footer] :global([data-slot='button-link']:hover) { color: hsl(var(--ink)); }
  @container chapter-header (width < 44rem) {
    [data-section-header-shelf][data-slot='card'] { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    [data-chapter-footer] { justify-content: flex-start; }
  }
  @container chapter-header (width < 27.5rem) {
    [data-section-header-shelf] [data-chapter-heading] { font-size: 1.75rem; line-height: 1.25; }
  }
  @container chapter-header (width < 16rem) {
    [data-section-header-shelf] [data-chapter-heading] { font-size: 1rem; line-height: 1.5; }
    [data-chapter-footer] :global([data-slot='button-link']) { padding-inline: 0; }
    [data-chapter-footer] :global(.site-action-arrow) { display: none; }
  }
</style>
