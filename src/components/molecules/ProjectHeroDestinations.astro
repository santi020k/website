---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getProjectPrimaryDestination } from '@/utils/project-destinations'

import { ButtonLink, Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  hasProductPreviews: boolean
  parentPage: { name: string, url: string }
  project: CollectionEntry<'project'>
}

const { hasProductPreviews, parentPage, project } = Astro.props
const { githubUrl, liveDemoUrl, previews } = project.data
const destination = getProjectPrimaryDestination(project.data)
---

<nav aria-label={t('collection.projectDestinations')} data-project-destinations id="project-destinations">
  {destination && (
    <Card data-destination-brief variant="unstyled">
      <div data-destination-copy>
        <p data-destination-context>{localizeCollectionSource(locale, destination.context)}</p>
        <p data-destination-name>{destination.name}</p>
      </div>
      <ButtonLink class="btn-primary" data-destination-primary href={destination.href} newTab variant="unstyled">
        <span>{localizeCollectionSource(locale, destination.action)}</span>
        <ArrowExchange direction="up-right" size="sm" />
      </ButtonLink>
    </Card>
  )}
  <div data-destination-links>
    {hasProductPreviews && (
      <Link href="#inside-the-product" variant="inherit">
        <span>{localizeCollectionSource(locale, previews?.linkLabel ?? 'View product previews')}</span>
        <ArrowExchange direction="down" size="sm" />
      </Link>
    )}
    {liveDemoUrl && githubUrl && (
      <Link href={githubUrl} newTab variant="inherit">
        <span>{t('collection.openRepository')}</span>
        <ArrowExchange direction="up-right" size="sm" />
      </Link>
    )}
    <Link href={localizePath(parentPage.url, locale)} variant="inherit">
      <span>{t('project.browse')} {localizeCollectionSource(locale, parentPage.name).toLocaleLowerCase(locale)}</span>
      <ArrowExchange direction="right" size="sm" />
    </Link>
  </div>
</nav>

<style>
  [data-project-destinations] { container: project-destinations / inline-size; }
  [data-destination-brief][data-slot='card'] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.375rem 1.5rem;
    background: hsl(var(--brand-soft) / 0.6);
    padding: 1.5rem;
  }
  [data-destination-copy] { min-width: 0; }
  [data-destination-context] { margin: 0 0 0.25rem; color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.6; }
  [data-destination-name] { margin: 0; color: hsl(var(--ink)); font: 500 1.375rem/1.4 var(--font-sans); letter-spacing: -0.03em; overflow-wrap: anywhere; }
  [data-destination-primary][data-slot='button-link'] {
    display: inline-flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 1.125rem;
    min-height: 3.125rem;
    max-width: 100%;
    border-radius: 1.125rem 1.125rem 0.3125rem 1.125rem;
    padding: 0.875rem 1.125rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  [data-destination-primary] > span { min-width: 0; overflow-wrap: anywhere; }
  [data-destination-primary] :global(.ui-icon), [data-destination-links] :global(.ui-icon) { flex-shrink: 0; }
  [data-destination-links] { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.375rem; }
  [data-destination-brief] + [data-destination-links] { margin-top: 1rem; }
  [data-destination-links] :global(a) { display: inline-flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; max-width: 100%; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.6; text-decoration: none; }
  [data-destination-links] span { min-width: 0; overflow-wrap: anywhere; }
  [data-destination-links] :global(a:is(:hover, :focus-visible)) { color: hsl(var(--ink)); text-decoration: underline; text-underline-offset: 0.25rem; }
  @container project-destinations (width < 35rem) {
    [data-destination-brief][data-slot='card'] { padding: 1.25rem; }
  }
  @container project-destinations (width < 18rem) {
    [data-destination-brief][data-slot='card'] { padding: 1rem; }
    [data-destination-primary][data-slot='button-link'] { padding-inline: 0.875rem; gap: 0.625rem; }
  }
</style>
