---
import { Image } from 'astro:assets'

import type { WebmentionsChildren } from '@/types/webmentions'
import { getFormattedDate } from '@/utils/date'

import { Icon } from '@santi020k/lumen-astro'

interface Props {
  mentions: WebmentionsChildren[]
}

const { mentions } = Astro.props
const likes = mentions.filter(m => m['wm-property'] === 'like-of')

const replies = mentions.filter(
  m => m['wm-property'] === 'in-reply-to' || m['wm-property'] === 'mention-of'
)

const authorPhoto = (entry: WebmentionsChildren): string | undefined => entry.author?.photo ?? undefined

const replyText = (entry: WebmentionsChildren): string => {
  const raw = entry.content?.text ?? entry.summary?.value ?? ''

  return raw.trim().slice(0, 2000)
}

// Webmention timestamps arrive in loose formats, so `datetime` gets the
// normalized ISO form rather than the raw string.
const publishedDate = (entry: WebmentionsChildren): { datetime: string, label: string } | undefined => {
  const raw = entry.published ?? entry['wm-received']

  if (!raw) return undefined

  const d = new Date(raw)

  if (Number.isNaN(d.getTime())) return undefined

  return { datetime: d.toISOString(), label: getFormattedDate(d) }
}

const showSection = likes.length > 0 || replies.length > 0
---

{
  showSection && (
    <section aria-label="Webmentions" class="space-y-8 pt-8">
      {likes.length > 0 && (
        <div class="space-y-3">
          <h2 class="section-label">
            <Icon
              class="mr-1 inline size-4 align-text-bottom"
              name="heart"
            />
            {likes.length} {likes.length === 1 ? 'like' : 'likes'} across the IndieWeb
          </h2>
          <ul class="flex flex-wrap gap-2">
            {likes.map(entry => {
              const photo = authorPhoto(entry)
              const name = entry.author?.name ?? 'Someone'
              const href = entry.author?.url ?? entry['wm-source']

              return (
                <li>
                  <a
                    aria-label={name}
                    class="
                      inline-flex size-11 overflow-hidden rounded-full border
                      border-line/60 bg-surface-muted transition
                      hover:border-brand/40 hover:ring-2 hover:ring-brand/15
                      motion-reduce:transition-none
                    "
                    href={href}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {photo ?
                      (
                        <Image alt="" class="size-full object-cover" height={44} loading="lazy" src={photo} width={44} />
                      ) :
                      (
                        <span class="
                          flex size-full items-center justify-center text-xs
                          font-semibold text-ink-muted
                        "
                        >
                          {name.slice(0, 1).toUpperCase()}
                        </span>
                      )}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      )}

      {replies.length > 0 && (
        <div class="space-y-4">
          <h2 class="section-label">
            <Icon
              class="mr-1 inline size-4 align-text-bottom"
              name="message-circle"
            />
            Replies &amp; mentions
          </h2>
          <ul class="space-y-4">
            {replies.map(entry => {
              const name = entry.author?.name ?? 'Anonymous'
              const authorUrl = entry.author?.url
              const source = entry['wm-source']
              const text = replyText(entry)
              const date = publishedDate(entry)

              return (
                <li
                  class="
                    rounded-2xl border border-line/55 bg-surface-muted/45 p-4
                    sm:p-5
                  "
                >
                  <div class="
                    flex flex-wrap items-baseline justify-between gap-2
                  "
                  >
                    <p class="font-medium text-ink">
                      {authorUrl ?
                        (
                          <a
                            class="
                              text-brand
                              hover:underline
                            "
                            href={authorUrl}
                            rel="noopener noreferrer"
                            target="_blank"
                          >
                            {name}
                          </a>
                        ) :
                        (
                          <span>{name}</span>
                        )}
                    </p>
                    {date && <time class="text-xs text-ink-muted" datetime={date.datetime}>{date.label}</time>}
                  </div>
                  {text && <p class="mt-2 text-sm/6 text-ink-soft">{text}</p>}
                  <p class="mt-3">
                    <a
                      class="
                        inline-flex min-h-11 items-center gap-1 text-xs
                        font-medium text-brand
                        hover:underline
                      "
                      href={source}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      View original
                      <Icon class="size-3.5" name="external-link" />
                    </a>
                  </p>
                </li>
              )
            })}
          </ul>
        </div>
      )}
    </section>
  )
}
