---
import { Image, Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getFormattedDate } from '@/utils/date'
import { getPortfolioPath } from '@/utils/links'

interface Props {
  project: CollectionEntry<'project'>
  accentTone?: 'brand' | 'accent'
}

const { project, accentTone = 'brand' } = Astro.props
const isActive = !project.data.endingDate
const dateOptions = { day: undefined, month: 'short' as const, year: 'numeric' as const }
const startDate = getFormattedDate(project.data.startingDate, dateOptions)

const endDate = isActive ?
  'Present' :
  project.data.endingDate ? getFormattedDate(project.data.endingDate, dateOptions) : undefined

const dateRange = `${startDate} – ${endDate}`
const projectLink = getPortfolioPath(project.id)
const coverImage = project.data.coverImage
const bgImage = coverImage?.vertical ?? coverImage?.src
const isAccent = accentTone === 'accent'
const cardAccentVar = isAccent ? 'var(--accent)' : 'var(--brand)'
const accentHoverClass = isAccent ? 'group-hover:text-accent' : 'group-hover:text-brand'
const accentTextClass = isAccent ? 'text-accent/75' : 'text-brand/75'
const logoImage = coverImage?.logo

type LogoAspect = 'square' | 'tall' | 'wide'

type LogoSurface = 'dark' | 'light' | 'neutral'

const logoAspect: LogoAspect = coverImage?.logoAspect ?? 'square'
const logoSurface: LogoSurface = coverImage?.logoSurface ?? 'neutral'

const logoBoxClass = {
  square: 'size-20 p-1.5',
  tall: 'h-24 w-20 p-2.5',
  wide: 'h-16 w-40 px-4 py-3'
} satisfies Record<LogoAspect, string>
---

<a
  href={projectLink}
  class="
    group block h-full rounded-[1.75rem]
    focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:outline-none
  "
>
  <article
    class="
      relative h-110 overflow-hidden rounded-[1.75rem]
      sm:h-108
    "
    data-project-card
    style={`--card-accent: ${cardAccentVar};`}
  >

    {/* ── Background media: brand wash + ghosted cover texture ───── */}
    <div
      aria-hidden="true"
      class="absolute inset-0"
      data-card-bg-base
    />
    {bgImage && (
      <Picture
        alt=""
        aria-hidden="true"
        class="absolute inset-0 size-full object-cover"
        data-card-bg
        formats={['avif', 'webp']}
        height={800}
        loading="lazy"
        sizes="(min-width: 1024px) 50vw, 100vw"
        src={bgImage}
        width={600}
        widths={[400, 600, 800]}
      />
    )}
    <div
      aria-hidden="true"
      class="absolute inset-0"
      data-card-bg-overlay
    />

    {/* ── Logo/Brand area ─────────────────────────────────────────── */}
    <div class="
      absolute inset-x-0 top-0 z-10 flex h-[52%] -translate-y-1 items-center
      justify-center
    "
    >
      {logoImage ?
        (
          <div
            class:list={[
              'flex items-center justify-center overflow-hidden rounded-2xl',
              logoBoxClass[logoAspect]
            ]}
            data-card-logo
            data-logo-aspect={logoAspect}
            data-logo-surface={logoSurface}
          >
            <Image
              alt={`${project.data.title} logo`}
              class="size-full object-contain"
              data-card-logo-img
              loading="lazy"
              src={logoImage}
            />
          </div>
        ) :
        (
          <div
            class="
              flex size-20 items-center justify-center rounded-2xl text-3xl
              font-bold text-white
            "
            data-card-logo-fallback
          >
            {project.data.title.charAt(0).toUpperCase()}
          </div>
        )}
    </div>

    {/* Progressive darkening scrim */}
    <div
      aria-hidden="true"
      class="absolute inset-0"
      data-card-scrim
    />

    {/* Ambient animated tint — always present, subtle */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      data-card-ambient
    />

    {/* Accent hover tint */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-0"
      data-card-tint
    />

    {/* Specular top-edge highlight — light catching the rim of the glass */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 z-20 h-px"
      data-card-rim
    />

    {/* ── Glass panel ───────────────────────────────────────────── */}
    <div class="absolute inset-x-0 bottom-0 z-10" data-card-panel>

      {/* Status + date header */}
      <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3.5">
        {isActive ?
          (
            <span
              class="inline-flex items-center gap-1.5 text-xs font-semibold"
              data-card-status
              style="color: hsl(var(--card-accent));"
            >
              <span
                aria-hidden="true"
                class="
                  inline-block size-1.5 rounded-full
                  motion-safe:animate-pulse
                "
                style="background: hsl(var(--card-accent));"
              />
              Active
            </span>
          ) :
          (
            <span
              class="
                inline-flex items-center text-xs font-medium text-ink-muted
                dark:text-white/70
              "
              data-card-status
            >
              Completed
            </span>
          )}
        <span class="
          text-xs text-ink-muted tabular-nums
          dark:text-white/55
        "
        >
          {dateRange}
        </span>
      </div>

      {/* Separator */}
      <div
        aria-hidden="true"
        class="mx-5 h-px"
        data-card-separator
      />

      {/* Title + description + tags */}
      <div class="space-y-3 px-5 pt-3.5 pb-5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 space-y-1">
            <h3
              class:list={[`
                text-base/snug font-semibold text-ink
                dark:text-white
              `, accentHoverClass]}
              data-card-title
            >
              {project.data.title}
            </h3>
            <p class:list={['text-xs font-medium', accentTextClass]}>
              {project.data.role ?? 'Engineering'}
            </p>
          </div>
          <svg
            aria-hidden="true"
            class="
              mt-0.5 size-4 shrink-0 -translate-x-1.5 translate-y-0.5
              text-ink-muted opacity-0
              dark:text-white/45
            "
            data-card-arrow
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </div>

        <p class="
          line-clamp-2 text-sm/relaxed text-ink-soft
          dark:text-white/65
        "
        >
          {project.data.description}
        </p>

        <div
          class="
            flex max-h-[3.1rem] min-h-[3.1rem] flex-wrap gap-1.5 overflow-hidden
            text-[0.66rem]/none
          "
        >
          {project.data.technologies.slice(0, 5).map(tech => (
            <span
              class="
                inline-flex shrink-0 items-center rounded-full border
                border-line/60 bg-surface-muted/72 px-1.5 py-1 whitespace-nowrap
                text-ink-muted
                dark:border-white/10 dark:bg-white/6 dark:text-white/62
              "
              data-card-tag
            >
              {tech}
            </span>
          ))}
          {project.data.technologies.length > 5 && (
            <span
              class="
                inline-flex shrink-0 items-center rounded-full border
                border-line/50 bg-surface-muted/58 px-1.5 py-1 whitespace-nowrap
                text-ink-muted/80
                dark:border-white/8 dark:bg-white/4 dark:text-white/42
              "
            >
              +{project.data.technologies.length - 5}
            </span>
          )}
        </div>
      </div>
    </div>
  </article>
</a>

<style>
  [data-project-card] {
    border: 1px solid hsl(var(--line) / 0.58);
    background: hsl(var(--surface) / 0.72);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.72),
      inset 1px 0 0 hsl(0 0% 100% / 0.38),
      0 14px 34px hsl(230 30% 8% / 0.08),
      0 4px 12px hsl(230 30% 8% / 0.045);
  }

  :global(:root[data-theme='dark']) [data-project-card] {
    border-color: hsl(0 0% 100% / 0.13);
    background: transparent;
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.18),
      inset 1px 0 0 hsl(0 0% 100% / 0.07),
      0 12px 32px hsl(230 30% 8% / 0.14),
      0 4px 12px hsl(230 30% 8% / 0.1);
  }

  /* Background: stable brand wash with the cover used only as texture */
  [data-card-bg-base] {
    background:
      radial-gradient(ellipse 95% 68% at 50% 2%, hsl(var(--card-accent) / 0.32), transparent 62%),
      radial-gradient(ellipse 74% 62% at 12% 20%, hsl(var(--card-accent) / 0.18), transparent 68%),
      radial-gradient(ellipse 70% 58% at 88% 78%, hsl(var(--card-accent) / 0.14), transparent 68%),
      linear-gradient(180deg, hsl(var(--brand-soft) / 0.95) 0%, hsl(var(--surface-muted) / 0.9) 60%, hsl(var(--surface) / 0.98) 100%);
  }

  [data-card-bg] {
    opacity: 0.28;
    filter: blur(1px) saturate(1.05) contrast(1.02) brightness(0.96);
    mix-blend-mode: multiply;
    transform: scale(1.03);
    mask-image: linear-gradient(to bottom, hsl(0 0% 0%) 0%, hsl(0 0% 0% / 0.72) 45%, transparent 82%);
    -webkit-mask-image: linear-gradient(to bottom, hsl(0 0% 0%) 0%, hsl(0 0% 0% / 0.72) 45%, transparent 82%);
  }

  [data-card-bg-overlay] {
    background:
      linear-gradient(180deg, hsl(0 0% 100% / 0.12) 0%, transparent 18%),
      linear-gradient(180deg, hsl(var(--surface) / 0) 0%, hsl(var(--surface) / 0.3) 56%, hsl(var(--surface) / 0.86) 100%);
  }

  [data-card-scrim] {
    background: linear-gradient(
      to bottom,
      hsl(var(--surface) / 0) 10%,
      hsl(var(--surface) / 0.12) 46%,
      hsl(var(--surface) / 0.78) 100%
    );
  }

  [data-card-rim] {
    background: linear-gradient(
      90deg,
      transparent 8%,
      hsl(0 0% 100% / 0.6) 28%,
      hsl(0 0% 100% / 0.78) 50%,
      hsl(0 0% 100% / 0.6) 72%,
      transparent 92%
    );
  }

  [data-card-separator] {
    background: linear-gradient(
      90deg,
      transparent,
      hsl(var(--line) / 0.72) 20%,
      hsl(var(--line) / 0.72) 80%,
      transparent
    );
  }

  :global(:root[data-theme='dark']) [data-card-bg-base] {
    background:
      radial-gradient(ellipse 95% 68% at 50% 2%, hsl(var(--card-accent) / 0.2), transparent 62%),
      radial-gradient(ellipse 74% 62% at 12% 20%, hsl(var(--card-accent) / 0.1), transparent 68%),
      radial-gradient(ellipse 70% 58% at 88% 78%, hsl(var(--card-accent) / 0.08), transparent 68%),
      linear-gradient(180deg, hsl(260 32% 10%) 0%, hsl(260 38% 5%) 72%, hsl(260 42% 3%) 100%);
  }

  :global(:root[data-theme='dark']) [data-card-bg] {
    opacity: 0.11;
    filter: blur(1.25px) saturate(0.7) contrast(0.88) brightness(1.1);
    mix-blend-mode: screen;
  }

  :global(:root[data-theme='dark']) [data-card-bg-overlay] {
    background:
      linear-gradient(180deg, hsl(0 0% 100% / 0.08) 0%, transparent 18%),
      linear-gradient(180deg, hsl(260 40% 5% / 0.02) 0%, hsl(260 45% 4% / 0.5) 58%, hsl(260 45% 3% / 0.86) 100%);
  }

  :global(:root[data-theme='dark']) [data-card-scrim] {
    background: linear-gradient(
      to bottom,
      hsl(0 0% 0% / 0) 10%,
      hsl(0 0% 0% / 0.14) 48%,
      hsl(0 0% 0% / 0.52) 100%
    );
  }

  :global(:root[data-theme='dark']) [data-card-rim] {
    background: linear-gradient(
      90deg,
      transparent 8%,
      hsl(0 0% 100% / 0.4) 28%,
      hsl(0 0% 100% / 0.56) 50%,
      hsl(0 0% 100% / 0.4) 72%,
      transparent 92%
    );
  }

  :global(:root[data-theme='dark']) [data-card-separator] {
    background: linear-gradient(
      90deg,
      transparent,
      hsl(0 0% 100% / 0.1) 20%,
      hsl(0 0% 100% / 0.1) 80%,
      transparent
    );
  }

  /* Logo/Brand mark styling */
  [data-card-logo] {
    position: relative;
    isolation: isolate;
    background: linear-gradient(
      135deg,
      hsl(var(--surface) / 0.88) 0%,
      hsl(var(--surface-muted) / 0.72) 100%
    );
    border: 1px solid hsl(var(--card-accent) / 0.38);
    box-shadow:
      0 14px 36px hsl(230 30% 8% / 0.14),
      0 4px 16px hsl(var(--card-accent) / 0.14),
      inset 0 1px 0 hsl(0 0% 100% / 0.55);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  [data-logo-surface='dark'] {
    background: linear-gradient(
      135deg,
      hsl(260 32% 13% / 0.96) 0%,
      hsl(260 45% 8% / 0.9) 100%
    );
  }

  [data-logo-surface='light'] {
    background: linear-gradient(
      135deg,
      hsl(0 0% 100% / 0.9) 0%,
      hsl(264 48% 93% / 0.82) 100%
    );
    box-shadow:
      0 8px 32px hsl(0 0% 0% / 0.18),
      inset 0 1px 0 hsl(0 0% 100% / 0.52);
  }

  [data-card-logo-img] {
    filter:
      drop-shadow(0 1px 1px hsl(0 0% 100% / 0.12))
      drop-shadow(0 3px 7px hsl(260 45% 10% / 0.2));
  }

  [data-logo-surface='light'] [data-card-logo-img] {
    filter: drop-shadow(0 3px 7px hsl(260 45% 10% / 0.24));
  }

  [data-card-logo-fallback] {
    background: linear-gradient(
      135deg,
      hsl(var(--card-accent) / 0.25) 0%,
      hsl(var(--card-accent) / 0.15) 100%
    );
    border: 1px solid hsl(var(--card-accent) / 0.3);
    box-shadow:
      0 8px 32px hsl(0 0% 0% / 0.2),
      inset 0 1px 0 hsl(0 0% 100% / 0.1);
    text-shadow: 0 2px 4px hsl(0 0% 0% / 0.3);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .group:hover [data-card-logo] {
      transform: translateY(-4px) scale(1.05);
      box-shadow:
        0 12px 40px hsl(var(--card-accent) / 0.15),
        0 8px 32px hsl(0 0% 0% / 0.25),
        inset 0 1px 0 hsl(0 0% 100% / 0.15);
    }

    .group:hover [data-card-logo-fallback] {
      transform: translateY(-4px) scale(1.05);
      background: linear-gradient(
        135deg,
        hsl(var(--card-accent) / 0.35) 0%,
        hsl(var(--card-accent) / 0.25) 100%
      );
      box-shadow:
        0 12px 40px hsl(var(--card-accent) / 0.15),
        0 8px 32px hsl(0 0% 0% / 0.25),
        inset 0 1px 0 hsl(0 0% 100% / 0.15);
    }
  }

  [data-card-panel] {
    min-height: 55%;
    background: linear-gradient(
      180deg,
      hsl(var(--surface) / 0) 0%,
      hsl(var(--surface) / 0.5) 28%,
      hsl(var(--surface) / 0.95) 100%
    );
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
  }

  :global(:root[data-theme='dark']) [data-card-panel] {
    background: linear-gradient(
      180deg,
      hsl(0 0% 0% / 0) 0%,
      hsl(0 0% 0% / 0.42) 28%,
      hsl(0 0% 0% / 0.70) 100%
    );
  }

  /* SVG noise texture overlay — applied via the ambient layer */
  [data-card-ambient] {
    opacity: 0.22;
  }

  [data-card-ambient]::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    pointer-events: none;
  }

  [data-card-tint] {
    background: radial-gradient(ellipse 80% 60% at 70% 20%, color-mix(in srgb, hsl(var(--card-accent)) 22%, transparent), transparent 65%);
  }

  @keyframes card-shimmer {
    from { left: -65%; }
    to { left: 130%; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-project-card] {
      transition:
        border-color 0.2s ease,
        background-color 0.2s ease;
    }

    [data-project-card]::after {
      display: none;
    }

    [data-card-panel] {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-project-card] {
      transition:
        transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.3s ease;
    }

    [data-project-card]:hover {
      transform: translateY(-5px);
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 34%, hsl(var(--line) / 0.62));
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.76),
        inset 1px 0 0 hsl(0 0% 100% / 0.42),
        0 0 0 1px color-mix(in srgb, hsl(var(--card-accent)) 20%, transparent),
        0 24px 56px hsl(230 30% 8% / 0.12),
        0 8px 24px color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent);
    }

    :global(:root[data-theme='dark']) [data-project-card]:hover {
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 32%, hsl(0 0% 100% / 0.14));
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.22),
        inset 1px 0 0 hsl(0 0% 100% / 0.09),
        0 0 0 1px color-mix(in srgb, hsl(var(--card-accent)) 20%, transparent),
        0 24px 56px hsl(230 30% 8% / 0.22),
        0 8px 24px color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent);
    }

    /* Diagonal shimmer sweep on hover */
    [data-project-card]::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -65%;
      width: 35%;
      background: linear-gradient(
        90deg,
        transparent,
        hsl(0 0% 100% / 0.04) 40%,
        hsl(0 0% 100% / 0.07) 50%,
        hsl(0 0% 100% / 0.04) 60%,
        transparent
      );
      transform: skewX(-10deg);
      z-index: 9;
      pointer-events: none;
    }

    .group:hover [data-project-card]::after {
      animation: card-shimmer 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    [data-card-panel] {
      transition: background 0.3s ease;
    }

    [data-card-bg] {
      transition:
        opacity 0.45s ease,
        transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-card-bg] {
      opacity: 0.3;
      transform: scale(1.06);
    }

    .group:hover [data-card-panel] {
      background: linear-gradient(
        180deg,
        hsl(var(--surface) / 0) 0%,
        hsl(var(--surface) / 0.56) 28%,
        hsl(var(--surface) / 0.98) 100%
      );
    }

    :global(:root[data-theme='dark']) .group:hover [data-card-panel] {
      background: linear-gradient(
        180deg,
        hsl(0 0% 0% / 0) 0%,
        hsl(0 0% 0% / 0.48) 28%,
        hsl(0 0% 0% / 0.76) 100%
      );
    }

    [data-card-tint] {
      transition: opacity 0.45s ease;
    }
    .group:hover [data-card-tint] { opacity: 1; }

    [data-card-arrow] {
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .group:hover [data-card-arrow] {
      opacity: 1;
      transform: translate(0, 0);
    }

    [data-card-title] { transition: color 0.2s ease; }

    [data-card-tag] {
      transition: color 0.25s ease;
    }
    .group:hover [data-card-tag] {
      color: color-mix(in srgb, hsl(var(--card-accent)) 84%, hsl(var(--ink)));
    }

    :global(:root[data-theme='dark']) .group:hover [data-card-tag] {
      color: color-mix(in srgb, hsl(var(--card-accent)) 70%, white);
    }
  }
</style>
