---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'

interface Props {
  project: CollectionEntry<'project'>
  accentTone?: 'brand' | 'accent'
}

const { project } = Astro.props
const isActive = !project.data.endingDate
const startDate = project.data.startingDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
const endDate = isActive ? 'Present' : project.data.endingDate?.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
const dateRange = `${startDate} – ${endDate}`
const projectLink = getPortfolioPath(project.id)

const accentHoverClass = 'group-hover:text-brand'
const accentTextClass = 'text-brand'
const cardAccentVar = 'var(--brand)'
---

<a href={projectLink} class:list={["group block h-full focus-visible:outline-none focus-visible:ring-2 rounded-[1.75rem] focus-visible:ring-brand/50"]}>
  <article
    class="h-full flex flex-col overflow-hidden"
    data-project-card
    style={`--card-accent: ${cardAccentVar};`}
  >
    {/* Glass layers container */}
    <div aria-hidden="true" class="absolute inset-0 z-0" data-glass-base>
      {/* Base glass gradient */}
      <div class="absolute inset-0 rounded-[1.75rem]" style="background: linear-gradient(165deg, hsl(var(--surface) / 0.75) 0%, hsl(var(--surface-muted) / 0.55) 50%, hsl(var(--surface) / 0.68) 100%);" />
      {/* Subtle noise texture overlay */}
      <div class="absolute inset-0 rounded-[1.75rem] opacity-[0.015]" style="background: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');" />
    </div>

    {/* Border layer */}
    <div aria-hidden="true" class="absolute inset-0 z-0 rounded-[1.75rem] border border-line/38" data-glass-border />

    {/* Top accent line */}
    <div
      aria-hidden="true"
      class="absolute top-0 inset-x-0 h-px z-20 opacity-40"
      data-card-accent-line
      style="background: linear-gradient(90deg, transparent 5%, color-mix(in srgb, hsl(var(--card-accent)) 70%, transparent) 35%, color-mix(in srgb, hsl(var(--brand)) 40%, transparent) 65%, transparent 95%);"
    />

    {/* Ambient glow layer — top area */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-0 right-0 h-32 z-10 opacity-60"
      data-glass-ambient
      style="background: radial-gradient(ellipse 80% 60% at 30% 0%, color-mix(in srgb, hsl(var(--card-accent)) 8%, transparent) 0%, transparent 70%);"
    />

    {/* Hover glow — top-right corner */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 right-0 h-48 w-48 z-10 opacity-0"
      data-card-glow
      style="background: radial-gradient(circle at top right, color-mix(in srgb, hsl(var(--card-accent)) 16%, transparent) 0%, transparent 70%);"
    />

    {project.data.coverImage?.src ? (
      <div class="relative aspect-[16/10] overflow-hidden shrink-0">
        <Image
          alt={project.data.coverImage.alt || project.data.title}
          class="h-full w-full object-cover"
          data-card-img
          src={project.data.coverImage.src}
          width={600}
          height={375}
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-canvas/85 via-canvas/20 to-transparent" />
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 opacity-0"
          data-card-img-tint
          style="background: linear-gradient(180deg, color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent) 0%, transparent 60%);"
        />
      </div>
    ) : (
      <div
        class="relative aspect-[16/7] overflow-hidden shrink-0"
        aria-hidden="true"
      >
        <div class="absolute inset-0 grid-fade opacity-30 dark:opacity-40" />
        <div
          class="absolute inset-0 opacity-60"
          data-card-no-img-glow
          style="background: radial-gradient(ellipse at 70% 50%, color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent) 0%, transparent 65%);"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-surface/90 via-transparent to-transparent" />
      </div>
    )}

    {/* Badge + date row — always outside image so always visible */}
    <div class="flex items-center justify-between gap-2 px-4 pt-3">
      {isActive ? (
        <span
          class="flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full border backdrop-blur-sm shadow-[inset_0_1px_0_hsl(0_0%_100%/0.12)]"
          style="background: hsl(var(--brand-soft) / 0.65); color: hsl(var(--card-accent)); border-color: color-mix(in srgb, hsl(var(--card-accent)) 28%, transparent);"
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-full motion-safe:animate-pulse"
            style="background: hsl(var(--card-accent));"
            aria-hidden="true"
          />
          Active
        </span>
      ) : (
        <span class="inline-flex items-center text-xs font-medium px-2.5 py-1 rounded-full bg-surface/50 backdrop-blur-sm text-ink-muted border border-line/28 shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)]">
          Completed
        </span>
      )}
      <span class="text-xs text-ink-muted tabular-nums">
        {dateRange}
      </span>
    </div>

    {/* Content body */}
    <div class="relative z-20 px-5 pt-2 pb-5 flex flex-col gap-3 flex-1" data-card-content>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h3 class:list={['text-lg font-semibold text-ink leading-snug', accentHoverClass]} data-card-title>
            {project.data.title}
          </h3>
          <p class:list={['text-xs font-semibold mt-0.5', accentTextClass]}>
            {project.data.role ?? 'Engineering'}
          </p>
        </div>
        <svg
          aria-hidden="true"
          class="mt-1 h-4 w-4 shrink-0 text-ink-muted opacity-30 -translate-x-1"
          data-card-arrow
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M7 17L17 7M17 7H7M17 7v10" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="text-sm text-ink-soft line-clamp-2 flex-1">
        {project.data.description}
      </p>
      <div class="flex flex-wrap gap-1.5 text-xs text-ink-muted pt-1">
        {project.data.technologies.slice(0, 4).map(tech => (
          <span class="bg-surface/50 backdrop-blur-sm border border-line/35 px-2 py-0.5 rounded-md shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)]" data-card-tag>
            {tech}
          </span>
        ))}
        {project.data.technologies.length > 4 && (
          <span class="bg-surface/50 backdrop-blur-sm border border-line/35 px-2 py-0.5 rounded-md shadow-[inset_0_1px_0_hsl(0_0%_100%/0.08)]">
            +{project.data.technologies.length - 4}
          </span>
        )}
      </div>
    </div>
  </article>
</a>

<style>
  /* Base glass card styles */
  [data-project-card] {
    position: relative;
    border-radius: 1.75rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 12px 30px hsl(230 30% 8% / 0.035),
      0 4px 12px hsl(230 30% 8% / 0.02),
      inset 0 1px 0 hsl(0 0% 100% / 0.08);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-project-card] {
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-glass-border] {
      transition: border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-glass-ambient] {
      transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-project-card]:hover {
      transform: translateY(-4px);
      box-shadow:
        0 2px 0 0 color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent),
        0 24px 56px hsl(230 30% 8% / 0.12),
        0 8px 24px color-mix(in srgb, hsl(var(--card-accent)) 12%, transparent),
        inset 0 1px 0 hsl(0 0% 100% / 0.12);
    }

    .group:hover [data-glass-border] {
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 45%, hsl(var(--line) / 0.38));
    }

    .group:hover [data-glass-ambient] {
      opacity: 1;
    }

    [data-project-card] [data-card-accent-line] {
      transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-project-card] [data-card-accent-line] {
      opacity: 1;
    }

    [data-project-card] [data-card-glow],
    [data-project-card] [data-card-img-tint],
    [data-project-card] [data-card-no-img-glow] {
      transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-project-card] [data-card-glow] {
      opacity: 0.7;
    }
    .group:hover [data-project-card] [data-card-img-tint],
    .group:hover [data-project-card] [data-card-no-img-glow] {
      opacity: 1;
    }

    [data-project-card] [data-card-img] {
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-project-card] [data-card-img] {
      transform: scale(1.05);
    }

    [data-project-card] [data-card-arrow] {
      transition:
        opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-project-card] [data-card-arrow] {
      opacity: 1;
      transform: translateX(0);
    }

    [data-project-card] [data-card-title] {
      transition: color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-project-card] [data-card-tag] {
      transition:
        border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        background 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-project-card] [data-card-tag] {
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 30%, transparent);
      background: color-mix(in srgb, hsl(var(--card-accent)) 6%, hsl(var(--surface) / 0.5));
    }
  }
</style>
