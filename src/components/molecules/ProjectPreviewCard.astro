---
import { Icon } from 'astro-icon/components'

import { Image, Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'
import { getProjectTimelineLabel } from '@/utils/project-meta'
import { sortTechnologiesByInterest } from '@/utils/technologies'

interface Props {
  accentTone?: 'brand' | 'accent'
  project: CollectionEntry<'project'>
}

const { project, accentTone = 'brand' } = Astro.props
const isActive = !project.data.endingDate
const projectLink = getPortfolioPath(project.id)
const timeline = getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)
const coverImage = project.data.coverImage
const previewImage = coverImage?.horizontal ?? coverImage?.src ?? coverImage?.vertical
const logoImage = coverImage?.logo
const isAccent = accentTone === 'accent'
const cardAccentVar = isAccent ? 'var(--accent)' : 'var(--brand)'
const accentTextClass = isAccent ? 'text-accent' : 'text-brand'
const accentHoverClass = isAccent ? 'group-hover:text-accent' : 'group-hover:text-brand'
const sortedTechnologies = sortTechnologiesByInterest(project.data.technologies)
const visibleTechnologies = sortedTechnologies.slice(0, 4)
const hiddenTechnologyCount = Math.max(0, sortedTechnologies.length - visibleTechnologies.length)

type LogoAspect = 'square' | 'tall' | 'wide'

type LogoSurface = 'dark' | 'light' | 'neutral'

const logoAspect: LogoAspect = coverImage?.logoAspect ?? 'square'
const logoSurface: LogoSurface = coverImage?.logoSurface ?? 'dark'

const logoFrameClass = {
  square: 'size-16 p-2.5',
  tall: 'h-18 w-15 p-2.5',
  wide: 'h-15 w-40 px-4 py-2.5'
} satisfies Record<LogoAspect, string>

const logoImageClass = {
  square: 'max-h-10 max-w-10',
  tall: 'max-h-12 max-w-9',
  wide: 'max-h-9 max-w-32'
} satisfies Record<LogoAspect, string>

const logoSurfaceClass = {
  dark: 'border-white/18 bg-ink text-white dark:border-white/14 dark:bg-canvas',
  light: 'border-line/70 bg-surface text-ink dark:border-white/18 dark:bg-white/92',
  neutral: 'border-line/60 bg-surface/86 text-ink-muted dark:border-white/12 dark:bg-white/10 dark:text-white/74'
} satisfies Record<LogoSurface, string>
---

<a
  aria-label={`View ${project.data.title}`}
  class="
    group block h-full rounded-[1.75rem]
    focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:outline-none
  "
  href={projectLink}
  style={`--project-preview-accent: ${cardAccentVar};`}
>
  <article
    class="card-interactive h-full min-h-112 rounded-[1.75rem] bg-surface/58"
    data-project-preview-card
  >
    <div class="
      relative min-h-48
      sm:min-h-52
    "
    >
      {previewImage ?
        (
          <Picture
            alt=""
            aria-hidden="true"
            class="
              absolute inset-0 size-full scale-[1.01] object-cover object-center
              saturate-110 transition-transform duration-500
              motion-safe:group-hover:scale-[1.035]
              motion-reduce:transition-none
            "
            formats={['avif', 'webp']}
            height={600}
            loading="lazy"
            sizes="(min-width: 1280px) 24vw, (min-width: 768px) 42vw, 100vw"
            src={previewImage}
            data-project-preview-media
            width={840}
            widths={[480, 720, 960]}
          />
        ) :
        (
          <div class="absolute inset-0 bg-brand-soft" />
        )}

      <div
        aria-hidden="true"
        class="
          absolute inset-0 bg-linear-to-b from-brand-soft/5 via-surface/8
          via-68% to-surface/58
          dark:from-brand/10 dark:via-canvas/52 dark:to-canvas
        "
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-90"
        data-project-preview-wash
      />
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-linear-to-b
          from-transparent via-surface/22 to-surface/72
          dark:via-canvas/86 dark:to-canvas
        "
        data-project-preview-media-fade
      />

      <div class="
        absolute inset-x-4 top-4 z-20 flex items-start justify-end gap-3
      "
      >
        <span
          class="
            inline-flex size-9 items-center justify-center rounded-full border
            border-white/30 bg-surface/72 text-ink-muted shadow-sm
            backdrop-blur-xl transition duration-200
            group-hover:border-brand/30
            group-hover:text-[hsl(var(--project-preview-accent))]
            motion-safe:group-hover:translate-x-0.5
            motion-safe:group-hover:-translate-y-0.5
            motion-reduce:transition-none
            dark:border-white/14 dark:bg-white/10 dark:text-white/72
          "
        >
          <Icon aria-hidden="true" class="size-4" name="tabler:arrow-up-right" />
        </span>
      </div>

      <div class="
        absolute inset-x-5 bottom-0 z-20 flex translate-y-[58%] items-end
        justify-between gap-3
      "
      >
        <span
          class:list={[
            `
              flex shrink-0 items-center justify-center overflow-hidden
              rounded-2xl border backdrop-blur-xl
            `,
            logoFrameClass[logoAspect],
            logoSurfaceClass[logoSurface],
            `
              motion-safe:transition-transform motion-safe:duration-300
              motion-safe:group-hover:-translate-y-1
              motion-reduce:transition-none
            `
          ]}
          data-project-preview-logo
          data-logo-aspect={logoAspect}
          data-logo-surface={logoSurface}
        >
          {logoImage ?
            (
              <Image
                alt=""
                aria-hidden="true"
                class:list={['object-contain drop-shadow-sm', logoImageClass[logoAspect]]}
                loading="lazy"
                src={logoImage}
              />
            ) :
            (
              <span class="text-base font-bold">{project.data.title.charAt(0).toUpperCase()}</span>
            )}
        </span>
      </div>
    </div>

    <div class="
      flex grow flex-col gap-5 px-5 pt-12 pb-5
      sm:px-6 sm:pb-6
    "
    >
      <div class="space-y-3">
        <div class="space-y-2.5">
          <div class="flex items-center justify-between gap-3">
            <p class:list={['min-w-0 text-sm/5 font-bold', accentTextClass]}>
              {project.data.role ?? 'Engineering'}
            </p>
            <span
              class="
                inline-flex shrink-0 items-center gap-1.5 rounded-full border
                border-line/50 bg-surface/44 px-2.5 py-1 text-[0.7rem]/4
                font-bold text-ink-soft
              "
            >
              <span
                aria-hidden="true"
                class="size-1.5 rounded-full"
                style="background: hsl(var(--project-preview-accent));"
              />
              {isActive ? 'Active' : 'Completed'}
            </span>
          </div>
          <h3
            class:list={[
              `
                text-2xl/tight font-semibold tracking-tight text-ink
                transition-colors duration-200
                motion-reduce:transition-none
              `,
              accentHoverClass
            ]}
          >
            {project.data.title}
          </h3>
        </div>

        <p class="line-clamp-3 text-sm/7 text-ink-soft">
          {project.data.description}
        </p>
      </div>

      <div class="mt-auto space-y-4">
        <div class="
          flex items-center gap-2 text-xs/5 font-semibold text-ink-soft
        "
        >
          <Icon aria-hidden="true" class="size-3.5 shrink-0" name="tabler:calendar" />
          <span class="tabular-nums">{timeline}</span>
        </div>

        {visibleTechnologies.length > 0 && (
          <div class="flex min-h-16 flex-wrap content-start gap-2">
            {visibleTechnologies.map(technology => (
              <span
                class="
                  rounded-full border border-line/60 bg-surface/28 px-2.5 py-1
                  text-xs/5 font-semibold text-ink-soft transition-colors
                  duration-200
                  group-hover:border-brand/20
                  group-hover:text-[hsl(var(--project-preview-accent))]
                  motion-reduce:transition-none
                "
              >
                {technology}
              </span>
            ))}
            {hiddenTechnologyCount > 0 && (
              <span
                class="
                  rounded-full border border-line/50 bg-surface-muted/42 px-2.5
                  py-1 text-xs/5 font-semibold text-ink-muted
                "
              >
                +{hiddenTechnologyCount}
              </span>
            )}
          </div>
        )}
      </div>
    </div>
  </article>
</a>

<style>
  [data-project-preview-card] {
    box-shadow:
      0 22px 58px hsl(230 30% 8% / 0.07),
      0 8px 24px hsl(var(--brand) / 0.035),
      inset 0 1px 0 hsl(0 0% 100% / 0.22),
      inset 1px 0 0 hsl(0 0% 100% / 0.10),
      inset 0 -1px 0 hsl(var(--line) / 0.12);
  }

  [data-project-preview-card]::after {
    background: radial-gradient(
      ellipse at center,
      hsl(var(--project-preview-accent) / 0.10),
      transparent 68%
    );
  }

  [data-project-preview-media] {
    mask-image: linear-gradient(
      to bottom,
      hsl(0 0% 0%) 0%,
      hsl(0 0% 0%) 78%,
      hsl(0 0% 0% / 0.72) 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      hsl(0 0% 0%) 0%,
      hsl(0 0% 0%) 78%,
      hsl(0 0% 0% / 0.72) 92%,
      transparent 100%
    );
  }

  [data-project-preview-media-fade] {
    z-index: 10;
  }

  [data-project-preview-logo] {
    box-shadow:
      0 8px 18px hsl(230 30% 8% / 0.10),
      0 2px 8px hsl(var(--project-preview-accent) / 0.06),
      inset 0 1px 0 hsl(0 0% 100% / 0.45);
  }

  [data-project-preview-logo][data-logo-aspect='wide'] {
    border-radius: 1rem;
  }

  [data-project-preview-logo][data-logo-surface='dark'] {
    box-shadow:
      0 8px 18px hsl(230 30% 8% / 0.14),
      0 2px 8px hsl(var(--project-preview-accent) / 0.07),
      inset 0 1px 0 hsl(0 0% 100% / 0.16);
  }

  [data-project-preview-logo][data-logo-surface='light'] {
    box-shadow:
      0 8px 18px hsl(230 30% 8% / 0.08),
      0 2px 8px hsl(var(--project-preview-accent) / 0.05),
      inset 0 1px 0 hsl(0 0% 100% / 0.72);
  }

  [data-project-preview-wash] {
    background:
      radial-gradient(
        ellipse 70% 80% at 16% 12%,
        hsl(var(--project-preview-accent) / 0.22),
        transparent 68%
      ),
      radial-gradient(
        ellipse 82% 60% at 90% 86%,
        hsl(var(--brand) / 0.13),
        transparent 70%
      );
  }

  [data-project-preview-card]:hover {
    border-color: hsl(var(--project-preview-accent) / 0.34);
    box-shadow:
      0 28px 68px hsl(230 30% 8% / 0.10),
      0 16px 34px hsl(var(--project-preview-accent) / 0.12),
      inset 0 1px 0 hsl(0 0% 100% / 0.28),
      inset 0 -1px 0 hsl(var(--project-preview-accent) / 0.12);
  }

  :global(:root[data-theme='dark']) [data-project-preview-card] {
    background: hsl(var(--surface) / 0.42);
  }

  :global(:root[data-theme='dark']) [data-project-preview-wash] {
    background:
      radial-gradient(
        ellipse 72% 82% at 16% 12%,
        hsl(var(--project-preview-accent) / 0.16),
        transparent 68%
      ),
      radial-gradient(
        ellipse 82% 60% at 90% 86%,
        hsl(var(--brand) / 0.10),
        transparent 70%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    [data-project-preview-card],
    [data-project-preview-card]:hover {
      transform: none;
    }
  }
</style>
