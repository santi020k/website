---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'

interface Props {
  project: CollectionEntry<'project'>
  accentTone?: 'brand' | 'accent'
}

const { project, accentTone = 'brand' } = Astro.props
const isActive = !project.data.endingDate
const startDate = project.data.startingDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })

const endDate = isActive ?
  'Present' :
  project.data.endingDate?.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })

const dateRange = `${startDate} – ${endDate}`
const projectLink = getPortfolioPath(project.id)
const coverImage = project.data.coverImage
const bgImage = coverImage?.vertical ?? coverImage?.src
const isAccent = accentTone === 'accent'
const cardAccentVar = isAccent ? 'var(--accent)' : 'var(--brand)'
const accentHoverClass = isAccent ? 'group-hover:text-accent' : 'group-hover:text-brand'
const accentTextClass = isAccent ? 'text-accent/75' : 'text-brand/75'
const logoImage = coverImage?.logo

type LogoAspect = 'square' | 'tall' | 'wide'

type LogoSurface = 'dark' | 'light' | 'neutral'

const logoAspect: LogoAspect = coverImage?.logoAspect ?? 'square'
const logoSurface: LogoSurface = coverImage?.logoSurface ?? 'neutral'

const logoBoxClass = {
  square: 'size-20 p-1.5',
  tall: 'h-24 w-20 p-2.5',
  wide: 'h-16 w-40 px-4 py-3'
} satisfies Record<LogoAspect, string>
---

<a
  href={projectLink}
  class="
    group block rounded-[1.75rem]
    focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:outline-none
  "
>
  <article
    class="relative overflow-hidden rounded-[1.75rem]"
    data-project-card
    style={`--card-accent: ${cardAccentVar};`}
  >

    {/* ── Background media (vertical cover, blurred) ────────────── */}
    {bgImage ?
      (
        <>
          <Image
            alt=""
            aria-hidden="true"
            class="absolute inset-0 size-full object-cover"
            data-card-bg
            height={800}
            loading="lazy"
            src={bgImage}
            width={600}
          />
          {/* Blur + dim overlay for background */}
          <div
            aria-hidden="true"
            class="absolute inset-0"
            data-card-bg-overlay
          />
        </>
      ) :
      (
        <div
          aria-hidden="true"
          class="absolute inset-0"
          data-card-mesh
          style="--mesh-base: hsl(var(--surface-muted));"
        />
      )}

    {/* ── Logo/Brand area ─────────────────────────────────────────── */}
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-center" style="padding-top: 16%;">
      {logoImage ?
        (
          <div
            class:list={[
              'flex items-center justify-center overflow-hidden rounded-2xl',
              logoBoxClass[logoAspect]
            ]}
            data-card-logo
            data-logo-aspect={logoAspect}
            data-logo-surface={logoSurface}
          >
            <Image
              alt={`${project.data.title} logo`}
              class="size-full object-contain"
              data-card-logo-img
              loading="lazy"
              src={logoImage}
            />
          </div>
        ) :
        (
          <div
            class="
              flex size-20 items-center justify-center rounded-2xl text-3xl
              font-bold text-white
            "
            data-card-logo-fallback
          >
            {project.data.title.charAt(0).toUpperCase()}
          </div>
        )}
    </div>

    {/* Progressive darkening scrim */}
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, hsl(0 0% 0% / 0) 10%, hsl(0 0% 0% / 0.14) 48%, hsl(0 0% 0% / 0.52) 100%);"
    />

    {/* Ambient animated tint — always present, subtle */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      data-card-ambient
    />

    {/* Accent hover tint */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-0"
      data-card-tint
    />

    {/* Specular top-edge highlight — light catching the rim of the glass */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 z-20 h-px"
      style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.4) 28%, hsl(0 0% 100% / 0.56) 50%, hsl(0 0% 100% / 0.4) 72%, transparent 92%);"
    />

    {/* ── Spacer pushes glass panel down ────────────────────────── */}
    <div aria-hidden="true" class="relative" style="padding-top: 62%;" />

    {/* ── Glass panel ───────────────────────────────────────────── */}
    <div class="relative z-10" data-card-panel>

      {/* Status + date header */}
      <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3.5">
        {isActive ?
          (
            <span
              class="inline-flex items-center gap-1.5 text-xs font-semibold"
              data-card-status
              style="color: hsl(var(--card-accent));"
            >
              <span
                aria-hidden="true"
                class="
                  inline-block size-1.5 rounded-full
                  motion-safe:animate-pulse
                "
                style="background: hsl(var(--card-accent));"
              />
              Active
            </span>
          ) :
          (
            <span
              class="inline-flex items-center text-xs font-medium text-white/70"
              data-card-status
            >
              Completed
            </span>
          )}
        <span class="text-xs text-white/55 tabular-nums">
          {dateRange}
        </span>
      </div>

      {/* Separator */}
      <div
        aria-hidden="true"
        class="mx-5 h-px"
        style="background: linear-gradient(90deg, transparent, hsl(0 0% 100% / 0.1) 20%, hsl(0 0% 100% / 0.1) 80%, transparent);"
      />

      {/* Title + description + tags */}
      <div class="space-y-3 px-5 pt-3.5 pb-5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 space-y-1">
            <h3
              class:list={['text-base/snug font-semibold text-white', accentHoverClass]}
              data-card-title
            >
              {project.data.title}
            </h3>
            <p class:list={['text-xs font-medium', accentTextClass]}>
              {project.data.role ?? 'Engineering'}
            </p>
          </div>
          <svg
            aria-hidden="true"
            class="
              mt-0.5 size-4 shrink-0 -translate-x-1.5 translate-y-0.5
              text-white/45 opacity-0
            "
            data-card-arrow
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </div>

        <p class="line-clamp-2 text-sm/relaxed text-white/65">
          {project.data.description}
        </p>

        <div class="flex flex-wrap gap-2 text-xs">
          {project.data.technologies.slice(0, 4).map(tech => (
            <span
              class="text-white/55"
              data-card-tag
            >
              {tech}
            </span>
          ))}
          {project.data.technologies.length > 4 && (
            <span class="text-white/40">
              +{project.data.technologies.length - 4}
            </span>
          )}
        </div>
      </div>
    </div>
  </article>
</a>

<style>
  [data-project-card] {
    border: 1px solid hsl(0 0% 100% / 0.13);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.18),
      inset 1px 0 0 hsl(0 0% 100% / 0.07),
      0 12px 32px hsl(230 30% 8% / 0.14),
      0 4px 12px hsl(230 30% 8% / 0.1);
  }

  /* Background image with blur effect */
  [data-card-bg] {
    filter: blur(8px) brightness(0.7);
    transform: scale(1.1);
  }

  [data-card-bg-overlay] {
    background: linear-gradient(
      to bottom,
      hsl(0 0% 0% / 0.3) 0%,
      hsl(0 0% 0% / 0.1) 50%,
      hsl(0 0% 0% / 0.4) 100%
    );
    backdrop-filter: blur(2px);
  }

  /* Logo/Brand mark styling */
  [data-card-logo] {
    position: relative;
    isolation: isolate;
    background: linear-gradient(
      135deg,
      hsl(var(--surface) / 0.78) 0%,
      hsl(var(--surface-muted) / 0.58) 100%
    );
    border: 1px solid hsl(var(--card-accent) / 0.3);
    box-shadow:
      0 8px 32px hsl(0 0% 0% / 0.2),
      inset 0 1px 0 hsl(0 0% 100% / 0.1);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  [data-logo-surface='dark'] {
    background: linear-gradient(
      135deg,
      hsl(260 32% 13% / 0.9) 0%,
      hsl(260 45% 8% / 0.78) 100%
    );
  }

  [data-logo-surface='light'] {
    background: linear-gradient(
      135deg,
      hsl(0 0% 100% / 0.9) 0%,
      hsl(264 48% 93% / 0.82) 100%
    );
    box-shadow:
      0 8px 32px hsl(0 0% 0% / 0.18),
      inset 0 1px 0 hsl(0 0% 100% / 0.52);
  }

  [data-card-logo-img] {
    filter:
      drop-shadow(0 1px 1px hsl(0 0% 100% / 0.12))
      drop-shadow(0 3px 7px hsl(0 0% 0% / 0.34));
  }

  [data-logo-surface='light'] [data-card-logo-img] {
    filter: drop-shadow(0 3px 7px hsl(260 45% 10% / 0.24));
  }

  [data-card-logo-fallback] {
    background: linear-gradient(
      135deg,
      hsl(var(--card-accent) / 0.25) 0%,
      hsl(var(--card-accent) / 0.15) 100%
    );
    border: 1px solid hsl(var(--card-accent) / 0.3);
    box-shadow:
      0 8px 32px hsl(0 0% 0% / 0.2),
      inset 0 1px 0 hsl(0 0% 100% / 0.1);
    text-shadow: 0 2px 4px hsl(0 0% 0% / 0.3);
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .group:hover [data-card-logo] {
      transform: translateY(-4px) scale(1.05);
      box-shadow:
        0 12px 40px hsl(var(--card-accent) / 0.15),
        0 8px 32px hsl(0 0% 0% / 0.25),
        inset 0 1px 0 hsl(0 0% 100% / 0.15);
    }

    .group:hover [data-card-logo-fallback] {
      transform: translateY(-4px) scale(1.05);
      background: linear-gradient(
        135deg,
        hsl(var(--card-accent) / 0.35) 0%,
        hsl(var(--card-accent) / 0.25) 100%
      );
      box-shadow:
        0 12px 40px hsl(var(--card-accent) / 0.15),
        0 8px 32px hsl(0 0% 0% / 0.25),
        inset 0 1px 0 hsl(0 0% 100% / 0.15);
    }
  }

  [data-card-panel] {
    background: linear-gradient(
      180deg,
      hsl(0 0% 0% / 0) 0%,
      hsl(0 0% 0% / 0.42) 28%,
      hsl(0 0% 0% / 0.70) 100%
    );
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
  }

  @keyframes card-shimmer {
    from { left: -65%; }
    to { left: 130%; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-project-card] {
      transition:
        border-color 0.2s ease,
        background-color 0.2s ease;
    }

    [data-project-card]::after {
      display: none;
    }

    [data-card-panel] {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-project-card] {
      transition:
        transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.3s ease;
    }

    [data-project-card]:hover {
      transform: translateY(-5px);
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 32%, hsl(0 0% 100% / 0.14));
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.22),
        inset 1px 0 0 hsl(0 0% 100% / 0.09),
        0 0 0 1px color-mix(in srgb, hsl(var(--card-accent)) 20%, transparent),
        0 24px 56px hsl(230 30% 8% / 0.22),
        0 8px 24px color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent);
    }

    /* Diagonal shimmer sweep on hover */
    [data-project-card]::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -65%;
      width: 35%;
      background: linear-gradient(
        90deg,
        transparent,
        hsl(0 0% 100% / 0.04) 40%,
        hsl(0 0% 100% / 0.07) 50%,
        hsl(0 0% 100% / 0.04) 60%,
        transparent
      );
      transform: skewX(-10deg);
      z-index: 9;
      pointer-events: none;
    }

    .group:hover [data-project-card]::after {
      animation: card-shimmer 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    [data-card-panel] {
      transition: background 0.3s ease;
    }

    .group:hover [data-card-panel] {
      background: linear-gradient(
        180deg,
        hsl(0 0% 0% / 0) 0%,
        hsl(0 0% 0% / 0.48) 28%,
        hsl(0 0% 0% / 0.76) 100%
      );
    }

    /* ── Animated mesh gradient (fallback when no cover image) ──── */

  @property --mx1 { syntax: '<percentage>'; inherits: false; initial-value: 18%; }
  @property --my1 { syntax: '<percentage>'; inherits: false; initial-value: 25%; }
  @property --mx2 { syntax: '<percentage>'; inherits: false; initial-value: 78%; }
  @property --my2 { syntax: '<percentage>'; inherits: false; initial-value: 15%; }
  @property --mx3 { syntax: '<percentage>'; inherits: false; initial-value: 55%; }
  @property --my3 { syntax: '<percentage>'; inherits: false; initial-value: 82%; }

  [data-card-mesh] {
    --_a: hsl(var(--card-accent) / 0.18);
    --_b: hsl(var(--card-accent) / 0.10);
    --_c: hsl(var(--card-accent) / 0.06);
    background:
      radial-gradient(ellipse 110% 90% at var(--mx1) var(--my1), var(--_a), transparent 55%),
      radial-gradient(ellipse 75% 85% at var(--mx2) var(--my2), var(--_b), transparent 52%),
      radial-gradient(ellipse 50% 50% at var(--mx3) var(--my3), var(--_c), transparent 58%),
      var(--mesh-base);
  }

  @keyframes mesh-drift {
    0%, 100% {
      --mx1: 18%; --my1: 25%;
      --mx2: 78%; --my2: 15%;
      --mx3: 55%; --my3: 82%;
    }
    33% {
      --mx1: 62%; --my1: 18%;
      --mx2: 22%; --my2: 72%;
      --mx3: 78%; --my3: 42%;
    }
    66% {
      --mx1: 48%; --my1: 68%;
      --mx2: 82%; --my2: 28%;
      --mx3: 12%; --my3: 52%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-card-mesh] {
      animation: mesh-drift 14s ease-in-out infinite;
    }
  }

  /* ── Ambient animated tint (always present, subtle) ─────────── */

  @property --atx { syntax: '<percentage>'; inherits: false; initial-value: 65%; }
  @property --aty { syntax: '<percentage>'; inherits: false; initial-value: 25%; }

  [data-card-ambient] {
    background: radial-gradient(ellipse 70% 55% at var(--atx) var(--aty), color-mix(in srgb, hsl(var(--card-accent)) 10%, transparent), transparent 68%);
    opacity: 0.55;
  }

  @keyframes ambient-drift {
    0%, 100% { --atx: 65%; --aty: 25%; }
    50% { --atx: 35%; --aty: 70%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-card-ambient] {
      animation: ambient-drift 10s ease-in-out infinite;
    }
  }

  [data-card-tint] {
    background: radial-gradient(ellipse 80% 60% at 70% 20%, color-mix(in srgb, hsl(var(--card-accent)) 22%, transparent), transparent 65%);
    transition: opacity 0.45s ease;
  }
  .group:hover [data-card-tint] { opacity: 1; }

    [data-card-img] {
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-card-img] { transform: scale(1.06); }

    [data-card-arrow] {
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .group:hover [data-card-arrow] {
      opacity: 1;
      transform: translate(0, 0);
    }

    [data-card-title] { transition: color 0.2s ease; }

    [data-card-tag] {
      transition: color 0.25s ease;
    }
    .group:hover [data-card-tag] {
      color: color-mix(in srgb, hsl(var(--card-accent)) 70%, white);
    }
  }
</style>
