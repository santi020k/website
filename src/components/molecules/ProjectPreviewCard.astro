---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'

interface Props {
  project: CollectionEntry<'project'>
  accentTone?: 'brand' | 'accent'
}

const { project, accentTone = 'brand' } = Astro.props
const isActive = !project.data.endingDate
const startDate = project.data.startingDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
const endDate = isActive ?
  'Present' :
  project.data.endingDate?.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
const dateRange = `${startDate} – ${endDate}`
const projectLink = getPortfolioPath(project.id)

const isAccent = accentTone === 'accent'
const cardAccentVar = isAccent ? 'var(--accent)' : 'var(--brand)'
const accentHoverClass = isAccent ? 'group-hover:text-accent' : 'group-hover:text-brand'
const accentTextClass = isAccent ? 'text-accent/75' : 'text-brand/75'
---

<a
  href={projectLink}
  class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/50 rounded-[1.75rem]"
>
  <article
    class="relative overflow-hidden rounded-[1.75rem]"
    data-project-card
    style={`--card-accent: ${cardAccentVar};`}
  >

    {/* ── Background media ──────────────────────────────────────── */}
    {project.data.coverImage?.src ? (
      <Image
        alt={project.data.coverImage.alt}
        class="absolute inset-0 h-full w-full object-cover"
        data-card-img
        height={450}
        loading="lazy"
        src={project.data.coverImage.horizontal ?? project.data.coverImage.src}
        width={600}
      />
    ) : (
      <div
        aria-hidden="true"
        class="absolute inset-0"
        style={`background:
          radial-gradient(ellipse 120% 95% at 12% 28%, color-mix(in srgb, hsl(var(--card-accent)) 32%, transparent), transparent 55%),
          radial-gradient(ellipse 80% 90% at 88% 10%, color-mix(in srgb, hsl(var(--card-accent)) 16%, transparent), transparent 52%),
          radial-gradient(ellipse 55% 55% at 58% 88%, color-mix(in srgb, hsl(var(--card-accent)) 9%, transparent), transparent 58%),
          hsl(var(--surface-muted));`}
      />
    )}

    {/* Progressive darkening scrim */}
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, hsl(0 0% 0% / 0) 10%, hsl(0 0% 0% / 0.14) 48%, hsl(0 0% 0% / 0.52) 100%);"
    />

    {/* Accent hover tint */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 opacity-0"
      data-card-tint
      style="background: radial-gradient(ellipse 80% 60% at 70% 20%, color-mix(in srgb, hsl(var(--card-accent)) 22%, transparent), transparent 65%);"
    />

    {/* Specular top-edge highlight — light catching the rim of the glass */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 z-20 h-px"
      style="background: linear-gradient(90deg, transparent 8%, hsl(0 0% 100% / 0.4) 28%, hsl(0 0% 100% / 0.56) 50%, hsl(0 0% 100% / 0.4) 72%, transparent 92%);"
    />

    {/* ── Spacer pushes glass panel down ────────────────────────── */}
    <div aria-hidden="true" class="relative" style="padding-top: 60%;" />

    {/* ── Glass panel ───────────────────────────────────────────── */}
    <div class="relative z-10" data-card-panel>

      {/* Status + date header */}
      <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3.5">
        {isActive ? (
          <span
            class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold"
            data-card-status
            style="background: hsl(var(--brand-soft) / 0.5); color: hsl(var(--card-accent)); border-color: color-mix(in srgb, hsl(var(--card-accent)) 35%, transparent);"
          >
            <span
              aria-hidden="true"
              class="inline-block size-1.5 rounded-full motion-safe:animate-pulse"
              style="background: hsl(var(--card-accent));"
            />
            Active
          </span>
        ) : (
          <span
            class="inline-flex items-center rounded-full border border-line/30 bg-surface/30 px-2.5 py-1 text-xs font-medium text-white/70"
            data-card-status
          >
            Completed
          </span>
        )}
        <span class="text-xs tabular-nums text-white/55">
          {dateRange}
        </span>
      </div>

      {/* Separator */}
      <div
        aria-hidden="true"
        class="mx-5 h-px"
        style="background: linear-gradient(90deg, transparent, hsl(0 0% 100% / 0.1) 20%, hsl(0 0% 100% / 0.1) 80%, transparent);"
      />

      {/* Title + description + tags */}
      <div class="px-5 pt-3.5 pb-5 space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 space-y-1">
            <h3
              class:list={['text-base font-semibold leading-snug text-white', accentHoverClass]}
              data-card-title
            >
              {project.data.title}
            </h3>
            <p class:list={['text-xs font-medium', accentTextClass]}>
              {project.data.role ?? 'Engineering'}
            </p>
          </div>
          <svg
            aria-hidden="true"
            class="mt-0.5 size-4 shrink-0 text-white/45 opacity-0 -translate-x-1.5 translate-y-0.5"
            data-card-arrow
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </div>

        <p class="text-sm leading-relaxed text-white/65 line-clamp-2">
          {project.data.description}
        </p>

        <div class="flex flex-wrap gap-2 text-xs">
          {project.data.technologies.slice(0, 4).map(tech => (
            <span
              class="rounded-md border border-white/15 bg-white/8 px-2.5 py-1 text-white/55 backdrop-blur-sm"
              data-card-tag
            >
              {tech}
            </span>
          ))}
          {project.data.technologies.length > 4 && (
            <span class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-white/40">
              +{project.data.technologies.length - 4}
            </span>
          )}
        </div>
      </div>
    </div>
  </article>
</a>

<style>
  [data-project-card] {
    border: 1px solid hsl(0 0% 100% / 0.13);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.18),
      inset 1px 0 0 hsl(0 0% 100% / 0.07),
      0 12px 32px hsl(230 30% 8% / 0.14),
      0 4px 12px hsl(230 30% 8% / 0.1);
  }

  [data-card-panel] {
    background: linear-gradient(
      180deg,
      hsl(var(--surface) / 0.44) 0%,
      hsl(var(--surface) / 0.72) 40%,
      hsl(var(--surface-muted) / 0.90) 100%
    );
    border-top: 1px solid hsl(0 0% 100% / 0.22);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.08),
      inset 0 0 50px hsl(var(--card-accent) / 0.05);
  }

  @keyframes card-shimmer {
    from { left: -65%; }
    to { left: 130%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-project-card] {
      transition:
        transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.3s ease;
    }

    [data-project-card]:hover {
      transform: translateY(-5px);
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 32%, hsl(0 0% 100% / 0.14));
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.22),
        inset 1px 0 0 hsl(0 0% 100% / 0.09),
        0 0 0 1px color-mix(in srgb, hsl(var(--card-accent)) 20%, transparent),
        0 24px 56px hsl(230 30% 8% / 0.22),
        0 8px 24px color-mix(in srgb, hsl(var(--card-accent)) 18%, transparent);
    }

    /* Diagonal shimmer sweep on hover */
    [data-project-card]::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -65%;
      width: 35%;
      background: linear-gradient(
        90deg,
        transparent,
        hsl(0 0% 100% / 0.04) 40%,
        hsl(0 0% 100% / 0.07) 50%,
        hsl(0 0% 100% / 0.04) 60%,
        transparent
      );
      transform: skewX(-10deg);
      z-index: 9;
      pointer-events: none;
    }

    .group:hover [data-project-card]::after {
      animation: card-shimmer 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    [data-card-panel] {
      transition: background 0.3s ease, backdrop-filter 0.3s ease, box-shadow 0.3s ease;
    }

    .group:hover [data-card-panel] {
      background: linear-gradient(
        180deg,
        hsl(var(--surface) / 0.52) 0%,
        hsl(var(--surface) / 0.80) 40%,
        hsl(var(--surface-muted) / 0.94) 100%
      );
      backdrop-filter: blur(24px) saturate(170%);
      -webkit-backdrop-filter: blur(24px) saturate(170%);
      box-shadow:
        inset 0 1px 0 hsl(0 0% 100% / 0.12),
        inset 0 0 50px hsl(var(--card-accent) / 0.09);
    }

    [data-card-tint] {
      transition: opacity 0.45s ease;
    }
    .group:hover [data-card-tint] { opacity: 1; }

    [data-card-img] {
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .group:hover [data-card-img] { transform: scale(1.06); }

    [data-card-arrow] {
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .group:hover [data-card-arrow] {
      opacity: 1;
      transform: translate(0, 0);
    }

    [data-card-title] { transition: color 0.2s ease; }

    [data-card-tag] {
      transition: border-color 0.25s ease, background 0.25s ease;
    }
    .group:hover [data-card-tag] {
      border-color: color-mix(in srgb, hsl(var(--card-accent)) 35%, hsl(0 0% 100% / 0.15));
      background: color-mix(in srgb, hsl(var(--card-accent)) 12%, hsl(0 0% 100% / 0.08));
    }
  }
</style>
