---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'
import LinkRecovery from '@/components/molecules/LinkRecovery.astro'

import Button from '@santi020k/lumen-astro/components/Button'
import Card from '@santi020k/lumen-astro/components/Card'
import FieldError from '@santi020k/lumen-astro/components/FieldError'
import Icon from '@santi020k/lumen-astro/components/Icon'
import Input from '@santi020k/lumen-astro/components/Input'
import Link from '@santi020k/lumen-astro/components/Link'

import { getLocale, localizePath, sharedTranslator } from '@/i18n'

interface Props {
  formAction: string

  /** Distinguishes fields and headings when multiple signups share a page. */
  idSuffix?: string
}

const { formAction, idSuffix = 'compact' } = Astro.props
const emailId = `newsletter-email-${idSuffix}`
const headingId = `newsletter-heading-${idSuffix}`
const handoffId = `newsletter-handoff-${idSuffix}`
const errorId = `newsletter-error-${idSuffix}`
const feedCopyId = `newsletter-feed-copy-${idSuffix}`
const feedUrl = new URL('/feed.xml', Astro.site).href
const locale = getLocale(Astro.url.pathname)
const t = sharedTranslator(locale)
---

<Card data-newsletter variant="unstyled">
  <header data-newsletter-header>
    <div data-newsletter-masthead>
      <p data-newsletter-eyebrow>Newsletter</p>
      <span data-newsletter-postmark><Icon class="size-7" name="mail" /></span>
    </div>
    <h2 id={headingId}>{t('shared.keepUpWithNewWriting')}</h2>
    <p data-newsletter-description>
      {t('shared.aLowVolumeEmailWithNew')}
    </p>
  </header>
  <form
    action={formAction}
    aria-labelledby={headingId}
    method="post"
    rel="noopener noreferrer"
    target="_blank"
    data-newsletter-form
  >
    <input name="embed" type="hidden" value="1" />
    <label data-newsletter-label for={emailId}>{t('shared.emailAddress')}</label>
    <div data-newsletter-controls>
      <div data-newsletter-field>
        <Input
          aria-describedby={handoffId}
          autocomplete="email"
          data-newsletter-email
          id={emailId}
          inputmode="email"
          name="email"
          placeholder="your@email.com"
          required
          type="email"
        />
        <FieldError
          id={errorId}
          data-newsletter-error
          data-required-message={t('newsletter.emailRequired')}
          data-invalid-message={t('newsletter.emailInvalid')}
          role="alert"
          aria-atomic="true"
        >
          <Icon class="size-4 shrink-0" name="circle-alert" />
          <span data-newsletter-error-message></span>
        </FieldError>
      </div>
      <Button
        aria-describedby={handoffId}
        data-newsletter-submit
        type="submit"
      >
        <span data-newsletter-submit-content>
          <span data-newsletter-submit-label>{t('shared.subscribe')}</span>
          <ArrowExchange class="size-4 shrink-0" direction="up-right" />
        </span>
      </Button>
    </div>
    <p
      id={handoffId}
      data-newsletter-handoff
      data-idle-message={t('newsletter.opensButtondown')}
      data-submitted-message={t('newsletter.continueOnButtondown')}
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <Icon class="size-4 shrink-0" name="external-link" />
      <span data-newsletter-handoff-message>{t('newsletter.opensButtondown')}</span>
    </p>
  </form>
  <footer data-newsletter-footer>
    <p>
      {t('shared.monthlyAtMostUnsubscribeAnytime')}<br />
      <Link className="privacy-inline-link" href={localizePath('/privacy/', locale)} variant="inherit">{t('shared.privacy')}</Link>
    </p>
    <div data-newsletter-feed>
      <a data-newsletter-rss data-text-link href="/feed.xml">
        <Icon class="size-4" name="rss" />
        <span data-text-link-label>{t('newsletter.rssFeed')}</span>
      </a>
      <Button
        id={feedCopyId}
        class="article-copy-action"
        data-newsletter-copy
        data-share-url={feedUrl}
        type="button"
        variant="ghost"
      >
        <span data-copy-action-content>
          <span data-copy-label>{t('newsletter.copyFeed')}</span>
          <span data-copy-action-icon>
            <Icon class="size-4" data-copy-icon name="copy" />
            <Icon class="hidden size-4" data-check-icon name="check" />
          </span>
        </span>
      </Button>
    </div>
    <LinkRecovery
      buttonId={feedCopyId}
      url={feedUrl}
      idleLabel={t('newsletter.copyFeed')}
      copiedLabel={t('shared.copied')}
      copiedAnnouncement={t('newsletter.feedCopied')}
      addressLabel={t('newsletter.selectFeedAddress')}
    />
  </footer>
</Card>

<style>
  [data-newsletter][data-slot='card'] {
    --newsletter-accent: var(--brand);
    container: newsletter / inline-size;
    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1.75rem 1.75rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  :global(:root[data-theme='santi020k-dark']) [data-newsletter] { --newsletter-accent: var(--accent); }
  [data-newsletter-header] { padding: 1.75rem; border-radius: 0.3125rem 1.6875rem 0 0; background: hsl(var(--brand-soft)); }
  [data-newsletter-masthead] { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 0; margin-bottom: 1rem; }
  [data-newsletter-eyebrow] { margin: 0; color: color-mix(in srgb, hsl(var(--newsletter-accent)) 80%, hsl(var(--ink))); font-size: 0.625rem; line-height: 1.8; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase; }
  [data-newsletter] h2 { max-width: 18ch; margin: 0; color: hsl(var(--ink)); font-size: 2.5rem; line-height: 1.2; font-weight: 500; letter-spacing: -0.05em; }
  [data-newsletter-description] { max-width: 52ch; margin: 1.125rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-newsletter-postmark] { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; color: hsl(var(--newsletter-accent)); }
  [data-newsletter-form] { min-width: 0; margin: 0; padding: 1.5rem 1.75rem; }
  [data-newsletter-label] { display: block; margin-bottom: 0.5rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.6; font-weight: 500; }
  [data-newsletter-controls] { display: flex; align-items: flex-start; gap: 0.5rem; min-width: 0; }
  [data-newsletter-field] { flex: 1; min-width: 0; }
  [data-newsletter-field] :global([data-newsletter-error]) { display: flex; align-items: flex-start; gap: 0.5rem; margin: 0.5rem 0 0; color: color-mix(in srgb, hsl(var(--danger)) 75%, hsl(var(--ink))); font-size: 0.75rem; line-height: 1.65; }
  [data-newsletter-field] :global([data-newsletter-error][hidden]) { display: none; }
  [data-newsletter-error] :global(svg) { margin-top: 0.125rem; }
  [data-newsletter-email][aria-invalid='true'] { border-color: color-mix(in srgb, hsl(var(--danger)) 75%, hsl(var(--ink))); }
  [data-newsletter-email] { flex: 1; width: 100%; min-width: 0; min-height: 2.75rem; height: auto; padding: 0.625rem 0.75rem; border: 1px solid hsl(var(--line)); border-radius: 0.75rem; background: hsl(var(--surface)); color: hsl(var(--ink)); font-size: 1rem; line-height: 1.5; }
  [data-newsletter-email]::placeholder { color: hsl(var(--ink-soft)); opacity: 1; }
  [data-newsletter-submit] { flex-shrink: 0; min-width: 2.75rem; min-height: calc(2.75rem + 2px); max-width: 100%; height: auto; padding: 0.625rem 1rem; border: 1px solid hsl(var(--ink)); border-radius: 0.75rem; background: hsl(var(--ink)); color: hsl(var(--surface)); font-size: 0.75rem; line-height: 1.6; font-weight: 500; white-space: normal; transition: background-color 160ms ease; }
  [data-newsletter-submit], [data-newsletter-submit]:hover { box-shadow: none; }
  [data-newsletter-submit]:hover { background: hsl(var(--ink-soft)); }
  [data-newsletter-submit-content] { display: flex; align-items: center; justify-content: center; gap: 0.625rem; min-width: 0; }
  [data-newsletter-handoff] { display: flex; align-items: flex-start; gap: 0.5625rem; margin: 0.875rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.7; }
  [data-newsletter-handoff] :global(svg) { margin-top: 0.125rem; color: hsl(var(--newsletter-accent)); }
  [data-newsletter-handoff][data-submitted] { padding-left: 0.75rem; border-left: 2px solid hsl(var(--newsletter-accent)); color: hsl(var(--ink)); }
  [data-newsletter-handoff][data-submitted] :global(svg) { display: none; }
  [data-newsletter-footer] { margin-inline: 1.75rem; padding: 0.75rem 0 1.25rem; border-top: 1px solid hsl(var(--line)); }
  [data-newsletter-footer] > p { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.8; }
  [data-newsletter-feed] { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1rem; margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px solid hsl(var(--line)); }
  [data-newsletter-rss] { display: inline-flex; align-items: center; gap: 0.5rem; max-width: 100%; min-width: 2.75rem; min-height: 2.75rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.5; }
  [data-newsletter-rss] [data-text-link-label] { text-decoration: underline; text-decoration-color: hsl(var(--line)); text-decoration-thickness: 1px; text-underline-offset: 0.25rem; }
  [data-newsletter-rss]:is(:hover, :focus-visible) [data-text-link-label] { text-decoration-color: currentColor; }
  [data-newsletter-footer] :global([data-newsletter-copy]) { width: auto; min-height: 2.75rem; max-width: 100%; padding: 0.375rem 0.5rem 0.375rem 0.75rem; border-color: transparent; border-radius: 0.75rem; background: transparent; color: hsl(var(--ink-soft)); font-size: 0.75rem; font-weight: 500; box-shadow: none; transition: color 240ms ease, background-color 240ms ease, border-color 240ms ease; }
  [data-newsletter-copy] [data-copy-action-content] { column-gap: 0.875rem; }
  [data-newsletter-copy] [data-copy-action-icon] { width: 1.75rem; height: 1.75rem; background: transparent; color: inherit; }
  [data-newsletter-footer] :global([data-newsletter-copy]:is(:hover, :focus-visible)),
  [data-newsletter-footer] :global([data-newsletter-copy].copied) { border-color: hsl(var(--line)); background: hsl(var(--brand-soft)); color: color-mix(in srgb, hsl(var(--newsletter-accent)) 80%, hsl(var(--ink))); }
  [data-newsletter-footer] :global([data-newsletter-copy][data-link-recovery-active]) { border-color: hsl(var(--danger)); background: transparent; color: hsl(var(--ink)); }
  [data-newsletter-footer] :global([data-link-recovery]) { margin-block-start: 1rem; }
  @container newsletter (width < 25rem) {
    [data-newsletter] h2 { font-size: 2rem; }
    [data-newsletter-controls] { flex-direction: column; align-items: stretch; }
  }
  @container newsletter (width < 18rem) {
    [data-newsletter-header], [data-newsletter-form] { padding: 1.375rem; }
    [data-newsletter-footer] { margin-inline: 1.375rem; }
    [data-newsletter] h2 { font-size: 1.5rem; }
    [data-newsletter-postmark] { display: none; }
  }
  @container newsletter (width < 13rem) {
    [data-newsletter-header], [data-newsletter-form] { padding: 0.75rem; }
    [data-newsletter-footer] { margin-inline: 0.75rem; }
    [data-newsletter] h2 { font-size: 1.125rem; }
    [data-newsletter-submit-content] > :last-child { display: none; }
  }
  @container newsletter (width < 10rem) {
    [data-newsletter] h2 { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-newsletter-submit] { transition: none; }
    [data-newsletter-footer] :global([data-newsletter-copy]) { transition: none; }
  }
  @media (forced-colors: active) {
    [data-newsletter-footer] :global([data-newsletter-copy]:is(:hover, :focus-visible)),
    [data-newsletter-footer] :global([data-newsletter-copy].copied) { border-color: Highlight; }
  }
</style>

<script>
  const setup = () => {
    const controller = new AbortController()
    const { signal } = controller

    document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach(form => {
      const note = form.querySelector<HTMLElement>('[data-newsletter-handoff]')
      const message = note?.querySelector<HTMLElement>('[data-newsletter-handoff-message]')
      const idle = note?.dataset.idleMessage
      const submitted = note?.dataset.submittedMessage
      const field = form.querySelector<HTMLInputElement>('[data-newsletter-email]')
      const error = form.querySelector<HTMLElement>('[data-newsletter-error]')
      const errorMessage = error?.querySelector<HTMLElement>('[data-newsletter-error-message]')
      const requiredMessage = error?.dataset.requiredMessage
      const invalidMessage = error?.dataset.invalidMessage

      if (!note || !message || !idle || !submitted || !field || !error || !errorMessage) return

      if (!requiredMessage || !invalidMessage) return

      const originalDescription = field.getAttribute('aria-describedby') ?? ''

      const clearError = () => {
        error.hidden = true

        errorMessage.textContent = ''

        field.removeAttribute('aria-invalid')

        field.setAttribute('aria-describedby', originalDescription)
      }

      const reset = () => {
        note.removeAttribute('data-submitted')

        message.textContent = idle

        clearError()
      }

      field.addEventListener('invalid', event => {
        // Native constraint validation still blocks the POST; use one inline message.
        event.preventDefault()

        reset()

        error.hidden = false

        errorMessage.textContent = field.validity.valueMissing ? requiredMessage : invalidMessage

        field.setAttribute('aria-invalid', 'true')

        field.setAttribute('aria-describedby', `${error.id} ${originalDescription}`.trim())

        field.focus()
      }, { signal })

      form.addEventListener('submit', event => {
        clearError()

        // Observe the native POST; only Buttondown can confirm the subscription.
        window.setTimeout(() => {
          if (event.defaultPrevented || signal.aborted) return

          note.setAttribute('data-submitted', '')

          message.textContent = submitted
        }, 0)
      }, { signal })

      form.addEventListener('input', reset, { signal })

      form.addEventListener('reset', reset, { signal })
    })

    return () => controller.abort()
  }

  let cleanup = setup()

  document.addEventListener('astro:before-swap', () => cleanup())

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
