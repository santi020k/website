---
import Button from '@/components/atoms/Button.astro'

import { Card, Icon, Input, Link } from '@santi020k/lumen-astro'

interface Props {
  formAction: string
}

const { formAction } = Astro.props
const emailId = 'newsletter-email-compact'
---

<Card class="rounded-3xl border border-line/65 bg-surface p-6" data-newsletter variant="unstyled">
  <div class="relative z-10 space-y-3">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0 flex-1 basis-48">
        <p class="section-label">Stay in the loop</p>
        <h3 class="mt-1 text-base font-semibold text-ink">New posts and discoveries</h3>
      </div>
      <a
        class="
          inline-flex min-h-11 min-w-11 shrink-0 items-center gap-1 text-xs
          font-medium text-ink-muted transition-colors
          hover:text-brand
          motion-reduce:transition-none
        "
        href="/feed.xml"
      >
        <Icon class="size-3.5" name="rss" />
        RSS
      </a>
    </div>
    <form
      action={formAction}
      class="flex gap-2"
      method="post"
      rel="noopener noreferrer"
      target="_blank"
      data-newsletter-form
    >
      <input name="embed" type="hidden" value="1" />
      <label class="sr-only" for={emailId}>Email address</label>
      <Input
        autocomplete="email"
        class="min-h-11 min-w-0 flex-1 rounded-xl px-3 py-2"
        id={emailId}
        inputmode="email"
        name="email"
        placeholder="your@email.com"
        required
        type="email"
      />
      <Button
        aria-label="Get new posts"
        className="min-h-11 min-w-11 px-3 py-2"
        type="submit"
      >
        <Icon class="size-4" name="send" />
        <span aria-hidden="true" data-newsletter-submit-label>Get new posts</span>
      </Button>
    </form>
    <p class="text-xs text-ink-muted">
      Monthly at most. Unsubscribe anytime.{' '}
      <Link className="privacy-inline-link" href="/privacy/" variant="inherit">Privacy</Link>.
    </p>
  </div>
</Card>
