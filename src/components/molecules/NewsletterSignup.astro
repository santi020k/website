---
import { Icon } from 'astro-icon/components'

interface Props {
  formAction: string
  label?: string
  variant?: 'compact' | 'default'
}

const { formAction, label, variant = 'default' } = Astro.props
const isCompact = variant === 'compact'
const headingId = `newsletter-heading-${variant}`
const emailId = `newsletter-email-${variant}`
---

<section aria-label={label} aria-labelledby={label ? undefined : headingId} data-animate class="panel-card overflow-hidden">
  <div
    class:list={[
      'p-6 sm:p-8',
      isCompact ?
        'space-y-4' :
        'flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-8'
    ]}
  >
    <div class="max-w-xl space-y-2">
      <p class="section-label">
        Updates
      </p>
      <h2 class="text-lg font-semibold tracking-tight text-ink" id={headingId}>
        Get new posts in your inbox
      </h2>
      <p class="text-sm/6 text-ink-soft">
        Low volume — engineering notes, architecture writeups, and occasional career updates.
        Prefer a feed?{' '}
        <a
          class="
            font-medium text-brand underline-offset-2
            hover:underline
          "
          href="/feed.xml"
        >
          Subscribe via RSS
        </a>
        .
      </p>
      <p class="text-xs text-ink-muted">
        We never share your email.{' '}
        <a
          class="
            text-ink-muted underline-offset-2
            hover:text-brand hover:underline
          "
          href="/privacy/"
        >
          Privacy policy
        </a>
        .
      </p>
    </div>

    <form
      action={formAction}
      class="
        flex w-full min-w-0 flex-col gap-3
        sm:max-w-xs
      "
      method="post"
      data-newsletter-form
    >
      <input name="embed" type="hidden" value="1" />
      <label class="sr-only" for={emailId}>Email address</label>
      <input
        autocomplete="email"
        class="
          min-h-11 w-full rounded-2xl border border-line/70 bg-surface px-4
          py-2.5 text-sm text-ink shadow-inner shadow-ink/5 transition
          outline-none
          placeholder:text-ink-muted
          focus:border-brand/45 focus:ring-2 focus:ring-brand/20
        "
        id={emailId}
        inputmode="email"
        name="email"
        placeholder="you@company.com"
        required
        type="email"
      />
      <button
        class="
          inline-flex min-h-11 w-full items-center justify-center gap-2
          rounded-2xl bg-brand-solid px-4 py-2.5 text-sm font-semibold
          text-white shadow-md shadow-brand/25 transition
          hover:brightness-110
          active:scale-[0.99]
          motion-reduce:transition-none
          motion-reduce:active:scale-100
        "
        type="submit"
      >
        <Icon aria-hidden="true" class="size-4 shrink-0" name="tabler:send" />
        Subscribe
      </button>
    </form>
  </div>
</section>

<script>
  function setupNewsletterForms() {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault()
        const data = new FormData(form)
        const params = new URLSearchParams(data as unknown as Record<string, string>).toString()
        window.open(`${form.action}?${params}`, '_blank', 'noopener,noreferrer')
      })
    })
  }

  setupNewsletterForms()
  document.addEventListener('astro:after-swap', setupNewsletterForms)
</script>
