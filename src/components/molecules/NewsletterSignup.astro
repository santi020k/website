---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { Button, Card, Icon, Input, Link } from '@santi020k/lumen-astro'

interface Props {
  formAction: string

  /** Distinguishes fields and headings when multiple signups share a page. */
  idSuffix?: string
}

const { formAction, idSuffix = 'compact' } = Astro.props
const emailId = `newsletter-email-${idSuffix}`
const headingId = `newsletter-heading-${idSuffix}`
---

<Card data-newsletter variant="unstyled">
  <header data-newsletter-header>
    <div data-newsletter-masthead>
      <p data-newsletter-eyebrow>Newsletter</p>
      <span data-newsletter-postmark><Icon class="size-7" name="mail" /></span>
    </div>
    <h2 id={headingId}>Keep up with new writing.</h2>
    <p data-newsletter-description>
      A low-volume email with new posts on software, reading, gaming, and everyday discoveries.
    </p>
  </header>
  <form
    action={formAction}
    aria-labelledby={headingId}
    method="post"
    rel="noopener noreferrer"
    target="_blank"
    data-newsletter-form
  >
    <input name="embed" type="hidden" value="1" />
    <label data-newsletter-label for={emailId}>Email address</label>
    <div data-newsletter-controls>
      <Input
        autocomplete="email"
        data-newsletter-email
        id={emailId}
        inputmode="email"
        name="email"
        placeholder="your@email.com"
        required
        type="email"
      />
      <Button
        data-newsletter-submit
        type="submit"
      >
        <span data-newsletter-submit-content>
          <span data-newsletter-submit-label>Subscribe</span>
          <ArrowExchange class="size-4 shrink-0" direction="up-right" />
        </span>
      </Button>
    </div>
  </form>
  <footer data-newsletter-footer>
    <p>
      Monthly at most. Unsubscribe anytime.<br />
      <Link className="privacy-inline-link" href="/privacy/" variant="inherit">Privacy</Link>
    </p>
    <a data-newsletter-rss data-text-link href="/feed.xml">
      <Icon class="size-4" name="rss" />
      <span data-text-link-label>RSS</span>
    </a>
  </footer>
</Card>

<style>
  [data-newsletter][data-slot='card'] {
    --newsletter-accent: var(--brand);
    container: newsletter / inline-size;
    min-width: 0;
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 0.375rem 1.75rem 1.75rem 1.75rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  :global(:root[data-theme='dark']) [data-newsletter] { --newsletter-accent: var(--accent); }
  [data-newsletter-header] { padding: 1.75rem; border-radius: 0.3125rem 1.6875rem 0 0; background: hsl(var(--brand-soft)); }
  [data-newsletter-masthead] { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 0; margin-bottom: 1rem; }
  [data-newsletter-eyebrow] { margin: 0; color: color-mix(in srgb, hsl(var(--newsletter-accent)) 80%, hsl(var(--ink))); font-size: 0.625rem; line-height: 1.8; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase; }
  [data-newsletter] h2 { max-width: 18ch; margin: 0; color: hsl(var(--ink)); font-size: 2.5rem; line-height: 1.2; font-weight: 500; letter-spacing: -0.05em; }
  [data-newsletter-description] { max-width: 52ch; margin: 1.125rem 0 0; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.85; }
  [data-newsletter-postmark] { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; color: hsl(var(--newsletter-accent)); }
  [data-newsletter-form] { min-width: 0; margin: 0; padding: 1.5rem 1.75rem; }
  [data-newsletter-label] { display: block; margin-bottom: 0.5rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.6; font-weight: 500; }
  [data-newsletter-controls] { display: flex; align-items: stretch; gap: 0.5rem; min-width: 0; }
  [data-newsletter-email] { flex: 1; width: 100%; min-width: 0; min-height: 2.75rem; height: auto; padding: 0.625rem 0.75rem; border: 1px solid hsl(var(--line)); border-radius: 0.75rem; background: hsl(var(--surface)); color: hsl(var(--ink)); font-size: 1rem; line-height: 1.5; }
  [data-newsletter-email]::placeholder { color: hsl(var(--ink-soft)); opacity: 1; }
  [data-newsletter-submit] { flex-shrink: 0; min-width: 2.75rem; min-height: 2.75rem; max-width: 100%; height: auto; padding: 0.625rem 1rem; border: 1px solid hsl(var(--ink)); border-radius: 0.75rem; background: hsl(var(--ink)); color: hsl(var(--surface)); font-size: 0.75rem; line-height: 1.6; font-weight: 500; white-space: normal; transition: background-color 160ms ease; }
  [data-newsletter-submit], [data-newsletter-submit]:hover { box-shadow: none; }
  [data-newsletter-submit]:hover { background: hsl(var(--ink-soft)); }
  [data-newsletter-submit-content] { display: flex; align-items: center; justify-content: center; gap: 0.625rem; min-width: 0; }
  [data-newsletter-footer] { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-inline: 1.75rem; padding: 0.75rem 0 1.25rem; border-top: 1px solid hsl(var(--line)); }
  [data-newsletter-footer] p { margin: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.8; }
  [data-newsletter-rss] { display: inline-flex; flex-shrink: 0; align-items: center; gap: 0.375rem; min-width: 2.75rem; min-height: 2.75rem; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.5; }
  @container newsletter (width < 25rem) {
    [data-newsletter] h2 { font-size: 2rem; }
    [data-newsletter-controls] { flex-direction: column; }
    [data-newsletter-footer] { flex-direction: column; align-items: start; gap: 0.25rem; }
  }
  @container newsletter (width < 18rem) {
    [data-newsletter-header], [data-newsletter-form] { padding: 1.375rem; }
    [data-newsletter-footer] { margin-inline: 1.375rem; }
    [data-newsletter] h2 { font-size: 1.5rem; }
    [data-newsletter-postmark] { display: none; }
  }
  @container newsletter (width < 13rem) {
    [data-newsletter-header], [data-newsletter-form] { padding: 0.75rem; }
    [data-newsletter-footer] { margin-inline: 0.75rem; }
    [data-newsletter] h2 { font-size: 1.125rem; }
    [data-newsletter-submit-content] > :last-child { display: none; }
  }
  @container newsletter (width < 10rem) {
    [data-newsletter] h2 { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-newsletter-submit] { transition: none; }
  }
</style>
