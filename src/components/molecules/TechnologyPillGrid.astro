---
import Pill from '@/components/atoms/Pill.astro'
import PillCount from '@/components/atoms/PillCount.astro'

import { getTechnologyPath } from '@/utils/links'

interface Props {
  hiddenCount?: number
  intro: string
  technologies: [string, number][]
}

const { hiddenCount = 0, intro, technologies } = Astro.props
---

<div class="space-y-5">
  <p class="max-w-3xl text-sm/6 text-ink-muted">{intro}</p>
  <div class="flex flex-wrap gap-3">
    {technologies.map(([technology, count]) => (
      <Pill href={getTechnologyPath(technology)} label={technology} tone="outline">
        <PillCount count={count} />
      </Pill>
    ))}
    {hiddenCount > 0 && (
      <Pill href="/technologies/" label={`+${hiddenCount} technologies`} tone="neutral" />
    )}
  </div>
</div>
