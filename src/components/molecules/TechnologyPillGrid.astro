---
import Pill from '@/components/atoms/Pill.astro'

import { getTechnologyPath } from '@/utils/links'

import { AnimatedNumber, Card } from '@santi020k/lumen-astro'

interface Props {
  hiddenCount?: number
  intro: string
  technologies: [string, number][]
}

const { hiddenCount = 0, intro, technologies } = Astro.props
const featuredTechnologies = technologies.slice(0, 6)
const supportingTechnologies = technologies.slice(6)
const totalTechnologyCount = technologies.length + hiddenCount
---

<Card
  class="rounded-3xl p-0"
  data-technology-snapshot
  variant="default"
>
  <div
    data-technology-snapshot-body
    class="
      space-y-6 p-5
      sm:p-6
      lg:p-7
    "
  >
    <div class="grid gap-5" data-technology-snapshot-header>
      <div class="max-w-2xl space-y-2">
        <p class="
          section-label text-brand
          dark:text-accent
        "
        >
          Stack snapshot
        </p>
        <p class="text-sm/6 text-ink-soft">{intro}</p>
      </div>

      <dl data-technology-snapshot-stats>
        <div>
          <dt class="text-xs text-ink-muted">Highlighted</dt>
          <dd class="mt-1 text-xl font-medium tracking-[-0.055em] text-ink"><AnimatedNumber locale="en-US" value={technologies.length} /></dd>
        </div>
        <div>
          <dt class="text-xs text-ink-muted">Full index</dt>
          <dd class="mt-1 text-xl font-medium tracking-[-0.055em] text-ink"><AnimatedNumber locale="en-US" value={totalTechnologyCount} /></dd>
        </div>
      </dl>
    </div>

    <div class="h-px bg-line/65"></div>

    <div class="space-y-6">
      <div class="space-y-3">
        <div class="
          flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1
        "
        >
          <h3 class="site-label">Top of mind</h3>
          <p class="text-xs/5 text-ink-muted">The tools I’m most interested in reaching for.</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {featuredTechnologies.map(([technology, count]) => (
            <Pill
              count={count}
              href={getTechnologyPath(technology)}
              label={technology}
              tone="brand"
            />
          ))}
        </div>
      </div>

      {(supportingTechnologies.length > 0 || hiddenCount > 0) && (
        <div class="space-y-3">
          <div class="
            flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1
          "
          >
            <h3 class="site-label">In rotation</h3>
            <p class="text-xs/5 text-ink-muted">Supporting tools across delivery, testing, and DX.</p>
          </div>
          <div class="flex flex-wrap gap-2.5">
            {supportingTechnologies.map(([technology, count]) => (
              <Pill
                count={count}
                href={getTechnologyPath(technology)}
                label={technology}
                tone="outline"
              />
            ))}
            {hiddenCount > 0 && (
              <Pill
                href="/technologies/"
                label={`Explore ${hiddenCount} more`}
                tone="neutral"
              />
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</Card>

<style>
  [data-technology-snapshot] { container: technology-snapshot / inline-size; }
  [data-technology-snapshot] :global([data-site-pill]) { font-weight: 500; }
  [data-technology-snapshot-stats] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  [data-technology-snapshot-stats] > div + div {
    border-inline-start: 1px solid hsl(var(--line) / 0.65);
    padding-inline-start: 1.5rem;
  }
  @container technology-snapshot (width >= 36rem) {
    [data-technology-snapshot-header] { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    [data-technology-snapshot-stats] { text-align: end; }
  }
  @container technology-snapshot (width < 20rem) {
    [data-technology-snapshot-body] { padding: 0.75rem; }
    [data-technology-snapshot] :global([data-site-pill]) { padding-inline: 0.25rem; }
    [data-technology-snapshot] :global(.ui-pill__count) { margin-inline-start: 0; padding-inline-start: 0.25rem; }
  }
  @container technology-snapshot (width < 18rem) {
    [data-technology-snapshot-stats] { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    [data-technology-snapshot-stats] > div + div {
      border-inline-start: 0;
      border-top: 1px solid hsl(var(--line) / 0.65);
      padding-inline-start: 0;
      padding-top: 1rem;
    }
  }
</style>
