---
import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getTechnologyPath } from '@/utils/links'

import { AnimatedNumber, Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  projectCount: number
  technologies: [string, number][]
  totalTechnologyCount: number
}

interface TechnologyLedgerGroup {
  copy: string
  headingId: string
  label: string
  ledger: 'featured' | 'supporting'
  technologies: [string, number][]
}

const { projectCount, technologies, totalTechnologyCount } = Astro.props
const featuredTechnologies = technologies.slice(0, 6)
const supportingTechnologies = technologies.slice(6)
const singleTechnologyKey = projectCount === 1 ? 'technology.snapshotOneOne' : 'technology.snapshotOneMany'
const multipleTechnologiesKey = projectCount === 1 ? 'technology.snapshotManyOne' : 'technology.snapshotManyMany'
const scopeKey = technologies.length === 1 ? singleTechnologyKey : multipleTechnologiesKey

const ledgerGroups: TechnologyLedgerGroup[] = [
  {
    copy: t('collection.theToolsIMMostInterested'),
    headingId: 'technology-top-of-mind',
    label: t('collection.topOfMind'),
    ledger: 'featured',
    technologies: featuredTechnologies
  },
  {
    copy: t('collection.supportingToolsAcrossDeliveryTestingAnd'),
    headingId: 'technology-in-rotation',
    label: t('collection.inRotation'),
    ledger: 'supporting',
    technologies: supportingTechnologies
  }
]
---

<Card
  data-technology-snapshot
  id="technology-snapshot"
  variant="unstyled"
>
  <div data-technology-snapshot-header>
    <div class="space-y-3">
      <p data-technology-snapshot-eyebrow>{t('collection.behindTheProjects')}</p>
      <h2 data-technology-snapshot-title id="technology-snapshot-heading">{t('collection.followTheStack')}</h2>
    </div>

    <dl data-technology-snapshot-stats>
      <div>
        <dt>{t('collection.technologiesUsed')}</dt>
        <dd><AnimatedNumber locale={locale === 'es' ? 'es-419' : 'en-US'} value={totalTechnologyCount} /></dd>
      </div>
    </dl>
  </div>

  <div data-technology-snapshot-body>
    <p data-technology-snapshot-scope>
      {t(scopeKey, { count: technologies.length, projects: projectCount })}
    </p>
    {ledgerGroups.filter(group => group.ledger === 'featured' || group.technologies.length > 0).map(group => (
      <div class="space-y-3">
        <div class="space-y-1">
          <h3 class="site-label" id={group.headingId}>{group.label}</h3>
          <p class="text-xs/5 text-ink-muted">{group.copy}</p>
        </div>
        <ul aria-labelledby={group.headingId} data-technology-ledger={group.ledger}>
          {group.technologies.map(([technology, count]) => (
            <li>
              <a href={localizePath(getTechnologyPath(technology), locale)}>
                <span>{technology}</span>
                <span data-technology-count>{count}<span class="sr-only"> {count === 1 ? t('collection.project') : t('collection.projects')}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div data-technology-snapshot-footer>
    <Link data-technology-snapshot-more href={localizePath('/technologies/', locale)} variant="inherit">
      <span>{t('collection.exploreTheFullTechnologyIndex')}</span>
      <ArrowExchange direction="right" size="sm" />
    </Link>
  </div>
</Card>

<style>
  [data-technology-snapshot][data-slot='card'] {
    --technology-ledger-accent: var(--brand);
    container: technology-snapshot / inline-size;
    scroll-margin-top: 7rem;
    overflow: hidden;
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 1.75rem 0.5rem 1.75rem;
    background: hsl(var(--surface));
    padding: 0;
  }
  :global([data-theme='dark']) [data-technology-snapshot] { --technology-ledger-accent: var(--accent); }
  [data-technology-snapshot-header] {
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem;
    background: hsl(var(--brand-soft));
  }
  [data-technology-snapshot-title] {
    color: hsl(var(--ink));
    font-size: 2.125rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.055em;
  }
  [data-technology-snapshot-eyebrow] { color: color-mix(in srgb, hsl(var(--technology-ledger-accent)) 85%, hsl(var(--ink))); font-size: 0.75rem; line-height: 1.6; }
  [data-technology-snapshot-body] { display: grid; gap: 1.75rem; padding: 1.75rem; }
  [data-technology-snapshot-scope] { max-width: 54rem; color: hsl(var(--ink-soft)); font-size: 0.875rem; line-height: 1.8; }
  [data-technology-snapshot-stats] > div { display: flex; flex-direction: column; gap: 0.375rem; }
  [data-technology-snapshot-stats] dt { color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.6; }
  [data-technology-snapshot-stats] dd { order: -1; color: hsl(var(--technology-ledger-accent)); font-size: 2.5rem; line-height: 1.2; font-weight: 500; letter-spacing: -0.055em; }
  [data-technology-ledger] { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 1.5rem; }
  [data-technology-ledger] li { min-width: 0; border-bottom: 1px solid hsl(var(--line)); }
  [data-technology-ledger] a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    height: 100%;
    min-height: 3.25rem;
    padding-block: 0.875rem;
    color: hsl(var(--ink));
    font-size: 0.875rem;
    line-height: 1.375rem;
    font-weight: 500;
    text-decoration: none;
  }
  [data-technology-ledger='featured'] a { font-size: 1.0625rem; line-height: 1.625rem; }
  [data-technology-count] { flex-shrink: 0; color: hsl(var(--ink-soft)); font-size: 0.75rem; line-height: 1.25rem; }
  [data-technology-ledger='featured'] [data-technology-count] { color: hsl(var(--technology-ledger-accent)); }
  [data-technology-snapshot-footer] { border-top: 1px solid hsl(var(--line)); padding: 0.75rem 1.75rem; }
  [data-technology-snapshot-footer] :global([data-technology-snapshot-more]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: hsl(var(--ink));
    font-size: 0.875rem;
    line-height: 1.6;
    font-weight: 400;
    text-decoration: none;
  }
  [data-technology-ledger] a:is(:hover, :focus-visible) { color: hsl(var(--technology-ledger-accent)); }
  [data-technology-snapshot-footer] :global([data-technology-snapshot-more]:is(:hover, :focus-visible)) { color: hsl(var(--technology-ledger-accent)); text-decoration: underline; text-underline-offset: 0.25em; }
  @container technology-snapshot (width >= 36rem) {
    [data-technology-snapshot-header] { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    [data-technology-snapshot-stats] { text-align: end; }
  }
  @container technology-snapshot (width < 36rem) {
    [data-technology-snapshot-stats] > div { flex-direction: row; flex-wrap: wrap; align-items: baseline; column-gap: 0.75rem; }
  }
  @container technology-snapshot (width < 32rem) {
    [data-technology-ledger] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container technology-snapshot (width < 20rem) {
    [data-technology-snapshot-header], [data-technology-snapshot-body] { padding: 1.25rem; }
    [data-technology-snapshot-footer] { padding-inline: 1.25rem; }
    [data-technology-snapshot-title] { font-size: 1.875rem; }
    [data-technology-ledger] { grid-template-columns: minmax(0, 1fr); }
    [data-technology-ledger='featured'] a { font-size: 1rem; }
  }
</style>
