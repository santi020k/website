---
import ProjectPreviewViewer from '@/components/molecules/ProjectPreviewViewer.astro'

import { Card, Image } from '@santi020k/lumen-astro'

import { getLocale } from '@/i18n'
import { projectStoryTranslator } from '@/i18n/project-story'
import type { ProjectPreviewImage } from '@/types'

const t = projectStoryTranslator(getLocale(Astro.url.pathname))

interface Props {
  id: string
  label: string
  context: string
  before: ProjectPreviewImage
  after: ProjectPreviewImage
}

const { id, label, context, before, after } = Astro.props

const entries = [
  { state: t('comparison.before'), key: 'before', preview: before },
  { state: t('comparison.after'), key: 'after', preview: after }
]
---

<Card
as="section"
aria-label={t('comparison.beforeAndAfter', { label })}
class="not-prose"
data-project-comparison
id={id}
variant="unstyled"
>
  <div data-comparison-topline><span>{label}</span><span>{context}</span></div>
  <div data-comparison-pair>
    {entries.map(({ state, key, preview }) => (
      <figure data-comparison-version={key}>
        <figcaption>
          <span data-comparison-state>{state}</span>
          <h4 data-comparison-title>{preview.title}</h4>
        </figcaption>
        <Image
          alt={preview.alt}
          data-comparison-image
          fit="contain"
          format="webp"
          loading="lazy"
          radius="none"
          sizes="(min-width: 1280px) 360px, (min-width: 1024px) 30vw, (min-width: 640px) calc((100vw - 128px) / 2), calc(100vw - 88px)"
          src={preview.src}
          widths={[320, 480, 640, 960, 1280]}
        />
        <ProjectPreviewViewer id={`${id}-${key}`} preview={preview} />
      </figure>
    ))}
  </div>
</Card>

<style>
  [data-project-comparison] { container: project-comparison / inline-size; margin-block: 1.75rem 2.5rem; overflow: hidden; border: 1px solid hsl(var(--line)); border-radius: var(--radius-sheet); background: hsl(var(--surface)); }
  [data-comparison-topline] { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; padding: 1rem 1.5rem; border-bottom: 1px solid hsl(var(--line)); color: hsl(var(--ink-soft)); font: 400 0.75rem/1.75 var(--font-sans); }
  [data-comparison-topline] span:first-child, [data-comparison-state] { color: hsl(var(--brand)); }
  :global(:root[data-theme='santi020k-dark']) [data-comparison-topline] span:first-child,
  :global(:root[data-theme='santi020k-dark']) [data-comparison-state] { color: hsl(var(--accent)); }
  :global(:root[data-theme='santi020k-dark']) [data-comparison-version='after'] [data-comparison-state] { color: hsl(var(--ink-soft)); }
  [data-comparison-pair] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  [data-comparison-version] { display: grid; grid-template-rows: subgrid; grid-row: span 3; min-width: 0; margin: 0; padding: 1.25rem; }
  [data-comparison-version='after'] { border-left: 1px solid hsl(var(--line)); background: hsl(var(--brand-soft)); }
  [data-comparison-version] figcaption { margin: 0 0 1.25rem; }
  [data-comparison-state] { display: block; margin-bottom: 0.5rem; font: 400 0.75rem/1.75 var(--font-sans); }
  [data-comparison-title] { margin: 0; padding: 0; border: 0; color: hsl(var(--ink)); font: 500 1.125rem/1.5 var(--font-sans); letter-spacing: -0.025em; }
  [data-comparison-image] { display: block; width: 100%; height: auto; object-fit: contain; }
  @container project-comparison (width < 32.5rem) {
    [data-comparison-pair] { grid-template-columns: minmax(0, 1fr); }
    [data-comparison-version='after'] { border-left: 0; border-top: 1px solid hsl(var(--line)); }
  }
  @container project-comparison (width < 18rem) {
    [data-comparison-topline], [data-comparison-version] { padding: 1rem; }
  }
</style>
