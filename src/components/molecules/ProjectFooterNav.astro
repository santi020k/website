---
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { getProjectPrimaryDestination } from '@/utils/project-destinations'

import { Card, Link } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator, localizeCollectionSource } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  hasProductPreviews?: boolean
  project?: CollectionEntry<'project'>
  parentPage: { name: string, url: string }
  variant?: 'folio' | 'colophon'
}

const { hasProductPreviews = false, project, parentPage, variant = 'folio' } = Astro.props
const { closingLinks = [], githubUrl, liveDemoUrl, previews } = project?.data ?? {}
const destination = project ? getProjectPrimaryDestination(project.data) : undefined
---

<footer data-reading-actions data-return-variant={variant} data-return-unified={closingLinks.length > 0 || undefined} id={project ? 'project-return' : undefined}>
  <Card variant="unstyled" data-return-folio>
    <nav aria-label={t('collection.pageEndNavigation')}>
      <div data-return-row>
        <Link href={localizePath(parentPage.url, locale)} variant="inherit" data-return-link>
          <span data-return-mark><ArrowExchange data-return-icon direction="left" /></span>
          <span data-return-copy>
            <span data-return-kicker>{t('collection.backTo')}</span>
            <span data-return-destination>{localizeCollectionSource(locale, parentPage.name)}</span>
          </span>
        </Link>
        <Link href="#main" variant="inherit" data-return-top>
          <span>{t('collection.backToTop')}</span>
          <ArrowExchange data-return-icon direction="up" />
        </Link>
      </div>
      {(liveDemoUrl || githubUrl || hasProductPreviews || closingLinks.length > 0) && (
        <div data-return-destinations>
          {liveDemoUrl && destination && (
            <Link href={liveDemoUrl} newTab variant="inherit">
              <span>{localizeCollectionSource(locale, destination.action)}</span>
              <ArrowExchange data-return-icon direction="up-right" />
            </Link>
          )}
          {closingLinks.map(link => (
            <Link href={localizePath(link.href, locale)} newTab variant="inherit">
              <span>{localizeCollectionSource(locale, link.label)}</span>
              <ArrowExchange data-return-icon direction="up-right" />
            </Link>
          ))}
          {hasProductPreviews && (
            <Link href="#inside-the-product" variant="inherit">
              <span>{localizeCollectionSource(locale, previews?.linkLabel ?? 'View product previews')}</span>
              <ArrowExchange data-return-icon direction="up" />
            </Link>
          )}
          {githubUrl && (
            <Link href={githubUrl} newTab variant="inherit">
              <span>{t('collection.openRepository')}</span>
              <ArrowExchange data-return-icon direction="up-right" />
            </Link>
          )}
        </div>
      )}
    </nav>
  </Card>
</footer>

<style>
  footer {
    --return-accent: hsl(var(--brand));
  }

  :global([data-theme="santi020k-dark"]) footer {
    --return-accent: color-mix(in srgb, hsl(var(--accent)) 80%, hsl(var(--ink)));
  }

  footer :global([data-return-folio]) {
    border: 1px solid hsl(var(--line));
    border-radius: 1.75rem 0.375rem 1.75rem 0.375rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
  }

  nav :global(a) {
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    max-width: 100%;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  nav :global(a:hover) {
    color: var(--return-accent);
  }

  nav :global(a:focus-visible) {
    border-radius: 0.25rem;
    outline: 2px solid var(--return-accent);
    outline-offset: 4px;
  }

  nav [data-return-icon] {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  nav [data-return-icon] :global(svg) { width: 100%; height: 100%; }

  span {
    min-width: 0;
  }

  [data-return-row] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
  }

  nav :global([data-return-link]) {
    gap: 1.125rem;
  }

  [data-return-mark] {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    place-items: center;
    border-radius: 50%;
    background: hsl(var(--brand-soft));
    color: var(--return-accent);
  }

  [data-return-copy] {
    display: grid;
    gap: 0.1875rem;
  }

  [data-return-kicker] {
    color: hsl(var(--ink-soft));
    font-size: 0.75rem;
  }

  [data-return-destination] {
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
  }

  nav :global([data-return-top]) {
    flex-shrink: 0;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  [data-return-destinations] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    border-top: 1px solid hsl(var(--line));
    padding: 0.8125rem 1.75rem;
  }

  [data-return-destinations] :global(a) {
    min-width: 11.25rem;
    flex: 1;
    justify-content: space-between;
    gap: 1.25rem;
  }

  [data-return-destinations] [data-return-icon] {
    width: 1rem;
    height: 1rem;
    color: var(--return-accent);
  }

  @container reading-actions (width < 28.75rem) {
    [data-return-row] {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      padding: 1.375rem;
    }

    nav :global([data-return-link]) {
      gap: 0.875rem;
    }

    [data-return-destination] {
      font-size: 1.375rem;
    }

    [data-return-destinations] {
      gap: 0.25rem;
      padding: 0.75rem 1.375rem;
    }

    [data-return-destinations] :global(a) {
      min-width: 0;
      flex-basis: 100%;
    }
  }

  @container reading-actions (width < 18rem) {
    [data-return-mark] {
      display: none;
    }

    [data-return-row],
    [data-return-destinations] {
      padding-inline: 1rem;
    }
  }
  @container reading-actions (width < 12rem) {
    [data-return-row],
    [data-return-destinations] {
      padding-inline: 0.75rem;
    }

    [data-return-destination] {
      font-size: 1rem;
    }

    [data-return-destinations] :global(a) {
      gap: 0.5rem;
    }

    nav [data-return-icon] {
      display: none;
    }
  }
  footer[data-return-variant='colophon'] :global([data-return-folio]) {
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  [data-return-variant='colophon'] [data-return-row] {
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 0 0;
  }
  [data-return-variant='colophon'] :global([data-return-link]) { gap: 0.875rem; }
  [data-return-variant='colophon'] [data-return-mark] {
    display: flex;
    width: 1rem;
    height: 1rem;
    border-radius: 0;
    background: transparent;
    color: inherit;
  }
  [data-return-variant='colophon'] [data-return-icon] { width: 1rem; height: 1rem; }
  [data-return-variant='colophon'] [data-return-copy] { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  [data-return-variant='colophon'] [data-return-kicker],
  [data-return-variant='colophon'] [data-return-destination] {
    color: inherit;
    font-size: 0.8125rem;
    line-height: 1.6;
    letter-spacing: normal;
  }
  [data-return-variant='colophon'] :global([data-return-top]) { color: hsl(var(--ink-soft)); flex-shrink: 1; }

  [data-return-unified] [data-return-row] { gap: 1.25rem; padding: 1.25rem 1.5rem; }
  [data-return-unified] :global([data-return-link]) { gap: 0.75rem; }
  [data-return-unified] [data-return-mark] { width: 1rem; height: 1rem; border-radius: 0; background: transparent; color: hsl(var(--ink-soft)); }
  [data-return-unified] [data-return-mark] [data-return-icon] { width: 1rem; height: 1rem; }
  [data-return-unified] [data-return-kicker] { font-size: 0.6875rem; }
  [data-return-unified] [data-return-destination] { font-size: 0.9375rem; line-height: 1.7; letter-spacing: normal; }
  [data-return-unified] [data-return-destinations] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 0 1.5rem 1.25rem;
    padding: 0.75rem 0 0;
  }
  [data-return-unified] [data-return-destinations] :global(a) { min-width: 0; padding-block: 0.5rem; color: var(--return-accent); font-size: 0.8125rem; font-weight: 400; }
  [data-return-unified] [data-return-destinations] :global(a:hover) { text-decoration: underline; text-underline-offset: 0.25rem; }

  @container reading-actions (width < 35rem) {
    [data-return-unified] [data-return-row] { padding-inline: 1.125rem; gap: 0.75rem; }
    [data-return-unified] [data-return-destinations] { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; margin-inline: 1.125rem; }
  }
</style>
