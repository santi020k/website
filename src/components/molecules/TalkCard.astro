---
import { Card } from '@santi020k/lumen-astro'

interface Props {
  description: string
  index?: number
  title: string
  variant: 'topic' | 'format'
}

const { description, index, title, variant } = Astro.props
---

<Card
  as="article"
  class="
    h-full space-y-4 p-6
    sm:p-7
  "
  data-talk-card={variant}
>
  {index !== undefined && (
    <p aria-hidden="true" class="text-sm font-semibold text-brand">
      {String(index + 1).padStart(2, '0')}
    </p>
  )}
  <h3 class:list={[
    'text-ink',
    variant === 'topic' && `
      text-xl font-semibold
      sm:text-2xl
    `,
    variant === 'format' && 'section-label'
  ]}
  >{title}</h3>
  <p class:list={[
    'text-ink-soft',
    variant === 'topic' && 'text-sm/7',
    variant === 'format' && 'text-base/7'
  ]}
  >{description}</p>
</Card>
