---
import { Card, Icon, Link } from '@santi020k/lumen-astro'

import type { SpeakingFormat, SpeakingTopic } from '@/data/profile'

interface Props {
  description: string
  index?: number
  outcome?: SpeakingFormat['outcome'] & { href: string }
  source?: SpeakingTopic['source']
  subtitle?: string
  title: string
  variant: 'topic' | 'format'
}

const { description, index, outcome, source, subtitle, title, variant } = Astro.props
const readingSource = variant === 'topic' ? source : undefined
const formatOutcome = variant === 'format' ? outcome : undefined
const hasCaption = Boolean(readingSource ?? formatOutcome)
---

<Card
  as="article"
  class:list={[
    `
      card-hierarchy h-full p-6
      sm:p-7
    `,
    hasCaption && 'flex flex-col'
  ]}
  data-talk-card={variant}
  data-talk-caption={hasCaption ? '' : undefined}
>
  {index !== undefined && (
    <p aria-hidden="true" class="text-sm font-semibold text-brand">
      {String(index + 1).padStart(2, '0')}
    </p>
  )}
  <h3 class="text-ink">
    <span data-card-title data-talk-title>{title}</span>
    {subtitle && <> <span data-card-subtitle data-talk-subtitle>{subtitle}</span></>}
  </h3>
  <p class="text-sm/7 text-ink-soft">{description}</p>
  {readingSource && (
    <footer data-talk-source>
      <p>Read the approach</p>
      <Link href={readingSource.href} variant="inherit">
        <span>{readingSource.label}</span><Icon data-talk-source-icon name="arrow-up-right" size="sm" />
      </Link>
    </footer>
  )}
  {formatOutcome && (
    <footer data-talk-outcome>
      <p>Good fit</p>
      <p data-talk-fit>{formatOutcome.fit}</p>
      <Link href={formatOutcome.href} variant="inherit">
        <span>{formatOutcome.label}</span><Icon data-talk-outcome-icon name="arrow-down-right" size="sm" />
      </Link>
    </footer>
  )}
</Card>

<style>
  [data-talk-caption] { padding-bottom: 1.5rem; }
  :is([data-talk-source], [data-talk-outcome]) { margin-top: auto; padding-top: 1.75rem; }
  :is([data-talk-source], [data-talk-outcome]) > p:first-child { margin-bottom: 0.5rem; padding-top: 1.25rem; border-top: 1px solid hsl(var(--line)); color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.8; letter-spacing: 0.08em; text-transform: uppercase; }
  :is([data-talk-source], [data-talk-outcome]) :global(a) { display: flex; min-height: 2.75rem; align-items: center; justify-content: space-between; gap: 1rem; color: hsl(var(--ink)); font-size: 0.8125rem; line-height: 1.8; text-decoration: none; }
  :is([data-talk-source], [data-talk-outcome]) span { min-width: 0; overflow-wrap: anywhere; }
  :is([data-talk-source], [data-talk-outcome]) :global([data-talk-source-icon], [data-talk-outcome-icon]) { flex-shrink: 0; color: hsl(var(--brand)); }
  :is([data-talk-source], [data-talk-outcome]) :global(a:hover) span { color: hsl(var(--brand)); text-decoration: underline; text-underline-offset: 0.25rem; }
  :is([data-talk-source], [data-talk-outcome]) :global(a:focus-visible) { outline: 2px solid hsl(var(--brand)); outline-offset: 0.25rem; }
  [data-talk-fit] { margin-bottom: 0.75rem; color: hsl(var(--ink)); font-size: 0.875rem; font-weight: 500; line-height: 1.75; }
</style>
