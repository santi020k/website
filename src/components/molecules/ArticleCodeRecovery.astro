---
import { Button, Icon } from '@santi020k/lumen-astro'

import { getLocale, sharedTranslator } from '@/i18n'

const t = sharedTranslator(getLocale(Astro.url.pathname))

---

<template data-code-recovery-template>
  <div data-code-recovery lang={getLocale(Astro.url.pathname)}>
    <div data-code-recovery-message>
      <p data-code-recovery-title>{t('clipboard.failure')}</p>
      <p data-code-recovery-status role="status">{t('shared.selectTheCodeAndCopyIt')}</p>
    </div>
    <Button data-select-code size="sm" variant="outline">
      <Icon name="text-select" />
      {t('shared.selectCode')}
    </Button>
  </div>
</template>

<script>
  import { getLocale, sharedTranslator } from '@/i18n'

  const clientTranslate = sharedTranslator(() => getLocale(window.location.pathname))

  const articleCodeForEvent = (event: Event): HTMLElement | null => {
    if (!(event.target instanceof HTMLButtonElement) || !event.target.matches('[data-ui-code-copy]')) return null

    return event.target.closest<HTMLElement>(
      '[data-article-prose] :is([data-article-code-folio], [data-package-manager-code-tabs] [data-ui-code])'
    )
  }

  const showCodeRecovery = (event: Event) => {
    const figure = articleCodeForEvent(event)
    const template = document.querySelector<HTMLTemplateElement>('[data-code-recovery-template]')
    const heading = figure?.querySelector(':scope > figcaption')
    const pre = figure?.querySelector<HTMLElement>('[data-code-complete], pre')
    const code = pre?.querySelector('code')

    if (!figure || !template || !heading || !pre || !code || figure.closest('[role="tabpanel"][hidden]')) return

    const existing = figure.querySelector<HTMLElement>('[data-code-recovery-status]')

    if (existing) {
      existing.textContent = clientTranslate('shared.selectTheCodeAndCopyIt')

      return
    }

    const recovery = template.content.firstElementChild?.cloneNode(true)

    if (!(recovery instanceof HTMLElement)) return

    const button = recovery.querySelector<HTMLButtonElement>('[data-select-code]')
    const status = recovery.querySelector<HTMLElement>('[data-code-recovery-status]')

    if (!button || !status) return

    button.addEventListener('click', () => {
      const selection = window.getSelection()

      if (!selection) return

      const disclosure = pre.closest('details')

      if (disclosure) disclosure.open = true

      pre.focus({ preventScroll: true })

      const range = document.createRange()

      range.selectNodeContents(code)

      selection.removeAllRanges()

      selection.addRange(range)

      pre.scrollIntoView({ behavior: 'instant', block: 'start' })

      status.textContent = clientTranslate('shared.codeSelectedUseYourKeyboardOr')
    })

    heading.after(recovery)
  }

  document.addEventListener('ui:copy-error', showCodeRecovery)

  document.addEventListener('ui:copy-success', event => {
    articleCodeForEvent(event)?.querySelector('[data-code-recovery]')?.remove()
  })

  document.addEventListener('ui:tabs-change', event => {
    if (!(event.target instanceof HTMLElement) || !event.target.matches('[data-package-manager-code-tabs]')) return

    // Lumen also emits this event for synchronized groups; retain its tab controller.
    event.target.querySelectorAll('[data-code-recovery]').forEach(recovery => recovery.remove())
  })
</script>

<style>
  :global([data-article-prose] [data-code-recovery]) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .875rem 1.5rem;
    padding: 1.125rem 1.5rem;
    border-block: 1px solid hsl(var(--line));
    color: hsl(var(--ink-soft));
    background: hsl(var(--surface));
  }

  :global([data-code-recovery-message]) { flex: 1 1 12rem; min-width: 0; }

  :global([data-code-recovery] p) {
    margin: 0;
    font: 400 .875rem/1.6 var(--font-sans);
    overflow-wrap: anywhere;
  }

  :global([data-code-recovery] [data-code-recovery-title]) {
    margin-bottom: .25rem;
    color: hsl(var(--ink));
    font-weight: 500;
  }

  :global([data-code-recovery] [data-select-code]) {
    flex: 0 1 auto;
    min-height: 44px;
    max-width: 100%;
    margin-inline-start: auto;
    padding: .5rem .75rem;
    border-radius: .75rem .75rem .25rem .75rem;
    background: hsl(var(--canvas));
    color: var(--folio-accent, var(--tab-folio-accent));
    white-space: normal;
    font: 500 .8125rem/1.6 var(--font-sans);
    box-shadow: none;
    transform: none;
  }

  :global([data-code-recovery] .ui-button__content) { gap: .5rem; }
  :global([data-code-recovery] svg) { width: 1rem; height: 1rem; flex-shrink: 0; }

  :global([data-code-recovery] [data-select-code]:hover) {
    border-color: currentColor;
    background: hsl(var(--brand-soft));
  }

  :global([data-article-prose] [data-ui-code]:has([data-code-recovery]) pre) {
    scroll-margin-block-start: 1rem;
  }

  :global([data-article-prose] [data-package-manager-code-tabs]:has([data-code-recovery])) {
    grid-template-rows: auto auto auto auto;
  }

  :global([data-package-manager-code-tabs] [data-code-recovery]) {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  :global([data-article-prose] [data-package-manager-code-tabs] [data-ui-code]:has([data-code-recovery]) > pre) {
    grid-row: 4;
  }

  @container tab-folio (width < 28rem) {
    :global([data-package-manager-code-tabs] [data-code-recovery]) { padding-inline: 1.125rem; }
  }

  @container code-folio (width < 27rem) {
    :global([data-article-prose] [data-code-recovery]) { padding-inline: 1.375rem; }
  }

  @container code-folio (width < 18rem) {
    :global([data-article-prose] [data-code-recovery]) { padding-inline: .75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-code-recovery] [data-select-code]) { transition: none; }
  }

  @media print {
    :global([data-article-prose] [data-code-recovery]) { display: none; }
  }
</style>
