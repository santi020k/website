---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { getPortfolioPath } from '@/utils/links'

import { Icon } from '@santi020k/lumen-astro'

interface Props {
  projects: CollectionEntry<'project'>[]
}

type LogoAspect = 'square' | 'tall' | 'wide'
type LogoSurface = 'dark' | 'light' | 'neutral'

const { projects } = Astro.props
const [featuredProject, ...supportingProjects] = projects

const logoFrameClass = {
  square: 'size-14 p-2.5',
  tall: 'h-14 w-12 p-2.5',
  wide: 'h-12 w-20 px-3 py-2'
} satisfies Record<LogoAspect, string>

const logoImageClass = {
  square: 'max-h-9 max-w-9',
  tall: 'max-h-9 max-w-7',
  wide: 'max-h-7 max-w-14'
} satisfies Record<LogoAspect, string>

const featuredLogoFrameClass = {
  square: 'size-20 p-4',
  tall: 'h-20 w-16 p-4',
  wide: 'h-16 w-28 px-5 py-3'
} satisfies Record<LogoAspect, string>

const featuredLogoImageClass = {
  square: 'max-h-12 max-w-12',
  tall: 'max-h-12 max-w-9',
  wide: 'max-h-9 max-w-20'
} satisfies Record<LogoAspect, string>

const logoSurfaceClass = {
  dark: 'border-white/18 bg-ink text-white dark:border-white/14 dark:bg-canvas',
  light: 'border-line/70 bg-surface text-ink dark:border-white/18 dark:bg-white/92',
  neutral: 'border-line/60 bg-surface-strong/86 text-ink-muted dark:border-white/12 dark:bg-white/10 dark:text-white/74'
} satisfies Record<LogoSurface, string>

const getProjectInitial = (title: string) => {
  const name = title.includes('/') ? title.split('/').at(-1) : title

  return name?.charAt(0).toUpperCase() || 'P'
}

const getProjectStatus = (project: CollectionEntry<'project'>) => {
  if (project.data.draft) return 'In development'

  return project.data.endingDate ? 'Completed' : 'Active'
}
---

<ul
  class="grid auto-rows-[11.5rem] list-none grid-cols-2 gap-3 p-0 sm:auto-rows-[12rem] lg:grid-cols-4 lg:gap-4"
  data-stagger="55"
>
  {featuredProject && (() => {
    const cover = featuredProject.data.coverImage?.horizontal ?? featuredProject.data.coverImage?.src
    const logo = featuredProject.data.coverImage?.logo
    const logoAspect: LogoAspect = featuredProject.data.coverImage?.logoAspect ?? 'square'
    const logoSurface: LogoSurface = featuredProject.data.coverImage?.logoSurface ?? 'neutral'
    const status = getProjectStatus(featuredProject)
    const metric = featuredProject.data.impactMetrics.at(0)

    return (
      <li class="col-span-2 row-span-2">
        <a
          aria-label={`View featured ${featuredProject.data.title} project`}
          class="group relative flex size-full flex-col justify-between overflow-hidden rounded-[2rem] border border-brand/25 bg-surface/72 p-6 shadow-lg shadow-brand/8 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-brand/45 hover:shadow-xl hover:shadow-brand/14 focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:outline-none motion-reduce:transform-none motion-reduce:transition-none sm:p-8"
          href={getPortfolioPath(featuredProject.id)}
        >
          {cover && (
            <Image
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 size-full object-cover opacity-20 saturate-125 transition duration-700 group-hover:scale-[1.035] group-hover:opacity-30 motion-reduce:transform-none motion-reduce:transition-none dark:opacity-25 dark:group-hover:opacity-35"
              loading="eager"
              sizes="(min-width: 1024px) 50vw, 100vw"
              src={cover}
              widths={[480, 720, 960]}
            />
          )}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-linear-to-r from-surface via-surface/92 to-surface/35 dark:from-surface dark:via-surface/88 dark:to-canvas/20"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-brand/16 blur-3xl transition duration-500 group-hover:scale-110 group-hover:bg-brand/22 motion-reduce:transform-none motion-reduce:transition-none"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_110%,hsl(var(--brand)/0.2),transparent_52%)]"
          />
          <span aria-hidden="true" class="absolute inset-x-10 top-0 h-px bg-linear-to-r from-transparent via-brand/70 to-transparent" />

          <span class="relative flex items-start justify-between gap-4">
            <span
              class:list={[
                'flex shrink-0 items-center justify-center overflow-hidden rounded-2xl border text-xl font-bold shadow-md',
                featuredLogoFrameClass[logoAspect],
                logoSurfaceClass[logoSurface]
              ]}
            >
              {logo ?
                (
                  <Image
                    alt=""
                    aria-hidden="true"
                    class:list={['object-contain drop-shadow-sm', featuredLogoImageClass[logoAspect]]}
                    loading="eager"
                    src={logo}
                  />
                ) :
                getProjectInitial(featuredProject.data.title)}
            </span>

            <span class="inline-flex items-center gap-2 rounded-full border border-brand/22 bg-brand-soft/72 px-3 py-1.5 text-xs font-semibold text-brand backdrop-blur-sm">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-brand" />
              {status}
            </span>
          </span>

          <span class="relative block sm:max-w-[74%]">
            <span class="section-label text-brand">Featured project</span>
            <span class="mt-2 block text-2xl/8 font-bold text-ink sm:text-3xl/9">
              {featuredProject.data.title}
            </span>
            <span class="mt-3 max-w-2xl line-clamp-3 text-sm/6 text-ink-soft sm:text-base/7">
              {featuredProject.data.description}
            </span>
            {metric && (
              <span class="mt-4 flex items-start gap-2 text-xs/5 font-medium text-ink-muted sm:text-sm/6">
                <Icon aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-brand" name="sparkles" />
                <span class="line-clamp-2">{metric}</span>
              </span>
            )}
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">
              Explore case study
              <Icon
                aria-hidden="true"
                class="size-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
                name="arrow-right"
              />
            </span>
          </span>
        </a>
      </li>
    )
  })()}

  {supportingProjects.map(project => {
    const logo = project.data.coverImage?.logo
    const logoAspect: LogoAspect = project.data.coverImage?.logoAspect ?? 'square'
    const logoSurface: LogoSurface = project.data.coverImage?.logoSurface ?? 'neutral'
    const status = getProjectStatus(project)

    return (
      <li>
        <a
          aria-label={`View ${project.data.title} project`}
          class:list={[
            'group relative flex size-full flex-col justify-between overflow-hidden rounded-3xl border bg-linear-to-br from-surface/94 via-surface/72 to-brand-soft/42 p-4 shadow-sm backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-brand/35 hover:shadow-lg hover:shadow-brand/12 focus-visible:ring-2 focus-visible:ring-brand/50 focus-visible:outline-none motion-reduce:transform-none motion-reduce:transition-none sm:p-5',
            status === 'Completed' ? 'border-line/40' : 'border-brand/16'
          ]}
          href={getPortfolioPath(project.id)}
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_115%,hsl(var(--brand)/0.18),transparent_58%)] opacity-35 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
          />
          <span aria-hidden="true" class="absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-brand/0 to-transparent transition-colors duration-300 group-hover:via-brand/60 motion-reduce:transition-none" />

          <span class="relative flex items-start justify-between gap-2">
            <span
              class:list={[
                'flex shrink-0 items-center justify-center overflow-hidden rounded-2xl border text-base font-bold shadow-sm transition duration-300 group-hover:scale-105 group-hover:shadow-md motion-reduce:transform-none motion-reduce:transition-none',
                logoFrameClass[logoAspect],
                logoSurfaceClass[logoSurface]
              ]}
            >
              {logo ?
                (
                  <Image
                    alt=""
                    aria-hidden="true"
                    class:list={['object-contain drop-shadow-sm', logoImageClass[logoAspect]]}
                    loading="lazy"
                    src={logo}
                  />
                ) :
                getProjectInitial(project.data.title)}
            </span>
            <Icon
              aria-hidden="true"
              class="size-4 -translate-x-1 text-brand opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 motion-reduce:translate-x-0 motion-reduce:opacity-100 motion-reduce:transition-none"
              name="arrow-up-right"
            />
          </span>

          <span class="relative block min-w-0">
            <span class="flex items-center gap-1.5 text-[0.65rem] font-semibold tracking-wider text-ink-muted uppercase">
              <span
                aria-hidden="true"
                class:list={[
                  'size-1.5 shrink-0 rounded-full',
                  status === 'Completed' ? 'bg-ink-muted/45' : 'bg-brand'
                ]}
              />
              {status}
            </span>
            <span class="mt-1.5 line-clamp-2 text-sm/5 font-bold text-ink transition-colors duration-200 group-hover:text-brand motion-reduce:transition-none sm:text-base/5">
              {project.data.title}
            </span>
            <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:opacity-100 motion-reduce:transition-none">
              View project
              <Icon aria-hidden="true" class="size-3.5" name="arrow-right" />
            </span>
          </span>
        </a>
      </li>
    )
  })}
</ul>
