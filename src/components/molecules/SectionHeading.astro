---
import ButtonLink from '../../components/atoms/ButtonLink.astro'
import Eyebrow from '../../components/atoms/Eyebrow.astro'

interface Props {
  align?: 'center' | 'left'
  description?: string
  eyebrow?: string
  level?: 'h1' | 'h2' | 'h3'
  linkHref?: string
  linkLabel?: string
  title: string
}

const {
  align = 'left',
  description,
  eyebrow,
  level = 'h2',
  linkHref,
  linkLabel,
  title
} = Astro.props

const HeadingTag = level
---

<div class:list={['flex flex-col gap-4', align === 'center' && `
  items-center text-center
`]}
>
  {eyebrow && <Eyebrow label={eyebrow} tone="brand" />}
  <div class="flex flex-col gap-3">
    <HeadingTag class="
      max-w-3xl text-xl
      sm:text-2xl
      md:text-4xl
    "
    >{title}
    </HeadingTag>
    {description && (
      <p class="
        max-w-2xl text-base/7 text-ink-soft
        sm:text-lg
      "
      >{description}
      </p>
    )}
  </div>
  {linkHref && linkLabel && (
    <ButtonLink href={linkHref} showArrow variant="inline">
      {linkLabel}
    </ButtonLink>
  )}
</div>
