---
import type { MarkdownHeading } from 'astro'

import TocCard from '@/components/molecules/TocCard.astro'

import { Collapsible, Icon } from '@santi020k/lumen-astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const tocHeadings = headings.filter(heading => heading.depth <= 3)
const sectionCount = tocHeadings.filter(heading => heading.depth <= 2).length || tocHeadings.length
---

{tocHeadings.length > 0 && (
  <div data-chapter-opener>
    <Collapsible data-toc-opener>
      <summary data-toc-summary>
        <span>On this page</span>{' '}
        <span data-toc-count>{sectionCount} {sectionCount === 1 ? 'section' : 'sections'}</span>
        <Icon class="size-4 shrink-0" name="chevron-down" />
      </summary>
      <TocCard embedded headings={tocHeadings} />
    </Collapsible>
  </div>
)}

<style>
  [data-chapter-opener] { container: chapter-opener / inline-size; }
  [data-toc-opener] {
    padding: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    box-shadow: none;
    overflow-wrap: break-word;
  }
  [data-toc-summary] {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    min-height: 4.25rem;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border-radius: inherit;
    color: hsl(var(--brand));
    font-size: 0.75rem;
    line-height: 1.667;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    background: transparent;
  }
  [data-toc-summary]::-webkit-details-marker { display: none; }
  [data-toc-summary]::before, [data-toc-summary]::after { display: none; }
  [data-toc-opener][open] > [data-toc-summary] { margin-bottom: 0; }
  [data-toc-count] { margin-inline-start: auto; color: hsl(var(--ink-soft)); }
  [data-toc-opener][open] [data-toc-summary] :global(.ui-icon) { transform: rotate(180deg); }
  :global(:root[data-theme='dark']) [data-toc-summary] { color: hsl(var(--accent)); }

  @container chapter-opener (width < 16rem) {
    [data-toc-summary] { padding-inline: 0.75rem; }
  }

  @container chapter-opener (width < 9rem) {
    [data-toc-summary] { padding-inline: 0.5rem; }
  }
</style>
