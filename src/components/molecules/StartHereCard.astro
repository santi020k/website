---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import ArrowExchange from '@/components/atoms/ArrowExchange.astro'

import { Card } from '@santi020k/lumen-astro'

import { getLocale, localizePath } from '@/i18n'
import { collectionTranslator } from '@/i18n/collection-copy'

const locale = getLocale(Astro.url.pathname)
const t = collectionTranslator(locale)

interface Props {
  contentLocale?: 'en' | 'es'
  coverImage: CollectionEntry<'post'>['data']['coverImage']
  href: string
  label: string
  position: number
  reason: string
  title: string
}

const { contentLocale = 'en', coverImage, href, label, position, reason, title } = Astro.props
---

<Card as="article" data-start-here-card variant="unstyled">
  <a href={localizePath(href, locale)}>
    {coverImage && (
      <div data-reading-slip-artwork>
        <Image
          alt={coverImage.alt}
          decoding="async"
          height={360}
          loading="lazy"
          sizes="(min-width: 1280px) 370px, (min-width: 960px) 30vw, (min-width: 656px) 36vw, 90vw"
          src={coverImage.src}
          width={640}
          widths={[320, 480, 640, 960]}
        />
      </div>
    )}
    <div data-reading-slip-body>
      <div data-reading-slip-header>
        <p lang={contentLocale} data-reading-slip-label>{label}</p>
        <span aria-hidden="true" data-reading-slip-number>{String(position).padStart(2, '0')}</span>
      </div>
      <h4 lang={contentLocale}>{title}</h4>
      <p lang={contentLocale} data-reading-slip-reason>{reason}</p>
      <span data-reading-slip-footer>
        <span>{t('collection.readTheArticle')} <ArrowExchange
class="size-4.5 shrink-0"
direction="up-right"
                                               /></span>
      </span>
    </div>
  </a>
</Card>

<style>
  [data-start-here-card][data-slot='card'] {
    --reading-slip-emphasis: hsl(var(--brand));
    container: reading-slip / inline-size;
    width: 100%;
    height: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: hsl(var(--ink));
    box-shadow: none;
    overflow-wrap: anywhere;
  }
  :global([data-theme='dark']) [data-start-here-card] { --reading-slip-emphasis: hsl(var(--accent)); }
  a { display: flex; flex-direction: column; gap: 1.5rem; height: 100%; color: inherit; text-decoration: none; }
  [data-reading-slip-artwork] { min-width: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 1.125rem 1.125rem 0.375rem 1.125rem; background: hsl(var(--surface-muted)); }
  [data-reading-slip-artwork] img { display: block; width: 100%; height: 100%; object-fit: cover; }
  [data-reading-slip-body] { display: flex; flex: 1; flex-direction: column; min-width: 0; }
  [data-reading-slip-header] { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  [data-reading-slip-label] { color: var(--reading-slip-emphasis); font-size: 0.75rem; line-height: 1.6; font-weight: 500; }
  [data-reading-slip-number] { color: hsl(var(--ink-soft)); font-size: 0.6875rem; line-height: 1.6; font-variant-numeric: tabular-nums; }
  h4 { font-size: 1.25rem; line-height: 1.4; font-weight: 500; letter-spacing: -0.04em; text-wrap: pretty; }
  a:is(:hover, :focus-visible) h4 { color: var(--reading-slip-emphasis); text-decoration: underline; text-underline-offset: 0.25rem; text-decoration-thickness: 1px; }
  [data-reading-slip-reason] { margin-block: 0.875rem 1.5rem; color: hsl(var(--ink-soft)); font-size: 0.8125rem; line-height: 1.85; }
  [data-reading-slip-footer] { margin-top: auto; padding-top: 1rem; border-top: 1px solid hsl(var(--line) / 0.65); }
  [data-reading-slip-footer] > span { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--reading-slip-emphasis); font-size: 0.75rem; line-height: 1.6; font-weight: 500; }
  @container reading-slip (width >= 38rem) {
    a:has([data-reading-slip-artwork]) { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    [data-reading-slip-body] { height: 100%; }
  }
  @container reading-slip (width < 16rem) {
    [data-reading-slip-header], [data-reading-slip-footer] > span { flex-wrap: wrap; gap: 0.5rem; }
    h4 { font-size: 1.125rem; }
  }
</style>
