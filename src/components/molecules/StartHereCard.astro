---
import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  href: string
  label: string
  position: number
  reason: string
  title: string
}

const { href, label, position, reason, title } = Astro.props
---

<Card as="article" data-start-here-card variant="unstyled">
  <a href={href}>
    <div data-reading-slip-header>
      <p data-reading-slip-label>{label}</p>
      <span aria-hidden="true" data-reading-slip-number>{String(position).padStart(2, '0')}</span>
    </div>
    <h4>{title}</h4>
    <p data-reading-slip-reason>{reason}</p>
    <span data-reading-slip-footer>
      <span>Read the article <Icon class="size-4.5 shrink-0" name="arrow-up-right" /></span>
    </span>
  </a>
</Card>

<style>
  [data-start-here-card][data-slot='card'] {
    --reading-slip-emphasis: hsl(var(--brand));
    container: reading-slip / inline-size;
    width: 100%;
    height: 100%;
    min-width: 0;
    border: 1px solid hsl(var(--line));
    border-radius: 1.5rem 1.5rem 0.5rem 1.5rem;
    background: hsl(var(--surface));
    color: hsl(var(--ink));
    overflow-wrap: break-word;
  }
  :global([data-theme='dark']) [data-start-here-card] {
    --reading-slip-emphasis: hsl(var(--accent));
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }
  [data-reading-slip-header] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1.875rem;
  }
  [data-reading-slip-label] {
    color: var(--reading-slip-emphasis);
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
  [data-reading-slip-number] {
    color: var(--reading-slip-emphasis);
    font-size: 3rem;
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.0625em;
  }
  h4 {
    font-size: 1.4375rem;
    line-height: 2rem;
    font-weight: 500;
    letter-spacing: -0.024em;
    transition: color 180ms ease;
  }
  a:is(:hover, :focus-visible) h4 { color: var(--reading-slip-emphasis); }
  [data-reading-slip-reason] {
    margin-top: 1.125rem;
    color: hsl(var(--ink-soft));
    font-size: 0.875rem;
    line-height: 1.75rem;
  }
  [data-reading-slip-footer] { margin-top: auto; padding-top: 1.75rem; }
  [data-reading-slip-footer] > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid hsl(var(--line));
    padding-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-weight: 500;
  }
  @container reading-slip (width < 19.375rem) {
    a { padding: 1.375rem; }
  }
  @container reading-slip (width < 16rem) {
    a { padding: 1rem; }
    [data-reading-slip-header] { flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
    [data-reading-slip-number] { font-size: 2rem; }
    h4 { font-size: 1.25rem; line-height: 1.5; }
    [data-reading-slip-footer] > span { flex-wrap: wrap; gap: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    h4 { transition: none; }
  }
</style>
