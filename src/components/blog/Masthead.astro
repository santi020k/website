---
import { Image } from 'astro:assets'
import { type CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

import Badge from '../atoms/Badge.astro'
import FormattedDate from '../atoms/FormattedDate.astro'
import Separator from '../atoms/Separator.astro'

interface Props {
  content: CollectionEntry<'post'>
}

const { content } = Astro.props

const dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'long'
}
---

<div class="
  flex items-end
  md:sticky md:top-8 md:z-10
"
>
  {
    !!(content.rendered?.metadata?.headings as unknown[] | undefined)?.length && (
      <button
        id="toggle-toc"
        class="
          hidden size-8 shrink-0 items-center justify-center rounded-lg
          bg-accent/10 text-accent
          hover:brightness-110
          md:flex
        "
        aria-label="Table of Contents"
      >
        <Icon aria-hidden="true" class="size-6" focusable="false" name="solar:clipboard-list-bold" />
      </button>
    )
  }

  <h1
    class="
      ml-2 line-clamp-none
      md:sticky md:top-4 md:z-20 md:line-clamp-1 md:max-w-[calc(100%-10rem)]
    "
    title={content.data.title}
    data-pagefind-body
  >
    {content.data.title}
  </h1>
</div>

<div class="mx-2 mt-4.25 mb-2 flex flex-wrap items-center text-sm text-ink-soft">
  <span class="flex h-7 items-center">
    <Icon aria-hidden="true" class="me-1 flex size-4 items-center" focusable="false" name="hugeicons:calendar-03" />
    <FormattedDate
      date={content.data.publishDate}
      dateTimeOptions={dateTimeOptions}
      class="flex shrink-0"
    />
  </span>
  <Separator type="dot" />
  <span class="flex h-7 items-center">
    <Icon aria-hidden="true" class="me-1 flex size-4 items-center" focusable="false" name="hugeicons:book-open-01" />
    {/* @ts-expect-error:next-line. TODO: add reading time to collection schema? */}
    {content.rendered?.metadata?.frontmatter?.readingTime ? `${content.rendered.metadata.frontmatter.readingTime}` : 'Less than one minute read'}
  </span>
  {
    content.data.updatedDate && (
      <Separator type="dot" />
      <span class="
        flex h-7 shrink-0 items-center gap-x-1 rounded-lg bg-brand/5 px-2 py-1
        text-sm text-brand
      "
      >
        Updated:<FormattedDate class="flex shrink-0" date={content.data.updatedDate} dateTimeOptions={dateTimeOptions} />
      </span>
    )
  }
</div>

{content.data.draft ? <span class="ml-2 text-base text-red-500">(Draft)</span> : null}

{
  content.data.coverImage && (
    <div class="mt-2 mb-4 overflow-auto rounded-lg">
      <Image
        alt={content.data.coverImage.alt}
        class="object-cover"
        fetchpriority="high"
        loading="lazy"
        src={content.data.coverImage.src}
      />
    </div>
  )
}

<p
  class="mx-2 prose max-w-none text-ink"
  data-pagefind-body
>
  {content.data.description}
</p>

<div class="mx-1 mt-4 flex flex-wrap items-center gap-2">
  {
    content.data.tags.length ?
      (
      <Icon
        aria-hidden="true"
        class="inline-block size-6 shrink-0 text-accent"
        focusable="false"
        name="solar:tag-line-duotone"
      />
      <>
        {content.data.tags.map(tag => (
          <a aria-label={`View all posts with the tag: ${tag}`} href={`/tags/${tag}`}>
            <Badge variant="brand-accent" title={tag} />
          </a>
        ))}
      </>
      ) :
      (
      <Icon
        aria-hidden="true"
        class="inline-block size-6 shrink-0 text-ink-muted"
        focusable="false"
        name="solar:tag-line-duotone"
      />
      <span class="text-sm text-ink-muted">No tags</span>
      )
  }
</div>
