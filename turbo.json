{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "packages/website-history/**",
    ".nvmrc",
    "scripts/js/archive-cache-context.mjs",
    "scripts/js/build-sites.mjs"
  ],
  "tasks": {
    "build:site": {
      "outputs": [
        "dist/**"
      ],
      "cache": true
    },
    "website#build:site": {
      "outputs": [
        "dist/**"
      ],
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.shared.js"
      ],
      "outputs": [],
      "cache": true
    },
    "check": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [],
      "cache": true
    }
  },
  "globalEnv": [
    "BASE_URL",
    "CI",
    "CLOUDFLARE_WEB_ANALYTICS_TOKEN",
    "CSP_REPORT_URL",
    "DEBUG",
    "DEV",
    "ENABLE_PRODUCTION_SOURCE_MAPS",
    "HISTORY_PREVIEW_URL",
    "NODE_ENV",
    "OG_INCLUDE_DRAFTS",
    "PROD",
    "PW_CHROMIUM_CHANNEL",
    "PW_ONLY_CHROMIUM",
    "PW_PREVIEW_PORT",
    "PW_UPDATE_SNAPSHOTS",
    "SITE",
    "SKIP_BUILD",
    "SYNCKIT_TIMEOUT",
    "TZ",
    "WEBMENTION_API_KEY",
    "WEBMENTION_PINGBACK",
    "WEBMENTION_URL",
    "npm_lifecycle_event",
    "WEBSITE_ARCHIVE_BUILD_DATE",
    "WEBSITE_ARCHIVE_CACHE_IDENTITY"
  ],
  "globalPassThroughEnv": [
    "CI_BASE_SHA",
    "CI_HEAD_SHA",
    "GITHUB_EVENT_NAME",
    "GITHUB_HEAD_REF",
    "GITHUB_OUTPUT",
    "PATH",
    "PW_WORKERS"
  ]
}
