---
import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  icon: string
  id: string
  title: string
}

const { icon, id, title } = Astro.props
---

<Card
  as="section"
  aria-labelledby={id}
  class="rounded-2xl p-5"
  glass="subtle"
>
  <p class="flex items-center gap-2 section-label" id={id}>
    <Icon class="size-4 text-brand" name={icon} />
    {title}
  </p>
  <slot />
</Card>
