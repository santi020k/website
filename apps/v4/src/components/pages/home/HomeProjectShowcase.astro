---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import HomeSectionHeading from '@/components/pages/home/HomeSectionHeading.astro'

import { getPortfolioPath } from '@/utils/links'
import { getProjectCoverForUsage } from '@/utils/project-cover'
import { getProjectTimelineLabel } from '@/utils/project-meta'

import { Card, Icon } from '@santi020k/lumen-astro'

interface Props {
  projects: CollectionEntry<'project'>[]
  kind: 'work' | 'projects'
}

const { projects, kind } = Astro.props
const isWork = kind === 'work'
const featured = projects.slice(0, isWork ? 1 : 2)
const supporting = projects.slice(featured.length)
---

{projects.length > 0 && (
  <section class="studio-section" aria-labelledby={`${kind}-heading`} data-home-showcase={kind}>
    <HomeSectionHeading
      id={`${kind}-heading`}
      number={isWork ? '01' : '02'}
      eyebrow={isWork ? 'Selected work' : 'Independent projects'}
      title={isWork ? 'Good work. Built together.' : 'Curiosity, made useful.'}
      description={isWork ?
        'Products shaped with ambitious teams. From the first architectural decision to the details people use every day.' :
        'Small ideas that turned into real products. Tools, experiments, and open-source work I keep coming back to.'}
      href={isWork ? '/work/' : '/projects/'}
      action={isWork ? 'Explore my experience' : 'View all projects'}
    />
    <div class:list={['studio-feature-grid', { 'studio-feature-grid-pair': !isWork }]}>
      {featured.map(project => {
        const cover = getProjectCoverForUsage(project.data.coverImage, 'hero')

        return (
          <Card as="article" class:list={['studio-project', { 'studio-project-wide': isWork }]} variant="unstyled">
            <a class="studio-project-link" href={getPortfolioPath(project.id)} data-project-card data-showcase-feature>
              <div class="studio-project-media" data-showcase-artwork>
                {cover && (
                  <Image
                    src={cover}
                    alt=""
                    width={960}
                    widths={[400, 640, 960, 1280]}
                    sizes="(min-width: 1200px) 640px, (min-width: 768px) 50vw, 100vw"
                    format="webp"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="studio-project-copy">
                <p class="studio-project-category">{isWork ? 'Selected experience' : 'Independent product'}</p>
                <div class="studio-project-title">
                  <h3>{project.data.title}</h3>
                  <span class="studio-arrow-box" aria-hidden="true"><Icon name="arrow-up-right" /></span>
                </div>
                <p class="studio-project-description">{project.data.description}</p>
                <div class="studio-project-meta">
                  <span>{isWork ? project.data.role : project.data.technologies.slice(0, 3).join(' / ')}</span>
                  <span>{getProjectTimelineLabel(project.data.startingDate, project.data.endingDate)}</span>
                </div>
                {isWork && project.data.impactMetrics.length > 0 && (
                  <p class="studio-project-outcome"><Icon name="trending-up" /> {project.data.impactMetrics[0]}</p>
                )}
              </div>
            </a>
          </Card>
        )
      })}
    </div>
    <ol class:list={['studio-project-list', { 'studio-project-list-pair': !isWork }]}>
      {supporting.map((project, index) => (
        <li data-showcase-row>
          <a class="studio-project-row" href={getPortfolioPath(project.id)} data-showcase-item>
            <span class="studio-row-number" aria-hidden="true">{String(index + featured.length + 1).padStart(2, '0')}</span>
            <span class="studio-row-title"><strong>{project.data.title}</strong><span>{project.data.role}</span></span>
            <span class="studio-row-summary">{project.data.description}</span>
            <Icon data-project-row-icon name="arrow-up-right" />
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
