---
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import TechnologyPillGrid from '@/components/molecules/TechnologyPillGrid.astro'
import ProjectsGallery from '@/components/organisms/ProjectsGallery.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { collectionDateSortProjects, collectionRelevanceSortProjects } from '@/utils/date'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { ButtonLink as LumenButtonLink, Icon } from '@santi020k/lumen-astro'

import { createProjectCollectionSchema, getUniqueTechnologiesWithCount } from '@/data/project'
import { siteConfig, YEARS_OF_EXPERIENCE } from '@/site.config'

const allProjects = (await getCachedProjects()).sort(collectionDateSortProjects)
const sideProjects = allProjects.filter(p => p.data.typesId === 'personal')
const showcaseProjects = [...sideProjects].sort(collectionRelevanceSortProjects)
const allTechnologies = getUniqueTechnologiesWithCount(sideProjects)
const technologies = sortTechnologyCountsByInterest(allTechnologies).slice(0, 18)
const hiddenTechnologyCount = Math.max(0, allTechnologies.length - technologies.length)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Projects', url: '/projects/' }
]

const projectsListSchema = createProjectCollectionSchema('Side Projects — Santiago Molina', '/projects/', showcaseProjects, Astro.site)
---

<PageLayout
  headerVariant="signature"
  mainClass="projects-page"
  meta={{
    breadcrumbs,
    description: 'Open-source tools and self-directed experiments — the projects I build to learn, share, and sharpen how I engineer beyond client work.',
    structuredData: projectsListSchema,
    title: 'Side Projects — Santiago Molina'
  }}
>
  <section class="signature-frame maker-hero projects-intro" aria-labelledby="projects-heading" data-projects-page>
    <p class="maker-hero-eyebrow">
      <span aria-hidden="true" class="maker-hero-signal"></span>
      Independent making / Side projects
    </p>
    <div class="projects-intro-stage">
      <h1 id="projects-heading">
        <span>Built for the{' '}</span>
        <span class="maker-hero-emphasis">love of it.</span>
      </h1>
      <div>
        <p class="maker-hero-description">
          Useful products. Better tools. Room to explore.
          These are the things I build beyond client work,
          turning curiosity into something other people can use.
        </p>
        <div class="maker-hero-actions">
          <LumenButtonLink class="maker-hero-primary" href="#projects" variant="unstyled">
            Explore projects
            <span class="maker-hero-arrow" aria-hidden="true"><Icon name="arrow-down-right" /></span>
          </LumenButtonLink>
          <LumenButtonLink class="maker-hero-secondary" href={siteConfig.contact.github} newTab variant="unstyled">
            View GitHub <Icon name="arrow-up-right" />
          </LumenButtonLink>
        </div>
      </div>
    </div>
    <dl class="projects-intro-ledger">
      <div><dt>Independent builds</dt><dd>{sideProjects.length}<span>Projects &amp; experiments</span></dd></div>
      <div><dt>Tools of the trade</dt><dd>{allTechnologies.length}<span>Technologies explored</span></dd></div>
      <div><dt>Experience behind it</dt><dd>{YEARS_OF_EXPERIENCE}<span>Years in engineering</span></dd></div>
    </dl>
  </section>

  <section
    aria-label={`${sideProjects.length} personal projects`}
    class="
      section-container-wide scroll-mt-28 pt-12
      sm:pt-16
      lg:pt-20
    "
    id="projects"
  >
    <SectionHeader
      description="Every project has a deeper story about the problem, the decisions, and the system behind the finished work."
      eyebrow={`${showcaseProjects.length} project stories`}
      title="The work behind the logos."
    />
    <div class="
      mt-10
      sm:mt-12
    "
    >
      <ProjectsGallery projects={showcaseProjects} variant="editorial" />
    </div>
  </section>

  <section class="
    section-container-wide space-y-8 pt-20
    sm:pt-24
    lg:pt-28
  "
  >
    <SectionHeader
      description="Trusted foundations and tools I’m actively exploring across personal projects, open source, developer experience, and testing."
      eyebrow="Technology map"
      linkHref="/technologies/"
      linkLabel="Browse the full stack index"
      title="The stack I choose when curiosity leads."
    />
    <TechnologyPillGrid
      hiddenCount={hiddenTechnologyCount}
      intro="Technologies from side projects and open-source contributions, ordered by interest."
      technologies={technologies}
    />
  </section>
</PageLayout>
