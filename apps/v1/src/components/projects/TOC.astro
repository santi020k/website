---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '@/utils/generate-toc'

import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const toc = generateToc(headings);
---

<div class="sticky top-20 flex flex-col gap-y-4 rounded-t-lg">
  <div class="sticky top-20 rounded-t-lg">
    <div class="sticky top-20 flex items-end gap-x-1 rounded-t-lg">
      <h4>Table of Contents</h4>
    </div>
  </div>
  <div class="rounded-b-lg">
    <div class="rounded-b-lg pb-6">
      <div class="
        h-auto max-h-[calc(100vh-11rem)] overflow-hidden overflow-y-auto
      "
      >
        <ul class="text-sm font-medium">
          {toc.map(heading => <TOCHeading heading={heading} />)}
        </ul>
      </div>
    </div>
  </div>
</div>
