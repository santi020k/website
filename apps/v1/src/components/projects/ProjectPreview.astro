---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import Badge from '@/components/Badge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import Separator from '@/components/Separator.astro'

import { dateWithoutDay } from '@/utils/date-format-presets'

interface Props {
  project: CollectionEntry<'project'>
  withDesc?: boolean
}

const { project } = Astro.props
---

<a
  href={`/portfolio/${project.id}/`}
  class="
    group relative flex min-w-0 flex-col gap-y-4 rounded-xl p-6 wrap-anywhere
    transition-all duration-300
    hover:bg-stone-100 hover:shadow-xl
    motion-reduce:transition-none
    dark:hover:bg-stone-800
  "
>
  {project.data.coverImage?.src && (
    <div class="
      relative block overflow-hidden rounded-xl shadow-xl
      dark:shadow-gray-900
    "
    >
      <Image
        src={project.data.coverImage.src}
        alt={project.data.coverImage.alt || project.data.title}
        width="800"
        height="450"
        decoding="async"
        class="
          aspect-video w-full object-cover transition-transform duration-300
          group-hover:scale-105
          motion-reduce:transform-none motion-reduce:transition-none
        "
        loading="lazy"
        transition:name={`cover-image-${project.id}`}
      />
    </div>
  )}

  <div class="flex flex-col gap-y-3">
    <div>
      <h2
        transition:name={`project-title-${project.id}`}
        class="
          text-lg font-semibold text-zinc-900
          dark:text-zinc-100
        "
      >
        {project.data.title}
      </h2>
      <div
        transition:name={`project-subtitle-${project.id}`}
        class="
          flex flex-col items-start text-sm text-zinc-500
          sm:flex-row sm:items-center
          dark:text-zinc-200
        "
      >
        {project.data.rol && (
          <>
            <p class="inline-flex">{project.data.rol}</p>
            <Separator
              className="
                hidden
                sm:inline-flex
              "
              type="dot"
            />
          </>
        )}
        <div>
          <FormattedDate dateTimeOptions={dateWithoutDay} date={project.data.startingDate} />
          <span>
            &nbsp;-&nbsp;
          </span>
          {project.data.endingDate ?
            (
              <FormattedDate dateTimeOptions={dateWithoutDay} date={project.data.endingDate} />
            ) :
            'Present'}
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-y-2">
      <p
        transition:name={`project-description-${project.id}`}
        class="
          line-clamp-6 text-sm text-zinc-600
          sm:line-clamp-2
          dark:text-zinc-200
        "
      >
        {project.data.description}
      </p>

      <div
        transition:name={`project-badges-${project.id}`}
        class="flex flex-wrap items-center gap-2"
      >
        {
          project.data.technologies.slice(0, 5).map(technology => (
            <div class="flex max-w-full min-w-0 items-center gap-x-2">
              <Badge variant="outline" className="hover:border-zinc-400" showHash={false} wrap title={technology} />
            </div>
          ))
        }

        {project.data.technologies.length > 5 && (
          <div class="flex max-w-full min-w-0 items-center gap-x-2">
            <Badge variant="outline" className="hover:border-zinc-400" showHash={false} wrap title={`+${project.data.technologies.length - 5} more`} />
          </div>
        )}
      </div>
    </div>

  </div>
</a>
