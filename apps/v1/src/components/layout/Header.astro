---
import { Icon } from 'astro-icon/components'

import { Image } from 'astro:assets'

import ThemeToggle from '@/components/ThemeToggle.astro'

import LogoSVG from '@/assets/svg/logo.svg'

import { menuLinks, siteConfig } from '@/site.config';
---

<header
  id="main-header"
  transition:name="header"
  class="
    fixed top-0 left-0 z-20 flex h-16 w-full items-center bg-white/20 px-4
    backdrop-blur-xl
    md:relative md:px-0 md:backdrop-blur-none
    dark:bg-black/20
  "
>
  <div class="
    w-full justify-between
    sm:flex-col
  "
  >
    <div class="flex items-center gap-x-2">
      <a
        aria-label={siteConfig.title}
        aria-current={Astro.url.pathname === '/' ? 'page' : false}
        data-astro-prefetch
        class="
          group flex h-8 items-center
          hover:filter-none
          sm:relative
        "
        href="/"
        transition:name="logo-link"
      >
        <div title={siteConfig.title} class="p-2">
          <Image
            src={LogoSVG}
            alt="Santi020k Logo"
            width="140"
            height="100"
            fetchpriority="high"
            class="inline-block size-24 fill-current"
          />
        </div>
      </a>
      <nav
        aria-label="Main menu"
        class="
          top-20 mx-auto mr-4 hidden flex-col items-end justify-center gap-x-4
          rounded-md text-base font-medium shadow-sm backdrop-blur-sm
          group-[.menu-open]:z-50 group-[.menu-open]:flex
          sm:static sm:z-auto sm:flex-row sm:items-center sm:rounded-none
          sm:bg-transparent sm:shadow-none sm:backdrop-blur-none
          md:flex
        "
        id="main-navigation-menu"
      >
        {
          menuLinks.map(link => (
            <a
              aria-current={Astro.url.pathname === link.path ? 'page' : false}
              class="
                underline-offset-2
                hover:underline
              "
              data-astro-prefetch
              href={link.path}
            >
              {link.title}
            </a>
          ))
        }
        <!-- TODO: Temporal Blog link to medium -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="
            underline-offset-2
            hover:underline
          "
          data-astro-prefetch
          href="https://medium.com/@santi020k"
        >
          Blog
        </a>
        <!-- Contact -->
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="
            underline-offset-2
            hover:underline
          "
          data-astro-prefetch
          href="https://api.whatsapp.com/send?phone=37257899454&text=Hi%2C%20I%20came%20across%20your%20website%20and%20wanted%20to%20get%20in%20touch"
        >
          Contact
        </a>
      </nav>

      <div class="
        ml-auto w-fit
        md:ml-0
      "
      >
        <div
          id="buttons-panel"
          class="
            top-4 ml-auto flex space-x-2
            md:top-8 md:ml-0
          "
        >
          <ThemeToggle />
        </div>
      </div>

      <button
        aria-controls="drawer"
        aria-expanded="false"
        aria-label="Open main menu"
        class="
          group relative size-8 cursor-pointer rounded-lg
          md:invisible md:hidden
        "
        id="toggle-nav-menu-mobile"
        type="button"
      >
        <Icon
          id="open-nav-menu-icon"
          aria-hidden="true"
          class="
            absolute inset-s-1/2 top-1/2 size-6 -translate-1/2 scale-100
            opacity-100 transition-all
            motion-reduce:transition-none
          "
          focusable="false"
          name="hugeicons:menu-01"
        />
        <Icon
          id="close-nav-menu-icon"
          aria-hidden="true"
          class="
            absolute inset-s-1/2 top-1/2 size-6 -translate-1/2 scale-0 opacity-0
            transition-all
            motion-reduce:transition-none
          "
          focusable="false"
          name="hugeicons:cancel-01"
        />
      </button>
    </div>
  </div>
</header>

<div id="drawer" class="fixed inset-0 z-10 hidden backdrop-blur-xl" aria-hidden="true" inert>
  <div
    id="drawer-body"
    class="
      absolute inset-0 -translate-y-full transition-all duration-300 ease-in-out
      motion-reduce:transition-none
    "
  >
    <nav
      aria-label="Mobile navigation menu"
      class="
        absolute inset-0 flex flex-col items-center justify-center gap-y-4
        text-center text-lg font-medium
      "
      id="nav-menu-mobile"
    >
      {
        menuLinks.map(link => (
          <a
            aria-current={Astro.url.pathname === link.path ? 'page' : false}
            class="
              underline-offset-2
              hover:underline
            "
            data-astro-prefetch
            href={link.path}
          >
            {link.title}
          </a>
        ))
      }
      <!-- TODO: Temporal Blog link to medium -->
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="
          underline-offset-2
          hover:underline
        "
        data-astro-prefetch
        href="https://medium.com/@santi020k"
      >
        Blog
      </a>
    </nav>
  </div>
</div>

<script>
const desktopQuery = window.matchMedia('(min-width: 48rem)')
const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
const focusableSelector = 'a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])'

const isFocusable = (element: HTMLElement) => !element.matches(':disabled') &&
  element.getClientRects().length > 0 &&
  getComputedStyle(element).visibility !== 'hidden'

let cleanupMenu: (() => void) | undefined

document.addEventListener('astro:page-load', () => {
  cleanupMenu?.()

  const header = document.getElementById('main-header')
  const toggleNavMenuMobileButton = document.getElementById('toggle-nav-menu-mobile')
  const openMenuIcon = document.getElementById('open-nav-menu-icon')
  const closeMenuIcon = document.getElementById('close-nav-menu-icon')
  const drawer = document.getElementById('drawer')
  const drawerBody = document.getElementById('drawer-body')
  const mainNavigation = document.getElementById('main-navigation-menu')

  if (
    !header ||
    !(toggleNavMenuMobileButton instanceof HTMLButtonElement) ||
    !openMenuIcon ||
    !closeMenuIcon ||
    !drawer ||
    !drawerBody ||
    !mainNavigation
  ) {
    console.error('One or more required elements are missing in the DOM.')

    return
  }

  let isOpen = false
  let hideTimer: number | undefined

  const clearHideTimer = () => {
    window.clearTimeout(hideTimer)

    hideTimer = undefined
  }

  const openMenu = () => {
    clearHideTimer()

    isOpen = true

    drawer.classList.remove('hidden')

    drawer.inert = false

    drawer.setAttribute('aria-hidden', 'false')

    drawerBody.classList.add('translate-y-0')

    drawerBody.classList.remove('opacity-0', '-translate-y-full')

    openMenuIcon.classList.add('scale-0', 'opacity-0')

    closeMenuIcon.classList.add('scale-100', 'opacity-100')

    closeMenuIcon.classList.remove('scale-0', 'opacity-0')

    openMenuIcon.classList.remove('scale-100', 'opacity-100')

    toggleNavMenuMobileButton.setAttribute('aria-expanded', 'true')

    toggleNavMenuMobileButton.setAttribute('aria-label', 'Close main menu')
  }

  const closeMenu = ({ restoreFocus = false, immediate = false } = {}) => {
    clearHideTimer()

    isOpen = false

    // Hide from assistive technology and the tab order before the exit transition runs.
    drawer.inert = true

    drawer.setAttribute('aria-hidden', 'true')

    drawerBody.classList.add('opacity-0', '-translate-y-full')

    drawerBody.classList.remove('translate-y-0')

    if (immediate || reducedMotionQuery.matches) {
      drawer.classList.add('hidden')
    } else {
      hideTimer = window.setTimeout(() => {
        hideTimer = undefined

        drawer.classList.add('hidden')
      }, 300)
    }

    openMenuIcon.classList.add('scale-100', 'opacity-100')

    openMenuIcon.classList.remove('scale-0', 'opacity-0')

    closeMenuIcon.classList.add('scale-0', 'opacity-0')

    closeMenuIcon.classList.remove('scale-100', 'opacity-100')

    toggleNavMenuMobileButton.setAttribute('aria-expanded', 'false')

    toggleNavMenuMobileButton.setAttribute('aria-label', 'Open main menu')

    if (restoreFocus) {
      toggleNavMenuMobileButton.focus()
    }
  }

  const getFocusCycle = () => [
    ...header.querySelectorAll<HTMLElement>(focusableSelector),
    ...drawer.querySelectorAll<HTMLElement>(focusableSelector)
  ].filter(isFocusable)

  const handleToggleClick = () => {
    if (isOpen) {
      closeMenu()
    } else {
      openMenu()
    }
  }

  const handleDrawerClick = (event: MouseEvent) => {
    if (event.target instanceof Element && event.target.closest('a[href]')) {
      return
    }

    closeMenu({ restoreFocus: true })
  }

  const handleKeydown = (event: KeyboardEvent) => {
    if (!isOpen) {
      return
    }

    if (event.key === 'Escape') {
      event.preventDefault()

      closeMenu({ restoreFocus: true })

      return
    }

    if (event.key !== 'Tab') {
      return
    }

    const focusCycle = getFocusCycle()
    const firstElement = focusCycle.at(0)
    const lastElement = focusCycle.at(-1)

    if (!firstElement || !lastElement) {
      return
    }

    const activeElement = document.activeElement
    const activeIndex = activeElement instanceof HTMLElement ? focusCycle.indexOf(activeElement) : -1
    let nextIndex = (activeIndex + (event.shiftKey ? -1 : 1) + focusCycle.length) % focusCycle.length

    if (activeIndex < 0) {
      nextIndex = event.shiftKey ? focusCycle.length - 1 : 0
    }

    // Safari can skip buttons in native Tab order; every visible control belongs here.
    event.preventDefault()

    focusCycle.at(nextIndex)?.focus()
  }

  const handleBreakpointChange = () => {
    if (!desktopQuery.matches) {
      return
    }

    const activeElement = document.activeElement

    const hasMobileFocus = activeElement === toggleNavMenuMobileButton ||
      (activeElement instanceof Node && drawer.contains(activeElement))

    if (isOpen) {
      closeMenu({ immediate: true })
    }

    if (!hasMobileFocus) {
      return
    }

    // The mobile controls are now hidden; move focus to the matching desktop link or the logo.
    const href = activeElement instanceof HTMLAnchorElement ? activeElement.getAttribute('href') : null

    const desktopTarget = [...mainNavigation.querySelectorAll<HTMLAnchorElement>('a[href]')]
      .find(link => link.getAttribute('href') === href && isFocusable(link)) ??
      header.querySelector<HTMLAnchorElement>('a[href]')

    desktopTarget?.focus()
  }

  const cleanup = () => {
    clearHideTimer()

    toggleNavMenuMobileButton.removeEventListener('click', handleToggleClick)

    drawer.removeEventListener('click', handleDrawerClick)

    document.removeEventListener('keydown', handleKeydown)

    desktopQuery.removeEventListener('change', handleBreakpointChange)

    document.removeEventListener('astro:before-swap', cleanup)

    cleanupMenu = undefined
  }

  toggleNavMenuMobileButton.addEventListener('click', handleToggleClick)

  drawer.addEventListener('click', handleDrawerClick)

  document.addEventListener('keydown', handleKeydown)

  desktopQuery.addEventListener('change', handleBreakpointChange)

  document.addEventListener('astro:before-swap', cleanup)

  cleanupMenu = cleanup

  closeMenu({ immediate: true })
})
</script>
