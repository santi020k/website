---
import '@santi020k/lumen-astro/styles.css'
import '@santi020k/theme/tokens.css'
import '../styles/preview.css'

import { Badge, Button, Link } from '@santi020k/lumen-astro'

import { chapters, duration, outroStart } from '../composition'
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Website motion studio — A website, over time</title>
    <meta name="description" content="Preview a locally rendered website history composition in vertical, square, and landscape formats." />
  </head>
  <body>
    <main class="preview-shell" aria-labelledby="preview-title">
      <header class="preview-header">
        <strong class="preview-wordmark">santi020k.</strong>
        <Badge variant="outline">Local pilot · {duration} seconds</Badge>
      </header>
      <div class="preview-layout">
        <section class="preview-copy" aria-labelledby="preview-title">
          <p class="preview-eyebrow">WEBSITE MOTION STUDIO</p>
          <h1 id="preview-title">A website,<br />over time.</h1>
          <p>Four design eras, from the original portfolio to today’s personal canvas. Real desktop and mobile captures, arranged on one timeline.</p>
          <div class="controls" role="group" aria-label="Video format">
            <Button data-format="portrait" aria-pressed="true">Vertical</Button>
            <Button data-format="square" variant="outline" aria-pressed="false">Square</Button>
            <Button data-format="landscape" variant="outline" aria-pressed="false">Landscape</Button>
          </div>
          <div class="controls" role="group" aria-label="Choose chapter">
            <Button data-time="1" data-start="0" data-name="Opening" variant="outline" aria-pressed="true">Opening</Button>
            {chapters.map(chapter => <Button data-time={chapter.still} data-start={chapter.start} data-name={chapter.id.toUpperCase()} variant="outline" aria-pressed="false">{chapter.id.toUpperCase()}</Button>)}
            <Button data-time="24" data-start={outroStart} data-name="Ending" variant="outline" aria-pressed="false">Ending</Button>
          </div>
          <div class="controls" role="group" aria-label="Playback">
            <Button id="play">Play animation</Button>
            <Button id="pause" variant="outline">Pause</Button>
          </div>
          <p id="playback-status" role="status">Paused · Opening</p>
          <p id="motion-preference" hidden>Reduced motion is enabled. Choose a chapter to view a still frame.</p>
          <p class="preview-note">Authentic website captures. V1 and V2 are curated design eras. The film is silent and uses local assets.</p>
          <Link href="https://santi020k.com/history/" newTab>Explore the website history ↗</Link>
        </section>
        <section class="preview-stage" aria-label="Animation preview">
          <div class="frame-container" data-preview-format="portrait">
            <iframe id="composition" data-duration={duration} src="/portrait/" title="Website history film" width="1080" height="1920"></iframe>
          </div>
        </section>
      </div>
      <footer class="preview-footer">Created with Lumen UI and HyperFrames · <Link href="https://santi020k.com" newTab>santi020k</Link></footer>
    </main>
    <script>
      import '../scripts/preview'
    </script>
  </body>
</html>
