---
import type { CollectionEntry } from 'astro:content'

import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Eyebrow from '@/components/atoms/Eyebrow.astro'
import FormattedDate from '@/components/atoms/FormattedDate.astro'
import GradientDivider from '@/components/atoms/GradientDivider.astro'
import HoverableCover from '@/components/atoms/HoverableCover.astro'
import Pill from '@/components/atoms/Pill.astro'

import { getTagPath } from '@/utils/links'
import { getPostSlug } from '@/utils/posts'

import { Breadcrumb, CopyButton, Icon } from '@santi020k/lumen-astro'
import readingTime from 'reading-time'

import { getSeriesContext } from '@/data/series'
import { siteConfig } from '@/site.config'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { canonicalUrl, description, publishDate, title, updatedDate, tags } = post.data
const stats = readingTime(post.body ?? '')
const readingTimeText = stats.text
const wordCount = Math.round(stats.words)
const seriesContext = await getSeriesContext(post)
const copyUrl = new URL(Astro.url.pathname, Astro.site).href

const coverAspectRatio = post.data.coverImage ?
  post.data.coverImage.src.width / post.data.coverImage.src.height :
  16 / 10

const useWideCoverFrame = coverAspectRatio > 1.08
// Use the first tag as an editorial eyebrow label, fallback to "Article"
const eyebrowLabel = tags[0] ?? 'Article'
const publishDateIso = publishDate.toISOString().slice(0, 10)
const updatedDateIso = updatedDate?.toISOString().slice(0, 10)

const metaItems = [
  { label: 'Published', value: publishDate, datetime: publishDateIso, type: 'date' as const },
  { label: 'Read time', value: readingTimeText, datetime: undefined, type: 'text' as const },
  { label: 'Words', value: wordCount.toLocaleString(), datetime: undefined, type: 'text' as const },
  ...(updatedDate ? [{ label: 'Updated', value: updatedDate, datetime: updatedDateIso, type: 'date' as const }] : [])
]
---

<section class="relative space-y-12">
  {/* ── Eyebrow + breadcrumb ─────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-4
      motion-reduce:animate-none
    "
  >
    <div class="
      flex min-w-0 flex-col items-start gap-3
      sm:flex-row sm:items-center sm:justify-between
    "
    >
      <Eyebrow label={eyebrowLabel} tone="brand" />
      <Breadcrumb
        class="
          flex max-w-full flex-wrap items-center gap-x-1.5 gap-y-1 text-sm
          font-medium text-ink-muted
        "
      >
        <ol>
          <li>
            <a
              href="/blog/"
              class="
                whitespace-nowrap transition-colors
                hover:text-brand
                motion-reduce:transition-none
              "
            >Blog
            </a>
          </li>
          <li><span aria-current="page" class="text-ink-soft">Article</span></li>
        </ol>
      </Breadcrumb>
    </div>
  </div>

  {/* ── Title + description ──────────────────────────────────── */}
  <div
    class="
      animate-slide-up space-y-6 [animation-delay:80ms]
      motion-reduce:animate-none
    "
  >
    <div class="relative">
      <h1 class="
        p-name max-w-4xl text-4xl/[0.98] font-bold tracking-tighter
        wrap-break-word
        sm:text-5xl/[0.96]
        lg:text-[3.6rem]/[0.94]
      "
      >
        {title}
      </h1>
      <div class="
        absolute -inset-x-4 -inset-y-2 -z-10 rounded-3xl bg-linear-to-br
        from-brand/5 to-transparent blur-3xl
      "
      >
      </div>
    </div>
    <p class="
      p-summary max-w-3xl text-lg/7 font-medium text-ink-soft
      sm:text-xl/8
    "
    >
      {description}
    </p>
    <p class="text-sm/6 text-ink-muted">
      By{' '}
      <a
        class="
          p-name u-url font-semibold text-ink-soft transition-colors
          hover:text-brand
          motion-reduce:transition-none
        "
        href="/about/"
        rel="author"
      >
        {siteConfig.author}
      </a>
    </p>
  </div>

  {/* ── Meta row — styled cards ──────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:160ms]
      motion-reduce:animate-none
    "
  >
    <GradientDivider class="mb-8" />
    <div class="
      grid grid-cols-1 gap-4
      sm:grid-cols-2
      md:grid-cols-4
    "
    >
      {metaItems.map((item, index) => (
        <div
          class="
            post-meta-card relative rounded-2xl border border-line/30
            bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300
            hover:-translate-y-1 hover:border-brand/40 hover:bg-brand-soft/10
            hover:shadow-lg hover:shadow-brand/5
          "
          style={`animation-delay: ${160 + (index * 40)}ms`}
        >
          <dl class="space-y-2">
            <dt class="
              section-label text-xs font-semibold tracking-wider
              text-ink-muted/80 uppercase
            "
            >
              {item.label}
            </dt>
            <dd class="
              text-lg/6 font-bold text-ink
              sm:text-xl/6
            "
            >
              {item.type === 'date' ?
                <FormattedDate date={item.value} /> :
                item.value}
            </dd>
          </dl>
        </div>
      ))}
    </div>
  </div>

  {/* ── Tags / topics ────────────────────────────────────────── */}
  {tags.length > 0 && (
    <div
      class="
        animate-slide-up space-y-4 [animation-delay:200ms]
        motion-reduce:animate-none
      "
    >
      <div class="flex items-center gap-3">
        <span class="section-label">Topics</span>
        <span
          aria-hidden="true"
          class="
            h-px flex-1 bg-linear-to-r from-transparent via-line/40
            to-transparent
          "
        />
      </div>
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <Pill href={getTagPath(tag)} label={tag} showHash tone="outline" />
        ))}
      </div>
    </div>
  )}

  {/* ── CTAs ────────────────────────────────────────────────── */}
  <div
    class="
      animate-slide-up [animation-delay:240ms]
      motion-reduce:animate-none
    "
  >
    <div class="section-actions">
      {canonicalUrl && (
        <ButtonLink href={canonicalUrl} newTab showArrow>
          Read on Medium
        </ButtonLink>
      )}
      {!canonicalUrl && (
        <CopyButton
          className="
            group btn-primary inline-flex min-h-11 items-center justify-center
            gap-2 rounded-full border text-sm font-semibold tracking-[0.01em]
          "
          copiedLabel="Article link copied"
          errorLabel="Could not copy article link"
          label="Copy article link"
          value={copyUrl}
        >
          <Icon class="size-4" data-copy-icon name="link" />
          <Icon class="hidden size-4" data-check-icon name="check" />
          <span data-copy-label>Copy link</span>
          <span class="hidden" data-copied-label>Copied!</span>
        </CopyButton>
      )}
      {seriesContext && (
        <ButtonLink
          href={`/blog/series/${seriesContext.series.id}/`}
          showArrow
          variant="secondary"
        >
          <span class="flex items-center gap-2">
            <Icon
              class="size-4"
              name="route"
            />
            {seriesContext.series.data.title}
          </span>
        </ButtonLink>
      )}
      <ButtonLink
        href="/blog/"
        showArrow
        variant="secondary"
        className="text-ink-soft"
      >
        Browse blog
      </ButtonLink>
    </div>
  </div>

  {/* ── Cover image: full-width below ────────────────────────── */}
  {post.data.coverImage && (
    <div class="space-y-4">
      <div class:list={[
        'relative',
        !useWideCoverFrame && 'mx-auto w-full max-w-4xl'
      ]}
      >
        <HoverableCover
          alt={post.data.coverImage.alt}
          ariaHidden={true}
          className={useWideCoverFrame ? '' : 'mx-auto w-full max-w-4xl'}
          fetchpriority="high"
          image={post.data.coverImage.src}
          loading="eager"
          showBottomGradient={useWideCoverFrame}
          sizes="(min-width: 1024px) 1200px, 100vw"
          transitionName={`post-cover-${getPostSlug(post.id)}`}
        />
        {useWideCoverFrame && (
          <div
            aria-hidden="true"
            class="
              pointer-events-none absolute inset-x-0 bottom-0 z-20 flex
              flex-wrap items-end justify-between gap-4 p-5
              sm:p-6
            "
          >
            <div>
              <p class="section-label text-white/70">Article cover</p>
              <p class="
                mt-2 text-lg font-semibold tracking-[-0.03em] text-white
                sm:text-xl
              "
              >
                {title}
              </p>
            </div>
            <p class="max-w-md text-sm/6 text-white/78">
              {readingTimeText} · {eyebrowLabel}
            </p>
          </div>
        )}
      </div>
    </div>
  )}
</section>

<style>
  [data-ui-copy-button][data-state='copied'] [data-copy-icon],
  [data-ui-copy-button][data-state='copied'] [data-copy-label] {
    display: none;
  }

  [data-ui-copy-button][data-state='copied'] [data-check-icon],
  [data-ui-copy-button][data-state='copied'] [data-copied-label] {
    display: inline-flex;
  }
</style>
