---
import Pill from '@/components/atoms/Pill.astro'

import { getTagPath } from '@/utils/links'

interface Props {
  activeTag?: string
  scrollOnMobile?: boolean
  showDivider?: boolean
  tags: [string, number][]
}

const { activeTag, scrollOnMobile = false, showDivider = false, tags } = Astro.props
---

{showDivider && (
  <div class="flex items-center gap-4">
    <div class="
      h-px flex-1 bg-linear-to-r from-transparent via-line/40 to-transparent
    "
    />
    <span class="section-label">Filter posts</span>
    <div class="
      h-px flex-1 bg-linear-to-r from-transparent via-line/40 to-transparent
    "
    />
  </div>
)}
<div
  aria-label="Filter by topic"
  class:list={[
    'flex items-center gap-2',
    scrollOnMobile ?
      `
        -mx-5 flex-nowrap overflow-x-auto px-5 pb-2
        sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0
      ` :
      'flex-wrap'
  ]}
  data-blog-tag-filter
  role="group"
>
  <Pill
    className={scrollOnMobile ? 'shrink-0' : ''}
    href="/blog/"
    label="All posts"
    tone={!activeTag ? 'brand' : 'outline'}
  />
  {tags.map(([tag, count]) => (
    <Pill
      className={scrollOnMobile ? 'shrink-0' : ''}
      count={count}
      href={getTagPath(tag)}
      label={tag}
      showHash
      tone={activeTag === tag ? 'brand' : 'outline'}
    />
  ))}
</div>

<script>
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client'

  let preservedFilterTop: number | undefined

  document.addEventListener('astro:before-preparation', event => {
    const { sourceElement } = event as TransitionBeforePreparationEvent
    const filter = sourceElement?.closest<HTMLElement>('[data-blog-tag-filter]')

    preservedFilterTop = filter?.getBoundingClientRect().top
  })

  document.addEventListener('astro:after-swap', () => {
    if (preservedFilterTop === undefined) return

    const filter = document.querySelector<HTMLElement>('[data-blog-tag-filter]')

    if (filter) {
      const filterTop = filter.getBoundingClientRect().top

      window.scrollBy({
        behavior: 'instant',
        top: filterTop - preservedFilterTop
      })
    }

    preservedFilterTop = undefined
  })
</script>
