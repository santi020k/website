---
import ButtonLink from '@/components/atoms/ButtonLink.astro'
import Pill from '@/components/atoms/Pill.astro'
import PageHero from '@/components/molecules/PageHero.astro'
import SectionHeader from '@/components/molecules/SectionHeader.astro'
import StatCard from '@/components/molecules/StatCard.astro'
import PageSection from '@/components/organisms/PageSection.astro'
import StatsGrid from '@/components/organisms/StatsGrid.astro'
import PageLayout from '@/layouts/Base.astro'

import { getCachedProjects } from '@/utils/content'
import { getTechnologyPath } from '@/utils/links'
import { sortTechnologyCountsByInterest } from '@/utils/technologies'

import { Card, Input } from '@santi020k/lumen-astro'

import { getUniqueTechnologiesWithCount } from '@/data/project'

const allProjects = await getCachedProjects()
const technologies = getUniqueTechnologiesWithCount(allProjects)
const topTechnology = technologies[0]?.[0]
const totalTechnologyMentions = technologies.reduce((total, [, count]) => total + count, 0)
const coreTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 4))
const regularTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count >= 2 && count < 4))
const selectiveTechnologies = sortTechnologyCountsByInterest(technologies.filter(([, count]) => count === 1))

const technologyGroups = [
  {
    items: coreTechnologies,
    summary: 'Repeated foundations across product architecture, delivery workflows, and the portfolio surface.',
    title: 'Core'
  },
  {
    items: regularTechnologies,
    summary: 'Reliable companion tools that help teams ship, test, document, and maintain production systems.',
    title: 'Regular'
  },
  {
    items: selectiveTechnologies,
    summary: 'Context-specific platforms, APIs, and product capabilities used when the problem calls for them.',
    title: 'Selective'
  }
].filter(group => group.items.length > 0)

const meta = {
  description: 'Browse Santiago Molina’s capabilities and technologies across frontend architecture, product systems, testing, and delivery.',
  title: 'Capabilities & Technologies'
}

---

<PageLayout meta={meta}>
  <PageHero
    description="The recurring capabilities and technologies across the portfolio: frontend and backend architecture, testing, delivery automation, developer experience, and the platforms around them."
    eyebrow="Capabilities index"
    gradientText="Full-stack range."
    metaItems={['Frontend architecture', 'Testing', 'Delivery tooling']}
    title="Capabilities and technologies."
  >
    <ButtonLink href="/work/" showArrow>
      Browse work
    </ButtonLink>
    <ButtonLink href="/portfolio/" showArrow variant="secondary">
      Back to portfolio
    </ButtonLink>
  </PageHero>

  <PageSection>
    <SectionHeader
      description="Grouped by how often each tool appears in shipped work, with the most product-shaping technologies kept easiest to scan."
      eyebrow="Technology groups"
      title="The stack by recurrence."
    />

    <Card
      class="relative overflow-hidden p-0"
      variant="muted"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 grid-fade opacity-25"
      >
      </div>
      <div
        aria-hidden="true"
        class="
          pointer-events-none absolute -right-20 -bottom-28 size-72 rounded-full
          bg-radial from-brand/16 via-accent/7 to-transparent blur-3xl
        "
      />

      <div class="relative z-10">
        <div class="
          grid gap-5 p-5
          sm:p-6
          lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.72fr)] lg:items-end lg:p-7
        "
        >
          <div class="max-w-xl space-y-2">
            <p class="
              section-label text-brand
              dark:text-accent
            "
            >Stack snapshot
            </p>
            <p class="text-sm/6 text-ink-soft">
              Search the full index, then follow any technology to the projects where it appears.
            </p>
          </div>

          <div class="space-y-2">
            <label class="block section-label" for="technology-filter">Find a technology</label>
            <Input
              aria-describedby="technology-filter-status"
              autocomplete="off"
              class="field-surface"
              id="technology-filter"
              placeholder="Search technologies…"
              spellcheck="false"
              type="search"
            />
            <p
              id="technology-filter-status"
              aria-live="polite"
              class="text-xs text-ink-muted"
            >
              Showing all {technologies.length} technologies.
            </p>
          </div>
        </div>

        <div class="h-px bg-linear-to-r from-line/70 via-line/35 to-transparent"></div>

        <div data-technology-groups>
          {technologyGroups.map((group, index) => (
            <section
              aria-labelledby={`technology-group-${index}`}
              class:list={[
                `
                  grid gap-5 p-5
                  sm:p-6
                  lg:grid-cols-[minmax(12rem,0.38fr)_minmax(0,1.62fr)] lg:gap-8
                  lg:p-7
                `,
                index > 0 && 'border-t border-line/40'
              ]}
              data-technology-group
            >
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-semibold text-ink-muted">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="
                    section-label text-brand
                    dark:text-accent
                  "
                  >{group.title}
                  </p>
                </div>
                <h3
                  class="text-2xl font-bold tracking-tight text-ink"
                  id={`technology-group-${index}`}
                >
                  <span data-technology-group-count>{group.items.length}</span> tools
                </h3>
                <p class="max-w-sm text-sm/6 text-ink-soft">{group.summary}</p>
              </div>

              <div class="flex flex-wrap content-start gap-2.5">
                {group.items.map(([technology, count]) => (
                  <span data-label={technology} data-technology-item>
                    <Pill
                      count={count}
                      href={getTechnologyPath(technology)}
                      label={technology}
                      tone={index === 0 ? 'brand' : 'outline'}
                    />
                  </span>
                ))}
              </div>
            </section>
          ))}
        </div>

        <p
          class="
            m-5 rounded-2xl border border-line/55 bg-surface/72 p-5 text-sm
            text-ink-soft
            sm:m-6
            lg:m-7
          "
          data-technologies-empty
          hidden
        >
          No technologies match that search. Try a broader term or clear the search field.
        </p>
      </div>
    </Card>
  </PageSection>

  <StatsGrid showDivider={false}>
    <StatCard description="Distinct capabilities, tools, and platforms across the full portfolio." label="Technologies" value={String(technologies.length)} />
    <StatCard description="The single technology that appears most often across shipped projects." label="Most used" value={topTechnology ?? ''} />
    <StatCard description="Tagged project evidence connecting tools back to shipped work." label="Signals" value={String(totalTechnologyMentions)} />
    <StatCard description="Frontend, backend, testing, delivery, and developer tooling." label="Scope" value="Full stack" />
  </StatsGrid>

  <section class="
    section-container-wide pt-20
    sm:pt-24
    lg:pt-28
  "
  >
    <div class="cta-panel">
      <div
        class="
          grid gap-6
          lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end
        "
      >
        <div class="max-w-2xl space-y-3">
          <p class="
            section-label text-brand
            dark:text-accent
          "
          >Trace the evidence
          </p>
          <h2 class="
            text-2xl font-semibold tracking-tight text-ink
            sm:text-3xl
          "
          >
            Tools are easier to trust when they point to real work.
          </h2>
          <p class="section-copy">
            Each technology page filters the portfolio to the projects where that tool shaped the
            architecture, delivery workflow, or product experience.
          </p>
        </div>
        <div class="
          section-actions
          lg:justify-end
        "
        >
          <ButtonLink href="/portfolio/" showArrow>
            Browse portfolio
          </ButtonLink>
          <ButtonLink href="/blog/" showArrow variant="secondary">
            Read the writing
          </ButtonLink>
        </div>
      </div>
    </div>
  </section>

  <script>
    const setupTechnologyIndex = () => {
      const groups = document.querySelector<HTMLElement>('[data-technology-groups]')
      const input = document.querySelector<HTMLInputElement>('#technology-filter')
      const status = document.getElementById('technology-filter-status')
      const empty = document.querySelector<HTMLElement>('[data-technologies-empty]')

      if (!groups || !input || !status || !empty || groups.dataset.filterReady === 'true') return

      groups.dataset.filterReady = 'true'

      const groupElements = groups.querySelectorAll<HTMLElement>('[data-technology-group]')
      const items = groups.querySelectorAll<HTMLElement>('[data-technology-item]')

      input.addEventListener('input', () => {
        const query = input.value.trim().toLocaleLowerCase()
        let visibleTotal = 0

        groupElements.forEach(group => {
          const groupItems = group.querySelectorAll<HTMLElement>('[data-technology-item]')

          const count = [...groupItems].reduce((total, item) => {
            const matches = !query || (item.dataset.label ?? '').toLocaleLowerCase().includes(query)

            item.hidden = !matches

            return total + (matches ? 1 : 0)
          }, 0)

          const countLabel = group.querySelector<HTMLElement>('[data-technology-group-count]')

          group.hidden = count === 0

          if (countLabel) countLabel.textContent = String(count)

          visibleTotal += count
        })

        empty.hidden = visibleTotal > 0

        status.textContent = query ?
          `${visibleTotal} ${visibleTotal === 1 ? 'technology' : 'technologies'} found.` :
          `Showing all ${items.length} technologies.`
      })
    }

    document.addEventListener('astro:page-load', setupTechnologyIndex)
  </script>
</PageLayout>
