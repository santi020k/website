---
import { Icon } from 'astro-icon/components'

import { siteConfig } from '@/site.config'

import ButtonLink from '../atoms/ButtonLink.astro'

import SectionHeading from './SectionHeading.astro'

const contactChannels = [
  {
    action: 'Open WhatsApp',
    description: 'Best when you want a fast, lightweight conversation with useful context up front.',
    href: siteConfig.contact.whatsapp,
    icon: 'tabler:brand-whatsapp',
    label: 'WhatsApp',
    newTab: true,
    value: '+57 350 799 0136'
  },
  {
    action: 'Message on LinkedIn',
    description: 'A good fit for referrals, role discussions, and keeping the thread professional.',
    href: siteConfig.contact.linkedin,
    icon: 'tabler:brand-linkedin',
    label: 'LinkedIn',
    newTab: true,
    value: '/in/santi020k'
  },
  {
    action: 'Send email',
    description: 'Still available for longer briefs, documents, or formal follow-ups.',
    href: `mailto:${siteConfig.contact.email}`,
    icon: 'tabler:mail',
    label: 'Email',
    value: siteConfig.contact.email
  }
]
---

<section
  id="contact"
  class="editorial-section"
  data-animate
>
  <div class="space-y-6">
    <SectionHeading
      description="Whether you have a project in flight or just want to compare notes on engineering leadership, architecture, and developer experience, I'm always open to a thoughtful conversation."
      eyebrow="Contact"
      title="Let's build something useful together."
    />

    <div class="
      grid gap-3
      sm:grid-cols-2
      lg:grid-cols-1
    "
    >
      <div class="mini-note">
        <p class="section-label">Availability</p>
        <p class="mt-2 text-sm/7 text-ink-soft">{siteConfig.availability}</p>
      </div>
      <div class="mini-note">
        <p class="section-label">Response window</p>
        <p class="mt-2 text-sm/7 text-ink-soft">
          WhatsApp is the fastest route for short intros; LinkedIn works well for async professional context.
        </p>
      </div>
    </div>
  </div>

  <div class="
    panel-card h-max p-6
    sm:p-8
  "
  >
    <div class="space-y-6">
      <div class="space-y-2">
        <p class="section-label">Direct contact</p>
        <h3 class="
          text-2xl
          sm:text-3xl
        "
        >Pick the channel that matches the conversation.
        </h3>
      </div>

      <!-- Rows respond to the card's own width, so enlarged text stacks instead of squeezing values. -->
      <div class="@container space-y-5">
        {contactChannels.map(({ action, description, href, icon, label, newTab = false, value }, index) => (
          <div
            data-contact-row
            class:list={[
              `
                flex flex-col gap-4
                @lg:flex-row @lg:items-start @lg:justify-between
              `,
              index > 0 && 'border-t border-line/60 pt-5'
            ]}
          >
            <div class="
              flex min-w-0 flex-col gap-4
              @3xs:flex-row
            "
            >
              <div class="
                flex size-12 shrink-0 items-center justify-center rounded-2xl
                bg-brand-soft text-brand
              "
              >
                <Icon aria-hidden="true" class="size-6" name={icon} />
              </div>
              <div class="min-w-0 space-y-2" data-copy-scope>
                <p class="section-label">{label}</p>
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    class="
                      block max-w-full min-w-0 text-lg font-semibold
                      wrap-break-word text-ink transition-colors
                      hover:text-brand
                    "
                    href={href}
                    rel={newTab ? 'noopener noreferrer' : undefined}
                    target={newTab ? '_blank' : undefined}
                  >
                    {value}
                  </a>
                  {label === 'Email' && (
                    <button
                      aria-label="Copy email address"
                      class="
                        group/copy -my-2 inline-flex size-11 shrink-0
                        items-center justify-center rounded-lg
                        focus-visible:outline-brand
                      "
                      data-copy-email={value}
                      type="button"
                    >
                      <!-- The 44px button keeps the original 28px visual chip. -->
                      <span class="
                        inline-flex size-7 items-center justify-center
                        rounded-lg border border-line/50 bg-surface-muted/60
                        text-ink-muted transition-all duration-200
                        group-hover/copy:border-brand/40
                        group-hover/copy:bg-brand-soft/30
                        group-hover/copy:text-brand
                        motion-reduce:transition-none
                      "
                      >
                        <Icon aria-hidden="true" class="size-3.5" data-copy-icon name="tabler:copy" />
                        <Icon aria-hidden="true" class="hidden size-3.5" data-check-icon name="tabler:check" />
                      </span>
                    </button>
                  )}
                </div>
                {label === 'Email' && (
                  <p
                    id="contact-copy-status"
                    class="
                      text-sm/6 text-ink-soft
                      empty:sr-only
                    "
                    data-copy-status
                    role="status"
                  />
                )}
                <p class="max-w-md text-sm/6 text-ink-soft">{description}</p>
              </div>
            </div>

            <ButtonLink className="max-w-full shrink-0 text-center" href={href} newTab={newTab} showArrow variant="secondary">
              {action}
            </ButtonLink>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const COPIED_MESSAGE = 'Email address copied.'
  const FAILED_MESSAGE = 'Could not copy. Select the email address to copy it.'

  const setupCopyEmail = () => {
    const controller = new AbortController()
    const { signal } = controller
    const timers = new Set<number>()

    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach(btn => {
      const status = btn.closest('[data-copy-scope]')?.querySelector<HTMLElement>('[data-copy-status]')
      const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]')
      const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]')
      let resetTimer: number | undefined
      let announcementTimer: number | undefined

      // The button name stays "Copy email address"; the status region carries the result.
      const showResult = (copied: boolean) => {
        if (resetTimer !== undefined) {
          window.clearTimeout(resetTimer)

          timers.delete(resetTimer)
        }

        copyIcon?.classList.toggle('hidden', copied)

        checkIcon?.classList.toggle('hidden', !copied)

        if (announcementTimer !== undefined) {
          window.clearTimeout(announcementTimer)

          timers.delete(announcementTimer)
        }

        if (status) {
          status.textContent = ''

          announcementTimer = window.setTimeout(() => {
            status.textContent = copied ? COPIED_MESSAGE : FAILED_MESSAGE

            if (announcementTimer !== undefined) timers.delete(announcementTimer)
          }, 100)

          timers.add(announcementTimer)
        }

        if (!copied) return

        resetTimer = window.setTimeout(() => {
          copyIcon?.classList.remove('hidden')

          checkIcon?.classList.add('hidden')

          if (status) status.textContent = ''

          if (resetTimer !== undefined) timers.delete(resetTimer)
        }, 4000)

        timers.add(resetTimer)
      }

      btn.addEventListener('click', async () => {
        const email = btn.dataset.copyEmail

        if (!email || btn.getAttribute('aria-busy') === 'true') return

        btn.setAttribute('aria-busy', 'true')

        let copied = false

        try {
          await navigator.clipboard.writeText(email)

          copied = true
        } catch {
          // Clipboard access can be unavailable or denied; the status explains the fallback.
        }

        // Ignore results that settle after the page has been swapped.
        if (!signal.aborted) {
          btn.removeAttribute('aria-busy')

          showResult(copied)
        }
      }, { signal })
    })

    return () => {
      controller.abort()

      timers.forEach(timer => window.clearTimeout(timer))

      timers.clear()
    }
  }

  let cleanupCopyEmail = setupCopyEmail()

  document.addEventListener('astro:after-swap', () => {
    cleanupCopyEmail()

    cleanupCopyEmail = setupCopyEmail()
  })
</script>
