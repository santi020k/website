---
import { Icon } from 'astro-icon/components'
---

<button
  id="back-to-top"
  inert
  aria-label="Scroll back to top"
  class="back-to-top-button"
  type="button"
>
  <Icon aria-hidden="true" name="tabler:arrow-up" class="size-5" />
</button>

<style>
  #back-to-top {
    opacity: 0;
    transform: translateY(2.5rem) scale(0.5);
    pointer-events: none;
    /* leave transition */
    transition:
      opacity 0.3s ease-in,
      transform 0.3s ease-in;
  }

  #back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    /* enter transition — spring */
    transition:
      opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top,
    #back-to-top.is-visible {
      transition: none;
    }
  }
</style>

<script>
  const focusMain = () => document.getElementById('main')?.focus({ preventScroll: true })

  const setup = () => {
    const btn = document.getElementById('back-to-top')

    if (!(btn instanceof HTMLButtonElement)) return () => undefined

    const onScroll = () => {
      const isVisible = window.scrollY > 400

      // Never leave keyboard focus on a control that is about to disappear.
      if (!isVisible && document.activeElement === btn) focusMain()

      btn.inert = !isVisible

      btn.classList.toggle('is-visible', isVisible)
    }

    const onClick = () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const wasFocused = document.activeElement === btn

      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })

      if (wasFocused) focusMain()
    }

    window.addEventListener('scroll', onScroll, { passive: true })

    btn.addEventListener('click', onClick)

    onScroll()

    return () => {
      window.removeEventListener('scroll', onScroll)

      btn.removeEventListener('click', onClick)
    }
  }

  let cleanup = setup()

  document.addEventListener('astro:after-swap', () => {
    cleanup()

    cleanup = setup()
  })
</script>
