---
export enum SeparatorType {
  Horizontal = 'horizontal',
  Vertical = 'vertical',
  Dot = 'dot'
}

export interface SeparatorProps {
  type?: SeparatorType
  className?: string
}

const {
  type = SeparatorType.Horizontal,
  className = ''
} = Astro.props as SeparatorProps

const separatorClasses = {
  base: 'shrink-0 bg-lighter mx-2',
  types: {
    [SeparatorType.Horizontal]: 'h-px w-full',
    [SeparatorType.Vertical]: 'h-full w-px',
    [SeparatorType.Dot]: 'w-1.5 h-1.5 rounded-full'
  }
} as const

const isDot = type === SeparatorType.Dot
const ariaOrientation = type === SeparatorType.Horizontal ? 'horizontal' : 'vertical'
const typeClass = separatorClasses.types[type]
---

{isDot ?
  (
    <span class={`
      ${separatorClasses.base}
      ${typeClass}
      ${className}
    `}
    />
  ) :
  (
    <span
      role="separator"
      aria-orientation={ariaOrientation}
      class={`
        ${separatorClasses.base}
        ${typeClass}
        ${className}
      `}
    />
  )}
