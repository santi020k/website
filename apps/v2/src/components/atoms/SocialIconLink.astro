---
import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  icon: string
  label: string
}

const { href, icon, label } = Astro.props
---

<a
  aria-label={label}
  class="
    inline-flex size-11 items-center justify-center rounded-full text-ink
    panel-surface transition duration-200
    hover:-translate-y-0.5 hover:text-brand
    motion-reduce:transition-none
    motion-reduce:hover:translate-y-0
  "
  href={href}
  rel="noreferrer noopener"
  target="_blank"
>
  <Icon aria-hidden="true" class="size-5" name={icon} />
</a>
