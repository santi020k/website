---
const { variant = 'default', showHash = true, className = '', title } = Astro.props

const badgeClasses = {
  base:
    'inline-flex items-center gap-1 px-2 h-6 rounded-2xl text-sm font-medium transition-colors truncate overflow-hidden text-ellipsis whitespace-nowrap max-w-[200px] sm:max-w-full',
  variants: {
    default: 'bg-ink text-canvas hover:brightness-90',
    accent: 'bg-accent text-canvas hover:brightness-90',
    'brand-accent': 'bg-brand text-canvas hover:brightness-90',
    muted:
      'bg-surface-muted hover:bg-line text-ink transition duration-300',
    outline:
      'border border-line text-ink bg-transparent hover:border-accent',
    inactive: 'bg-surface-muted text-ink/40 cursor-default',
    subtle: 'bg-surface-muted text-ink/60',
    ghost: 'bg-transparent text-ink/60 hover:bg-surface-muted',
    warning: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
    danger: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
  }
}

const variantClasses = badgeClasses.variants[variant as keyof typeof badgeClasses.variants]
---
<div class={`
  ${badgeClasses.base}
  ${variantClasses}
  ${className}
`}
>
  {showHash && <span class="text-xs font-normal opacity-60">#</span>}
  <span class="truncate">{title}</span>
  <slot />
</div>
