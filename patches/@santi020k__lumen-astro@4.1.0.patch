--- /dev/null
+++ b/runtime/controllers/scroll-cue.ts
@@ -0,0 +1,178 @@
+interface ScrollCueBinding {
+  apply: (visible: boolean) => void
+  cleanup: () => void
+  measure: () => boolean | undefined
+}
+
+const bindings = new Map<HTMLElement, ScrollCueBinding>()
+const pending = new Set<ScrollCueBinding>()
+const watchedFonts = new WeakSet<FontFaceSet>()
+let nextId = 0
+let pendingFrame = 0
+
+// Unchanged cues write nothing, so they leave the layout other scripts read intact.
+const updateDescription = (viewport: HTMLElement, id: string, visible: boolean): void => {
+  const current = viewport.getAttribute('aria-describedby')
+  const ids = new Set(current?.split(/\s+/u).filter(Boolean))
+
+  if (visible) ids.add(id)
+  else ids.delete(id)
+
+  const next = [...ids].join(' ')
+
+  if (next === (current ?? '')) return
+
+  if (next) viewport.setAttribute('aria-describedby', next)
+  else viewport.removeAttribute('aria-describedby')
+}
+
+// Measure every cue before changing any. Interleaving reads and writes forces one
+// full-page layout per code block, which dominates long, code-heavy articles.
+const update = (targets: Iterable<ScrollCueBinding>): void => {
+  const measured = [...targets].map(binding => ({ binding, visible: binding.measure() }))
+
+  for (const { binding, visible } of measured) {
+    if (visible !== undefined) binding.apply(visible)
+  }
+}
+
+// Showing a cue resizes its scroll viewport. Write layout outside the observer
+// delivery so WebKit can finish notifying all observed elements.
+const requestUpdate = (binding: ScrollCueBinding): void => {
+  pending.add(binding)
+
+  if (pendingFrame) return
+
+  pendingFrame = requestAnimationFrame(() => {
+    pendingFrame = 0
+
+    const targets = [...pending]
+
+    pending.clear()
+
+    update(targets)
+  })
+}
+
+// A web font swap can change code width without resizing the observed boxes. Listen for
+// font loads instead of reading `fonts.ready`, which forces a style pass on every page.
+// The event fires before `fonts.ready` resolves, so cues settle before code awaiting it runs.
+const watchFonts = (fonts: FontFaceSet): void => {
+  if (watchedFonts.has(fonts)) return
+
+  watchedFonts.add(fonts)
+
+  fonts.addEventListener('loadingdone', () => {
+    update(bindings.values())
+  })
+}
+
+export const clearScrollCues = (): void => {
+  for (const binding of bindings.values()) binding.cleanup()
+
+  bindings.clear()
+
+  cancelAnimationFrame(pendingFrame)
+
+  pendingFrame = 0
+}
+
+const bindScrollCue = (root: HTMLElement): ScrollCueBinding | undefined => {
+  const viewport = root.querySelector<HTMLElement>('[data-scroll-cue-viewport], pre')
+  const content = viewport?.querySelector<HTMLElement>('table, code')
+  const message = root.querySelector<HTMLElement>('[data-scroll-cue-message]')
+
+  if (!viewport || !content || !message) return undefined
+
+  if (!message.id) {
+    let candidate: string
+
+    do {
+      nextId += 1
+
+      candidate = `ui-scroll-cue-${nextId}`
+    } while (root.ownerDocument.getElementById(candidate))
+
+    message.id = candidate
+  }
+
+  const id = message.id
+  let active = true
+
+  const binding: ScrollCueBinding = {
+    measure: () => {
+      if (!active || !root.isConnected) return undefined
+
+      return viewport.clientWidth > 0 && viewport.scrollWidth > viewport.clientWidth + 1
+    },
+    apply: visible => {
+      if (message.hidden === visible) message.hidden = !visible
+
+      updateDescription(viewport, id, visible)
+    },
+    cleanup: () => {
+      active = false
+
+      observer.disconnect()
+
+      pending.delete(binding)
+
+      message.hidden = true
+
+      updateDescription(viewport, id, false)
+    }
+  }
+
+  const observer = new ResizeObserver(() => {
+    requestUpdate(binding)
+  })
+
+  observer.observe(viewport)
+
+  observer.observe(content)
+
+  bindings.set(root, binding)
+
+  return binding
+}
+
+/** Enhance the documented Code/Table markup without owning native scrolling or focus. */
+export const initScrollCues = (scope: ParentNode): void => {
+  for (const [root, binding] of bindings) {
+    if (!root.isConnected) {
+      binding.cleanup()
+
+      bindings.delete(root)
+    }
+  }
+
+  const added: ScrollCueBinding[] = []
+
+  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-scroll-cue]')) {
+    const binding = bindings.has(root) ? undefined : bindScrollCue(root)
+
+    if (binding) added.push(binding)
+  }
+
+  if (!added.length) return
+
+  // Settle every new cue in one layout before the page continues.
+  update(added)
+
+  const fonts = (scope instanceof Document ? scope : scope.ownerDocument)?.fonts
+
+  if (fonts) watchFonts(fonts)
+}
+
+/** Commit panel visibility and its cue in one layout before tabs scroll into view. */
+export const refreshScrollCues = (scope: ParentNode): void => {
+  const targets: ScrollCueBinding[] = []
+
+  for (const root of scope.querySelectorAll<HTMLElement>('[data-ui-scroll-cue]')) {
+    const binding = bindings.get(root)
+
+    if (binding) targets.push(binding)
+  }
+
+  update(targets)
+}
