+/* Panel measurements must finish before the document selects a new scroll anchor. */
+:root[data-ui-tabs-layout] { overflow-anchor: none; }
+
+@layer lumen.components {
+/* Opt-in overflow guidance remains outside the native scrolling content. */
+.ui-scroll-cue:not([hidden]) { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem; color: hsl(var(--ink-soft)); font: 400 0.75rem/1.6 var(--font-sans, sans-serif); }
+.ui-scroll-cue > svg { flex: none; width: 1rem; height: 1rem; color: hsl(var(--brand)); }
+.ui-scroll-cue > span { min-width: 0; overflow-wrap: anywhere; }
+.ui-code > .ui-scroll-cue { border-block-start: 1px solid hsl(var(--line)); }
+.ui-table-scroll { min-width: 0; border: var(--ui-border-width, 1px) solid hsl(var(--line)); border-radius: var(--ui-radius); background: hsl(var(--surface)); }
+.ui-table-scroll > .ui-scroll-cue { border-block-end: 1px solid hsl(var(--line)); }
+.ui-table-scroll > .ui-table-wrap { border: 0; border-radius: inherit; }
+.ui-table-scroll:has(> .ui-scroll-cue:not([hidden])) > .ui-table-wrap { border-start-start-radius: 0; border-start-end-radius: 0; }
+.ui-table-scroll > .ui-table-wrap:focus-visible { outline: 2px solid hsl(var(--accent)); outline-offset: 2px; }
