+// Resolves a computed scroll-padding or scroll-margin value. `auto`, unresolved
+// calc() expressions, and other non-numeric values contribute nothing.
+const readScrollLength = (value: string, percentageBasis: number): number => {
+  const amount = Number.parseFloat(value)
+
+  if (!Number.isFinite(amount)) return 0
+
+  return value.trim().endsWith('%') ? (amount / 100) * percentageBasis : amount
+}
