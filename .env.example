# GitHub fine-grained PAT used by Changesets to create release pull requests.
# Grant Contents and Pull requests read/write access to this repository.
CHANGESETS_TOKEN=

# Optional — Webmention.io integration (blog post mentions on the site).
# Leave unset to build and run without fetching webmentions.
# https://webmention.io/

# API token from the webmention.io dashboard (server-only; do not commit real values)
# WEBMENTION_API_KEY=

# Public endpoint URL for the webmention rel link (e.g. https://webmention.io/...)
# WEBMENTION_URL=

# Optional pingback URL if you use it alongside webmention
# WEBMENTION_PINGBACK=
