{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "tests",
    "scripts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "dist"
  ]
}
