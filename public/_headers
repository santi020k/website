# Cloudflare Pages _headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ─── Immutable static assets (hashed filenames) ─────────────────────────────
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  # CORS: lets the giscus.app iframe load the brand font (see public/styles/giscus-*.css)
  Access-Control-Allow-Origin: *

/og/*
  Cache-Control: public, max-age=31536000, immutable

# ─── Service worker — must revalidate on every request ───────────────────────
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# ─── Dynamic / frequently updated documents ──────────────────────────────────
/sitemap*.xml
  CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
  Cache-Control: public, max-age=0, must-revalidate

/feed.json
  CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
  Cache-Control: public, max-age=0, must-revalidate

# ─── HTML pages ──────────────────────────────────────────────────────────────
/*.html
  CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
  Cache-Control: public, max-age=0, must-revalidate

# ─── Search consolidation ────────────────────────────────────────────────────
/pdf/cv.pdf
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://santi020k.com/resume/>; rel="canonical"

# ─── Security & privacy headers (applied globally) ───────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://webmention.io https://buttondown.com; frame-src https://giscus.app; frame-ancestors 'none'; form-action 'self' https://buttondown.com; upgrade-insecure-requests
